{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "minLength",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10009.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "authorizationCode": {
                    "maxLength": 100,
                    "type": "string"
                  },
                  "clientId": {
                    "description": "MongoDB object ID for the user",
                    "maxLength": 12,
                    "minLength": 12,
                    "pattern": "[0-9a-fA-F]+",
                    "type": "string"
                  },
                  "expirationTime": {
                    "type": "number"
                  },
                  "scope": {
                    "type": "string"
                  }
                },
                "title": "OAuthAuthorizationCode",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^authorizationCode$": true,
                  "^clientId$": true,
                  "^expirationTime$": true,
                  "^scope$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "authorizationCode": {
        "maxLength": 100,
        "type": "string"
      },
      "clientId": {
        "description": "MongoDB object ID for the user",
        "maxLength": 12,
        "minLength": 12,
        "pattern": "[0-9a-fA-F]+",
        "type": "string"
      },
      "expirationTime": {
        "type": "number"
      },
      "scope": {
        "type": "string"
      }
    },
    "title": "OAuthAuthorizationCode",
    "type": "object"
  }
}
