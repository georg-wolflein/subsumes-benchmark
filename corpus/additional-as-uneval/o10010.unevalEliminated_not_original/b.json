{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "expirationTime": {
                  "type": "number"
                },
                "clientId": {
                  "description": "MongoDB object ID for the user",
                  "maxLength": 12,
                  "minLength": 12,
                  "pattern": "[0-9a-fA-F]+",
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "refreshToken": {
                  "maxLength": 100,
                  "type": "string"
                },
                "accessToken": {
                  "maxLength": 100,
                  "type": "string"
                }
              },
              "title": "OAuthBearerToken",
              "type": "object"
            },
            {
              "patternProperties": {
                "^refreshToken$": true,
                "^expirationTime$": true,
                "^clientId$": true,
                "^scope$": true,
                "^accessToken$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
