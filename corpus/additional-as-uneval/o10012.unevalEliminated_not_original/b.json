{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "OAuthClientResponse",
              "description": "OAuthClient response when created",
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[ !\"#$%&\\'()*+,\\-./0-9:;<=>?@A-Z[\\\\\\]\\^_`a-z{\\|}]+$",
                  "minLength": 30,
                  "maxLength": 30
                },
                "secret": {
                  "type": "string",
                  "pattern": "^[ !\"#$%&\\'()*+,\\-./0-9:;<=>?@A-Z[\\\\\\]\\^_`a-z{\\|}]+$",
                  "minLength": 30
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^secret$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
