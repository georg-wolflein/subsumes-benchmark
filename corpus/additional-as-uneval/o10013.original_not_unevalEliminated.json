{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "maxLength",
    "minLength",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10013.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10013.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "oneOf": [
                  {
                    "properties": {
                      "grantType": {
                        "enum": [
                          "authorization_code"
                        ]
                      },
                      "responseType": {
                        "enum": [
                          "code"
                        ]
                      }
                    },
                    "required": [
                      "grantType",
                      "responseType"
                    ]
                  },
                  {
                    "properties": {
                      "grantType": {
                        "enum": [
                          "client_credentials"
                        ]
                      },
                      "responseType": {
                        "enum": [
                          "token"
                        ]
                      }
                    },
                    "required": [
                      "grantType",
                      "responseType"
                    ]
                  }
                ],
                "properties": {
                  "secret": {
                    "minLength": 30,
                    "type": "string"
                  },
                  "redirectUris": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "clientId": {
                    "minLength": 30,
                    "type": "string"
                  },
                  "responseType": {
                    "type": "string"
                  },
                  "userId": {
                    "description": "MongoDB object ID for the user",
                    "maxLength": 12,
                    "minLength": 12,
                    "pattern": "[0-9a-fA-F]+",
                    "type": "string"
                  },
                  "scopes": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "grantType": {
                    "type": "string"
                  }
                },
                "title": "OAuthClient",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^clientId$": true,
                  "^scopes$": true,
                  "^userId$": true,
                  "^secret$": true,
                  "^redirectUris$": true,
                  "^responseType$": true,
                  "^grantType$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "oneOf": [
      {
        "properties": {
          "grantType": {
            "enum": [
              "authorization_code"
            ]
          },
          "responseType": {
            "enum": [
              "code"
            ]
          }
        },
        "required": [
          "grantType",
          "responseType"
        ]
      },
      {
        "properties": {
          "grantType": {
            "enum": [
              "client_credentials"
            ]
          },
          "responseType": {
            "enum": [
              "token"
            ]
          }
        },
        "required": [
          "grantType",
          "responseType"
        ]
      }
    ],
    "properties": {
      "clientId": {
        "minLength": 30,
        "type": "string"
      },
      "grantType": {
        "type": "string"
      },
      "redirectUris": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "responseType": {
        "type": "string"
      },
      "scopes": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "secret": {
        "minLength": 30,
        "type": "string"
      },
      "userId": {
        "description": "MongoDB object ID for the user",
        "maxLength": 12,
        "minLength": 12,
        "pattern": "[0-9a-fA-F]+",
        "type": "string"
      }
    },
    "title": "OAuthClient",
    "type": "object"
  }
}
