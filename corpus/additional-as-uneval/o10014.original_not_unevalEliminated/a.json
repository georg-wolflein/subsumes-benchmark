{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "scopes": {
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "type": "array"
                }
              },
              "required": [
                "scopes"
              ],
              "title": "ScopeRegisterRequest",
              "type": "object"
            },
            {
              "patternProperties": {
                "^scopes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "scope": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                }
              },
              "required": [
                "scope",
                "uri"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^scope$": true,
                "^uri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
