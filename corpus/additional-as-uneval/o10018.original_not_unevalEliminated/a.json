{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "key": {
                  "maxLength": 12,
                  "pattern": "^[a-zA-Z0-9_\\.]+$",
                  "type": "string"
                }
              },
              "required": [
                "key"
              ],
              "title": "ExtractRequest",
              "type": "object"
            },
            {
              "patternProperties": {
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
