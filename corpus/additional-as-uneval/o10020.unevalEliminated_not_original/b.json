{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/modern_1"
    },
    {
      "$ref": "#/$defs/modern_2"
    }
  ],
  "title": "ForgetRequest",
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "key": {
                  "maxLength": 12,
                  "pattern": "^[a-zA-Z0-9_\\.]+$",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "keys": {
                  "items": {
                    "maxLength": 12,
                    "pattern": "^[a-zA-Z0-9_\\.]+$",
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            {
              "patternProperties": {
                "^keys$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
