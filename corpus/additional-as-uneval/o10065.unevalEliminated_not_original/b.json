{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "matched": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "modified": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "upsertedId": {
                  "type": "string"
                }
              },
              "required": [
                "matched",
                "modified"
              ],
              "title": "UpdateManyResponse",
              "type": "object"
            },
            {
              "patternProperties": {
                "^matched$": true,
                "^modified$": true,
                "^upsertedId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
