{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "data": true,
                "error": true,
                "meta": {
                  "type": "object"
                },
                "warning": true
              },
              "title": "API Results",
              "type": "object"
            },
            {
              "patternProperties": {
                "^data$": true,
                "^error$": true,
                "^meta$": true,
                "^warning$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
