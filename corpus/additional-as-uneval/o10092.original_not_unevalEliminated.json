{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "oneOf",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10092.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "$ref": "#/$defs/modern_1"
      },
      {
        "$ref": "#/$defs/modern_2"
      }
    ],
    "title": "Cursor request schema for your api",
    "type": "object",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "next": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^next$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "previous": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^previous$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "next": {
            "type": "string"
          }
        }
      },
      {
        "additionalProperties": false,
        "properties": {
          "previous": {
            "type": "string"
          }
        }
      }
    ],
    "title": "Cursor request schema for your api",
    "type": "object"
  }
}
