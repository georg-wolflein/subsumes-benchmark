{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "Address": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "Address"
              ],
              "title": "test/addressSchema.xsd",
              "type": "object"
            },
            {
              "patternProperties": {
                "^Address$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "Town": {
                  "type": "string"
                },
                "Country": {
                  "enum": [
                    "IN",
                    "DE",
                    "ES",
                    "UK",
                    "US"
                  ],
                  "type": "string"
                },
                "County": {
                  "type": "string"
                },
                "Street": {
                  "type": "string"
                },
                "Recipient": {
                  "type": "string"
                },
                "PostCode": {
                  "type": "string"
                },
                "House": {
                  "type": "string"
                }
              },
              "required": [
                "Recipient",
                "House",
                "Street",
                "Town",
                "PostCode"
              ]
            },
            {
              "patternProperties": {
                "^PostCode$": true,
                "^House$": true,
                "^Country$": true,
                "^Town$": true,
                "^County$": true,
                "^Recipient$": true,
                "^Street$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
