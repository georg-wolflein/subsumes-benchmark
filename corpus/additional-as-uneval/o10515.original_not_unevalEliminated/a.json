                "feed": {
                  "$ref": "#/$defs/feedType"
                }
              },
              "required": [
                "feed"
              ],
              "title": "test/atomSchema.xsd",
              "type": "object"
            },
            {
              "patternProperties": {
                "^feed$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
