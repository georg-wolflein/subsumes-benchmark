{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "projects",
    "drivers"
  ],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_5"
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_6"
      }
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z\\d\\./-]+$"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "maintainer": {
                  "$ref": "#/$defs/user"
                },
                "project_id": {
                  "type": "string"
                },
                "wiki": {
                  "type": "string"
                },
                "os_versions": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "oneOf": [
                      {
                        "$ref": "#/$defs/self_verification"
                      },
                      {
                        "$ref": "#/$defs/3rd_party_verification"
                      },
                      {
                        "$ref": "#/$defs/external_ci_verification"
                      }
                    ]
                  }
                },
                "vendor": {
                  "type": "string"
                }
              },
              "required": [
                "project_id",
                "vendor",
                "name",
                "os_versions",
                "maintainer"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^wiki$": true,
                "^os_versions$": true,
                "^name$": true,
                "^project_id$": true,
                "^vendor$": true,
                "^maintainer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string",
                  "pattern": "^[a-z\\d_\\.-]+@([a-z\\d\\.-]+\\.)+[a-z]+$"
                },
                "irc": {
                  "type": "string"
                },
                "launchpad_id": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true,
                "^irc$": true,
                "^launchpad_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "verification": {
                  "enum": [
                    "self_verification"
                  ]
                },
                "os_version": {
                  "type": "string"
                },
                "success": {
                  "type": "boolean"
                }
              },
              "required": [
                "verification",
                "os_version",
                "success"
              ]
            },
            {
              "patternProperties": {
                "^verification$": true,
                "^os_version$": true,
                "^success$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "self_verification": {
      "$ref": "#/$defs/modern_2"
    },
    "external_ci_verification": {
      "$ref": "#/$defs/modern_4"
    },
    "3rd_party_verification": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "verification": {
                  "enum": [
                    "3rd_party_verification"
                  ]
                },
                "os_version": {
                  "type": "string"
                },
                "success": {
                  "type": "boolean"
                },
                "verifiers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/user"
                  }
                }
              },
              "required": [
                "verification",
                "os_version",
                "success",
                "verifiers"
              ]
            },
            {
              "patternProperties": {
                "^verification$": true,
                "^os_version$": true,
                "^success$": true,
                "^verifiers$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "user": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "verification": {
                  "enum": [
                    "external_ci_verification"
                  ]
                },
                "ci_id": {
                  "type": "string"
                }
              },
              "required": [
                "verification",
                "ci_id"
              ]
            },
            {
              "patternProperties": {
                "^verification$": true,
                "^ci_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
