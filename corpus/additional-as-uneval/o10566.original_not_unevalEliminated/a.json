{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/$defs/subdocument"
    },
    {
      "required": [
        "_id"
      ]
    }
  ],
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "$date": {
                  "type": "integer"
                }
              },
              "required": [
                "$date"
              ]
            },
            {
              "patternProperties": {
                "^$date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "$binary": {
                  "type": "string"
                },
                "$type": {
                  "type": "string",
                  "pattern": "[a-z0-9]"
                }
              },
              "required": [
                "$binary",
                "$type"
              ]
            },
            {
              "patternProperties": {
                "^$binary$": true,
                "^$type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "$timestamp": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "$timestamp": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "$timestamp"
              ]
            },
            {
              "patternProperties": {
                "^$timestamp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "subdocument": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "$oid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{24}$"
                }
              },
              "required": [
                "$oid"
              ]
            },
            {
              "patternProperties": {
                "^$oid$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/$binary"
        },
        {
          "$ref": "#/$defs/$date"
        },
        {
          "$ref": "#/$defs/$oid"
        },
        {
          "$ref": "#/$defs/$timestamp"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          }
        },
        {
          "$ref": "#/$defs/subdocument"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[^$]": {
                  "$ref": "#/$defs/value"
                }
              }
            },
            {
              "patternProperties": {
                "^[^$]": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "$oid": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "t": {
                  "type": "integer"
                },
                "i": {
                  "type": "integer"
                }
              },
              "required": [
                "t",
                "i"
              ]
            },
            {
              "patternProperties": {
                "^t$": true,
                "^i$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "$date": {
      "$ref": "#/$defs/modern_5"
    },
    "$binary": {
      "$ref": "#/$defs/modern_6"
    }
  }
}
