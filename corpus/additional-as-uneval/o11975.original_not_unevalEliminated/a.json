{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A squadron for the X-Wing Miniatures Game in app-independent format for sharing, saving and moving between apps.",
              "properties": {
                "name": {
                  "description": "The name of the squadron.",
                  "type": "string"
                },
                "description": {
                  "description": "A description of this squadron.",
                  "type": "string"
                },
                "version": {
                  "description": "The version of the XWS spec used to create this data",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                  "type": "string"
                },
                "points": {
                  "description": "The total points spent creating this squadron.",
                  "type": "integer"
                },
                "faction": {
                  "description": "The faction this squadron belongs to.",
                  "enum": [
                    "rebel",
                    "imperial",
                    "scum"
                  ],
                  "type": "string"
                },
                "obstacles": {
                  "description": "Array of three Strings, each being an identifier for the obstacle chosen for tournament use.",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 3,
                  "minItems": 3,
                  "type": "array"
                },
                "pilots": {
                  "description": "The members of this squadron.",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "type": "array"
                },
                "vendor": {
                  "description": "An extensible object containing app-specific data. Developers should put extra data here under their own namespace.",
                  "maxProperties": 1,
                  "minProperties": 1,
                  "type": "object"
                }
              },
              "required": [
                "version",
                "faction",
                "pilots"
              ],
              "title": "X-Wing Squadron Format Schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^version$": true,
                "^obstacles$": true,
                "^description$": true,
                "^faction$": true,
                "^name$": true,
                "^points$": true,
                "^vendor$": true,
                "^pilots$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "minItems": 1,
              "properties": {
                "name": {
                  "pattern": "^[0-9a-z]+$",
                  "type": "string"
                },
                "upgrades": {
                  "$ref": "#/$defs/modern_3"
                },
                "multisection_id": {
                  "type": "integer"
                },
                "shields": {
                  "description": "Shield value for the ship",
                  "type": "integer"
                },
                "points": {
                  "description": "The total points spent creating this squadron.",
                  "type": "integer"
                },
                "vendor": {
                  "description": "An extensible object containing app-specific data. Developers should put extra data here under their own namespace.",
                  "maxProperties": 1,
                  "minProperties": 1,
                  "type": "object"
                },
                "hull": {
                  "description": "Hull value for the ship",
                  "type": "integer"
                },
                "ship": {
                  "pattern": "^[0-9a-z]+$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "ship"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^upgrades$": true,
                "^ship$": true,
                "^hull$": true,
                "^points$": true,
                "^name$": true,
                "^shields$": true,
                "^vendor$": true,
                "^multisection_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "minProperties": 1,
              "patternProperties": {
                "^[0-9a-z]+$": {
                  "items": {
                    "pattern": "^[0-9a-z]+$",
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^[0-9a-z]+$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
