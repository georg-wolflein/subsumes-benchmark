{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": {
                "$ref": "#/$defs/modern_2"
              },
              "self": {
                "format": "jsonschema",
                "name": "category/items",
                "vendor": "com.nordstrom",
                "version": "1-0-0"
              },
              "type": "array"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "category": {
                  "type": "string"
                }
              },
              "required": [
                "category"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^category$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
