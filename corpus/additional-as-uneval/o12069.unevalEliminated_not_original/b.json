{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": {
                "$ref": "#/$defs/modern_2"
              },
              "self": {
                "format": "jsonschema",
                "name": "product/items",
                "vendor": "com.nordstrom",
                "version": "1-0-0"
              },
              "type": "array"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "image": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "brand": {
                  "type": "string"
                },
                "id": {
                  "pattern": "^[\\d]+$",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "brand",
                "name",
                "description"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^image$": true,
                "^name$": true,
                "^id$": true,
                "^brand$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
