{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "body": {
                  "$ref": "#/$defs/modern_2"
                },
                "headers": {
                  "$ref": "#/$defs/modern_3"
                },
                "httpMethod": {
                  "pattern": "^POST$",
                  "type": "string"
                },
                "path": {
                  "pattern": "^/product-photos$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "httpMethod",
                "headers"
              ],
              "self": {
                "format": "jsonschema",
                "name": "product-photos/assignment-record",
                "vendor": "com.nordstrom",
                "version": "1-0-0"
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^body$": true,
                "^headers$": true,
                "^httpMethod$": true,
                "^path$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "Body": {
                  "type": "string"
                },
                "From": {
                  "pattern": "^\\+?[1-9]\\d{1,14}$",
                  "type": "string"
                },
                "MediaUrl0": {
                  "format": "url",
                  "type": "string"
                },
                "NumMedia": {
                  "pattern": "^\\d+$",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^Body$": true,
                "^From$": true,
                "^MediaUrl0$": true,
                "^NumMedia$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "X-Twilio-Signature": {
                  "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)$",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^X-Twilio-Signature$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
