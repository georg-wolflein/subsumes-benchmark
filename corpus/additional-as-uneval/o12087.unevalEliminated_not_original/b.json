{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": {
                "$ref": "#/$defs/modern_2"
              },
              "self": {
                "format": "jsonschema",
                "name": "score/items",
                "vendor": "com.nordstrom",
                "version": "1-0-0"
              },
              "type": "array"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "role": {
                  "type": "string"
                },
                "score": {
                  "type": "number"
                },
                "userId": {
                  "type": "string"
                }
              },
              "required": [
                "score",
                "userId"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^role$": true,
                "^score$": true,
                "^userId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
