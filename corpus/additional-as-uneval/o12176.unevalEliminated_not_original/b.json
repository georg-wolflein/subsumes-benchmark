{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "info object (section 5.1.3)",
              "type": "object",
              "required": [
                "title",
                "description"
              ],
              "properties": {
                "termsOfServiceUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "description": {
                  "type": "string"
                },
                "contact": {
                  "type": "string",
                  "format": "email"
                },
                "license": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "licenseUrl": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            {
              "patternProperties": {
                "^description$": true,
                "^title$": true,
                "^license$": true,
                "^licenseUrl$": true,
                "^termsOfServiceUrl$": true,
                "^contact$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
