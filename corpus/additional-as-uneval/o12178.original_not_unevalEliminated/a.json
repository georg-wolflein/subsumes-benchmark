{
  "$id": "https://raw.githubusercontent.com/OAI/OpenAPI-Specification/master/schemas/v1.2/oauth2GrantType.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "minProperties": 1,
  "properties": {
    "implicit": {
      "$ref": "#/$defs/implicit"
    },
    "authorization_code": {
      "$ref": "#/$defs/authorizationCode"
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "tokenName": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^url$": true,
                "^tokenName$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "authorizationCode": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "tokenEndpoint",
                "tokenRequestEndpoint"
              ],
              "properties": {
                "tokenEndpoint": {
                  "$ref": "#/$defs/tokenEndpoint"
                },
                "tokenRequestEndpoint": {
                  "$ref": "#/$defs/tokenRequestEndpoint"
                }
              }
            },
            {
              "patternProperties": {
                "^tokenEndpoint$": true,
                "^tokenRequestEndpoint$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "loginEndpoint": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            {
              "patternProperties": {
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "implicit": {
      "$ref": "#/$defs/modern_3"
    },
    "tokenRequestEndpoint": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "loginEndpoint"
              ],
              "properties": {
                "loginEndpoint": {
                  "$ref": "#/$defs/loginEndpoint"
                },
                "tokenName": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^loginEndpoint$": true,
                "^tokenName$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "tokenEndpoint": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "clientIdName": {
                  "type": "string"
                },
                "clientSecretName": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^url$": true,
                "^clientIdName$": true,
                "^clientSecretName$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
