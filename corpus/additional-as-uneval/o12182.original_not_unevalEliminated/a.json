{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "description": {
                  "type": "string"
                },
                "path": {
                  "_format": "uri",
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^path$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
