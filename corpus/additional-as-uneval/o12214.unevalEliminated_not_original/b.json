{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "description": "News title : used only for notification system",
                  "type": "string"
                },
                "comment": {
                  "type": "string"
                },
                "info_id": {
                  "type": "integer"
                }
              },
              "required": [
                "info_id",
                "comment"
              ]
            },
            {
              "patternProperties": {
                "^title$": true,
                "^comment$": true,
                "^info_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
