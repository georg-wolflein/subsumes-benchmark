{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "minItems",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o12228.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o12228.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "question": {
                    "type": "string"
                  },
                  "_id": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "answers": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "minItems": 2
                  },
                  "end": {
                    "type": "string"
                  }
                },
                "required": [
                  "question",
                  "answers",
                  "end"
                ]
              },
              {
                "patternProperties": {
                  "^question$": true,
                  "^end$": true,
                  "^_id$": true,
                  "^icon$": true,
                  "^answers$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "votes": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              },
              {
                "patternProperties": {
                  "^value$": true,
                  "^votes$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "_id": {
        "type": "string"
      },
      "icon": {
        "type": "string"
      },
      "question": {
        "type": "string"
      },
      "end": {
        "type": "string"
      },
      "answers": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string"
            },
            "votes": {
              "type": "array",
              "additionalProperties": false,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "minItems": 2
      }
    },
    "required": [
      "question",
      "answers",
      "end"
    ]
  }
}
