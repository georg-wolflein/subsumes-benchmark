{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "question": {
                  "type": "string"
                },
                "_id": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "answers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "minItems": 2
                },
                "end": {
                  "type": "string"
                }
              },
              "required": [
                "question",
                "answers",
                "end"
              ]
            },
            {
              "patternProperties": {
                "^question$": true,
                "^end$": true,
                "^_id$": true,
                "^icon$": true,
                "^answers$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "votes": {
                  "$ref": "#/$defs/modern_3"
                }
              }
            },
            {
              "patternProperties": {
                "^value$": true,
                "^votes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
