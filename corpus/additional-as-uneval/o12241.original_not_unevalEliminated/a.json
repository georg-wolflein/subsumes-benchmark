{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "string",
                  "maxLength": 255
                },
                "description": {
                  "type": "string"
                },
                "school_id": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36
                },
                "category": {
                  "type": "string",
                  "maxLength": 255
                },
                "attachments": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "subject",
                "description",
                "category",
                "school_id"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^category$": true,
                "^subject$": true,
                "^school_id$": true,
                "^attachments$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/modern_3"
              }
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "type": "integer",
                  "minimum": 1.0
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true,
                "^size$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
