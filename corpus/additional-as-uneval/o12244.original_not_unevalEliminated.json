{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "maxLength",
    "minLength",
    "minimum",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o12244.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o12244.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "description": {
                    "type": "string"
                  },
                  "school_id": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36
                  },
                  "newComment": {
                    "type": "string"
                  },
                  "status": {
                    "description": "A value of enum TicketStatus.java",
                    "enum": [
                      1,
                      2,
                      3,
                      4
                    ]
                  },
                  "category": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "attachments": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^description$": true,
                  "^newComment$": true,
                  "^category$": true,
                  "^status$": true,
                  "^subject$": true,
                  "^school_id$": true,
                  "^attachments$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              {
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1.0
                  }
                }
              },
              {
                "patternProperties": {
                  "^id$": true,
                  "^name$": true,
                  "^size$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "subject": {
        "type": "string",
        "maxLength": 255
      },
      "description": {
        "type": "string"
      },
      "category": {
        "type": "string",
        "maxLength": 255
      },
      "school_id": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36
      },
      "status": {
        "description": "A value of enum TicketStatus.java",
        "enum": [
          1,
          2,
          3,
          4
        ]
      },
      "newComment": {
        "type": "string"
      },
      "attachments": {
        "type": "array",
        "additionalProperties": false,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
