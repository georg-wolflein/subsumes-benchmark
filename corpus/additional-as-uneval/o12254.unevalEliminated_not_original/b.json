{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "saisie_cpe": {
                  "type": "boolean"
                },
                "timestamp_depart": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "commentaire": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "timestamp_arrive": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "id_type": {
                  "type": "integer"
                },
                "id_appel": {
                  "type": "integer"
                },
                "id_eleve": {
                  "type": "string"
                },
                "id_motif": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "id_pj": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              },
              "required": [
                "saisie_cpe",
                "id_eleve",
                "id_appel",
                "id_type"
              ]
            },
            {
              "patternProperties": {
                "^id_appel$": true,
                "^timestamp_depart$": true,
                "^id_pj$": true,
                "^id_motif$": true,
                "^id_type$": true,
                "^timestamp_arrive$": true,
                "^saisie_cpe$": true,
                "^commentaire$": true,
                "^id_eleve$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
