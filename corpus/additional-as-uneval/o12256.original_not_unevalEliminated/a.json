{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "EventsIds": true,
                "MotifId": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^EventsIds$": true,
                "^MotifId$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
