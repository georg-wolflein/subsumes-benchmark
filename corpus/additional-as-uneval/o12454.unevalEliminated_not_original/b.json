{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "brand": {
                  "$ref": "#/$defs/brandData",
                  "description": "Brand data for the well group (e.g. for tubes)"
                },
                "metadata": {
                  "$ref": "#/$defs/modern_6"
                },
                "wells": {
                  "description": "An array of wells that contain the same metadata",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array"
                }
              },
              "required": [
                "wells",
                "metadata"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^brand$": true,
                "^metadata$": true,
                "^wells$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Metadata specific to a grid of wells in a labware",
              "properties": {
                "displayCategory": {
                  "$ref": "#/$defs/displayCategory",
                  "description": "Label(s) used in UI to categorize well groups"
                },
                "displayName": {
                  "description": "User-readable name for the well group",
                  "type": "string"
                },
                "wellBottomShape": {
                  "description": "Bottom shape of the well for UI purposes",
                  "enum": [
                    "flat",
                    "u",
                    "v"
                  ],
                  "type": "string"
                }
              },
              "required": [],
              "type": "object"
            },
            {
              "patternProperties": {
                "^displayCategory$": true,
                "^displayName$": true,
                "^wellBottomShape$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Properties used for search and display",
              "properties": {
                "displayCategory": {
                  "$ref": "#/$defs/displayCategory",
                  "description": "Label(s) used in UI to categorize labware"
                },
                "displayName": {
                  "description": "Easy to remember name of labware",
                  "type": "string"
                },
                "displayVolumeUnits": {
                  "description": "Volume units for display",
                  "enum": [
                    "\u00b5L",
                    "mL",
                    "L"
                  ],
                  "type": "string"
                },
                "tags": {
                  "description": "List of descriptions for a given labware",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "displayName",
                "displayCategory",
                "displayVolumeUnits"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^displayCategory$": true,
                "^displayName$": true,
                "^displayVolumeUnits$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "brand": {
                  "description": "Brand/manufacturer name",
                  "type": "string"
                },
                "brandId": {
                  "description": "An array of manufacture numbers pertaining to a given labware",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "links": {
                  "description": "URLs for manufacturer page(s)",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "brand"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^brand$": true,
                "^brandId$": true,
                "^links$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Distance from left-front-bottom corner of slot to left-front-bottom corner of labware bounding box. Used for labware that spans multiple slots. For labware that does not span multiple slots, x/y/z should all be zero.",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^x$": true,
                "^y$": true,
                "^z$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "displayCategory": {
      "enum": [
        "tipRack",
        "tubeRack",
        "reservoir",
        "trash",
        "wellPlate",
        "aluminumBlock",
        "other"
      ],
      "type": "string"
    },
    "brandData": {
      "$ref": "#/$defs/modern_1"
    },
    "safeString": {
      "description": "a string safe to use for loadName / namespace. Lowercase-only.",
      "pattern": "^[a-z0-9._]+$",
      "type": "string"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Internal describers used to determine pipette movement to labware",
              "properties": {
                "format": {
                  "description": "Property to determine compatibility with multichannel pipette",
                  "enum": [
                    "96Standard",
                    "384Standard",
                    "trough",
                    "irregular",
                    "trash"
                  ],
                  "type": "string"
                },
                "tipOverlap": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "Required if labware is tiprack, specifies the length of the area of the tip that overlaps the nozzle of the pipette"
                },
                "tipLength": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "Required if labware is tiprack, specifies length of tip from drawing or as measured with calipers"
                },
                "isMagneticModuleCompatible": {
                  "description": "Flag marking whether a labware is compatible by default with the Magnetic Module",
                  "type": "boolean"
                },
                "quirks": {
                  "description": "Property to classify a specific behavior this labware should have",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "magneticModuleEngageHeight": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "Distance to move magnetic module magnets to engage"
                },
                "isTiprack": {
                  "description": "Flag marking whether a labware is a tiprack or not",
                  "type": "boolean"
                },
                "loadName": {
                  "$ref": "#/$defs/safeString",
                  "description": "Name used to reference a labware definition"
                }
              },
              "required": [
                "format",
                "isTiprack",
                "loadName",
                "isMagneticModuleCompatible"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^isTiprack$": true,
                "^format$": true,
                "^loadName$": true,
                "^quirks$": true,
                "^isMagneticModuleCompatible$": true,
                "^tipLength$": true,
                "^tipOverlap$": true,
                "^magneticModuleEngageHeight$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Outer dimensions of a labware",
              "properties": {
                "xDimension": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "yDimension": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "zDimension": {
                  "$ref": "#/$defs/positiveNumber"
                }
              },
              "required": [
                "xDimension",
                "yDimension",
                "zDimension"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^xDimension$": true,
                "^yDimension$": true,
                "^zDimension$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Unordered object of well objects with position and dimensional information",
              "minProperties": 1,
              "patternProperties": {
                "[A-Z]+[0-9]+": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "[A-Z]+[0-9]+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "diameter",
                      "xDimension"
                    ]
                  },
                  {
                    "required": [
                      "diameter",
                      "yDimension"
                    ]
                  }
                ]
              },
              "oneOf": [
                {
                  "required": [
                    "xDimension",
                    "yDimension"
                  ]
                },
                {
                  "required": [
                    "diameter"
                  ]
                }
              ],
              "properties": {
                "xDimension": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "x dimension of rectangular wells"
                },
                "x": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "x location of center-bottom of well in reference to left-front-bottom of labware"
                },
                "y": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "y location of center-bottom of well in reference to left-front-bottom of labware"
                },
                "yDimension": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "y dimension of rectangular wells"
                },
                "totalLiquidVolume": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "Total well, tube, or tip volume in microliters"
                },
                "shape": {
                  "description": "If 'rectangular', use xDimension and yDimension; if 'circular' use diameter",
                  "enum": [
                    "rectangular",
                    "circular"
                  ],
                  "type": "string"
                },
                "z": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "z location of center-bottom of well in reference to left-front-bottom of labware"
                },
                "diameter": {
                  "$ref": "#/$defs/positiveNumber",
                  "description": "diameter of circular wells"
                },
                "depth": {
                  "$ref": "#/$defs/positiveNumber"
                }
              },
              "required": [
                "depth",
                "shape",
                "totalLiquidVolume",
                "x",
                "y",
                "z"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^x$": true,
                "^z$": true,
                "^shape$": true,
                "^diameter$": true,
                "^y$": true,
                "^yDimension$": true,
                "^xDimension$": true,
                "^totalLiquidVolume$": true,
                "^depth$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "wells": {
                  "$ref": "#/$defs/modern_3"
                },
                "groups": {
                  "description": "Logical well groupings for metadata/display purposes; changes in groups do not affect protocol execution",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "type": "array"
                },
                "brand": {
                  "$ref": "#/$defs/brandData",
                  "description": "Real-world labware that the definition is modeled from and/or compatible with"
                },
                "cornerOffsetFromSlot": {
                  "$ref": "#/$defs/modern_7"
                },
                "version": {
                  "description": "Version of the labware definition itself (eg myPlate v1/v2/v3). An incrementing integer",
                  "minimum": 1.0,
                  "type": "integer"
                },
                "schemaVersion": {
                  "description": "Which schema version a labware is using",
                  "enum": [
                    2
                  ],
                  "type": "number"
                },
                "parameters": {
                  "$ref": "#/$defs/modern_8"
                },
                "namespace": {
                  "$ref": "#/$defs/safeString"
                },
                "ordering": {
                  "description": "Generated array that keeps track of how wells should be ordered in a labware",
                  "items": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "type": "array"
                },
                "dimensions": {
                  "$ref": "#/$defs/modern_9"
                },
                "metadata": {
                  "$ref": "#/$defs/modern_10"
                }
              },
              "required": [
                "schemaVersion",
                "version",
                "namespace",
                "metadata",
                "brand",
                "parameters",
                "cornerOffsetFromSlot",
                "ordering",
                "dimensions",
                "wells",
                "groups"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^version$": true,
                "^cornerOffsetFromSlot$": true,
                "^wells$": true,
                "^ordering$": true,
                "^namespace$": true,
                "^brand$": true,
                "^parameters$": true,
                "^dimensions$": true,
                "^groups$": true,
                "^schemaVersion$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "positiveNumber": {
      "minimum": 0.0,
      "type": "number"
    }
  }
}
