{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Module specifications",
  "type": "object",
  "$comment": "Example key: 'magdeck'",
  "patternProperties": {
    ".*": {
      "$ref": "#/$defs/modern_2"
    }
  },
  "$defs": {
    "coordinates": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "x",
                "y"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^x$": true,
                "^y$": true,
                "^z$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "labwareOffset",
                "dimensions",
                "calibrationPoint",
                "displayName",
                "loadName",
                "quirks"
              ],
              "properties": {
                "displayName": {
                  "type": "string"
                },
                "labwareOffset": {
                  "$ref": "#/$defs/coordinates"
                },
                "quirks": {
                  "type": "array",
                  "description": "List of quirks for a given module",
                  "items": {
                    "type": "string"
                  }
                },
                "dimensions": {
                  "type": "object",
                  "required": [
                    "bareOverallHeight",
                    "overLabwareHeight"
                  ],
                  "properties": {
                    "bareOverallHeight": {
                      "type": "number"
                    },
                    "overLabwareHeight": {
                      "type": "number"
                    },
                    "lidHeight": {
                      "type": "number"
                    }
                  }
                },
                "calibrationPoint": {
                  "$ref": "#/$defs/coordinates"
                },
                "loadName": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^calibrationPoint$": true,
                "^loadName$": true,
                "^quirks$": true,
                "^labwareOffset$": true,
                "^displayName$": true,
                "^dimensions$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
