{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Object containing linear equations for translating between uL of liquid and mm of plunger travel. There is one linear equation for aspiration and one for dispense",
              "type": "object",
              "required": [
                "aspirate",
                "dispense"
              ],
              "properties": {
                "aspirate": {
                  "$ref": "#/$defs/linearEquations"
                },
                "dispense": {
                  "$ref": "#/$defs/linearEquations"
                }
              }
            },
            {
              "patternProperties": {
                "^aspirate$": true,
                "^dispense$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "xyzArray": {
      "type": "array",
      "description": "Array of 3 numbers, [x, y, z]",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "name",
                "top",
                "bottom",
                "blowout",
                "dropTip",
                "pickUpCurrent",
                "pickUpDistance",
                "pickUpIncrement",
                "pickUpPresses",
                "pickUpSpeed",
                "modelOffset",
                "plungerCurrent",
                "dropTipCurrent",
                "dropTipSpeed",
                "ulPerMm",
                "tipLength"
              ],
              "properties": {
                "name": {
                  "description": "reference to name of this version, should match a key in corresponding pipetteNameSpecs.json file",
                  "type": "string"
                },
                "dropTip": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "pickUpPresses": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "plungerCurrent": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "tipLength": {
                  "type": "object",
                  "value": {
                    "$ref": "#/$defs/positiveNumber"
                  }
                },
                "quirks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "backCompatNames": {
                  "description": "Optional reference for name of backwards compatible pipette corresponding to a key in pipetteNameSpecs.json, only relevant to gen2 pipettes",
                  "type": "array"
                },
                "pickUpSpeed": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "idleCurrent": {
                  "$ref": "#/$defs/idleCurrentRange"
                },
                "dropTipSpeed": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "pickUpDistance": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "modelOffset": {
                  "$ref": "#/$defs/xyzArray"
                },
                "blowout": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "tipOverlap": {
                  "$ref": "#/$defs/modern_4"
                },
                "pickUpIncrement": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "bottom": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "pickUpCurrent": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "dropTipCurrent": {
                  "$ref": "#/$defs/editConfigurations"
                },
                "returnTipHeight": {
                  "$ref": "#/$defs/returnTipHeightRange"
                },
                "ulPerMm": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/liquidHandlingSpecs"
                  }
                },
                "top": {
                  "$ref": "#/$defs/editConfigurations"
                }
              }
            },
            {
              "patternProperties": {
                "^bottom$": true,
                "^pickUpCurrent$": true,
                "^backCompatNames$": true,
                "^quirks$": true,
                "^pickUpDistance$": true,
                "^plungerCurrent$": true,
                "^name$": true,
                "^dropTipSpeed$": true,
                "^tipLength$": true,
                "^pickUpPresses$": true,
                "^tipOverlap$": true,
                "^pickUpSpeed$": true,
                "^dropTip$": true,
                "^dropTipCurrent$": true,
                "^blowout$": true,
                "^pickUpIncrement$": true,
                "^returnTipHeight$": true,
                "^top$": true,
                "^modelOffset$": true,
                "^ulPerMm$": true,
                "^idleCurrent$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "idleCurrentRange": {
      "type": "number",
      "minimum": 0.01,
      "maximum": 1.0
    },
    "linearEquations": {
      "description": "Array containing any number of 3-arrays. Each inner 3-array describes a line segment: [boundary, slope, intercept]. So [1, 2, 3] would mean 'where (next_boundary > x >= 1), y = 2x + 3'",
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      }
    },
    "returnTipHeightRange": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 1.25
    },
    "liquidHandlingSpecs": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "config",
                "mutableConfigs"
              ],
              "properties": {
                "config": {
                  "description": "Version-level pipette specifications, which may vary across different versions of the same pipette",
                  "type": "object",
                  "$comment": "Example key: 'p10_single_v1.3'",
                  "patternProperties": {
                    ".*": {
                      "$ref": "#/$defs/modern_3"
                    }
                  }
                },
                "mutableConfigs": {
                  "type": "array",
                  "description": "Array of mutable configs for a given pipette",
                  "items": {
                    "type": "string"
                  }
                },
                "validQuirks": {
                  "type": "array",
                  "description": "Array of valid quirks for a given pipette",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^config$": true,
                "^mutableConfigs$": true,
                "^validQuirks$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "positiveNumber": {
      "type": "number",
      "minimum": 0.0
    },
    "editConfigurations": {
      "type": "object",
      "description": "Object allowing you to modify a config",
      "required": [
        "value"
      ],
      "properties": {
        "displayName": {
          "type": "string"
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "units": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "array"
          ]
        }
      }
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Map of tip overlap values with defaults",
              "required": [
                "default"
              ],
              "$comment": "Other keys in here should be labware URIs",
              "properties": {
                "default": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^default$": true
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        }
      ]
    }
  }
}
