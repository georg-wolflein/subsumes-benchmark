{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Model-level pipette specifications. These do not vary across different versions of the same model",
  "type": "object",
  "$comment": "Example key: 'p10_single'",
  "patternProperties": {
    ".*": {
      "type": "object",
      "required": [
        "channels",
        "displayName",
        "defaultAspirateFlowRate",
        "defaultDispenseFlowRate",
        "defaultBlowOutFlowRate",
        "maxVolume",
        "minVolume"
      ],
      "additionalProperties": false,
      "properties": {
        "channels": {
          "$ref": "#/$defs/channels"
        },
        "defaultAspirateFlowRate": {
          "value": {
            "$ref": "#/$defs/positiveNumber"
          },
          "min": {
            "$ref": "#/$defs/positiveNumber"
          },
          "max": {
            "$ref": "#/$defs/positiveNumber"
          }
        },
        "defaultDispenseFlowRate": {
          "value": {
            "$ref": "#/$defs/positiveNumber"
          },
          "min": {
            "$ref": "#/$defs/positiveNumber"
          },
          "max": {
            "$ref": "#/$defs/positiveNumber"
          }
        },
        "defaultBlowOutFlowRate": {
          "value": {
            "$ref": "#/$defs/positiveNumber"
          },
          "min": {
            "$ref": "#/$defs/positiveNumber"
          },
          "max": {
            "$ref": "#/$defs/positiveNumber"
          }
        },
        "displayName": {
          "type": "string"
        },
        "displayCategory": {
          "$ref": "#/$defs/displayCategory"
        },
        "maxVolume": {
          "$ref": "#/$defs/positiveNumber"
        },
        "minVolume": {
          "$ref": "#/$defs/positiveNumber"
        },
        "smoothieConfigs": {
          "type": "object",
          "description": "Runtime smoothie configs per pipette type",
          "properties": {
            "stepsPerMM": {
              "type": "number"
            },
            "homePosition": {
              "type": "number"
            },
            "travelDistance": {
              "type": "number"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "positiveNumber": {
      "type": "number",
      "minimum": 0
    },
    "channels": {
      "enum": [
        1,
        8
      ]
    },
    "displayCategory": {
      "type": "string",
      "enum": [
        "GEN1",
        "GEN2"
      ]
    }
  }
}
