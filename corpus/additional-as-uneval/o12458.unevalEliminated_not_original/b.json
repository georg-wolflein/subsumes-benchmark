{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Model-level pipette specifications. These do not vary across different versions of the same model",
  "type": "object",
  "$comment": "Example key: 'p10_single'",
  "patternProperties": {
    ".*": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "channels": {
      "enum": [
        1,
        8
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "channels",
                "displayName",
                "defaultAspirateFlowRate",
                "defaultDispenseFlowRate",
                "defaultBlowOutFlowRate",
                "maxVolume",
                "minVolume"
              ],
              "properties": {
                "displayName": {
                  "type": "string"
                },
                "channels": {
                  "$ref": "#/$defs/channels"
                },
                "smoothieConfigs": {
                  "type": "object",
                  "description": "Runtime smoothie configs per pipette type",
                  "properties": {
                    "stepsPerMM": {
                      "type": "number"
                    },
                    "homePosition": {
                      "type": "number"
                    },
                    "travelDistance": {
                      "type": "number"
                    }
                  }
                },
                "defaultDispenseFlowRate": {
                  "value": {
                    "$ref": "#/$defs/positiveNumber"
                  },
                  "min": {
                    "$ref": "#/$defs/positiveNumber"
                  },
                  "max": {
                    "$ref": "#/$defs/positiveNumber"
                  }
                },
                "minVolume": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "displayCategory": {
                  "$ref": "#/$defs/displayCategory"
                },
                "maxVolume": {
                  "$ref": "#/$defs/positiveNumber"
                },
                "defaultBlowOutFlowRate": {
                  "value": {
                    "$ref": "#/$defs/positiveNumber"
                  },
                  "min": {
                    "$ref": "#/$defs/positiveNumber"
                  },
                  "max": {
                    "$ref": "#/$defs/positiveNumber"
                  }
                },
                "defaultAspirateFlowRate": {
                  "value": {
                    "$ref": "#/$defs/positiveNumber"
                  },
                  "min": {
                    "$ref": "#/$defs/positiveNumber"
                  },
                  "max": {
                    "$ref": "#/$defs/positiveNumber"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^defaultAspirateFlowRate$": true,
                "^defaultDispenseFlowRate$": true,
                "^minVolume$": true,
                "^channels$": true,
                "^maxVolume$": true,
                "^defaultBlowOutFlowRate$": true,
                "^displayName$": true,
                "^displayCategory$": true,
                "^smoothieConfigs$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "positiveNumber": {
      "type": "number",
      "minimum": 0.0
    },
    "displayCategory": {
      "type": "string",
      "enum": [
        "GEN1",
        "GEN2"
      ]
    }
  }
}
