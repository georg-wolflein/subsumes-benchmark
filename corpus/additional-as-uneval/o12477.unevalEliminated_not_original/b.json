                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "creationDate": {
                  "type": "string"
                },
                "annotationLevels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "toolHelp": {
                  "type": "string"
                },
                "derogation": {
                  "type": "string"
                },
                "corporaLanguageType": {
                  "type": "string"
                },
                "corporaLanguages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "lexiconFormats": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "conditionsOfUse": {
                  "type": "string"
                },
                "programmingLanguages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "toolFunctionalities": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "toolId": {
                  "type": "string"
                },
                "toolLanguages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "image": {
                  "type": "string"
                },
                "statusOfUse": {
                  "type": "string"
                },
                "lexiconInputCount": {
                  "type": "string"
                },
                "discourseTypes": {
                  "type": "array",
