                "toolUrl": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                },
                "publications": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "priority": {
                        "type": "string",
                        "enum": [
                          "primary",
                          "secondary"
                        ]
                      },
                      "value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "priority",
                      "value"
