                      },
                      "value": {
                        "type": "string"
                      }
                    }
                  }
                },
                "preview": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string",
                      "default": "line",
                      "enum": [
                        "line",
                        "slideshow"
                      ]
                    },
                    "paths": {
                      "type": "array",
