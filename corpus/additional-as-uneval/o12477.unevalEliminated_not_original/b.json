                    "type": "string"
                  }
                },
                "lexiconDescriptionTypes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "toolOutputData": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
