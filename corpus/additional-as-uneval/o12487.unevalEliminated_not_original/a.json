{
  "$id": "http://www.ortolang.fr/schema/rating/01",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "grade": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "esrAccessibility": {
      "type": "boolean"
    },
    "normalized": {
      "type": "boolean"
    },
    "preview": {
      "type": "boolean"
    },
    "description": {
      "type": "boolean"
    },
    "metadata": {
      "type": "boolean"
    },
    "content": {
      "type": "string"
    },
    "recommendations": {
      "type": "string"
    },
    "comments": {
      "type": "string"
    }
  },
  "required": [
    "grade",
    "score"
  ]
}
