{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "esrAccessibility": {
                  "type": "boolean"
                },
                "description": {
                  "type": "boolean"
                },
                "preview": {
                  "type": "boolean"
                },
                "score": {
                  "type": "number"
                },
                "normalized": {
                  "type": "boolean"
                },
                "grade": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "metadata": {
                  "type": "boolean"
                },
                "recommendations": {
                  "type": "string"
                },
                "comments": {
                  "type": "string"
                }
              },
              "required": [
                "grade",
                "score"
              ]
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^preview$": true,
                "^recommendations$": true,
                "^description$": true,
                "^grade$": true,
                "^score$": true,
                "^content$": true,
                "^comments$": true,
                "^normalized$": true,
                "^esrAccessibility$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
