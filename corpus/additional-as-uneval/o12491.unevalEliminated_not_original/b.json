{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Schema for metadata extracted from Microsoft Office and OpenDocument files",
              "type": "object",
              "properties": {
                "meta:word-count": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^meta:word-count$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
