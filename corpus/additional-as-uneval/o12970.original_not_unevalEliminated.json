{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o12970.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Grading Queue Message",
                "description": "A message describing a grading job to be run.",
                "type": "object",
                "required": [
                  "jobId",
                  "image",
                  "entrypoint",
                  "s3Bucket",
                  "s3RootKey"
                ],
                "properties": {
                  "s3Bucket": {
                    "description": "The AWS S3 bucket containing this job's files.",
                    "type": "string"
                  },
                  "image": {
                    "description": "The image that this job will be executed in.",
                    "type": "string"
                  },
                  "entrypoint": {
                    "description": "The script that will be run to start this job.",
                    "type": "string"
                  },
                  "s3RootKey": {
                    "description": "The root key for th job's files.",
                    "type": "string"
                  },
                  "jobId": {
                    "description": "The unique ID for this job.",
                    "type": [
                      "string",
                      "integer"
                    ]
                  },
                  "timeout": {
                    "description": "The number of seconds after which the grading job will timeout.",
                    "type": "integer"
                  }
                }
              },
              {
                "patternProperties": {
                  "^image$": true,
                  "^entrypoint$": true,
                  "^jobId$": true,
                  "^s3RootKey$": true,
                  "^s3Bucket$": true,
                  "^timeout$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Grading Queue Message",
    "description": "A message describing a grading job to be run.",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "jobId",
      "image",
      "entrypoint",
      "s3Bucket",
      "s3RootKey"
    ],
    "properties": {
      "jobId": {
        "description": "The unique ID for this job.",
        "type": [
          "string",
          "integer"
        ]
      },
      "image": {
        "description": "The image that this job will be executed in.",
        "type": "string"
      },
      "entrypoint": {
        "description": "The script that will be run to start this job.",
        "type": "string"
      },
      "timeout": {
        "description": "The number of seconds after which the grading job will timeout.",
        "type": "integer"
      },
      "s3Bucket": {
        "description": "The AWS S3 bucket containing this job's files.",
        "type": "string"
      },
      "s3RootKey": {
        "description": "The root key for th job's files.",
        "type": "string"
      }
    }
  }
