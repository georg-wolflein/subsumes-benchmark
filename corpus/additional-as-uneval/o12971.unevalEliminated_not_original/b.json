{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Admin Query",
              "description": "Description of an administrator SQL query.",
              "type": "object",
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "description": "Brief one-line description of the query.",
                  "type": "string"
                },
                "resultFormats": {
                  "$ref": "#/$defs/modern_2"
                },
                "params": {
                  "description": "Parameters for the query.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^description$": true,
                "^resultFormats$": true,
                "^params$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Custom formats for result columns.",
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "pre"
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "description"
              ],
              "properties": {
                "name": {
                  "description": "Name of the parameter. Must match a $name in the SQL.",
                  "type": "string"
                },
                "description": {
                  "description": "Brief one-line description of the parameter.",
                  "type": "string"
                },
                "default": {
                  "description": "Default value.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^description$": true,
                "^default$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
