{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o13140.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Sample schema",
    "description": "Sample schema definition",
    "type": "object",
    "properties": {
      "foo": {
        "title": "Foo value",
        "description": "Some value of foo",
        "type": "string"
      },
      "bars": {
        "title": "Module many-to-many relationships",
        "description": "Configuration of many-to-many relationships",
        "type": "array",
        "items": {
          "allOf": [
            {
              "$ref": "#/$defs/testField"
            }
          ]
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "foo"
    ],
    "$defs": {
      "testField": {
        "title": "Module field name",
        "description": "A single module field name",
        "type": "string"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "testField": {
        "title": "Module field name",
        "description": "A single module field name",
        "type": "string"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Sample schema",
                "description": "Sample schema definition",
                "type": "object",
                "properties": {
                  "foo": {
                    "title": "Foo value",
                    "description": "Some value of foo",
                    "type": "string"
                  },
                  "bars": {
                    "title": "Module many-to-many relationships",
                    "description": "Configuration of many-to-many relationships",
                    "type": "array",
                    "items": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/testField"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "foo"
                ]
              },
              {
                "patternProperties": {
                  "^foo$": true,
                  "^bars$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
