{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "datestamp": {
                  "_format": "date-time",
                  "type": "string"
                },
                "testProp": {
                  "type": "string"
                }
              },
              "required": [
                "testProp",
                "datestamp"
              ],
              "self": {
                "format": "jsonschema",
                "name": "example",
                "vendor": "quicklime",
                "version": "1-0-0"
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^datestamp$": true,
                "^testProp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
