{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "displayName": {
                  "description": "Short name used for visualizing the symbol in a hierarchical structure. For example for symbol with a name 'sap.ui.core.Control' would be only 'Control'.",
                  "minLength": 1,
                  "type": "string"
                },
                "children": {
                  "items": {
                    "$ref": "#/$defs/symbol"
                  },
                  "type": "array"
                },
                "name": {
                  "minLength": 1,
                  "type": "string"
                },
                "implementedBy": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "deprecated": {
                  "type": "boolean"
                },
                "extendedBy": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "lib": {
                  "description": "Full library name",
                  "minLength": 1,
                  "type": "string"
                },
                "extends": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "namespace",
                    "class",
                    "interface",
                    "enum",
                    "typedef",
                    "function"
                  ],
                  "type": "string"
                },
                "visibility": {
                  "defaultValue": "public",
                  "enum": [
                    "public",
                    "protected",
                    "private",
                    "restricted"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "kind",
                "lib",
                "visibility"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^deprecated$": true,
                "^lib$": true,
                "^children$": true,
                "^name$": true,
                "^extendedBy$": true,
                "^implementedBy$": true,
                "^displayName$": true,
                "^visibility$": true,
                "^extends$": true,
                "^kind$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Schema that describes the structure of the api-index.json files that the documentation build can create for the Demo Kit",
              "properties": {
                "$schema-ref": {
                  "description": "A reference to this schema to make the structure of the file obvious.",
                  "enum": [
                    "http://schemas.sap.com/sapui5/designtime/api-index.json/1.0"
                  ],
                  "type": "string"
                },
                "name": {
                  "description": "Name representing the scope of libraries from which symbols are listed in this file",
                  "type": "string"
                },
                "symbols": {
                  "items": {
                    "$ref": "#/$defs/symbol"
                  },
                  "type": "array"
                },
                "version": {
                  "$ref": "#/$defs/version"
                }
              },
              "required": [
                "$schema-ref",
                "version",
                "name",
                "symbols"
              ],
              "title": "Schema for api-index.json files",
              "type": "object"
            },
            {
              "patternProperties": {
                "^$schema-ref$": true,
                "^name$": true,
                "^symbols$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "symbol": {
      "$ref": "#/$defs/modern_1"
    },
    "version": {
      "pattern": "^\\d+(\\.\\d+(\\.\\d+([.-][a-zA-Z0-9_-]+)?)?)?$",
      "type": "string"
    }
  }
}
