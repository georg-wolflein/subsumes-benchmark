{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "COBRA",
              "description": "JSON representation of COBRA model",
              "type": "object",
              "properties": {
                "genes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "name": {
                  "type": "string"
                },
                "compartments": {
                  "type": "object",
                  "patternProperties": {
                    "[a-z]{1,2}": {
                      "type": "string"
                    }
                  }
                },
                "annotation": {
                  "type": "object"
                },
                "version": {
                  "type": "integer",
                  "default": 1
                },
                "id": {
                  "type": "string"
                },
                "notes": {
                  "type": "object"
                },
                "metabolites": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "description": {
                  "type": "string"
                },
                "reactions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "id",
                "reactions",
                "metabolites",
                "genes"
              ]
            },
            {
              "patternProperties": {
                "^annotation$": true,
                "^version$": true,
                "^description$": true,
                "^notes$": true,
                "^reactions$": true,
                "^name$": true,
                "^id$": true,
                "^metabolites$": true,
                "^compartments$": true,
                "^genes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "notes": {
                  "type": "object"
                },
                "annotation": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true,
                "^notes$": true,
                "^annotation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "annotation": {
                  "type": "object"
                },
                "id": {
                  "type": "string"
                },
                "formula": {
                  "type": "string"
                },
                "_bound": {
                  "type": "number",
                  "default": 0
                },
                "charge": {
                  "type": "integer"
                },
                "notes": {
                  "type": "object"
                },
                "_constraint_sense": {
                  "type": "string",
                  "default": "E",
                  "pattern": "E|L|G"
                },
                "compartment": {
                  "type": "string",
                  "pattern": "[a-z]{1,2}"
                }
              },
              "required": [
                "id",
                "name",
                "compartment"
              ]
            },
            {
              "patternProperties": {
                "^formula$": true,
                "^annotation$": true,
                "^_constraint_sense$": true,
                "^notes$": true,
                "^name$": true,
                "^id$": true,
                "^compartment$": true,
                "^_bound$": true,
                "^charge$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "variable_kind": {
                  "type": "string",
                  "pattern": "integer|continuous",
                  "default": "continuous"
                },
                "name": {
                  "type": "string"
                },
                "objective_coefficient": {
                  "type": "number",
                  "default": 0
                },
                "upper_bound": {
                  "type": "number"
                },
                "annotation": {
                  "type": "object"
                },
                "gene_reaction_rule": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "notes": {
                  "type": "object"
                },
                "lower_bound": {
                  "type": "number"
                },
                "subsystem": {
                  "type": "string"
                },
                "metabolites": {
                  "type": "object",
                  "patternProperties": {
                    ".*": {
                      "type": "number"
                    }
                  }
                }
              },
              "required": [
                "id",
                "name",
                "metabolites",
                "lower_bound",
                "upper_bound",
                "gene_reaction_rule"
              ]
            },
            {
              "patternProperties": {
                "^notes$": true,
                "^gene_reaction_rule$": true,
                "^lower_bound$": true,
                "^name$": true,
                "^id$": true,
                "^metabolites$": true,
                "^subsystem$": true,
                "^variable_kind$": true,
                "^upper_bound$": true,
                "^objective_coefficient$": true,
                "^annotation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
