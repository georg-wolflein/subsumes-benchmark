{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "entities": {
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "type": "array"
                },
                "name": {
                  "type": "string"
                },
                "relations": {
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^entities$": true,
                "^name$": true,
                "^relations$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "nanoentities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^nanoentities$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "destination": {
                  "type": "string"
                },
                "origin": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "AGGREGATION",
                    "COMPOSITION",
                    "INHERITANCE"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^destination$": true,
                "^origin$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
