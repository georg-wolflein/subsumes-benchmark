{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "nanoentities": {
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^nanoentities$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "context": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^context$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
