{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "id": {
                  "type": "number"
                },
                "message": {
                  "type": "string"
                },
                "warnings": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^id$": true,
                "^message$": true,
                "^warnings$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
