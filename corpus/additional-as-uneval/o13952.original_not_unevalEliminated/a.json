{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "relations": {
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "type": "array"
                },
                "services": {
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "type": "array"
                },
                "useCaseResponsibility": {
                  "type": "object"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^relations$": true,
                "^services$": true,
                "^useCaseResponsibility$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "serviceA": {
                  "type": "string"
                },
                "serviceB": {
                  "type": "string"
                },
                "sharedEntities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^serviceA$": true,
                "^serviceB$": true,
                "^sharedEntities$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "nanoentities": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true,
                "^nanoentities$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
