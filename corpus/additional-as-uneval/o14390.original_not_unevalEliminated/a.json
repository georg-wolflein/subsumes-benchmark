    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "collector": {
                  "$ref": "#/$defs/collector"
                },
                "projectIssues": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-fA-F0-9]+$": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/issue"
                      },
                      "_uniqueItems": true
                    }
                  }
                },
                "commits": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/commit"
                  },
                  "_uniqueItems": true
                },
                "projectComponents": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-fA-F0-9]+$": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/component"
                      },
                      "_uniqueItems": true
                    }
                  }
                },
                "projectVersions": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-fA-F0-9]+$": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/version"
                      },
                      "_uniqueItems": true
                    }
                  }
                },
                "projects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/project"
                  },
                  "_uniqueItems": true
                },
                "contributors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/contributor"
                  },
                  "_uniqueItems": true
                }
              },
              "required": [
                "collector",
                "contributors",
                "commits",
                "projects",
                "projectComponents",
                "projectVersions",
                "projectIssues"
              ]
            },
            {
              "patternProperties": {
                "^projects$": true,
                "^projectComponents$": true,
                "^contributors$": true,
                "^collector$": true,
                "^projectVersions$": true,
                "^projectIssues$": true,
                "^commits$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
