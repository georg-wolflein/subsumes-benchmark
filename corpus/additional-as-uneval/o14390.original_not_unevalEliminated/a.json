{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_13",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "assignee": {
                  "type": "string",
                  "minLength": 1
                },
                "estimatedTime": {
                  "type": "string",
                  "format": "duration"
                },
                "components": {
                  "$ref": "#/$defs/stringArray"
                },
                "opened": {
                  "type": "string",
                  "format": "date-time"
                },
                "dueTo": {
                  "type": "string",
                  "format": "date-time"
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "OPEN",
                    "IN_PROGRESS",
                    "CLOSED"
                  ]
                },
                "childIssues": {
                  "$ref": "#/$defs/stringArray"
                },
                "creationDate": {
                  "type": "string",
                  "format": "date-time"
                },
                "severity": {
                  "enum": [
                    "BLOCKER",
                    "CRITICAL",
                    "SEVERE",
                    "LOW",
                    "TRIVIAL"
                  ]
                },
                "type": {
                  "enum": [
                    "BUG",
                    "IMPROVEMENT",
                    "TASK"
                  ]
                },
                "blockedIssues": {
                  "$ref": "#/$defs/stringArray"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "priority": {
                  "enum": [
                    "VERY_HIGH",
                    "HIGH",
                    "MEDIUM",
                    "LOW"
                  ]
                },
                "reporter": {
                  "type": "string",
                  "minLength": 1
                },
                "closed": {
                  "type": "string",
                  "format": "date-time"
                },
                "description": {
                  "type": "string"
                },
                "versions": {
                  "$ref": "#/$defs/stringArray"
                },
                "tags": {
                  "$ref": "#/$defs/stringArray"
                },
                "changes": {
                  "$ref": "#/$defs/changeLog"
                },
                "commits": {
                  "$ref": "#/$defs/stringArray"
                },
                "projectId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "projectId",
                "status",
                "severity",
                "priority",
                "creationDate",
                "opened",
                "reporter",
                "assignee",
                "id",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^dueTo$": true,
                "^closed$": true,
                "^estimatedTime$": true,
                "^severity$": true,
                "^status$": true,
                "^type$": true,
                "^assignee$": true,
                "^id$": true,
                "^projectId$": true,
                "^components$": true,
                "^opened$": true,
                "^tags$": true,
                "^childIssues$": true,
                "^versions$": true,
                "^blockedIssues$": true,
                "^description$": true,
                "^name$": true,
                "^reporter$": true,
                "^commits$": true,
                "^creationDate$": true,
                "^priority$": true,
                "^changes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "commit": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "entries": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/changeLogEntry"
                  },
                  "_uniqueItems": true
                }
              },
              "required": [
                "entries"
              ]
            },
            {
              "patternProperties": {
                "^entries$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "emails": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "email"
                  },
                  "minItems": 1,
                  "_uniqueItems": true
                }
              },
              "required": [
                "id",
                "name",
                "emails"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true,
                "^emails$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "_uniqueItems": true
    },
    "version": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "property": {
                  "type": "string",
                  "minLength": 1
                },
                "oldValue": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "property",
                "oldValue"
              ]
            },
            {
              "patternProperties": {
                "^property$": true,
                "^oldValue$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "changeLog": {
      "$ref": "#/$defs/modern_7"
    },
    "valueDeleted": {
      "$ref": "#/$defs/modern_8"
    },
    "modern_9": {
