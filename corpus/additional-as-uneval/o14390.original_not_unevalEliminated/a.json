    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "projectId",
                "id",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^projectId$": true,
                "^id$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
