                "newValue": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "property",
                "oldValue",
                "newValue"
              ]
            },
            {
              "patternProperties": {
                "^property$": true,
                "^oldValue$": true,
                "^newValue$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "property": {
                  "type": "string",
                  "minLength": 1
                },
                "newValue": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "property",
