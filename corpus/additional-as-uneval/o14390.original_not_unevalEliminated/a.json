                "author": {
                  "type": "string",
                  "minLength": 1
                },
                "timeStamp": {
                  "type": "string",
                  "format": "date-time"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "oneOf": [
                      {
                        "$ref": "#/$defs/valueAdded"
                      },
                      {
                        "$ref": "#/$defs/valueDeleted"
