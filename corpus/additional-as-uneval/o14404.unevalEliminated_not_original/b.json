{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "ControllerElement": {
      "type": "object",
      "properties": {
        "Label": {
          "type": "string"
        },
        "Type": {
          "type": "string",
          "enum": [
            "Button",
            "Directional",
            "AxisPositive",
            "AxisNegative",
            "Trigger",
            "Rumble",
            "Keyboard",
            "Pointer",
            "PointerAxisPositive",
            "PointerAxisNegative",
            "Touchscreen",
            "Gyroscope"
          ]
        }
      },
      "required": [
        "Label",
        "Type"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "LayoutID": {
                  "type": "string",
                  "pattern": "^[A-Z0-9_]+(_CONTROLLER|_DEVICE|_LAYOUT)$"
                },
                "FriendlyName": {
                  "type": "string"
                },
                "Platforms": {
                  "$ref": "#/$defs/modern_2"
                },
                "Layout": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "LayoutID",
                "FriendlyName",
                "Platforms",
                "Layout"
              ]
            },
            {
              "patternProperties": {
                "^LayoutID$": true,
                "^FriendlyName$": true,
                "^Platforms$": true,
                "^Layout$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "minItems": 1,
              "_uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
