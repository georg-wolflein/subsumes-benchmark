{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "LuminositySensor Schema",
              "type": "object",
              "required": [
                "LuminositySensor"
              ],
              "properties": {
                "_id": {
                  "$ref": "#/$defs/identificador"
                },
                "LuminositySensor": {
                  "$ref": "#/$defs/datos"
                }
              }
            },
            {
              "patternProperties": {
                "^_id$": true,
                "^LuminositySensor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "id",
              "description": "Id insertado del LuminositySensor",
              "type": "object",
              "properties": {
                "$oid": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^$oid$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "datos": {
      "$ref": "#/$defs/modern_2"
    },
    "gps": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "datos",
              "description": "Info LuminositySensor",
              "type": "object",
              "required": [
                "id",
                "va",
                "un",
                "loc"
              ],
              "properties": {
                "timestamp": {
                  "$ref": "#/$defs/modern_3"
                },
                "va": {
                  "type": "number"
                },
                "id": {
                  "type": "string"
                },
                "un": {
                  "type": "string"
                },
                "loc": {
                  "$ref": "#/$defs/gps"
                }
              }
            },
            {
              "patternProperties": {
                "^timestamp$": true,
                "^un$": true,
                "^id$": true,
                "^loc$": true,
                "^va$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "identificador": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "$date"
              ],
              "properties": {
                "$date": {
                  "type": "string",
                  "_format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^$date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "gps",
              "description": "Gps LuminositySensor",
              "type": "object",
              "required": [
                "la",
                "lon"
              ],
              "properties": {
                "al": {
                  "type": "number"
                },
                "la": {
                  "type": "number"
                },
                "lon": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^al$": true,
                "^la$": true,
                "^lon$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
