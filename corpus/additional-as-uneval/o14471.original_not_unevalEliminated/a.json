{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Errors",
              "description": "Define the errors for the API",
              "type": "object",
              "patternProperties": {
                "[a-zA-Z]+": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "[a-zA-Z]+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
