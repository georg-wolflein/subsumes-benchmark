{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "priority": {
                  "type": "integer",
                  "minimum": 0.0
                },
                "scope": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "mark_style": {
                  "type": "string",
                  "enum": [
                    "fill",
                    "outline",
                    "solid_underline",
                    "squiggly_underline",
                    "stippled_underline",
                    "none"
                  ]
                },
                "codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "_uniqueItems": true
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning"
                    ]
                  },
                  "minItems": 1,
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^types$": true,
                "^codes$": true,
                "^scope$": true,
                "^icon$": true,
                "^mark_style$": true,
                "^priority$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "delay": {
                  "type": "number"
                },
                "highlights.demote_while_editing": {
                  "type": "string",
                  "enum": [
                    "none",
                    "ws_only",
                    "some_ws",
                    "multilines",
                    "warnings",
                    "all"
                  ]
                },
                "statusbar.messages_template": {
                  "type": "string"
                },
                "kill_old_processes": {
                  "type": "boolean"
                },
                "no_column_highlights_line": {
                  "type": "boolean"
                },
                "styles": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "xperiments": {
                  "$ref": "#/$defs/modern_3"
                },
                "show_marks_in_minimap": {
                  "type": "boolean"
                },
                "lint_mode": {
                  "type": "string",
                  "enum": [
                    "background",
                    "load_save",
                    "manual",
                    "save"
                  ]
                },
                "linters": {
                  "$ref": "#/$defs/modern_4"
                },
                "highlights.start_hidden": {
                  "type": "boolean"
                },
                "show_panel_on_save": {
                  "type": "string",
                  "enum": [
                    "never",
                    "view",
                    "window"
                  ]
                },
                "paths": {
                  "type": "object"
                },
                "show_hover_region_report": {
                  "type": "boolean"
                },
                "debug": {
                  "type": "boolean"
                },
                "syntax_map": {
                  "type": "object"
                },
                "statusbar.show_active_linters": {
                  "type": "boolean"
                },
                "highlights.time_to_idle": {
                  "type": "number"
                },
                "show_hover_line_report": {
                  "type": "boolean"
                },
                "gutter_theme": {
                  "type": "string"
                },
                "highlights.demote_scope": {
                  "type": "string"
                },
                "statusbar.counters_template": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^show_hover_region_report$": true,
                "^linters$": true,
                "^highlights.time_to_idle$": true,
                "^highlights.start_hidden$": true,
                "^xperiments$": true,
                "^statusbar.counters_template$": true,
                "^show_marks_in_minimap$": true,
                "^delay$": true,
                "^statusbar.show_active_linters$": true,
                "^highlights.demote_while_editing$": true,
                "^statusbar.messages_template$": true,
                "^styles$": true,
                "^lint_mode$": true,
                "^paths$": true,
                "^debug$": true,
                "^gutter_theme$": true,
                "^show_hover_line_report$": true,
                "^highlights.demote_scope$": true,
                "^kill_old_processes$": true,
                "^no_column_highlights_line$": true,
                "^show_panel_on_save$": true,
                "^syntax_map$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "priority": {
                  "type": "integer",
                  "minimum": 0.0
                },
                "scope": {
                  "type": "string",
                  "examples": [
                    "region.redish",
                    "region.orangish",
                    "region.yellowish",
                    "region.greenish",
                    "region.bluish",
                    "region.purplish",
                    "region.pinkish",
                    "markup.warning",
                    "markup.error"
                  ]
                },
                "icon": {
                  "type": "string"
                },
                "mark_style": {
                  "type": "string",
                  "enum": [
                    "fill",
                    "outline",
                    "solid_underline",
                    "squiggly_underline",
                    "stippled_underline",
                    "none"
                  ]
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "error",
                      "warning"
                    ]
                  },
                  "minItems": 1,
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^types$": true,
                "^scope$": true,
                "^icon$": true,
                "^mark_style$": true,
                "^priority$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "additionalProperties": true
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "styles": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_5"
                    }
                  },
                  "excludes": {
                    "type": [
                      "array",
                      "string"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "args": {
                    "type": [
                      "array",
                      "string"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "selector": {
                    "type": "string"
                  },
                  "executable": {
                    "type": [
                      "array",
                      "string"
                    ],
                    "items": {
                      "type": "string"
                    }
                  },
                  "env": {
                    "type": "object"
                  },
                  "lint_mode": {
                    "type": "string",
                    "enum": [
                      "background",
                      "load_save",
                      "manual",
                      "save"
                    ]
                  },
                  "working_dir": {
                    "type": "string"
                  },
                  "disable": {
                    "type": "boolean"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
