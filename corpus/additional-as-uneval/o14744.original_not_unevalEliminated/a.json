{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": {
                "monthly": {
                  "channel": "none",
                  "message": "",
                  "userstate": {
                    "bits": 0,
                    "display-name": "N/A"
                  }
                },
                "daily": {
                  "channel": "none",
                  "message": "",
                  "userstate": {
                    "bits": 0,
                    "display-name": "N/A"
                  }
                }
              },
              "type": "object",
              "properties": {
                "daily": {
                  "type": "object",
                  "properties": {
                    "channel": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "userstate": {
                      "type": "object",
                      "properties": {
                        "bits": {
                          "type": "number"
                        },
                        "display-name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "bits",
                        "display-name"
                      ]
                    }
                  },
                  "required": [
                    "channel",
                    "message",
                    "userstate"
                  ]
                },
                "monthly": {
                  "type": "object",
                  "properties": {
                    "channel": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    },
                    "userstate": {
                      "type": "object",
                      "properties": {
                        "bits": {
                          "type": "number"
                        },
                        "display-name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "bits",
                        "display-name"
                      ]
                    }
                  },
                  "required": [
                    "channel",
                    "message",
                    "userstate"
                  ]
                }
              },
              "required": [
                "daily",
                "monthly"
              ]
            },
            {
              "patternProperties": {
                "^daily$": true,
                "^monthly$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "cheer": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "channel": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "userstate": {
          "type": "object",
          "properties": {
            "bits": {
              "type": "number"
            },
            "display-name": {
              "type": "string"
            }
          },
          "required": [
            "bits",
            "display-name"
          ]
        }
      },
      "required": [
        "channel",
        "message",
        "userstate"
      ]
    }
  }
}
