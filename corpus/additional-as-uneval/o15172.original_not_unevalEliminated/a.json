{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            {
              "patternProperties": {
                "^start$": true,
                "^end$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "custom": {
                  "type": "string"
                }
              },
              "required": [
                "custom"
              ]
            },
            {
              "patternProperties": {
                "^custom$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "version": "1.1.1",
              "type": "object",
              "properties": {
                "adventure": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^adventure$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "alId": {
                  "description": "Adventurers League ID; for use in homebrew.",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "coverUrl": {
                  "type": "string"
                },
                "published": {
                  "type": "string",
                  "format": "date"
                },
                "alAveragePlayerLevel": {
                  "description": "Adventurers League APL; for use in homebrew.",
                  "type": "integer"
                },
                "contents": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "id": {
                  "type": "string"
                },
                "storyline": {
                  "type": "string",
                  "enum": [
                    "Starter Set",
                    "Tyranny of Dragons",
                    "Elemental Evil",
                    "Rage of Demons",
                    "Curse of Strahd",
                    "Storm King's Thunder",
                    "Tales from the Yawning Portal",
                    "Tomb of Annihilation",
                    "Waterdeep",
                    "Ravnica",
                    "Extra Life",
                    "Ghosts of Saltmarsh",
                    "Acquisitions Incorporated",
                    "Essentials Kit",
                    "Stranger Things",
                    "Baldur's Gate",
                    "Eberron",
                    "Rick and Morty",
                    "Wildemount"
                  ]
                },
                "level": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_5"
                    },
                    {
                      "$ref": "#/$defs/modern_6"
                    }
                  ]
                },
                "alLength": {
                  "description": "Adventurers League length (in hours); for use in homebrew.",
                  "type": "object",
                  "oneOf": [
                    {
                      "properties": {
                        "min": {
                          "type": "integer"
                        },
                        "max": {
                          "type": "integer"
                        }
                      }
                    },
                    {
                      "properties": {
                        "exact": {
                          "type": "integer"
                        }
                      }
                    }
                  ]
                },
                "publishedOrder": {
                  "description": "A sorting order for adventures within a single source.",
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "id",
                "source",
                "contents",
                "level",
                "published",
                "storyline"
              ]
            },
            {
              "patternProperties": {
                "^alAveragePlayerLevel$": true,
                "^contents$": true,
                "^alId$": true,
                "^level$": true,
                "^publishedOrder$": true,
                "^alLength$": true,
                "^name$": true,
                "^id$": true,
                "^source$": true,
                "^published$": true,
                "^storyline$": true,
                "^coverUrl$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "headers": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "depth": {
                            "type": "integer"
                          },
                          "header": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "depth",
                          "header"
                        ]
                      }
                    ]
                  }
                },
                "ordinal": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^headers$": true,
                "^ordinal$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "chapter",
                    "appendix",
                    "part",
                    "episode",
                    "level"
                  ]
                },
                "identifier": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              },
              "required": [
                "type",
                "identifier"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^identifier$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
