{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "version": "1.0.1",
              "type": "object",
              "properties": {
                "monsterfeatures": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "monsterfeatures"
              ]
            },
            {
              "patternProperties": {
                "^monsterfeatures$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "numbox": {
                  "type": "boolean"
                },
                "effect": {
                  "type": "string"
                },
                "hp": {
                  "type": "string"
                },
                "attackbonus": {
                  "type": "string"
                },
                "example": {
                  "type": "string"
                },
                "dpr": {
                  "type": "string"
                },
                "ac": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "example",
                "effect",
                "hp",
                "ac",
                "dpr",
                "attackbonus"
              ]
            },
            {
              "patternProperties": {
                "^dpr$": true,
                "^attackbonus$": true,
                "^name$": true,
                "^numbox$": true,
                "^hp$": true,
                "^effect$": true,
                "^example$": true,
                "^ac$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
