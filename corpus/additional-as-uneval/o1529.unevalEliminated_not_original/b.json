{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "parameter": {
      "properties": {
        "metadata": {
          "description": "Client specific parameter metadata",
          "type": "object"
        },
        "value": {
          "description": "Input value to the template",
          "type": [
            "string",
            "boolean",
            "integer",
            "array",
            "object",
            "null"
          ]
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An Azure deployment parameter file",
              "properties": {
                "$schema": {
                  "type": "string"
                },
                "contentVersion": {
                  "description": "A 4 number format for the version number of this parameter file. For example, 1.0.0.0",
                  "pattern": "(^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$)",
                  "type": "string"
                },
                "parameters": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "$schema",
                "contentVersion",
                "parameters"
              ],
              "title": "Parameters",
              "type": "object"
            },
            {
              "patternProperties": {
                "^$schema$": true,
                "^contentVersion$": true,
                "^parameters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Collection of parameters to pass into a template",
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/parameter"
              }
            }
          ]
        }
      ]
    }
  }
}
