{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "environments": {
                  "$ref": "#/$defs/modern_6"
                },
                "navigationPath": {
                  "title": "navigationPath",
                  "type": "string"
                },
                "structure": {
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/IStructureNode"
                      },
                      {
                        "$ref": "#/$defs/IBranch"
                      }
                    ]
                  },
                  "title": "structure",
                  "type": "array"
                },
                "destinationPath": {
                  "title": "destinationPath",
                  "type": "string"
                },
                "pugLintPath": {
                  "title": "pugLintPath",
                  "type": "string"
                },
                "ampPath": {
                  "title": "ampPath",
                  "type": "string"
                },
                "siteTitle": {
                  "title": "siteTitle",
                  "type": "string"
                },
                "pugPath": {
                  "title": "pugPath",
                  "type": "string"
                },
                "environment": {
                  "title": "environment",
                  "type": "string"
                },
                "searchIndex": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/ISearchIndexConfig"
                    },
                    {
                      "type": "boolean"
                    }
                  ],
                  "title": "searchIndex"
                }
              },
              "required": [
                "destinationPath",
                "environment",
                "environments",
                "pugLintPath",
                "pugPath",
                "structure"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^pugPath$": true,
                "^structure$": true,
                "^pugLintPath$": true,
                "^siteTitle$": true,
                "^searchIndex$": true,
                "^destinationPath$": true,
                "^navigationPath$": true,
                "^environments$": true,
                "^environment$": true,
                "^ampPath$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "environments",
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/IEnvironmentConfig"
              }
            }
          ]
        }
      ]
    },
    "IStructureNode": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "children": {
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/IStructureNode"
                      },
                      {
                        "$ref": "#/$defs/IBranch"
                      }
                    ]
                  },
                  "title": "children",
                  "type": "array"
                },
                "navigation": {
                  "description": "Values can be any string. Special treatment for:\n- \"none\" : excluded from all navigations except \"allplain\"\n- \"top\" : default top navigation",
                  "title": "navigation",
                  "type": "string"
                },
                "title": {
                  "title": "title",
                  "type": "string"
                }
              },
              "required": [
                "children",
                "title"
              ],
              "title": "IBranch",
              "type": "object"
            },
            {
              "patternProperties": {
                "^children$": true,
                "^navigation$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "baseUrl": {
                  "title": "baseUrl",
                  "type": "string"
                },
                "isRelease": {
                  "title": "isRelease",
                  "type": "boolean"
                }
              },
              "title": "IEnvironmentConfig",
              "type": "object"
            },
            {
              "patternProperties": {
                "^baseUrl$": true,
                "^isRelease$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "IBranch": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "bodySelector": {
                  "title": "bodySelector",
                  "type": "string"
                },
                "destination": {
                  "title": "destination",
                  "type": "string"
                },
                "glob": {
                  "title": "glob",
                  "type": "string"
                }
              },
              "title": "ISearchIndexConfig",
              "type": "object"
            },
            {
              "patternProperties": {
                "^bodySelector$": true,
                "^destination$": true,
                "^glob$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "reference": {
                  "title": "reference",
                  "type": "string"
                },
                "children": {
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/IStructureNode"
                      },
                      {
                        "$ref": "#/$defs/IBranch"
                      }
                    ]
                  },
                  "title": "children",
                  "type": "array"
                },
                "isExternal": {
                  "title": "isExternal",
                  "type": "boolean"
                },
                "navigation": {
                  "description": "Values can be any string. Special treatment for:\n- \"none\" : excluded from all navigations except \"allplain\"\n- \"top\" : default top navigation",
                  "title": "navigation",
                  "type": "string"
                },
                "title": {
                  "title": "title",
                  "type": "string"
                }
              },
              "required": [
                "reference",
                "title"
              ],
              "title": "IStructureNode",
              "type": "object"
            },
            {
              "patternProperties": {
                "^children$": true,
                "^isExternal$": true,
                "^navigation$": true,
                "^title$": true,
                "^reference$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "IEnvironmentConfig": {
      "$ref": "#/$defs/modern_2"
    },
    "ISearchIndexConfig": {
      "$ref": "#/$defs/modern_3"
    }
  }
}
