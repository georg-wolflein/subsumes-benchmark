{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Zenodo record",
              "description": "metadata record from Zenodo (datacite3)",
              "type": "object",
              "properties": {
                "source": {
                  "description": "the publisher of this metadata",
                  "type": "string"
                },
                "abstract": {
                  "description": "summary of the work",
                  "type": "string"
                },
                "references": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "affiliations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "title": {
                  "description": "the title of the work",
                  "type": "string"
                },
                "bibcode": {
                  "type": "string"
                },
                "pubdate": {
                  "description": "the publication date of the work",
                  "type": "string"
                },
                "properties": {
                  "type": "object",
                  "properties": {
                    "DOI": {
                      "type": "string"
                    },
                    "PDF": {
                      "type": "string"
                    },
                    "OPEN": {
                      "type": "number"
                    },
                    "ELECTR": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "DOI"
                  ]
                },
                "authors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "_uniqueItems": true
                }
              },
              "required": [
                "authors",
                "title",
                "pubdate",
                "properties"
              ]
            },
            {
              "patternProperties": {
                "^keywords$": true,
                "^pubdate$": true,
                "^abstract$": true,
                "^title$": true,
                "^source$": true,
                "^properties$": true,
                "^bibcode$": true,
                "^authors$": true,
                "^references$": true,
                "^affiliations$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
