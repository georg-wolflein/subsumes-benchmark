{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "list"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Scenario Reasoner output for scenarioinfo method",
              "type": "object",
              "properties": {
                "result": {
                  "$ref": "#/$defs/modern_2"
                },
                "id": {
                  "description": "A value identifying this response, equal to the id of the request or null"
                },
                "error": {
                  "type": "null"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "result",
                "error",
                "id",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^result$": true,
                "^id$": true,
                "^error$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Result of the method scenarioInfo",
              "description": "This sub-schema describes the result of the method scenarioInfo",
              "name": "result",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the scenario",
                  "example": "Game Merchant Dialogue"
                },
                "description": {
                  "type": "string",
                  "description": "The description of the scenario"
                },
                "expressions": {
                  "type": "array",
                  "description": "The expressions for this scenario",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The id of the expression"
                      },
                      "name": {
                        "type": "string",
                        "description": "The name of the expression"
                      },
                      "description": {
                        "type": "string",
                        "description": "The description of the expression"
                      },
                      "type": {
                        "anyOf": [
                          {
                            "type": "string",
                            "example": "string"
                          },
                          {
                            "$ref": "#/$defs/modern_3"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "name"
                    ]
                  }
                },
                "characters": {
                  "type": "array",
                  "description": "The characters of the scenario",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The id of the character"
                      },
                      "name": {
                        "type": "string",
                        "decription": "The name of the character"
                      }
                    },
                    "required": [
                      "id"
                    ]
                  }
                },
                "version": {
                  "type": "integer",
                  "description": "The version of the scenario"
                },
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The ID of the scenario",
                  "example": "gmd4"
                },
                "language": {
                  "type": "string",
                  "description": "The language of the scenario",
                  "example": "en"
                },
                "propertyValues": {
                  "type": "object",
                  "description": "The statement-independent property values for this scenario",
                  "properties": {
                    "independent": {
                      "type": "object"
                    },
                    "perCharacter": {
                      "$ref": "#/$defs/modern_4"
                    }
                  }
                },
                "difficulty": {
                  "type": "string",
                  "minLength": 1,
                  "title": "Difficulty of scenario",
                  "description": "Indicates the scenario difficulty",
                  "default": "medium"
                },
                "userDefinedParameters": {
                  "type": "array",
                  "description": "The user-defined parameters for this scenario",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "description": "The id of the parameter",
                        "pattern": "^p([0-9]+)|t$"
                      },
                      "name": {
                        "type": "string",
                        "description": "The name of the parameter",
                        "example": "Interacting"
                      },
                      "description": {
                        "type": "string",
                        "description": "The description of the parameter",
                        "example": "If the player is interacting with the merchant."
                      },
                      "type": {
                        "anyOf": [
                          {
                            "type": "string",
                            "example": "string"
                          },
                          {
                            "$ref": "#/$defs/modern_5"
                          }
                        ]
                      }
                    },
                    "required": [
                      "id",
                      "name"
                    ]
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^userDefinedParameters$": true,
                "^expressions$": true,
                "^version$": true,
                "^description$": true,
                "^name$": true,
                "^id$": true,
                "^difficulty$": true,
                "^language$": true,
                "^propertyValues$": true,
                "^characters$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "list"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "object"
              }
            }
          ]
        }
      ]
    }
  }
}
