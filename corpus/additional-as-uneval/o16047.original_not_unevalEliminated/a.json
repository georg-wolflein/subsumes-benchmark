{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A state for the scenario",
  "type": "object",
  "properties": {
    "parameters": {
      "description": "The values for the parameters",
      "type": "object",
      "properties": {
        "userDefined": {
          "type": "object",
          "properties": {
            "independent": {
              "$ref": "#/$defs/modern_1"
            },
            "perCharacter": {
              "$ref": "#/$defs/modern_2"
            }
          },
          "required": [
            "independent",
            "perCharacter"
          ]
        },
        "fixed": {
          "type": "object",
          "properties": {
            "independent": {
              "type": "object"
            },
            "perCharacter": {
              "$ref": "#/$defs/modern_3"
            }
          },
          "required": [
            "independent",
            "perCharacter"
          ]
        }
      }
    },
    "statement": {
      "$ref": "#/$defs/modern_4"
    },
    "internal": {
      "type": "object",
      "description": "This property contains internal data for the ScenarioReasoner and must not be removed from the state. Internal is not always present in output; when it is, it must be sent back in input"
    }
  },
  "required": [
    "parameters"
  ],
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "object"
              }
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^p([0-9]+)|t$": true
              },
              "example": {
                "p1": false,
                "p2": 0,
                "p3": "A string"
              }
            },
            {
              "patternProperties": {
                "^p([0-9]+)|t$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "object"
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "object"
              }
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": [
                "object",
                "null"
              ],
              "description": "Statement will be present in output, but is not required in input",
              "properties": {
                "type": {
                  "description": "The statement type: whether it is for a computer or a player",
                  "type": "string",
                  "enum": [
                    "player",
                    "computer",
                    "situation"
                  ]
                },
                "text": {
                  "description": "The actual text for the statement",
                  "type": "string"
                },
                "character": {
                  "description": "The character this statement belongs to, if any",
                  "type": "string"
                },
                "propertyValues": {
                  "description": "The property values belonging to this statement",
                  "type": "object",
                  "properties": {
                    "independent": {
                      "type": "object"
                    },
                    "perCharacter": {
                      "$ref": "#/$defs/modern_5"
                    }
                  },
                  "required": [
                    "independent",
                    "perCharacter"
                  ]
                }
              },
              "required": [
                "type",
                "text",
                "propertyValues"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^text$": true,
                "^character$": true,
                "^propertyValues$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
