{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Random Key Expression",
              "type": "object",
              "properties": {
                "random_key": {
                  "enum": [
                    "sym_key",
                    "asym_prv_key"
                  ]
                }
              },
              "required": [
                "random_key"
              ]
            },
            {
              "patternProperties": {
                "^random_key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
