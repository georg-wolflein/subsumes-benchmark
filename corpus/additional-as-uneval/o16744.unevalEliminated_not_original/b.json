{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON schema for the Source Maps v3",
  "type": "object",
  "required": [
    "version"
  ],
  "patternProperties": {
    "^x_": {
      "$ref": "#/$defs/modern_3"
    }
  },
  "properties": {
    "names": {
      "type": "array",
      "description": "A list of symbol names used by the 'mappings' entry.",
      "items": {
        "type": "string"
      }
    },
    "sourceRoot": {
      "type": "string",
      "default": " An optional source root, useful for relocating source files on a server or removing repeated values in the 'sources' entry.  This value is prepended to the individual entries in the 'source' field."
    },
    "version": {
      "type": "integer",
      "description": " File version (always the first entry in the object) and must be a positive integer.",
      "default": 3
    },
    "file": {
      "type": "string",
      "default": "An optional name of the generated code that this source map is associated with."
    },
    "sourcesContent": {
      "type": "array",
      "description": "An optional list of source content, useful when the 'source' can\ufffdt be hosted. The contents are listed in the same order as the sources in line 5. 'null' may be used if some original sources should be retrieved by name.",
      "items": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "sources": {
      "type": "array",
      "description": "A list of original sources used by the 'mappings' entry.",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "$ref": "#/$defs/modern_4"
    },
    "mappings": {
      "type": "string",
      "description": "A string with the encoded mapping data."
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "map": {
                  "$ref": "#"
                }
              }
            },
            {
              "patternProperties": {
                "^map$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "sectionMap": {
      "oneOf": [
        {
          "$ref": "#/$defs/modern_1"
        },
        {
          "$ref": "#/$defs/modern_2"
        }
      ]
    },
    "modern_3": {
      "allOf": [
        {
          "anyOf": [
            {
              "allOf": [
                {
                  "description": "Any property starting with 'x_' is valid."
                },
                {
                  "additionalProperties": true
                }
              ]
            }
          ]
        },
        {
          "anyOf": [
            {
              "allOf": [
                {
                  "description": "Any property starting with 'x_' is valid."
                },
                {
                  "items": {
                    "anyOf": [
                      false,
                      true
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "minItems": 1,
              "_uniqueItems": true
            },
            {
              "items": {
                "anyOf": [
                  false,
                  {
                    "allOf": [
                      {
                        "$ref": "#/$defs/sectionMap"
                      }
                    ],
                    "properties": {
                      "offset": {
                        "type": "object",
                        "properties": {
                          "line": {
                            "type": "integer"
                          },
                          "column": {
                            "type": "integer"
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
