{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o17131.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "sensorsObj",
                "description": "Used to log captured sensors value",
                "type": "object",
                "properties": {
                  "date": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "Date of the capture"
                  },
                  "interval": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Capture interval configured for the source, in seconds"
                  },
                  "sensors": {
                    "type": [
                      "object",
                      "null"
                    ],
                    "description": "Sensor values captures on a phidget board",
                    "patternProperties": {
                      "^(.)+": {
                        "type": "object",
                        "properties": {
                          "description": {
                            "type": "string",
                            "description": "Description of the sensor"
                          },
                          "type": {
                            "type": "string",
                            "description": "Sensor Type"
                          },
                          "value": {
                            "type": "number",
                            "description": "Captured value after applying formula"
                          },
                          "valueRaw": {
                            "type": "number",
                            "description": "Captured value before applying formula"
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^date$": true,
                  "^interval$": true,
                  "^sensors$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "sensorsObj",
    "description": "Used to log captured sensors value",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "date": {
        "type": [
          "string",
          "null"
        ],
        "description": "Date of the capture"
      },
      "interval": {
        "type": [
          "number",
          "null"
        ],
        "description": "Capture interval configured for the source, in seconds"
      },
      "sensors": {
        "type": [
          "object",
          "null"
        ],
        "description": "Sensor values captures on a phidget board",
        "patternProperties": {
          "^(.)+": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "description": "Description of the sensor"
              },
              "type": {
                "type": "string",
                "description": "Sensor Type"
              },
              "value": {
                "type": "number",
                "description": "Captured value after applying formula"
              },
              "valueRaw": {
                "type": "number",
                "description": "Captured value before applying formula"
              }
            }
          }
        }
      }
    }
  }
}
