{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "end": {
      "_format": "date",
      "description": "Date your basis period ended",
      "title": "End date",
      "type": "string"
    },
    "start": {
      "_format": "date",
      "description": "Date your basis period began",
      "title": "Start date",
