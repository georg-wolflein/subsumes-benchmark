{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Server ChildDiscussionForm",
              "description": "Server ChildDiscussionForm from Tiamat",
              "type": "object",
              "required": [
                "parentDiscussion"
              ],
              "properties": {
                "parentDiscussion": {
                  "type": "object",
                  "required": [
                    "_id"
                  ],
                  "properties": {
                    "_id": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{24}$"
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^parentDiscussion$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
