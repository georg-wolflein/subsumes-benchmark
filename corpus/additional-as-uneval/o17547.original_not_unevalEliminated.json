{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o17547.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o17547.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Server RootDiscussionForm",
                "description": "Server RootDiscussionForm from Tiamat",
                "type": "object",
                "required": [
                  "forumBoard",
                  "forumBoardGroup"
                ],
                "properties": {
                  "forumBoardGroup": {
                    "type": "object",
                    "enum": [
                      {
                        "$data": "1/forumBoard/groups"
                      }
                    ]
                  },
                  "forumBoard": {
                    "type": "object",
                    "required": [
                      "_id"
                    ],
                    "properties": {
                      "_id": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{24}$"
                      },
                      "groups": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^forumBoardGroup$": true,
                  "^forumBoard$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Server RootDiscussionForm",
    "description": "Server RootDiscussionForm from Tiamat",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "forumBoard",
      "forumBoardGroup"
    ],
    "properties": {
      "forumBoardGroup": {
        "type": "object",
        "enum": [
          {
            "$data": "1/forumBoard/groups"
          }
        ]
      },
      "forumBoard": {
        "type": "object",
