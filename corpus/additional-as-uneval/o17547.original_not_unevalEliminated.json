          "_id"
        ],
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{24}$"
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
