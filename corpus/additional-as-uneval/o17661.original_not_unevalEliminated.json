{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o17661.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/MyObject",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "export": {
                    "$ref": "#/$defs/MyExportString"
                  },
                  "private": {
                    "type": "string"
                  }
                },
                "required": [
                  "export",
                  "private"
                ]
              },
              {
                "patternProperties": {
                  "^export$": true,
                  "^private$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "MyExportString": {
        "type": "string"
      },
      "MyObject": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/MyObject",
    "$defs": {
      "MyObject": {
        "type": "object",
        "properties": {
          "export": {
            "$ref": "#/$defs/MyExportString"
          },
          "private": {
            "type": "string"
          }
        },
        "required": [
          "export",
          "private"
        ],
        "additionalProperties": false
      },
      "MyExportString": {
        "type": "string"
      }
    }
  }
}
