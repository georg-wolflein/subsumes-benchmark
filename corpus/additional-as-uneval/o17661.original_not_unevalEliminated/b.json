{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MyObject",
  "$defs": {
    "MyObject": {
      "type": "object",
      "properties": {
        "export": {
          "$ref": "#/$defs/MyExportString"
        },
        "private": {
          "type": "string"
        }
      },
      "required": [
        "export",
        "private"
      ],
      "additionalProperties": false
    },
    "MyExportString": {
      "type": "string"
    }
  }
}
