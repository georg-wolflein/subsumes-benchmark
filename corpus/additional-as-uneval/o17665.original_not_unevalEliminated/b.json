{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MyObject",
  "$defs": {
    "MyObject": {
      "properties": {
        "object": {
          "$ref": "#/$defs/MySubObject"
        },
        "primitive": {
          "$ref": "#/$defs/MyString"
        }
      },
      "required": [
        "primitive",
        "object"
      ],
      "additionalProperties": false,
      "type": "object"
    },
    "MyString": {
      "type": "string"
    },
    "MySubObject": {
      "properties": {
        "propA": {
          "type": "number"
        },
        "propB": {
          "type": "number"
        }
      },
      "required": [
        "propA",
        "propB"
      ],
      "additionalProperties": false,
      "type": "object"
    }
  }
}
