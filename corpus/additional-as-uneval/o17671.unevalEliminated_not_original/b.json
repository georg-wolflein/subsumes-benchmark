                },
                "self": {
                  "$ref": "#/$defs/interface-0"
                }
              },
              "required": [
                "alias",
                "self"
              ]
            },
            {
              "patternProperties": {
                "^alias$": true,
                "^self$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "MyAlias": {
      "$ref": "#/$defs/interface-0"
    }
  }
