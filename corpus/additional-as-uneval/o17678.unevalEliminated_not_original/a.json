{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MyUnion",
  "$defs": {
    "MyUnion": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/MyObject"
          }
        ]
      }
    },
    "MyObject": {
      "type": "object",
      "properties": {
        "array": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number"
            ]
          }
        }
      },
      "required": [
        "array"
      ],
      "additionalProperties": false
    }
  }
}
