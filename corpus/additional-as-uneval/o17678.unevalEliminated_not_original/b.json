{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MyUnion",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "array": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  }
                }
              },
              "required": [
                "array"
              ]
            },
            {
              "patternProperties": {
                "^array$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "MyObject": {
      "$ref": "#/$defs/modern_1"
    },
    "MyUnion": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/MyObject"
          }
        ]
      }
    }
  }
}
