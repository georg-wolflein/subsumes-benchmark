{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "arguments": {
      "$ref": "#/$defs/arguments"
    },
    "description": {
      "$ref": "#/$defs/description"
    },
    "id": {
      "type": "string"
    },
    "maintainer": {
      "$ref": "#/$defs/maintainer"
    },
    "multi_instance": {
      "$ref": "#/$defs/multi_instance"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "$ref": "#/$defs/uri"
    }
  },
  "required": [
    "name",
    "id",
    "description",
    "maintainer",
    "multi_instance",
    "arguments"
  ],
  "title": "Yunohost application manifest schema",
  "type": "object",
  "$defs": {
    "arguments": {
      "additionalProperties": false,
      "properties": {
        "install": {
          "items": {
            "$ref": "#/$defs/install_item"
          },
          "type": "array"
        }
      },
      "required": [
        "install"
      ],
      "type": "object"
    },
    "boolean_string": {
      "enum": [
        "true",
        "false"
      ],
      "type": "string"
    },
    "description": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "en": {
          "type": "string"
        }
      },
      "required": [
        "en"
      ],
      "type": "object"
    },
    "email": {
      "_format": "email",
      "type": "string"
    },
    "install_item": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "$ref": "#/$defs/install_item_ask"
        },
        "choices": {
          "$ref": "#/$defs/install_item_choice"
        },
        "default": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "optional": {
          "$ref": "#/$defs/boolean_string"
        },
        "pattern": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/install_item_type"
        }
      },
      "required": [
        "name",
        "ask"
      ],
      "type": "object"
    },
    "install_item_ask": {
      "additionalProperties": {
        "type": "string"
      },
      "properties": {
        "en": {
          "type": "string"
        }
      },
      "required": [
        "en"
      ],
      "type": "object"
    },
    "install_item_choice": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "install_item_type": {
      "enum": [
        "domain",
        "user",
        "app",
        "password",
        "path"
      ],
      "type": "string"
    },
    "maintainer": {
      "additionalProperties": false,
      "properties": {
        "email": {
          "$ref": "#/$defs/email"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "email"
      ],
      "type": "object"
    },
    "multi_instance": {
      "$ref": "#/$defs/boolean_string"
    },
    "uri": {
      "_format": "uri",
      "type": "string"
    }
  }
}
