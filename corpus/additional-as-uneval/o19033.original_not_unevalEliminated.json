{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o19033.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Number and type of units",
                "example": "../examples/measure.json",
                "properties": {
                  "type": {
                    "description": "The type of measurement.",
                    "enum": [
                      "distance",
                      "length",
                      "angle",
                      "measure",
                      "scale"
                    ],
                    "translation": {}
                  },
                  "unitOfMeasure": {
                    "description": "The type of units to associated with the value.",
                    "minLength": 1,
                    "translation": {},
                    "type": "string"
                  },
                  "value": {
                    "description": "The number of units in the measurement.",
                    "translation": {},
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "value",
                  "unitOfMeasure"
                ],
                "title": "measure",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^unitOfMeasure$": true,
                  "^value$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "Number and type of units",
    "example": "../examples/measure.json",
    "properties": {
      "type": {
        "description": "The type of measurement.",
        "enum": [
          "distance",
          "length",
          "angle",
          "measure",
          "scale"
        ],
        "translation": {}
      },
      "unitOfMeasure": {
        "description": "The type of units to associated with the value.",
        "minLength": 1,
        "translation": {},
        "type": "string"
      },
      "value": {
        "description": "The number of units in the measurement.",
        "translation": {},
        "type": "number"
      }
    },
    "required": [
      "type",
      "value",
      "unitOfMeasure"
    ],
    "title": "measure",
    "type": "object"
  }
}
