{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o19155.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "flutter.yaml",
                "type": "object",
                "properties": {
                  "services": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "assets": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "uses-material-design": {
                    "type": "boolean"
                  },
                  "name": {
                    "type": "string"
                  },
                  "fonts": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^uses-material-design$": true,
                  "^fonts$": true,
                  "^name$": true,
                  "^services$": true,
                  "^assets$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "family": {
                    "type": "string"
                  },
                  "fonts": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_3"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^family$": true,
                  "^fonts$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "asset": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer"
                  },
                  "style": {
                    "enum": [
                      "normal",
                      "italic"
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^asset$": true,
                  "^weight$": true,
                  "^style$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "flutter.yaml",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "type": "string"
      },
      "uses-material-design": {
        "type": "boolean"
      },
      "assets": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "services": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "fonts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "family": {
              "type": "string"
            },
            "fonts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "asset": {
                    "type": "string"
                  },
                  "weight": {
                    "type": "integer"
                  },
                  "style": {
                    "enum": [
                      "normal",
                      "italic"
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
