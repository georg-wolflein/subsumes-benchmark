    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "CFFIXED_USER_HOME": {
                  "type": "string"
                },
                "HOME": {
                  "type": "string"
                },
                "TMPDIR": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^CFFIXED_USER_HOME$": true,
                "^HOME$": true,
                "^TMPDIR$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "CFBundlePrimaryIcon": {
                  "$ref": "#/$defs/modern_7"
                }
