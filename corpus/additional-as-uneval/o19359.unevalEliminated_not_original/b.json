{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "number",
                  "minimum": 0.0
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "price"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^price$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
