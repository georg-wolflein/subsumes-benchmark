{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "Parameter": {
      "type": "object",
      "properties": {
        "keyname": {
          "description": "The name of the parameter",
          "type": "string"
        },
        "keymin": {
          "description": "The minimum value of the parameter",
          "type": "number"
        },
        "domain": {
          "description": "The optional names of the values of the parameter",
          "type": "array",
          "_uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "keytype": {
          "description": "The description of the type of the parameter",
          "type": "string"
        },
        "default": {
          "description": "The default value of the parameter",
          "type": "number"
        },
        "keymax": {
          "description": "The maximum value of the parameter",
          "type": "number"
        }
      },
      "required": [
        "keyname",
        "keytype",
        "keymin",
        "keymax",
        "default"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "eotsfilter service",
              "description": "Capabilities document of a Earth-Observation Time-Series filter service",
              "type": "object",
              "properties": {
                "service": {
                  "description": "The name of the service",
                  "type": "string"
                },
                "filters": {
                  "description": "A list of filters",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Filter"
                  }
                }
              },
              "required": [
                "service",
                "filters"
              ]
            },
            {
              "patternProperties": {
                "^service$": true,
                "^filters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Sample": {
      "type": "object",
      "properties": {
        "label": {
          "description": "Name of the sample",
          "type": "string"
        },
        "attributes": {
          "description": "List of lists of observations",
          "type": "string"
        },
        "id": {
          "description": "ID of the sample",
          "type": "string"
        },
        "timeline": {
          "description": "List of sample dates",
          "type": "string"
        },
        "lat": {
          "description": "WGS84 latitude",
          "type": "string"
        },
        "lon": {
          "description": "WGS84 longitude",
          "type": "string"
        },
        "validdata": {
          "description": "List of sample dates",
          "type": "string"
        }
      }
    },
    "Filter": {
      "type": "object",
      "properties": {
        "name": {
          "description": "The complete name of the filter",
          "type": "string"
        },
        "missingdata": {
          "description": "Does the filter support the use of missing data?",
          "type": "string"
        },
        "alias": {
          "description": "The short name of the filter",
          "type": "string"
        },
        "sample": {
          "description": "A sample object",
          "type": "string"
        },
        "parameters": {
          "description": "The list of parameters of the filter",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        }
      },
      "required": [
        "alias",
        "name",
        "missingdata",
        "parameters",
        "sample"
      ]
    }
  }
}
