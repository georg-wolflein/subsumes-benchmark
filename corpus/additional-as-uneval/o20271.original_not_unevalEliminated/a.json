{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_4",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                }
              },
              "required": [
                "data"
              ]
            },
            {
              "patternProperties": {
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "entPhysicalIndex": {
                  "type": "string"
                },
                "precision": {
                  "type": "integer"
                },
                "oid": {
                  "type": "string"
                },
                "descr": {
                  "type": "string"
                },
                "snmp_flags": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "num_oid": {
                  "type": "string"
                },
                "skip_values": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "$ref": "#/$defs/modern_7"
                          }
                        ]
                      }
                    }
                  ]
                },
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "index": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              },
              "required": [
                "num_oid",
                "oid"
              ]
            },
            {
              "patternProperties": {
                "^snmp_flags$": true,
                "^oid$": true,
                "^num_oid$": true,
                "^type$": true,
                "^precision$": true,
                "^entPhysicalIndex$": true,
                "^value$": true,
                "^descr$": true,
                "^index$": true,
                "^skip_values$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "oid": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "oid"
              ]
            },
            {
              "patternProperties": {
                "^oid$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "comparison": {
      "type": "string",
      "enum": [
        "=",
        "!=",
        "==",
        "!==",
        "<=",
        ">=",
        "<",
        ">",
        "starts",
        "ends",
        "contains",
        "regex"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "data": {
                  "$ref": "#/$defs/data"
