          "oid": {
            "type": "string"
          },
          "descr": {
            "type": "string"
          },
          "entPhysicalIndex_measured": {
            "type": "string"
          },
          "snmp_flags": {
            "type": [
              "string",
              "array"
            ]
          },
          "num_oid": {
            "type": "string",
            "pattern": "^(\\.\\d+)+\\.?\\{\\{ \\$index \\}\\}(\\.\\d+)*$"
          },
          "skip_values": {
            "type": [
              "number",
              "array"
            ],
            "items": {
              "$ref": "#/$defs/modern_2"
            }
          },
          "value": {
            "type": "string"
          },
          "index": {
            "type": [
              "integer",
              "string"
            ]
          },
          "divisor": {
            "type": "integer"
          },
          "entPhysicalIndex": {
            "type": "string"
          }
        },
        "required": [
          "descr",
          "num_oid",
          "oid"
        ]
      }
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "oid": {
                  "type": "string"
