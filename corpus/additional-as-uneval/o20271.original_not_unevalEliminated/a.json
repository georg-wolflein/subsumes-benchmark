                "value": {
                  "type": "integer"
                }
              },
              "required": [
                "oid",
                "op",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^oid$": true,
                "^op$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
