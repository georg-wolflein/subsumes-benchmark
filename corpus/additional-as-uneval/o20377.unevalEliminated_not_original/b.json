{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "TSD - TypeScript Definition Manager: config & data file",
  "properties": {
    "path": {
      "description": "path to definition directory",
      "minLength": 1,
      "type": "string"
    },
    "ref": {
      "description": "git index ref (branch/commit)",
      "pattern": "^[\\w\\.-]+(?:\\/[\\w\\.-]+)*$",
      "type": "string"
    },
    "cache": {
      "description": "path to (shared) tsd-cache",
      "minLength": 1,
      "type": "string"
    },
    "version": {
      "description": "config-format version",
      "pattern": "^v[\\d]+$",
      "type": "string"
    },
    "repo": {
      "description": "github repository \"owner/name\"",
      "pattern": "^[\\w\\.-]+/[\\w\\.-]+$",
      "type": "string"
    },
    "installed": {
      "$ref": "#/$defs/modern_1"
    },
    "bundle": {
      "description": "path to <reference /> bundle",
      "pattern": "\\w+\\.ts$",
      "type": "string"
    },
    "stats": {
      "description": "enable stats tracking",
      "type": "boolean"
    }
  },
  "required": [
    "version",
    "repo",
    "ref",
    "path"
  ],
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "index of installed definitions4",
              "patternProperties": {
                "^[\\w\\.-]+\\/[\\w\\.-]+\\.d\\.ts$": {
                  "properties": {
                    "commit": {
                      "description": "sha1 hex",
                      "pattern": "^[0-9a-f]{6,40}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "commit"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^[\\w\\.-]+\\/[\\w\\.-]+\\.d\\.ts$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
