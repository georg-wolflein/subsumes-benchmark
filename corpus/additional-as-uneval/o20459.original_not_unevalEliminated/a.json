{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Get client request",
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Cannot be an empty string"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
