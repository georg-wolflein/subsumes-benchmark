{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Post device request",
              "type": "object",
              "required": [
                "user_agent",
                "user_id"
              ],
              "properties": {
                "user_agent": {
                  "type": "string",
                  "minLength": 1
                },
                "user_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^user_agent$": true,
                "^user_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
