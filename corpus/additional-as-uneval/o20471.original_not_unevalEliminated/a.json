{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Post device response",
              "type": "object",
              "properties": {
                "access_token": {
                  "type": "string"
                },
                "refresh_token": {
                  "type": "string"
                },
                "expires_in": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^access_token$": true,
                "^refresh_token$": true,
                "^expires_in$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
