                ],
                "title": "OAuth implicit flow",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^state$": true,
                  "^id_token$": true,
                  "^access_token$": true,
                  "^token_type$": true,
                  "^expires_in$": true
                },
                "additionalProperties": false
