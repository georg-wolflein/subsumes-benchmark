{
  "$id": "http://localhost:3000/schemas/refresh-token-request.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grant_type": {
      "enum": [
        "refresh_token"
      ],
      "type": "string"
    },
    "redirect_uri": {
      "type": "string"
    },
    "refresh_token": {
      "minLength": 1,
      "type": "string"
    },
    "scope": {
      "enum": [
        "openid",
        "profile",
        "email",
        "address",
        "phone"
      ],
      "type": "array"
    }
  },
  "required": [
    "grant_type",
    "refresh_token"
  ],
  "title": "refresh",
  "type": "object"
}
