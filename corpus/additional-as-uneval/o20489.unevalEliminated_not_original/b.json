{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "authorization": true,
              "content-type": "application/x-www-form-urlencoded.",
              "method": "POST",
              "properties": {
                "token": {
                  "description": "The token that the client wants to get revoked.",
                  "type": "string"
                },
                "token_type_hint": {
                  "description": "Optional hint about the type of the submitted token; if omitted the server will use heuristics to determine the token type:",
                  "enum": [
                    "access_token",
                    "refresh_token"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "token",
                "token_type_hint"
              ],
              "resource": "POST /token/revoke",
              "title": "Token revoke",
              "type": "object"
            },
            {
              "patternProperties": {
                "^token$": true,
                "^token_type_hint$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
