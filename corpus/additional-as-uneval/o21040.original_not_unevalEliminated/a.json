{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "minProperties": 1,
              "properties": {
                "frameworkAgreementVersion": {
                  "minLength": 1,
                  "type": "string"
                },
                "signerName": {
                  "minLength": 1,
                  "type": "string"
                },
                "signerRole": {
                  "minLength": 1,
                  "type": "string"
                },
                "uploaderUserId": {
                  "minimum": 1.0,
                  "type": "integer"
                }
              },
              "required": [
                "frameworkAgreementVersion",
                "signerName",
                "signerRole",
                "uploaderUserId"
              ],
              "title": "SupplierFramework.agreement_details Schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^frameworkAgreementVersion$": true,
                "^signerName$": true,
                "^signerRole$": true,
                "^uploaderUserId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
