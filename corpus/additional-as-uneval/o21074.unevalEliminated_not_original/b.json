{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "additionalTerms": {
                  "minLength": 0,
                  "pattern": "^$|(^(?:\\S+\\s+){0,99}\\S+$)",
                  "type": "string"
                },
                "priceWeighting": {
                  "maximum": 80.0,
                  "minimum": 20.0,
                  "type": "integer"
                },
                "researchAddress": {
                  "minLength": 1,
                  "pattern": "^(?:\\S+\\s+){0,99}\\S+$",
                  "type": "string"
                },
                "technicalWeighting": {
                  "maximum": 70.0,
                  "minimum": 10.0,
                  "type": "integer"
                },
                "successCriteria": {
                  "items": {
                    "maxLength": 300,
                    "pattern": "^(?:\\S+\\s+){0,29}\\S+$",
                    "type": "string"
                  },
                  "maxItems": 20,
                  "minItems": 1,
                  "type": "array"
                },
                "researchRounds": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "budgetRange": {
                  "minLength": 0,
                  "pattern": "^$|(^(?:\\S+\\s+){0,99}\\S+$)",
                  "type": "string"
                },
                "researchPlan": {
                  "minLength": 0,
                  "pattern": "^$|(^(?:\\S+\\s+){0,99}\\S+$)",
                  "type": "string"
                },
                "evaluationType": {
                  "items": {
                    "enum": [
                      "Case study",
                      "Reference",
                      "Interview"
                    ]
                  },
                  "maxItems": 3,
                  "minItems": 0,
                  "type": "array",
                  "_uniqueItems": true
                },
                "title": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "niceToHaveRequirements": {
                  "items": {
                    "maxLength": 300,
                    "pattern": "^(?:\\S+\\s+){0,29}\\S+$",
                    "type": "string"
                  },
                  "maxItems": 20,
                  "minItems": 0,
                  "type": "array"
                },
                "organisation": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "participantsPerRound": {
                  "minLength": 1,
                  "pattern": "^(?:\\S+\\s+){0,99}\\S+$",
                  "type": "string"
                },
                "researchDates": {
                  "maxLength": 100,
                  "minLength": 1,
                  "type": "string"
                },
                "location": {
                  "enum": [
                    "Scotland",
                    "North East England",
                    "North West England",
                    "Yorkshire and the Humber",
                    "East Midlands",
                    "West Midlands",
                    "East of England",
                    "Wales",
                    "London",
                    "South East England",
                    "South West England",
                    "Northern Ireland",
                    "International (outside the UK)"
                  ]
                },
                "researchOutOfHours": {
                  "items": {
                    "enum": [
                      "Weekday evenings",
                      "Weekends"
                    ]
                  },
                  "maxItems": 2,
                  "minItems": 0,
                  "type": "array",
                  "_uniqueItems": true
                },
                "culturalWeighting": {
                  "maximum": 70.0,
                  "minimum": 10.0,
                  "type": "integer"
                },
                "participantSpecification": {
                  "minLength": 1,
                  "pattern": "^(?:\\S+\\s+){0,199}\\S+$",
                  "type": "string"
                },
                "accessRestrictions": {
                  "minLength": 0,
                  "pattern": "^$|(^(?:\\S+\\s+){0,99}\\S+$)",
                  "type": "string"
                },
                "participantAccessibilityNeeds": {
                  "minLength": 0,
                  "pattern": "^$|(^(?:\\S+\\s+){0,99}\\S+$)",
                  "type": "string"
                },
                "earlyMarketEngagement": {
                  "minLength": 0,
                  "pattern": "^$|(^(?:\\S+\\s+){0,199}\\S+$)",
                  "type": "string"
                },
                "researchFrequency": {
                  "minLength": 1,
                  "pattern": "^(?:\\S+\\s+){0,99}\\S+$",
                  "type": "string"
                },
                "summary": {
                  "minLength": 1,
                  "pattern": "^(?:\\S+\\s+){0,49}\\S+$",
                  "type": "string"
                },
                "questionAndAnswerSessionDetails": {
                  "minLength": 0,
                  "pattern": "^$|(^(?:\\S+\\s+){0,99}\\S+$)",
                  "type": "string"
                },
                "essentialRequirements": {
                  "items": {
                    "maxLength": 300,
                    "pattern": "^(?:\\S+\\s+){0,29}\\S+$",
                    "type": "string"
                  },
                  "maxItems": 20,
                  "minItems": 1,
                  "type": "array"
                },
                "numberOfSuppliers": {
                  "maximum": 15.0,
                  "minimum": 3.0,
                  "type": "integer"
                }
              },
              "required": [
                "culturalWeighting",
                "essentialRequirements",
                "location",
                "numberOfSuppliers",
                "organisation",
                "participantSpecification",
                "participantsPerRound",
                "priceWeighting",
                "researchAddress",
                "researchDates",
                "researchFrequency",
                "researchRounds",
                "successCriteria",
                "summary",
                "technicalWeighting",
                "title"
              ],
              "title": "Digital Outcomes and Specialists 4 User research participants Brief Schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^essentialRequirements$": true,
                "^earlyMarketEngagement$": true,
                "^additionalTerms$": true,
                "^organisation$": true,
                "^participantSpecification$": true,
                "^technicalWeighting$": true,
                "^successCriteria$": true,
                "^researchRounds$": true,
                "^summary$": true,
                "^culturalWeighting$": true,
                "^researchFrequency$": true,
                "^numberOfSuppliers$": true,
                "^priceWeighting$": true,
                "^budgetRange$": true,
                "^title$": true,
                "^participantAccessibilityNeeds$": true,
                "^researchPlan$": true,
                "^accessRestrictions$": true,
                "^niceToHaveRequirements$": true,
                "^evaluationType$": true,
                "^researchOutOfHours$": true,
                "^questionAndAnswerSessionDetails$": true,
                "^location$": true,
                "^researchDates$": true,
                "^researchAddress$": true,
                "^participantsPerRound$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
