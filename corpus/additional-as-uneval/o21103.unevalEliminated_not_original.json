{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21103.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "completed": {
        "type": "boolean"
      },
      "award": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startDate": {
            "OneOf": [
              {
                "type": "string",
                "pattern": "\\d{4}-\\d{2}-\\d{2}"
              },
              {
                "type": "null"
              }
            ]
          },
          "endDate": {
            "OneOf": [
              {
                "type": "string",
                "pattern": "\\d{4}-\\d{2}-\\d{2}"
              },
              {
                "type": "null"
              }
            ]
          },
          "awardingOrganisationName": {
            "OneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "awardValue": {
            "OneOf": [
              {
                "type": "string",
                "pattern": "[\\d.]+"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "title": "Schema to validate outcome updates",
    "type": "object"
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "completed": {
                    "type": "boolean"
                  },
                  "award": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "title": "Schema to validate outcome updates",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^completed$": true,
                  "^award$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "startDate": {
                    "OneOf": [
                      {
                        "type": "string",
                        "pattern": "\\d{4}-\\d{2}-\\d{2}"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "endDate": {
                    "OneOf": [
                      {
                        "type": "string",
                        "pattern": "\\d{4}-\\d{2}-\\d{2}"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "awardingOrganisationName": {
                    "OneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "awardValue": {
                    "OneOf": [
                      {
                        "type": "string",
                        "pattern": "[\\d.]+"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^startDate$": true,
                  "^endDate$": true,
                  "^awardingOrganisationName$": true,
                  "^awardValue$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
