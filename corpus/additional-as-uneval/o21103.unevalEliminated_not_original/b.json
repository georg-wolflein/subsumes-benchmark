{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "completed": {
                  "type": "boolean"
                },
                "award": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "title": "Schema to validate outcome updates",
              "type": "object"
            },
            {
              "patternProperties": {
                "^completed$": true,
                "^award$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "startDate": {
                  "OneOf": [
                    {
                      "type": "string",
                      "pattern": "\\d{4}-\\d{2}-\\d{2}"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "endDate": {
                  "OneOf": [
                    {
                      "type": "string",
                      "pattern": "\\d{4}-\\d{2}-\\d{2}"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "awardingOrganisationName": {
                  "OneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "awardValue": {
                  "OneOf": [
                    {
                      "type": "string",
                      "pattern": "[\\d.]+"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^startDate$": true,
                "^endDate$": true,
                "^awardingOrganisationName$": true,
                "^awardValue$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
