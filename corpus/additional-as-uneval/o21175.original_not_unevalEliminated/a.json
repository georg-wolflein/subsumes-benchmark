{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_14",
  "$defs": {
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "public_timestamp",
                "note"
              ],
              "properties": {
                "note": {
                  "description": "A summary of the change",
                  "type": "string"
                },
                "public_timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^note$": true,
                "^public_timestamp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "attachment_type",
                "content_type",
                "id",
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "hoc_paper_number": {
                  "type": "string"
                },
                "attachment_type": {
                  "type": "string",
                  "enum": [
                    "file"
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "preview_url": {
                  "type": "string",
                  "format": "uri"
                },
                "id": {
                  "type": "string"
                },
                "number_of_pages": {
                  "type": "integer"
                },
                "command_paper_number": {
                  "type": "string"
                },
                "accessible": {
                  "type": "boolean"
                },
                "file_size": {
                  "type": "integer"
                },
                "content_type": {
                  "type": "string"
                },
                "unnumbered_command_paper": {
                  "type": "boolean"
                },
                "unnumbered_hoc_paper": {
                  "type": "boolean"
                },
                "unique_reference": {
                  "type": "string"
                },
                "parliamentary_session": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "isbn": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "alternative_format_contact_email": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^command_paper_number$": true,
                "^preview_url$": true,
                "^url$": true,
                "^id$": true,
                "^hoc_paper_number$": true,
                "^title$": true,
                "^accessible$": true,
                "^parliamentary_session$": true,
                "^isbn$": true,
                "^file_size$": true,
                "^locale$": true,
                "^unique_reference$": true,
                "^attachment_type$": true,
                "^unnumbered_hoc_paper$": true,
                "^alternative_format_contact_email$": true,
                "^content_type$": true,
                "^filename$": true,
                "^number_of_pages$": true,
                "^unnumbered_command_paper$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_public_at": {
      "description": "DEPRECATED. The date the content was first published. Used in details. Deprecated in favour of top level `first_published_at`.",
      "type": "string",
      "format": "date-time"
    },
    "nation_applicability": {
      "$ref": "#/$defs/modern_1"
    },
    "analytics_identifier": {
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "attachment_type",
                "id",
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "hoc_paper_number": {
                  "type": "string"
                },
                "attachment_type": {
                  "type": "string",
                  "enum": [
                    "external"
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "id": {
                  "type": "string"
                },
                "isbn": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "command_paper_number": {
                  "type": "string"
                },
                "unnumbered_command_paper": {
                  "type": "boolean"
                },
                "unnumbered_hoc_paper": {
                  "type": "boolean"
                },
                "unique_reference": {
                  "type": "string"
                },
                "parliamentary_session": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^parliamentary_session$": true,
                "^command_paper_number$": true,
                "^isbn$": true,
                "^url$": true,
                "^id$": true,
                "^hoc_paper_number$": true,
                "^title$": true,
                "^unnumbered_command_paper$": true,
                "^locale$": true,
                "^unique_reference$": true,
                "^attachment_type$": true,
                "^unnumbered_hoc_paper$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guid"
      },
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "body",
                "political"
              ],
              "properties": {
                "public_feedback_attachments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "body": {
                  "$ref": "#/$defs/body"
                },
                "final_outcome_detail": {
                  "type": "string"
                },
                "image": {
                  "$ref": "#/$defs/image"
                },
                "change_history": {
                  "$ref": "#/$defs/change_history"
                },
                "ways_to_respond": {
                  "$ref": "#/$defs/modern_6"
                },
                "opening_date": {
                  "type": "string",
                  "format": "date-time"
                },
                "public_feedback_detail": {
                  "type": "string"
                },
                "featured_attachments": {
                  "description": "An ordered list of attachments to feature below the document",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "held_on_another_website_url": {
                  "type": "string"
                },
                "attachments": {
                  "description": "An ordered list of asset links",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/publication_attachment_asset"
                  }
                },
                "emphasised_organisations": {
                  "$ref": "#/$defs/emphasised_organisations"
                },
                "final_outcome_documents": {
                  "$ref": "#/$defs/attachments_with_thumbnails"
                },
                "public_feedback_publication_date": {
                  "type": "string",
                  "format": "date-time"
                },
                "closing_date": {
                  "type": "string",
                  "format": "date-time"
                },
                "tags": {
                  "$ref": "#/$defs/tags"
                },
                "public_feedback_documents": {
                  "$ref": "#/$defs/attachments_with_thumbnails"
                },
                "final_outcome_publication_date": {
                  "type": "string",
                  "format": "date-time"
                },
                "documents": {
                  "$ref": "#/$defs/attachments_with_thumbnails"
                },
                "first_public_at": {
                  "$ref": "#/$defs/first_public_at"
                },
                "political": {
                  "$ref": "#/$defs/political"
                },
                "government": {
                  "$ref": "#/$defs/government"
                },
                "national_applicability": {
                  "$ref": "#/$defs/national_applicability"
                },
                "final_outcome_attachments": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^final_outcome_detail$": true,
                "^image$": true,
                "^held_on_another_website_url$": true,
                "^body$": true,
                "^public_feedback_publication_date$": true,
                "^political$": true,
                "^public_feedback_documents$": true,
                "^government$": true,
                "^public_feedback_attachments$": true,
                "^ways_to_respond$": true,
                "^closing_date$": true,
                "^final_outcome_attachments$": true,
                "^emphasised_organisations$": true,
                "^documents$": true,
                "^national_applicability$": true,
                "^public_feedback_detail$": true,
                "^featured_attachments$": true,
                "^change_history$": true,
                "^attachments$": true,
                "^opening_date$": true,
                "^final_outcome_documents$": true,
                "^first_public_at$": true,
                "^final_outcome_publication_date$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "access_limited": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "attachment_url": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "link_url": {
                  "type": "string"
                },
                "postal_address": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^attachment_url$": true,
                "^email$": true,
                "^link_url$": true,
                "^postal_address$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "body": {
      "description": "The main content provided as HTML rendered from govspeak",
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1
    },
    "attachments_with_thumbnails": {
      "description": "An ordered list of attachments",
      "type": "array",
      "items": {
        "description": "Generated HTML for each attachment including thumbnail and download link",
        "type": "string"
      }
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "related_policies": {
                  "$ref": "#/$defs/guid_list"
                },
                "original_primary_publishing_organisation": {
                  "description": "The organisation that published the original version of the page. Corresponds to the first of the 'Lead organisations' in Whitehall for the first edition, and is empty for all other publishing applications.",
                  "$ref": "#/$defs/guid_list"
                },
                "roles": {
                  "description": "Government roles that are associated with this document, typically the role part of a role association",
                  "$ref": "#/$defs/guid_list"
                },
                "policy_areas": {
                  "description": "A largely deprecated tag currently only used to power email alerts.",
                  "$ref": "#/$defs/guid_list"
                },
                "parent": {
                  "$ref": "#/$defs/guid_list"
                },
                "people": {
                  "description": "People that are associated with this document, typically the person part of a role association",
                  "$ref": "#/$defs/guid_list"
                },
                "topics": {
                  "$ref": "#/$defs/guid_list"
                },
                "topical_events": {
                  "$ref": "#/$defs/guid_list"
                },
                "government": {
                  "description": "The government associated with this document",
                  "$ref": "#/$defs/guid_list",
                  "maxItems": 1
                },
                "primary_publishing_organisation": {
                  "description": "The organisation that published the page. Corresponds to the first of the 'Lead organisations' in Whitehall, and is empty for all other publishing applications.",
                  "$ref": "#/$defs/guid_list",
                  "maxItems": 1
                },
                "organisations": {
                  "$ref": "#/$defs/guid_list"
                }
              }
            },
            {
              "patternProperties": {
                "^topical_events$": true,
                "^roles$": true,
                "^organisations$": true,
                "^primary_publishing_organisation$": true,
                "^policy_areas$": true,
                "^parent$": true,
                "^original_primary_publishing_organisation$": true,
                "^related_policies$": true,
                "^topics$": true,
                "^government$": true,
                "^people$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "guid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An object specifying the applicability of a particular nation.",
              "type": "object",
              "properties": {
                "alternative_url": {
                  "description": "An optional alternative URL to link to for more information on this content item pertaining to this nation.",
                  "type": "string"
                },
                "applicable": {
                  "description": "Whether the content applies to this nation or not.",
                  "type": "boolean"
                },
                "label": {
                  "description": "The pretty-printed, translated label for this nation.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^alternative_url$": true,
                "^applicable$": true,
                "^label$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "image": {
      "$ref": "#/$defs/modern_8"
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "$ref": "#/$defs/modern_9"
    },
    "change_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_10"
      }
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ]
    },
    "public_updated_at": {
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "auth_bypass_ids": {
                  "description": "Deprecated: auth_bypass_ids should be sent as a separate field",
                  "$ref": "#/$defs/guid_list"
                },
                "organisations": {
                  "description": "A list of organisation content ids permitted access to this item",
                  "$ref": "#/$defs/guid_list"
                },
                "users": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^organisations$": true,
                "^users$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An object specifying the applicable nations for this content item. If it applies to all nations, it should be omitted.",
              "type": "object",
              "properties": {
                "england": {
                  "$ref": "#/$defs/nation_applicability"
                },
                "northern_ireland": {
                  "$ref": "#/$defs/nation_applicability"
                },
                "scotland": {
                  "$ref": "#/$defs/nation_applicability"
                },
                "wales": {
                  "$ref": "#/$defs/nation_applicability"
                }
              }
            },
            {
              "patternProperties": {
                "^england$": true,
                "^northern_ireland$": true,
                "^scotland$": true,
                "^wales$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "political": {
      "description": "If the content is considered political in nature, reflecting views of the government it was published under.",
      "type": "boolean"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "description": "URL to the image. The image should be in a suitable resolution for display on the page.",
                  "type": "string",
                  "format": "uri"
                },
                "alt_text": {
                  "type": "string"
                },
                "credit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "high_resolution_url": {
                  "description": "URL to a high resolution version of the image, for use by third parties such as Twitter, Facebook or Slack. Used by the machine readable metadata component. Don't use this on user-facing web pages, as it might be very large.",
                  "type": "string",
                  "format": "uri"
                },
                "caption": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^credit$": true,
                "^url$": true,
                "^alt_text$": true,
                "^high_resolution_url$": true,
                "^caption$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "government": {
      "$ref": "#/$defs/modern_11"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Field used by email-alert-api to trigger email alerts for subscriptions to topics (gov.uk/topic) and policies (gov.uk/policies).",
              "type": "object",
              "properties": {
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "browse_pages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "additional_topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primary_topic": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "policies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^additional_topics$": true,
                "^topics$": true,
                "^primary_topic$": true,
                "^browse_pages$": true,
                "^policies$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ]
    },
    "publication_attachment_asset": {
      "oneOf": [
        {
          "$ref": "#/$defs/modern_2"
        },
        {
          "$ref": "#/$defs/modern_3"
        },
        {
          "$ref": "#/$defs/modern_4"
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "path",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "attachment_type",
                "id",
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "hoc_paper_number": {
                  "type": "string"
                },
                "attachment_type": {
                  "type": "string",
                  "enum": [
                    "html"
                  ]
