                  "description": "Last time when the content received a major or minor update.",
                  "type": "string",
                  "format": "date-time"
                },
                "schema_name": {
                  "type": "string",
                  "enum": [
                    "consultation"
                  ]
                },
                "links": {
                  "$ref": "#/$defs/modern_16"
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^rendering_app$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^details$": true,
                "^previous_version$": true,
                "^need_ids$": true,
                "^links$": true,
                "^document_type$": true,
                "^phase$": true,
                "^first_published_at$": true,
                "^routes$": true,
                "^update_type$": true,
                "^schema_name$": true,
                "^base_path$": true,
                "^access_limited$": true,
                "^redirects$": true,
                "^description$": true,
                "^last_edited_at$": true,
                "^analytics_identifier$": true,
                "^public_updated_at$": true,
                "^change_note$": true,
                "^title$": true,
                "^bulk_publishing$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
