    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "DEPRECATED: Content should be associated with a government through a link",
              "type": "object",
              "required": [
                "title",
                "slug",
                "current"
              ],
              "properties": {
                "current": {
                  "description": "Is the government that published this document still the current government.",
                  "type": "boolean"
                },
                "slug": {
                  "description": "Government slug, used for analytics, eg '1970-to-1974-conservative-government'.",
                  "type": "string"
                },
                "title": {
                  "description": "Name of the government that first published this document, eg '1970 to 1974 Conservative government'.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^current$": true,
                "^slug$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "base_path",
                "details",
                "document_type",
                "publishing_app",
                "rendering_app",
                "routes",
                "schema_name",
                "title"
              ],
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "routes": {
                  "$ref": "#/$defs/routes"
                },
                "previous_version": {
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "change_note": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_15"
                },
                "update_type": {
                  "$ref": "#/$defs/update_type"
                },
                "document_type": {
                  "type": "string",
                  "enum": [
                    "closed_consultation",
                    "open_consultation",
                    "consultation",
                    "consultation_outcome"
                  ]
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "access_limited": {
                  "$ref": "#/$defs/access_limited"
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "type": "string",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ]
                },
                "need_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "auth_bypass_ids": {
