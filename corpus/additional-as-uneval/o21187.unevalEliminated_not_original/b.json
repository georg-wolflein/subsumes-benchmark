{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_10",
  "$defs": {
    "external_link": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "base_path",
                "details",
                "document_type",
                "publishing_app",
                "rendering_app",
                "routes",
                "schema_name",
                "title"
              ],
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "routes": {
                  "$ref": "#/$defs/routes"
                },
                "previous_version": {
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "change_note": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_11"
                },
                "update_type": {
                  "$ref": "#/$defs/update_type"
                },
                "document_type": {
                  "type": "string",
                  "enum": [
                    "about",
                    "recruitment",
                    "complaints_procedure",
                    "about_our_services",
                    "social_media_use",
                    "publication_scheme",
                    "our_governance",
                    "procurement",
                    "statistics",
                    "membership",
                    "research",
                    "welsh_language_scheme",
                    "media_enquiries",
                    "access_and_opening",
                    "our_energy_use",
                    "personal_information_charter",
                    "equality_and_diversity",
                    "staff_update",
                    "terms_of_reference",
                    "petitions_and_campaigns",
                    "accessible_documents_policy"
                  ]
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "access_limited": {
                  "$ref": "#/$defs/access_limited"
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "type": "string",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ]
                },
                "need_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "auth_bypass_ids": {
                  "description": "A list of ids that will allow access to this item for non-authenticated users",
                  "$ref": "#/$defs/guid_list"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "bulk_publishing": {
                  "type": "boolean"
                },
                "last_edited_at": {
                  "description": "Last time when the content received a major or minor update.",
                  "type": "string",
                  "format": "date-time"
                },
                "schema_name": {
                  "type": "string",
                  "enum": [
                    "corporate_information_page"
                  ]
                },
                "links": {
                  "$ref": "#/$defs/modern_12"
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^rendering_app$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^details$": true,
                "^previous_version$": true,
                "^need_ids$": true,
                "^links$": true,
                "^document_type$": true,
                "^phase$": true,
                "^first_published_at$": true,
                "^routes$": true,
                "^update_type$": true,
                "^schema_name$": true,
                "^base_path$": true,
                "^access_limited$": true,
                "^redirects$": true,
                "^description$": true,
                "^last_edited_at$": true,
                "^analytics_identifier$": true,
                "^public_updated_at$": true,
                "^change_note$": true,
                "^title$": true,
                "^bulk_publishing$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "contents"
              ],
              "properties": {
                "contents": {
                  "description": "An ordered list of links, either internal with GUID or external with URL and title",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/internal_or_external_link"
                  }
                },
                "name": {
                  "description": "Title of the group",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^contents$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "grouped_lists_of_links": {
      "description": "Lists of links with titles in named groups",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_2"
      }
    },
    "analytics_identifier": {
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "route": {
      "$ref": "#/$defs/modern_4"
    },
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "type": "string",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$"
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "path",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "absolute_fullpath": {
      "description": "A path with optional query string and/or fragment.",
      "type": "string",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?(\\?([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)?(#([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)?$"
    },
    "guid_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guid"
      },
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "auth_bypass_ids": {
                  "description": "Deprecated: auth_bypass_ids should be sent as a separate field",
                  "$ref": "#/$defs/guid_list"
                },
                "organisations": {
                  "description": "A list of organisation content ids permitted access to this item",
                  "$ref": "#/$defs/guid_list"
                },
                "users": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^organisations$": true,
                "^users$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "access_limited": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Field used by email-alert-api to trigger email alerts for subscriptions to topics (gov.uk/topic) and policies (gov.uk/policies).",
              "type": "object",
              "properties": {
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "browse_pages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "additional_topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primary_topic": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "policies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^additional_topics$": true,
                "^topics$": true,
                "^primary_topic$": true,
                "^browse_pages$": true,
                "^policies$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "body": {
      "description": "The main content provided as HTML rendered from govspeak",
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1
    },
    "internal_or_external_link": {
      "anyOf": [
        {
          "$ref": "#/$defs/external_link"
        },
        {
          "$ref": "#/$defs/internal_link_without_guid"
        },
        {
          "$ref": "#/$defs/guid"
        }
      ]
    },
    "guid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "title",
                "url"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            {
              "patternProperties": {
                "^title$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "$ref": "#/$defs/modern_6"
    },
    "change_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_7"
      }
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ]
    },
    "public_updated_at": {
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "public_timestamp",
                "note"
              ],
              "properties": {
                "note": {
                  "description": "A summary of the change",
                  "type": "string"
                },
                "public_timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^note$": true,
                "^public_timestamp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "parent": {
                  "description": "The parent content item.",
                  "$ref": "#/$defs/guid_list",
                  "maxItems": 1
                },
                "original_primary_publishing_organisation": {
                  "description": "The organisation that published the original version of the page. Corresponds to the first of the 'Lead organisations' in Whitehall for the first edition, and is empty for all other publishing applications.",
                  "$ref": "#/$defs/guid_list"
                },
                "corporate_information_pages": {
                  "$ref": "#/$defs/guid_list"
                },
                "government": {
                  "description": "The government associated with this document",
                  "$ref": "#/$defs/guid_list",
                  "maxItems": 1
                },
                "primary_publishing_organisation": {
                  "description": "The organisation that published the page. Corresponds to the first of the 'Lead organisations' in Whitehall, and is empty for all other publishing applications.",
                  "$ref": "#/$defs/guid_list",
                  "maxItems": 1
                },
                "organisations": {
                  "description": "All organisations linked to this content item. This should include lead organisations.",
                  "$ref": "#/$defs/guid_list"
                }
              }
            },
            {
              "patternProperties": {
                "^organisations$": true,
                "^primary_publishing_organisation$": true,
                "^government$": true,
                "^parent$": true,
                "^original_primary_publishing_organisation$": true,
                "^corporate_information_pages$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "body",
                "organisation"
              ],
              "properties": {
                "tags": {
                  "$ref": "#/$defs/tags"
                },
                "change_history": {
                  "$ref": "#/$defs/change_history"
                },
                "corporate_information_groups": {
                  "description": "Groups of corporate information to display on about pages",
                  "$ref": "#/$defs/grouped_lists_of_links"
                },
                "attachments": {
                  "description": "An ordered list of asset links",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/file_attachment_asset"
                  }
                },
                "organisation": {
                  "description": "A single organisation that is the subject of this corporate information page",
                  "$ref": "#/$defs/guid"
                },
                "body": {
                  "$ref": "#/$defs/body"
                }
              }
            },
            {
              "patternProperties": {
                "^organisation$": true,
                "^body$": true,
                "^corporate_information_groups$": true,
                "^tags$": true,
                "^change_history$": true,
                "^attachments$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "file_attachment_asset": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Links to pages on GOV.UK without a corresponding GUID. eg A filtered list of publications",
              "type": "object",
              "required": [
                "title",
                "path"
              ],
              "properties": {
                "path": {
                  "$ref": "#/$defs/absolute_fullpath"
                },
                "title": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^path$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "attachment_type",
                "content_type",
                "id",
                "url"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "attachment_type": {
                  "type": "string",
                  "enum": [
                    "file"
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "preview_url": {
                  "type": "string",
                  "format": "uri"
                },
                "id": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "number_of_pages": {
                  "type": "integer"
                },
                "accessible": {
                  "type": "boolean"
                },
                "file_size": {
                  "type": "integer"
                },
                "content_type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "alternative_format_contact_email": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^accessible$": true,
                "^preview_url$": true,
                "^file_size$": true,
                "^locale$": true,
                "^url$": true,
                "^id$": true,
                "^title$": true,
                "^number_of_pages$": true,
                "^attachment_type$": true,
                "^alternative_format_contact_email$": true,
                "^content_type$": true,
                "^filename$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "details": {
      "$ref": "#/$defs/modern_8"
    },
    "internal_link_without_guid": {
      "$ref": "#/$defs/modern_9"
    },
    "title": {
      "type": "string"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
