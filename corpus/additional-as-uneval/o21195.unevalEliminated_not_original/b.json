{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_9",
  "$defs": {
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Collection group",
              "type": "object",
              "required": [
                "title",
                "documents"
              ],
              "properties": {
                "body": {
                  "$ref": "#/$defs/body"
                },
                "documents": {
                  "description": "An ordered list of documents in this collection group",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/guid"
                  }
                },
                "title": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^body$": true,
                "^documents$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ]
    },
    "first_public_at": {
      "description": "DEPRECATED. The date the content was first published. Used in details. Deprecated in favour of top level `first_published_at`.",
      "type": "string",
      "format": "date-time"
    },
    "analytics_identifier": {
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "route": {
      "$ref": "#/$defs/modern_3"
    },
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "type": "string",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$"
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "auth_bypass_ids": {
                  "description": "Deprecated: auth_bypass_ids should be sent as a separate field",
                  "$ref": "#/$defs/guid_list"
                },
                "organisations": {
                  "description": "A list of organisation content ids permitted access to this item",
                  "$ref": "#/$defs/guid_list"
                },
                "users": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^organisations$": true,
                "^users$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guid"
      },
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Field used by email-alert-api to trigger email alerts for subscriptions to topics (gov.uk/topic) and policies (gov.uk/policies).",
              "type": "object",
              "properties": {
                "topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "browse_pages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "additional_topics": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "primary_topic": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "policies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^additional_topics$": true,
                "^topics$": true,
                "^primary_topic$": true,
                "^browse_pages$": true,
                "^policies$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "access_limited": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "public_timestamp",
                "note"
              ],
              "properties": {
                "note": {
                  "description": "A summary of the change",
                  "type": "string"
                },
                "public_timestamp": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^note$": true,
                "^public_timestamp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "body": {
      "description": "The main content provided as HTML rendered from govspeak",
      "type": "string"
    },
    "guid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "collection_groups",
                "political"
              ],
              "properties": {
                "body": {
                  "$ref": "#/$defs/body"
                },
                "tags": {
                  "$ref": "#/$defs/tags"
                },
                "change_history": {
                  "$ref": "#/$defs/change_history"
                },
                "first_public_at": {
                  "$ref": "#/$defs/first_public_at"
                },
                "collection_groups": {
                  "description": "The ordered list of collection groups",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "brexit_no_deal_notice": {
                  "$ref": "#/$defs/brexit_no_deal_notice"
                },
                "emphasised_organisations": {
                  "$ref": "#/$defs/emphasised_organisations"
                },
                "political": {
                  "$ref": "#/$defs/political"
                },
                "government": {
                  "$ref": "#/$defs/government"
                }
              }
            },
            {
              "patternProperties": {
                "^collection_groups$": true,
                "^body$": true,
                "^emphasised_organisations$": true,
                "^political$": true,
                "^change_history$": true,
                "^government$": true,
                "^brexit_no_deal_notice$": true,
                "^first_public_at$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "tags": {
      "$ref": "#/$defs/modern_5"
    },
    "change_history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_6"
      }
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ]
    },
    "public_updated_at": {
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "DEPRECATED: Content should be associated with a government through a link",
              "type": "object",
              "required": [
                "title",
                "slug",
                "current"
              ],
              "properties": {
                "current": {
                  "description": "Is the government that published this document still the current government.",
                  "type": "boolean"
                },
                "slug": {
                  "description": "Government slug, used for analytics, eg '1970-to-1974-conservative-government'.",
                  "type": "string"
                },
                "title": {
                  "description": "Name of the government that first published this document, eg '1970 to 1974 Conservative government'.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^current$": true,
                "^slug$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "political": {
      "description": "If the content is considered political in nature, reflecting views of the government it was published under.",
      "type": "boolean"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "title",
                "href"
              ],
              "properties": {
                "href": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^href$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "government": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "base_path",
                "details",
                "document_type",
                "publishing_app",
                "rendering_app",
                "routes",
                "schema_name",
                "title"
              ],
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "routes": {
                  "$ref": "#/$defs/routes"
                },
                "previous_version": {
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "change_note": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_10"
                },
                "update_type": {
                  "$ref": "#/$defs/update_type"
                },
                "document_type": {
                  "type": "string",
                  "enum": [
                    "document_collection"
                  ]
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "access_limited": {
                  "$ref": "#/$defs/access_limited"
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "type": "string",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ]
                },
                "need_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "auth_bypass_ids": {
                  "description": "A list of ids that will allow access to this item for non-authenticated users",
                  "$ref": "#/$defs/guid_list"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "bulk_publishing": {
                  "type": "boolean"
                },
                "last_edited_at": {
                  "description": "Last time when the content received a major or minor update.",
                  "type": "string",
                  "format": "date-time"
                },
                "schema_name": {
                  "type": "string",
                  "enum": [
                    "document_collection"
                  ]
                },
                "links": {
                  "$ref": "#/$defs/modern_11"
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^rendering_app$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^details$": true,
                "^previous_version$": true,
                "^need_ids$": true,
                "^links$": true,
                "^document_type$": true,
                "^phase$": true,
                "^first_published_at$": true,
                "^routes$": true,
                "^update_type$": true,
                "^schema_name$": true,
                "^base_path$": true,
                "^access_limited$": true,
                "^redirects$": true,
                "^description$": true,
                "^last_edited_at$": true,
                "^analytics_identifier$": true,
                "^public_updated_at$": true,
                "^change_note$": true,
                "^title$": true,
                "^bulk_publishing$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "brexit_no_deal_notice": {
      "description": "A list of URLs and titles for a brexit no deal notice.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_8"
      }
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "path",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "details": {
      "$ref": "#/$defs/modern_1"
    },
    "title": {
      "type": "string"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "related_policies": {
                  "$ref": "#/$defs/guid_list"
                },
                "original_primary_publishing_organisation": {
                  "description": "The organisation that published the original version of the page. Corresponds to the first of the 'Lead organisations' in Whitehall for the first edition, and is empty for all other publishing applications.",
                  "$ref": "#/$defs/guid_list"
                },
                "documents": {
                  "$ref": "#/$defs/guid_list"
                },
                "policy_areas": {
                  "description": "A largely deprecated tag currently only used to power email alerts.",
                  "$ref": "#/$defs/guid_list"
                },
                "parent": {
                  "$ref": "#/$defs/guid_list"
                },
                "topics": {
                  "$ref": "#/$defs/guid_list"
                },
                "topical_events": {
                  "$ref": "#/$defs/guid_list"
                },
                "government": {
                  "description": "The government associated with this document",
                  "$ref": "#/$defs/guid_list",
                  "maxItems": 1
                },
                "primary_publishing_organisation": {
                  "description": "The organisation that published the page. Corresponds to the first of the 'Lead organisations' in Whitehall, and is empty for all other publishing applications.",
                  "$ref": "#/$defs/guid_list",
                  "maxItems": 1
                },
                "organisations": {
                  "$ref": "#/$defs/guid_list"
                }
              }
            },
            {
              "patternProperties": {
                "^topical_events$": true,
                "^documents$": true,
                "^organisations$": true,
                "^primary_publishing_organisation$": true,
                "^government$": true,
                "^policy_areas$": true,
                "^parent$": true,
                "^original_primary_publishing_organisation$": true,
                "^related_policies$": true,
                "^topics$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "emphasised_organisations": {
      "description": "The content ids of the organisations that should be displayed first in the list of organisations related to the item, these content ids must be present in the item organisation links hash.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/guid"
      }
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    }
  }
}
