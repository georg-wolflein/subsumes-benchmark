{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_6",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "explanation": {
                  "type": "string"
                },
                "withdrawn_at": {
                  "format": "date-time"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^explanation$": true,
                "^withdrawn_at$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "frontend_links": {
      "items": {
        "$ref": "#/$defs/modern_1"
      },
      "type": "array"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "change_history": {
                  "$ref": "#/$defs/change_history"
                },
                "hidden_search_terms": {
                  "$ref": "#/$defs/hidden_search_terms"
                },
                "url": {
                  "_format": "uri",
                  "description": "A URL for the external resource",
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^change_history$": true,
                "^hidden_search_terms$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "locale": {
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ],
      "type": "string"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": true,
              "type": "array"
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "analytics_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations."
    },
    "title": {
      "type": "string"
    },
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$",
      "type": "string"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links_with_base_path"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "base_path",
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "_format": "date-time",
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "routes": {
                  "$ref": "#/$defs/modern_7"
                },
                "user_journey_document_supertype": {
                  "description": "Document type grouping powering analytics of user journeys",
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "search_user_need_document_supertype": {
                  "description": "Document supertype grouping core and government documents",
                  "type": "string"
                },
                "need_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "content_purpose_document_supertype": {
                  "description": "DEPRECATED. Use `content_purpose_subgroup`.",
                  "type": "string"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_8"
                },
                "document_type": {
                  "enum": [
                    "external_content"
                  ],
                  "type": "string"
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "content_purpose_subgroup": {
                  "description": "Document subgroup grouping documents by purpose. Narrows down the purpose defined in content_purpose_supergroup.",
                  "type": "string"
                },
                "expanded_links": {
                  "$ref": "#/$defs/modern_9"
                },
                "base_path": {
                  "type": "null"
                },
                "user_need_document_supertype": {
                  "description": "DEPRECATED. Use `content_purpose_document_supertype`.",
                  "type": "string"
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ],
                  "type": "string"
                },
                "payload_version": {
                  "$ref": "#/$defs/payload_version"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "email_document_supertype": {
                  "description": "Document supertype grouping intended to power the Whitehall finders and email subscriptions",
                  "type": "string"
                },
                "schema_name": {
                  "enum": [
                    "external_content"
                  ],
                  "type": "string"
                },
                "links": {
                  "$ref": "#/$defs/modern_10"
                },
                "rendering_app": {
                  "type": "null"
                },
                "govuk_request_id": {
                  "$ref": "#/$defs/govuk_request_id"
                },
                "navigation_document_supertype": {
                  "description": "Document type grouping powering the new taxonomy-based navigation pages",
                  "type": "string"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "publishing_request_id": {
                  "$ref": "#/$defs/publishing_request_id"
                },
                "withdrawn_notice": {
                  "$ref": "#/$defs/withdrawn_notice"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "content_purpose_supergroup": {
                  "description": "Document supergroup grouping documents by a purpose",
                  "type": "string"
                },
                "update_type": {
                  "$ref": "#/$defs/update_type"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "government_document_supertype": {
                  "description": "Document supertype grouping intended to power the Whitehall finders and email subscriptions",
                  "type": "string"
                }
              },
              "required": [
                "analytics_identifier",
                "base_path",
                "content_id",
                "description",
                "details",
                "document_type",
                "email_document_supertype",
                "expanded_links",
                "first_published_at",
                "government_document_supertype",
                "govuk_request_id",
                "links",
                "locale",
                "navigation_document_supertype",
                "payload_version",
                "phase",
                "public_updated_at",
                "publishing_app",
                "redirects",
                "rendering_app",
                "routes",
                "schema_name",
                "title",
                "update_type",
                "user_journey_document_supertype"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^content_purpose_supergroup$": true,
                "^base_path$": true,
                "^user_need_document_supertype$": true,
                "^rendering_app$": true,
                "^payload_version$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^need_ids$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^first_published_at$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^update_type$": true,
                "^schema_name$": true,
                "^expanded_links$": true,
                "^search_user_need_document_supertype$": true,
                "^government_document_supertype$": true,
                "^email_document_supertype$": true,
                "^redirects$": true,
                "^description$": true,
                "^details$": true,
                "^withdrawn_notice$": true,
                "^content_purpose_subgroup$": true,
                "^content_purpose_document_supertype$": true,
                "^phase$": true,
                "^user_journey_document_supertype$": true,
                "^navigation_document_supertype$": true,
                "^routes$": true,
                "^govuk_request_id$": true,
                "^publishing_request_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "type": "string"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "payload_version": {
      "description": "Counter to indicate when the payload was generated",
      "type": "integer"
    },
    "change_history": {
      "items": {
        "$ref": "#/$defs/modern_3"
      },
      "type": "array"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ],
      "type": "string"
    },
    "public_updated_at": {
      "_format": "date-time",
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": true,
              "type": "array"
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "frontend_links_with_base_path": {
      "items": {
        "$ref": "#/$defs/modern_4"
      },
      "type": "array"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "children": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "role_appointments": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Link type automatically added by Publishing API"
                },
                "related_to_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "child_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "secondary_to_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "policies": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "available_translations": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "part_of_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "topic_taxonomy_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "level_one_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "ministers": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Link type automatically added by Publishing API"
                },
                "document_collections": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^role_appointments$": true,
                "^children$": true,
                "^policies$": true,
                "^document_collections$": true,
                "^topic_taxonomy_taxons$": true,
                "^level_one_taxons$": true,
                "^available_translations$": true,
                "^related_to_step_navs$": true,
                "^child_taxons$": true,
                "^part_of_step_navs$": true,
                "^ministers$": true,
                "^secondary_to_step_navs$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "govuk_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "note": {
                  "description": "A summary of the change",
                  "type": "string"
                },
                "public_timestamp": {
                  "_format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "public_timestamp",
                "note"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^note$": true,
                "^public_timestamp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "details": {
      "$ref": "#/$defs/modern_2"
    },
    "publishing_request_id": {
      "description": "A unique identifier used to track publishing requests to rendered content",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "withdrawn_notice": {
      "$ref": "#/$defs/modern_5"
    },
    "hidden_search_terms": {
      "description": "List of words/phrases the user can search for that aren't present on the page.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    }
  }
}
