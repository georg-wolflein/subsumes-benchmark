{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "maxItems",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21205.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21205.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "guid_list": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/guid"
        },
        "_uniqueItems": true
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "facet_values": {
                    "description": "Possible facet_values to show for non-dynamic select facets. All values are shown regardless of the search.",
                    "$ref": "#/$defs/guid_list"
                  },
                  "parent": {
                    "description": "The facet_group this facet belongs to.",
                    "$ref": "#/$defs/guid_list",
                    "maxItems": 1
                  }
                }
              },
              {
                "patternProperties": {
                  "^facet_values$": true,
                  "^parent$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "guid": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "bulk_publishing": {
                    "type": "boolean"
                  },
                  "links": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "previous_version": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^bulk_publishing$": true,
                  "^links$": true,
                  "^previous_version$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bulk_publishing": {
        "type": "boolean"
      },
      "links": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "facet_values": {
            "description": "Possible facet_values to show for non-dynamic select facets. All values are shown regardless of the search.",
            "$ref": "#/$defs/guid_list"
          },
          "parent": {
            "description": "The facet_group this facet belongs to.",
            "$ref": "#/$defs/guid_list",
            "maxItems": 1
          }
        }
      },
      "previous_version": {
        "type": "string"
      }
    },
    "$defs": {
      "guid": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
      },
      "guid_list": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/guid"
        },
        "_uniqueItems": true
      }
    }
  }
}
