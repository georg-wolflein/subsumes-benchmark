{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_10",
  "$defs": {
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "base_path",
                "details",
                "document_type",
                "publishing_app",
                "rendering_app",
                "routes",
                "schema_name",
                "title"
              ],
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "routes": {
                  "$ref": "#/$defs/routes"
                },
                "previous_version": {
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "change_note": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_11"
                },
                "update_type": {
                  "$ref": "#/$defs/update_type"
                },
                "document_type": {
                  "type": "string",
                  "enum": [
                    "finder",
                    "search"
                  ]
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "access_limited": {
                  "$ref": "#/$defs/access_limited"
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "type": "string",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ]
                },
                "need_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "auth_bypass_ids": {
                  "description": "A list of ids that will allow access to this item for non-authenticated users",
                  "$ref": "#/$defs/guid_list"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "bulk_publishing": {
                  "type": "boolean"
                },
                "last_edited_at": {
                  "description": "Last time when the content received a major or minor update.",
                  "type": "string",
                  "format": "date-time"
                },
                "schema_name": {
                  "type": "string",
                  "enum": [
                    "finder"
                  ]
                },
                "links": {
                  "$ref": "#/$defs/modern_12"
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^rendering_app$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^details$": true,
                "^previous_version$": true,
                "^need_ids$": true,
                "^links$": true,
                "^document_type$": true,
                "^phase$": true,
                "^first_published_at$": true,
                "^routes$": true,
                "^update_type$": true,
                "^schema_name$": true,
                "^base_path$": true,
                "^access_limited$": true,
                "^redirects$": true,
                "^description$": true,
                "^last_edited_at$": true,
                "^analytics_identifier$": true,
                "^public_updated_at$": true,
                "^change_note$": true,
                "^title$": true,
                "^bulk_publishing$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ]
    },
    "finder_summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "auth_bypass_ids": {
                  "description": "Deprecated: auth_bypass_ids should be sent as a separate field",
                  "$ref": "#/$defs/guid_list"
                },
                "organisations": {
                  "description": "A list of organisation content ids permitted access to this item",
                  "$ref": "#/$defs/guid_list"
                },
                "users": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^organisations$": true,
                "^users$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "This is the fixed filter that scopes the finder",
              "type": "object",
              "properties": {
                "format": {
                  "type": "string"
                },
                "content_purpose_subgroup": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "all_part_of_taxonomy_tree": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "email_document_supertype": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "has_official_document": {
                  "type": "boolean"
                },
                "content_purpose_supergroup": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "facet_groups": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "document_type": {
                  "type": "string"
                },
                "policies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "content_store_document_type": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "organisations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^email_document_supertype$": true,
                "^content_purpose_supergroup$": true,
                "^has_official_document$": true,
                "^facet_groups$": true,
                "^content_purpose_subgroup$": true,
                "^organisations$": true,
                "^policies$": true,
                "^document_type$": true,
                "^all_part_of_taxonomy_tree$": true,
                "^content_store_document_type$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "analytics_identifier": {
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "guid_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guid"
      },
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A map of keys to values that can be used to associate allowed_values with multiple values",
              "type": "object",
              "patternProperties": {
                "^[a-z_]+$": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^[a-z_]+$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "access_limited": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "path",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "finder_show_summaries": {
      "type": "boolean"
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1
    },
    "guid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "finder_signup_link": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "document_noun",
                "facets"
              ],
              "properties": {
                "signup_link": {
                  "$ref": "#/$defs/finder_signup_link"
                },
                "default_documents_per_page": {
                  "$ref": "#/$defs/finder_default_documents_per_page"
                },
                "logo_path": {
                  "type": "string"
                },
                "beta_message": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reject": {
                  "$ref": "#/$defs/finder_reject_filter"
                },
                "show_summaries": {
                  "$ref": "#/$defs/finder_show_summaries"
                },
                "default_order": {
                  "$ref": "#/$defs/finder_default_order"
                },
                "beta": {
                  "$ref": "#/$defs/finder_beta"
                },
                "facets": {
                  "$ref": "#/$defs/finder_facets"
                },
                "summary": {
                  "$ref": "#/$defs/finder_summary"
                },
                "document_noun": {
                  "$ref": "#/$defs/finder_document_noun"
                },
                "no_index": {
                  "type": "boolean"
                },
                "generic_description": {
                  "type": "boolean"
                },
                "format_name": {
                  "type": "string"
                },
                "filter": {
                  "$ref": "#/$defs/finder_filter"
                },
                "canonical_link": {
                  "type": "boolean"
                },
                "sort": {
                  "$ref": "#/$defs/finder_sort"
                }
              }
            },
            {
              "patternProperties": {
                "^default_order$": true,
                "^sort$": true,
                "^no_index$": true,
                "^facets$": true,
                "^beta_message$": true,
                "^summary$": true,
                "^document_noun$": true,
                "^format_name$": true,
                "^beta$": true,
                "^show_summaries$": true,
                "^default_documents_per_page$": true,
                "^filter$": true,
                "^canonical_link$": true,
                "^generic_description$": true,
                "^signup_link$": true,
                "^reject$": true,
                "^logo_path$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "public_updated_at": {
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A fixed filter that rejects documents which match the conditions",
              "type": "object",
              "properties": {
                "email_document_supertype": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "link": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "content_store_document_type": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "content_purpose_supergroup": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "policies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^email_document_supertype$": true,
                "^content_purpose_supergroup$": true,
                "^content_store_document_type$": true,
                "^policies$": true,
                "^link$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "finder_document_noun": {
      "description": "How to refer to documents when presenting the search results",
      "type": "string"
    },
    "finder_beta": {
      "description": "Indicates if finder is in beta. TODO: Switch to top-level phase label",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "policy_areas": {
                  "description": "A largely deprecated tag currently only used to power email alerts.",
                  "$ref": "#/$defs/guid_list"
                }
              }
            },
            {
              "patternProperties": {
                "^policy_areas$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "finder_default_order": {
      "description": "DEPRECATED: Use \u201csort\u201d property",
      "type": "string"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "One of many possible values a user can select from",
              "type": "object",
              "required": [
                "label",
                "value"
              ],
              "properties": {
                "default": {
                  "description": "The default option for a radio facet",
                  "type": "boolean"
                },
                "label": {
                  "description": "A human readable label",
                  "type": "string"
                },
                "value": {
                  "description": "A value to use for form controls",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^default$": true,
                "^label$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "key",
                "name"
              ],
              "properties": {
                "default": {
                  "description": "Indicates if this should be the default sort option",
                  "type": "boolean"
                },
                "key": {
                  "description": "Rummager field name, with an optional preceding \u201c-\u201d to sort in descending order",
                  "type": "string"
                },
                "name": {
                  "description": "Label for the sort option",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^default$": true,
                "^key$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "details": {
      "$ref": "#/$defs/modern_1"
    },
    "finder_sort": {
      "description": "These are the options for sorting the finder",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_3"
      }
    },
    "finder_facets": {
      "description": "The facets shown to the user to refine their search.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_4"
      }
    },
    "route": {
      "$ref": "#/$defs/modern_6"
    },
    "finder_reject_filter": {
      "$ref": "#/$defs/modern_7"
    },
    "title": {
      "type": "string"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "finder_filter": {
      "$ref": "#/$defs/modern_8"
    },
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "type": "string",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$"
    },
    "label_value_pair": {
      "$ref": "#/$defs/modern_9"
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    },
    "finder_default_documents_per_page": {
      "description": "Specify this to paginate results",
      "type": "integer"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "key",
                "filterable",
                "display_as_result_metadata"
              ],
              "properties": {
                "name": {
                  "description": "Label for the facet.",
                  "type": "string"
                },
                "combine_mode": {
                  "description": "Specifies how to combine with other facets",
                  "type": "string",
                  "default": "and",
                  "enum": [
                    "and",
                    "or"
                  ]
                },
                "hide_facet_tag": {
                  "description": "Causes the facet to not have a facet tag shown in a finder",
                  "type": "boolean"
                },
                "filter_value": {
                  "description": "A preset filter value that is applied when a checkbox is selected",
                  "type": "string"
                },
                "key": {
                  "description": "The rummager field name used for this facet.",
                  "type": "string"
                },
                "display_as_result_metadata": {
                  "description": "Include this in search result metadata. Can be set for non-filterable facets.",
                  "type": "boolean"
                },
                "short_name": {
                  "type": "string"
                },
                "show_option_select_filter": {
                  "description": "Controls whether Option Select Facet displays a filter field",
                  "type": "boolean"
                },
                "keys": {
                  "description": "Field names used for the taxon drop down.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "allowed_values": {
                  "description": "Possible values to show for non-dynamic select facets. All values are shown regardless of the search.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/label_value_pair"
                  }
                },
                "option_lookup": {
                  "$ref": "#/$defs/modern_5"
                },
                "closed_value": {
                  "description": "Value that determines the closed state (the key field is in the past) of a topical facet.",
                  "$ref": "#/$defs/label_value_pair"
                },
                "open_value": {
                  "description": "Value that determines the open state (the key field is in the future) of a topical facet.",
                  "$ref": "#/$defs/label_value_pair"
                },
                "type": {
                  "description": "Defines the UI component and how the facet is queried from the search API",
                  "type": "string",
                  "enum": [
                    "autocomplete",
                    "checkbox",
                    "date",
                    "hidden",
                    "hidden_clearable",
                    "radio",
                    "research_and_statistics",
                    "official_documents",
                    "taxon",
                    "text",
                    "topical"
                  ]
                },
                "filter_key": {
                  "description": "The exact rummager field name for this facet. Allows 'key' to be aliased to a rummager filter field",
                  "type": "string"
                },
                "filterable": {
                  "description": "This must be true to show the facet to users.",
                  "type": "boolean"
                },
                "preposition": {
                  "description": "Text used to augment the description of the search when the facet is used.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^filter_value$": true,
                "^keys$": true,
                "^filter_key$": true,
