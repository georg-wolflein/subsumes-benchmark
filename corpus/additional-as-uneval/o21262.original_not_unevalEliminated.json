      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "The parent manual for a manual section",
                "type": "object",
                "required": [
                  "base_path"
                ],
                "properties": {
                  "base_path": {
                    "$ref": "#/$defs/absolute_path"
                  }
                }
              },
              {
                "patternProperties": {
                  "^base_path$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "hmrc_manual_breadcrumbs": {
        "description": "Breadcrumbs for HMRC manuals based on section",
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_1"
        }
      },
      "locale": {
        "type": "string",
        "enum": [
          "ar",
          "az",
          "be",
          "bg",
          "bn",
          "cs",
          "cy",
          "da",
          "de",
          "dr",
          "el",
          "en",
          "es",
          "es-419",
          "et",
          "fa",
          "fi",
          "fr",
          "gd",
          "he",
          "hi",
          "hr",
          "hu",
          "hy",
          "id",
          "is",
          "it",
          "ja",
          "ka",
          "kk",
          "ko",
          "lt",
          "lv",
          "ms",
          "mt",
          "nl",
          "no",
          "pl",
          "ps",
          "pt",
          "ro",
          "ru",
          "si",
          "sk",
          "sl",
          "so",
          "sq",
          "sr",
          "sv",
          "sw",
          "ta",
          "th",
          "tk",
          "tr",
          "uk",
          "ur",
          "uz",
          "vi",
          "zh",
          "zh-hk",
          "zh-tw"
        ]
      },
      "modern_8": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "title",
                  "abbreviation",
                  "web_url"
                ],
                "properties": {
                  "abbreviation": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "web_url": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^abbreviation$": true,
                  "^title$": true,
                  "^web_url$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "analytics_identifier": {
        "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.",
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "manual_section_parent": {
        "$ref": "#/$defs/modern_2"
      },
      "absolute_path": {
        "description": "A path only. Query string and/or fragment are not allowed.",
        "type": "string",
        "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$"
      },
      "update_type": {
        "enum": [
          "major",
          "minor",
          "republish"
        ]
      },
      "description_optional": {
        "anyOf": [
          {
            "$ref": "#/$defs/description"
          },
          {
            "type": "null"
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "child_sections"
                ],
                "properties": {
                  "child_sections": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_5"
                    }
                  },
                  "title": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^child_sections$": true,
                  "^title$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "guid_list": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/guid"
        },
        "_uniqueItems": true
      },
      "modern_5": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "section_id",
                  "title",
                  "description",
                  "base_path"
                ],
                "properties": {
                  "base_path": {
                    "$ref": "#/$defs/absolute_path"
                  },
                  "description": {
                    "type": "string"
                  },
                  "section_id": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^base_path$": true,
                  "^description$": true,
                  "^section_id$": true,
                  "^title$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "first_published_at": {
        "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
        "type": "string",
        "format": "date-time"
      },
      "hmrc_manual_child_section_groups": {
        "description": "Grouped sections of an HMRC manual. Differs from manuals as section_id is required and group titles are optional.",
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_4"
        }
      },
      "access_limited": {
        "$ref": "#/$defs/modern_6"
      },
      "modern_6": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "auth_bypass_ids": {
                    "description": "Deprecated: auth_bypass_ids should be sent as a separate field",
                    "$ref": "#/$defs/guid_list"
                  },
                  "organisations": {
                    "description": "A list of organisation content ids permitted access to this item",
                    "$ref": "#/$defs/guid_list"
                  },
                  "users": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^auth_bypass_ids$": true,
                  "^organisations$": true,
                  "^users$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "body": {
        "description": "The main content provided as HTML rendered from govspeak",
        "type": "string"
      },
      "guid": {
        "type": "string",
        "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "base_path",
                  "section_id"
                ],
                "properties": {
                  "base_path": {
                    "$ref": "#/$defs/absolute_path"
                  },
                  "section_id": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^base_path$": true,
                  "^section_id$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "public_updated_at": {
        "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
        "type": "string",
        "format": "date-time"
      },
      "modern_7": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "type"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "prefix",
                      "exact"
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^path$": true,
                  "^type$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_9": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "base_path",
                  "details",
                  "document_type",
                  "publishing_app",
                  "rendering_app",
                  "routes",
                  "schema_name",
                  "title"
                ],
                "properties": {
                  "base_path": {
                    "$ref": "#/$defs/absolute_path"
                  },
                  "routes": {
                    "$ref": "#/$defs/routes"
                  },
                  "previous_version": {
                    "type": "string"
                  },
                  "public_updated_at": {
                    "$ref": "#/$defs/public_updated_at"
                  },
                  "change_note": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "analytics_identifier": {
                    "$ref": "#/$defs/analytics_identifier"
                  },
                  "rendering_app": {
                    "$ref": "#/$defs/rendering_app"
                  },
                  "details": {
                    "$ref": "#/$defs/details"
                  },
                  "title": {
                    "$ref": "#/$defs/title"
                  },
                  "redirects": {
                    "$ref": "#/$defs/modern_10"
                  },
                  "update_type": {
                    "$ref": "#/$defs/update_type"
                  },
                  "document_type": {
                    "type": "string",
                    "enum": [
                      "hmrc_manual_section"
                    ]
                  },
                  "publishing_app": {
                    "$ref": "#/$defs/publishing_app_name"
                  },
                  "first_published_at": {
                    "$ref": "#/$defs/first_published_at"
                  },
                  "access_limited": {
                    "$ref": "#/$defs/access_limited"
                  },
                  "description": {
                    "$ref": "#/$defs/description_optional"
                  },
                  "phase": {
                    "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                    "type": "string",
                    "enum": [
                      "alpha",
                      "beta",
                      "live"
                    ]
                  },
                  "need_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "auth_bypass_ids": {
                    "description": "A list of ids that will allow access to this item for non-authenticated users",
                    "$ref": "#/$defs/guid_list"
                  },
                  "locale": {
                    "$ref": "#/$defs/locale"
                  },
                  "bulk_publishing": {
                    "type": "boolean"
                  },
                  "last_edited_at": {
                    "description": "Last time when the content received a major or minor update.",
                    "type": "string",
                    "format": "date-time"
                  },
                  "schema_name": {
                    "type": "string",
                    "enum": [
                      "hmrc_manual_section"
                    ]
                  },
                  "links": {
                    "$ref": "#/$defs/modern_11"
                  }
                }
              },
              {
                "patternProperties": {
                  "^auth_bypass_ids$": true,
                  "^rendering_app$": true,
                  "^publishing_app$": true,
                  "^locale$": true,
                  "^details$": true,
                  "^previous_version$": true,
                  "^need_ids$": true,
                  "^links$": true,
                  "^document_type$": true,
                  "^phase$": true,
                  "^first_published_at$": true,
                  "^routes$": true,
                  "^update_type$": true,
                  "^schema_name$": true,
                  "^base_path$": true,
                  "^access_limited$": true,
                  "^redirects$": true,
                  "^description$": true,
                  "^last_edited_at$": true,
                  "^analytics_identifier$": true,
                  "^public_updated_at$": true,
                  "^change_note$": true,
                  "^title$": true,
                  "^bulk_publishing$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "rendering_app": {
        "description": "The application that renders this item.",
        "type": "string",
        "enum": [
          "calculators",
          "calendars",
          "collections",
          "content-store",
          "email-alert-frontend",
          "email-campaign-frontend",
          "feedback",
          "finder-frontend",
          "frontend",
          "government-frontend",
          "info-frontend",
          "licencefinder",
          "manuals-frontend",
          "performanceplatform-big-screen-view",
          "rummager",
          "search-api",
          "service-manual-frontend",
          "smartanswers",
          "spotlight",
          "static",
          "tariff",
          "whitehall-admin",
          "whitehall-frontend"
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "section_id",
                  "manual"
                ],
                "properties": {
                  "breadcrumbs": {
                    "$ref": "#/$defs/hmrc_manual_breadcrumbs"
                  },
                  "body": {
                    "$ref": "#/$defs/body"
                  },
                  "child_section_groups": {
                    "$ref": "#/$defs/hmrc_manual_child_section_groups"
                  },
                  "section_id": {
                    "type": "string"
                  },
                  "organisations": {
                    "$ref": "#/$defs/manual_organisations"
                  },
                  "manual": {
                    "$ref": "#/$defs/manual_section_parent"
                  }
                }
              },
              {
                "patternProperties": {
                  "^breadcrumbs$": true,
                  "^body$": true,
                  "^organisations$": true,
                  "^manual$": true,
                  "^child_section_groups$": true,
                  "^section_id$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "details": {
        "$ref": "#/$defs/modern_3"
      },
      "route": {
        "$ref": "#/$defs/modern_7"
      },
      "manual_organisations": {
        "description": "A manual\u2019s organisations. TODO: Switch to use organisations in links",
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_8"
        }
      },
      "title": {
        "type": "string"
      },
      "modern_11": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "policy_areas": {
                    "description": "A largely deprecated tag currently only used to power email alerts.",
                    "$ref": "#/$defs/guid_list"
                  }
                }
              },
              {
                "patternProperties": {
                  "^policy_areas$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
