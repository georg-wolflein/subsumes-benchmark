{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "updated_at": {
                  "_format": "date-time",
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "enum": [
                    "homepage",
                    "service_manual_homepage"
                  ],
                  "type": "string"
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/first_published_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ],
                  "type": "string"
                },
                "public_updated_at": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "publishing_scheduled_at": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/publishing_scheduled_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "need_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "scheduled_publishing_delay_seconds": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/scheduled_publishing_delay_seconds"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "schema_name": {
                  "enum": [
                    "homepage"
                  ],
                  "type": "string"
                },
                "links": {
                  "$ref": "#/$defs/modern_6"
                },
                "publishing_request_id": {
                  "$ref": "#/$defs/publishing_request_id"
                },
                "withdrawn_notice": {
                  "$ref": "#/$defs/withdrawn_notice"
                }
              },
              "required": [
                "base_path",
                "content_id",
                "description",
                "details",
                "document_type",
                "links",
                "locale",
                "public_updated_at",
                "schema_name",
                "title",
                "updated_at"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^updated_at$": true,
                "^base_path$": true,
                "^description$": true,
                "^rendering_app$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^need_ids$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^publishing_scheduled_at$": true,
                "^document_type$": true,
                "^first_published_at$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^publishing_request_id$": true,
                "^schema_name$": true,
                "^details$": true,
                "^withdrawn_notice$": true,
                "^phase$": true,
                "^scheduled_publishing_delay_seconds$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "frontend_links": {
      "items": {
        "$ref": "#/$defs/modern_1"
      },
      "type": "array"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "note": {
                  "description": "A summary of the change",
                  "type": "string"
                },
                "public_timestamp": {
                  "_format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "public_timestamp",
                "note"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^note$": true,
                "^public_timestamp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "scheduled_publishing_delay_seconds": {
      "description": "The delay between the most recent scheduled and actual publishing times. Determined by the content store based on the publishing intent.",
      "type": "integer"
    },
    "locale": {
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ],
      "type": "string"
    },
    "analytics_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations."
    },
    "title": {
      "type": "string"
    },
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$",
      "type": "string"
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "explanation": {
                  "type": "string"
                },
                "withdrawn_at": {
                  "format": "date-time"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^explanation$": true,
                "^withdrawn_at$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "_format": "date-time",
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "children": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "role_appointments": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Link type automatically added by Publishing API"
                },
                "related_to_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "child_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "policy_areas": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "A largely deprecated tag currently only used to power email alerts."
                },
                "secondary_to_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "policies": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "available_translations": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "part_of_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "topic_taxonomy_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "level_one_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "ministers": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Link type automatically added by Publishing API"
                },
                "document_collections": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^role_appointments$": true,
                "^children$": true,
                "^policies$": true,
                "^document_collections$": true,
                "^topic_taxonomy_taxons$": true,
                "^level_one_taxons$": true,
                "^policy_areas$": true,
                "^available_translations$": true,
                "^related_to_step_navs$": true,
                "^child_taxons$": true,
                "^part_of_step_navs$": true,
                "^ministers$": true,
                "^secondary_to_step_navs$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "type": "string"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "change_history": {
      "items": {
        "$ref": "#/$defs/modern_2"
      },
      "type": "array"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ],
      "type": "string"
    },
    "public_updated_at": {
      "_format": "date-time",
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "publishing_scheduled_at": {
      "_format": "date-time",
      "description": "When this content was last scheduled for publishing. Determined by the publishing intent sent by the publishing API.",
      "type": "string"
    },
    "frontend_links_with_base_path": {
      "items": {
        "$ref": "#/$defs/modern_3"
      },
      "type": "array"
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ],
      "type": "string"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links_with_base_path"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "base_path",
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "details": {
      "properties": {
        "change_history": {
          "$ref": "#/$defs/change_history"
        }
      },
      "type": "object"
    },
    "publishing_request_id": {
      "description": "A unique identifier used to track publishing requests to rendered content",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "withdrawn_notice": {
      "$ref": "#/$defs/modern_4"
    }
  }
}
