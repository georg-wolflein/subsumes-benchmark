{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_8",
  "$defs": {
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "policy_areas": {
                  "description": "A largely deprecated tag currently only used to power email alerts.",
                  "$ref": "#/$defs/guid_list"
                }
              }
            },
            {
              "patternProperties": {
                "^policy_areas$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "path",
                "type"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "base_path",
                "details",
                "document_type",
                "publishing_app",
                "rendering_app",
                "routes",
                "schema_name",
                "title"
              ],
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "routes": {
                  "$ref": "#/$defs/routes"
                },
                "previous_version": {
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "change_note": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_9"
                },
                "update_type": {
                  "$ref": "#/$defs/update_type"
                },
                "document_type": {
                  "type": "string",
                  "enum": [
                    "finder"
                  ]
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "access_limited": {
                  "$ref": "#/$defs/access_limited"
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "type": "string",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ]
                },
                "need_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "auth_bypass_ids": {
                  "description": "A list of ids that will allow access to this item for non-authenticated users",
                  "$ref": "#/$defs/guid_list"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "bulk_publishing": {
                  "type": "boolean"
                },
                "last_edited_at": {
                  "description": "Last time when the content received a major or minor update.",
                  "type": "string",
                  "format": "date-time"
                },
                "schema_name": {
                  "type": "string",
                  "enum": [
                    "organisations_homepage"
                  ]
                },
                "links": {
                  "$ref": "#/$defs/modern_10"
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^rendering_app$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^details$": true,
                "^previous_version$": true,
                "^need_ids$": true,
                "^links$": true,
                "^document_type$": true,
                "^phase$": true,
                "^first_published_at$": true,
                "^routes$": true,
                "^update_type$": true,
                "^schema_name$": true,
                "^base_path$": true,
                "^access_limited$": true,
                "^redirects$": true,
                "^description$": true,
                "^last_edited_at$": true,
                "^analytics_identifier$": true,
                "^public_updated_at$": true,
                "^change_note$": true,
                "^title$": true,
                "^bulk_publishing$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "analytics_identifier": {
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "route": {
      "$ref": "#/$defs/modern_2"
    },
    "title": {
      "type": "string"
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "title",
                "href",
                "separate_website",
                "format",
                "slug",
                "content_id"
              ],
              "properties": {
                "parent_organisations": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "superseded_organisations": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "slug": {
                  "type": "string"
                },
                "brand": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "child_organisations": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "logo": {
                  "type": "object",
                  "properties": {
                    "crest": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "bis",
                        "dit",
                        "eo",
                        "hmrc",
                        "ho",
                        "mod",
                        "portcullis",
                        "single-identity",
                        "so",
                        "ukaea",
                        "wales",
                        null
                      ]
                    },
                    "formatted_title": {
                      "type": "string"
                    },
                    "image": {
                      "$ref": "#/$defs/image"
                    },
                    "type_class_name": {
                      "type": "string"
                    }
                  }
                },
                "works_with": {
                  "$ref": "#/$defs/modern_5"
                },
                "govuk_closed_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "closed_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "govuk_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "superseding_organisations": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "separate_website": {
                  "type": "boolean"
                },
                "acronym": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "brand_colour_class": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "href": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^parent_organisations$": true,
                "^superseded_organisations$": true,
                "^govuk_status$": true,
                "^format$": true,
                "^govuk_closed_status$": true,
                "^logo$": true,
                "^superseding_organisations$": true,
                "^separate_website$": true,
                "^analytics_identifier$": true,
                "^works_with$": true,
                "^content_id$": true,
                "^child_organisations$": true,
                "^slug$": true,
                "^brand_colour_class$": true,
                "^href$": true,
                "^acronym$": true,
                "^closed_at$": true,
                "^updated_at$": true,
                "^brand$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/guid"
      },
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "civil_service": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "devolved_administration": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "executive_agency": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "non_ministerial_department": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "sub_organisation": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "adhoc_advisory_group": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "advisory_ndpb": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "executive_office": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "executive_ndpb": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "other": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "ministerial_department": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "tribunal": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "public_corporation": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                },
                "independent_monitoring_body": {
                  "$ref": "#/$defs/list_of_sub_organisations"
                }
              }
            },
            {
              "patternProperties": {
                "^public_corporation$": true,
                "^ministerial_department$": true,
                "^tribunal$": true,
                "^non_ministerial_department$": true,
                "^adhoc_advisory_group$": true,
                "^other$": true,
                "^executive_office$": true,
                "^executive_ndpb$": true,
                "^executive_agency$": true,
                "^independent_monitoring_body$": true,
                "^civil_service$": true,
                "^sub_organisation$": true,
                "^devolved_administration$": true,
                "^advisory_ndpb$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "access_limited": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "url"
              ],
              "properties": {
                "url": {
                  "description": "URL to the image. The image should be in a suitable resolution for display on the page.",
                  "type": "string",
                  "format": "uri"
                },
                "alt_text": {
                  "type": "string"
                },
                "credit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "high_resolution_url": {
                  "description": "URL to a high resolution version of the image, for use by third parties such as Twitter, Facebook or Slack. Used by the machine readable metadata component. Don't use this on user-facing web pages, as it might be very large.",
                  "type": "string",
                  "format": "uri"
                },
                "caption": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^credit$": true,
                "^url$": true,
                "^alt_text$": true,
                "^high_resolution_url$": true,
                "^caption$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "routes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1
    },
    "summary_organisations": {
      "description": "A list of all organisations of a particular type. Turn into proper links once details for organisations no longer need to be expanded.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_4"
      }
    },
    "guid": {
      "type": "string",
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "ordered_devolved_administrations": {
                  "$ref": "#/$defs/summary_organisations"
                },
                "ordered_executive_offices": {
                  "$ref": "#/$defs/summary_organisations"
                },
                "ordered_public_corporations": {
                  "$ref": "#/$defs/summary_organisations"
                },
                "ordered_high_profile_groups": {
                  "$ref": "#/$defs/summary_organisations"
                },
                "ordered_agencies_and_other_public_bodies": {
                  "$ref": "#/$defs/summary_organisations"
                },
                "ordered_ministerial_departments": {
                  "$ref": "#/$defs/summary_organisations"
                },
                "ordered_non_ministerial_departments": {
                  "$ref": "#/$defs/summary_organisations"
                }
              }
            },
            {
              "patternProperties": {
                "^ordered_devolved_administrations$": true,
                "^ordered_public_corporations$": true,
                "^ordered_non_ministerial_departments$": true,
                "^ordered_agencies_and_other_public_bodies$": true,
                "^ordered_ministerial_departments$": true,
                "^ordered_executive_offices$": true,
                "^ordered_high_profile_groups$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "image": {
      "$ref": "#/$defs/modern_6"
    },
    "public_updated_at": {
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string",
      "format": "date-time"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "title",
                "href"
              ],
              "properties": {
                "href": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^href$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "type": "string",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "auth_bypass_ids": {
                  "description": "Deprecated: auth_bypass_ids should be sent as a separate field",
                  "$ref": "#/$defs/guid_list"
                },
                "organisations": {
                  "description": "A list of organisation content ids permitted access to this item",
                  "$ref": "#/$defs/guid_list"
                },
                "users": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^organisations$": true,
                "^users$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "details": {
      "$ref": "#/$defs/modern_1"
    },
    "list_of_sub_organisations": {
      "description": "A list of all sub-organisations of a particular type for a parent organisation. Turn into proper links once details for organisations no longer need to be expanded.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_7"
      }
    },
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "type": "string",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$"
    }
  }
}
