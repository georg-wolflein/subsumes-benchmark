{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_11",
  "$defs": {
    "external_link": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "explanation": {
                  "type": "string"
                },
                "withdrawn_at": {
                  "format": "date-time"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^explanation$": true,
                "^withdrawn_at$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1,
      "type": "array"
    },
    "frontend_links": {
      "items": {
        "$ref": "#/$defs/modern_2"
      },
      "type": "array"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "multiple_content_types": {
      "items": {
        "$ref": "#/$defs/modern_3"
      },
      "type": "array"
    },
    "analytics_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations."
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "lead_organisations": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "DEPRECATED: A subset of organisations that should be emphasised in relation to this content item. All organisations specified here should also be part of the organisations array."
                },
                "role_appointments": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Link type automatically added by Publishing API"
                },
                "related_to_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "suggested_ordered_related_items": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "New A/B test suggestions for related items. Used for displaying related content on most pages, except for step-by-step and fatality notices. Links and their ordering are determined by the machine learning algorithms included in this A/B test."
                },
                "meets_user_needs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "The user needs this piece of content meets."
                },
                "original_primary_publishing_organisation": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "The organisation that published the original version of the page. Corresponds to the first of the 'Lead organisations' in Whitehall for the first edition, and is empty for all other publishing applications."
                },
                "ordered_related_items": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Related items, can be any page on GOV.UK. Mostly used for mainstream content to power the sidebar. Ordering of the links is determined by the editor in Content Tagger."
                },
                "child_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "policy_areas": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "A largely deprecated tag currently only used to power email alerts."
                },
                "taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Prototype-stage taxonomy label for this content item"
                },
                "secondary_to_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "finder": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Powers links from content back to finders the content is surfaced on"
                },
                "facet_values": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Prototype-stage metadata tagging values for this content item, a content item can be linked to many facet values from varying facet groups."
                },
                "policies": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "available_translations": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "part_of_step_navs": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "parent": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "The parent content item.",
                  "maxItems": 1
                },
                "children": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "topics": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Powers the /topic section of the site. These are known as specialist sectors in some legacy apps."
                },
                "mainstream_browse_pages": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Powers the /browse section of the site. These are known as sections in some legacy apps."
                },
                "ordered_related_items_overrides": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Related items, can be any page on GOV.UK. Overrides 'more like this' automatically generated links in the beta navigation."
                },
                "topic_taxonomy_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "level_one_taxons": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "primary_publishing_organisation": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "The organisation that published the page. Corresponds to the first of the 'Lead organisations' in Whitehall, and is empty for all other publishing applications.",
                  "maxItems": 1
                },
                "organisations": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "All organisations linked to this content item. This should include lead organisations."
                },
                "ministers": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Link type automatically added by Publishing API"
                },
                "document_collections": {
                  "$ref": "#/$defs/frontend_links_with_base_path",
                  "description": "Link type automatically added by Publishing API"
                },
                "facet_groups": {
                  "$ref": "#/$defs/frontend_links",
                  "description": "Prototype-stage metadata tagging tree roots for this content item. A content item my belong to many facet groups without having any specific facet_values links."
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^role_appointments$": true,
                "^children$": true,
                "^taxons$": true,
                "^topics$": true,
                "^facet_groups$": true,
                "^ordered_related_items$": true,
                "^organisations$": true,
                "^policies$": true,
                "^document_collections$": true,
                "^level_one_taxons$": true,
                "^related_to_step_navs$": true,
                "^child_taxons$": true,
                "^part_of_step_navs$": true,
                "^ministers$": true,
                "^secondary_to_step_navs$": true,
                "^ordered_related_items_overrides$": true,
                "^primary_publishing_organisation$": true,
                "^mainstream_browse_pages$": true,
                "^lead_organisations$": true,
                "^topic_taxonomy_taxons$": true,
                "^policy_areas$": true,
                "^suggested_ordered_related_items$": true,
                "^meets_user_needs$": true,
                "^parent$": true,
                "^facet_values$": true,
                "^finder$": true,
                "^original_primary_publishing_organisation$": true,
                "^available_translations$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "route": {
      "$ref": "#/$defs/modern_7"
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "body": {
                  "$ref": "#/$defs/body_html_and_govspeak"
                },
                "change_history": {
                  "$ref": "#/$defs/change_history"
                },
                "start_button_text": {
                  "$ref": "#/$defs/start_button_text"
                },
                "nodes": {
                  "description": "List of nodes consisting of questions and answers",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "type": "array"
                },
                "external_related_links": {
                  "$ref": "#/$defs/external_related_links"
                }
              },
              "required": [
                "start_button_text"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^external_related_links$": true,
                "^body$": true,
                "^nodes$": true,
                "^start_button_text$": true,
                "^change_history$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid_list": {
      "items": {
        "$ref": "#/$defs/guid"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A node represents either a question or an answer and results in a renderable page",
              "properties": {
                "body": {
                  "$ref": "#/$defs/body_html_and_govspeak"
                },
                "slug": {
                  "type": "string"
                },
                "options": {
                  "description": "Contains references to other nodes",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  },
                  "type": "array"
                },
                "kind": {
                  "enum": [
                    "question",
                    "outcome"
                  ]
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "slug",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^kind$": true,
                "^body$": true,
                "^options$": true,
                "^slug$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "_format": "date-time",
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An option represents a possible answer a user can select which links to another node",
              "properties": {
                "label": {
                  "type": "string"
                },
                "next_node": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                }
              },
              "required": [
                "label",
                "slug",
                "next_node"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^label$": true,
                "^next_node$": true,
                "^slug$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "type": "string"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "_format": "uri",
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^title$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "payload_version": {
      "description": "Counter to indicate when the payload was generated",
      "type": "integer"
    },
    "change_history": {
      "items": {
        "$ref": "#/$defs/modern_8"
      },
      "type": "array"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ],
      "type": "string"
    },
    "public_updated_at": {
      "_format": "date-time",
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              },
              "required": [
                "path",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "locale": {
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ],
      "type": "string"
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": true,
              "type": "array"
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "note": {
                  "description": "A summary of the change",
                  "type": "string"
                },
                "public_timestamp": {
                  "_format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "public_timestamp",
                "note"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^note$": true,
                "^public_timestamp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "start_button_text": {
      "description": "Custom text to be displayed on the green button that takes you to another page",
      "type": "string"
    },
    "frontend_links_with_base_path": {
      "items": {
        "$ref": "#/$defs/modern_9"
      },
      "type": "array"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links_with_base_path"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "base_path",
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ],
      "type": "string"
    },
    "govuk_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "content": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                }
              },
              "required": [
                "content_type",
                "content"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^content$": true,
                "^content_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "details": {
      "$ref": "#/$defs/modern_4"
    },
    "publishing_request_id": {
      "description": "A unique identifier used to track publishing requests to rendered content",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "withdrawn_notice": {
      "$ref": "#/$defs/modern_10"
    },
    "external_related_links": {
      "items": {
        "$ref": "#/$defs/external_link"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "routes": {
                  "$ref": "#/$defs/routes"
                },
