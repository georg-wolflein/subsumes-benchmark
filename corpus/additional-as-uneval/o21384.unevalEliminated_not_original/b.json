{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_12",
  "$defs": {
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links_with_base_path"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "base_path",
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1,
      "type": "array"
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "lead_organisations": {
                  "$ref": "#/$defs/guid_list",
                  "description": "DEPRECATED: A subset of organisations that should be emphasised in relation to this content item. All organisations specified here should also be part of the organisations array."
                },
                "suggested_ordered_related_items": {
                  "$ref": "#/$defs/guid_list",
                  "description": "New A/B test suggestions for related items. Used for displaying related content on most pages, except for step-by-step and fatality notices. Links and their ordering are determined by the machine learning algorithms included in this A/B test."
                },
                "meets_user_needs": {
                  "$ref": "#/$defs/guid_list",
                  "description": "The user needs this piece of content meets."
                },
                "original_primary_publishing_organisation": {
                  "$ref": "#/$defs/guid_list",
                  "description": "The organisation that published the original version of the page. Corresponds to the first of the 'Lead organisations' in Whitehall for the first edition, and is empty for all other publishing applications."
                },
                "ordered_related_items": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Related items, can be any page on GOV.UK. Mostly used for mainstream content to power the sidebar. Ordering of the links is determined by the editor in Content Tagger."
                },
                "government": {
                  "$ref": "#/$defs/guid_list",
                  "description": "The government associated with this document"
                },
                "policy_areas": {
                  "$ref": "#/$defs/guid_list",
                  "description": "A largely deprecated tag currently only used to power email alerts."
                },
                "taxons": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Prototype-stage taxonomy label for this content item"
                },
                "finder": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Powers links from content back to finders the content is surfaced on"
                },
                "facet_values": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Prototype-stage metadata tagging values for this content item, a content item can be linked to many facet values from varying facet groups."
                },
                "facet_groups": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Prototype-stage metadata tagging tree roots for this content item. A content item my belong to many facet groups without having any specific facet_values links."
                },
                "parent": {
                  "$ref": "#/$defs/guid_list",
                  "description": "The parent content item.",
                  "maxItems": 1
                },
                "topics": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Powers the /topic section of the site. These are known as specialist sectors in some legacy apps."
                },
                "mainstream_browse_pages": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Powers the /browse section of the site. These are known as sections in some legacy apps."
                },
                "ordered_related_items_overrides": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Related items, can be any page on GOV.UK. Overrides 'more like this' automatically generated links in the beta navigation."
                },
                "primary_publishing_organisation": {
                  "$ref": "#/$defs/guid_list",
                  "description": "The organisation that published the page. Corresponds to the first of the 'Lead organisations' in Whitehall, and is empty for all other publishing applications.",
                  "maxItems": 1
                },
                "organisations": {
                  "$ref": "#/$defs/guid_list",
                  "description": "All organisations linked to this content item. This should include lead organisations."
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^taxons$": true,
                "^topics$": true,
                "^facet_groups$": true,
                "^ordered_related_items$": true,
                "^organisations$": true,
                "^ordered_related_items_overrides$": true,
                "^lead_organisations$": true,
                "^government$": true,
                "^primary_publishing_organisation$": true,
                "^mainstream_browse_pages$": true,
                "^policy_areas$": true,
                "^suggested_ordered_related_items$": true,
                "^meets_user_needs$": true,
                "^parent$": true,
                "^facet_values$": true,
                "^finder$": true,
                "^original_primary_publishing_organisation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "frontend_links": {
      "items": {
        "$ref": "#/$defs/modern_1"
      },
      "type": "array"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "_format": "uri",
                  "type": "string"
                },
                "hoc_paper_number": {
                  "type": "string"
                },
                "attachment_type": {
                  "enum": [
                    "file"
                  ],
                  "type": "string"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "preview_url": {
                  "_format": "uri",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "number_of_pages": {
                  "type": "integer"
                },
                "command_paper_number": {
                  "type": "string"
                },
                "accessible": {
                  "type": "boolean"
                },
                "file_size": {
                  "type": "integer"
                },
                "content_type": {
                  "type": "string"
                },
                "unnumbered_command_paper": {
                  "type": "boolean"
                },
                "unnumbered_hoc_paper": {
                  "type": "boolean"
                },
                "unique_reference": {
                  "type": "string"
                },
                "parliamentary_session": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "isbn": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "alternative_format_contact_email": {
                  "type": "string"
                }
              },
              "required": [
                "attachment_type",
                "content_type",
                "id",
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^command_paper_number$": true,
                "^preview_url$": true,
                "^url$": true,
                "^id$": true,
                "^hoc_paper_number$": true,
                "^title$": true,
                "^accessible$": true,
                "^parliamentary_session$": true,
                "^isbn$": true,
                "^file_size$": true,
                "^locale$": true,
                "^unique_reference$": true,
                "^attachment_type$": true,
                "^unnumbered_hoc_paper$": true,
                "^alternative_format_contact_email$": true,
                "^content_type$": true,
                "^filename$": true,
                "^number_of_pages$": true,
                "^unnumbered_command_paper$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_public_at": {
      "_format": "date-time",
      "description": "DEPRECATED. The date the content was first published. Used in details. Deprecated in favour of top level `first_published_at`.",
      "type": "string"
    },
    "analytics_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations."
    },
    "route": {
      "$ref": "#/$defs/modern_6"
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "_format": "uri",
                  "type": "string"
                },
                "hoc_paper_number": {
                  "type": "string"
                },
                "attachment_type": {
                  "enum": [
                    "external"
                  ],
                  "type": "string"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "id": {
                  "type": "string"
                },
                "isbn": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "command_paper_number": {
                  "type": "string"
                },
                "unnumbered_command_paper": {
                  "type": "boolean"
                },
                "unnumbered_hoc_paper": {
                  "type": "boolean"
                },
                "unique_reference": {
                  "type": "string"
                },
                "parliamentary_session": {
                  "type": "string"
                }
              },
              "required": [
                "attachment_type",
                "id",
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^parliamentary_session$": true,
                "^command_paper_number$": true,
                "^isbn$": true,
                "^url$": true,
                "^id$": true,
                "^hoc_paper_number$": true,
                "^title$": true,
                "^unnumbered_command_paper$": true,
                "^locale$": true,
                "^unique_reference$": true,
                "^attachment_type$": true,
                "^unnumbered_hoc_paper$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid_list": {
      "items": {
        "$ref": "#/$defs/guid"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "body": {
                  "$ref": "#/$defs/body"
                },
                "tags": {
                  "$ref": "#/$defs/tags"
                },
                "change_history": {
                  "$ref": "#/$defs/change_history"
                },
                "first_public_at": {
                  "$ref": "#/$defs/first_public_at"
                },
                "attachments": {
                  "description": "An ordered list of asset links",
                  "items": {
                    "$ref": "#/$defs/publication_attachment_asset"
                  },
                  "type": "array"
                },
                "emphasised_organisations": {
                  "$ref": "#/$defs/emphasised_organisations"
                },
                "political": {
                  "$ref": "#/$defs/political"
                },
                "government": {
                  "$ref": "#/$defs/government"
                }
              },
              "required": [
                "body",
                "political"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^body$": true,
                "^emphasised_organisations$": true,
                "^political$": true,
                "^government$": true,
                "^change_history$": true,
                "^attachments$": true,
                "^first_public_at$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "_format": "date-time",
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              },
              "required": [
                "path",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "body": {
      "description": "The main content provided as HTML rendered from govspeak",
      "type": "string"
    },
    "guid": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "type": "string"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "public_updated_at": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/public_updated_at"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "api_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "title": {
                  "type": "string"
                },
                "content_id": {
                  "$ref": "#/$defs/guid"
                },
                "document_type": {
                  "type": "string"
                },
                "schema_name": {
                  "type": "string"
                },
                "links": {
                  "patternProperties": {
                    "^[a-z_]+$": {
                      "$ref": "#/$defs/frontend_links"
                    }
                  },
                  "type": "object"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "api_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: api_path should be used instead of api_url. This is due to values of api_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                },
                "web_url": {
                  "_format": "uri",
                  "description": "DEPRECATED: base_path should be used instead of web_url. This is due to values of web_url being tied to an environment which can cause problems when data is synced between environments. In time this field will be removed by the Publishing Platform team.",
                  "type": "string"
                }
              },
              "required": [
                "content_id",
                "locale",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^api_url$": true,
                "^web_url$": true,
                "^base_path$": true,
                "^api_path$": true,
                "^locale$": true,
                "^analytics_identifier$": true,
                "^links$": true,
                "^content_id$": true,
                "^document_type$": true,
                "^public_updated_at$": true,
                "^title$": true,
                "^schema_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "payload_version": {
      "description": "Counter to indicate when the payload was generated",
      "type": "integer"
    },
    "tags": {
      "$ref": "#/$defs/modern_7"
    },
    "change_history": {
      "items": {
        "$ref": "#/$defs/modern_8"
      },
      "type": "array"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ],
      "type": "string"
    },
    "public_updated_at": {
      "_format": "date-time",
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Field used by email-alert-api to trigger email alerts for subscriptions to topics (gov.uk/topic) and policies (gov.uk/policies).",
              "properties": {
                "topics": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "browse_pages": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "additional_topics": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "primary_topic": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "policies": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^additional_topics$": true,
                "^topics$": true,
                "^primary_topic$": true,
                "^browse_pages$": true,
                "^policies$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "locale": {
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ],
      "type": "string"
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "routes": {
                  "$ref": "#/$defs/routes"
                },
                "user_journey_document_supertype": {
                  "description": "Document type grouping powering analytics of user journeys",
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "search_user_need_document_supertype": {
                  "description": "Document supertype grouping core and government documents",
                  "type": "string"
                },
                "need_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "content_purpose_document_supertype": {
                  "description": "DEPRECATED. Use `content_purpose_subgroup`.",
                  "type": "string"
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_13"
                },
                "document_type": {
                  "enum": [
                    "statistical_data_set"
                  ],
                  "type": "string"
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "content_purpose_subgroup": {
                  "description": "Document subgroup grouping documents by purpose. Narrows down the purpose defined in content_purpose_supergroup.",
                  "type": "string"
                },
                "expanded_links": {
                  "$ref": "#/$defs/modern_14"
                },
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "user_need_document_supertype": {
                  "description": "DEPRECATED. Use `content_purpose_document_supertype`.",
                  "type": "string"
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ],
                  "type": "string"
                },
                "payload_version": {
                  "$ref": "#/$defs/payload_version"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "email_document_supertype": {
                  "description": "Document supertype grouping intended to power the Whitehall finders and email subscriptions",
                  "type": "string"
                },
                "schema_name": {
                  "enum": [
                    "statistical_data_set"
                  ],
                  "type": "string"
                },
                "links": {
                  "$ref": "#/$defs/modern_15"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "govuk_request_id": {
                  "$ref": "#/$defs/govuk_request_id"
                },
                "navigation_document_supertype": {
                  "description": "Document type grouping powering the new taxonomy-based navigation pages",
                  "type": "string"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "publishing_request_id": {
                  "$ref": "#/$defs/publishing_request_id"
                },
