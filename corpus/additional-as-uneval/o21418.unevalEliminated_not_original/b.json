{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_9",
  "$defs": {
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": true,
              "type": "array"
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1,
      "type": "array"
    },
    "description": {
      "type": "string"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ],
      "type": "string"
    },
    "locale": {
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ],
      "type": "string"
    },
    "analytics_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations."
    },
    "publishing_request_id": {
      "description": "A unique identifier used to track publishing requests to rendered content",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "route": {
      "$ref": "#/$defs/modern_4"
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "guid_list": {
      "items": {
        "$ref": "#/$defs/guid"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "auth_bypass_ids": {
                  "$ref": "#/$defs/guid_list",
                  "description": "Deprecated: auth_bypass_ids should be sent as a separate field"
                },
                "organisations": {
                  "$ref": "#/$defs/guid_list",
                  "description": "A list of organisation content ids permitted access to this item"
                },
                "users": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^organisations$": true,
                "^users$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "first_published_at": {
      "_format": "date-time",
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "access_limited": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "content": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                }
              },
              "required": [
                "content_type",
                "content"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^content$": true,
                "^content_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "guid": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "type": "string"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "synonyms": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "slug",
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^slug$": true,
                "^synonyms$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "email_signup_link": {
      "_format": "uri",
      "description": "Path to email signup form. TODO: Check if can be switched to use links instead",
      "type": "string"
    },
    "public_updated_at": {
      "_format": "date-time",
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "_format": "uri",
                  "type": "string"
                },
                "credit": {
                  "type": "string"
                },
                "caption": {
                  "type": "string"
                },
                "alt_text": {
                  "type": "string"
                },
                "content_type": {
                  "type": "string"
                }
              },
              "required": [
                "content_type",
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^credit$": true,
                "^caption$": true,
                "^url$": true,
                "^alt_text$": true,
                "^content_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "country": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "_format": "uri",
                  "type": "string"
                },
                "attachment_type": {
                  "enum": [
                    "file"
                  ],
                  "type": "string"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "preview_url": {
                  "_format": "uri",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "filename": {
                  "type": "string"
                },
                "number_of_pages": {
                  "type": "integer"
                },
                "accessible": {
                  "type": "boolean"
                },
                "file_size": {
                  "type": "integer"
                },
                "content_type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "alternative_format_contact_email": {
                  "type": "string"
                }
              },
              "required": [
                "attachment_type",
                "content_type",
                "id",
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^accessible$": true,
                "^preview_url$": true,
                "^file_size$": true,
                "^locale$": true,
                "^url$": true,
                "^id$": true,
                "^title$": true,
                "^number_of_pages$": true,
                "^attachment_type$": true,
                "^alternative_format_contact_email$": true,
                "^content_type$": true,
                "^filename$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "multiple_content_types": {
      "items": {
        "$ref": "#/$defs/modern_6"
      },
      "type": "array"
    },
    "image_asset": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "body": {
                  "$ref": "#/$defs/body_html_and_govspeak"
                },
                "slug": {
                  "_format": "uri",
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "slug",
                "body"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^body$": true,
                "^slug$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "file_attachment_asset": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "base_path": {
                  "$ref": "#/$defs/absolute_path"
                },
                "routes": {
                  "$ref": "#/$defs/routes"
                },
                "previous_version": {
                  "type": "string"
                },
                "public_updated_at": {
                  "$ref": "#/$defs/public_updated_at"
                },
                "change_note": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "analytics_identifier": {
                  "$ref": "#/$defs/analytics_identifier"
                },
                "rendering_app": {
                  "$ref": "#/$defs/rendering_app"
                },
                "details": {
                  "$ref": "#/$defs/details"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "redirects": {
                  "$ref": "#/$defs/modern_10"
                },
                "update_type": {
                  "$ref": "#/$defs/update_type"
                },
                "document_type": {
                  "enum": [
                    "travel_advice"
                  ],
                  "type": "string"
                },
                "publishing_app": {
                  "$ref": "#/$defs/publishing_app_name"
                },
                "first_published_at": {
                  "$ref": "#/$defs/first_published_at"
                },
                "access_limited": {
                  "$ref": "#/$defs/access_limited"
                },
                "description": {
                  "$ref": "#/$defs/description_optional"
                },
                "phase": {
                  "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
                  "enum": [
                    "alpha",
                    "beta",
                    "live"
                  ],
                  "type": "string"
                },
                "need_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "auth_bypass_ids": {
                  "$ref": "#/$defs/guid_list",
                  "description": "A list of ids that will allow access to this item for non-authenticated users"
                },
                "locale": {
                  "$ref": "#/$defs/locale"
                },
                "bulk_publishing": {
                  "type": "boolean"
                },
                "last_edited_at": {
                  "_format": "date-time",
                  "description": "Last time when the content received a major or minor update.",
                  "type": "string"
                },
                "schema_name": {
                  "enum": [
                    "travel_advice"
                  ],
                  "type": "string"
                },
                "links": {
                  "$ref": "#/$defs/modern_11"
                }
              },
              "required": [
                "base_path",
                "details",
                "document_type",
                "publishing_app",
                "rendering_app",
                "routes",
                "schema_name",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^auth_bypass_ids$": true,
                "^rendering_app$": true,
                "^publishing_app$": true,
                "^locale$": true,
                "^details$": true,
                "^previous_version$": true,
                "^need_ids$": true,
                "^links$": true,
                "^document_type$": true,
                "^phase$": true,
                "^first_published_at$": true,
                "^routes$": true,
                "^update_type$": true,
                "^schema_name$": true,
                "^base_path$": true,
                "^access_limited$": true,
                "^redirects$": true,
                "^description$": true,
                "^last_edited_at$": true,
                "^analytics_identifier$": true,
                "^public_updated_at$": true,
                "^change_note$": true,
                "^title$": true,
                "^bulk_publishing$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ],
      "type": "string"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "document": {
                  "$ref": "#/$defs/file_attachment_asset"
                },
                "country": {
                  "$ref": "#/$defs/country"
                },
                "change_description": {
                  "type": "string"
                },
                "publishing_request_id": {
                  "$ref": "#/$defs/publishing_request_id"
                },
                "updated_at": {
                  "_format": "date-time",
                  "type": "string"
                },
                "summary": {
                  "$ref": "#/$defs/multiple_content_types"
                },
                "email_signup_link": {
                  "$ref": "#/$defs/email_signup_link"
                },
                "image": {
                  "$ref": "#/$defs/image_asset"
                },
                "reviewed_at": {
                  "_format": "date-time",
                  "type": "string"
                },
                "alert_status": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "max_cache_time": {
                  "$ref": "#/$defs/max_cache_time"
                },
                "parts": {
                  "$ref": "#/$defs/parts"
                }
              },
              "required": [
                "summary",
                "country",
                "updated_at",
                "reviewed_at",
                "change_description",
                "alert_status",
                "email_signup_link",
                "parts"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^alert_status$": true,
                "^updated_at$": true,
                "^image$": true,
                "^email_signup_link$": true,
                "^summary$": true,
                "^max_cache_time$": true,
                "^parts$": true,
                "^change_description$": true,
                "^country$": true,
                "^document$": true,
                "^publishing_request_id$": true,
                "^reviewed_at$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "details": {
      "$ref": "#/$defs/modern_3"
    },
    "title": {
      "type": "string"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "policy_areas": {
                  "$ref": "#/$defs/guid_list",
                  "description": "A largely deprecated tag currently only used to power email alerts."
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^policy_areas$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$",
      "type": "string"
    },
    "body_html_and_govspeak": {
      "anyOf": [
        {
          "$ref": "#/$defs/multiple_content_types"
        }
      ],
      "description": "The main content provided as HTML with the govspeak markdown it's rendered from"
    },
    "max_cache_time": {
      "description": "The maximum length of time the content should be cached, in seconds",
      "type": "integer"
    },
    "parts": {
      "items": {
        "$ref": "#/$defs/modern_8"
      },
      "type": "array"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "path": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "prefix",
                    "exact"
                  ]
                }
              },
              "required": [
                "path",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^path$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
