{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "description": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "jobId": {
                  "type": "integer"
                },
                "message": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string"
                },
                "to": {
                  "pattern": "^\\+44[\\d]{10}$",
                  "type": "string"
                }
              },
              "required": [
                "to",
                "message"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^jobId$": true,
                "^message$": true,
                "^to$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
