{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21470.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "_id": {
                    "description": "unique url-friendly base64 encoded, utf8 endoded concatenation identifier",
                    "type": "string"
                  },
                  "consulate": {
                    "description": "The name or identity of the consulate providing the appointment",
                    "type": "string"
                  },
                  "service": {
                    "description": "The name of the service provided e.g. appointment",
                    "type": "string"
                  },
                  "period": {
                    "description": "The period covered by each data point from the _timestamp",
                    "enum": [
                      "hour",
                      "day",
                      "week",
                      "month",
                      "quarter"
                    ]
                  },
                  "available_hours": {
                    "description": "The number of hours available - decimal(i.e.8.00 - not HH:MM)",
                    "minimum": 0.0,
                    "type": "number"
                  },
                  "_timestamp": {
                    "_format": "date-time",
                    "description": "ISO8601 combined date and time in UTC e.g. '2014-12-01T00:00:00+00:00'",
                    "type": "string"
                  },
                  "used_hours": {
                    "description": "The number of hours used - decimal(i.e.8.00 - not HH:MM)",
                    "minimum": 0.0,
                    "type": "number"
                  }
                },
                "required": [
                  "_id",
                  "_timestamp",
                  "period",
                  "consulate",
                  "service",
                  "available_hours",
                  "used_hours"
                ],
                "title": "consulate-service-utilisation",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^_timestamp$": true,
                  "^period$": true,
                  "^_id$": true,
                  "^service$": true,
                  "^consulate$": true,
                  "^used_hours$": true,
                  "^available_hours$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
