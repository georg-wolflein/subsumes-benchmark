{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "chunk-size": {
                  "type": "number"
                },
                "empty-data-set": {
                  "type": "boolean"
                },
                "filtersets": {
                  "items": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "type": "array"
                },
                "plugins": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "title": "Google Analytics Content Collector Options",
              "type": "object"
            },
            {
              "patternProperties": {
                "^chunk-size$": true,
                "^empty-data-set$": true,
                "^filtersets$": true,
                "^plugins$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
