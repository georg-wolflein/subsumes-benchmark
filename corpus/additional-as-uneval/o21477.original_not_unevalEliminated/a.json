{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "filters": {
                  "type": "string"
                },
                "ids": {
                  "pattern": "^[a-z0-9:]+$",
                  "type": "string"
                },
                "metrics": {
                  "type": "string"
                }
              },
              "required": [
                "metrics"
              ],
              "title": "Google Analytics Realtime Collector Query",
              "type": "object"
            },
            {
              "patternProperties": {
                "^filters$": true,
                "^ids$": true,
                "^metrics$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
