{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "mappings": {
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "nb_conversions": {
                      "type": "string"
                    },
                    "nb_visits": {
                      "type": "string"
                    },
                    "nb_visits_converted": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "idMapping": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "empty-data-set": {
                  "type": "boolean"
                },
                "filters": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "additionalFields": {
                  "event_detail": {
                    "type": "string"
                  },
                  "event_type": {
                    "type": "string"
                  },
                  "journey_stage": {
                    "type": "string"
                  },
                  "service_identifier": {
                    "type": "string"
                  }
                },
                "chunk-size": {
                  "type": "number"
                }
              },
              "title": "Piwik Core Collector Options",
              "type": "object"
            },
            {
              "patternProperties": {
                "^chunk-size$": true,
                "^mappings$": true,
                "^idMapping$": true,
                "^empty-data-set$": true,
                "^filters$": true,
                "^additionalFields$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
