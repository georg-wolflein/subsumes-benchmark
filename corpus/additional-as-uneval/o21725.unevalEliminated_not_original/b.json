{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "json-schema-umbrella/analyse/in",
              "type": "object",
              "properties": {
                "schema": {
                  "type": "object",
                  "description": "schema to analyse",
                  "default": {}
                },
                "options": {
                  "type": "object",
                  "description": "analyse switch options",
                  "default": {}
                }
              }
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^options$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
