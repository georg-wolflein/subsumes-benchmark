{
  "$id": "http://select-object-path/ref.alias.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "select alias",
  "default": {
    "*": ".*",
    "all": "*",
    "none": "-*"
  },
  "patternProperties": {
    "\\w": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pattern": {
          "type": "string",
          "description": "pattern"
        },
        "flag": {
          "type": "string",
          "enum": [
            "-",
            "+"
          ]
        }
      },
      "required": [
        "pattern",
        "flag"
      ]
    }
  }
}
