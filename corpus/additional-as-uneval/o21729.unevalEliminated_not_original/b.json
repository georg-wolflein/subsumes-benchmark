{
  "$id": "http://select-object-path/ref.alias.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "select alias",
  "default": {
    "*": ".*",
    "all": "*",
    "none": "-*"
  },
  "patternProperties": {
    "\\w": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "pattern": {
                  "type": "string",
                  "description": "pattern"
                },
                "flag": {
                  "type": "string",
                  "enum": [
                    "-",
                    "+"
                  ]
                }
              },
              "required": [
                "pattern",
                "flag"
              ]
            },
            {
              "patternProperties": {
                "^pattern$": true,
                "^flag$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
