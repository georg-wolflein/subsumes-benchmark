{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "maxItems",
    "minItems",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21735.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21735.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "donate": {
                    "description": "donate urls",
                    "items": {
                      "enum": [
                        "https://pledgie.com/campaigns/28037",
                        "https://gratipay.com/aminassian"
                      ]
                    },
                    "maxItems": 2,
                    "minItems": 2,
                    "type": "array",
                    "_uniqueItems": true
                  },
                  "licence": {
                    "description": "licence code",
                    "type": "string"
                  },
                  "patterns": {
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "licence",
                  "donate",
                  "patterns"
                ],
                "title": "select-object-path/selectToPattern/out",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^donate$": true,
                  "^licence$": true,
                  "^patterns$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "flag": {
                    "enum": [
                      "+",
                      "-"
                    ],
                    "type": "string"
                  },
                  "pattern": {
                    "type": "string"
                  }
                },
                "required": [
                  "pattern",
                  "flag"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^flag$": true,
                  "^pattern$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "donate": {
        "description": "donate urls",
        "items": {
          "enum": [
            "https://pledgie.com/campaigns/28037",
            "https://gratipay.com/aminassian"
          ]
        },
        "maxItems": 2,
        "minItems": 2,
        "type": "array",
        "_uniqueItems": true
      },
      "licence": {
        "description": "licence code",
        "type": "string"
      },
      "patterns": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "flag": {
              "enum": [
                "+",
                "-"
              ],
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "pattern",
            "flag"
          ],
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "licence",
      "donate",
      "patterns"
    ],
    "title": "select-object-path/selectToPattern/out",
    "type": "object"
  }
}
