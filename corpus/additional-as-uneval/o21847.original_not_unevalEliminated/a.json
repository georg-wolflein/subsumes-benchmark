{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "dictionary": {
      "$ref": "#/$defs/modern_1"
    },
    "ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "lastTagId": {
      "minimum": -1.0,
      "type": "integer"
    }
  },
  "required": [
    "lastTagId",
    "ids",
    "dictionary"
  ],
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "^\\d*$": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^\\d*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
