{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "dictionary": {
      "additionalProperties": false,
      "patternProperties": {
        "^\\d*$": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "lastTagId": {
      "minimum": -1,
      "type": "integer"
    }
  },
  "required": [
    "lastTagId",
    "ids",
    "dictionary"
  ],
  "type": "object"
}
