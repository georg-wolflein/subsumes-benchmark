{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "LogGroupNamePrefix"
              ],
              "properties": {
                "LogGroupNamePrefix": {
                  "type": "string",
                  "pattern": ".+"
                },
                "RetentionInDays": {
                  "type": "integer",
                  "enum": [
                    1,
                    3,
                    5,
                    7,
                    14,
                    30,
                    60,
                    90,
                    120,
                    150,
                    180,
                    365,
                    400,
                    545,
                    731,
                    1827,
                    3653
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^LogGroupNamePrefix$": true,
                "^RetentionInDays$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
