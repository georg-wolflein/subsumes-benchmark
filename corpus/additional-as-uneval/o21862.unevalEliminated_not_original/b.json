{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "AutomatedSnapshotStartHour": {
                  "type": "string",
                  "pattern": "^\\d$"
                }
              }
            },
            {
              "patternProperties": {
                "^AutomatedSnapshotStartHour$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "DomainName"
              ],
              "properties": {
                "AccessPolicies": {
                  "type": "string",
                  "pattern": ".+"
                },
                "ElasticsearchClusterConfig": {
                  "$ref": "#/$defs/modern_2"
                },
                "AdvancedOptions": {
                  "$ref": "#/$defs/modern_3"
                },
                "DomainName": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9\\-]+$"
                },
                "EBSOptions": {
                  "$ref": "#/$defs/modern_4"
                },
                "SnapshotOptions": {
                  "$ref": "#/$defs/modern_5"
                }
              }
            },
            {
              "patternProperties": {
                "^EBSOptions$": true,
                "^AccessPolicies$": true,
                "^SnapshotOptions$": true,
                "^DomainName$": true,
                "^ElasticsearchClusterConfig$": true,
                "^AdvancedOptions$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "DedicatedMasterType": {
                  "$ref": "#/$defs/ElasticseachNodeType"
                },
                "DedicatedMasterEnabled": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                },
                "DedicatedMasterCount": {
                  "type": "string",
                  "pattern": "^\\d$"
                },
                "InstanceCount": {
                  "type": "string",
                  "pattern": "^\\d$"
                },
                "InstanceType": {
                  "$ref": "#/$defs/ElasticseachNodeType"
                },
                "ZoneAwarenessEnabled": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^InstanceType$": true,
                "^DedicatedMasterCount$": true,
                "^InstanceCount$": true,
                "^ZoneAwarenessEnabled$": true,
                "^DedicatedMasterType$": true,
                "^DedicatedMasterEnabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                ".+": {
                  "type": "string",
                  "pattern": ".+"
                }
              }
            },
            {
              "patternProperties": {
                ".+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "ElasticseachNodeType": {
      "type": "string",
      "enum": [
        "m3.medium.elasticsearch",
        "m3.large.elasticsearch",
        "m3.xlarge.elasticsearch",
        "m3.2xlarge.elasticsearch",
        "t2.micro.elasticsearch",
        "t2.small.elasticsearch",
        "t2.medium.elasticsearch",
        "r3.large.elasticsearch",
        "r3.xlarge.elasticsearch",
        "r3.2xlarge.elasticsearch",
        "r3.4xlarge.elasticsearch",
        "r3.8xlarge.elasticsearch",
        "i2.xlarge.elasticsearch",
        "i2.2xlarge.elasticsearch"
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "EBSEnabled": {
                  "type": "string",
                  "enum": [
                    "true",
                    "false"
                  ]
                },
                "Iops": {
                  "type": "string",
                  "pattern": "^\\d+$"
                },
                "VolumeSize": {
                  "type": "string",
                  "pattern": "^\\d+$"
                },
                "VolumeType": {
                  "type": "string",
                  "enum": [
                    "standard",
                    "gp2",
                    "io1"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^EBSEnabled$": true,
                "^Iops$": true,
                "^VolumeSize$": true,
                "^VolumeType$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
