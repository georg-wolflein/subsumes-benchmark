{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21869.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21869.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Badge List",
                "description": "A list of available Open Badges",
                "type": "object",
                "required": [
                  "badgelist"
                ],
                "properties": {
                  "badgelist": {
                    "description": "Container for a set of badge elements.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^badgelist$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Badge",
                "description": "Container for the data needed to describe a badge assertion to extract.",
                "type": "object",
                "required": [
                  "loc"
                ],
                "properties": {
                  "loc": {
                    "description": "The location URI of a badge assertion.",
                    "type": "string",
                    "format": "uri"
                  },
                  "priority": {
                    "description": "The priority of a particular badge relative to other badges on the same site.",
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 1.0
                  }
                }
              },
              {
                "patternProperties": {
                  "^loc$": true,
                  "^priority$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Badge List",
    "description": "A list of available Open Badges",
    "type": "object",
    "required": [
      "badgelist"
    ],
    "additionalProperties": false,
    "properties": {
      "badgelist": {
        "description": "Container for a set of badge elements.",
        "type": "array",
        "items": {
          "title": "Badge",
          "description": "Container for the data needed to describe a badge assertion to extract.",
          "type": "object",
          "required": [
            "loc"
          ],
          "additionalProperties": false,
          "properties": {
            "loc": {
              "description": "The location URI of a badge assertion.",
              "type": "string",
              "format": "uri"
            },
            "priority": {
              "description": "The priority of a particular badge relative to other badges on the same site.",
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        }
      }
    }
  }
}
