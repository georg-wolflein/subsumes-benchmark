{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Prerender Target",
              "type": "object",
              "properties": {
                "routes": {
                  "type": "array",
                  "description": "The routes to render.",
                  "items": {
                    "minItems": 1,
                    "type": "string",
                    "_uniqueItems": true
                  },
                  "default": []
                },
                "routesFile": {
                  "type": "string",
                  "description": "The path to a file containing routes separated by newlines."
                },
                "guessRoutes": {
                  "type": "boolean",
                  "description": "Whether or not the builder should extract routes and guess which paths to render.",
                  "default": true
                },
                "numProcesses": {
                  "type": "number",
                  "description": "The number of cpus to use. Defaults to all but one.",
                  "minimum": 1.0
                },
                "serverTarget": {
                  "type": "string",
                  "description": "Server target to use for prerendering the app.",
                  "pattern": "^[^:\\s]+:[^:\\s]+(:[^\\s]+)?$"
                },
                "browserTarget": {
                  "type": "string",
                  "description": "Target to build.",
                  "pattern": "^[^:\\s]+:[^:\\s]+(:[^\\s]+)?$"
                }
              },
              "required": [
                "browserTarget",
                "serverTarget"
              ],
              "anyOf": [
                {
                  "required": [
                    "routes"
                  ]
                },
                {
                  "required": [
                    "routesFile"
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^browserTarget$": true,
                "^routesFile$": true,
                "^guessRoutes$": true,
                "^serverTarget$": true,
                "^routes$": true,
                "^numProcesses$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
