{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "server": {
                  "$ref": "#/$defs/modern_2"
                },
                "database": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "url"
                  ]
                }
              },
              "required": [
                "server"
              ]
            },
            {
              "patternProperties": {
                "^server$": true,
                "^database$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                }
              },
              "required": [
                "host",
                "port"
              ]
            },
            {
              "patternProperties": {
                "^host$": true,
                "^port$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
