{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A represtentation of a route generated by or for display in Scope.",
              "properties": {
                "created": {
                  "$ref": "#/$defs/date"
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "geometry": {
                  "$ref": "#/$defs/geometry"
                },
                "name": {
                  "$ref": "#/$defs/name"
                }
              },
              "required": [
                "created",
                "description",
                "name",
                "geometry"
              ],
              "title": "Route",
              "type": "object"
            },
            {
              "patternProperties": {
                "^created$": true,
                "^description$": true,
                "^geometry$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "name": {
      "description": "The display name of the data element",
      "title": "Content name",
      "type": "string"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "geometry": {
                  "$ref": "#/$defs/modern_11"
                },
                "name": {
                  "description": "The name of the layer.  Required for display purposes.",
                  "title": "Layer name",
                  "type": "string"
                },
                "resources": {
                  "$ref": "#/$defs/modern_12"
                },
                "style": {
                  "$ref": "#/$defs/modern_13"
                }
              },
              "required": [
                "geometry",
                "name",
                "style"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^geometry$": true,
                "^name$": true,
                "^resources$": true,
                "^style$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "minProperties": 4,
              "properties": {
                "image": {
                  "$ref": "#/$defs/modern_2"
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "sensor": {
                  "$ref": "#/$defs/modern_3"
                },
                "date": {
                  "$ref": "#/$defs/date"
                },
                "video": {
                  "$ref": "#/$defs/modern_4"
                },
                "route": {
                  "$ref": "#/$defs/modern_5"
                },
                "asset": {
                  "$ref": "#/$defs/modern_6"
                },
                "observation": {
                  "$ref": "#/$defs/modern_14"
                },
                "area": {
                  "$ref": "#/$defs/modern_15"
                },
                "generator": {
                  "$ref": "#/$defs/modern_17"
                },
                "manifest_version": {
                  "description": "The version of the manifest schema used to validate the manifest contents.",
                  "title": "Manifest version",
                  "type": "number"
                },
                "point": {
                  "$ref": "#/$defs/modern_18"
                }
              },
              "required": [
                "date",
                "description",
                "manifest_version",
                "generator"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^route$": true,
                "^image$": true,
                "^date$": true,
                "^area$": true,
                "^observation$": true,
                "^manifest_version$": true,
                "^point$": true,
                "^video$": true,
                "^asset$": true,
                "^generator$": true,
                "^description$": true,
                "^sensor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "description": "The detailed description of the data element",
      "title": "Description",
      "type": "string"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "minProperties": 1,
              "patternProperties": {
                "group": {
                  "$ref": "#/$defs/modern_8"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "group": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "imagegeoref": {
      "description": "GeoReference in structured format",
      "properties": {
        "pixel_height": {
          "type": "number"
        },
        "rotation_x": {
          "type": "number"
        },
        "pixel_units": {
          "type": "string"
        },
        "pixel_width": {
          "type": "number"
        },
        "rotation_y": {
          "type": "number"
        },
        "upperleft": {
          "$ref": "#/$defs/georeference"
        }
      },
      "required": [
        "pixel_width",
        "pixel_height",
        "pixel_units",
        "rotation_x",
        "rotation_y",
        "upperleft"
      ],
      "title": "GeoReference of an image",
      "type": "object"
    },
    "imagegeoref_wf": {
      "description": "GeoReference in worldfile format",
      "properties": {
        "data": {
          "$ref": "#/$defs/dataset"
        },
        "type": {
          "description": "The type of the bounds data.  E.g. 'text/x-worldfile'.",
          "enum": [
            "text/x-worldfile"
          ],
          "title": "Bounds type",
          "type": "string"
        }
      },
      "required": [
        "data",
        "type"
      ],
      "title": "GeoReference in worldfile format",
      "type": "object"
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The resources needed for styling the layer",
              "properties": {
                "data": {
                  "$ref": "#/$defs/dataset"
                }
              },
              "required": [
                "data"
              ],
              "title": "Layer resources",
              "type": "object"
            },
            {
              "patternProperties": {
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "layers": {
                  "description": "This is an array of layers that are included in the group.",
                  "items": {
                    "type": "string"
                  },
                  "minitems": "1",
                  "title": "Group layers",
                  "type": "array"
                },
                "name": {
                  "description": "The name of the group.  Required for display purposes.",
                  "title": "Group name",
                  "type": "string"
                }
              },
              "required": [
                "layers",
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^layers$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "date": {
      "_format": "date-time",
      "description": "ISO 8601 date.",
      "title": "Datestamp",
      "type": "string"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The data layers included in the .apt archive.",
              "minProperties": 1,
              "patternProperties": {
                "layer": {
                  "$ref": "#/$defs/modern_10"
                }
              },
              "title": "Data layers",
              "type": "object"
            },
            {
              "patternProperties": {
                "layer": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "data": {
                  "$ref": "#/$defs/dataset"
                },
                "type": {
                  "enum": [
                    "text/x-shapefile"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "data",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^data$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "bounds_nw": {
                  "$ref": "#/$defs/georeference"
                },
                "bounds_se": {
                  "$ref": "#/$defs/georeference"
                },
                "date": {
                  "$ref": "#/$defs/date"
                }
              },
              "required": [
                "date",
                "bounds_nw",
                "bounds_se"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^bounds_nw$": true,
                "^bounds_se$": true,
                "^date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "geometry": {
      "description": "The geometry of the data element",
      "properties": {
        "data": {
          "$ref": "#/$defs/dataset"
        },
        "type": {
          "description": "The pseudo-mime type of the geometry.  E.g. 'text/x-ewkt'.  The type controls the interpretation of the 'data' elements.",
          "enum": [
            "text/x-ewkt"
          ],
          "title": "Geometry type",
          "type": "string"
        }
      },
      "required": [
        "data",
        "type"
      ],
      "title": "Data geometry",
      "type": "object"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "georeference": {
                  "$ref": "#/$defs/georeference"
                },
                "name": {
                  "$ref": "#/$defs/name"
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "data": {
                  "$ref": "#/$defs/dataset"
                },
                "created": {
                  "$ref": "#/$defs/date"
                }
              },
              "required": [
                "created",
                "description",
                "name",
                "data"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^created$": true,
                "^data$": true,
                "^georeference$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "georeference": {
      "description": "A georeference object that locates the element in space.",
      "properties": {
        "elevation": {
          "description": "The elevation of the object.",
          "title": "Georeference elevation",
          "type": "number"
        },
        "latitude": {
          "description": "The latitude of the object.",
          "title": "Georeference latitude",
          "type": "number"
        },
        "longitude": {
          "description": "The longitude of the object.",
          "title": "Georeference longitude",
          "type": "number"
        }
      },
      "required": [
        "latitude",
        "longitude"
      ],
      "title": "Georeference",
      "type": "object"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "groups": {
                  "$ref": "#/$defs/modern_7"
                },
                "layers": {
                  "$ref": "#/$defs/modern_9"
                }
              },
              "required": [
                "groups",
                "layers"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^groups$": true,
                "^layers$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "max_thickness": {
                  "type": "number"
                },
                "min_thickness": {
                  "type": "number"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^max_thickness$": true,
                "^min_thickness$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "$ref": "#/$defs/name"
                },
                "oil_spill": {
                  "$ref": "#/$defs/modern_16"
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "geometry": {
                  "$ref": "#/$defs/geometry"
                },
                "created": {
                  "$ref": "#/$defs/date"
                }
              },
              "required": [
                "created",
                "description",
                "name",
                "geometry"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^geometry$": true,
                "^created$": true,
                "^oil_spill$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Contains information about the generating program / organization.",
              "properties": {
                "creator": {
                  "type": "string"
                },
                "program": {
                  "type": "string"
                }
              },
              "required": [
                "creator",
                "program"
              ],
              "title": "Archive generator",
              "type": "object"
            },
            {
              "patternProperties": {
                "^creator$": true,
                "^program$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "georeference": {
                  "$ref": "#/$defs/georeference"
                },
                "name": {
                  "$ref": "#/$defs/name"
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "data": {
                  "$ref": "#/$defs/dataset"
                },
                "bounds": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/imagegeoref_wf"
                    },
                    {
                      "$ref": "#/$defs/imagegeoref"
                    }
                  ],
                  "type": "object"
                },
                "created": {
                  "$ref": "#/$defs/date"
                }
              },
              "required": [
                "created",
                "description",
                "name",
                "data"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^bounds$": true,
                "^created$": true,
                "^data$": true,
                "^georeference$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_18": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A representation of a point-of-interest",
              "properties": {
                "name": {
                  "$ref": "#/$defs/name"
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "object-type": {
                  "description": "The type of the point-of-interest",
                  "enum": [
                    "boat",
                    "bouy",
                    "debris",
                    "fishfarm",
                    "green",
                    "oil",
                    "personnel",
                    "red",
                    "unknown",
                    "vessel",
                    "yellow"
                  ],
                  "title": "Object type",
                  "type": "string"
                },
                "geometry": {
                  "$ref": "#/$defs/geometry"
                },
                "created": {
                  "$ref": "#/$defs/date"
                }
              },
              "required": [
                "created",
                "description",
                "name",
                "geometry",
                "object-type"
              ],
              "title": "Point-of-Interest",
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^object-type$": true,
                "^name$": true,
                "^geometry$": true,
                "^created$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The style description for the layer",
              "properties": {
                "data": {
                  "$ref": "#/$defs/dataset"
                },
                "type": {
                  "description": "The pseudo-mime type of the styling information.  E.g. 'text/x-sld'",
                  "enum": [
                    "text/x-sld"
                  ],
                  "title": "Style type",
                  "type": "string"
                }
              },
              "required": [
                "data",
                "type"
              ],
              "title": "Layer style",
              "type": "object"
            },
            {
              "patternProperties": {
                "^data$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "dataset": {
      "description": "Files in the archive that contain the data of interest",
      "items": {
        "description": "Use 'data:<mime-type>[;base64],<...>' for data URIs, 'file:<...>' for file references, and 'http://<host>/<file>' for external references.",
        "title": "Data-URI encoded reference.",
        "type": "string"
      },
      "minitems": "1",
      "title": "A set of files",
      "type": "array"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "manufacturer_name": {
                  "type": "string"
                },
                "shortname": {
                  "type": "string"
                },
                "location_name": {
                  "type": "string"
                },
                "model_number": {
                  "type": "string"
                },
                "serial_number": {
                  "type": "string"
                }
              },
              "required": [
                "shortname",
                "location_name",
                "manufacturer_name",
                "model_number",
                "serial_number"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^location_name$": true,
                "^manufacturer_name$": true,
                "^model_number$": true,
                "^shortname$": true,
                "^serial_number$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
