{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Codex Item Schema",
              "type": "object",
              "properties": {
                "identifier": {
                  "$ref": "#/$defs/modern_2"
                },
                "description": {
                  "type": "string"
                },
                "isCustomized": {
                  "type": "boolean"
                },
                "coverage": {
                  "type": "object"
                },
                "id": {
                  "type": "string"
                },
                "language": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "date": {
                  "type": "string"
                },
                "publisher": {
                  "type": "string"
                },
                "rights": {
                  "type": "string"
                },
                "instanceId": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "copyNumber": {
                  "type": "number"
                },
                "series": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "contributor": {
                  "$ref": "#/$defs/modern_3"
                },
                "barcode": {
                  "type": "string"
                },
                "location": {
                  "$ref": "#/$defs/modern_4"
                },
                "itemStatus": {
                  "type": "string"
                },
                "altTitle": {
                  "type": "string"
                },
                "isSelected": {
                  "type": "boolean"
                },
                "vendorPackage": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "instanceId",
                "title"
              ]
            },
            {
              "patternProperties": {
                "^publisher$": true,
                "^barcode$": true,
                "^description$": true,
                "^format$": true,
                "^identifier$": true,
                "^type$": true,
                "^id$": true,
                "^vendorPackage$": true,
                "^isSelected$": true,
                "^isCustomized$": true,
                "^location$": true,
                "^instanceId$": true,
                "^altTitle$": true,
                "^copyNumber$": true,
                "^series$": true,
                "^date$": true,
                "^coverage$": true,
                "^language$": true,
                "^contributor$": true,
                "^title$": true,
                "^rights$": true,
                "^source$": true,
                "^itemStatus$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "type": {
                    "type": "string"
                  }
                }
              },
              "_uniqueItems": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                }
              },
              "_uniqueItems": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
