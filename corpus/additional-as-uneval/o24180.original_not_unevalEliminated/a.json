{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "type of contributor to the resource"
                },
                "name": {
                  "type": "string",
                  "description": "name of contributor to the resource"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "description": "list of subjects this resource belongs to",
              "items": {
                "$ref": "#/$defs/modern_7"
              },
              "_uniqueItems": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Codex Instance Schema",
              "description": "Codex Instance Schema",
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "description": "format of the resource"
                },
                "series": {
                  "type": "string",
                  "description": "a series title associated with the resource (e.g. Harry Potter)"
                },
                "identifier": {
                  "$ref": "#/$defs/modern_2"
                },
                "lastModified": {
                  "type": "string",
                  "description": "date/time when this resource was last modified"
                },
                "version": {
                  "type": "string",
                  "description": "version of the resource"
                },
                "id": {
                  "type": "string",
                  "description": "the ID of the original record within its own database: since these come from various sources they may take different forms, e.g. integer, UUID"
                },
                "language": {
                  "type": "array",
                  "description": "the set of languages used by the resource",
                  "items": {
                    "type": "string"
                  }
                },
                "date": {
                  "type": "string",
                  "description": "the date of publication of the resource"
                },
                "publisher": {
                  "type": "string",
                  "description": "name of publisher of the resource"
                },
                "rights": {
                  "type": "string",
                  "description": "access rights associated with the resource"
                },
                "source": {
                  "type": "string",
                  "description": "a label indicating the source of the recent, e.g. kb, local"
                },
                "contributor": {
                  "$ref": "#/$defs/modern_4"
                },
                "subject": {
                  "$ref": "#/$defs/modern_6"
                },
                "altTitle": {
                  "type": "string",
                  "description": "an alternative title for the resource. (e.g. original language version title of a movie)"
                },
                "title": {
                  "type": "string",
                  "description": "the primary title (or label) associated with the resource"
                },
                "type": {
                  "type": "string",
                  "description": "content type of the resource",
                  "enum": [
                    "audio",
                    "audiobooks",
                    "books",
                    "bookseries",
                    "databases",
                    "ebooks",
                    "kits",
                    "maps",
                    "music",
                    "newspapers",
                    "newsletters",
                    "periodicals",
                    "posters",
                    "reports",
                    "proceedings",
                    "thesisanddissertation",
                    "unspecified",
                    "video",
                    "webresources"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "type",
                "source"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^publisher$": true,
                "^format$": true,
                "^identifier$": true,
                "^series$": true,
                "^date$": true,
                "^type$": true,
                "^id$": true,
                "^subject$": true,
                "^source$": true,
                "^altTitle$": true,
                "^lastModified$": true,
                "^language$": true,
                "^contributor$": true,
                "^title$": true,
                "^rights$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "description": "type of subject"
                },
                "name": {
                  "type": "string",
                  "description": "name of subject"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/modern_3"
              },
              "_uniqueItems": true,
              "description": "an extensible set of name-value pairs of identifiers associated with the resource"
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "description": "identifier type : e.g. ISSN"
                },
                "type": {
                  "type": "string",
                  "description": "identifier value"
                }
              }
            },
            {
              "patternProperties": {
                "^value$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "description": "list of contributors to the resource",
              "items": {
                "$ref": "#/$defs/modern_5"
              },
              "_uniqueItems": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
