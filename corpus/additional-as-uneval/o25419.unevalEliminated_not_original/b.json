{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A JSON RPC 2.0 request",
  "oneOf": [
    {
      "description": "An individual request",
      "$ref": "#/$defs/request"
    },
    {
      "description": "An array of requests",
      "type": "array",
      "items": {
        "$ref": "#/$defs/request"
      },
      "minItems": 1
    }
  ],
  "$defs": {
    "request": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "jsonrpc",
                "method"
              ],
              "properties": {
                "jsonrpc": {
                  "enum": [
                    "2.0"
                  ]
                },
                "method": {
                  "type": "string"
                },
                "id": {
                  "type": [
                    "string",
                    "number",
                    "null"
                  ],
                  "note": [
                    "While allowed, null should be avoided: http://www.jsonrpc.org/specification#id1",
                    "While allowed, a number with a fractional part should be avoided: http://www.jsonrpc.org/specification#id2"
                  ]
                },
                "params": {
                  "type": [
                    "array",
                    "object"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^jsonrpc$": true,
                "^method$": true,
                "^id$": true,
                "^params$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
