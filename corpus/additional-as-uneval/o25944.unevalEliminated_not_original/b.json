{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MySubObject"
      }
    },
    "sub1": {
      "$ref": "#/$defs/MySubObject"
    },
    "sub2": {
      "$ref": "#/$defs/modern_2"
    }
  },
  "required": [
    "list",
    "sub1",
    "sub2"
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Type-level description",
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/MySubObject",
              "description": "Property-level description"
            },
            {
              "patternProperties": {
                ".*": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "MySubObject": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
