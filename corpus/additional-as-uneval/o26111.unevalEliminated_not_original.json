                  "IdentityPoolId": {
                    "type": "string",
                    "pattern": "[\\w-]+:[0-9a-f-]+"
                  },
                  "DeveloperProviderName": {
                    "type": "string",
                    "pattern": "[\\w._-]+"
                  }
                }
              },
              {
                "patternProperties": {
