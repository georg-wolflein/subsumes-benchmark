                  },
                  "AllowUnauthenticatedIdentities": {
                    "type": "boolean"
                  },
                  "SupportedLoginProviders": {
                    "type": "object",
                    "properties": {
                      "www.amazon.com": {
                        "type": "string"
                      },
                      "api.twitter.com": {
                        "type": "string"
                      },
                      "www.digits.com": {
                        "type": "string"
                      },
                      "accounts.google.com": {
                        "type": "string"
                      },
                      "graph.facebook.com": {
                        "type": "string"
                      }
                    }
                  },
                  "OpenIdConnectProviderARNs": {
                    "type": "array",
