            "type": "string"
          },
          "accounts.google.com": {
            "type": "string"
          },
          "www.amazon.com": {
            "type": "string"
          },
          "api.twitter.com": {
            "type": "string"
          },
          "www.digits.com": {
            "type": "string"
          }
        }
      }
    },
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
