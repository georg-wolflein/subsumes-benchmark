{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_4",
  "$defs": {
    "stage": {
      "title": "stage",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stage"
          ],
          "default": "stage"
        },
        "props": {
          "$ref": "#/$defs/modern_1"
        }
      },
      "required": [
        "type",
        "props"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "description"
              ]
            },
            {
              "patternProperties": {
                "^title$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "teaser",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "teaser"
                  ],
                  "default": "teaser"
                },
                "props": {
                  "properties": {
                    "children": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/modern_3"
                      }
                    }
                  }
                }
              },
              "required": [
                "type",
                "props"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^props$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "teaser": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "reference": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "description",
                "reference"
              ]
            },
            {
              "patternProperties": {
                "^title$": true,
                "^description$": true,
                "^reference$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Page",
              "properties": {
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/stage"
                      },
                      {
                        "$ref": "#/$defs/teaser"
                      }
                    ]
                  }
                }
              },
              "required": [
                "title",
                "description",
                "children"
              ]
            },
            {
              "patternProperties": {
                "^title$": true,
                "^description$": true,
                "^children$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
