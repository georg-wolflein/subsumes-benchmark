{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "email": {
                  "_format": "email",
                  "type": "string"
                },
                "username": {
                  "minLength": 3,
                  "type": "string"
                },
                "roles": {
                  "type": "array"
                },
                "first": {
                  "type": "string"
                },
                "verified": {
                  "type": "boolean"
                },
                "password": {
                  "minLength": 8,
                  "type": "string"
                },
                "verification": {
                  "type": "string"
                },
                "last": {
                  "type": "string"
                }
              },
              "required": [
                "email",
                "first",
                "last",
                "username",
                "verified",
                "roles"
              ],
              "title": "user schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^verified$": true,
                "^roles$": true,
                "^username$": true,
                "^last$": true,
                "^first$": true,
                "^email$": true,
                "^verification$": true,
                "^password$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
