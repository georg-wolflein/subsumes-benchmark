{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "plugins": {
      "properties": {
        "puppet": {
          "$ref": "#/$defs/modern_1"
        }
      },
      "type": "object"
    }
  },
  "title": "Puppet plugin manifest",
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "minProperties": 1,
              "properties": {
                "assets": {
                  "$ref": "#/$defs/absolute_path"
                },
                "manifest": {
                  "$ref": "#/$defs/absolute_path"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^assets$": true,
                "^manifest$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "absolute_path": {
      "pattern": "^/[^\\0]+$",
      "type": "string"
    }
  }
}
