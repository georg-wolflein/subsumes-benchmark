{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRT to CVSS v3 Mapping",
  "description": "Mapping from the Vulnerability Rating Taxonomy to CVSS v3",
  "type": "object",
  "required": [
    "metadata",
    "content"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/MappingMetadata"
    },
    "content": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/MappingParent"
          },
          {
            "$ref": "#/$defs/Mapping"
          }
        ]
      }
    }
  },
  "$defs": {
    "MappingMetadata": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "#/$defs/CVSSv3"
        }
      },
      "required": [
        "default"
      ]
    },
    "VRTid": {
      "type": "string",
      "pattern": "^[a-z_]*$"
    },
    "CVSSv3": {
      "type": "string",
      "pattern": "^AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$"
    },
    "Mapping": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/VRTid"
        },
        "cvss_v3": {
          "$ref": "#/$defs/CVSSv3"
        }
      },
      "required": [
        "id",
        "cvss_v3"
      ],
      "additionalProperties": false
    },
    "MappingParent": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/VRTid"
        },
        "children": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/MappingParent"
              },
              {
                "$ref": "#/$defs/Mapping"
              }
            ]
          }
        },
        "cvss_v3": {
          "$ref": "#/$defs/CVSSv3"
        }
      },
      "required": [
        "id",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
