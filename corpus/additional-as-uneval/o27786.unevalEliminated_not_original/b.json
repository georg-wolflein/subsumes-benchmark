{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VRT to CVSS v3 Mapping",
  "description": "Mapping from the Vulnerability Rating Taxonomy to CVSS v3",
  "type": "object",
  "required": [
    "metadata",
    "content"
  ],
  "properties": {
    "metadata": {
      "$ref": "#/$defs/MappingMetadata"
    },
    "content": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/MappingParent"
          },
          {
            "$ref": "#/$defs/Mapping"
          }
        ]
      }
    }
  },
  "$defs": {
    "CVSSv3": {
      "type": "string",
      "pattern": "^AV:[NALP]/AC:[LH]/PR:[NLH]/UI:[NR]/S:[UC]/C:[NLH]/I:[NLH]/A:[NLH]$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/VRTid"
                },
                "cvss_v3": {
                  "$ref": "#/$defs/CVSSv3"
                }
              },
              "required": [
                "id",
                "cvss_v3"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^cvss_v3$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/VRTid"
                },
                "children": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/MappingParent"
                      },
                      {
                        "$ref": "#/$defs/Mapping"
                      }
                    ]
                  }
                },
                "cvss_v3": {
                  "$ref": "#/$defs/CVSSv3"
                }
              },
              "required": [
                "id",
                "children"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^children$": true,
                "^cvss_v3$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Mapping": {
      "$ref": "#/$defs/modern_1"
    },
    "MappingMetadata": {
      "type": "object",
      "properties": {
        "default": {
          "$ref": "#/definitions4/CVSSv3"
        }
      },
      "required": [
        "default"
      ]
    },
    "VRTid": {
      "type": "string",
      "pattern": "^[a-z_]*$"
    },
    "MappingParent": {
      "$ref": "#/$defs/modern_2"
    }
  }
}
