{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Mapping from the Vulnerability Rating Taxonomy to Remediation Advice",
  "properties": {
    "content": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/MappingParent"
          },
          {
            "$ref": "#/$defs/Mapping"
          }
        ]
      },
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/MappingMetadata"
    }
  },
  "required": [
    "metadata",
    "content"
  ],
  "title": "VRT to Remediation Advice",
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "remediation_advice"
                  ]
                },
                {
                  "required": [
                    "references"
                  ]
                }
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/VRTid"
                },
                "references": {
                  "$ref": "#/$defs/References"
                },
                "remediation_advice": {
                  "$ref": "#/$defs/RemediationAdvice"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^id$": true,
                "^references$": true,
                "^remediation_advice$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "children": {
                  "items": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/MappingParent"
                      },
                      {
                        "$ref": "#/$defs/Mapping"
                      }
                    ]
                  },
                  "type": "array"
                },
                "id": {
                  "$ref": "#/$defs/VRTid"
                },
                "references": {
                  "$ref": "#/$defs/References"
                },
                "remediation_advice": {
                  "$ref": "#/$defs/RemediationAdvice"
                }
              },
              "required": [
                "id",
                "children"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^children$": true,
                "^id$": true,
                "^references$": true,
                "^remediation_advice$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Mapping": {
      "$ref": "#/$defs/modern_1"
    },
    "MappingMetadata": {
      "properties": {
        "default": {
          "type": "null"
        },
        "keys": {
          "items": {
            "enum": [
              "remediation_advice",
              "references"
            ],
            "type": "string"
          },
          "minItems": 2,
          "type": "array",
          "_uniqueItems": true
        }
      },
      "required": [
        "default",
        "keys"
      ],
      "type": "object"
    },
    "References": {
      "items": {
        "pattern": "^http[s]?://.*$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "_uniqueItems": true
    },
    "RemediationAdvice": {
      "type": "string"
    },
    "VRTid": {
      "pattern": "^[a-z_]*$",
      "type": "string"
    },
    "MappingParent": {
      "$ref": "#/$defs/modern_2"
    }
  }
}
