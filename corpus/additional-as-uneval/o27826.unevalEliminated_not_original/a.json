{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "additionalProperties": false,
    "properties": {
      "computeOfferings": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "description": {
        "$ref": "#/$defs/Translations"
      },
      "id": {
        "minLength": 1,
        "type": "string"
      },
      "name": {
        "$ref": "#/$defs/Translations"
      }
    },
    "required": [
      "id",
      "name",
      "description",
      "computeOfferings"
    ],
    "type": "object"
  },
  "type": "array",
  "$defs": {
    "Translations": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string"
        },
        "ru": {
          "type": "string"
        }
      },
      "required": [
        "ru",
        "en"
      ],
      "type": "object"
    }
  }
}
