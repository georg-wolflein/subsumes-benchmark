{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o27827.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "errorMessage": {
      "uniqueItemProperties": "should NOT contain objects with the same offeringId"
    },
    "items": {
      "additionalProperties": false,
      "properties": {
        "cpunumber": {
          "$ref": "#/$defs/HardwareParameterLimits"
        },
        "cpuspeed": {
          "$ref": "#/$defs/HardwareParameterLimits"
        },
        "memory": {
          "$ref": "#/$defs/HardwareParameterLimits"
        },
        "offeringId": {
          "type": "string"
        }
      },
      "required": [
        "offeringId",
        "cpunumber",
        "cpuspeed",
        "memory"
      ],
      "type": "object"
    },
    "type": "array",
    "uniqueItemProperties": [
      "offeringId"
    ],
    "$defs": {
      "HardwareParameterLimits": {
        "additionalProperties": false,
        "properties": {
          "max": {
            "minimum": 1,
            "type": "number"
          },
          "min": {
            "minimum": 1,
            "type": "number"
          },
          "value": {
            "minimum": 1,
            "type": "number"
          }
        },
        "required": [
          "min",
          "max",
          "value"
        ],
        "type": "object"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "errorMessage": {
      "uniqueItemProperties": "should NOT contain objects with the same offeringId"
    },
    "items": {
      "$ref": "#/$defs/modern_2"
    },
    "type": "array",
    "uniqueItemProperties": [
      "offeringId"
    ],
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "max": {
                    "minimum": 1.0,
                    "type": "number"
                  },
                  "min": {
                    "minimum": 1.0,
                    "type": "number"
                  },
                  "value": {
                    "minimum": 1.0,
                    "type": "number"
                  }
                },
                "required": [
                  "min",
                  "max",
                  "value"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^max$": true,
                  "^min$": true,
                  "^value$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "cpunumber": {
                    "$ref": "#/$defs/HardwareParameterLimits"
                  },
                  "cpuspeed": {
                    "$ref": "#/$defs/HardwareParameterLimits"
                  },
                  "memory": {
                    "$ref": "#/$defs/HardwareParameterLimits"
                  },
                  "offeringId": {
                    "type": "string"
                  }
                },
                "required": [
                  "offeringId",
                  "cpunumber",
                  "cpuspeed",
                  "memory"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^cpunumber$": true,
                  "^cpuspeed$": true,
                  "^memory$": true,
                  "^offeringId$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "HardwareParameterLimits": {
        "$ref": "#/$defs/modern_1"
      }
    }
  }
}
