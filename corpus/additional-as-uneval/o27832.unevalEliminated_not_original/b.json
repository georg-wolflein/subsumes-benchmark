{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "en": {
                  "type": "string"
                },
                "ru": {
                  "type": "string"
                }
              },
              "required": [
                "ru",
                "en"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^en$": true,
                "^ru$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
