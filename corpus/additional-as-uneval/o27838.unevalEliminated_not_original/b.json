{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "env": {
                  "minLength": 1,
                  "type": "string"
                },
                "realm": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "realm",
                "env"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^env$": true,
                "^realm$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
