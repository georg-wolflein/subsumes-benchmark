{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "autoUpdateRefreshFrequency": {
                  "minimum": 1.0,
                  "type": "number"
                },
                "autoUpdateRequestedInterval": {
                  "minimum": 1.0,
                  "type": "number"
                }
              },
              "required": [
                "autoUpdateRefreshFrequency",
                "autoUpdateRequestedInterval"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^autoUpdateRefreshFrequency$": true,
                "^autoUpdateRequestedInterval$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
