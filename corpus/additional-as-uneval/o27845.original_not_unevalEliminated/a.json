{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "enable": {
                  "type": "boolean"
                },
                "snapshotsLimit": {
                  "minimum": 0.0,
                  "type": "number"
                }
              },
              "required": [
                "enable",
                "snapshotsLimit"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^enable$": true,
                "^snapshotsLimit$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
