                "locality",
                "region"
              ],
              "title": "address",
              "type": "object"
            },
            {
              "patternProperties": {
                "^postal_code$": true,
                "^extended_address$": true,
                "^region$": true,
                "^locality$": true,
                "^post_office_box$": true,
                "^street_address$": true,
