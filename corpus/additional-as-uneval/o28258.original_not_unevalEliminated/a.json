{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "RGBA color",
              "properties": {
                "a": {
                  "default": 1.0,
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "b": {
                  "default": 0,
                  "maximum": 255.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "g": {
                  "default": 0,
                  "maximum": 255.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "r": {
                  "default": 0,
                  "maximum": 255.0,
                  "minimum": 0.0,
                  "type": "integer"
                }
              },
              "title": "color",
              "type": "object"
            },
            {
              "patternProperties": {
                "^a$": true,
                "^b$": true,
                "^g$": true,
                "^r$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
