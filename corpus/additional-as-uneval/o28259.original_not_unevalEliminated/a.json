{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "",
              "properties": {
                "day": {
                  "maximum": 31.0,
                  "minimum": 1.0,
                  "type": "integer"
                },
                "month": {
                  "maximum": 12.0,
                  "minimum": 1.0,
                  "type": "integer"
                },
                "year": {
                  "type": "integer"
                }
              },
              "title": "date",
              "type": "object"
            },
            {
              "patternProperties": {
                "^day$": true,
                "^month$": true,
                "^year$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
