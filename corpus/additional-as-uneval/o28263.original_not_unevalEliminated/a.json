{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "",
              "properties": {
                "amount": {
                  "type": "number"
                },
                "currency": {
                  "default": "USD",
                  "type": "string"
                }
              },
              "required": [
                "amount"
              ],
              "title": "money",
              "type": "object"
            },
            {
              "patternProperties": {
                "^amount$": true,
                "^currency$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
