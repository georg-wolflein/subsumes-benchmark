{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "",
              "properties": {
                "hour": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "minute": {
                  "maximum": 59.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "second": {
                  "maximum": 59.0,
                  "minimum": 0.0,
                  "type": "integer"
                }
              },
              "title": "time",
              "type": "object"
            },
            {
              "patternProperties": {
                "^hour$": true,
                "^minute$": true,
                "^second$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
