{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": " ",
              "properties": {
                "method": {
                  "enum": [
                    "POST",
                    "PUT"
                  ]
                },
                "source": {
                  "enum": [
                    null,
                    "common-ingest"
                  ]
                },
                "host": {
                  "_format": "ipv4",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "contentType": {
                  "enum": [
                    "application/xml",
                    "application/json"
                  ]
                },
                "content": {
                  "type": "string"
                },
                "requestUrl": {
                  "_format": "uri",
                  "type": "string"
                },
                "protocol": {
                  "type": "string"
                }
              },
              "required": [
                "content",
                "contentType",
                "host",
                "id",
                "method",
                "protocol",
                "requestUrl",
                "source"
              ],
              "title": "",
              "type": "object"
            },
            {
              "patternProperties": {
                "^contentType$": true,
                "^method$": true,
                "^requestUrl$": true,
                "^protocol$": true,
                "^host$": true,
                "^id$": true,
                "^content$": true,
                "^source$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
