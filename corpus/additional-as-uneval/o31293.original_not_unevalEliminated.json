{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o31293.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o31293.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "define segments to insert into a jinja template",
                "type": "object",
                "required": [
                  "identifier",
                  "description",
                  "segments"
                ],
                "properties": {
                  "identifier": {
                    "description": "the identification of the segments",
                    "type": "string"
                  },
                  "description": {
                    "description": "the purpose of this group of segments",
                    "type": "string"
                  },
                  "segments": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "overwrite": {
                    "description": "a list of segment keys that may overwrite previously defined entries",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "$schema": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^$schema$": true,
                  "^segments$": true,
                  "^description$": true,
                  "^identifier$": true,
                  "^overwrite$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "the segments to insert",
                "patternProperties": {
                  ".+": {
                    "description": "a segment of the template, each line should be a separate list item",
                    "type": [
                      "string",
                      "array"
                    ],
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  ".+": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "define segments to insert into a jinja template",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "identifier",
      "description",
      "segments"
    ],
    "properties": {
      "$schema": {
        "type": "string"
      },
      "identifier": {
        "description": "the identification of the segments",
        "type": "string"
      },
      "description": {
        "description": "the purpose of this group of segments",
        "type": "string"
      },
      "segments": {
        "additionalProperties": false,
        "description": "the segments to insert",
        "patternProperties": {
          ".+": {
            "description": "a segment of the template, each line should be a separate list item",
            "type": [
              "string",
              "array"
            ],
            "items": {
              "type": "string"
            }
          }
        }
      },
      "overwrite": {
        "description": "a list of segment keys that may overwrite previously defined entries",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
