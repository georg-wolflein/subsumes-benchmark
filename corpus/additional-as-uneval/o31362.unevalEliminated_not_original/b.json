{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The global configuration of the project.",
              "type": "object",
              "properties": {
                "version": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "protractor": {
                  "$ref": "#/$defs/modern_7"
                }
              }
            },
            {
              "patternProperties": {
                "^protractor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {}
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Angular CLI Config Schema",
              "type": "object",
              "properties": {
                "test": {
                  "$ref": "#/$defs/modern_2"
                },
                "defaults": {
                  "$ref": "#/$defs/modern_4"
                },
                "project": {
                  "$ref": "#/$defs/modern_5"
                },
                "e2e": {
                  "$ref": "#/$defs/modern_6"
                },
                "apps": {
                  "$ref": "#/$defs/modern_8"
                },
                "packages": {
                  "description": "Configuration reserved for installed third party packages.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                },
                "addons": {
                  "description": "Configuration reserved for installed third party addons.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^apps$": true,
                "^addons$": true,
                "^test$": true,
                "^packages$": true,
                "^defaults$": true,
                "^project$": true,
                "^e2e$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "karma": {
                  "$ref": "#/$defs/modern_3"
                }
              }
            },
            {
              "patternProperties": {
                "^karma$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Properties of the different applications in this project.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/modern_9"
              }
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "main": {
                  "type": "string"
                },
                "tsconfig": {
                  "type": "string"
                },
                "mobile": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^main$": true,
                "^tsconfig$": true,
                "^mobile$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {}
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "prefix": {
                  "type": "string"
                },
                "sourceDir": {
                  "type": "string"
                },
                "styleExt": {
                  "type": "string"
                },
                "prefixInterfaces": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^prefix$": true,
                "^sourceDir$": true,
                "^styleExt$": true,
                "^prefixInterfaces$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
