{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Plurality Election",
              "description": "A single plurality race",
              "type": "object",
              "properties": {
                "votes": {
                  "description": "all of the votes in the election",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "results": {
                  "$ref": "#/$defs/modern_3"
                },
                "isTest": {
                  "description": "Value that is always true if it exists, could later be used to specify some useful info about the test",
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                },
                "tiebreak": {
                  "description": "the candidate that should be chosen in the event of a tie",
                  "type": "integer"
                },
                "counts": {
                  "description": "In a test, this array specifies how many of each of the ballots in votes will appear. Can be used for a compressed form of tests",
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                }
              },
              "dependentRequired": {
                "isTest": [
                  "results",
                  "tiebreak",
                  "counts"
                ]
              }
            },
            {
              "patternProperties": {
                "^isTest$": true,
                "^votes$": true,
                "^counts$": true,
                "^tiebreak$": true,
                "^results$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "description": "A unique identifier for each ballot",
                  "type": "integer"
                },
                "selection": {
                  "description": "The candidate selected on this ballot",
                  "type": "integer"
                }
              },
              "required": [
                "id",
                "selection"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^selection$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "a record of what happened as the election was tabulated",
              "type": "object",
              "properties": {
                "winner": {
                  "description": "which candidate won the election",
                  "type": "integer"
                },
                "tabulation": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "winner"
              ]
            },
            {
              "patternProperties": {
                "^winner$": true,
                "^tabulation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "candidate": {
                  "type": "integer"
                },
                "votes": {
                  "type": "integer"
                }
              },
              "required": [
                "candidate",
                "votes"
              ]
            },
            {
              "patternProperties": {
                "^candidate$": true,
                "^votes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
