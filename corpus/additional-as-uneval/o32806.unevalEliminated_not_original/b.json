{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "identifier": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "pattern": "^[\\w\\d][\\w\\d-]*$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "registry": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "required": [
                    "command"
                  ],
                  "properties": {
                    "command": {
                      "type": "string"
                    },
                    "argv": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "env": {
                      "type": "object",
                      "patternProperties": {
                        ".+": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "aws": {
                  "type": "object",
                  "properties": {
                    "accountId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "profile": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "region": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "utils": {
                  "type": "object"
                },
                "build": {
                  "type": "object",
                  "properties": {
                    "unbundled": {
                      "type": "object",
                      "patternProperties": {
                        ".+": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "log_level": {
                  "type": "string",
                  "enum": [
                    "trace",
                    "debug",
                    "info",
                    "warn",
                    "error",
                    "fatal"
                  ]
                },
                "hooks": {
                  "type": "object",
                  "properties": {
                    "postbuildrollup": true,
                    "prebuildinstall": true,
                    "preupdate": true,
                    "postpublish": true,
                    "postbuildinstall": true,
                    "postbuild": true,
                    "prepublish": true,
                    "postupdate": true,
                    "prebuild": true,
                    "prebuildrollup": true
                  }
                },
                "update": {
                  "type": "object",
                  "properties": {}
                },
                "env": {
                  "$ref": "#/$defs/identifier"
                }
              }
            },
            {
              "patternProperties": {
                "^aws$": true,
                "^utils$": true,
                "^hooks$": true,
                "^build$": true,
                "^env$": true,
                "^log_level$": true,
                "^update$": true,
                "^registry$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
