{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_16",
  "$defs": {
    "challenge": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A challenge that uses the ClutchGame template",
              "type": "object",
              "properties": {
                "mother": {
                  "description": "Specifies the mother's genetics",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/dashDrakeOrRandomMatched"
                  }
                },
                "hiddenAlleles": {
                  "$ref": "#/$defs/hiddenAlleles"
                },
                "container": {
                  "description": "The container for the challenge",
                  "type": "string",
                  "enum": [
                    "FVContainer"
                  ]
                },
                "challengeType": {
                  "description": "The type of challenge",
                  "type": "string",
                  "enum": [
                    "match-target",
                    "submit-parents",
                    "test-cross"
                  ]
                },
                "targetDrakes": {
                  "description": "Specifies the target drake's genetics",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/dashDrakeOrRandomMatched"
                  }
                },
                "linkedGenes": {
                  "$ref": "#/$defs/linkedGenes"
                },
                "visibleGenes": {
                  "$ref": "#/$defs/genes"
                },
                "userChangeableGenes": {
                  "description": "The genes the user can manipulate for each parent in the trial",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  }
                },
                "template": {
                  "type": "string",
                  "enum": [
                    "ClutchGame"
                  ]
                },
                "hiddenParent": {
                  "description": "Attributes of the hidden parent",
                  "type": "object",
                  "properties": {
                    "hiddenGenotype": {
                      "description": "Whether to hide the genotype of the parent",
                      "type": "boolean"
                    },
                    "sex": {
                      "$ref": "#/$defs/biologicaSex"
                    }
                  }
                },
                "goalMoves": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/goalMovesOrArray"
                  }
                },
                "father": {
                  "description": "Specifies the father's genetics",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/dashDrakeOrRandomMatched"
                  }
                },
                "comment": {
                  "description": "A description of the challenge",
                  "type": "string"
                }
              },
              "required": [
                "challengeType",
                "container",
                "father",
                "goalMoves",
                "hiddenAlleles",
                "template",
                "userChangeableGenes"
              ]
            },
            {
              "patternProperties": {
                "^hiddenAlleles$": true,
                "^template$": true,
                "^container$": true,
                "^hiddenParent$": true,
                "^comment$": true,
                "^userChangeableGenes$": true,
                "^challengeType$": true,
                "^visibleGenes$": true,
                "^goalMoves$": true,
                "^linkedGenes$": true,
                "^targetDrakes$": true,
                "^mother$": true,
                "^father$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_20": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Information about the challenge",
              "type": "object",
              "properties": {
                "description": {
                  "description": "A description of the challenge",
                  "type": "string"
                },
                "tip": {
                  "description": "A hint provided to the user",
                  "type": "string"
                },
                "type": {
                  "description": "The type of the challenge",
                  "type": "string"
                }
              },
              "required": [
                "description",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^tip$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "FVEggSortGame": {
      "$ref": "#/$defs/modern_3"
    },
    "goalMovesArray": {
      "description": "The number of moves required to match multiple targets",
      "type": "array",
      "items": {
        "$ref": "#/$defs/goalMovesSingle"
      }
    },
    "dashDrakeRandomMatched": {
      "$ref": "#/$defs/modern_8"
    },
    "modern_21": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The dialog spoken by the characters during the challenge",
              "type": "object",
              "properties": {
                "end": {
                  "$ref": "#/$defs/endDialogSequence"
                },
                "start": {
                  "$ref": "#/$defs/dialogSequence"
                }
              },
              "required": [
                "end",
                "start"
              ]
            },
            {
              "patternProperties": {
                "^end$": true,
                "^start$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "baseDrake": {
                  "$ref": "#/$defs/biologicaAlleles"
                },
                "drakes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/drake"
                  }
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "randomize-order"
                  ]
                }
              },
              "required": [
                "baseDrake",
                "drakes",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^baseDrake$": true,
                "^drakes$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "genes": {
      "description": "An array of gene strings or a string containing a comma-separated list of genes",
      "oneOf": [
        {
          "$ref": "#/$defs/genesArray"
        },
        {
          "$ref": "#/$defs/genesString"
        }
      ]
    },
    "biologicaAlleles": {
      "description": "A set of alleles that can be used to specify an organism in the 'a:b:' format used by BioLogica",
      "comment": "Note that this excludes the A2 allele which is not used by Geniventure.",
      "type": "string",
      "pattern": "^(((a|b):(T|Tk|t|M|m|W|w|H|h|C|c|Fl|fl|Hl|hl|A1|a|B|b|D|d|Rh|rh|Bog|bog))|,)*$"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A challenge that uses the FVGenomeChallenge template",
              "type": "object",
              "properties": {
                "numTrials": {
                  "description": "The number of trials",
                  "type": "integer",
                  "minimum": 1.0
                },
                "hiddenAlleles": {
                  "$ref": "#/$defs/hiddenAlleles"
                },
                "showDrakeColorHint": {
                  "description": "Whether to show text next to a drake image to describe the color (copper, lava, etc)",
                  "type": "boolean"
                },
                "container": {
                  "type": "string",
                  "enum": [
                    "FVContainer"
                  ]
                },
                "showUserDrake": {
                  "description": "Whether the user's drake should be visible",
                  "type": "boolean"
                },
                "challengeType": {
                  "type": "string",
                  "enum": [
                    "create-unique",
                    "match-target"
                  ]
                },
                "targetDrakes": {
                  "description": "Specifies the target drakes to be matched",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/drake"
                  }
                },
                "linkedGenes": {
                  "$ref": "#/$defs/linkedGenes"
                },
                "randomizeTrials": {
                  "description": "Whether the order of the trials should be randomized",
                  "type": "boolean"
                },
                "visibleGenes": {
                  "$ref": "#/$defs/genes"
                },
                "comment": {
                  "type": "string"
                },
                "instructions": {
                  "description": "Instructions displayed to the user",
                  "type": "string"
                },
                "userChangeableGenes": {
                  "$ref": "#/$defs/genes"
                },
                "initialDrake": {
                  "description": "Specifies a single drake or an array of drakes",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/drake"
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/drake"
                      }
                    }
                  ]
                },
                "trialGenerator": {
                  "$ref": "#/$defs/modern_7"
                },
                "template": {
                  "type": "string",
                  "enum": [
                    "FVGenomeChallenge"
                  ]
                }
              },
              "required": [
                "challengeType",
                "container",
                "showUserDrake",
                "template",
                "userChangeableGenes"
              ]
            },
            {
              "patternProperties": {
                "^hiddenAlleles$": true,
                "^template$": true,
                "^showDrakeColorHint$": true,
                "^container$": true,
                "^showUserDrake$": true,
                "^comment$": true,
                "^userChangeableGenes$": true,
                "^challengeType$": true,
                "^randomizeTrials$": true,
                "^initialDrake$": true,
                "^targetDrakes$": true,
                "^numTrials$": true,
                "^instructions$": true,
                "^linkedGenes$": true,
                "^trialGenerator$": true,
                "^visibleGenes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Geniventure Authoring",
              "description": "Geniventure's authoring document",
              "type": "object",
              "properties": {
                "application": {
                  "$ref": "#/$defs/modern_17"
                },
                "challenges": {
                  "description": "Configuration of the challenges provided by the application",
                  "type": "object",
                  "patternProperties": {
                    "^.+$": {
                      "description": "Each entry represents a challenge",
                      "type": "object",
                      "oneOf": [
                        {
                          "$ref": "#/$defs/challenge"
                        },
                        {
                          "$ref": "#/$defs/ClutchGame"
                        },
                        {
                          "$ref": "#/$defs/FVEggGame"
                        },
                        {
                          "$ref": "#/$defs/FVEggSortGame"
                        },
                        {
                          "$ref": "#/$defs/FVGenomeChallenge"
                        }
                      ]
                    }
                  }
                },
                "rooms": {
                  "$ref": "#/$defs/modern_23"
                }
              },
              "required": [
                "application",
                "challenges",
                "rooms"
              ]
            },
            {
              "patternProperties": {
                "^application$": true,
                "^challenges$": true,
                "^rooms$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Specification for a drake using BioLogica alleles format",
              "type": "object",
              "properties": {
                "alleles": {
                  "$ref": "#/$defs/biologicaAlleles"
                },
                "sex": {
                  "$ref": "#/$defs/biologicaSex"
                }
              },
              "required": [
                "alleles"
              ]
            },
            {
              "patternProperties": {
                "^alleles$": true,
                "^sex$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "drakeOrArray": {
      "description": "Specification for a single drake or an array of drakes",
      "oneOf": [
        {
          "$ref": "#/$defs/drake"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/drake"
          }
        }
      ]
    },
    "hiddenAlleles": {
      "description": "A list of alleles that should not be selectable by the user",
      "type": "string",
      "pattern": "^((T|Tk|t|M|m|W|w|H|h|C|c|Fl|fl|Hl|hl|A1|A2|a|B|b|D|d|Rh|rh|Bog|bog)|,)*$"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configuration of an individual challenge",
              "type": "object",
              "properties": {
                "linkedGenes": {
                  "$ref": "#/$defs/linkedGenes"
                },
                "template": {
                  "$ref": "#/$defs/template"
                },
                "patternProperties": {
                  "^.+$": {
                    "description": "Challenge properties are defined by the template and vary among challenges."
                  }
                }
              },
              "required": [
                "template"
              ]
            },
            {
              "patternProperties": {
                "^linkedGenes$": true,
                "^template$": true,
                "^patternProperties$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Specifies the randomization of the trials",
              "type": "object",
              "properties": {
                "baseDrake": {
                  "$ref": "#/$defs/biologicaAlleles"
                },
                "initialDrakeCombos": {
                  "description": "Specifies the combinations of alleles used to generated the initial drakes",
                  "type": "array",
                  "items": {
                    "description": "Specifies a set of alleles, one of which is to be randomly selected",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/biologicaAlleles"
                    }
                  }
                },
                "targetDrakeCombos": {
                  "description": "Specifies the combinations of alleles used to generated the target drakes",
                  "type": "array",
                  "items": {
                    "description": "Specifies a set of alleles, one of which is to be randomly selected",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/biologicaAlleles"
                    }
                  }
                },
                "type": {
                  "description": "The type of randomization used to generate the trials",
                  "type": "string",
                  "enum": [
                    "all-combinations"
                  ]
                }
              },
              "required": [
                "baseDrake",
                "initialDrakeCombos",
                "targetDrakeCombos",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^baseDrake$": true,
                "^initialDrakeCombos$": true,
                "^targetDrakeCombos$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "drakeRandomMatched": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_23": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configuration of the locations available within the application",
              "type": "object",
              "patternProperties": {
                "^.+$": {
                  "description": "Each entry represents a room",
                  "type": "object",
                  "properties": {
                    "defaultCharacter": {
                      "description": "The narrative character present by default in the room",
                      "type": "string"
                    },
                    "name": {
                      "description": "The name of the room",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^.+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "drakeOrRandomMatched": {
      "description": "A drake or a set of drakes from which one is to be randomly selected.",
      "oneOf": [
        {
          "$ref": "#/$defs/drake"
        },
        {
          "$ref": "#/$defs/drakeRandomMatched"
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configuration for the levels and missions that comprise the application",
              "type": "object",
              "properties": {
                "levels": {
                  "description": "Configuration for the levels that comprise the application",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_18"
                  }
                }
              },
              "required": [
                "levels"
              ]
            },
            {
              "patternProperties": {
                "^levels$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Specification for a set of drakes from which one is to be randomly selected.",
              "type": "object",
              "properties": {
                "randomMatched": {
                  "description": "The set of drakes from which one is to be randomly selected.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/drake"
                  }
                }
              },
              "required": [
                "randomMatched"
              ]
            },
            {
              "patternProperties": {
                "^randomMatched$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Alternative dialog sequences spoken at the end of a challenge or mission",
              "type": "object",
              "properties": {
                "failure": {
                  "$ref": "#/$defs/dialogSequence"
                },
                "success": {
                  "$ref": "#/$defs/dialogSequence"
                }
              },
              "required": [
                "failure",
                "success"
              ]
            },
            {
              "patternProperties": {
                "^failure$": true,
                "^success$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "ClutchGame": {
      "$ref": "#/$defs/modern_10"
    },
    "goalMovesSingle": {
      "description": "The number of moves required to match the target",
      "type": "integer",
      "minimum": 0.0
    },
    "linkedGenes": {
      "description": "Specifies genes that should be synchronized between multiple drakes for one or more trials",
      "oneOf": [
        {
          "$ref": "#/$defs/linkedGenesTrial"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/linkedGenesTrial"
          }
        }
      ]
    },
    "goalMovesOrArray": {
      "oneOf": [
        {
          "$ref": "#/$defs/goalMovesSingle"
        },
        {
          "$ref": "#/$defs/goalMovesArray"
        }
      ]
    },
    "linkedGenesTrial": {
      "description": "Specifies genes that should be synchronized between multiple drakes",
      "type": "object",
      "properties": {
        "drakes": {
          "description": "Specifies the drakes that should be linked by their indices",
          "type": "array",
          "items": {
            "description": "Indices of the drakes to be linked",
            "type": "number"
          }
        },
        "genes": {
          "$ref": "#/$defs/genes"
        },
        "minChanges": {
          "description": "The minimum number of allele changes required to match the drakes after linking genes",
          "type": "integer",
          "minimum": 0.0
        }
      }
    },
    "FVGenomeChallenge": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Specification for a set of drakes from which one is to be randomly selected.",
              "type": "object",
              "properties": {
                "randomMatched": {
                  "description": "The set of drakes from which one is to be randomly selected.",
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/dashDrake"
                      },
                      {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/dashDrake"
                        }
                      }
                    ]
                  }
                }
              },
              "required": [
                "randomMatched"
              ]
            },
            {
              "patternProperties": {
                "^randomMatched$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "biologicaSex": {
      "description": "Numeric value to indicate sex -- 0: male, 1: female",
      "type": "number",
      "enum": [
        0,
        1
      ]
    },
    "genesString": {
      "description": "A comma-separated list of gene strings",
      "type": "string",
      "pattern": "^(tail|metallic|wings|horns|color|black|forelimbs|hindlimbs|armor|dilute|bogbreath|nose|(, ))*$"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Each item corresponds to a piece of dialog from one of the characters",
              "type": "object",
              "properties": {
                "character": {
                  "$ref": "#/$defs/character"
                },
                "text": {
                  "description": "The text spoken by the character",
                  "type": "string"
                }
              },
              "required": [
                "character",
                "text"
              ]
            },
            {
              "patternProperties": {
                "^character$": true,
                "^text$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "endDialogSequence": {
      "$ref": "#/$defs/modern_12"
    },
    "character": {
      "description": "The name of the character",
      "type": "string",
      "enum": [
        "ELLIS",
        "HATCH",
        "HERRERA",
        "NETANYA",
        "RAJPUT",
        "WEAVER",
        "YEUNG"
      ]
    },
    "modern_18": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Each entry corresponds to a level",
              "type": "object",
              "properties": {
                "missions": {
                  "description": "Configuration for the missions that comprise the level",
                  "type": "array",
                  "items": {
                    "description": "Each entry corresponds to a mission",
                    "type": "object",
                    "properties": {
                      "challenges": {
                        "description": "The list of challenges provided by this mission",
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/modern_19"
                        }
                      },
                      "dialog": {
                        "$ref": "#/$defs/modern_22"
                      },
                      "name": {
                        "description": "The name of the mission",
                        "type": "string"
                      }
                    },
                    "required": [
                      "challenges",
                      "dialog",
                      "name"
                    ]
                  }
                },
                "name": {
                  "description": "The name of the mission",
                  "type": "string"
                }
              },
              "required": [
                "missions",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^missions$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Specification for a drake using dash alleles format",
              "type": "object",
              "properties": {
                "alleles": {
                  "$ref": "#/$defs/biologicaDashAlleles"
                },
                "sex": {
                  "$ref": "#/$defs/biologicaSex"
                }
              },
              "required": [
                "alleles"
              ]
            },
            {
              "patternProperties": {
                "^alleles$": true,
                "^sex$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "biologicaDashAlleles": {
      "description": "A set of alleles that can be used to specify an organism in the 'a-a' format",
      "comment": "Note that this excludes the A2 allele which is not used by Geniventure.",
      "type": "string",
