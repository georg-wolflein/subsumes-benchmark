{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "target",
                "source"
              ],
              "properties": {
                "source": {
                  "$ref": "#/$defs/modern_6"
                },
                "target": {
                  "$ref": "#/$defs/modern_7"
                },
                "metadata": {
                  "$ref": "#/$defs/modern_8"
                }
              }
            },
            {
              "patternProperties": {
                "^source$": true,
                "^target$": true,
                "^metadata$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "memberIndex": {
                  "type": "integer"
                },
                "slot": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^memberIndex$": true,
                "^slot$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "displayName": {
                  "type": "string"
                },
                "outslots": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  }
                },
                "metadata": {
                  "$ref": "#/$defs/modern_13"
                },
                "compoundId": {
                  "type": "string",
                  "readonly": true
                },
                "inslots": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_14"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^inslots$": true,
                "^displayName$": true,
                "^compoundId$": true,
                "^outslots$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "BDE internal component model",
              "type": "object",
              "required": [
                "id",
                "name",
                " type"
              ],
              "properties": {
                "displayName": {
                  "description": "User given name for a Cubixx",
                  "type": "string"
                },
                "outslots": {
                  "$ref": "#/$defs/modern_2"
                },
                "metadata": {
                  "$ref": "#/$defs/modern_4"
                },
                "compoundId": {
                  "description": "Cubixx group_id + name + version",
                  "type": "string",
                  "readonly": true
                },
                "connections": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  }
                },
                "members": {
                  "$ref": "#/$defs/modern_9"
                },
                "memberId": {
                  "description": "Cubixx local unique name",
                  "type": "string"
                },
                "inslots": {
                  "$ref": "#/$defs/modern_16"
                },
                "type": {
                  "enum": [
                    "compound"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^memberId$": true,
                "^type$": true,
                "^connections$": true,
                "^inslots$": true,
                "^displayName$": true,
                "^members$": true,
                "^compoundId$": true,
                "^outslots$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "memberIndex": {
                  "type": "integer"
                },
                "slot": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^memberIndex$": true,
                "^slot$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "This lists the members of the compound Cubixx",
              "type": "object",
              "patternProperties": {
                "[a-zA-Z0-9_.-]+": {
                  "$ref": "#/$defs/modern_10"
                }
              }
            },
            {
              "patternProperties": {
                "[a-zA-Z0-9_.-]+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "x": {
                  "type": "integer"
                },
                "y": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^label$": true,
                "^x$": true,
                "^y$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "metadata": {
                  "$ref": "#/$defs/modern_12"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^type$": true,
                "^metadata$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "metadata": {
                  "$ref": "#/$defs/modern_15"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^type$": true,
                "^metadata$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Slots pointing into the Cubixx",
              "type": "object",
              "patternProperties": {
                "[a-z0-9]+": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "metadata": {
                      "$ref": "#/$defs/modern_17"
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "[a-z0-9]+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Slots pointing out of the Cubixx",
              "type": "object",
              "patternProperties": {
                "[a-z0-9]+": {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string"
                    },
                    "metadata": {
                      "$ref": "#/$defs/modern_3"
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "[a-z0-9]+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
