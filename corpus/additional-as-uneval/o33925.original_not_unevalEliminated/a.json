{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "issuer_key": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "revocation_key": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              },
              "required": [
                "issuer_key",
                "revocation_key"
              ]
            },
            {
              "patternProperties": {
                "^issuer_key$": true,
                "^revocation_key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Date time ISO-8601 format of the date that the keys were issued."
                },
                "key": {
                  "type": "string",
                  "description": "Bitcoin address (compressed public key, usually 24 characters) that the issuer uses to issue the certificates."
                }
              },
              "required": [
                "date",
                "key"
              ]
            },
            {
              "patternProperties": {
                "^date$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "date": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Date time ISO-8601 format of the date that the keys were issued."
                },
                "key": {
                  "type": "string",
                  "description": "Bitcoin address (compressed public key, usually 24 characters) that the issuer uses to revoke the certificates."
                }
              },
              "required": [
                "date",
                "key"
              ]
            },
            {
              "patternProperties": {
                "^date$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
