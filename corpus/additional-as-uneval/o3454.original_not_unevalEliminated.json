                            "enum": [
                              "vm"
                            ],
                            "type": "string"
                          }
                        }
                      }
                    ]
                  },
                  "manifest-version": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^info$": true,
                  "^app$": true,
                  "^manifest-version$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "descriptorschema_1_0.AppInfo": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
