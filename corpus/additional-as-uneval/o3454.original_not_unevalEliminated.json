                  "description": {
                    "type": "string"
                  },
                  "author-name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "author-link": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^author-link$": true,
                  "^description$": true,
                  "^name$": true,
                  "^author-name$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Schema for IOx application descriptor - version 1.0",
