{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Describes the header of the import",
              "type": "object",
              "required": [
                "expectedHeader",
                "fieldNames",
                "caseSensitive",
                "strict",
                "additionalColumns",
                "severity"
              ],
              "properties": {
                "missingColumns": {
                  "$ref": "#/$defs/boolean"
                },
                "fieldNames": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "caseSensitive": {
                  "type": "boolean"
                },
                "strict": {
                  "$ref": "#/$defs/boolean"
                },
                "additionalColumns": {
                  "$ref": "#/$defs/boolean"
                },
                "expectedHeader": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "_uniqueItems": true
                },
                "severity": {
                  "$ref": "#/$defs/severity"
                },
                "mandatoryColumns": {
                  "oneOf": [
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string"
                            }
                          }
                        ]
                      },
                      "_uniqueItems": true
                    },
                    {
                      "type": "object",
                      "properties": {
                        "val": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                  "type": "string"
                                }
                              }
                            ]
                          },
                          "_uniqueItems": true
                        },
                        "severity": {
                          "$ref": "#/$defs/severity"
                        }
                      }
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^severity$": true,
                "^caseSensitive$": true,
                "^missingColumns$": true,
                "^mandatoryColumns$": true,
                "^strict$": true,
                "^fieldNames$": true,
                "^additionalColumns$": true,
                "^expectedHeader$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "boolean": {
      "onOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "val": {
              "type": "boolean"
            },
            "severity": {
              "$ref": "#/$defs/severity"
            }
          }
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "abort_file",
        "abort_scope",
        "skip_record",
        "skip_field"
      ]
    }
  }
}
