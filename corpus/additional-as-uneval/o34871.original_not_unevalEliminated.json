      },
      "segment": {
        "$ref": "#/$defs/modern_5"
      },
      "citation": {
        "$ref": "#/$defs/modern_6"
      },
      "numeric": {
        "pattern": "^[0-9]*(\\.[0-9]*)?$",
        "type": "string"
      },
      "release": {
        "description": "Levels at which participants or researchers may choose to share data.",
        "enum": [
          null,
          "PRIVATE",
          "SHARED",
          "EXCERPTS",
          "PUBLIC"
        ],
        "title": "sharing release level"
      }
