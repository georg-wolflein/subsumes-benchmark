                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "gestational age": {
                    "$ref": "#/$defs/numeric"
                  },
                  "country": {
                    "type": "string"
                  },
                  "reason": {
                    "enum": [
                      "Did not meet inclusion criteria",
                      "Procedural/experimenter error",
                      "Withdrew/fussy/tired",
                      "Outlier"
                    ],
                    "type": "string"
                  },
                  "info": {
                    "type": "string"
                  },
                  "key": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  },
                  "race": {
                    "enum": [
                      "American Indian or Alaska Native",
                      "Asian",
                      "Native Hawaiian or Other Pacific Islander",
                      "Black or African American",
                      "White",
                      "More than one",
                      "Unknown or not reported"
                    ],
                    "type": "string"
                  },
                  "disability": {
                    "type": "string"
                  },
                  "birth weight": {
                    "$ref": "#/$defs/numeric"
                  },
                  "summary": {
                    "type": "string"
                  },
                  "gender": {
                    "enum": [
                      "Female",
                      "Male"
                    ],
                    "type": "string"
                  },
                  "birthdate": {
                    "$ref": "#/$defs/date"
                  },
                  "id": {
                    "type": "integer"
                  },
                  "positions": {
                    "items": {
                      "$ref": "#/$defs/segment"
                    },
                    "type": "array"
                  },
                  "ethnicity": {
                    "enum": [
                      "Not Hispanic or Latino",
                      "Hispanic or Latino"
                    ],
                    "type": "string"
                  },
                  "category": {
                    "description": "Types of records that are relevant for data organization.",
                    "enum": [
                      "participant",
                      "pilot",
                      "exclusion",
                      "condition",
                      "group",
                      "task",
                      "context"
                    ]
                  }
                },
                "required": [
                  "key",
                  "category"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^race$": true,
                  "^gestational age$": true,
                  "^description$": true,
                  "^state$": true,
                  "^gender$": true,
                  "^category$": true,
                  "^name$": true,
                  "^summary$": true,
                  "^id$": true,
                  "^country$": true,
                  "^reason$": true,
                  "^ethnicity$": true,
                  "^birthdate$": true,
                  "^positions$": true,
                  "^pregnancy term$": true,
                  "^info$": true,
                  "^ID$": true,
                  "^birth weight$": true,
                  "^language$": true,
                  "^setting$": true,
                  "^disability$": true,
                  "^key$": true
                },
                "additionalProperties": false
              }
