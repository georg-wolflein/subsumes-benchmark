{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Schema for PawBlock's browser storage state",
              "type": "object",
              "properties": {
                "softBlockDelay": {
                  "description": "The number of seconds that the user must wait before continuing",
                  "type": "integer",
                  "minimum": 0.0
                },
                "blockType": {
                  "description": "The strictness of the block page",
                  "type": "string",
                  "enum": [
                    "hard",
                    "soft"
                  ]
                },
                "reenableMinutes": {
                  "description": "Number of minutes to wait before automatically turning PawBlock back on after turning it off",
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1.0
                },
                "storageVersion": {
                  "description": "To make schema changes easier in the future",
                  "type": "string"
                },
                "on": {
                  "description": "Whether or not the rules should be applied",
                  "type": "boolean"
                },
                "allowedTabId": {
                  "description": "The tab that should not enforce a block",
                  "type": "integer"
                },
                "rules": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^rules$": true,
                "^blockType$": true,
                "^allowedTabId$": true,
                "^on$": true,
                "^reenableMinutes$": true,
                "^storageVersion$": true,
                "^softBlockDelay$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "domain": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^domain$": true,
                "^path$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
