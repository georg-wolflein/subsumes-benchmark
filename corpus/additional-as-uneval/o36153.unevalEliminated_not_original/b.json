{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "users",
    "releases",
    "companies",
    "repos"
  ],
  "properties": {
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "project_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_2"
      }
    },
    "users": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_3"
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_5"
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_6"
      }
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "release_name": {
                  "type": "string"
                },
                "end_date": {
                  "type": "string",
                  "pattern": "20\\d{2}-\\w{3}-[0-3]\\d"
                }
              },
              "required": [
                "release_name",
                "end_date"
              ]
            },
            {
              "patternProperties": {
                "^release_name$": true,
                "^end_date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "module": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "project_group": {
                  "type": "string"
                },
                "project_type": {
                  "type": "string"
                },
                "releases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tag_from": {
                        "type": "string"
                      },
                      "tag_to": {
                        "type": "string"
                      },
                      "release_name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "tag_from",
                      "tag_to",
                      "release_name"
                    ]
                  }
                },
                "branches": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "uri",
                "project_type",
                "module",
                "branches"
              ]
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^branches$": true,
                "^project_group$": true,
                "^releases$": true,
                "^module$": true,
                "^project_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "company_name": {
                  "type": "string"
                },
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "company_name",
                "domains"
              ]
            },
            {
              "patternProperties": {
                "^company_name$": true,
                "^domains$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "organization": {
                  "type": "string"
                },
                "project_type": {
                  "type": "string"
                },
                "project_group": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "organization",
                "project_type"
              ]
            },
            {
              "patternProperties": {
                "^organization$": true,
                "^project_type$": true,
                "^project_group$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "launchpad_id": {
                  "type": "string"
                },
                "user_name": {
                  "type": "string"
                },
                "emails": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "[\\w\\d_\\.-]+@([\\w\\d_\\.-]+\\.)+[\\w]+"
                  },
                  "minItems": 1
                },
                "companies": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "launchpad_id",
                "user_name",
                "emails"
              ]
            },
            {
              "patternProperties": {
                "^launchpad_id$": true,
                "^user_name$": true,
                "^emails$": true,
                "^companies$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "company_name": {
                  "type": "string"
                },
                "end_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "20\\d{2}-\\w{3}-[0-3]\\d"
                }
              }
            },
            {
              "patternProperties": {
                "^company_name$": true,
                "^end_date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
