{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o36463.unevalEliminated_not_original.json",
  "a": {
    "$id": "http://localhost:1203/default-schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "test json schema",
    "type": "object",
    "properties": {
      "value": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      },
      "optionalValue": {
        "type": "string",
        "default": "my-default-value"
      }
    },
    "additionalProperties": false,
    "required": [
      "value"
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "test json schema",
                "type": "object",
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 1.0,
                    "maximum": 100.0
                  },
                  "optionalValue": {
                    "type": "string",
                    "default": "my-default-value"
                  }
                },
                "required": [
                  "value"
                ]
              },
              {
                "patternProperties": {
                  "^value$": true,
                  "^optionalValue$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
