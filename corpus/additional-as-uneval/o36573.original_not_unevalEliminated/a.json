{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "stringOrArr": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Multi code model generator",
              "description": "The scheme describes the data models and methods structure for the generation of a uniform code using various programming languages",
              "type": "object",
              "properties": {
                "contracts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "basetype": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "methods": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "args": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "name": {
                                    "type": "string"
                                  },
                                  "description": {
                                    "type": "string"
                                  },
                                  "array": {
                                    "type": "boolean"
                                  },
                                  "type": {
                                    "$ref": "#/$defs/typeBoth"
                                  },
                                  "arrayparams": {
                                    "type": "boolean",
                                    "description": "Rest Parameters. ts: func(...data[])"
                                  }
                                }
                              },
                              "required": [
                                "name",
                                "type"
                              ],
                              "minItems": 1
                            },
                            "result": {
                              "type": "object",
                              "properties": {
                                "type": {
                                  "$ref": "#/$defs/typeBoth"
                                },
                                "array": {
                                  "type": "boolean"
                                },
                                "description": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "type"
                              ]
                            }
                          },
                          "required": [
                            "name"
                          ],
                          "minItems": 1
                        }
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "enums": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "value": {
                              "type": "integer"
                            }
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "minItems": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "items"
                  ]
                },
                "models": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "array": {
                              "type": "boolean"
                            },
                            "attrs": {
                              "$ref": "#/$defs/attrType"
                            },
                            "type": {
                              "$ref": "#/$defs/typeBoth"
                            },
                            "required": {
                              "type": "boolean",
                              "default": true
                            }
                          }
                        },
                        "required": [
                          "name",
                          "type"
                        ],
                        "minItems": 1
                      },
                      "basetype": {
                        "type": "string"
                      },
                      "attrs": {
                        "$ref": "#/$defs/attrType"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "items"
                  ]
                },
                "$schema": {
                  "type": "string"
                },
                "imports": {
                  "type": "array",
                  "description": "The physical path to the other module types for use. Example: ../data/time.json",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "file",
                      "type"
                    ]
                  },
                  "minItems": 1,
                  "_uniqueItems": true,
                  "messages": {
                    "_uniqueItems": "Error unique imports"
                  }
                },
                "consts": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "name": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "type": {
                              "$ref": "#/$defs/simpleTypes"
                            },
                            "value": true
                          }
                        },
                        "required": [
                          "name",
                          "type",
                          "value"
                        ],
                        "minItems": 1
                      }
                    }
                  },
                  "required": [
                    "name",
                    "items"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^consts$": true,
                "^$schema$": true,
                "^contracts$": true,
                "^imports$": true,
                "^models$": true,
                "^enums$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "typeBoth": {
      "anyOf": [
        {
          "$ref": "#/$defs/simpleTypes"
        },
        {
          "type": "string"
        }
      ]
    },
    "simpleTypes": {
      "enum": [
        "boolean",
        "integer",
        "integer64",
        "float",
        "string",
        "any"
      ]
    },
    "attrType": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "^.+$": {
            "$ref": "#/$defs/stringOrArr"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
