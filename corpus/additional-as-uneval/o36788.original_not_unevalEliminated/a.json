{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Select2 Auto-complete Data Schema",
  "description": "",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "type": "string"
      },
      {
        "$ref": "#/$defs/modern_1"
      }
    ]
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "restype": {
                  "type": "string"
                },
                "router": {
                  "type": "string"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "File",
                    "Notes",
                    "Development",
                    "Personal"
                  ]
                }
              },
              "required": [
                "label"
              ]
            },
            {
              "patternProperties": {
                "^label$": true,
                "^restype$": true,
                "^router$": true,
                "^category$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
