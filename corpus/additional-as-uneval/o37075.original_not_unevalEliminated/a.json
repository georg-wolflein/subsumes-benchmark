{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configures debugging options.",
              "type": "object",
              "properties": {
                "generateHeapDump": {
                  "description": "Periodically generate a heap dump file.",
                  "type": "boolean"
                },
                "logToFile": {
                  "description": "Whether to log out to a file.",
                  "type": "boolean",
                  "default": true
                },
                "logPath": {
                  "description": "The file path to the file log.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^generateHeapDump$": true,
                "^logToFile$": true,
                "^logPath$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configures the Edge transport layer.",
              "type": "object",
              "properties": {
                "enableHeartbeat": {
                  "description": "Whether or not heartbeat should be enabled. This should only ever be disabled for diagnostic purposes.",
                  "type": "boolean",
                  "default": true
                },
                "host": {
                  "description": "The host service uri.",
                  "type": "string",
                  "format": "uri"
                }
              }
            },
            {
              "patternProperties": {
                "^enableHeartbeat$": true,
                "^host$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configuration for an individual plugin.",
              "type": "object",
              "properties": {
                "enabled": {
                  "description": "Set whether the plugin is enabled.",
                  "type": "boolean",
                  "default": true
                },
                "localServices": {
                  "description": "List local services that the plugin manages.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "name": {
                  "description": "The name of the plugin.",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^enabled$": true,
                "^localServices$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configures the diagnostics telnet console.",
              "type": "object",
              "properties": {
                "enabled": {
                  "description": "Determine whether the console should be enabled or not.",
                  "type": "boolean"
                },
                "port": {
                  "description": "The port the console is opened on.",
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 65536.0,
                  "default": 8888
                }
              }
            },
            {
              "patternProperties": {
                "^enabled$": true,
                "^port$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configuration for an individual plugin.",
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "description": "Set whether the plugin is enabled.",
                    "type": "boolean",
                    "default": true
                  },
                  "localServices": {
                    "description": "List local services that the plugin manages.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "_uniqueItems": true
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "plugins-object": {
      "$ref": "#/$defs/modern_2"
    },
    "plugins-array": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/plugins-array-item"
          }
        ]
      }
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "JSON Schema for droplit-edge localsettings",
              "type": "object",
              "properties": {
                "ecosystemId": {
                  "description": "The Ecosystem associated with this Edge device. May be omitted if Ecosystem is determined via the claims process.",
                  "type": "string"
                },
                "plugins": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/plugins-object"
                    },
                    {
                      "$ref": "#/$defs/plugins-array"
                    }
                  ]
                },
                "config": {
                  "$ref": "#/$defs/modern_4"
                },
                "debug": {
                  "$ref": "#/$defs/modern_5"
                },
                "transport": {
                  "$ref": "#/$defs/modern_6"
                },
                "diagnostics": {
                  "$ref": "#/$defs/modern_7"
                },
                "environmentId": {
                  "description": "The Environment associated with this Edge device. Specifying this allows for multiple Edge devices within the same environment.",
                  "type": "string"
                },
                "router": {
                  "$ref": "#/$defs/modern_8"
                }
              },
              "default": {},
              "required": [
                "transport"
              ]
            },
            {
              "patternProperties": {
                "^debug$": true,
                "^plugins$": true,
                "^router$": true,
                "^environmentId$": true,
                "^transport$": true,
                "^ecosystemId$": true,
                "^config$": true,
                "^diagnostics$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configures miscellaneous capabilities.",
              "type": "object",
              "properties": {
                "LinuxNetInterfaceOverride": {
                  "description": "Override the Linux network interface",
                  "type": "string"
                },
                "MACAddressOverride": {
                  "description": "Override the MAC address used as the Edge Id.",
                  "type": "string"
                },
                "provisioningServiceEnabled": {
                  "description": "Enables the network provisioning service.",
                  "type": "boolean"
                },
                "provisioningServicePort": {
                  "description": "Set the port used for network provisioning.",
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 65536.0,
                  "default": 81
                }
              }
            },
            {
              "patternProperties": {
                "^LinuxNetInterfaceOverride$": true,
                "^MACAddressOverride$": true,
                "^provisioningServiceEnabled$": true,
                "^provisioningServicePort$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "plugins-array-item": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Configures the Edge router layer.",
              "type": "object",
              "properties": {
                "autodiscover": {
                  "description": "Whether or not autodiscover should be enabled.",
                  "type": "boolean"
                },
                "autodiscoverCadence": {
                  "description": "The amount of time (in ms) between discovery invocations.",
                  "type": "integer",
                  "minimum": 0.0
                }
              }
            },
            {
              "patternProperties": {
                "^autodiscover$": true,
                "^autodiscoverCadence$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
