{
  "$id": "https://mcda.drugis.org/dataSource.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "MCDA problem schema",
              "description": "MCDA dataSource schema for uploaded JSON",
              "type": "object",
              "required": [
                "id",
                "unitOfMeasurement",
                "scale"
              ],
              "properties": {
                "source": {
                  "description": "Where the data comes from",
                  "type": "string"
                },
                "strengthOfEvidence": {
                  "description": "Strengths of the data",
                  "type": "string"
                },
                "sourceLink": {
                  "description": "Link to the source",
                  "type": "string"
                },
                "scale": {
                  "description": "The minimum and maximum values the data can have",
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "oneOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "id": {
                  "description": "identifier of the data source",
                  "type": "string"
                },
                "pvf": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_2"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "unitOfMeasurement": {
                  "$ref": "#/$defs/modern_3"
                },
                "uncertainties": {
                  "description": "Uncertainties about the data",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^unitOfMeasurement$": true,
                "^uncertainties$": true,
                "^id$": true,
                "^strengthOfEvidence$": true,
                "^sourceLink$": true,
                "^source$": true,
                "^scale$": true,
                "^pvf$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The partial value function",
              "type": "object",
              "required": [
                "direction",
                "type",
                "range"
              ],
              "properties": {
                "direction": {
                  "type": "string",
                  "enum": [
                    "increasing",
                    "decreasing"
                  ]
                },
                "cutoffs": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "range": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "number"
                  }
                },
                "values": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "piecewise-linear"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^range$": true,
                "^cutoffs$": true,
                "^direction$": true,
                "^type$": true,
                "^values$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type",
                "label"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "custom",
                    "percentage",
                    "decimal"
                  ]
                },
                "label": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^label$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
