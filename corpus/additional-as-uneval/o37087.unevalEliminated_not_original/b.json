{
  "$id": "https://mcda.drugis.org/emptyPerformance.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "MCDA empty performance for the performance table entry of absolute data",
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "empty"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
