{
  "$id": "https://mcda.drugis.org/eventsSampleSizeEffect.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "MCDA events, sample size effect for the performance table entry of absolute data",
              "type": "object",
              "required": [
                "type",
                "value",
                "input"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "exact"
                  ]
                },
                "value": {
                  "type": "number"
                },
                "input": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^input$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "events",
                "sampleSize"
              ],
              "properties": {
                "events": {
                  "type": "number"
                },
                "sampleSize": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^events$": true,
                "^sampleSize$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
