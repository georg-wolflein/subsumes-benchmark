{
  "$id": "https://mcda.drugis.org/normalDistribution.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "MCDA normal distribution for the performance table entry of absolute data",
              "type": "object",
              "required": [
                "type",
                "parameters"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "dnorm"
                  ]
                },
                "parameters": {
                  "$ref": "#/$defs/modern_2"
                },
                "input": {
                  "$ref": "#/$defs/modern_3"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^parameters$": true,
                "^input$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "mu",
                "sigma"
              ],
              "properties": {
                "mu": {
                  "type": "number"
                },
                "sigma": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^mu$": true,
                "^sigma$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "lowerBound": {
                  "type": "number"
                },
                "stdErr": {
                  "type": "number"
                },
                "scale": {
                  "type": "string",
                  "enum": [
                    "percentage",
                    "decimal"
                  ]
                },
                "sigma": {
                  "type": "number"
                },
                "upperBound": {
                  "type": "number"
                },
                "sampleSize": {
                  "type": "number"
                },
                "mu": {
                  "type": "number"
                },
                "value": {
                  "type": "number"
                },
                "events": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^sigma$": true,
                "^events$": true,
                "^scale$": true,
                "^stdErr$": true,
                "^lowerBound$": true,
                "^value$": true,
                "^upperBound$": true,
                "^mu$": true,
                "^sampleSize$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
