{
  "$id": "https://mcda.drugis.org/rangeDistribution.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "MCDA range distribution for the performance table entry of absolute data",
              "type": "object",
              "required": [
                "type",
                "parameters"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "range"
                  ]
                },
                "parameters": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^parameters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "lowerBound",
                "upperBound"
              ],
              "properties": {
                "lowerBound": {
                  "type": "number"
                },
                "upperBound": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^lowerBound$": true,
                "^upperBound$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
