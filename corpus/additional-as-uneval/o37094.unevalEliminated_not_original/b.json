{
  "$id": "https://mcda.drugis.org/relativeEntry.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCDA performance table entry for relative data",
  "type": "object",
  "required": [
    "criterion",
    "dataSource",
    "performance"
  ],
  "properties": {
    "criterion": {
      "type": "string"
    },
    "dataSource": {
      "type": "string"
    },
    "performance": {
      "type": "object",
      "required": [
        "distribution"
      ],
      "properties": {
        "distribution": {
          "type": "object",
          "required": [
            "type",
            "parameters"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "relative-identity-normal",
                "relative-logit-normal",
                "relative-log-normal",
                "relative-cloglog-normal",
                "relative-smd-normal",
                "relative-normal",
                "relative-survival"
              ]
            },
            "parameters": {
              "type": "object",
              "required": [
                "baseline",
                "relative"
              ],
              "properties": {
                "baseline": {
                  "$ref": "#/$defs/modern_1"
                },
                "relative": {
                  "type": "object",
                  "required": [
                    "mu",
                    "cov",
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "dmnorm"
                      ]
                    },
                    "mu": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "cov": {
                      "type": "object",
                      "required": [
                        "colnames",
                        "rownames",
                        "data"
                      ],
                      "properties": {
                        "colnames": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "rownames": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type",
                "name"
              ],
              "properties": {
                "alpha": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "stdErr": {
                  "type": "number"
                },
                "summaryMeasure": {
                  "type": "string",
                  "enum": [
                    "none",
                    "median",
                    "mean",
                    "survivalAtTime"
                  ]
                },
                "mean": {
                  "type": "number"
                },
                "survivalAtTime": {
                  "type": "number"
                },
                "sigma": {
                  "type": "number"
                },
                "beta": {
                  "type": "number"
                },
                "property": {
                  "type": "string",
                  "enum": [
                    "log odds ratio",
                    "mean difference",
                    "log hazard ratio"
                  ]
                },
                "mu": {
                  "type": "number"
                },
                "scale": {
                  "type": "string",
                  "enum": [
                    "mean difference",
                    "hazard ratio",
                    "hazard",
                    "log odds",
                    "mean"
                  ]
                },
                "distribution": {
                  "type": "string",
                  "enum": [
                    "Normal",
                    "Beta",
                    "Gamma"
                  ]
                },
                "dof": {
                  "type": "number"
                },
                "std.err": {
                  "type": "number"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "dnorm",
                    "dsurv",
                    "dbeta-logit",
                    "dbeta-cloglog",
                    "dt",
                    "identity",
                    "logit",
                    "log",
                    "cloglog",
                    "smd"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^distribution$": true,
                "^std.err$": true,
                "^mu$": true,
                "^property$": true,
                "^stdErr$": true,
                "^survivalAtTime$": true,
                "^title$": true,
                "^dof$": true,
                "^summaryMeasure$": true,
                "^sigma$": true,
                "^scale$": true,
                "^name$": true,
                "^mean$": true,
                "^type$": true,
                "^alpha$": true,
                "^beta$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "number"
              }
            }
          ]
        }
      ]
    }
  }
}
