{
  "$id": "https://mcda.drugis.org/tDistribution.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCDA student's t distribution for the performance table entry of absolute data",
  "type": "object",
  "required": [
    "type",
    "parameters"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "dt"
      ]
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mu",
        "stdErr",
        "dof"
      ],
      "properties": {
        "mu": {
          "type": "number"
        },
        "stdErr": {
          "type": "number"
        },
        "dof": {
          "type": "number"
        }
      }
    },
    "input": {
      "type": "object",
      "required": [
        "mu",
        "sigma",
        "sampleSize"
      ],
      "additionalProperties": false,
      "properties": {
        "mu": {
          "type": "number"
        },
        "sigma": {
          "type": "number"
        },
        "sampleSize": {
          "type": "number"
        }
      }
    }
  }
}
