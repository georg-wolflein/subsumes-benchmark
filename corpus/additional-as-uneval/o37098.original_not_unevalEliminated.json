{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o37098.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o37098.unevalEliminated_not_original.json"
  ],
  "a": {
    "$id": "https://mcda.drugis.org/valueEffect.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "MCDA value effect for the performance table entry of absolute data",
                "type": "object",
                "required": [
                  "type",
                  "value"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "exact"
                    ]
                  },
                  "value": {
                    "type": "number"
                  },
                  "input": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^value$": true,
                  "^input$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "string",
                    "enum": [
                      "percentage",
                      "decimal"
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^value$": true,
                  "^scale$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://mcda.drugis.org/valueEffect.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "MCDA value effect for the performance table entry of absolute data",
    "type": "object",
    "required": [
      "type",
      "value"
    ],
    "additionalProperties": false,
    "properties": {
      "type": {
        "type": "string",
        "enum": [
          "exact"
        ]
      },
      "value": {
        "type": "number"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "number"
          },
          "scale": {
            "type": "string",
            "enum": [
              "percentage",
              "decimal"
            ]
          }
        }
      }
    }
  }
}
