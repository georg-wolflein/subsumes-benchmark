{
  "$id": "https://mcda.drugis.org/valueEffect.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCDA value effect for the performance table entry of absolute data",
  "type": "object",
  "required": [
    "type",
    "value"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "exact"
      ]
    },
    "value": {
      "type": "number"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number"
        },
        "scale": {
          "type": "string",
          "enum": [
            "percentage",
            "decimal"
          ]
        }
      }
    }
  }
}
