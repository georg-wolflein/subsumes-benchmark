{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minItems",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o37615.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o37615.unevalEliminated_not_original.json"
  ],
  "a": {
    "$id": "https://www.yacpdb.org/schemas/yacpdb-tourney.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "$ref": "#/$defs/text"
                  },
                  "comments": {
                    "$ref": "#/$defs/text_list"
                  }
                },
                "required": [
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^comments$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "text": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      },
      "text_list": {
        "type": "array",
        "elements": {
          "$ref": "#/$defs/text"
        },
        "minItems": 1,
        "_uniqueItems": true
      }
    }
  },
  "b": {
    "$id": "https://www.yacpdb.org/schemas/yacpdb-tourney.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "$ref": "#/$defs/text"
      },
      "comments": {
        "$ref": "#/$defs/text_list"
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false,
    "$defs": {
      "text": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      },
      "text_list": {
        "type": "array",
        "elements": {
          "$ref": "#/$defs/text"
        },
        "minItems": 1,
        "_uniqueItems": true
      }
    }
  }
}
