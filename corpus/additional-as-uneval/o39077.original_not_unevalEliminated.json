{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "const",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o39077.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Retrive attributes of arukas.",
                "properties": {
                  "token": {
                    "description": "Can be set through ARUKAS_JSON_API_TOKEN env.",
                    "type": "string"
                  },
                  "attr": {
                    "description": "Attribute name to fetch, only support host now.",
                    "enum": [
                      "host"
                    ],
                    "type": "string"
                  },
                  "$schema": {
                    "type": "string"
                  },
                  "$tool": {
                    "const": "arukas",
                    "description": "Must be set to arukas",
                    "type": "string"
                  },
                  "secret": {
                    "description": "Can be set through ARUKAS_JSON_API_SECRET env.",
                    "type": "string"
                  }
                },
                "required": [
                  "$tool",
                  "attr"
                ],
                "title": "arukas Config",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schema$": true,
                  "^secret$": true,
                  "^attr$": true,
                  "^$tool$": true,
                  "^token$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Retrive attributes of arukas.",
    "properties": {
      "$schema": {
        "type": "string"
      },
      "$tool": {
        "const": "arukas",
        "description": "Must be set to arukas",
        "type": "string"
      },
      "attr": {
        "description": "Attribute name to fetch, only support host now.",
        "enum": [
          "host"
        ],
        "type": "string"
      },
      "secret": {
        "description": "Can be set through ARUKAS_JSON_API_SECRET env.",
        "type": "string"
      },
      "token": {
        "description": "Can be set through ARUKAS_JSON_API_TOKEN env.",
        "type": "string"
      }
    },
    "required": [
      "$tool",
      "attr"
    ],
    "title": "arukas Config",
    "type": "object"
  }
}
