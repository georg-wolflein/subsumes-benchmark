{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "const",
    "items",
    "minItems",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o39084.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39084.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "replace-in-file options.",
                "properties": {
                  "$tool": {
                    "const": "replace-in-file",
                    "description": "Must be set to replace-in-file",
                    "type": "string"
                  },
                  "encoding": {
                    "description": "Character encoding for reading/writing files (defaults to utf-8).",
                    "type": "string"
                  },
                  "files": {
                    "oneOf": [
                      {
                        "description": "File(glob) to proccess.",
                        "type": "string"
                      },
                      {
                        "description": "Files(glob) to proccess.",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      }
                    ]
                  },
                  "to": {
                    "description": "Multiple replacements with same/different strings (replaced sequentially).",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "items": {
                          "type": "string"
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    ]
                  },
                  "from": {
                    "description": "RegExp(s) to find from files.",
                    "oneOf": [
                      {
                        "instanceof": "RegExp"
                      },
                      {
                        "preproccess": "regexp",
                        "type": "string"
                      },
                      {
                        "items": {
                          "oneOf": [
                            {
                              "instanceof": "RegExp"
                            },
                            {
                              "preproccess": "regexp",
                              "type": "string"
                            }
                          ]
                        },
                        "minItems": 1,
                        "type": "array"
                      }
                    ]
                  },
                  "$schema": {
                    "type": "string"
                  },
                  "allowEmptyPaths": {
                    "description": "Specify if empty/invalid file paths are allowed (defaults to false). If set to true these paths will fail silently and no error will be thrown.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "$tool",
                  "files",
                  "from",
                  "to"
                ],
                "title": "replace-in-file Config",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schema$": true,
                  "^to$": true,
                  "^allowEmptyPaths$": true,
                  "^from$": true,
                  "^encoding$": true,
                  "^files$": true,
                  "^$tool$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "replace-in-file options.",
    "properties": {
      "$schema": {
        "type": "string"
      },
      "$tool": {
        "const": "replace-in-file",
        "description": "Must be set to replace-in-file",
        "type": "string"
      },
      "allowEmptyPaths": {
        "description": "Specify if empty/invalid file paths are allowed (defaults to false). If set to true these paths will fail silently and no error will be thrown.",
        "type": "boolean"
      },
      "encoding": {
        "description": "Character encoding for reading/writing files (defaults to utf-8).",
        "type": "string"
      },
      "files": {
        "oneOf": [
          {
            "description": "File(glob) to proccess.",
            "type": "string"
          },
          {
            "description": "Files(glob) to proccess.",
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "from": {
        "description": "RegExp(s) to find from files.",
        "oneOf": [
          {
            "instanceof": "RegExp"
          },
          {
            "preproccess": "regexp",
            "type": "string"
          },
          {
            "items": {
              "oneOf": [
                {
                  "instanceof": "RegExp"
                },
                {
                  "preproccess": "regexp",
                  "type": "string"
                }
              ]
            },
            "minItems": 1,
            "type": "array"
          }
        ]
      },
      "to": {
        "description": "Multiple replacements with same/different strings (replaced sequentially).",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        ]
      }
    },
    "required": [
      "$tool",
      "files",
      "from",
      "to"
    ],
    "title": "replace-in-file Config",
    "type": "object"
  }
}
