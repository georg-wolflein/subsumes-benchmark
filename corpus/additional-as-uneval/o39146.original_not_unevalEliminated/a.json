{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "circularReference"
              ],
              "properties": {
                "circularReference": {
                  "$ref": "#/$defs/exception"
                }
              }
            },
            {
              "patternProperties": {
                "^circularReference$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "exception": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "causedBy": {
          "$ref": "#/$defs/maybeCircularException"
        },
        "at": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "suppressed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/maybeCircularException"
          }
        }
      }
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "statusCode",
                "reasonPhrase"
              ],
              "properties": {
                "statusCode": {
                  "type": "integer"
                },
                "stackTrace": {
                  "$ref": "#/$defs/exception"
                },
                "reasonPhrase": {
                  "type": "string"
                },
                "details": true,
                "message": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^statusCode$": true,
                "^message$": true,
                "^stackTrace$": true,
                "^details$": true,
                "^reasonPhrase$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "maybeCircularException": {
      "oneOf": [
        {
          "$ref": "#/$defs/exception"
        },
        {
          "$ref": "#/$defs/circularReference"
        }
      ]
    },
    "circularReference": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
