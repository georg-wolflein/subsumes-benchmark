{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "privacyStatements"
              ],
              "properties": {
                "privacyStatements": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "issuedDate"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "issuedDate": {
                        "type": "string",
                        "format": "date"
                      }
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^privacyStatements$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
