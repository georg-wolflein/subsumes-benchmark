{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "minItems",
    "minProperties",
    "minimum",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o3920.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o3920.unevalEliminated_not_original.json"
  ],
  "a": {
    "$id": "http://www.cornutum.org/tcases/generators-schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_4",
    "$defs": {
      "tupleGenerator": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Defines tuple combinations for a set of variables",
                "type": "object",
                "minProperties": 1,
                "properties": {
                  "tuples": {
                    "type": "integer",
                    "minimum": 0.0
                  },
                  "include": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "exclude": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "once": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_3"
                    },
                    "minItems": 1
                  }
                }
              },
              {
                "patternProperties": {
                  "^tuples$": true,
                  "^include$": true,
                  "^exclude$": true,
                  "^once$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "minProperties": 1
              },
              {
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "System Test Coverage Model",
                "description": "Defines the test coverage generators for a system (version: ${project.version})",
                "type": "object"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/tupleGenerator"
                }
              }
            ]
          }
        ]
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Defines a tuple coverage generator",
                "type": "object",
                "properties": {
                  "tuples": {
                    "type": "integer",
                    "minimum": 0.0
                  },
                  "seed": {
                    "type": "integer"
                  },
                  "combiners": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/combiner"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^tuples$": true,
                  "^seed$": true,
                  "^combiners$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "combiner": {
        "$ref": "#/$defs/modern_2"
      }
    }
  },
  "b": {
    "$id": "http://www.cornutum.org/tcases/generators-schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "System Test Coverage Model",
    "description": "Defines the test coverage generators for a system (version: ${project.version})",
    "type": "object",
    "additionalProperties": {
      "$ref": "#/$defs/tupleGenerator"
    },
    "$defs": {
      "tupleGenerator": {
        "description": "Defines a tuple coverage generator",
        "type": "object",
        "properties": {
          "tuples": {
            "type": "integer",
            "minimum": 0
          },
          "seed": {
            "type": "integer"
          },
          "combiners": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/combiner"
            }
          }
        },
        "additionalProperties": false
      },
      "combiner": {
        "description": "Defines tuple combinations for a set of variables",
        "type": "object",
        "minProperties": 1,
        "properties": {
          "tuples": {
            "type": "integer",
            "minimum": 0
          },
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "once": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "minProperties": 1
            },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}
