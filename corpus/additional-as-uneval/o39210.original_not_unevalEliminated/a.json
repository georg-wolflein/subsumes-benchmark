{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_18",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "not": {
                  "type": "object",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/conditionDefinition"
                    },
                    {
                      "$ref": "#/$defs/conditionSetInvokerDefinition"
                    },
                    {
                      "$ref": "#/$defs/logicalConditionDefinition"
                    }
                  ]
                }
              },
              "required": [
                "not"
              ]
            },
            {
              "patternProperties": {
                "^not$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "validityValue": {
                  "description": "When usage is 'timeout', after a timeout (specified in minutes in validityValue), the node will be disabled",
                  "type": "integer",
                  "minimum": 0.0
                },
                "name": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                },
                "conditionDescriptor": {
                  "$ref": "#/$defs/conditionDescriptorDefinition"
                },
                "usage": {
                  "type": "string",
                  "enum": [
                    "always",
                    "timeout",
                    "hitCount",
                    "disabled"
                  ],
                  "default": "always"
                },
                "responseDescriptor": {
                  "$ref": "#/$defs/responseDescriptorDefinition"
                },
                "comment": {
                  "$ref": "#/$defs/commentDefinition"
                }
              },
              "required": [
                "name",
                "conditionDescriptor",
                "responseDescriptor"
              ]
            },
            {
              "patternProperties": {
                "^validityValue$": true,
                "^name$": true,
                "^comment$": true,
                "^conditionDescriptor$": true,
                "^usage$": true,
                "^responseDescriptor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Describes a single response message template",
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                },
                "type": {
                  "description": "Type of the resource. In case of text, it is embedded (resource contains the value), other case (*file) name of the file",
                  "type": "string",
                  "enum": [
                    "xml",
                    "text",
                    "html",
                    "json",
                    "xmlFile",
                    "textFile",
                    "htmlFile",
                    "jsonFile",
                    "external"
                  ]
                },
                "resource": {
                  "description": "Resource is always a String - meaning depends on the type, for example if that is 'external', then resource is a class name",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "type",
                "resource"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^type$": true,
                "^resource$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "templateDefinition": {
      "$ref": "#/$defs/modern_1"
    },
    "responseDescriptorDefinition": {
      "$ref": "#/$defs/modern_2"
    },
    "responseFormatterSetsArrayDefinition": {
      "description": "Array of response Formatter sets.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/responseFormatterSetsDefinition"
      },
      "minItems": 1,
      "maxItems": 25
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Set of conditions",
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                },
                "conditionDescriptor": {
                  "$ref": "#/$defs/conditionDescriptorDefinition"
                }
              },
              "required": [
                "name",
                "conditionDescriptor"
              ],
              "minItems": 1
            },
            {
              "patternProperties": {
                "^name$": true,
                "^conditionDescriptor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                },
                "conditionDescriptor": {
                  "$ref": "#/$defs/conditionDescriptorDefinition"
                },
                "dialogDescriptorNames": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  },
                  "minItems": 1,
                  "maxItems": 50
                },
                "class": {
                  "$ref": "#/$defs/classNameDefinition"
                },
                "timeout": {
                  "description": "Timeout in milliseconds",
                  "type": "integer"
                },
                "parameters": {
                  "$ref": "#/$defs/parameterDefinition"
                }
              },
              "required": [
                "name",
                "class"
              ]
            },
            {
              "patternProperties": {
                "^timeout$": true,
                "^name$": true,
                "^class$": true,
                "^conditionDescriptor$": true,
                "^parameters$": true,
                "^dialogDescriptorNames$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "and": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/conditionDefinition"
                      },
                      {
                        "$ref": "#/$defs/conditionSetInvokerDefinition"
                      },
                      {
                        "$ref": "#/$defs/logicalConditionDefinition"
                      }
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "and"
              ]
            },
            {
              "patternProperties": {
                "^and$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "responseFormatterSetsDefinition": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Response formatter",
              "type": "object",
              "properties": {
                "responseFormatter": {
                  "$ref": "#/$defs/modern_12"
                }
              },
              "required": [
                "responseFormatter"
              ]
            },
            {
              "patternProperties": {
                "^responseFormatter$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Describes a single condition that should be evaluated, its result is a boolean value",
              "type": "object",
              "properties": {
                "condition": {
                  "$ref": "#/$defs/modern_15"
                }
              },
              "required": [
                "condition"
              ]
            },
            {
              "patternProperties": {
                "^condition$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "conditionArrayDefinition": {
      "description": "Array of conditions.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/conditionDefinition"
      },
      "minItems": 1,
      "maxItems": 25
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "templateArrayDefinition": {
      "description": "Array of templates.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/templateDefinition"
      },
      "minItems": 1,
      "maxItems": 50
    },
    "conditionSetDefinition": {
      "$ref": "#/$defs/modern_8"
    },
    "interceptorDefinition": {
      "description": "Interceptors",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "description": "The name of the interceptor",
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "class": {
            "description": "The name of the interceptor class, will be used to load the class itself",
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "parameters": {
            "$ref": "#/$defs/parameterDefinition"
          }
        },
        "required": [
          "name",
          "class"
        ]
      },
      "minItems": 1
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Object that holds a condition set invoker",
              "type": "object",
              "properties": {
                "conditionSetInvoker": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                }
              },
              "required": [
                "conditionSetInvoker"
              ]
            },
            {
              "patternProperties": {
                "^conditionSetInvoker$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "$ref": "#/$defs/classNameDefinition"
                },
                "negate": {
                  "type": "boolean",
                  "default": false
                },
                "parameters": {
                  "$ref": "#/$defs/parameterDefinition"
                }
              },
              "required": [
                "class"
              ]
            },
            {
              "patternProperties": {
                "^class$": true,
                "^negate$": true,
                "^parameters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "sequenceDescriptorsDefinition": {
      "description": "Sequence Descriptor Array",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_9"
      },
      "minItems": 1,
      "maxItems": 25
    },
    "conditionDescriptorDefinition": {
      "description": "Describes a complex condition which should be evaluated by the switch engine",
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/conditionDefinition"
        },
        {
          "$ref": "#/$defs/conditionSetInvokerDefinition"
        },
        {
          "$ref": "#/$defs/logicalConditionDefinition"
        }
      ]
    },
    "responseFormatterDefinition": {
      "$ref": "#/$defs/modern_11"
    },
    "responseFormatterSetArrayDefinition": {
      "description": "Describes the formatter method(s) applied on the specific response",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/responseFormatterDefinition"
          },
          {
            "$ref": "#/$defs/responseFormatterSetInvokerDefinition"
          }
        ]
      },
      "minItems": 1,
      "maxItems": 25
    },
    "responseFormatterSetInvokerDefinition": {
      "$ref": "#/$defs/modern_13"
    },
    "commentDefinition": {
      "description": "Object that hold an optional comment text",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "conditionDefinition": {
      "$ref": "#/$defs/modern_14"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An array of response formatter sets",
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                },
                "responseFormatterSet": {
                  "$ref": "#/$defs/responseFormatterSetArrayDefinition"
                }
              },
              "required": [
                "name",
                "responseFormatterSet"
              ],
              "minItems": 1
            },
            {
              "patternProperties": {
                "^name$": true,
                "^responseFormatterSet$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "conditionSetInvokerDefinition": {
      "$ref": "#/$defs/modern_16"
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Every parameter in the list has a name-value string pair.",
              "type": "object",
              "properties": {
                "name": {
                  "description": "",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "value": {
                  "description": "",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "name",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Describes what answer should be sent back, and in case a template is used, what method should be used to make it up-to-date",
              "type": "object",
              "properties": {
                "delay": {
                  "description": "Optional, default value is 0, delay of the response in seconds, 0 means no delay",
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0
                },
                "sequenceDescriptorName": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                },
                "templateName": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                },
                "responseFormatterSet": {
                  "$ref": "#/$defs/responseFormatterSetArrayDefinition"
                },
                "mimeType": {
                  "description": "Describes the response content type",
                  "type": "string"
                },
                "code": {
                  "description": "Optional, response code, default value is 200 (here E500 and others can be specified)",
                  "type": "integer",
                  "default": 200,
                  "minimum": 200.0
                }
              },
              "required": [
                "mimeType",
                "templateName"
              ]
            },
            {
              "patternProperties": {
                "^code$": true,
                "^templateName$": true,
                "^responseFormatterSet$": true,
                "^delay$": true,
                "^mimeType$": true,
                "^sequenceDescriptorName$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "$ref": "#/$defs/classNameDefinition"
                },
                "parameters": {
                  "$ref": "#/$defs/parameterDefinition"
                }
              },
              "required": [
                "class"
              ]
            },
            {
              "patternProperties": {
                "^class$": true,
                "^parameters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "logicalConditionDefinition": {
      "description": "Logical evaluation on condition(s), like 'and', 'or', and 'not'",
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/modern_3"
        },
        {
          "$ref": "#/$defs/modern_4"
        },
        {
          "$ref": "#/$defs/modern_5"
        }
      ]
    },
    "modern_18": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Representation of Wilma stub configuration possibilities",
              "type": "object",
              "properties": {
                "wilmaStubConfiguration": {
                  "$ref": "#/$defs/modern_19"
                }
              },
              "required": [
                "wilmaStubConfiguration"
              ]
            },
            {
              "patternProperties": {
                "^wilmaStubConfiguration$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "dialogDescriptorsDefinition": {
      "description": "Dialog Descriptor Array",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_6"
      },
      "minItems": 1,
      "maxItems": 25
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Object that holds a response formatter set invoker",
              "type": "object",
              "properties": {
                "responseFormatterSetInvoker": {
                  "$ref": "#/$defs/uniqueNameDefinition"
                }
              },
              "required": [
                "responseFormatterSetInvoker"
              ]
            },
            {
              "patternProperties": {
                "^responseFormatterSetInvoker$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "parameterDefinition": {
      "description": "Parameter list of a specific object (like: interceptor, condition descriptor etc).",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_17"
      },
      "minItems": 1,
      "maxItems": 25
    },
    "uniqueNameDefinition": {
      "description": "Object that hold a name of the object, and in the case object is in an array, its name is unique",
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "classNameDefinition": {
      "description": "Class name object",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "conditionSetArrayDefinition": {
      "description": "Array of condition sets.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/conditionSetDefinition"
      },
      "minItems": 1,
      "maxItems": 25
    },
    "modern_19": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "sequenceDescriptors": {
                  "$ref": "#/$defs/sequenceDescriptorsDefinition"
                },
                "responseFormatterSets": {
                  "$ref": "#/$defs/responseFormatterSetsArrayDefinition"
                },
                "interceptors": {
                  "$ref": "#/$defs/interceptorDefinition"
                },
                "conditionSets": {
                  "$ref": "#/$defs/conditionSetArrayDefinition"
                },
                "templates": {
                  "$ref": "#/$defs/templateArrayDefinition"
                },
                "groupName": {
                  "description": "The name of the Stub Configuration, if it is missing, the name will be considered as: 'Default'",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "default": "Default"
                },
                "dialogDescriptors": {
                  "$ref": "#/$defs/dialogDescriptorsDefinition"
                },
                "active": {
                  "description": "Whether the Stub Configuration is active or not, by default: true",
                  "type": "boolean",
                  "default": true
                }
              }
            },
            {
              "patternProperties": {
                "^dialogDescriptors$": true,
                "^conditionSets$": true,
                "^interceptors$": true,
                "^sequenceDescriptors$": true,
                "^templates$": true,
                "^groupName$": true,
                "^active$": true,
                "^responseFormatterSets$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "or": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/conditionDefinition"
                      },
                      {
                        "$ref": "#/$defs/conditionSetInvokerDefinition"
                      },
                      {
                        "$ref": "#/$defs/logicalConditionDefinition"
                      }
                    ]
                  },
                  "minItems": 1
                }
              },
              "required": [
                "or"
              ]
            },
            {
              "patternProperties": {
                "^or$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
