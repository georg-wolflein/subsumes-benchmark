{
  "$id": "http://www.cornutum.org/tcases/moco-test-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines access to certificate data",
              "type": "object",
              "properties": {
                "file": {
                  "description": "Path to a file containing certificate data",
                  "type": "string"
                },
                "resource": {
                  "description": "Path to a resource containing certificate data",
                  "type": "string"
                }
              },
              "minProperties": 1,
              "maxProperties": 1
            },
            {
              "patternProperties": {
                "^file$": true,
                "^resource$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Moco Server Test Configuration",
              "description": "Defines how tests created by a MocoServerTestWriter will access a Moco server (version: ${project.version})",
              "type": "object",
              "properties": {
                "server": {
                  "description": "Defines the Moco server type",
                  "type": "string",
                  "enum": [
                    "HttpServer",
                    "HttpsServer",
                    "RestServer",
                    "SocketServer"
                  ]
                },
                "runner": {
                  "$ref": "#/$defs/modern_2"
                },
                "certificate": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "required": [
                "server",
                "runner"
              ]
            },
            {
              "patternProperties": {
                "^server$": true,
                "^runner$": true,
                "^certificate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines how the Moco server runner will be configured in generated tests",
              "type": "object",
              "properties": {
                "name": {
                  "description": "For POJO configurations, the name of the Moco server variable",
                  "default": "mocoServer",
                  "type": "string"
                },
                "port": {
                  "description": "The Moco server port",
                  "default": "12306",
                  "type": "integer"
                },
                "eachTest": {
                  "description": "If true, (re)starts a Moco server for each test method. Otherwise, (re)starts once per test class",
                  "default": "false",
                  "type": "boolean"
                },
                "config": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "config"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^port$": true,
                "^eachTest$": true,
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines the source of the Moco server configuration",
              "type": "object",
              "properties": {
                "file": {
                  "description": "Path to a file containing the Moco server configuration",
                  "type": "string"
                },
                "resource": {
                  "description": "Path to a resource containing the Moco server configuration",
                  "type": "string"
                },
                "pojoWriterFactory": {
                  "description": "Fully-qualified class name for a MocoServerConfigPojo.PojoWriterFactory implementation",
                  "type": "string"
                }
              },
              "minProperties": 1,
              "maxProperties": 1
            },
            {
              "patternProperties": {
                "^file$": true,
                "^resource$": true,
                "^pojoWriterFactory$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines how an HttpsCertificate will be configured in generated tests",
              "type": "object",
              "properties": {
                "name": {
                  "description": "The name of the HttpsCertificate variable",
                  "default": "DEFAULT_CERTIFICATE",
                  "type": "string"
                },
                "keyStorePassword": {
                  "description": "The key store password",
                  "type": "string"
                },
                "certPassword": {
                  "description": "The certificate password",
                  "type": "string"
                },
                "config": {
                  "$ref": "#/$defs/modern_5"
                }
              },
              "required": [
                "config",
                "keyStorePassword",
                "certPassword"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^keyStorePassword$": true,
                "^certPassword$": true,
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
