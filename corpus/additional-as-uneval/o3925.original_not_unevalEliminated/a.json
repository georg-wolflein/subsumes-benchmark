{
  "$id": "http://www.cornutum.org/tcases/request-cases-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request Test Cases",
  "description": "Defines test cases for API requests (version: ${project.version})",
  "type": "array",
  "items": {
    "$ref": "#/$defs/requestCase"
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "boolean"
                },
                "value": {
                  "type": "boolean"
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "integer"
                },
                "value": {
                  "type": "integer"
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "parameter": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "string"
                },
                "value": {
                  "type": "string"
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines an API request test case",
              "type": "object",
              "properties": {
                "body": {
                  "$ref": "#/$defs/messageData"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "server": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "api": {
                  "type": "string",
                  "minLength": 1
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/parameter"
                  }
                },
                "invalidInput": {
                  "type": "string",
                  "minLength": 1
                },
                "id": {
                  "type": "integer"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "DELETE",
                    "GET",
                    "HEAD",
                    "OPTIONS",
                    "PATCH",
                    "POST",
                    "PUT",
                    "TRACE"
                  ]
                }
              },
              "required": [
                "id",
                "api",
                "path",
                "operation"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^body$": true,
                "^name$": true,
                "^id$": true,
                "^server$": true,
                "^operation$": true,
                "^path$": true,
                "^invalidInput$": true,
                "^api$": true,
                "^parameters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines an API request parameter value",
              "type": "object",
              "properties": {
                "style": {
                  "type": "string",
                  "enum": [
                    "deepObject",
                    "form",
                    "label",
                    "matrix",
                    "pipeDelimited",
                    "simple",
                    "spaceDelimited"
                  ]
                },
                "data": {
                  "$ref": "#/$defs/dataValue"
                },
                "explode": {
                  "type": "boolean"
                },
                "valid": {
                  "type": "boolean"
                },
                "mediaType": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "in": {
                  "type": "string",
                  "enum": [
                    "cookie",
                    "header",
                    "path",
                    "query"
                  ]
                }
              },
              "required": [
                "name",
                "in",
                "style",
                "data",
                "valid"
              ]
            },
            {
              "patternProperties": {
                "^explode$": true,
                "^style$": true,
                "^in$": true,
                "^mediaType$": true,
                "^name$": true,
                "^valid$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "messageData": {
      "$ref": "#/$defs/modern_3"
    },
    "dataValue": {
      "description": "Defines an input data value",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/modern_4"
        },
        {
          "$ref": "#/$defs/modern_5"
        },
        {
          "$ref": "#/$defs/modern_6"
        },
        {
          "$ref": "#/$defs/modern_7"
        },
        {
          "$ref": "#/$defs/modern_8"
        },
        {
          "$ref": "#/$defs/modern_9"
        },
        {
          "$ref": "#/$defs/modern_10"
        }
      ],
      "required": [
        "type",
        "value"
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "number"
                },
                "value": {
                  "type": "number"
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "object"
                },
                "value": {
                  "type": "object",
                  "patternProperties": {
                    ".": {
                      "$ref": "#/$defs/dataValue"
                    }
                  }
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines the data for an API request input",
              "type": "object",
              "properties": {
                "mediaType": {
                  "type": "string",
                  "minLength": 1
                },
                "data": {
                  "$ref": "#/$defs/dataValue"
                },
                "valid": {
                  "type": "boolean"
                }
              },
              "required": [
                "data",
                "valid"
              ]
            },
            {
              "patternProperties": {
                "^mediaType$": true,
                "^data$": true,
                "^valid$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "array"
                },
                "value": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/dataValue"
                  }
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "null"
                },
                "value": {
                  "type": "null"
                },
                "format": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "requestCase": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
