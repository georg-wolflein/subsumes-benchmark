{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "title"
              ],
              "properties": {
                "id": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "created_at": {
                  "type": "string",
                  "pattern": "\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}"
                },
                "tags": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^title$": true,
                "^created_at$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
