{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39432.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "CommitModel": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "commitId": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              {
                "patternProperties": {
                  "^commitId$": true,
                  "^version$": true,
                  "^createdAt$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "GetAllVersionsResponse",
                "type": "object",
                "properties": {
                  "commits": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/CommitModel"
                    },
                    "description": "All of the commits for a repository"
                  },
                  "latest": {
                    "$ref": "#/$defs/CommitModel"
                  }
                },
                "javaName": "GetAllVersionsResponse"
              },
              {
                "patternProperties": {
                  "^commits$": true,
                  "^latest$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "GetAllVersionsResponse",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "commits": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/CommitModel"
        },
        "description": "All of the commits for a repository"
      },
      "latest": {
        "$ref": "#/$defs/CommitModel"
      }
    },
    "javaName": "GetAllVersionsResponse",
    "$defs": {
      "CommitModel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commitId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
