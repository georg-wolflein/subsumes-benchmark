{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetRepoResponse",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectName": {
      "type": "string"
    },
    "repoName": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PermissionGrant"
      }
    }
  },
  "javaName": "GetRepoResponse",
  "$defs": {
    "PermissionGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "description": "Name of the user to grant the accessLevel to."
        },
        "accessLevel": {
          "type": "string",
          "enum": [
            "NONE",
            "READ",
            "WRITE",
            "ADMIN"
          ],
          "description": "Type of permission to grant access to"
        }
      }
    }
  }
}
