{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "expiresAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^createdAt$": true,
                "^expiresAt$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "GetTokensResponse",
              "type": "object",
              "properties": {
                "tokens": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/TokenEntryModel"
                  }
                }
              },
              "javaName": "GetTokensResponse"
            },
            {
              "patternProperties": {
                "^tokens$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "TokenEntryModel": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
