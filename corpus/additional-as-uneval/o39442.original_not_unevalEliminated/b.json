{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PostUserUpdate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "updates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Details"
      },
      "description": "List of updates to apply to the user."
    }
  },
  "javaName": "PostUserUpdate",
  "$defs": {
    "Details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "USER_NAME",
            "DISPLAY_NAME"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    }
  }
}
