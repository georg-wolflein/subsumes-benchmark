{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "VersionSearchResponse",
              "type": "object",
              "properties": {
                "commitId": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "javaName": "VersionSearchResponse"
            },
            {
              "patternProperties": {
                "^commitId$": true,
                "^version$": true,
                "^createdAt$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
