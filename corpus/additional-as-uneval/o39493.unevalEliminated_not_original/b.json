{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "schema for a product price",
              "properties": {
                "date_thru": {
                  "_format": "date-time",
                  "type": "string"
                },
                "id": {
                  "_format": "uuid",
                  "type": "string"
                },
                "date_from": {
                  "_format": "date-time",
                  "type": "string"
                },
                "type": {
                  "maxLength": 18,
                  "type": "string"
                },
                "is_public": {
                  "type": "boolean",
                  "value": false
                },
                "amount": {
                  "description": "schema for a currency amount",
                  "properties": {
                    "currency": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "units": {
                      "minimum": 0.0,
                      "type": "number"
                    }
                  },
                  "required": [
                    "currency",
                    "units"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "id",
                "type",
                "amount",
                "is_public",
                "date_from",
                "date_thru"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^is_public$": true,
                "^date_from$": true,
                "^type$": true,
                "^id$": true,
                "^amount$": true,
                "^date_thru$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "schema for a currency",
              "properties": {
                "label": {
                  "maxLength": 64,
                  "type": "string"
                },
                "code": {
                  "maxLength": 4,
                  "type": "string"
                },
                "id": {
                  "_format": "uuid",
                  "type": "string"
                },
                "separator": {
                  "properties": {
                    "decimal": {
                      "maxLength": 1,
                      "minLength": 1,
                      "type": "string"
                    },
                    "thousands": {
                      "maxLength": 1,
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "thousands",
                    "decimal"
                  ],
                  "type": "object"
                },
                "prefix": {
                  "maxLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "id",
                "code",
                "label",
                "separator"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^code$": true,
                "^label$": true,
                "^id$": true,
                "^separator$": true,
                "^prefix$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
