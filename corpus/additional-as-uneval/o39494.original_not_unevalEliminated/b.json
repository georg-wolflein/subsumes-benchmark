{
  "$id": "https://raw.githubusercontent.com/eviratec/schema/master/v1/app/client.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "schema for an app client",
  "properties": {
    "app_id": {
      "_format": "uuid",
      "type": "string"
    },
    "id": {
      "_format": "uuid",
      "type": "string"
    },
    "label": {
      "maxLength": 64,
      "type": "string"
    }
  },
  "required": [
    "id",
    "app_id",
    "label"
  ],
  "type": "object"
}
