{
  "$id": "https://raw.githubusercontent.com/eviratec/schema/master/v1/contact/detail.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "schema for a contact detail",
  "properties": {
    "content": {
      "type": "string"
    },
    "date_added": {
      "_format": "date-time",
      "type": "string"
    },
    "id": {
      "_format": "uuid",
      "type": "string"
    },
    "type": {
      "enum": [
        "email_address",
        "phone_number",
        "address"
      ]
    }
  },
  "required": [
    "id",
    "type",
    "content",
    "date_added"
  ],
  "type": "object"
}
