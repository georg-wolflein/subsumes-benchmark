{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "schema for a contact detail",
              "properties": {
                "content": {
                  "type": "string"
                },
                "date_added": {
                  "_format": "date-time",
                  "type": "string"
                },
                "id": {
                  "_format": "uuid",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "email_address",
                    "phone_number",
                    "address"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "content",
                "date_added"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^content$": true,
                "^date_added$": true,
                "^id$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
