{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39500.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "schema for a currency",
                "properties": {
                  "label": {
                    "maxLength": 64,
                    "type": "string"
                  },
                  "code": {
                    "maxLength": 4,
                    "type": "string"
                  },
                  "id": {
                    "_format": "uuid",
                    "type": "string"
                  },
                  "separator": {
                    "properties": {
                      "decimal": {
                        "maxLength": 1,
                        "minLength": 1,
                        "type": "string"
                      },
                      "thousands": {
                        "maxLength": 1,
                        "minLength": 1,
                        "type": "string"
                      }
                    },
                    "required": [
                      "thousands",
                      "decimal"
                    ],
                    "type": "object"
                  },
                  "prefix": {
                    "maxLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "code",
                  "label",
                  "separator"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^code$": true,
                  "^label$": true,
                  "^id$": true,
                  "^separator$": true,
                  "^prefix$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://raw.githubusercontent.com/eviratec/schema/master/v1/currency.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "schema for a currency",
    "properties": {
      "code": {
        "maxLength": 4,
        "type": "string"
      },
      "id": {
        "_format": "uuid",
        "type": "string"
      },
      "label": {
        "maxLength": 64,
        "type": "string"
      },
      "prefix": {
        "maxLength": 1,
        "type": "string"
      },
      "separator": {
        "properties": {
          "decimal": {
            "maxLength": 1,
            "minLength": 1,
            "type": "string"
          },
          "thousands": {
            "maxLength": 1,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "thousands",
          "decimal"
        ],
        "type": "object"
      }
    },
    "required": [
      "id",
      "code",
      "label",
      "separator"
    ],
    "type": "object"
  }
}
