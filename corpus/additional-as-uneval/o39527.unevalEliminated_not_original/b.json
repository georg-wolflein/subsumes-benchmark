{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Text Input",
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "textinput"
                  ],
                  "options": {
                    "hidden": true
                  }
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "id"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Image",
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "image"
                  ],
                  "options": {
                    "hidden": true
                  }
                },
                "path": {
                  "type": "string",
                  "description": "Just enter the unique filename here. Later you have to upload the image in the images section that you'll find on the dashboard."
                }
              },
              "required": [
                "type",
                "path"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^path$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Survey",
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "pages": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "options": {
                    "disable_collapse": true
                  }
                }
              },
              "required": [
                "title",
                "pages"
              ],
              "options": {
                "disable_collapse": true,
                "disable_properties": true
              }
            },
            {
              "patternProperties": {
                "^title$": true,
                "^pages$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Multiple Choice",
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "multiplechoice"
                  ],
                  "options": {
                    "hidden": true
                  }
                },
                "id": {
                  "type": "string"
                },
                "answers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                }
              },
              "required": [
                "type",
                "id",
                "answers"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^id$": true,
                "^answers$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Page",
              "type": "object",
              "properties": {
                "actions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [
                    "continue"
                  ],
                  "options": {
                    "collapsed": true
                  }
                },
                "timelimit": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_3"
                    },
                    {
                      "title": "None",
                      "type": "null"
                    }
                  ],
                  "default": null
                },
                "items": {
                  "type": "array",
                  "items": {
                    "title": "Page Item",
                    "type": "object",
                    "oneOf": [
                      {
                        "$ref": "#/$defs/modern_4"
                      },
                      {
                        "$ref": "#/$defs/modern_5"
                      },
                      {
                        "$ref": "#/$defs/modern_6"
                      },
                      {
                        "$ref": "#/$defs/modern_7"
                      },
                      {
                        "$ref": "#/$defs/modern_9"
                      }
                    ]
                  }
                }
              },
              "required": [
                "actions",
                "items",
                "timelimit"
              ]
            },
            {
              "patternProperties": {
                "^actions$": true,
                "^timelimit$": true,
                "^items$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "answer",
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "description": "Value displayed in the report."
                },
                "text": {
                  "type": "string",
                  "description": "Message displayed to the user."
                }
              },
              "required": [
                "value",
                "text"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^text$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Page Stopwatch",
              "description": "Measures time a participant spends on a given page in seconds",
              "properties": {
                "type": {
                  "enum": [
                    "pagestopwatch"
                  ],
                  "type": "string",
                  "options": {
                    "hidden": true
                  }
                },
                "id": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "id"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Yes",
              "type": "object",
              "properties": {
                "group": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": null,
                  "oneOf": [
                    {
                      "title": "yes",
                      "type": "string"
                    },
                    {
                      "title": "no",
                      "type": "null"
                    }
                  ]
                },
                "seconds": {
                  "type": "number",
                  "default": 5
                },
                "timeoutnotice": {
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "group",
                "seconds",
                "timeoutnotice"
              ]
            },
            {
              "patternProperties": {
                "^group$": true,
                "^seconds$": true,
                "^timeoutnotice$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Text Message",
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "textmessage"
                  ],
                  "options": {
                    "hidden": true
                  }
                },
                "content": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "content"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^content$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
