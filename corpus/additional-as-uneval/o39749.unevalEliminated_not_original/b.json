{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "order": {
                  "type": "array"
                },
                "exclude": {
                  "$ref": "#/$defs/inexclude"
                },
                "include": {
                  "$ref": "#/$defs/inexclude"
                }
              },
              "required": [
                "exclude",
                "include"
              ]
            },
            {
              "patternProperties": {
                "^order$": true,
                "^exclude$": true,
                "^include$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "combined": {
                  "type": "boolean"
                },
                "onlyOne": {
                  "type": "boolean"
                },
                "path": {
                  "$ref": "#/$defs/argument"
                },
                "file": {
                  "$ref": "#/$defs/argument"
                }
              },
              "required": [
                "combined",
                "path",
                "file"
              ]
            },
            {
              "patternProperties": {
                "^combined$": true,
                "^onlyOne$": true,
                "^path$": true,
                "^file$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "parameter": {
                  "type": "string"
                },
                "separator": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "multiple": {
                  "type": "boolean"
                },
                "relative": {
                  "type": "boolean"
                }
              },
              "required": [
                "parameter"
              ]
            },
            {
              "patternProperties": {
                "^parameter$": true,
                "^separator$": true,
                "^multiple$": true,
                "^relative$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "inexclude": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {},
              "patternProperties": {
                "^[a-z0-9_-]+\\/[a-z0-9_-]+$": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "required": []
            },
            {
              "patternProperties": {
                "^[a-z0-9_-]+\\/[a-z0-9_-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "argument": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {},
              "patternProperties": {
                "^[0-9.*]+(,[0-9.*]+)*$": {
                  "$ref": "#/$defs/modern_5"
                }
              }
            },
            {
              "patternProperties": {
                "^[0-9.*]+(,[0-9.*]+)*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
