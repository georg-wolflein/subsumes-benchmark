{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Metadata AOI",
              "description": "This is a schema for validating the specification.",
              "type": "object",
              "properties": {
                "metadata_type": {
                  "type": "string",
                  "default": "n/a"
                },
                "name_of_aoi": {
                  "type": "string",
                  "default": "n/a"
                },
                "planned_map_type": {
                  "type": "string",
                  "default": "n/a"
                },
                "planned_satellite_data": {
                  "type": "string",
                  "default": "n/a"
                }
              },
              "required": [
                "metadata_type",
                "name_of_aoi",
                "planned_map_type",
                "planned_satellite_data"
              ]
            },
            {
              "patternProperties": {
                "^metadata_type$": true,
                "^name_of_aoi$": true,
                "^planned_map_type$": true,
                "^planned_satellite_data$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
