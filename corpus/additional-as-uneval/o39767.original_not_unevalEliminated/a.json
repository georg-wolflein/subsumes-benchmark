{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Metadata Map Product",
              "description": "This is a schema for validating map products (schema only).",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "default": "n/a"
                },
                "status": {
                  "type": "string",
                  "default": "n/a"
                },
                "map_type": {
                  "type": "string",
                  "default": "n/a"
                },
                "production_site": {
                  "type": "string",
                  "default": "n/a"
                },
                "product_link": {
                  "type": "string",
                  "default": "n/a"
                },
                "availability": {
                  "type": "string",
                  "default": "n/a"
                },
                "metadata_type": {
                  "type": "string",
                  "default": "n/a"
                }
              },
              "required": [
                "metadata_type",
                "name",
                "map_type",
                "production_site",
                "status",
                "availability",
                "product_link"
              ]
            },
            {
              "patternProperties": {
                "^product_link$": true,
                "^metadata_type$": true,
                "^status$": true,
                "^name$": true,
                "^production_site$": true,
                "^map_type$": true,
                "^availability$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
