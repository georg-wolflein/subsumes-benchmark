{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_8",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Code repository description",
              "properties": {
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "metadata_code_repository": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "generic metadata dict in details list",
              "properties": {
                "author": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "path": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maintainers": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "code_repository": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/metadata_code_repository"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "engines": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_2"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ecosystem": {
                  "type": "string"
                },
                "declared_licenses": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "devel_dependencies": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "homepage": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "readme": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "bug_reporting": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dependencies": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "_dependency_tree_lock": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/metadata_lockfile"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "git_head": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "files": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "_tests_implemented": {
                  "type": "boolean"
                },
                "keywords": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "metadata": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_3"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "scripts": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_4"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "platform": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contributors": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^keywords$": true,
                "^_dependency_tree_lock$": true,
                "^author$": true,
                "^code_repository$": true,
                "^name$": true,
                "^readme$": true,
                "^git_head$": true,
                "^path$": true,
                "^_tests_implemented$": true,
                "^engines$": true,
                "^ecosystem$": true,
                "^scripts$": true,
                "^maintainers$": true,
                "^version$": true,
                "^dependencies$": true,
                "^files$": true,
                "^description$": true,
                "^contributors$": true,
                "^homepage$": true,
                "^declared_licenses$": true,
                "^platform$": true,
                "^bug_reporting$": true,
                "^devel_dependencies$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Dependency lock file description",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "hash": {
                  "type": "string"
                },
                "updated": {
                  "type": "string"
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/metadata_locked_dependency"
                  }
                },
                "runtime": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^runtime$": true,
                "^dependencies$": true,
                "^name$": true,
                "^hash$": true,
                "^updated$": true,
                "^version$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "metadata_lockfile": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Result of Mercator worker",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_9"
                },
                "_release": {
                  "type": "string",
                  "description": "Unique release id in form of \"ecosystem:package:version\""
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "success",
                    "error"
                  ]
                },
                "details": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/details_metadata"
                  }
                },
                "summary": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "status",
                "summary"
              ],
              "title": "metadata-v4-0-0"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true,
                "^details$": true,
                "^status$": true,
                "^summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "version": {
                  "type": "string",
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
                },
                "url": {
                  "type": "string",
                  "description": "Full URL of the schema",
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "metadata_locked_dependency": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Locked dependency description",
              "properties": {
                "name": {
                  "type": "string"
                },
                "resolved": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "specification": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "type": "string"
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/metadata_locked_dependency"
                  }
                },
                "subpackages": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^specification$": true,
                "^name$": true,
                "^resolved$": true,
                "^dependencies$": true,
                "^subpackages$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "details_metadata": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
