{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "domain": {
                  "pattern": "^([a-z0-9]+(-[a-z0-9]+)*\\.)+[a-z]{2,}$",
                  "type": "string"
                },
                "selector": {
                  "type": "string"
                },
                "url": {
                  "_format": "url",
                  "type": "string"
                }
              },
              "required": [
                "domain",
                "url",
                "selector"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^domain$": true,
                "^selector$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
