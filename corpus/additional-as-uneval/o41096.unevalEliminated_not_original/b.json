{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "pluginClass": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^pluginClass$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "pluginClass": {
                  "type": "string"
                },
                "dartPluginClass": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^pluginClass$": true,
                "^dartPluginClass$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string"
                },
                "fonts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^family$": true,
                "^fonts$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "$comment": "This should be kept in sync with the validator in packages/flutter_tools/lib/src/flutter_manifest.dart",
              "title": "pubspec.yaml",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "flutter": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^flutter$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "pluginClass": {
                  "type": "string"
                },
                "dartPluginClass": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^pluginClass$": true,
                "^dartPluginClass$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "oneOf": [
                {
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ],
              "properties": {
                "plugin": {
                  "$ref": "#/$defs/modern_3"
                },
                "fonts": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                },
                "assets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "uses-material-design": {
                  "type": "boolean"
                },
                "services": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "module": {
                  "$ref": "#/$defs/modern_12"
                }
              }
            },
            {
              "patternProperties": {
                "^uses-material-design$": true,
                "^plugin$": true,
                "^services$": true,
                "^assets$": true,
                "^module$": true,
                "^fonts$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "androidX": {
                  "type": "boolean"
                },
                "androidPackage": {
                  "type": "string"
                },
                "iosBundleIdentifier": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^androidX$": true,
                "^androidPackage$": true,
                "^iosBundleIdentifier$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "pluginClass": {
                  "type": "string"
                },
                "dartPluginClass": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^pluginClass$": true,
                "^dartPluginClass$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "package": {
                  "type": "string"
                },
                "pluginClass": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^package$": true,
                "^pluginClass$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "iosPrefix": {
                  "type": "string"
                },
                "pluginClass": {
                  "type": "string"
                },
                "macosPrefix": {
                  "type": "string"
                },
                "androidPackage": {
                  "type": "string"
                },
                "platforms": {
                  "$ref": "#/$defs/modern_4"
                }
              }
            },
            {
              "patternProperties": {
                "^androidPackage$": true,
                "^pluginClass$": true,
                "^macosPrefix$": true,
                "^iosPrefix$": true,
                "^platforms$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "asset": {
                  "type": "string"
                },
                "weight": {
                  "enum": [
                    100,
                    200,
                    300,
                    400,
                    500,
                    600,
                    700,
                    800,
                    900
                  ]
                },
                "style": {
                  "enum": [
                    "normal",
                    "italic"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^asset$": true,
                "^weight$": true,
                "^style$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "ios": {
                  "$ref": "#/$defs/modern_5"
                },
                "macos": {
                  "$ref": "#/$defs/modern_6"
                },
                "linux": {
                  "$ref": "#/$defs/modern_7"
                },
                "windows": {
                  "$ref": "#/$defs/modern_8"
                },
                "android": {
                  "$ref": "#/$defs/modern_9"
                }
              }
            },
            {
              "patternProperties": {
                "^linux$": true,
                "^android$": true,
                "^windows$": true,
                "^macos$": true,
                "^ios$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
