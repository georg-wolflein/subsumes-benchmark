{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/modern_1"
    },
    {
      "$ref": "#/$defs/modern_2"
    }
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "dog": {
                  "type": "string"
                }
              },
              "required": [
                "dog"
              ]
            },
            {
              "patternProperties": {
                "^dog$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "cat": {
                  "type": "string"
                }
              },
              "required": [
                "cat"
              ]
            },
            {
              "patternProperties": {
                "^cat$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
