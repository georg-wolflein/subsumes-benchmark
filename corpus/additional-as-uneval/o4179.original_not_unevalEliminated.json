{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "maxItems",
    "minItems",
    "minLength",
    "not",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o4179.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o4179.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "$schemaRef": {
                    "type": "string"
                  },
                  "header": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "message": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "$schemaRef",
                  "header",
                  "message"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schemaRef$": true,
                  "^header$": true,
                  "^message$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "gatewayTimestamp": {
                    "_format": "date-time",
                    "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
                    "type": "string"
                  },
                  "softwareName": {
                    "type": "string"
                  },
                  "softwareVersion": {
                    "type": "string"
                  },
                  "uploaderID": {
                    "type": "string"
                  }
                },
                "required": [
                  "uploaderID",
                  "softwareName",
                  "softwareVersion"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^gatewayTimestamp$": true,
                  "^softwareName$": true,
                  "^softwareVersion$": true,
                  "^uploaderID$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Contains all properties from the listed events in the client's journal minus Localised strings and the properties marked below as 'disallowed'",
                "patternProperties": {
                  "^(Materials|StationEconomies|Signals)$": {
                    "description": "Present in Scan, Docked and SAASignalsFound messages",
                    "items": {
                      "patternProperties": {
                        "_Localised$": {
                          "$ref": "#/$defs/disallowed"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "_Localised$": {
                    "$ref": "#/$defs/disallowed"
                  }
                },
                "properties": {
                  "SystemAddress": {
                    "description": "Should be added by the sender if not present in the journal event",
                    "type": "integer"
                  },
                  "Wanted": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "StarSystem": {
                    "description": "Must be added by the sender if not present in the journal event",
                    "minLength": 1,
                    "type": "string"
                  },
                  "Factions": {
                    "description": "Present in Location, FSDJump and CarrierJump messages",
                    "items": {
                      "patternProperties": {
                        "_Localised$": {
                          "$ref": "#/$defs/disallowed"
                        }
                      },
                      "properties": {
                        "HappiestSystem": {
                          "$ref": "#/$defs/disallowed"
                        },
                        "HomeSystem": {
                          "$ref": "#/$defs/disallowed"
                        },
                        "MyReputation": {
                          "$ref": "#/$defs/disallowed"
                        },
                        "SquadronFaction": {
                          "$ref": "#/$defs/disallowed"
                        }
                      },
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "ActiveFine": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "timestamp": {
                    "_format": "date-time",
                    "type": "string"
                  },
                  "Latitude": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "event": {
                    "enum": [
                      "Docked",
                      "FSDJump",
                      "Scan",
                      "Location",
                      "SAASignalsFound",
                      "CarrierJump"
                    ]
                  },
                  "Longitude": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "FuelLevel": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "JumpDist": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "CockpitBreach": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "FuelUsed": {
                    "$ref": "#/$defs/disallowed"
                  },
                  "StarPos": {
                    "description": "Must be added by the sender if not present in the journal event",
                    "items": {
                      "type": "number"
                    },
                    "maxItems": 3,
                    "minItems": 3,
                    "type": "array"
                  },
                  "BoostUsed": {
                    "$ref": "#/$defs/disallowed"
                  }
                },
                "required": [
                  "timestamp",
                  "event",
                  "StarSystem",
                  "StarPos",
                  "SystemAddress"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^StarPos$": true,
                  "^event$": true,
                  "^timestamp$": true,
                  "^(Materials|StationEconomies|Signals)$": true,
                  "^FuelUsed$": true,
                  "^FuelLevel$": true,
                  "^CockpitBreach$": true,
                  "^Wanted$": true,
                  "_Localised$": true,
                  "^Latitude$": true,
                  "^ActiveFine$": true,
                  "^Factions$": true,
                  "^BoostUsed$": true,
                  "^StarSystem$": true,
                  "^Longitude$": true,
                  "^SystemAddress$": true,
                  "^JumpDist$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "disallowed": {
        "not": {
          "type": [
            "array",
            "boolean",
            "integer",
            "number",
            "null",
            "object",
            "string"
          ]
        }
      }
    }
  },
  "b": {
    "$id": "https://eddn.edcd.io/schemas/journal/1",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "$schemaRef": {
        "type": "string"
      },
      "header": {
        "additionalProperties": true,
        "properties": {
          "gatewayTimestamp": {
            "_format": "date-time",
            "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
            "type": "string"
          },
          "softwareName": {
            "type": "string"
          },
          "softwareVersion": {
            "type": "string"
          },
          "uploaderID": {
            "type": "string"
          }
        },
        "required": [
          "uploaderID",
          "softwareName",
          "softwareVersion"
        ],
        "type": "object"
      },
      "message": {
        "additionalProperties": true,
        "description": "Contains all properties from the listed events in the client's journal minus Localised strings and the properties marked below as 'disallowed'",
        "patternProperties": {
          "^(Materials|StationEconomies|Signals)$": {
            "description": "Present in Scan, Docked and SAASignalsFound messages",
            "items": {
              "patternProperties": {
                "_Localised$": {
                  "$ref": "#/$defs/disallowed"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "_Localised$": {
            "$ref": "#/$defs/disallowed"
          }
        },
        "properties": {
          "ActiveFine": {
            "$ref": "#/$defs/disallowed"
          },
          "BoostUsed": {
            "$ref": "#/$defs/disallowed"
          },
          "CockpitBreach": {
            "$ref": "#/$defs/disallowed"
          },
          "Factions": {
            "description": "Present in Location, FSDJump and CarrierJump messages",
            "items": {
              "patternProperties": {
                "_Localised$": {
                  "$ref": "#/$defs/disallowed"
                }
              },
              "properties": {
                "HappiestSystem": {
                  "$ref": "#/$defs/disallowed"
                },
                "HomeSystem": {
                  "$ref": "#/$defs/disallowed"
                },
                "MyReputation": {
                  "$ref": "#/$defs/disallowed"
                },
                "SquadronFaction": {
                  "$ref": "#/$defs/disallowed"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "FuelLevel": {
            "$ref": "#/$defs/disallowed"
          },
          "FuelUsed": {
            "$ref": "#/$defs/disallowed"
          },
          "JumpDist": {
            "$ref": "#/$defs/disallowed"
          },
          "Latitude": {
            "$ref": "#/$defs/disallowed"
          },
          "Longitude": {
            "$ref": "#/$defs/disallowed"
          },
          "StarPos": {
            "description": "Must be added by the sender if not present in the journal event",
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "StarSystem": {
            "description": "Must be added by the sender if not present in the journal event",
            "minLength": 1,
            "type": "string"
          },
          "SystemAddress": {
            "description": "Should be added by the sender if not present in the journal event",
            "type": "integer"
          },
          "Wanted": {
            "$ref": "#/$defs/disallowed"
          },
          "event": {
            "enum": [
              "Docked",
              "FSDJump",
              "Scan",
              "Location",
              "SAASignalsFound",
              "CarrierJump"
            ]
          },
          "timestamp": {
            "_format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "timestamp",
          "event",
          "StarSystem",
          "StarPos",
          "SystemAddress"
        ],
        "type": "object"
      }
    },
    "required": [
      "$schemaRef",
      "header",
      "message"
    ],
    "type": "object",
    "$defs": {
      "disallowed": {
        "not": {
          "type": [
            "array",
            "boolean",
            "integer",
            "number",
            "null",
            "object",
            "string"
          ]
        }
      }
    }
  }
}
