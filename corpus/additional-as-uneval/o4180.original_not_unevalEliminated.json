{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "minItems",
    "minLength",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o4180.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "$schemaRef": {
                    "type": "string"
                  },
                  "header": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "message": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "$schemaRef",
                  "header",
                  "message"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schemaRef$": true,
                  "^header$": true,
                  "^message$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "gatewayTimestamp": {
                    "_format": "date-time",
                    "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
                    "type": "string"
                  },
                  "softwareName": {
                    "type": "string"
                  },
                  "softwareVersion": {
                    "type": "string"
                  },
                  "uploaderID": {
                    "type": "string"
                  }
                },
                "required": [
                  "uploaderID",
                  "softwareName",
                  "softwareVersion"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^gatewayTimestamp$": true,
                  "^softwareName$": true,
                  "^softwareVersion$": true,
                  "^uploaderID$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "stationName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "timestamp": {
                    "_format": "date-time",
                    "type": "string"
                  },
                  "systemName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "horizons": {
                    "description": "Whether the sending Cmdr has a Horizons pass.",
                    "type": "boolean"
                  },
                  "marketId": {
                    "type": "number"
                  },
                  "modules": {
                    "items": {
                      "description": "Module symbolic name. e.g. Hpt_ChaffLauncher_Tiny, Int_Engine_Size3_Class5_Fast, Independant_Trader_Armour_Grade1, etc. Modules that depend on the Cmdr's purchases (e.g. bobbleheads, paintjobs) or rank (e.g. decals and PowerPlay faction-specific modules) should be omitted.",
                      "minLength": 1,
                      "pattern": "(^Hpt_|^Int_|_Armour_)",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "_uniqueItems": true
                  }
                },
                "required": [
                  "systemName",
                  "stationName",
                  "marketId",
                  "timestamp",
                  "modules"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^modules$": true,
                  "^marketId$": true,
                  "^timestamp$": true,
                  "^systemName$": true,
                  "^stationName$": true,
                  "^horizons$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://eddn.edcd.io/schemas/outfitting/2",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "$schemaRef": {
        "type": "string"
      },
      "header": {
        "additionalProperties": true,
        "properties": {
          "gatewayTimestamp": {
            "_format": "date-time",
            "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
            "type": "string"
          },
          "softwareName": {
            "type": "string"
          },
          "softwareVersion": {
            "type": "string"
          },
          "uploaderID": {
            "type": "string"
          }
        },
        "required": [
          "uploaderID",
          "softwareName",
          "softwareVersion"
        ],
        "type": "object"
      },
      "message": {
        "additionalProperties": false,
        "properties": {
          "horizons": {
            "description": "Whether the sending Cmdr has a Horizons pass.",
            "type": "boolean"
          },
          "marketId": {
            "type": "number"
          },
          "modules": {
            "items": {
              "description": "Module symbolic name. e.g. Hpt_ChaffLauncher_Tiny, Int_Engine_Size3_Class5_Fast, Independant_Trader_Armour_Grade1, etc. Modules that depend on the Cmdr's purchases (e.g. bobbleheads, paintjobs) or rank (e.g. decals and PowerPlay faction-specific modules) should be omitted.",
              "minLength": 1,
              "pattern": "(^Hpt_|^Int_|_Armour_)",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "_uniqueItems": true
          },
          "stationName": {
            "minLength": 1,
            "type": "string"
          },
          "systemName": {
            "minLength": 1,
            "type": "string"
          },
          "timestamp": {
            "_format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "systemName",
          "stationName",
          "marketId",
          "timestamp",
          "modules"
        ],
        "type": "object"
      }
    },
    "required": [
      "$schemaRef",
      "header",
      "message"
    ],
    "type": "object"
  }
}
