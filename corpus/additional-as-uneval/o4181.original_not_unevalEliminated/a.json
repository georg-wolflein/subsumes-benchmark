{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "$schemaRef": {
                  "type": "string"
                },
                "header": {
                  "$ref": "#/$defs/modern_2"
                },
                "message": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "$schemaRef",
                "header",
                "message"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^$schemaRef$": true,
                "^header$": true,
                "^message$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "gatewayTimestamp": {
                  "_format": "date-time",
                  "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
                  "type": "string"
                },
                "softwareName": {
                  "type": "string"
                },
                "softwareVersion": {
                  "type": "string"
                },
                "uploaderID": {
                  "type": "string"
                }
              },
              "required": [
                "uploaderID",
                "softwareName",
                "softwareVersion"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^gatewayTimestamp$": true,
                "^softwareName$": true,
                "^softwareVersion$": true,
                "^uploaderID$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "stationName": {
                  "minLength": 1,
                  "type": "string"
                },
                "timestamp": {
                  "_format": "date-time",
                  "type": "string"
                },
                "systemName": {
                  "minLength": 1,
                  "type": "string"
                },
                "marketId": {
                  "type": "number"
                },
                "ships": {
                  "items": {
                    "description": "Ship symbolic name. i.e. one of: SideWinder, Adder, Anaconda, Asp, Asp_Scout CobraMkIII, CobraMkIV, Cutter, DiamondBack, DiamondBackXL, Eagle, Empire_Courier, Empire_Eagle, Empire_Trader, Federation_Corvette, Federation_Dropship, Federation_Dropship_MkII, Federation_Gunship, FerDeLance, Hauler, Independant_Trader, Orca, Python, Type6, Type7, Type9, Viper, Viper_MkIV, Vulture",
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "_uniqueItems": true
                },
                "horizons": {
                  "description": "Whether the sending Cmdr has a Horizons pass.",
                  "type": "boolean"
                }
              },
              "required": [
                "systemName",
                "stationName",
                "marketId",
                "timestamp",
                "ships"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^marketId$": true,
                "^ships$": true,
                "^timestamp$": true,
                "^systemName$": true,
                "^stationName$": true,
                "^horizons$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
