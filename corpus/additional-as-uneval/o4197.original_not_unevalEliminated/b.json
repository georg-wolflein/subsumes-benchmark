{
  "$id": "http://dtls.nl/schemas/dmp-knowledge-model/",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "chapter",
  "description": "JSON file describing a single chapter in the knowledge model for DMP questionnaires",
  "properties": {
    "chapterid": {
      "$ref": "#/$defs/chapterid"
    },
    "namespace": {
      "$ref": "#/$defs/namespace"
    },
    "formatversion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "questions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/question"
          },
          {
            "anyOf": [
              {
                "$ref": "#/$defs/optionquestion"
              },
              {
                "$ref": "#/$defs/fieldquestion"
              }
            ]
          }
        ]
      }
    }
  },
  "required": [
    "chapterid",
    "namespace",
    "formatversion",
    "questions"
  ],
  "additionalProperties": false,
  "$defs": {
    "chapterid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7
    },
    "questionid": {
      "type": "integer",
      "minimum": 1
    },
    "namespace": {
      "type": "string"
    },
    "expert": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "class": {
          "type": "string",
          "enum": [
            "individual",
            "organisation"
          ],
          "default": "organisation"
        }
      },
      "required": [
        "name"
      ]
    },
    "experts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/expert"
      }
    },
    "questionpointer": {
      "type": "object",
      "properties": {
        "chapterid": {
          "$ref": "#/$defs/chapterid"
        },
        "questionid": {
          "$ref": "#/$defs/questionid"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        }
      },
      "required": [
        "chapterid",
        "questionid",
        "namespace"
      ],
      "additionalProperties": false
    },
    "dmpbookreference": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "dmpbook"
          ]
        },
        "chapter": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "chapter"
      ],
      "additionalProperties": false
    },
    "urlreference": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "url"
          ]
        },
        "url": {
          "type": "string"
        },
        "anchor": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "weblink"
      ],
      "additionalProperties": false
    },
    "crossreference": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "xref"
          ]
        },
        "chapterid": {
          "$ref": "#/$defs/chapterid"
        },
        "questionid": {
          "$ref": "#/$defs/questionid"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        }
      },
      "required": [
        "chapterid",
        "questionid"
      ],
      "additionalProperties": false
    },
    "reference": {
      "anyOf": [
        {
          "$ref": "#/$defs/dmpbookreference"
        },
        {
          "$ref": "#/$defs/urlreference"
        },
        {
          "$ref": "#/$defs/crossreference"
        }
      ]
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "answerid": {
      "type": "integer",
      "minimum": 0
    },
    "optionanswer": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/answerid"
        },
        "label": {
          "type": "string"
        },
        "advice": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "optionanswers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/optionanswer"
      }
    },
    "precondition": {
      "type": "object",
      "properties": {
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "questionid": {
          "$ref": "#/$defs/questionid"
        },
        "answerid": {
          "$ref": "#/$defs/answerid"
        }
      },
      "required": [
        "questionid"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "questionid": {
          "$ref": "#/$defs/questionid"
        },
        "namespace": {
          "$ref": "#/$defs/namespace"
        },
        "precondition": {
          "$ref": "#/$defs/precondition"
        },
        "insertBefore": {
          "$ref": "#/$defs/questionpointer"
        },
        "references": {
          "$ref": "#/$defs/references"
        },
        "addReferences": {
          "$ref": "#/$defs/references"
        },
        "experts": {
          "$ref": "#/$defs/experts"
        },
        "addExperts": {
          "$ref": "#/$defs/experts"
        },
        "type": {
          "type": "string",
          "enum": [
            "option",
            "list",
            "string",
            "text"
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "answers": {
          "$ref": "#/$defs/optionanswers"
        },
        "addAnswers": {
          "$ref": "#/$defs/optionanswers"
        }
      },
      "required": [
        "questionid"
      ],
      "additionalProperties": false
    },
    "optionquestion": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "option"
          ]
        },
        "answers": {
          "minItems": 1
        }
      }
    },
    "fieldquestion": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "list",
            "string",
            "text"
          ]
        },
        "answers": {
          "maxItems": 0
        }
      }
    }
  }
}
