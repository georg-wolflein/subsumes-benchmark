{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Result of BlackDuck worker",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_2"
                },
                "_release": {
                  "type": "string",
                  "description": "Unique release id in form of \"ecosystem:package:version\""
                }
              },
              "title": "blackduck_data-v1-0-0"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "version": {
                  "type": "string",
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
                },
                "url": {
                  "type": "string",
                  "description": "Full URL of the schema",
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
