{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Result of CodeMetrics worker",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_6"
                },
                "_release": {
                  "type": "string",
                  "description": "Unique release id in form of \"ecosystem:package:version\""
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "success",
                    "error"
                  ]
                },
                "details": {
                  "$ref": "#/$defs/code_metrics_result"
                },
                "summary": {
                  "$ref": "#/$defs/code_metrics_summary"
                }
              },
              "required": [
                "status",
                "details",
                "summary"
              ],
              "title": "crypto_algorithms_result-v1-0-0"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true,
                "^details$": true,
                "^status$": true,
                "^summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "version": {
                  "type": "string",
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
                },
                "url": {
                  "type": "string",
                  "description": "Full URL of the schema",
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "code_metrics_result": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Details computed by CodeMetrics worker",
              "properties": {
                "languages": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/languages"
                  }
                }
              },
              "required": [
                "languages"
              ]
            },
            {
              "patternProperties": {
                "^languages$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Summary computed by CodeMetrics worker",
              "properties": {
                "total_lines": {
                  "type": "number"
                },
                "code_lines": {
                  "type": "number"
                },
                "blank_lines": {
                  "type": "number"
                },
                "total_files": {
                  "type": "number"
                },
                "comment_lines": {
                  "type": "number"
                }
              },
              "required": [
                "blank_lines",
                "code_lines",
                "comment_lines",
                "total_files",
                "total_lines"
              ]
            },
            {
              "patternProperties": {
                "^total_files$": true,
                "^comment_lines$": true,
                "^total_lines$": true,
                "^blank_lines$": true,
                "^code_lines$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "languages": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Generic language specific statistics",
              "properties": {
                "code_lines": {
                  "type": "number"
                },
                "files_count": {
                  "type": "number"
                },
                "blank_lines": {
                  "type": "number"
                },
                "comment_lines": {
                  "type": "number"
                },
                "language": {
                  "type": "string"
                },
                "metrics": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "required": [
                "blank_lines",
                "code_lines",
                "comment_lines",
                "files_count",
                "language"
              ]
            },
            {
              "patternProperties": {
                "^comment_lines$": true,
                "^language$": true,
                "^blank_lines$": true,
                "^code_lines$": true,
                "^files_count$": true,
                "^metrics$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "code_metrics_summary": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
