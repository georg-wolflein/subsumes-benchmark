{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_9",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Patch information about downstream SRPM",
              "properties": {
                "diff": {
                  "$ref": "#/$defs/diff"
                },
                "patch_files": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "package": {
                  "type": "string"
                }
              },
              "required": [
                "diff",
                "patch_files",
                "package"
              ]
            },
            {
              "patternProperties": {
                "^diff$": true,
                "^patch_files$": true,
                "^package$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "version": {
                  "type": "string",
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
                },
                "url": {
                  "type": "string",
                  "description": "Full URL of the schema",
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "toolchain_responses": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "package_names": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "registered_srpms": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/srpm_record"
                  }
                },
                "all_rhn_channels": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "all_rhsm_content_sets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "package_names",
                "registered_srpms",
                "all_rhn_channels",
                "all_rhsm_content_sets"
              ]
            },
            {
              "patternProperties": {
                "^package_names$": true,
                "^registered_srpms$": true,
                "^all_rhn_channels$": true,
                "^all_rhsm_content_sets$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "anitya_response": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Summary of Red Hat tracked SRPM",
              "properties": {
                "epoch": {
                  "type": "number"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "patch_count": {
                  "type": "number"
                },
                "modified_file_count": {
                  "type": "number"
                },
                "version": {
                  "type": "string"
                },
                "package_name": {
                  "type": "string"
                },
                "modified_line_count": {
                  "type": "number"
                },
                "hashes": {
                  "type": "object",
                  "properties": {
                    "md5": {
                      "type": "string"
                    },
                    "sha1": {
                      "type": "string"
                    },
                    "sha256": {
                      "type": "string"
                    }
                  }
                },
                "release": {
                  "type": "string"
                },
                "published_in": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "architectures": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "package_name",
                "epoch",
                "version",
                "release",
                "patch_count",
                "modified_line_count",
                "modified_file_count"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^modified_file_count$": true,
                "^modified_line_count$": true,
                "^published_in$": true,
                "^package_name$": true,
                "^architectures$": true,
                "^release$": true,
                "^patch_count$": true,
                "^epoch$": true,
                "^tags$": true,
                "^hashes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "downstream": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "The Pulp CDN handles Red Hat's SRPM publication",
              "properties": {
                "srpm_filename": {
                  "type": "string"
                }
              },
              "required": [
                "srpm_filename"
              ]
            },
            {
              "patternProperties": {
                "^srpm_filename$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "diff": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Result of DownstreamUsage worker",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_10"
                },
                "_release": {
                  "type": "string",
                  "description": "Unique release id in form of \"ecosystem:package:version\""
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "success",
                    "error"
                  ]
                },
                "details": {
                  "$ref": "#/$defs/toolchain_responses"
                },
                "summary": {
                  "$ref": "#/$defs/downstream_usage_summary"
                }
              },
              "required": [
                "status",
                "summary"
              ],
              "title": "downstream_usage_result-v2-1-0"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true,
                "^details$": true,
                "^status$": true,
                "^summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Anitya maps upstream components to downstream packages",
              "properties": {}
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Breakdown of changed lines per given file",
              "properties": {
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "lines",
                "file"
              ]
            },
            {
              "patternProperties": {
                "^lines$": true,
                "^file$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "downstream_usage_summary": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Information about changed files and lines",
              "properties": {
                "files": {
                  "type": "integer"
                },
                "lines": {
                  "type": "integer"
                },
                "changes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/changes"
                  }
                }
              },
              "required": [
                "files",
                "lines",
                "changes"
              ]
            },
            {
              "patternProperties": {
                "^files$": true,
                "^lines$": true,
                "^changes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "changes": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "redhat_anitya": {
                  "$ref": "#/$defs/anitya_response"
                },
                "brew": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/downstream"
                  }
                },
                "pulp_cdn": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/pulp_cdn_response"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^redhat_anitya$": true,
                "^brew$": true,
                "^pulp_cdn$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "srpm_record": {
      "$ref": "#/$defs/modern_7"
    },
    "pulp_cdn_response": {
      "$ref": "#/$defs/modern_8"
    }
  }
}
