{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "redmine": {
      "$ref": "#/$defs/redmine-configuration"
    },
    "git-lab": {
      "$ref": "#/$defs/git-lab-configuration"
    }
  },
  "required": [
    "redmine",
    "git-lab"
  ],
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "username": {
                  "type": "string",
                  "description": "Your Redmine username (must be an administrator)."
                },
                "password": {
                  "type": "string",
                  "description": "Your Redmine password."
                },
                "base-uri": {
                  "type": "string",
                  "description": "The base URL of your Redmine installation."
                }
              },
              "required": [
                "username",
                "password",
                "base-uri"
              ]
            },
            {
              "patternProperties": {
                "^username$": true,
                "^password$": true,
                "^base-uri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "labels-mapping": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "tracker": {
                  "$ref": "#/$defs/simple-label-mapping",
                  "description": "Labels to assign to tickets of a specific tracker."
                },
                "status": {
                  "$ref": "#/$defs/simple-label-mapping",
                  "description": "Labels to assign to tickets with a specific status."
                },
                "priority": {
                  "$ref": "#/$defs/simple-label-mapping",
                  "description": "Labels to assign to tickets with a specific priority."
                },
                "custom-field": {
                  "patternProperties": {
                    ".*": {
                      "$ref": "#/$defs/simple-label-mapping"
                    }
                  },
                  "description": "Labels to assign to tickets with one or more specific custom field value(s)."
                }
              }
            },
            {
              "patternProperties": {
                "^tracker$": true,
                "^status$": true,
                "^priority$": true,
                "^custom-field$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "users-mapping": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^\\d+$": {
                  "type": "integer",
                  "minimum": 1.0
                }
              }
            },
            {
              "patternProperties": {
                "^\\d+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "git-lab-configuration": {
      "$ref": "#/$defs/modern_3"
    },
    "simple-label-mapping": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "private-token": {
                  "type": "string",
                  "description": "Your GitLab private token (can be found in your account settings)."
                },
                "base-uri": {
                  "type": "string",
                  "description": "The base URL of your GitLab installation (incl. API prefix)."
                },
                "labels-mapping": {
                  "$ref": "#/$defs/labels-mapping",
                  "description": "Describes how to map Redmine ticket meta data to GitLab issue labels."
                },
                "users-mapping": {
                  "$ref": "#/$defs/users-mapping",
                  "description": "Describes how to map an assignee's Redmine user ID to his GitLab user ID."
                }
              },
              "required": [
                "private-token",
                "base-uri"
              ]
            },
            {
              "patternProperties": {
                "^private-token$": true,
                "^base-uri$": true,
                "^labels-mapping$": true,
                "^users-mapping$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "redmine-configuration": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                ".*": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
