{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_8",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "string"
                },
                "stop": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^start$": true,
                "^stop$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "host": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "targets": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/desthost"
                      }
                    ]
                  },
                  "_uniqueItems": true
                },
                "dest_root": {
                  "description": "The destination directory. Optional, if missing it will be the same the source_root",
                  "type": "string"
                },
                "paths": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/includeexclude"
                  }
                },
                "delete": {
                  "description": "Exact mirror, delete any files that exist only in dest.",
                  "type": "boolean"
                },
                "source_root": {
                  "description": "The root of the source directory, required for non abstract workspaces",
                  "type": "string"
                },
                "extends": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "abstract": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^targets$": true,
                "^name$": true,
                "^abstract$": true,
                "^dest_root$": true,
                "^source_root$": true,
                "^paths$": true,
                "^extends$": true,
                "^delete$": true,
                "^enabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "container": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "docker_image_name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "extra_flags": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "description": "Flags to add to the docker command line",
                  "items": {
                    "type": "string"
                  }
                },
                "docker_auth": {
                  "type": "string",
                  "description": "A command to run just before running docker, usually used for authentication"
                },
                "docker_image_name": {
                  "type": "string",
                  "description": "The docker image name"
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "command": {
                  "type": "string"
                },
                "mount_home_dir": {
                  "type": "boolean",
                  "default": true
                },
                "environ": {
                  "description": "Environment variables array to be passed to the container",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "env": {
                  "description": "Environment variables array to be passed to the container",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^docker_image_name$": true,
                "^docker_auth$": true,
                "^name$": true,
                "^mount_home_dir$": true,
                "^command$": true,
                "^extra_flags$": true,
                "^environ$": true,
                "^ports$": true,
                "^env$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "includeexclude": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "_uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "_uniqueItems": true
        }
      }
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "root",
              "type": "object",
              "properties": {
                "workspaces": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/workspace"
                  }
                },
                "config": {
                  "$ref": "#/$defs/modern_9"
                },
                "images": {
                  "title": "Your docker images",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/image"
                  }
                },
                "containers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/container"
                  }
                },
                "hosts": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "workspaces",
                "hosts"
              ]
            },
            {
              "patternProperties": {
                "^containers$": true,
                "^config$": true,
                "^images$": true,
                "^hosts$": true,
                "^workspaces$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "workspace": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "sd2 configuration",
              "type": "object",
              "default": {},
              "properties": {
                "HaltOnSuspendResume": {
                  "type": "boolean",
                  "default": true
                },
                "RsynCheckPeriodInSeconds": {
                  "type": "number",
                  "default": 900
                },
                "DockerCheckPeriodInSeconds": {
                  "type": "number",
                  "default": 60
                }
              }
            },
            {
              "patternProperties": {
                "^HaltOnSuspendResume$": true,
                "^RsynCheckPeriodInSeconds$": true,
                "^DockerCheckPeriodInSeconds$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "value"
              ],
              "_uniqueItems": true,
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "HostKeyAlias": {
                  "type": "string"
                },
                "StrictHostKeyChecking": {
                  "type": "string"
                },
                "ProxyJump": {
                  "type": "string"
                },
                "abstract": {
                  "type": "boolean"
                },
                "sudo_ssh": {
                  "type": "string",
                  "description": "Uses sudo ssh to connect to the host, useful if you want to forward locally ports like 80 or 443"
                },
                "UserKnownHostsFile": {
                  "type": "string"
                },
                "AddKeysToAgent": {
                  "type": "string"
                },
                "User": {
                  "type": "string",
                  "description": "Used in .ssh/config defaults to the $USER who runs sd2"
                },
                "IdentityFile": {
                  "type": "string"
                },
                "extends": {
                  "type": "string"
                },
                "ProxyCommand": {
                  "type": "string"
                },
                "Operations": {
                  "$ref": "#/$defs/modern_5"
                },
                "name": {
                  "type": "string"
                },
                "LocalForward": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "PKCS11Provider": {
                  "type": "string"
                },
                "Port": {
                  "type": "integer"
                },
                "containers": {
                  "type": "array",
                  "description": "List of containers to run on this host",
                  "items": {
                    "type": "object",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/container"
                      }
                    ]
                  }
                },
                "SmartcardDevice": {
                  "type": "string"
                },
                "UseKeychain": {
                  "type": "string"
                },
                "ForwardAgent": {
                  "type": "string"
                },
                "ServerAliveInterval": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^containers$": true,
                "^ServerAliveInterval$": true,
                "^AddKeysToAgent$": true,
                "^sudo_ssh$": true,
                "^name$": true,
                "^Port$": true,
                "^abstract$": true,
                "^StrictHostKeyChecking$": true,
                "^SmartcardDevice$": true,
                "^Operations$": true,
                "^IdentityFile$": true,
                "^ProxyCommand$": true,
                "^PKCS11Provider$": true,
                "^LocalForward$": true,
                "^extends$": true,
                "^ForwardAgent$": true,
                "^UserKnownHostsFile$": true,
                "^ProxyJump$": true,
                "^UseKeychain$": true,
                "^User$": true,
                "^HostKeyAlias$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "desthost": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "imagename",
                "hostname"
              ],
              "properties": {
                "aliases": {
                  "type": "array",
                  "description": "Names that will be added to /etc/hosts for this container",
                  "items": {
                    "type": "string"
                  }
                },
                "name": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "hostname": {
                  "type": "string"
                },
                "remove_if_running_when_disabled": {
                  "type": "boolean",
                  "description": "If the container is running and should not remove it.",
                  "default": false
                },
                "imagename": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean",
                  "descrption": "Should the container be started if it is missing",
                  "default": true
                },
                "abstract": {
                  "type": "boolean"
                },
                "remove_if_version_mismatch": {
                  "type": "boolean",
                  "description": "If the container is running with the wrong image remove it and restart it.",
                  "default": false
                },
                "disabled": {
                  "type": "boolean",
                  "descrption": "Should the container be started if it is missing",
                  "default": false
                },
                "extends": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^imagename$": true,
                "^extends$": true,
                "^name$": true,
                "^abstract$": true,
                "^remove_if_version_mismatch$": true,
                "^enabled$": true,
                "^aliases$": true,
                "^hostname$": true,
                "^disabled$": true,
                "^remove_if_running_when_disabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "disabled": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^enabled$": true,
                "^disabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "image": {
      "$ref": "#/$defs/modern_2"
    }
  }
}
