{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "org.eclipse.persistence.testing.jaxb.annotations.xmlcontainerproperty.Employee",
  "type": "object",
  "properties": {
    "employee": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "first-name": {
          "type": "string"
        },
        "last-name": {
          "type": "string"
        },
        "address": {
          "$ref": "#/$defs/Address"
        },
        "phone-numbers": {
          "type": "object",
          "properties": {
            "number": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PhoneNumber"
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "Address": {
      "type": "object",
      "properties": {
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "PhoneNumber": {
      "type": "string",
      "additionalProperties": false
    }
  }
}
