                }
              }
            },
            {
              "patternProperties": {
                "^listNumbersTest$": true,
                "^bigDecimalTest$": true,
                "^floatTest$": true,
                "^longTest$": true,
                "^shortTest$": true,
                "^doubleTest$": true,
                "^listIntegersTest$": true,
                "^intTest$": true,
                "^bigIntegerTest$": true,
                "^integerTest$": true
