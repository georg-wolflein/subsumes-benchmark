{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "org.eclipse.persistence.testing.jaxb.xmlidref.xmlelements.RootEmployeeSingle",
  "type": "object",
  "properties": {
    "root": {
      "$ref": "#/$defs/modern_4"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "address-id": {
                  "type": "string"
                },
                "phone-id": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true,
                "^address-id$": true,
                "^phone-id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "zip": {
                  "type": "string"
                },
                "aid": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "street": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^city$": true,
                "^aid$": true,
                "^country$": true,
                "^street$": true,
                "^zip$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "AddressSingle": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "number": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^number$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "employee": {
                  "$ref": "#/$defs/EmployeeSingle"
                },
                "address": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/AddressSingle"
                  }
                },
                "phone-number": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/PhoneSingle"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^employee$": true,
                "^address$": true,
                "^phone-number$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "EmployeeSingle": {
      "$ref": "#/$defs/modern_1"
    },
    "PhoneSingle": {
      "$ref": "#/$defs/modern_3"
    }
  }
