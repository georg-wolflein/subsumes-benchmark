{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "org.eclipse.persistence.testing.jaxb.xmlvalue.Root",
  "type": "object",
  "properties": {
    "root": {
      "type": "object",
      "properties": {
        "thing": {
          "$ref": "#/$defs/BytesHolderWithXmlId"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "BytesHolderWithXmlId": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "properties": {
                "Include": {
                  "type": "object",
                  "properties": {
                    "href": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          ]
        },
        "Id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
