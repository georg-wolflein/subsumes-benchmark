{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "_id": {
                  "type": "string",
                  "pattern": "^[\\w\\.-_]+$",
                  "pbj": {
                    "type": "identifier",
                    "rule": "single",
                    "overridable": true
                  }
                },
                "_schema": {
                  "type": "string",
                  "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                  "default": "pbj:acme:blog:entity:comment:1-0-0"
                },
                "comment": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 65535,
                  "pbj": {
                    "type": "text",
                    "rule": "single"
                  }
                },
                "created_at": {
                  "type": "string",
                  "pattern": "^[1-9]{1}[0-9]{12,15}$",
                  "pbj": {
                    "type": "microtime",
                    "rule": "single"
                  }
                },
                "updated_at": {
                  "type": "string",
                  "pattern": "^[1-9]{1}[0-9]{12,15}$",
                  "pbj": {
                    "type": "microtime",
                    "rule": "single",
                    "useTypeDefault": false
                  }
                },
                "published_at": {
                  "type": "string",
                  "pattern": "^[1-9]{1}[0-9]{12,15}$",
                  "pbj": {
                    "type": "microtime",
                    "rule": "single"
                  }
                }
              },
              "required": [
                "_schema",
                "_id",
                "created_at"
              ]
            },
            {
              "patternProperties": {
                "^published_at$": true,
                "^updated_at$": true,
                "^_schema$": true,
                "^comment$": true,
                "^_id$": true,
                "^created_at$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
