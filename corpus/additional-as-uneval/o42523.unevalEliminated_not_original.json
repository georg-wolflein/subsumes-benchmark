{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o42523.unevalEliminated_not_original.json",
  "a": {
    "$id": "http://schemas.gdbots.io/json-schema/gdbots/common/mixin/taggable/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "tags": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
            "type": "string",
            "pattern": "^[\\w\\/\\.:-]+$"
          }
        },
        "additionalProperties": false,
        "description": "Tags is a map that categorizes data or tracks references in external systems. The tags names should be consistent and descriptive, e.g. fb_user_id:123, salesforce_customer_id:456."
      }
    },
    "additionalProperties": true
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "tags": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^tags$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$"
                  }
                },
                "description": "Tags is a map that categorizes data or tracks references in external systems. The tags names should be consistent and descriptive, e.g. fb_user_id:123, salesforce_customer_id:456."
              },
              {
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
