{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maxLength",
    "maximum",
    "minLength",
    "minimum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o42568.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o42568.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_]{1}[\\w-]*$",
                    "description": "A unique identifier (within the form) for the field. This value is not shown to the user and should NOT change once set."
                  },
                  "maps_to": {
                    "type": "string",
                    "default": "cf",
                    "pattern": "^[a-zA-Z_]{1}\\w*$",
                    "description": "The name of the schema field the answer will map to. By default this will go to the \"cf\" field which is a \"dynamic-field\" list containing all answers filled out on the form (ref \"gdbots:forms:mixin:send-submission\")."
                  },
                  "description": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 65535,
                    "description": "A short description to better explain this field."
                  },
                  "placeholder": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 255
                  },
                  "max_value": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0.0,
                    "maximum": 4294967295.0
                  },
                  "is_required": {
                    "type": "boolean"
                  },
                  "link_url": {
                    "type": "string",
                    "pattern": "^(https?:\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-]*)*\\/?$",
                    "description": "The URL to use for the replaced token \"{link}\" within the label or description."
                  },
                  "pii_impact": {
                    "type": "string",
                    "enum": [
                      "unknown",
                      "high",
                      "moderate",
                      "low"
                    ]
                  },
                  "decimals": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0.0,
                    "maximum": 6.0,
                    "description": "Number of decimal places to allow. A \"0\" denotes this number field will require an integer."
                  },
                  "_schema": {
                    "type": "string",
                    "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                    "default": "pbj:gdbots:forms:field:number-field:1-0-0"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 255,
                    "description": "The main text for the question/field."
                  },
                  "min_value": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0.0,
                    "maximum": 4294967295.0
                  },
                  "link_text": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 255,
                    "description": "The text that will replace the token \"{link}\" within the label or description."
                  }
                },
                "required": [
                  "_schema",
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^min_value$": true,
                  "^description$": true,
                  "^label$": true,
                  "^name$": true,
                  "^_schema$": true,
                  "^placeholder$": true,
                  "^pii_impact$": true,
                  "^max_value$": true,
                  "^link_text$": true,
                  "^maps_to$": true,
                  "^link_url$": true,
                  "^is_required$": true,
                  "^decimals$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://schemas.gdbots.io/json-schema/gdbots/forms/field/number-field/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "_schema": {
        "type": "string",
        "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
        "default": "pbj:gdbots:forms:field:number-field:1-0-0"
      },
      "name": {
        "type": "string",
        "pattern": "^[a-zA-Z_]{1}[\\w-]*$",
        "description": "A unique identifier (within the form) for the field. This value is not shown to the user and should NOT change once set."
      },
      "maps_to": {
        "type": "string",
        "default": "cf",
        "pattern": "^[a-zA-Z_]{1}\\w*$",
        "description": "The name of the schema field the answer will map to. By default this will go to the \"cf\" field which is a \"dynamic-field\" list containing all answers filled out on the form (ref \"gdbots:forms:mixin:send-submission\")."
      },
      "label": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255,
        "description": "The main text for the question/field."
      },
      "placeholder": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255
      },
      "description": {
        "type": "string",
        "minLength": 0,
        "maxLength": 65535,
        "description": "A short description to better explain this field."
      },
      "is_required": {
        "type": "boolean"
      },
      "link_text": {
        "type": "string",
        "minLength": 0,
        "maxLength": 255,
        "description": "The text that will replace the token \"{link}\" within the label or description."
      },
      "link_url": {
        "type": "string",
        "pattern": "^(https?:\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-]*)*\\/?$",
        "description": "The URL to use for the replaced token \"{link}\" within the label or description."
      },
      "pii_impact": {
        "type": "string",
        "enum": [
          "unknown",
          "high",
          "moderate",
          "low"
        ]
      },
      "min_value": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 4294967295
      },
      "max_value": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 4294967295
      },
      "decimals": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 6,
        "description": "Number of decimal places to allow. A \"0\" denotes this number field will require an integer."
      }
    },
    "required": [
      "_schema",
      "name"
    ],
    "additionalProperties": false
  }
}
