{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "email": {
                  "description": "Your email address",
                  "title": "Your email address",
                  "type": "string"
                },
                "refresh_token": {
                  "description": "Your OAuth refresh token",
                  "title": "Your OAuth refresh token",
                  "type": "string"
                },
                "reporting": {
                  "default": true,
                  "description": "Whether to report usage events to Mesosphere",
                  "title": "Usage Reporting",
                  "type": "boolean"
                },
                "token": {
                  "description": "Your OAuth access token",
                  "title": "Your OAuth access token",
                  "type": "string"
                },
                "mesos_master_url": {
                  "description": "Mesos Master URL.  Must be of the format: \"http://host:port\"",
                  "format": "uri",
                  "title": "Mesos Master URL",
                  "type": "string"
                },
                "timeout": {
                  "default": 5,
                  "description": "Request timeout in seconds",
                  "minimum": 1.0,
                  "title": "Request timeout in seconds",
                  "type": "integer"
                },
                "dcos_url": {
                  "description": "The URL to the location of the DCOS",
                  "format": "uri",
                  "title": "DCOS URL",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^refresh_token$": true,
                "^dcos_url$": true,
                "^mesos_master_url$": true,
                "^token$": true,
                "^timeout$": true,
                "^reporting$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
