{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Map"
  },
  "$defs": {
    "Map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "supportedGameModes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "imageUrl": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "contentId": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "supportedGameModes",
        "imageUrl",
        "id",
        "contentId"
      ]
    }
  }
}
