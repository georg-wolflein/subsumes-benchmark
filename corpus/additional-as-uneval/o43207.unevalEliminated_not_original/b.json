{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Map"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "supportedGameModes": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "id": {
                  "type": "string"
                },
                "contentId": {
                  "type": "string"
                },
                "imageUrl": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description",
                "supportedGameModes",
                "imageUrl",
                "id",
                "contentId"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^name$": true,
                "^id$": true,
                "^imageUrl$": true,
                "^supportedGameModes$": true,
                "^contentId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Map": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
