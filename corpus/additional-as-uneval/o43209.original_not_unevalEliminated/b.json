{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$ref": "#/$defs/Playlist"
  },
  "$defs": {
    "Playlist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "isRanked": {
          "type": "boolean"
        },
        "imageUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "gameMode": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "contentId": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "isRanked",
        "imageUrl",
        "gameMode",
        "isActive",
        "id",
        "contentId"
      ]
    }
  }
}
