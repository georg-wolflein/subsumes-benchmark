{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "subcategoryName": {
                  "type": "string"
                },
                "isCertification": {
                  "type": "boolean"
                },
                "isMythic": {
                  "type": "boolean"
                },
                "useType": {
                  "type": "string"
                },
                "supportedGameModes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "rarityType": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "internalSubcategoryName": {
                  "type": "string"
                },
                "levelRequirement": {
                  "type": "integer"
                },
                "internalCategoryName": {
                  "type": "string"
                },
                "isWearable": {
                  "type": "boolean"
                },
                "subcategoryOrder": {
                  "type": "integer"
                },
                "sellPrice": {
                  "type": "integer"
                },
                "certificationRequisitionId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "categoryName": {
                  "type": "string"
                },
                "rarity": {
                  "type": "string"
                },
                "hideIfNotAcquired": {
                  "type": "boolean"
                },
                "largeImageUrl": {
                  "type": "string"
                },
                "contentId": {
                  "type": "string"
                }
              },
              "required": [
                "supportedGameModes",
                "name",
                "description",
                "rarityType",
                "rarity",
                "isMythic",
                "isCertification",
                "isWearable",
                "hideIfNotAcquired",
                "useType",
                "largeImageUrl",
                "categoryName",
                "internalCategoryName",
                "subcategoryName",
                "internalSubcategoryName",
                "subcategoryOrder",
                "sellPrice",
                "levelRequirement",
                "certificationRequisitionId",
                "id",
                "contentId"
              ]
            },
            {
              "patternProperties": {
                "^isWearable$": true,
                "^internalCategoryName$": true,
                "^sellPrice$": true,
                "^description$": true,
                "^categoryName$": true,
                "^hideIfNotAcquired$": true,
                "^name$": true,
                "^levelRequirement$": true,
                "^certificationRequisitionId$": true,
                "^useType$": true,
                "^largeImageUrl$": true,
                "^contentId$": true,
                "^isCertification$": true,
                "^subcategoryOrder$": true,
                "^subcategoryName$": true,
                "^isMythic$": true,
                "^id$": true,
                "^internalSubcategoryName$": true,
                "^rarityType$": true,
                "^supportedGameModes$": true,
                "^rarity$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
