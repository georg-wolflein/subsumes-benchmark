{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "PlayerRankAmount": {
                  "type": "integer"
                },
                "MatchSpeedWinAmount": {
                  "type": "integer"
                },
                "SpartanRankModifier": {
                  "type": "number"
                },
                "TotalCreditsEarned": {
                  "type": "integer"
                },
                "Result": {
                  "type": "integer"
                },
                "TimePlayedAmount": {
                  "type": "number"
                },
                "BoostAmount": {
                  "type": "integer"
                },
                "ObjectivesCompletedAmount": {
                  "type": "integer"
                }
              },
              "required": [
                "Result",
                "TotalCreditsEarned",
                "SpartanRankModifier",
                "PlayerRankAmount",
                "TimePlayedAmount",
                "BoostAmount",
                "MatchSpeedWinAmount",
                "ObjectivesCompletedAmount"
              ]
            },
            {
              "patternProperties": {
                "^BoostAmount$": true,
                "^PlayerRankAmount$": true,
                "^Result$": true,
                "^MatchSpeedWinAmount$": true,
                "^SpartanRankModifier$": true,
                "^TotalCreditsEarned$": true,
                "^ObjectivesCompletedAmount$": true,
                "^TimePlayedAmount$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
