{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "SpartanRankSource": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "CommendationSource": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "RewardSourceType": {
                  "type": "integer"
                },
                "CommendationLevelId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "RewardSet": {
                  "type": "string"
                }
              },
              "required": [
                "RewardSet",
                "RewardSourceType",
                "SpartanRankSource",
                "CommendationLevelId",
                "CommendationSource"
              ]
            },
            {
              "patternProperties": {
                "^RewardSet$": true,
                "^CommendationSource$": true,
                "^SpartanRankSource$": true,
                "^RewardSourceType$": true,
                "^CommendationLevelId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
