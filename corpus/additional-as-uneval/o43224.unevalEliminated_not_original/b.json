{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "PrevTotalXP": {
                  "type": "integer"
                },
                "PerformanceXP": {
                  "type": [
                    "null",
                    "integer"
                  ]
                },
                "MatchSpeedWinAmount": {
                  "type": "integer"
                },
                "TotalXP": {
                  "type": "integer"
                },
                "PrevSpartanRank": {
                  "type": "integer"
                },
                "PlayerRankXPAward": {
                  "type": "integer"
                },
                "SpartanRankMatchXPScalar": {
                  "type": "number"
                },
                "PlayerTimePerformanceXPAward": {
                  "type": "integer"
                },
                "SpartanRank": {
                  "type": "integer"
                },
                "BoostAmount": {
                  "type": "integer"
                },
                "ObjectivesCompletedAmount": {
                  "type": "integer"
                }
              },
              "required": [
                "PrevSpartanRank",
                "SpartanRank",
                "PrevTotalXP",
                "TotalXP",
                "SpartanRankMatchXPScalar",
                "PlayerTimePerformanceXPAward",
                "PerformanceXP",
                "PlayerRankXPAward",
                "BoostAmount",
                "MatchSpeedWinAmount",
                "ObjectivesCompletedAmount"
              ]
            },
            {
              "patternProperties": {
                "^BoostAmount$": true,
                "^PrevSpartanRank$": true,
                "^TotalXP$": true,
                "^MatchSpeedWinAmount$": true,
                "^PlayerRankXPAward$": true,
                "^PlayerTimePerformanceXPAward$": true,
                "^SpartanRankMatchXPScalar$": true,
                "^SpartanRank$": true,
                "^PrevTotalXP$": true,
                "^ObjectivesCompletedAmount$": true,
                "^PerformanceXP$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
