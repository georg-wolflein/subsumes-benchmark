{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "MedalStatCounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StatCount"
      }
    },
    "ImpulseStatCounts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StatCount"
      }
    },
    "MedalTimelapses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Timelapse"
      }
    },
    "ImpulseTimelapses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Timelapse"
      }
    }
  },
  "required": [
    "MedalStatCounts",
    "ImpulseStatCounts",
    "MedalTimelapses",
    "ImpulseTimelapses"
  ],
  "$defs": {
    "StatCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string"
        },
        "Count": {
          "type": "integer"
        }
      },
      "required": [
        "Id",
        "Count"
      ]
    },
    "Timelapse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string"
        },
        "Timelapse": {
          "type": "string"
        }
      },
      "required": [
        "Id",
        "Timelapse"
      ]
    }
  }
}
