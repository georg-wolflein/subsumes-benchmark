{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "GameBaseVariantRank": {
                  "type": "integer"
                },
                "NumberOfMatchesCompleted": {
                  "type": "integer"
                },
                "GameBaseVariantId": {
                  "type": "string"
                },
                "NumberOfMatchesWon": {
                  "type": "integer"
                }
              },
              "required": [
                "GameBaseVariantRank",
                "NumberOfMatchesCompleted",
                "GameBaseVariantId",
                "NumberOfMatchesWon"
              ]
            },
            {
              "patternProperties": {
                "^GameBaseVariantRank$": true,
                "^NumberOfMatchesCompleted$": true,
                "^GameBaseVariantId$": true,
                "^NumberOfMatchesWon$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
