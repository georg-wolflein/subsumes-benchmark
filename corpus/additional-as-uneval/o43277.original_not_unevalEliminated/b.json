{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": [
    "object",
    "null"
  ],
  "additionalProperties": false,
  "properties": {
    "PreviousTotalXP": {
      "type": "integer"
    },
    "GameplayXP": {
      "type": "integer"
    },
    "ChallengesXP": {
      "type": "integer"
    },
    "UpdatedTotalXP": {
      "type": "integer"
    },
    "CompletedSpartanRanks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CompletedSpartanRank"
      }
    }
  },
  "required": [
    "PreviousTotalXP",
    "GameplayXP",
    "ChallengesXP",
    "UpdatedTotalXP",
    "CompletedSpartanRanks"
  ],
  "$defs": {
    "CompletedSpartanRank": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string"
        },
        "PacksAwarded": {
          "type": "integer"
        }
      },
      "required": [
        "Id",
        "PacksAwarded"
      ]
    }
  }
}
