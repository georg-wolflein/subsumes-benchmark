{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/modern_2"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "TotalMatchesWon": {
                  "type": "integer"
                },
                "TotalMatchesCompleted": {
                  "type": "integer"
                },
                "TotalMatchesLost": {
                  "type": "integer"
                },
                "TotalMatchesStarted": {
                  "type": "integer"
                },
                "TotalTimePlayed": {
                  "type": "string"
                },
                "TotalLeaderPowersCast": {
                  "type": "integer"
                }
              },
              "required": [
                "TotalTimePlayed",
                "TotalMatchesStarted",
                "TotalMatchesCompleted",
                "TotalMatchesWon",
                "TotalMatchesLost",
                "TotalLeaderPowersCast"
              ]
            },
            {
              "patternProperties": {
                "^TotalMatchesLost$": true,
                "^TotalLeaderPowersCast$": true,
                "^TotalMatchesCompleted$": true,
                "^TotalMatchesWon$": true,
                "^TotalMatchesStarted$": true,
                "^TotalTimePlayed$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
