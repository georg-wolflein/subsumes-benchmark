{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Git LFS HTTPS Batch API Response",
  "type": "object",
  "properties": {
    "transfer": {
      "type": "string"
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "oid": {
            "type": "string"
          },
          "size": {
            "type": "number",
            "minimum": 0
          },
          "authenticated": {
            "type": "boolean"
          },
          "actions": {
            "type": "object",
            "properties": {
              "download": {
                "$ref": "#/$defs/action"
              },
              "upload": {
                "$ref": "#/$defs/action"
              },
              "verify": {
                "$ref": "#/$defs/action"
              }
            },
            "additionalProperties": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "number"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "oid",
          "size"
        ],
        "additionalProperties": false
      }
    },
    "message": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "documentation_url": {
      "type": "string"
    }
  },
  "required": [
    "objects"
  ],
  "$defs": {
    "action": {
      "type": "object",
      "properties": {
        "href": {
          "type": "string"
        },
        "header": {
          "type": "object",
          "additionalProperties": true
        },
        "expires_in": {
          "type": "number",
          "maximum": 2147483647,
          "minimum": -2147483647
        },
        "expires_at": {
          "type": "string"
        }
      },
      "required": [
        "href"
      ],
      "additionalProperties": false
    }
  }
}
