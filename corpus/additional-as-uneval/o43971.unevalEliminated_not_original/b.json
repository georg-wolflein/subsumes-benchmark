{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "BootNotificationRequest",
              "type": "object",
              "properties": {
                "firmwareVersion": {
                  "type": "string",
                  "maxLength": 50
                },
                "chargePointVendor": {
                  "type": "string",
                  "maxLength": 20
                },
                "chargeBoxSerialNumber": {
                  "type": "string",
                  "maxLength": 25
                },
                "chargePointSerialNumber": {
                  "type": "string",
                  "maxLength": 25
                },
                "iccid": {
                  "type": "string",
                  "maxLength": 20
                },
                "chargePointModel": {
                  "type": "string",
                  "maxLength": 20
                },
                "meterSerialNumber": {
                  "type": "string",
                  "maxLength": 25
                },
                "meterType": {
                  "type": "string",
                  "maxLength": 25
                },
                "imsi": {
                  "type": "string",
                  "maxLength": 20
                }
              },
              "required": [
                "chargePointVendor",
                "chargePointModel"
              ]
            },
            {
              "patternProperties": {
                "^imsi$": true,
                "^chargePointModel$": true,
                "^chargePointVendor$": true,
                "^firmwareVersion$": true,
                "^chargeBoxSerialNumber$": true,
                "^meterType$": true,
                "^chargePointSerialNumber$": true,
                "^iccid$": true,
                "^meterSerialNumber$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
