{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "ChangeConfigurationRequest",
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "maxLength": 50
                },
                "value": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "key",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
