{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "FirmwareStatusNotificationRequest",
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "Downloaded",
                    "DownloadFailed",
                    "Downloading",
                    "Idle",
                    "InstallationFailed",
                    "Installing",
                    "Installed"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            {
              "patternProperties": {
                "^status$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
