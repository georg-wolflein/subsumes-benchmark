{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "timestamp": {
                  "_format": "date-time",
                  "type": "string"
                },
                "idTag": {
                  "maxLength": 20,
                  "type": "string"
                },
                "reason": {
                  "enum": [
                    "EmergencyStop",
                    "EVDisconnected",
                    "HardReset",
                    "Local",
                    "Other",
                    "PowerLoss",
                    "Reboot",
                    "Remote",
                    "SoftReset",
                    "UnlockCommand",
                    "DeAuthorized"
                  ],
                  "type": "string"
                },
                "transactionId": {
                  "type": "integer"
                },
                "transactionData": {
                  "items": {
                    "properties": {
                      "sampledValue": {
                        "items": {
                          "properties": {
                            "format": {
                              "enum": [
                                "Raw",
                                "SignedData"
                              ],
                              "type": "string"
                            },
                            "location": {
                              "enum": [
                                "Cable",
                                "EV",
                                "Inlet",
                                "Outlet",
                                "Body"
                              ],
                              "type": "string"
                            },
                            "phase": {
                              "enum": [
                                "L1",
                                "L2",
                                "L3",
                                "N",
                                "L1-N",
                                "L2-N",
                                "L3-N",
                                "L1-L2",
                                "L2-L3",
                                "L3-L1"
                              ],
                              "type": "string"
                            },
                            "context": {
                              "enum": [
                                "Interruption.Begin",
                                "Interruption.End",
                                "Sample.Clock",
                                "Sample.Periodic",
                                "Transaction.Begin",
                                "Transaction.End",
                                "Trigger",
                                "Other"
                              ],
                              "type": "string"
                            },
                            "unit": {
                              "enum": [
                                "Wh",
                                "kWh",
                                "varh",
                                "kvarh",
                                "W",
                                "kW",
                                "VA",
                                "kVA",
                                "var",
                                "kvar",
                                "A",
                                "V",
                                "K",
                                "Celcius",
                                "Fahrenheit",
                                "Percent"
                              ],
                              "type": "string"
                            },
                            "measurand": {
                              "enum": [
                                "Energy.Active.Export.Register",
                                "Energy.Active.Import.Register",
                                "Energy.Reactive.Export.Register",
                                "Energy.Reactive.Import.Register",
                                "Energy.Active.Export.Interval",
                                "Energy.Active.Import.Interval",
                                "Energy.Reactive.Export.Interval",
                                "Energy.Reactive.Import.Interval",
                                "Power.Active.Export",
                                "Power.Active.Import",
                                "Power.Offered",
                                "Power.Reactive.Export",
                                "Power.Reactive.Import",
                                "Power.Factor",
                                "Current.Import",
                                "Current.Export",
                                "Current.Offered",
                                "Voltage",
                                "Frequency",
                                "Temperature",
                                "SoC",
                                "RPM"
                              ],
                              "type": "string"
                            },
                            "value": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "value"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "timestamp": {
                        "_format": "date-time",
                        "type": "string"
                      }
                    },
                    "required": [
                      "timestamp",
                      "sampledValue"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "meterStop": {
                  "type": "integer"
                }
              },
              "required": [
                "transactionId",
                "timestamp",
                "reason",
                "meterStop"
              ],
              "title": "StopTransactionRequest",
              "type": "object"
            },
            {
              "patternProperties": {
                "^meterStop$": true,
                "^idTag$": true,
                "^timestamp$": true,
                "^transactionData$": true,
                "^transactionId$": true,
                "^reason$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
