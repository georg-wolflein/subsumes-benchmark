{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "format",
    "maximum",
    "minimum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o44051.unevalEliminated_not_original.json",
  "a": {
    "$id": "https://lax.elifesciences.org/ingest-publish-request-schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "lax ingest+publish request schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "action": {
        "enum": [
          "ingest",
          "publish",
          "ingest+publish"
        ]
      },
      "location": {
        "description": "the location of the article to ingest/publish",
        "type": "string",
        "format": "uri",
        "pattern": "^(https|file)://"
      },
      "id": {
        "description": "article identifier",
        "type": "string"
      },
      "version": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9
      },
      "force": {
        "description": "force ingest/publish action. intended for silent corrections. use with caution.",
        "type": "boolean"
      },
      "token": {
        "description": "data to be returned to the sender once action complete",
        "type": "string"
      }
    },
    "required": [
      "action",
      "location",
      "id",
      "version",
      "token"
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "lax ingest+publish request schema",
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 1.0,
                    "maximum": 9.0
                  },
                  "id": {
                    "description": "article identifier",
                    "type": "string"
                  },
                  "token": {
                    "description": "data to be returned to the sender once action complete",
                    "type": "string"
                  },
                  "action": {
                    "enum": [
                      "ingest",
                      "publish",
                      "ingest+publish"
                    ]
                  },
                  "force": {
                    "description": "force ingest/publish action. intended for silent corrections. use with caution.",
                    "type": "boolean"
                  },
                  "location": {
                    "description": "the location of the article to ingest/publish",
                    "type": "string",
                    "format": "uri",
                    "pattern": "^(https|file)://"
                  }
                },
                "required": [
                  "action",
                  "location",
                  "id",
                  "version",
                  "token"
                ]
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^action$": true,
                  "^token$": true,
                  "^id$": true,
                  "^location$": true,
                  "^force$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
