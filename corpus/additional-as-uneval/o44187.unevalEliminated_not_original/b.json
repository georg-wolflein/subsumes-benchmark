{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "schema for type code",
              "type": "object",
              "properties": {
                "Z1K2": {
                  "type": "string",
                  "pattern": "^[a-z_A-Z0-9]+$"
                },
                "Z1K5": true,
                "Z1K3": true,
                "Z16K1": {
                  "enum": [
                    "javascript",
                    "python"
                  ]
                },
                "Z1K4": true,
                "Z16K2": {
                  "type": "string"
                },
                "Z1K1": {
                  "enum": [
                    "Z16"
                  ]
                }
              },
              "required": [
                "Z1K1",
                "Z16K1",
                "Z16K2"
              ]
            },
            {
              "patternProperties": {
                "^Z1K2$": true,
                "^Z16K1$": true,
                "^Z1K4$": true,
                "^Z16K2$": true,
                "^Z1K5$": true,
                "^Z1K1$": true,
                "^Z1K3$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
