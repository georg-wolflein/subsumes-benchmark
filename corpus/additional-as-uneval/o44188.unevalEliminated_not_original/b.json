{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "schema for type argument",
              "type": "object",
              "properties": {
                "Z1K1": {
                  "enum": [
                    "Z18"
                  ]
                },
                "Z18K1": {
                  "type": "string",
                  "pattern": "^([ZB][1-9][0-9]*)?K[1-9][0-9]*$"
                }
              },
              "required": [
                "Z1K1",
                "Z18K1"
              ]
            },
            {
              "patternProperties": {
                "^Z1K1$": true,
                "^Z18K1$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
