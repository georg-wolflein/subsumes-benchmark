{
  "$id": "http://schema.envirocar.org/badge.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "name",
    "displayName",
    "description"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "displayName": {
      "$ref": "#/$defs/modern_1"
    },
    "description": {
      "$ref": "#/$defs/modern_2"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    }
  }
}
