{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "unit"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "created": {
                  "type": "string",
                  "format": "date-time"
                },
                "modified": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^unit$": true,
                "^created$": true,
                "^modified$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
