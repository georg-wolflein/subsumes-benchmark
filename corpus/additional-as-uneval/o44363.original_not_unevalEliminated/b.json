{
  "$id": "http://schema.envirocar.org/phenomenon.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "unit"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "unit": {
      "type": "string"
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "modified": {
      "type": "string",
      "format": "date-time"
    }
  }
}
