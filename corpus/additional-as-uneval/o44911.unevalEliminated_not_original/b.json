{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "log file entry for ingestion by tsd aggregator",
  "properties": {
    "name": {
      "pattern": "^aint.metrics$",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "time": {
      "_format": "date-time",
      "type": "string"
    },
    "level": {
      "pattern": "^info$",
      "type": "string"
    },
    "context": {
      "properties": {},
      "type": "object"
    },
    "data": {
      "$ref": "#/$defs/data"
    }
  },
  "required": [
    "time",
    "name",
    "level",
    "data"
  ],
  "title": "Query Log",
  "type": "object",
  "$defs": {
    "sampleObject": {
      "properties": {
        "unit": {
          "enum": [
            "nanosecond",
            "microsecond",
            "millisecond",
            "second",
            "minute",
            "hour",
            "day",
            "week",
            "bit",
            "byte",
            "kilobit",
            "kilobyte",
            "megabit",
            "megabyte",
            "gigabit",
            "gigabyte",
            "terabyte",
            "petabyte"
          ],
          "type": "string"
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "finalTimestamp": {
                  "_format": "date-time",
                  "type": "string"
                },
                "initTimestamp": {
                  "_format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "initTimestamp",
                "finalTimestamp"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^finalTimestamp$": true,
                "^initTimestamp$": true
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "data": {
      "properties": {
        "gauges": {
          "$ref": "#/$defs/metricsList"
        },
        "counters": {
          "$ref": "#/$defs/metricsList"
        },
        "annotations": {
          "$ref": "#/$defs/modern_1"
        },
        "timers": {
          "$ref": "#/$defs/metricsList"
        },
        "version": {
          "pattern": "^2e$",
          "type": "string"
        }
      },
      "required": [
        "annotations",
        "version"
      ],
      "type": "object"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/dataElement"
              }
            }
          ]
        }
      ]
    },
    "metricsList": {
      "$ref": "#/$defs/modern_2"
    },
    "dataElement": {
      "properties": {
        "values": {
          "items": {
            "$ref": "#/$defs/sampleObject"
          },
          "type": "array"
        }
      },
      "required": [
        "values"
      ],
      "type": "object"
    }
  }
}
