{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "integer"
                },
                "end": {
                  "type": "integer"
                }
              },
              "required": [
                "start",
                "end"
              ]
            },
            {
              "patternProperties": {
                "^start$": true,
                "^end$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "custom": {
                  "type": "string"
                }
              },
              "required": [
                "custom"
              ]
            },
            {
              "patternProperties": {
                "^custom$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "version": "1.0.0",
              "type": "object",
              "properties": {
                "adventure": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^adventure$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "published": {
                  "type": "string",
                  "format": "date"
                },
                "contents": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "id": {
                  "type": "string"
                },
                "storyline": {
                  "type": "string",
                  "enum": [
                    "Starter Set",
                    "Tyranny of Dragons",
                    "Elemental Evil",
                    "Rage of Demons",
                    "Curse of Strahd",
                    "Storm King's Thunder",
                    "Tales from the Yawning Portal",
                    "Tomb of Annihilation"
                  ]
                },
                "level": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_5"
                    },
                    {
                      "$ref": "#/$defs/modern_6"
                    }
                  ]
                }
              },
              "required": [
                "name",
                "id",
                "contents",
                "level",
                "published",
                "storyline"
              ]
            },
            {
              "patternProperties": {
                "^contents$": true,
                "^level$": true,
                "^name$": true,
                "^id$": true,
                "^published$": true,
                "^storyline$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "headers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ordinal": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^headers$": true,
                "^ordinal$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "chapter",
                    "appendix",
                    "part",
                    "episode"
                  ]
                },
                "identifier": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              },
              "required": [
                "type",
                "identifier"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^identifier$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
