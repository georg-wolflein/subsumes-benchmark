{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "version": "1.0.0",
              "type": "object",
              "properties": {
                "book": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^book$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "contents": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              },
              "required": [
                "name",
                "id",
                "contents"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^id$": true,
                "^contents$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "headers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "ordinal": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^headers$": true,
                "^ordinal$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "chapter",
                    "appendix",
                    "part",
                    "episode"
                  ]
                },
                "identifier": {
                  "type": [
                    "integer",
                    "string"
                  ]
                }
              },
              "required": [
                "type",
                "identifier"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^identifier$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
