{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string"
                },
                "page": {
                  "type": "string"
                },
                "stealth": {
                  "type": "boolean"
                },
                "namePrefix": {
                  "type": "string"
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "properties": {}
                  }
                },
                "nameSuffix": {
                  "type": "string"
                },
                "resist": {
                  "type": "string"
                },
                "rarity": {
                  "type": "string"
                },
                "modifier": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                },
                "genericBonus": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "reqAttune": {
                  "type": "string"
                }
              },
              "required": [
                "rarity",
                "source",
                "page"
              ]
            },
            {
              "patternProperties": {
                "^namePrefix$": true,
                "^stealth$": true,
                "^tier$": true,
                "^nameSuffix$": true,
                "^entries$": true,
                "^source$": true,
                "^page$": true,
                "^genericBonus$": true,
                "^resist$": true,
                "^reqAttune$": true,
                "^modifier$": true,
                "^rarity$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "_category": {
                  "type": "string"
                },
                "__text": {
                  "type": "string"
                },
                "toString": {
                  "type": "array"
                }
              },
              "required": [
                "_category",
                "__text",
                "toString"
              ]
            },
            {
              "patternProperties": {
                "^_category$": true,
                "^__text$": true,
                "^toString$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "version": "1.0.0",
              "type": "object",
              "properties": {
                "variant": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "variant"
              ]
            },
            {
              "patternProperties": {
                "^variant$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "excludes": {
                  "$ref": "#/$defs/modern_3"
                },
                "entries": {
                  "type": "array",
                  "items": {
                    "properties": {}
                  }
                },
                "noDisplay": {
                  "type": "boolean"
                },
                "requires": {
                  "$ref": "#/$defs/modern_4"
                },
                "inherits": {
                  "$ref": "#/$defs/modern_5"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "inherits"
              ]
            },
            {
              "patternProperties": {
                "^noDisplay$": true,
                "^name$": true,
                "^type$": true,
                "^excludes$": true,
                "^requires$": true,
                "^entries$": true,
                "^inherits$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "page": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^page$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "sword": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "ammunition": {
                  "type": "boolean"
                },
                "dmgType": {
                  "type": "string"
                },
                "axe": {
                  "type": "boolean"
                },
                "weapon": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string"
                },
                "armor": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^armor$": true,
                "^sword$": true,
                "^weapon$": true,
                "^name$": true,
                "^type$": true,
                "^ammunition$": true,
                "^axe$": true,
                "^dmgType$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
