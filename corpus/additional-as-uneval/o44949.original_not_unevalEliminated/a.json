{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "version": "1.0.0",
              "type": "object",
              "properties": {
                "cr": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "cr"
              ]
            },
            {
              "patternProperties": {
                "^cr$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "savedc": {
                  "type": "integer"
                },
                "hpmin": {
                  "type": "integer"
                },
                "ac": {
                  "type": "integer"
                },
                "attackbonus": {
                  "type": "integer"
                },
                "dprmax": {
                  "type": "integer"
                },
                "hpmax": {
                  "type": "integer"
                },
                "dprmin": {
                  "type": "integer"
                },
                "pb": {
                  "type": "integer"
                },
                "_cr": {
                  "type": "string"
                }
              },
              "required": [
                "_cr",
                "pb",
                "ac",
                "hpmin",
                "hpmax",
                "attackbonus",
                "dprmin",
                "dprmax",
                "savedc"
              ]
            },
            {
              "patternProperties": {
                "^dprmin$": true,
                "^hpmin$": true,
                "^savedc$": true,
                "^hpmax$": true,
                "^attackbonus$": true,
                "^pb$": true,
                "^_cr$": true,
                "^dprmax$": true,
                "^ac$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
