{
  "$id": "http://grycap.upv.es/radl/schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "RADL JSON scheme",
  "type": "array",
  "items": {
    "$ref": "#/$defs/aspect"
  },
  "minItems": 1,
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "pattern": "^deploy$"
                },
                "system": {
                  "$ref": "#/$defs/idString"
                },
                "vm_number": {
                  "type": "integer",
                  "minimum": 1.0
                },
                "cloud_id": {
                  "$ref": "#/$defs/idString"
                }
              },
              "required": [
                "system",
                "vm_number"
              ]
            },
            {
              "patternProperties": {
                "^class$": true,
                "^system$": true,
                "^vm_number$": true,
                "^cloud_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "contextualize": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "$ref": "#/$defs/idString"
                },
                "id": {
                  "$ref": "#/$defs/idString"
                },
                "reference": {
                  "type": "boolean",
                  "enum": [
                    true
                  ]
                }
              },
              "required": [
                "class",
                "id",
                "reference"
              ]
            },
            {
              "patternProperties": {
                "^class$": true,
                "^id$": true,
                "^reference$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "contextualizeItem": {
      "$ref": "#/$defs/modern_3"
    },
    "features": {
      "$ref": "#/$defs/modern_4"
    },
    "aspect": {
      "oneOf": [
        {
          "$ref": "#/$defs/configure"
        },
        {
          "$ref": "#/$defs/contextualize"
        },
        {
          "$ref": "#/$defs/deploy"
        },
        {
          "$ref": "#/$defs/cfeatures"
        }
      ]
    },
    "configure": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "pattern": "^contextualize$"
                },
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/contextualizeItem"
                  }
                }
              },
              "required": [
                "class"
              ]
            },
            {
              "patternProperties": {
                "^class$": true,
                "^items$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "cfeaturesNoReference": {
      "allOf": [
        {
          "$ref": "#/$defs/class"
        },
        {
          "$ref": "#/$defs/features"
        },
        {
          "type": "object",
          "properties": {
            "softs": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/softFeatures"
              }
            },
            "reference": {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          }
        }
      ],
      "not": {
        "$ref": "#/$defs/configure"
      }
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z._\\-][a-zA-Z0-9._\\-]*$": {
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/features"
                    },
                    {
                      "$ref": "#/$defs/reference"
                    },
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "number"
                          },
                          {
                            "type": "string"
                          },
                          {
                            "$ref": "#/$defs/features"
                          },
                          {
                            "$ref": "#/$defs/reference"
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z._\\-][a-zA-Z0-9._\\-]*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "reference": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "class": {
                  "type": "string",
                  "pattern": "^configure$"
                },
                "id": {
                  "$ref": "#/$defs/idString"
                },
                "recipe": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    },
                    {
                      "type": "array"
                    }
                  ]
                }
              },
              "required": [
                "class",
                "id",
                "recipe"
              ]
            },
            {
              "patternProperties": {
                "^class$": true,
                "^id$": true,
                "^recipe$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "softFeatures": {
      "type": "object",
      "properties": {
        "weight": {
          "type": "number",
          "default": 0
        },
        "items": {
          "$ref": "#/$defs/features"
        }
      }
    },
    "cfeatures": {
      "oneOf": [
        {
          "$ref": "#/$defs/reference"
        },
        {
          "$ref": "#/$defs/cfeaturesNoReference"
        }
      ]
    },
    "deploy": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "system": {
                  "$ref": "#/$defs/idString"
                },
                "configure": {
                  "$ref": "#/$defs/idString"
                },
                "step": {
                  "type": "integer",
                  "minimum": 0.0
                }
              },
              "required": [
                "system",
                "configure"
              ]
            },
            {
              "patternProperties": {
                "^system$": true,
                "^configure$": true,
                "^step$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "class": {
      "type": "object",
      "properties": {
        "class": {
          "$ref": "#/$defs/idString"
        },
        "id": {
          "$ref": "#/$defs/idString"
        }
      },
      "required": [
        "class",
        "id"
      ]
    },
    "idString": {
      "type": "string",
      "pattern": "^[a-zA-Z._\\-][a-zA-Z0-9._\\-]*$"
    }
  }
}
