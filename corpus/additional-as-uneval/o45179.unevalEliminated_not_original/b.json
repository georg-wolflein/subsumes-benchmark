{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "aggregate": {
                    "type": "object",
                    "properties": {
                      "byes": {
                        "type": "number"
                      },
                      "desertions": {
                        "type": "number"
                      },
                      "forfeits": {
                        "type": "number"
                      },
                      "wins": {
                        "type": "number"
                      },
                      "losses": {
                        "type": "number"
                      }
                    }
                  },
                  "id": {
                    "type": "number"
                  },
                  "members": {
                    "type": "array",
                    "items": true
                  },
                  "ladders": {
                    "type": "object",
                    "properties": {}
                  },
                  "games": {
                    "type": "array",
                    "items": true
                  }
                },
                "required": [
                  "id",
                  "members",
                  "name",
                  "state",
                  "aggregate",
                  "ladders",
                  "games"
                ]
              },
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
