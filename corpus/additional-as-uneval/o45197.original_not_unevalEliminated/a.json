{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number"
                  },
                  "name": {
                    "type": "string"
                  },
                  "icon": {
                    "type": "string"
                  },
                  "attributes": {
                    "type": "object",
                    "properties": {
                      "Toughness": {
                        "type": "number"
                      },
                      "Power": {
                        "type": "number"
                      },
                      "CritDamage": {
                        "type": "number"
                      }
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "icon",
                  "attributes"
                ]
              },
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
