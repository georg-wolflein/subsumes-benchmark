{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "stats": {
                    "type": "object",
                    "properties": {
                      "offense": {
                        "type": "number"
                      },
                      "defense": {
                        "type": "number"
                      },
                      "speed": {
                        "type": "number"
                      }
                    }
                  },
                  "id": {
                    "type": "string"
                  },
                  "skins": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "icon": {
                          "type": "string"
                        },
                        "id": {
                          "type": "number"
                        },
                        "unlock_items": {
                          "type": "array",
                          "items": {
                            "type": "number"
                          }
                        },
                        "default": {
                          "type": "boolean"
                        }
                      },
                      "required": [
                        "id",
                        "name",
                        "icon",
                        "default",
                        "unlock_items"
                      ]
                    }
                  },
                  "type": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "underlay": {
                    "type": "string"
                  },
                  "overlay": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "description",
                  "type",
                  "stats",
                  "overlay",
                  "underlay",
                  "skins"
                ]
              },
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
