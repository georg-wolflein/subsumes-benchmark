                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "team_id": {
                    "type": "number"
                  },
                  "rank": {
                    "type": "number"
                  },
                  "id": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "team": {
                    "type": "string"
                  },
                  "scores": {
                    "type": "array",
