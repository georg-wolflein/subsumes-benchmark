                      }
                    }
                  },
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "type",
                  "flags",
                  "restrictions",
                  "rarity",
                  "id",
                  "icon"
                ]
              },
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
