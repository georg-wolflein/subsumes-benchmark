{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "elite": {
                    "type": "boolean"
                  },
                  "background": {
                    "type": "string"
                  },
                  "minor_traits": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  },
                  "icon": {
                    "type": "string"
                  },
                  "id": {
                    "type": "number"
                  },
                  "profession": {
                    "type": "string"
                  },
                  "profession_icon": {
                    "type": "string"
                  },
                  "profession_icon_big": {
                    "type": "string"
                  },
                  "weapon_trait": {
                    "type": "number"
                  },
                  "major_traits": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "profession",
                  "elite",
                  "minor_traits",
                  "major_traits",
                  "icon",
                  "background"
                ]
              },
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
