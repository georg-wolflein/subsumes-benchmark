{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "number"
                  },
                  "tiers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "yaks_required": {
                          "type": "number"
                        },
                        "upgrades": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "name": {
                                "type": "string"
                              },
                              "description": {
                                "type": "string"
                              },
                              "icon": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "name",
                              "description",
                              "icon"
                            ]
                          }
                        }
                      },
                      "required": [
                        "name",
                        "yaks_required",
                        "upgrades"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "tiers"
                ]
              },
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
