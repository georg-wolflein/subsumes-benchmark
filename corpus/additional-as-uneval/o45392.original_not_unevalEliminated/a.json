{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "fileReplacement": {
      "oneOf": [
        {
          "$ref": "#/$defs/modern_1"
        },
        {
          "$ref": "#/$defs/modern_2"
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "replaceWith": {
                  "type": "string"
                },
                "src": {
                  "type": "string"
                }
              },
              "required": [
                "src",
                "replaceWith"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^replaceWith$": true,
                "^src$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "replace": {
                  "type": "string"
                },
                "with": {
                  "type": "string"
                }
              },
              "required": [
                "replace",
                "with"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^replace$": true,
                "^with$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "namedChunks": {
                  "default": true,
                  "description": "Use file name for lazy loaded chunks.",
                  "type": "boolean"
                },
                "verbose": {
                  "default": false,
                  "description": "Adds more details to output logging.",
                  "type": "boolean"
                },
                "commonChunk": {
                  "default": true,
                  "description": "Use a separate bundle containing code used across multiple bundles.",
                  "type": "boolean"
                },
                "watch": {
                  "default": false,
                  "description": "Run build when files change.",
                  "type": "boolean"
                },
                "fileReplacements": {
                  "default": [],
                  "description": "Replace files with other files in the build.",
                  "items": {
                    "$ref": "#/$defs/fileReplacement"
                  },
                  "type": "array"
                },
                "main": {
                  "description": "The name of the main entry-point file.",
                  "type": "string"
                },
                "deleteOutputPath": {
                  "default": true,
                  "description": "delete-output-path",
                  "type": "boolean"
                },
                "forkTypeChecker": {
                  "default": true,
                  "description": "Run the TypeScript type checker in a forked process.",
                  "type": "boolean"
                },
                "sourceMap": {
                  "default": true,
                  "description": "Output sourcemaps.",
                  "type": "boolean"
                },
                "showCircularDependencies": {
                  "default": true,
                  "description": "Show circular dependency warnings on builds.",
                  "type": "boolean"
                },
                "i18nLocale": {
                  "description": "Locale to use for i18n.",
                  "type": "string"
                },
                "preserveSymlinks": {
                  "default": false,
                  "description": "Do not use the real path when resolving modules.",
                  "type": "boolean"
                },
                "outputHashing": {
                  "default": "none",
                  "description": "Define the output filename cache-busting hashing mode.",
                  "enum": [
                    "none",
                    "all",
                    "media",
                    "bundles"
                  ],
                  "type": "string"
                },
                "tsConfig": {
                  "default": "tsconfig.app.json",
                  "description": "The name of the TypeScript configuration file.",
                  "type": "string"
                },
                "stylePreprocessorOptions": {
                  "$ref": "#/$defs/modern_4"
                },
                "poll": {
                  "description": "Enable and define the file watching poll time period in milliseconds.",
                  "type": "number"
                },
                "i18nMissingTranslation": {
                  "description": "How to handle missing translations for i18n.",
                  "type": "string"
                },
                "bundleDependencies": {
                  "default": "none",
                  "description": "Available on server platform only. Which external dependencies to bundle into the module. By default, all of node_modules will be kept as requires.",
                  "enum": [
                    "none",
                    "all"
                  ],
                  "type": "string"
                },
                "vendorChunk": {
                  "default": true,
                  "description": "Use a separate bundle containing only vendor libraries.",
                  "type": "boolean"
                },
                "i18nFile": {
                  "description": "Localization file to use for i18n.",
                  "type": "string"
                },
                "evalSourceMap": {
                  "default": false,
                  "description": "Output in-file eval sourcemaps.",
                  "type": "boolean"
                },
                "extractLicenses": {
                  "default": true,
                  "description": "Extract all licenses in a separate file, in the case of production builds only.",
                  "type": "boolean"
                },
                "i18nFormat": {
                  "description": "Format of the localization file specified with --i18n-file.",
                  "type": "string"
                },
                "statsJson": {
                  "default": false,
                  "description": "Generates a 'stats.json' file which can be analyzed using tools such as: #webpack-bundle-analyzer' or https: //webpack.github.io/analyse.",
                  "type": "boolean"
                },
                "progress": {
                  "default": true,
                  "description": "Log progress to the console while building.",
                  "type": "boolean"
                },
                "optimization": {
                  "default": false,
                  "description": "Defines the optimization level of the build.",
                  "type": "boolean"
                },
                "lazyModules": {
                  "default": [],
                  "description": "List of additional NgModule files that will be lazy loaded. Lazy router modules with be discovered automatically.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "outputPath": {
                  "description": "Path where output will be placed.",
                  "type": "string"
                },
                "vendorSourceMap": {
                  "default": false,
                  "description": "Resolve vendor packages sourcemaps.",
                  "type": "boolean"
                }
              },
              "required": [
                "outputPath",
                "main",
                "tsConfig"
              ],
              "title": "Angular Webpack Architect Builder Schema"
            },
            {
              "patternProperties": {
                "^namedChunks$": true,
                "^tsConfig$": true,
                "^extractLicenses$": true,
                "^i18nFile$": true,
                "^watch$": true,
                "^bundleDependencies$": true,
                "^i18nMissingTranslation$": true,
                "^forkTypeChecker$": true,
                "^stylePreprocessorOptions$": true,
                "^evalSourceMap$": true,
                "^i18nFormat$": true,
                "^lazyModules$": true,
                "^outputPath$": true,
                "^fileReplacements$": true,
                "^vendorSourceMap$": true,
                "^main$": true,
                "^progress$": true,
                "^statsJson$": true,
                "^showCircularDependencies$": true,
                "^commonChunk$": true,
                "^vendorChunk$": true,
                "^outputHashing$": true,
                "^verbose$": true,
                "^sourceMap$": true,
                "^preserveSymlinks$": true,
                "^deleteOutputPath$": true,
                "^poll$": true,
                "^i18nLocale$": true,
                "^optimization$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Options to pass to style preprocessors",
              "properties": {
                "includePaths": {
                  "default": [],
                  "description": "Paths to include. Paths will be resolved to project root.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^includePaths$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
