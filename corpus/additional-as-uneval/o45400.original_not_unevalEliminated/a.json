{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "$default": {
                    "$source": "argv",
                    "index": 0
                  },
                  "description": "The name of the e2e application.",
                  "format": "html-selector",
                  "type": "string"
                },
                "projectRoot": {
                  "description": "The root directory of the new application.",
                  "type": "string",
                  "visible": false
                },
                "relatedAppName": {
                  "description": "The name of the app being tested.",
                  "type": "string"
                },
                "rootSelector": {
                  "default": "app-root",
                  "description": "HTML selector for the root component.",
                  "type": "string"
                }
              },
              "required": [
                "relatedAppName"
              ],
              "title": "Angular e2e Application Options Schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^projectRoot$": true,
                "^relatedAppName$": true,
                "^rootSelector$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
