{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "$default": {
                    "$source": "argv",
                    "index": 0
                  },
                  "description": "The name of the enum.",
                  "type": "string"
                },
                "path": {
                  "description": "The path to create the enum.",
                  "format": "path",
                  "type": "string",
                  "visible": false
                },
                "project": {
                  "$default": {
                    "$source": "projectName"
                  },
                  "description": "The name of the project.",
                  "type": "string"
                }
              },
              "required": [],
              "title": "Angular Enum Options Schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^path$": true,
                "^project$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
