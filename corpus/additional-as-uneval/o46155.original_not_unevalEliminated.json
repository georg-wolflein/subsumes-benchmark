        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "packs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stars": {
          "type": "number"
        }
      }
    }
  }
