{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/modern_2"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "packs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "author": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "stars": {
                  "type": "number"
                },
                "url": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^packs$": true,
                "^description$": true,
                "^author$": true,
                "^url$": true,
                "^name$": true,
                "^stars$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
