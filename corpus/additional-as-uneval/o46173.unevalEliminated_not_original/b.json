                            "host": {
                              "type": "string"
                            },
                            "port": {
                              "type": "integer"
                            },
                            "user": {
                              "type": "string"
                            },
                            "password": {
                              "type": "string"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "elasticsearch": {
                  "$ref": "#/$defs/modern_3"
                },
                "neo4j": {
                  "$ref": "#/$defs/modern_4"
                },
                "core": {
                  "$ref": "#/$defs/modern_5"
                },
                "schemas": {
                  "$ref": "#/$defs/modern_6"
                },
                "viewer": {
                  "$ref": "#/$defs/modern_7"
                },
                "logo": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "import": {
                  "$ref": "#/$defs/modern_8"
                },
                "redis": {
                  "$ref": "#/$defs/modern_10"
                },
                "api": {
                  "$ref": "#/$defs/modern_11"
                }
              },
              "required": [
                "schemas",
                "stats",
                "api",
                "redis",
                "elasticsearch",
                "neo4j",
                "viewer",
                "data",
                "import",
                "logo"
