      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "batchSize": {
                  "type": "integer"
                },
                "batchTimeout": {
                  "type": "integer"
                }
              },
              "required": [
                "batchSize",
                "batchTimeout"
              ]
            },
            {
              "patternProperties": {
                "^batchSize$": true,
                "^batchTimeout$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "baseUri": {
                  "type": "string"
                },
                "equivalence": {
                  "type": "string"
                },
                "baseType": {
                  "type": "string"
                },
                "relations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "baseUri",
                "baseType",
                "types",
                "relations",
                "equivalence"
              ]
            },
            {
              "patternProperties": {
                "^types$": true,
                "^equivalence$": true,
                "^relations$": true,
                "^baseUri$": true,
                "^baseType$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
