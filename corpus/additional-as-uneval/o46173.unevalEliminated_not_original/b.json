    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "region": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "accessKeyId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "secretAccessKey": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "buckets": {
                  "type": [
                    "array",
                    "null"
