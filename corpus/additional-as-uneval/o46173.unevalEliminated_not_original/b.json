    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "enabled",
                "cronExpression"
              ],
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "cronExpression": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^enabled$": true,
                "^cronExpression$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
