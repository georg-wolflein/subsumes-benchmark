    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "host",
                "port",
                "queue",
                "maxQueueSize"
              ],
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                },
                "queue": {
                  "type": "string"
                },
                "maxQueueSize": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^host$": true,
                "^port$": true,
                "^queue$": true,
                "^maxQueueSize$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
