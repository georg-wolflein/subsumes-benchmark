              "patternProperties": {
                "^exampleUrls$": true,
                "^admin$": true,
                "^bindHost$": true,
                "^hairRelations$": true,
                "^baseUrl$": true,
                "^bindPort$": true,
                "^dataDir$": true,
                "^defaultPathRelation$": true
              },
              "additionalProperties": false
            }
          ]
        }
