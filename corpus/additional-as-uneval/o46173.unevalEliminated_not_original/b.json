    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "admin": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    }
                  }
                },
                "dataDir": {
                  "type": "string"
                },
                "defaultPathRelation": {
                  "type": "string"
                },
                "baseUrl": {
                  "type": "string"
                },
                "bindPort": {
                  "type": "integer"
                },
                "bindHost": {
                  "type": "string"
                },
                "hairRelations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exampleUrls": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "bindHost",
                "bindPort",
                "baseUrl",
                "dataDir",
                "admin",
                "defaultPathRelation",
                "hairRelations"
