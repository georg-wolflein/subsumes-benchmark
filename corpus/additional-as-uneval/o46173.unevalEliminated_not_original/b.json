                  ]
                },
                "language": {
                  "type": "string"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "simple",
                    "advanced"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^mode$": true,
                "^logo$": true,
                "^color$": true,
                "^suffixFilters$": true,
                "^language$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
