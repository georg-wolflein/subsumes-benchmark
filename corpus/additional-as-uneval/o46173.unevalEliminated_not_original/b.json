            {
              "patternProperties": {
                "^schemas$": true,
                "^logo$": true,
                "^redis$": true,
                "^import$": true,
                "^elasticsearch$": true,
                "^api$": true,
                "^data$": true,
                "^neo4j$": true,
                "^viewer$": true,
                "^stats$": true,
                "^core$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "language",
                "mode",
                "logo",
                "color",
                "suffixFilters"
              ],
              "properties": {
                "suffixFilters": {
                  "type": "array"
                },
                "color": {
                  "type": "string"
                },
                "logo": {
                  "type": [
                    "string",
