    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "host": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                },
                "user": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "password": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "host",
                "port",
                "user",
                "password"
              ]
            },
            {
              "patternProperties": {
                "^host$": true,
                "^port$": true,
                "^user$": true,
                "^password$": true
