{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "dependency_type": {
                  "default": "jsonpath_ready",
                  "enum": [
                    "jsonpath_ready"
                  ],
                  "title": "Dependency Type",
                  "type": "string"
                },
                "expressions": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Expressions",
                  "type": "array"
                }
              },
              "title": "JSONPath ready predicate",
              "type": "object"
            },
            {
              "patternProperties": {
                "^dependency_type$": true,
                "^expressions$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
