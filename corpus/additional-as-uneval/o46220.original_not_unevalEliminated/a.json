{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "items": {
                "properties": {
                  "key": {
                    "title": "Key/Attribute",
                    "type": "string"
                  },
                  "value": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "$ref": "#/$defs/modern_2"
                      }
                    ],
                    "title": "Value"
                  }
                },
                "type": "object"
              },
              "title": "Parameter Selection",
              "type": "array"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "unwrap": {
                  "type": "boolean"
                },
                "output": {
                  "type": "string"
                },
                "expression_type": {
                  "default": "stage-output-selector",
                  "enum": [
                    "stage-output-selector"
                  ],
                  "type": "string"
                },
                "flatten": {
                  "type": "boolean"
                },
                "stages": {
                  "type": "string"
                }
              },
              "required": [
                "expression_type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^stages$": true,
                "^output$": true,
                "^expression_type$": true,
                "^unwrap$": true,
                "^flatten$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
