{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Frequency",
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "recurring": {
                  "type": "boolean"
                },
                "type": {
                  "type": "integer"
                }
              },
              "required": [
                "recurring"
              ]
            },
            {
              "patternProperties": {
                "^label$": true,
                "^recurring$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
