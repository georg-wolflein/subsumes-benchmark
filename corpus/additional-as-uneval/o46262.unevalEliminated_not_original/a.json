{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Security Holding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "marketValue": {
      "type": "number"
    },
    "price": {
      "type": "number"
    },
    "quantity": {
      "type": "number"
    },
    "security": {
      "$ref": "#/$defs/Security"
    }
  },
  "$defs": {
    "Security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "_id": {
          "type": "integer",
          "description": "A unique ID for Security"
        },
        "name": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        }
      }
    }
  }
}
