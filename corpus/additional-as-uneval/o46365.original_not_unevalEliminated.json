      },
      "part": {
        "properties": {
          "code": {
            "$ref": "#/$defs/code"
          },
          "message": {
            "$ref": "#/$defs/message"
          },
          "path": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
