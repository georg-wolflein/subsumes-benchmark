                  }
                },
                "required": [
                  "code",
                  "message"
                ]
              },
              {
                "patternProperties": {
                  "^code$": true,
                  "^message$": true,
                  "^path$": true,
                  "^errors$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "code": {
        "title": "Machine readable code",
        "description": "This will be in upper-case and underscore separated, aka ANGRY_SNAKE_CASE",
        "type": "string"
      },
      "message": {
        "title": "Human readable message",
        "description": "Free text",
        "type": "string"
      },
      "part": {
        "properties": {
          "code": {
            "$ref": "#/$defs/code"
          },
          "message": {
            "$ref": "#/$defs/message"
          },
          "path": {
            "$ref": "#/$defs/path"
          }
        }
      }
    }
  },
  "b": {
