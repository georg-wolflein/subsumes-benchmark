{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o46394.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "warningCount": {
                    "title": "Warning count",
                    "description": "The number of validation warning messages",
                    "type": "number",
                    "example": "10"
                  },
                  "errorCount": {
                    "title": "Error count",
                    "description": "The number of validation error messages",
                    "type": "number",
                    "example": "10"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "title": "Id",
                          "description": "The message identifier.",
                          "type": "string",
                          "example": "C00001",
                          "pattern": "^C[0-9]{5}$"
                        },
                        "type": {
                          "title": "Type",
                          "description": "The type of message. Must be one of: error, warning",
                          "type": "string",
                          "example": "warning"
                        },
                        "text": {
                          "title": "Text",
                          "description": "The message content",
                          "type": "string",
                          "example": "You have entered a large amount in total Gift Aid payments. Please check."
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ]
                    }
                  }
                },
                "required": [
                  "messages"
                ]
              },
              {
                "patternProperties": {
                  "^warningCount$": true,
                  "^errorCount$": true,
                  "^messages$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "warningCount": {
        "title": "Warning count",
        "description": "The number of validation warning messages",
        "type": "number",
        "example": "10"
      },
      "errorCount": {
        "title": "Error count",
        "description": "The number of validation error messages",
        "type": "number",
        "example": "10"
      },
      "messages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "title": "Id",
              "description": "The message identifier.",
              "type": "string",
              "example": "C00001",
              "pattern": "^C[0-9]{5}$"
            },
            "type": {
              "title": "Type",
              "description": "The type of message. Must be one of: error, warning",
              "type": "string",
              "example": "warning"
            },
            "text": {
              "title": "Text",
              "description": "The message content",
              "type": "string",
              "example": "You have entered a large amount in total Gift Aid payments. Please check."
            }
          },
          "required": [
            "type",
            "id"
          ]
        }
      }
    },
    "required": [
      "messages"
    ],
    "additionalProperties": false
  }
}
