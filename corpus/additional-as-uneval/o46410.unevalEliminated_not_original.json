                    "type": "number",
                    "multipleOf": 0.01,
                    "minimum": 0.0,
                    "maximum": 99999999999.99,
                    "example": "500.23"
                  }
                }
              },
              {
                "patternProperties": {
                  "^taxedUkInterest$": true,
                  "^untaxedUkInterest$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
