                "required": [
                  "income",
                  "expenses"
                ]
              },
              {
                "patternProperties": {
                  "^income$": true,
                  "^expenses$": true,
                  "^additions$": true,
                  "^deductions$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
