{
  "$id": "https://raw.githubusercontent.com/helpwanted/helpwanted/master/helpwanted.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "technologies": {
      "$ref": "#/$defs/modern_1"
    },
    "version": {
      "type": "string"
    },
    "resources": {
      "type": "object",
      "required": [
        "people",
        "repository"
      ],
      "properties": {
        "people": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/modern_2"
          }
        },
        "repository": {
          "type": "string"
        },
        "security": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mailinglist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bugs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "homepage": {
          "type": "string"
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "technologies",
    "skills",
    "resources"
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "email"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true,
                "^description$": true
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    }
  }
}
