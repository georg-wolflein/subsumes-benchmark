{
  "$id": "https://dcc.icgc.org/gene-set",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_summary": {
      "type": "object",
      "properties": {
        "_gene_count": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "description": {
      "type": "string"
    },
    "go_term": {
      "type": "object",
      "properties": {
        "alt_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inferred_tree": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "relation": {
                "type": "string"
              },
              "level": {
                "type": "integer"
              }
            },
            "additionalProperties": false
          }
        },
        "ontology": {
          "type": "string"
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "gene_set_pathway": {
      "type": "object",
      "properties": {
        "diagrammed": {
          "type": "boolean"
        },
        "evidence_code": {
          "type": "string"
        },
        "hierarchy": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "diagrammed": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "species": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "string"
    },
    "type": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
