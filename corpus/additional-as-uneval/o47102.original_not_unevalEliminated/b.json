{
  "$id": "https://dcc.icgc.org/observation-centric",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "donor": {
      "type": "object",
      "properties": {
        "_donor_id": {
          "type": "string"
        },
        "_summary": {
          "type": "object",
          "properties": {
            "_age_at_diagnosis_group": {
              "type": "string"
            },
            "_available_data_type": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "_state": {
              "type": "string"
            },
            "_studies": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "experimental_analysis_performed": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "disease_status_last_followup": {
          "type": "string"
        },
        "donor_relapse_type": {
          "type": "string"
        },
        "donor_sex": {
          "type": "string"
        },
        "donor_tumour_stage_at_diagnosis": {
          "type": "string"
        },
        "donor_vital_status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "_project_id": {
          "type": "string"
        },
        "primary_site": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ssm": {
      "type": "object",
      "properties": {
        "_mutation_id": {
          "type": "string"
        },
        "_type": {
          "type": "string"
        },
        "chromosome": {
          "type": "string"
        },
        "chromosome_end": {
          "type": "integer"
        },
        "chromosome_start": {
          "type": "integer"
        },
        "gene": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fake": {
                "description": "Present only when the value is 'true'",
                "type": "boolean"
              },
              "_gene_id": {
                "type": "string"
              },
              "biotype": {
                "type": "string"
              },
              "chromosome": {
                "type": "string"
              },
              "end": {
                "type": "integer"
              },
              "drug": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "start": {
                "type": "integer"
              },
              "pathway": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "go_term": {
                "type": "object",
                "properties": {
                  "biological_process": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "cellular_component": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "molecular_function": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "consequence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "consequence_type": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "mutation": {
          "type": "string"
        },
        "mutation_type": {
          "type": "string"
        },
        "observation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "_matched_sample_id": {
                "type": "string"
              },
              "_sample_id": {
                "type": "string"
              },
              "_specimen_id": {
                "type": "string"
              },
              "alignment_algorithm": {
                "type": "string"
              },
              "analyzed_sample_id": {
                "type": "string"
              },
              "base_calling_algorithm": {
                "type": "string"
              },
              "biological_validation_platform": {
                "type": "string"
              },
              "biological_validation_status": {
                "type": "string"
              },
              "experimental_protocol": {
                "type": "string"
              },
              "matched_sample_id": {
                "type": "string"
              },
              "mutant_allele_read_count": {
                "type": "integer"
              },
              "other_analysis_algorithm": {
                "type": "string"
              },
              "platform": {
                "type": "string"
              },
              "probability": {
                "type": "number"
              },
              "raw_data_accession": {
                "type": "string"
              },
              "raw_data_repository": {
                "type": "string"
              },
              "sequencing_strategy": {
                "type": "string"
              },
              "total_read_count": {
                "type": "integer"
              },
              "variation_calling_algorithm": {
                "type": "string"
              },
              "verification_status": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
