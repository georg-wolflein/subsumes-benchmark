{
  "$id": "https://dcc.icgc.org/diagram",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "diagram_id": {
      "type": "string"
    },
    "highlights": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protein_map": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "db_id": {
            "type": "string"
          },
          "uniprot_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "xml": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "diagram_id"
  ]
}
