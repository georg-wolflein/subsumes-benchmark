{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "mutation": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "start": {
                  "type": "string"
                },
                "geneMutations": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^start$": true,
                "^type$": true,
                "^geneMutations$": true,
                "^id$": true,
                "^mutation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
