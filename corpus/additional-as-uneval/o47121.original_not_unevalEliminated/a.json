                "_mirna_seq_tested_donor_count": {
                  "type": "integer"
                },
                "_cnsm_tested_donor_count": {
                  "type": "integer"
                },
                "_stsm_tested_donor_count": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^_exp_seq_tested_donor_count$": true,
                "^_total_live_donor_count$": true,
                "^_exp_array_tested_donor_count$": true,
