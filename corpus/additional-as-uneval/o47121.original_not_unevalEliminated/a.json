{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Each field of the object has name of experimental analysis performed and it's count. E.g. WGA:10",
              "patternProperties": {
                "^\\w+(-\\w+)+$": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^\\w+(-\\w+)+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tumour_subtype": {
                  "type": "string"
                },
                "icgc_id": {
                  "type": "string"
                },
                "alias": {
                  "type": "string"
                },
                "tumour_type": {
                  "type": "string"
                },
                "project_name": {
                  "type": "string"
                },
                "primary_site": {
                  "type": "string"
                },
                "pubmed_ids": {
                  "$ref": "#/$defs/modern_2"
                },
                "partner_countries": {
                  "$ref": "#/$defs/modern_3"
                },
                "_summary": {
                  "$ref": "#/$defs/modern_4"
                },
                "_project_id": {
                  "type": "string"
                },
                "primary_countries": {
                  "$ref": "#/$defs/modern_9"
                }
              }
            },
            {
              "patternProperties": {
                "^project_name$": true,
                "^icgc_id$": true,
                "^pubmed_ids$": true,
                "^tumour_subtype$": true,
                "^_project_id$": true,
                "^primary_countries$": true,
                "^partner_countries$": true,
                "^tumour_type$": true,
                "^primary_site$": true,
                "^alias$": true,
                "^_summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
