{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "donor_count": {
                  "type": "integer"
                },
                "live_project_count": {
                  "type": "integer"
                },
                "_release_id": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "project_count": {
                  "type": "integer"
                },
                "live_primary_site_count": {
                  "type": "integer"
                },
                "primary_site_count": {
                  "type": "integer"
                },
                "sample_count": {
                  "type": "integer"
                },
                "live_donor_count": {
                  "type": "integer"
                },
                "ssm_count": {
                  "type": "integer"
                },
                "specimen_count": {
                  "type": "integer"
                },
                "mutated_gene_count": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^primary_site_count$": true,
                "^live_primary_site_count$": true,
                "^mutated_gene_count$": true,
                "^live_donor_count$": true,
                "^specimen_count$": true,
                "^date$": true,
                "^ssm_count$": true,
                "^_release_id$": true,
                "^live_project_count$": true,
                "^donor_count$": true,
                "^name$": true,
                "^number$": true,
                "^sample_count$": true,
                "^project_count$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
