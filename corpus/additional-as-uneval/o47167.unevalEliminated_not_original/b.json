{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "MachineBoss named sequence schema",
              "properties": {
                "name": {
                  "type": "string"
                },
                "sequence": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "sequence"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^sequence$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
