      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Custom Rule",
                "type": "object",
                "properties": {
                  "plugin": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "fix": {
                    "type": "string"
                  },
                  "rule": {
                    "enum": [
                      "custom"
                    ]
                  },
                  "match": {
                    "type": "string",
                    "description": "A regexp to search the output."
                  },
                  "error": {
                    "type": "string"
                  },
                  "ci": {
                    "type": "boolean"
                  },
                  "platform": {
                    "enum": [
                      "darwin",
                      "macos",
                      "freebsd",
                      "linux",
                      "sunos",
                      "win32",
                      "windows"
                    ]
                  }
                },
                "required": [
                  "rule",
                  "plugin",
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^rule$": true,
                  "^fix$": true,
                  "^ci$": true,
                  "^platform$": true,
                  "^match$": true,
                  "^error$": true,
                  "^name$": true,
                  "^plugin$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
