    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Solidarity",
    "description": "A rule-set and config for the Solidarity JSON checker",
    "type": "object",
    "properties": {
      "config": {
        "output": {
          "description": "Identify what kind output should happen when a check is called",
          "type": "string",
