{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Flow configuration",
              "type": "object",
              "properties": {
                "deployTo": {
                  "propertyOrder": 30,
                  "title": "List of node roles where the flow can be deployed",
                  "type": "string",
                  "default": "hub"
                },
                "name": {
                  "propertyOrder": 10,
                  "title": "Name",
                  "type": "string"
                },
                "instancesPerNode": {
                  "propertyOrder": 30,
                  "title": "Flow instances per node",
                  "type": "number",
                  "default": 10
                },
                "pipeline": {
                  "propertyOrder": 50,
                  "title": "Pipeline configuration",
                  "type": "array",
                  "format": "tabs",
                  "items": {
                    "title": "Instruction",
                    "headerTemplate": "{{i}} - {{self.class}}: {{self.name}}",
                    "oneOf": []
                  }
                },
                "sourceGateName": {
                  "propertyOrder": 20,
                  "title": "Gate name or full address",
                  "type": "string"
                },
                "blockGateWhenPassive": {
                  "propertyOrder": 30,
                  "title": "Block gate when passive",
                  "type": "boolean",
                  "default": true
                }
              },
              "required": [
                "sourceGateName",
                "pipeline"
              ]
            },
            {
              "patternProperties": {
                "^instancesPerNode$": true,
                "^name$": true,
                "^sourceGateName$": true,
                "^blockGateWhenPassive$": true,
                "^deployTo$": true,
                "^pipeline$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "simpleCondition": {
      "type": "string",
      "title": "Simple condition",
      "format": "textarea"
    }
  }
}
