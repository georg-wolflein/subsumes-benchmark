{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Gate configuration",
              "properties": {
                "desc": {
                  "propertyOrder": 20,
                  "title": "Description",
                  "type": "string"
                },
                "name": {
                  "propertyOrder": 10,
                  "title": "Name",
                  "type": "string"
                },
                "noSinkDropMessages": {
                  "propertyOrder": 41,
                  "title": "Drop messages when no sinks connected",
                  "type": "boolean"
                },
                "inFlightThreshold": {
                  "propertyOrder": 40,
                  "title": "Max in-flight messages",
                  "type": "integer",
                  "minimum": 1.0
                },
                "address": {
                  "propertyOrder": 11,
                  "title": "Address",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "address",
                "inFlightThreshold",
                "noSinkDropMessages"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^address$": true,
                "^inFlightThreshold$": true,
                "^desc$": true,
                "^noSinkDropMessages$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
