{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "identifier": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A generic identifier.",
              "type": "object",
              "properties": {
                "scheme": {
                  "type": "string",
                  "description": "Identifier scheme."
                },
                "identifier": {
                  "type": "string"
                }
              },
              "required": [
                "scheme",
                "identifier"
              ]
            },
            {
              "patternProperties": {
                "^scheme$": true,
                "^identifier$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Invenio Community v1.0.0",
              "type": "object",
              "properties": {
                "member_policy": {
                  "description": "Community member policy.",
                  "enum": [
                    "open",
                    "closed"
                  ]
                },
                "page": {
                  "description": "Community page.",
                  "type": "string"
                },
                "domains": {
                  "description": "Community domain.",
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "alternate_identifiers": {
                  "type": "array",
                  "description": "Alternate identifiers for the community",
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/identifier"
                  }
                },
                "record_policy": {
                  "description": "Community record policy.",
                  "enum": [
                    "open",
                    "closed",
                    "restricted"
                  ]
                },
                "id": {
                  "description": "Community identifier.",
                  "type": "string"
                },
                "funding": {
                  "description": "Community funding.",
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "created_by": {
                  "description": "Community creator.",
                  "type": "integer"
                },
                "website": {
                  "description": "Community website.",
                  "type": "string"
                },
                "description": {
                  "description": "Community description.",
                  "type": "string"
                },
                "archived": {
                  "description": "Community archived.",
                  "type": "boolean"
                },
                "title": {
                  "description": "Community title.",
                  "type": "string"
                },
                "type": {
                  "description": "Community type.",
                  "enum": [
                    "organization",
                    "event",
                    "topic",
                    "project"
                  ]
                },
                "curation_policy": {
                  "description": "Community curation policy.",
                  "type": "string"
                },
                "$schema": {
                  "description": "JSONSchema for the community.",
                  "type": "string"
                },
                "visibility": {
                  "description": "Community visibility.",
                  "enum": [
                    "public",
                    "private",
                    "hidden"
                  ]
                },
                "verified": {
                  "description": "Community verified.",
                  "type": "boolean"
                }
              },
              "required": [
                "$schema",
                "id",
                "title",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^$schema$": true,
                "^record_policy$": true,
                "^description$": true,
                "^curation_policy$": true,
                "^domains$": true,
                "^type$": true,
                "^archived$": true,
                "^id$": true,
                "^website$": true,
                "^member_policy$": true,
                "^title$": true,
                "^alternate_identifiers$": true,
                "^created_by$": true,
                "^page$": true,
                "^verified$": true,
                "^visibility$": true,
                "^funding$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
