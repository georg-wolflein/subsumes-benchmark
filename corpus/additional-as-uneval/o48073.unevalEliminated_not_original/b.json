{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "projects",
    "drivers"
  ],
  "properties": {
    "projects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_3"
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/release_id"
          },
          "wiki": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "wiki"
        ]
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_4"
      }
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[^,]+$"
                },
                "email": {
                  "type": "string",
                  "pattern": "^[a-z\\d_\\.-]+@([a-z\\d\\.-]+\\.)+[a-z]+$"
                },
                "irc": {
                  "type": "string",
                  "pattern": "^[\\S]+$"
                },
                "launchpad_id": {
                  "type": "string",
                  "pattern": "^[\\S]+$"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true,
                "^irc$": true,
                "^launchpad_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\S]+$"
                },
                "success_pattern": {
                  "type": "string"
                },
                "failure_pattern": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^success_pattern$": true,
                "^failure_pattern$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Z][a-z]+$"
    },
    "user": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "maintainers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/user"
                  }
                },
                "description": {
                  "type": "string"
                },
                "project_id": {
                  "type": "string"
                },
                "wiki": {
                  "type": "string"
                },
                "vendor": {
                  "type": "string"
                },
                "releases": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/release_id"
                  }
                },
                "ci": {
                  "$ref": "#/$defs/ci"
                }
              },
              "required": [
                "project_id",
                "vendor",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^maintainers$": true,
                "^ci$": true,
                "^description$": true,
                "^wiki$": true,
                "^name$": true,
                "^vendor$": true,
                "^releases$": true,
                "^project_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z\\d\\./-]+$"
                },
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "ci": {
      "$ref": "#/$defs/modern_2"
    }
  }
}
