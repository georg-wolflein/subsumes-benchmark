{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "translations": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "fr": {
                  "type": "string"
                },
                "de": {
                  "type": "string"
                },
                "tr": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                },
                "es": {
                  "type": "string"
                },
                "jp": {
                  "type": "string"
                },
                "pl": {
                  "type": "string"
                },
                "it": {
                  "type": "string"
                },
                "dk": {
                  "type": "string"
                },
                "gr": {
                  "type": "string"
                },
                "cz": {
                  "type": "string"
                }
              },
              "required": [
                "en",
                "de"
              ]
            },
            {
              "patternProperties": {
                "^jp$": true,
                "^dk$": true,
                "^tr$": true,
                "^es$": true,
                "^fr$": true,
                "^gr$": true,
                "^it$": true,
                "^de$": true,
                "^pl$": true,
                "^en$": true,
                "^cz$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Generation",
              "properties": {
                "number": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 7.0
                },
                "names": {
                  "$ref": "#/$defs/translations"
                },
                "dex_name": {
                  "type": "string"
                },
                "games": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 7,
                  "items": {
                    "$ref": "#/$defs/translations"
                  }
                }
              },
              "required": [
                "number",
                "names",
                "dex_name",
                "games"
              ]
            },
            {
              "patternProperties": {
                "^number$": true,
                "^names$": true,
                "^dex_name$": true,
                "^games$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
