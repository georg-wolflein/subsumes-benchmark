        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "triggers_evolution": {
                  "type": "boolean"
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "Single Pokemon",
                    "Single Pokemon > Single Move",
                    "Single Pokemon > All Moves",
                    "Team",
                    "Trainer"
                  ]
