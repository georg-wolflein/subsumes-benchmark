                  "items": {
                    "$ref": "#/$defs/effect"
                  }
                },
                "names": {
                  "$ref": "#/$defs/translations"
                },
                "fling_power": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 150.0
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "Evolutionary stones",
                    "Repels",
                    "Fossils",
                    "Flutes",
                    "Shards",
                    "Held items",
                    "Escape items",
                    "Escape Rope",
                    "Exchangeable items",
                    "Valuable items",
                    "Battle items",
                    "Bottle Caps",
                    "Legendary artifacts",
                    "Honey",
                    "Scents",
                    "Nectars",
                    "Potions",
                    "Status condition healing items",
                    "Revives",
                    "PP-restoring items",
                    "Vitamins",
                    "Wings",
                    "Drinks",
                    "Herbal medicine",
                    "Ability Capsule",
                    "Berries",
                    "Mulch",
                    "Apricorns",
                    "Pok\u00e9 Balls",
                    "Decorations",
                    "Accessoiries",
                    "Backdrops",
                    "Props",
                    "D\u00e9cor",
                    "Clothing",
                    "Fashion items",
                    "Mail",
                    "Key Items",
                    "Event items",
                    "Wood boxes",
                    "Time Flute",
                    "Pass Orbs",
                    "Wonder Launcher items",
                    "Rotom Powers"
                  ]
                },
                "descriptions": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  }
                },
                "pockets": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                }
              },
              "required": [
                "names",
                "category",
                "descriptions",
                "prices",
                "pockets",
                "effects",
                "fling_power"
              ]
            },
            {
              "patternProperties": {
                "^descriptions$": true,
                "^pockets$": true,
                "^fling_power$": true,
                "^category$": true,
                "^prices$": true,
                "^names$": true,
                "^effects$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "games": {
                  "$ref": "#/$defs/games"
                },
                "buying": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 60000.0
                },
                "selling": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 60000.0
                }
              },
              "required": [
                "games",
                "buying",
                "selling"
              ]
            },
            {
              "patternProperties": {
                "^games$": true,
                "^buying$": true,
                "^selling$": true
              },
              "additionalProperties": false
