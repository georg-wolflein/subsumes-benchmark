                  "enum": [
                    "During Battle",
                    "Outside of Battle",
                    "Always"
                  ]
                },
                "pokemon_changes": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "condition",
                "target"
              ]
            },
            {
              "patternProperties": {
                "^target$": true,
                "^triggers_evolution$": true,
                "^condition$": true,
                "^pokemon_changes$": true,
                "^move_changes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "pocket": {
                  "$ref": "#/$defs/pocket"
                },
                "generations": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/generation"
                  }
                }
              },
              "required": [
                "pocket",
                "generations"
              ]
            },
            {
              "patternProperties": {
                "^pocket$": true,
                "^generations$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "max_pp",
                    "pp"
                  ]
                },
                "change_by_percent": {
                  "type": "integer",
                  "minimum": -100.0,
                  "maximum": 160.0
                },
                "change_by": {
                  "type": "integer",
                  "minimum": -10000.0,
                  "maximum": 10000.0
                },
                "change_by_max": {
                  "type": "integer",
                  "minimum": -10000.0,
