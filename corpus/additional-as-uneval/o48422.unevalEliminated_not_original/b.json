          "Diamond",
          "Pearl",
          "Platinum",
          "HeartGold",
          "SoulSilver",
          "Black",
          "White",
          "Black 2",
          "White 2",
          "X",
          "Y",
          "Omega Ruby",
          "Alpha Sapphire",
          "Sun",
          "Moon",
          "Ultra Sun",
          "Ultra Moon"
