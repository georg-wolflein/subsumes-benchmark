{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "condition": {
                  "type": "string",
                  "enum": [
                    "burn",
                    "freeze",
                    "paralysis",
                    "poison",
                    "badly_poisoned",
                    "sleep"
                  ]
                },
                "probability": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 100.0
                }
              },
              "required": [
                "condition",
                "probability"
              ]
            },
            {
              "patternProperties": {
                "^condition$": true,
                "^probability$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "Red|Blue|Yellow|Gold|Silver|Crystal|Ruby|Sapphire|Emerald|FireRed|LeafGreen|Diamond|Pearl|Platinum|HeartGold|SoulSilver|Black|White|Black 2|White 2|X|Y|Omega Ruby|Alpha Sapphire|Sun|Moon|Ultra Sun|Ultra Moon|Let's Go Pikachu|Let's Go Eevee": {
                  "$ref": "#/$defs/translations"
                }
              }
            },
            {
              "patternProperties": {
                "Red|Blue|Yellow|Gold|Silver|Crystal|Ruby|Sapphire|Emerald|FireRed|LeafGreen|Diamond|Pearl|Platinum|HeartGold|SoulSilver|Black|White|Black 2|White 2|X|Y|Omega Ruby|Alpha Sapphire|Sun|Moon|Ultra Sun|Ultra Moon|Let's Go Pikachu|Let's Go Eevee": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "translations": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "fr": {
                  "type": "string"
                },
                "de": {
                  "type": "string"
                },
                "tr": {
                  "type": "string"
                },
                "en": {
                  "type": "string"
                },
                "es": {
                  "type": "string"
                },
                "jp": {
                  "type": "string"
                },
                "pl": {
                  "type": "string"
                },
                "it": {
                  "type": "string"
                },
                "dk": {
                  "type": "string"
                },
                "gr": {
                  "type": "string"
                },
                "cz": {
                  "type": "string"
                }
              },
              "required": [
                "en",
                "de"
              ]
            },
            {
              "patternProperties": {
                "^jp$": true,
                "^dk$": true,
                "^tr$": true,
                "^es$": true,
                "^fr$": true,
                "^gr$": true,
                "^it$": true,
                "^de$": true,
                "^pl$": true,
                "^en$": true,
                "^cz$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "contest": {
                  "type": "string",
                  "enum": [
                    "Contests",
                    "Super Contests",
                    "Contest Spectaculars"
                  ]
                },
                "condition": {
                  "type": "string",
                  "enum": [
                    "Tough",
                    "Cute",
                    "Clever",
                    "Cool",
                    "Beautiful"
                  ]
                },
                "appeal": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 8.0
                },
                "jam": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 5.0
                }
              },
              "required": [
                "contest",
                "condition",
                "appeal",
                "jam"
              ]
            },
            {
              "patternProperties": {
                "^contest$": true,
                "^condition$": true,
                "^appeal$": true,
                "^jam$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Move",
              "properties": {
                "priority": {
                  "type": "integer",
                  "minimum": -7.0,
                  "maximum": 7.0
                },
                "stat_modifiers": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "index_number": {
                  "type": "integer",
                  "minimum": 0.0
                },
                "names": {
                  "$ref": "#/$defs/translations"
                },
                "accuracy": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 100.0
                },
                "critical_hit": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 2.0
                },
                "max_pp": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 64.0
                },
                "affected_by_kings_rock": {
                  "type": "boolean"
                },
                "affected_by_protect": {
                  "type": "boolean"
                },
                "in_battle_properties": {
                  "$ref": "#/$defs/modern_4"
                },
                "affected_by_mirror_move": {
                  "type": "boolean"
                },
                "category": {
                  "type": "string",
                  "enum": [
                    "physical",
                    "status",
                    "special",
                    "varies"
                  ]
                },
                "target": {
                  "type": "string",
                  "enum": [
                    "target_adjacent_single",
                    "target_adjacent_user_single",
                    "target_user_or_adjacent_user",
                    "user",
                    "all_users",
                    "all_adjacent",
                    "adjacent_foes_all",
                    "all_except_user",
                    "all_foes",
                    "all",
                    "user_and_random_adjacent_foe"
                  ]
                },
                "pp": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 40.0
                },
                "affected_by_snatch": {
                  "type": "boolean"
                },
                "pokedex_entries": {
                  "$ref": "#/$defs/modern_6"
                },
                "makes_contact": {
                  "type": "boolean"
                },
                "affected_by_magic_coat": {
                  "type": "boolean"
                },
                "contests": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  }
                },
                "power": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 250.0
                },
                "type": {
                  "$ref": "#/$defs/type"
                }
              },
              "required": [
                "index_number",
                "pp",
                "max_pp",
                "power",
                "accuracy",
                "type",
                "category",
                "priority",
                "target",
                "critical_hit",
                "makes_contact",
                "affected_by_protect",
                "affected_by_magic_coat",
                "affected_by_snatch",
                "affected_by_mirror_move",
                "affected_by_kings_rock",
                "names",
                "pokedex_entries",
                "contests"
              ]
            },
            {
              "patternProperties": {
                "^affected_by_protect$": true,
                "^target$": true,
                "^critical_hit$": true,
                "^stat_modifiers$": true,
                "^in_battle_properties$": true,
                "^affected_by_snatch$": true,
                "^accuracy$": true,
                "^index_number$": true,
                "^pokedex_entries$": true,
                "^makes_contact$": true,
                "^affected_by_mirror_move$": true,
                "^contests$": true,
                "^category$": true,
                "^affected_by_magic_coat$": true,
                "^power$": true,
                "^max_pp$": true,
                "^type$": true,
                "^affected_by_kings_rock$": true,
                "^names$": true,
                "^priority$": true,
                "^pp$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "stat": {
                  "type": "string",
                  "enum": [
                    "random",
                    "atk",
                    "def",
                    "speed",
                    "sp_atk",
                    "sp_def",
                    "accuracy",
                    "evasion",
                    "critital_hit"
                  ]
                },
                "change_by": {
                  "type": "integer",
                  "minimum": -12.0,
                  "maximum": 12.0
                },
                "affects_user": {
                  "type": "boolean"
                }
              },
              "required": [
                "stat",
                "change_by"
              ]
            },
            {
              "patternProperties": {
                "^stat$": true,
                "^change_by$": true,
                "^affects_user$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "Normal",
        "Fighting",
        "Flying",
        "Poison",
        "Ground",
        "Rock",
        "Bug",
        "Ghost",
        "Steel",
        "Fire",
        "Water",
        "Grass",
        "Electric",
        "Psychic",
        "Ice",
        "Dragon",
        "Dark",
        "Fairy"
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "increased_critical_hit_ratio": {
                  "type": "boolean"
                },
                "status_conditions": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^increased_critical_hit_ratio$": true,
                "^status_conditions$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
