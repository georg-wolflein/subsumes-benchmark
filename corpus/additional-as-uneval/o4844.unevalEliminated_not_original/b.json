{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An object that is applied to a sample to update one or more attributes and/or one or more external references",
              "properties": {
                "attributesPost": {
                  "description": "The updated version of the attribute",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "type": "array"
                },
                "attributesPre": {
                  "description": "The attribute to update, with it's type, value and iri. This need to match the sample in order for the curation to be applied",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "type": "array"
                },
                "externalReferencesPost": {
                  "description": "The updated value for the external reference",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  },
                  "type": "array"
                },
                "externalReferencesPre": {
                  "description": "The external reference to update",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "type": "array"
                }
              },
              "required": [
                "attributesPre",
                "attributesPost",
                "externalReferencesPre",
                "externalReferencesPost"
              ],
              "title": "BioSamples curation object",
              "type": "object"
            },
            {
              "patternProperties": {
                "^attributesPost$": true,
                "^attributesPre$": true,
                "^externalReferencesPost$": true,
                "^externalReferencesPre$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Define the way attributes are described in a curation object",
              "properties": {
                "iri": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^iri$": true,
                "^type$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Define the way attributes are described in a curation object",
              "properties": {
                "iri": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^iri$": true,
                "^type$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
