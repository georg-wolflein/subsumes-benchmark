{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "name": {
      "type": "string"
    },
    "crypto": {
      "$ref": "#/$defs/modern_1"
    },
    "version": {
      "minimum": 1.0,
      "type": "integer"
    },
    "meta": {
      "type": "string"
    },
    "address": {
      "pattern": "^(0x)?(([0-9]|[a-f]|[A-F]){2}){20}$",
      "type": "string"
    }
  },
  "required": [
    "version",
    "crypto"
  ],
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "mac": {
                  "pattern": "^(([0-9]|[a-f]){2}){32}$",
                  "type": "string"
                },
                "kdf": {
                  "type": "string"
                },
                "cipherparams": {
                  "type": "object"
                },
                "ciphertext": {
                  "type": "string"
                },
                "cipher": {
                  "type": "string"
                },
                "kdfparams": {
                  "type": "object"
                }
              },
              "required": [
                "cipher",
                "cipherparams",
                "ciphertext",
                "kdf",
                "kdfparams",
                "mac"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^kdf$": true,
                "^kdfparams$": true,
                "^cipher$": true,
                "^ciphertext$": true,
                "^mac$": true,
                "^cipherparams$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
