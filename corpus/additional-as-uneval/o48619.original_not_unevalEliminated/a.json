{
  "$id": "http://mynet.com/schemas/user.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "User profile with connections",
  "properties": {
    "name": {
      "faker": "name.findName",
      "maxLength": 128,
      "type": "string"
    },
    "email": {
      "_format": "email",
      "faker": "internet.email",
      "type": "string"
    },
    "createdAt": {
      "_format": "date-time",
      "type": "string"
    },
    "address": {
      "$ref": "#/$defs/modern_1"
    },
    "personal": {
      "$ref": "#/$defs/modern_2"
    },
    "id": {
      "maximum": 99999999999.0,
      "minimum": 1.0,
      "type": "integer"
    },
    "phone": {
      "faker": "phone.phoneNumber",
      "pattern": "^[0-9()\\-\\.\\s]+$",
      "type": "string"
    },
    "connections": {
      "items": {
        "$ref": "#/$defs/modern_3"
      },
      "maxItems": 5,
      "type": "array"
    },
    "feeds": {
      "$ref": "#/$defs/modern_4"
    }
  },
  "required": [
    "id",
    "name",
    "email",
    "phone",
    "address",
    "personal",
    "connections",
    "feeds",
    "createdAt"
  ],
  "title": "User",
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "maxProperties": 8,
              "properties": {
                "city": {
                  "faker": "address.city",
                  "type": "string"
                },
                "country": {
                  "faker": "address.country",
                  "type": "string"
                },
                "postcode": {
                  "faker": "address.zipCode",
                  "type": "string"
                },
                "street": {
                  "faker": "address.streetAddress",
                  "type": "string"
                }
              },
              "required": [
                "street",
                "postcode",
                "city",
                "country"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^city$": true,
                "^country$": true,
                "^postcode$": true,
                "^street$": true
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "DOB": {
                  "_format": "date-time",
                  "type": "string"
                },
                "age": {
                  "maximum": 130.0,
                  "minimum": 13.0,
                  "type": "integer"
                },
                "gender": {
                  "enum": [
                    "female",
                    "male"
                  ]
                }
              },
              "required": [
                "DOB",
                "age"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^DOB$": true,
                "^age$": true,
                "^gender$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "User connection schema",
              "oneOf": [
                {
                  "properties": {
                    "connType": {
                      "enum": [
                        "relative"
                      ]
                    },
                    "relation": {
                      "type": "string"
                    }
                  }
                },
                {
                  "properties": {
                    "close": {
                      "type": "boolean"
                    },
                    "connType": {
                      "enum": [
                        "friend",
                        "colleague",
                        "other"
                      ]
                    },
                    "relation": {
                      "type": "boolean"
                    }
                  }
                }
              ],
              "properties": {
                "name": {
                  "maxLength": 128,
                  "type": "string"
                },
                "relation": true,
                "connType": {
                  "type": "string"
                },
                "id": {
                  "maximum": 99999999999.0,
                  "minimum": 1.0,
                  "type": "integer"
                },
                "close": true,
                "since": {
                  "_format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "since",
                "connType"
              ],
              "title": "Connection",
              "type": "object"
            },
            {
              "patternProperties": {
                "^close$": true,
                "^relation$": true,
                "^name$": true,
                "^connType$": true,
                "^id$": true,
                "^since$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Feeds user subscribes to",
              "minProperties": 6,
              "title": "feeds",
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
