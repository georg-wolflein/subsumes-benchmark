{
  "$id": "http://jerzual.github.io/azimut/config.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "title": "ConfigurationSchema",
  "required": [
    "backendurl"
  ],
  "description": "Environment configuration",
  "additionalProperties": false,
  "properties": {
    "backendUrl": {
      "type": "string",
      "default": "",
      "examples": [
        "http://azimut_server"
      ],
      "description": "Base url",
      "pattern": "^https?://(.*)$"
    },
    "databaseHost": {
      "type": "string",
      "description": "host of couchdb",
      "default": ""
    }
  }
}
