{
  "$id": "http://jerzual.github.io/azimut/assets/sprites-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_4",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Meta Schema",
              "properties": {
                "format": {
                  "type": "string",
                  "title": "Format Schema",
                  "default": "",
                  "examples": [
                    "RGBA8888"
                  ],
                  "pattern": "^(.*)$"
                },
                "size": {
                  "$ref": "#/$defs/size",
                  "title": "Size Schema"
                },
                "image": {
                  "type": "string",
                  "title": "Image Schema",
                  "default": "",
                  "examples": [
                    "pack1.png"
                  ],
                  "pattern": "^(.*)$"
                },
                "scale": {
                  "type": "string",
                  "title": "Scale Schema",
                  "default": "",
                  "examples": [
                    "1"
                  ],
                  "pattern": "^(.*)$"
                },
                "smartupdate": {
                  "type": "string",
                  "title": "Smartupdate Schema",
                  "default": "",
                  "examples": [
                    "$TexturePacker:SmartUpdate:c5944b8d86d99a167f95924d4a62d5c3:3ed0ae95f00621580b477fcf2f6edb75:5d0ff2351eb79b7bb8a91bc3358bcff4$"
                  ],
                  "pattern": "^(.*)$"
                },
                "version": {
                  "type": "string",
                  "title": "Version Schema",
                  "default": "",
                  "examples": [
                    "1.0"
                  ],
                  "pattern": "^(.*)$"
                },
                "app": {
                  "type": "string",
                  "title": "App Schema",
                  "default": "",
                  "examples": [
                    "https://www.codeandweb.com/texturepacker"
                  ],
                  "pattern": "^(.*)$"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^app$": true,
                "^smartupdate$": true,
                "^scale$": true,
                "^size$": true,
                "^format$": true,
                "^image$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "size": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Size Schema",
              "required": [
                "w",
                "h"
              ],
              "properties": {
                "w": {
                  "type": "integer",
                  "title": "width",
                  "default": 0,
                  "examples": [
                    640
                  ]
                },
                "h": {
                  "type": "integer",
                  "title": "height",
                  "default": 0,
                  "examples": [
                    480
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^w$": true,
                "^h$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Size And Position Schema",
              "required": [
                "w",
                "h",
                "x",
                "y"
              ],
              "properties": {
                "w": {
                  "type": "integer",
                  "title": "width",
                  "default": 640,
                  "examples": [
                    640
                  ]
                },
                "h": {
                  "type": "integer",
                  "title": "height",
                  "default": 480,
                  "examples": [
                    480
                  ]
                },
                "x": {
                  "type": "integer",
                  "title": "left",
                  "default": 0,
                  "examples": [
                    640
                  ]
                },
                "y": {
                  "type": "integer",
                  "title": "top",
                  "default": 0,
                  "examples": [
                    480
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^w$": true,
                "^h$": true,
                "^x$": true,
                "^y$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "sizeAndPosition": {
      "$ref": "#/$defs/modern_2"
    },
    "sprite": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Sprite Schema",
              "properties": {
                "sourceSize": {
                  "$ref": "#/$defs/size"
                },
                "trimmed": {
                  "type": "boolean"
                },
                "frame": {
                  "$ref": "#/$defs/sizeAndPosition"
                },
                "spriteSourceSize": {
                  "$ref": "#/$defs/sizeAndPosition"
                },
                "rotated": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^spriteSourceSize$": true,
                "^sourceSize$": true,
                "^trimmed$": true,
                "^frame$": true,
                "^rotated$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "TexturePackerSchema",
              "required": [
                "frames"
              ],
              "properties": {
                "frames": {
                  "type": "object",
                  "title": "Frames Schema",
                  "description": "map of images names and sprite infos",
                  "patternProperties": {
                    "^([A-Za-z_\\.])\\.png": {
                      "$ref": "#/$defs/sprite"
                    }
                  }
                },
                "meta": {
                  "$ref": "#/$defs/modern_5"
                }
              }
            },
            {
              "patternProperties": {
                "^frames$": true,
                "^meta$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
