{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o49536.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "website": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "postInstallNotes": {
                    "description": "Post installation notes that would be useful to the user of this package.",
                    "type": "string"
                  },
                  "scm": {
                    "type": "string"
                  },
                  "maintainer": {
                    "type": "string"
                  },
                  "framework": {
                    "default": false,
                    "description": "True if this package installs a new Mesos framework.",
                    "type": "boolean"
                  },
                  "version": {
                    "type": "string"
                  },
                  "preInstallNotes": {
                    "description": "Pre installation notes that would be useful to the user of this package.",
                    "type": "string"
                  },
                  "images": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "description": {
                    "type": "string"
                  },
                  "tags": {
                    "items": {
                      "pattern": "^[^\\s]+$",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "required": [
                  "name",
                  "version",
                  "maintainer",
                  "description",
                  "tags"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^postInstallNotes$": true,
                  "^version$": true,
                  "^description$": true,
                  "^framework$": true,
                  "^images$": true,
                  "^name$": true,
                  "^website$": true,
                  "^scm$": true,
                  "^preInstallNotes$": true,
                  "^maintainer$": true,
                  "^tags$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "icon-large": {
                    "description": "PNG icon URL, preferably 256 by 256 pixels.",
                    "type": "string"
                  },
                  "icon-medium": {
                    "description": "PNG icon URL, preferably 128 by 128 pixels.",
                    "type": "string"
                  },
                  "icon-small": {
                    "description": "PNG icon URL, preferably 48 by 48 pixels.",
                    "type": "string"
                  },
                  "screenshots": {
                    "items": {
                      "description": "PNG screen URL, preferably 1024 by 1024 pixels.",
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^icon-large$": true,
                  "^icon-medium$": true,
                  "^icon-small$": true,
                  "^screenshots$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "description": {
        "type": "string"
      },
      "framework": {
        "default": false,
        "description": "True if this package installs a new Mesos framework.",
        "type": "boolean"
      },
      "images": {
        "additionalProperties": false,
        "properties": {
          "icon-large": {
            "description": "PNG icon URL, preferably 256 by 256 pixels.",
            "type": "string"
          },
          "icon-medium": {
            "description": "PNG icon URL, preferably 128 by 128 pixels.",
            "type": "string"
          },
          "icon-small": {
            "description": "PNG icon URL, preferably 48 by 48 pixels.",
            "type": "string"
          },
          "screenshots": {
            "items": {
              "description": "PNG screen URL, preferably 1024 by 1024 pixels.",
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "maintainer": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "postInstallNotes": {
        "description": "Post installation notes that would be useful to the user of this package.",
        "type": "string"
      },
      "preInstallNotes": {
        "description": "Pre installation notes that would be useful to the user of this package.",
        "type": "string"
      },
      "scm": {
        "type": "string"
      },
      "tags": {
        "items": {
          "pattern": "^[^\\s]+$",
          "type": "string"
        },
        "type": "array"
      },
      "version": {
        "type": "string"
      },
      "website": {
        "type": "string"
      }
    },
    "required": [
      "name",
      "version",
      "maintainer",
      "description",
      "tags"
    ],
    "type": "object"
  }
}
