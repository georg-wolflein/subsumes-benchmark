{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "_id",
                "kind",
                "metadata",
                "data",
                "involvedObject"
              ],
              "properties": {
                "involvedObject": {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "uid": {
                      "type": "string"
                    }
                  }
                },
                "timestamp": {
                  "type": "string"
                },
                "_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36
                },
                "data": {
                  "type": "object"
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "creationTimestamp": {
                      "type": "number"
                    },
                    "deletionTimestamp": {
                      "type": "number"
                    },
                    "resourceVersion": {
                      "type": "number"
                    }
                  }
                },
                "kind": {
                  "type": "string"
                }
              },
              "type:": "object"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^timestamp$": true,
                "^_id$": true,
                "^data$": true,
                "^involvedObject$": true,
                "^kind$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
