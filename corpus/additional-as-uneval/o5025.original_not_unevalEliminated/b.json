{
  "$id": "http://elasticbox.net/schemas/metric",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "kind",
    "metadata",
    "data",
    "involvedObject"
  ],
  "additionalProperties": false,
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "data": {
      "type": "object"
    },
    "involvedObject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "uid": {
          "type": "string"
        }
      }
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "creationTimestamp": {
          "type": "number"
        },
        "deletionTimestamp": {
          "type": "number"
        },
        "resourceVersion": {
          "type": "number"
        }
      }
    },
    "timestamp": {
      "type": "string"
    }
  },
  "type:": "object"
}
