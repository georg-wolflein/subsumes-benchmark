{
  "$id": "http://elasticbox.net/schemas/namespace",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "name",
    "metadata",
    "schema"
  ],
  "additionalProperties": false,
  "properties": {
    "_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 36
    },
    "metadata": {
      "type": "object",
      "properties": {
        "creationTimestamp": {
          "type": "number"
        },
        "deletionTimestamp": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "resourceVersion": {
          "type": "number"
        },
        "uid": {
          "type": "string"
        }
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63
    },
    "schema": {
      "type": "string",
      "enum": [
        "http://elasticbox.net/schemas/namespace"
      ]
    },
    "members": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    }
  },
  "type:": "object"
}
