{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "_id",
                "name",
                "metadata",
                "schema"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63
                },
                "_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36
                },
                "schema": {
                  "type": "string",
                  "enum": [
                    "http://elasticbox.net/schemas/namespace"
                  ]
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 63
                    },
                    "creationTimestamp": {
                      "type": "number"
                    },
                    "resourceVersion": {
                      "type": "number"
                    },
                    "uid": {
                      "type": "string"
                    },
                    "deletionTimestamp": {
                      "type": "number"
                    }
                  }
                },
                "members": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "type:": "object"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^schema$": true,
                "^name$": true,
                "^_id$": true,
                "^members$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
