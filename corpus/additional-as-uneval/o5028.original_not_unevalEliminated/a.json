{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "_id",
                "email",
                "firstname",
                "lastname",
                "metadata",
                "role",
                "schema",
                "username"
              ],
              "properties": {
                "email_validated_at": {
                  "type": "string"
                },
                "invite_token": {
                  "type": "string"
                },
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "lastname": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "schema": {
                  "type": "string",
                  "enum": [
                    "http://elasticbox.net/schemas/user"
                  ]
                },
                "metadata": {
                  "type": "object",
                  "properties": {
                    "creationTimestamp": {
                      "type": "number"
                    },
                    "deletionTimestamp": {
                      "type": "number"
                    },
                    "resourceVersion": {
                      "type": "number"
                    }
                  }
                },
                "last_login": {
                  "type": "string",
                  "maxLength": 2048
                },
                "google_id": {
                  "type": "string"
                },
                "password": {
                  "type": "object",
                  "properties": {
                    "hash": {
                      "type": "string",
                      "maxLength": 256
                    },
                    "rounds": {
                      "enum": [
                        20
                      ]
                    },
                    "salt": {
                      "type": "string",
                      "maxLength": 64
                    }
                  }
                },
                "email": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "role": {
                  "type": "string",
                  "default": "user",
                  "enum": [
                    "administrator",
                    "user"
                  ]
                },
                "_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 36
                },
                "firstname": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "saml_id": {
                  "type": "string"
                },
                "icon": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "type:": "object"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^schema$": true,
                "^username$": true,
                "^role$": true,
                "^email_validated_at$": true,
                "^last_login$": true,
                "^saml_id$": true,
                "^lastname$": true,
                "^icon$": true,
                "^invite_token$": true,
                "^email$": true,
                "^_id$": true,
                "^password$": true,
                "^google_id$": true,
                "^firstname$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
