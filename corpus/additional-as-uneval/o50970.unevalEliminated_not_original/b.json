{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "foo"
              ],
              "properties": {
                "foo": {
                  "$ref": "#/$defs/bar"
                }
              }
            },
            {
              "patternProperties": {
                "^foo$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "bar": {
      "type": "string"
    }
  }
}
