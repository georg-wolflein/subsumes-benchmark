{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Thing data upload",
              "type": "object",
              "properties": {
                "thing": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "thing"
              ]
            },
            {
              "patternProperties": {
                "^thing$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "license_url": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "description",
                "license",
                "license_url"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^license_url$": true,
                "^id$": true,
                "^title$": true,
                "^license$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
