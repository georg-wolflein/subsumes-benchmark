{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "3D data upload",
              "type": "object",
              "properties": {
                "vertices": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "maxItems": 3,
                    "minItems": 3,
                    "items": {
                      "type": "number"
                    }
                  }
                },
                "facets": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "maxItems": 3,
                    "minItems": 3,
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "camera": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "vertices",
                "facets",
                "camera"
              ]
            },
            {
              "patternProperties": {
                "^vertices$": true,
                "^facets$": true,
                "^camera$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            },
            {
              "patternProperties": {
                "^x$": true,
                "^y$": true,
                "^z$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
