        {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        {
          "default": 0
        }
      ]
    },
    "schemaArray": {
      "items": {
        "$ref": "#"
      },
      "minItems": 1,
      "type": "array"
    },
    "simpleTypes": {
      "enum": [
        "array",
        "boolean",
        "integer",
        "null",
        "number",
        "object",
        "string"
      ]
    },
    "stringArray": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array",
      "_uniqueItems": true
    }
  }
