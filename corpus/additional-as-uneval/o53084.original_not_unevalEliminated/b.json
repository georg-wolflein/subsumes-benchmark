  "title": "Core schema meta-schema",
  "type": [
    "object",
    "boolean"
  ],
  "$defs": {
    "nonNegativeInteger": {
      "minimum": 0,
      "type": "integer"
    },
    "nonNegativeIntegerDefault0": {
