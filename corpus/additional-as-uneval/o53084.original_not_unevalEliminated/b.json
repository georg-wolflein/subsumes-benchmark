      "type": "string"
    },
    "$schema": {
      "format": "uri",
      "type": "string"
    },
    "additionalItems": {
      "$ref": "#"
    },
    "additionalProperties": {
      "$ref": "#"
    },
    "allOf": {
      "$ref": "#/$defs/schemaArray"
    },
    "anyOf": {
      "$ref": "#/$defs/schemaArray"
    },
    "const": {},
