{
  "$id": "http://jsongraphformat.info/v2.0/json-graph-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/modern_5"
    },
    {
      "$ref": "#/$defs/modern_6"
    }
  ],
  "title": "JSON Graph Schema",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "graph": {
                  "$ref": "#/$defs/graph"
                }
              },
              "required": [
                "graph"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^graph$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "graphs": {
                  "items": {
                    "$ref": "#/$defs/graph"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^graphs$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "directed": {
                  "default": true,
                  "type": [
                    "boolean"
                  ]
                },
                "label": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "nodes": {
                  "$ref": "#/$defs/modern_2"
                },
                "metadata": {
                  "type": [
                    "object"
                  ]
                },
                "edges": {
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  },
                  "type": [
                    "array"
                  ]
                },
                "type": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^label$": true,
                "^nodes$": true,
                "^type$": true,
                "^id$": true,
                "^directed$": true,
                "^edges$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/modern_3"
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "label": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^label$": true,
                "^metadata$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "graph": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "relation": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "metadata": {
                  "type": [
                    "object"
                  ]
                },
                "target": {
                  "type": "string"
                },
                "source": {
                  "type": "string"
                },
                "directed": {
                  "default": true,
                  "type": [
                    "boolean"
                  ]
                }
              },
              "required": [
                "source",
                "target"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^target$": true,
                "^id$": true,
                "^directed$": true,
                "^source$": true,
                "^label$": true,
                "^relation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
