{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "meta": {
      "$ref": "#/$defs/modern_1"
    },
    "data": {
      "$ref": "#/$defs/modern_5"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_7"
      }
    }
  },
  "required": [
    "meta",
    "data",
    "links"
  ],
  "additonalProperties": false,
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                },
                "customData": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^reason$": true,
                "^customData$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": true
              },
              "required": [
                "key",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/modern_2"
                },
                "security": {
                  "$ref": "#/$defs/modern_3"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "version": {
                  "type": "string",
                  "enum": [
                    "2.0.0"
                  ],
                  "default": "2.0.0"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "time": {
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "EiffelActivityCanceledEvent"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "version",
                "time"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^security$": true,
                "^type$": true,
                "^id$": true,
                "^time$": true,
                "^source$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "type",
                "target"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^target$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "serializer": {
                  "type": "string",
                  "pattern": "^pkg:"
                },
                "domainId": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^host$": true,
                "^name$": true,
                "^domainId$": true,
                "^serializer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "sdm": {
                  "$ref": "#/$defs/modern_4"
                }
              }
            },
            {
              "patternProperties": {
                "^sdm$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "authorIdentity": {
                  "type": "string"
                },
                "encryptedDigest": {
                  "type": "string"
                }
              },
              "required": [
                "authorIdentity",
                "encryptedDigest"
              ]
            },
            {
              "patternProperties": {
                "^authorIdentity$": true,
                "^encryptedDigest$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
