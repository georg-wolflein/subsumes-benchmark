{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "JupyterLab Plugin Settings/Preferences Schema",
              "description": "JupyterLab plugin settings/preferences schema",
              "version": "1.0.0",
              "type": "object",
              "properties": {
                "jupyter.lab.setting-icon-label": {
                  "type": "string",
                  "default": "Plugin"
                },
                "jupyter.lab.setting-icon-class": {
                  "type": "string",
                  "default": ""
                },
                "jupyter.lab.setting-deprecated": {
                  "type": "boolean",
                  "default": false
                },
                "jupyter.lab.setting-icon": {
                  "type": "string",
                  "default": ""
                },
                "jupyter.lab.shortcuts": {
                  "items": {
                    "$ref": "#/$defs/shortcut"
                  },
                  "type": "array",
                  "default": []
                },
                "jupyter.lab.transform": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            {
              "patternProperties": {
                "^jupyter.lab.setting-icon-class$": true,
                "^jupyter.lab.setting-icon$": true,
                "^jupyter.lab.shortcuts$": true,
                "^jupyter.lab.setting-icon-label$": true,
                "^jupyter.lab.setting-deprecated$": true,
                "^jupyter.lab.transform$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "shortcut": {
      "properties": {
        "command": {
          "type": "string"
        },
        "selector": {
          "type": "string"
        },
        "keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "disabled": {
          "type": "boolean",
          "default": false
        },
        "args": {
          "type": "object"
        }
      },
      "required": [
        "command",
        "keys",
        "selector"
      ],
      "type": "object"
    }
  }
}
