{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "signature": {
                  "type": "string"
                },
                "alg": {
                  "type": "string",
                  "enum": [
                    "HS256",
                    "HS384",
                    "HS512",
                    "RS256",
                    "RS384",
                    "RS512",
                    "ES256",
                    "ES384",
                    "ES512",
                    "PS256",
                    "PS384",
                    "PS512"
                  ]
                },
                "publicKey": {
                  "type": "string"
                }
              },
              "required": [
                "signature",
                "alg"
              ]
            },
            {
              "patternProperties": {
                "^signature$": true,
                "^alg$": true,
                "^publicKey$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "sequenceName": {
                  "type": "string"
                },
                "position": {
                  "type": "integer"
                }
              },
              "required": [
                "sequenceName",
                "position"
              ]
            },
            {
              "patternProperties": {
                "^sequenceName$": true,
                "^position$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": true
              },
              "required": [
                "key",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "type",
                "target"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^target$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "meta": {
                  "$ref": "#/$defs/modern_2"
                },
                "data": {
                  "$ref": "#/$defs/modern_7"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_15"
                  }
                }
              },
              "required": [
                "meta",
                "data",
                "links"
              ]
            },
            {
              "patternProperties": {
                "^meta$": true,
                "^data$": true,
                "^links$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "author": {
                  "$ref": "#/$defs/modern_8"
                },
                "ccCompositeIdentifier": {
                  "$ref": "#/$defs/modern_9"
                },
                "customData": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                },
                "change": {
                  "$ref": "#/$defs/modern_11"
                },
                "gitIdentifier": {
                  "$ref": "#/$defs/modern_12"
                },
                "hgIdentifier": {
                  "$ref": "#/$defs/modern_13"
                },
                "svnIdentifier": {
                  "$ref": "#/$defs/modern_14"
                }
              }
            },
            {
              "patternProperties": {
                "^ccCompositeIdentifier$": true,
                "^customData$": true,
                "^change$": true,
                "^gitIdentifier$": true,
                "^author$": true,
                "^hgIdentifier$": true,
                "^svnIdentifier$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/modern_3"
                },
                "security": {
                  "$ref": "#/$defs/modern_4"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "version": {
                  "type": "string",
                  "enum": [
                    "4.0.0"
                  ],
                  "default": "4.0.0"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "time": {
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "EiffelSourceChangeCreatedEvent"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "version",
                "time"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^security$": true,
                "^type$": true,
                "^id$": true,
                "^time$": true,
                "^source$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "commitId": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "repoName": {
                  "type": "string"
                },
                "repoUri": {
                  "type": "string"
                }
              },
              "required": [
                "commitId",
                "repoUri"
              ]
            },
            {
              "patternProperties": {
                "^commitId$": true,
                "^branch$": true,
                "^repoName$": true,
                "^repoUri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true,
                "^id$": true,
                "^group$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "vobs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "branch": {
                  "type": "string"
                },
                "configSpec": {
                  "type": "string"
                }
              },
              "required": [
                "vobs",
                "branch",
                "configSpec"
              ]
            },
            {
              "patternProperties": {
                "^vobs$": true,
                "^branch$": true,
                "^configSpec$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "commitId": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "repoName": {
                  "type": "string"
                },
                "repoUri": {
                  "type": "string"
                }
              },
              "required": [
                "commitId",
                "repoUri"
              ]
            },
            {
              "patternProperties": {
                "^commitId$": true,
                "^branch$": true,
                "^repoName$": true,
                "^repoUri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "serializer": {
                  "type": "string",
                  "pattern": "^pkg:"
                },
                "domainId": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^host$": true,
                "^name$": true,
                "^domainId$": true,
                "^serializer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tracker": {
                  "type": "string"
                },
                "files": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "details": {
                  "type": "string"
                },
                "insertions": {
                  "type": "integer"
                },
                "deletions": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^insertions$": true,
                "^files$": true,
                "^details$": true,
                "^deletions$": true,
                "^tracker$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "integer"
                },
                "directory": {
                  "type": "string"
                },
                "repoName": {
                  "type": "string"
                },
                "repoUri": {
                  "type": "string"
                }
              },
              "required": [
                "revision",
                "directory",
                "repoUri"
              ]
            },
            {
              "patternProperties": {
                "^revision$": true,
                "^directory$": true,
                "^repoName$": true,
                "^repoUri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "authorIdentity": {
                  "type": "string"
                },
                "integrityProtection": {
                  "$ref": "#/$defs/modern_5"
                },
                "sequenceProtection": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                }
              },
              "required": [
                "authorIdentity"
              ]
            },
            {
              "patternProperties": {
                "^authorIdentity$": true,
                "^integrityProtection$": true,
                "^sequenceProtection$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
