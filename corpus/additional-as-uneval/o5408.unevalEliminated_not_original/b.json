{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "signature": {
                  "type": "string"
                },
                "alg": {
                  "type": "string",
                  "enum": [
                    "HS256",
                    "HS384",
                    "HS512",
                    "RS256",
                    "RS384",
                    "RS512",
                    "ES256",
                    "ES384",
                    "ES512",
                    "PS256",
                    "PS384",
                    "PS512"
                  ]
                },
                "publicKey": {
                  "type": "string"
                }
              },
              "required": [
                "signature",
                "alg"
              ]
            },
            {
              "patternProperties": {
                "^signature$": true,
                "^alg$": true,
                "^publicKey$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "sequenceName": {
                  "type": "string"
                },
                "position": {
                  "type": "integer"
                }
              },
              "required": [
                "sequenceName",
                "position"
              ]
            },
            {
              "patternProperties": {
                "^sequenceName$": true,
                "^position$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "MANUAL",
                    "EIFFEL_EVENT",
                    "SOURCE_CHANGE",
                    "TIMER",
                    "OTHER"
                  ]
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "meta": {
                  "$ref": "#/$defs/modern_2"
                },
                "data": {
                  "$ref": "#/$defs/modern_7"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_12"
                  }
                }
              },
              "required": [
                "meta",
                "data",
                "links"
              ]
            },
            {
              "patternProperties": {
                "^meta$": true,
                "^data$": true,
                "^links$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "recipeId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "testCase": {
                  "$ref": "#/$defs/modern_8"
                },
                "customData": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_9"
                  }
                },
                "triggers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                },
                "executionType": {
                  "type": "string",
                  "enum": [
                    "MANUAL",
                    "SEMI_AUTOMATED",
                    "AUTOMATED",
                    "OTHER"
                  ]
                },
                "parameters": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  }
                }
              },
              "required": [
                "testCase"
              ]
            },
            {
              "patternProperties": {
                "^customData$": true,
                "^triggers$": true,
                "^executionType$": true,
                "^testCase$": true,
                "^recipeId$": true,
                "^parameters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/modern_3"
                },
                "security": {
                  "$ref": "#/$defs/modern_4"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "version": {
                  "type": "string",
                  "enum": [
                    "3.0.0"
                  ],
                  "default": "3.0.0"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "time": {
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "EiffelTestCaseTriggeredEvent"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "version",
                "time"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^security$": true,
                "^type$": true,
                "^id$": true,
                "^time$": true,
                "^source$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "type",
                "target"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^target$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tracker": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ]
            },
            {
              "patternProperties": {
                "^tracker$": true,
                "^id$": true,
                "^version$": true,
                "^uri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": true
              },
              "required": [
                "key",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "serializer": {
                  "type": "string",
                  "pattern": "^pkg:"
                },
                "domainId": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^host$": true,
                "^name$": true,
                "^domainId$": true,
                "^serializer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "authorIdentity": {
                  "type": "string"
                },
                "integrityProtection": {
                  "$ref": "#/$defs/modern_5"
                },
                "sequenceProtection": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                }
              },
              "required": [
                "authorIdentity"
              ]
            },
            {
              "patternProperties": {
                "^authorIdentity$": true,
                "^integrityProtection$": true,
                "^sequenceProtection$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
