{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "sdm": {
                  "$ref": "#/$defs/modern_6"
                }
              }
            },
            {
              "patternProperties": {
                "^sdm$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "authorIdentity": {
                  "type": "string"
                },
                "encryptedDigest": {
                  "type": "string"
                }
              },
              "required": [
                "authorIdentity",
                "encryptedDigest"
              ]
            },
            {
              "patternProperties": {
                "^authorIdentity$": true,
                "^encryptedDigest$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "type",
                "target"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^target$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "meta": {
                  "$ref": "#/$defs/modern_2"
                },
                "data": {
                  "$ref": "#/$defs/modern_7"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                }
              },
              "required": [
                "meta",
                "data",
                "links"
              ]
            },
            {
              "patternProperties": {
                "^meta$": true,
                "^data$": true,
                "^links$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "customData": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                },
                "categories": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "liveLogs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_9"
                  }
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "ACCESSIBILITY",
                      "BACKUP_RECOVERY",
                      "COMPATIBILITY",
                      "CONVERSION",
                      "DISASTER_RECOVERY",
                      "FUNCTIONAL",
                      "INSTALLABILITY",
                      "INTEROPERABILITY",
                      "LOCALIZATION",
                      "MAINTAINABILITY",
                      "PERFORMANCE",
                      "PORTABILITY",
                      "PROCEDURE",
                      "RELIABILITY",
                      "SECURITY",
                      "STABILITY",
                      "USABILITY"
                    ]
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^customData$": true,
                "^types$": true,
                "^liveLogs$": true,
                "^categories$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "$ref": "#/$defs/modern_3"
                },
                "security": {
                  "$ref": "#/$defs/modern_5"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "version": {
                  "type": "string",
                  "enum": [
                    "1.1.0"
                  ],
                  "default": "1.1.0"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "time": {
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "EiffelTestSuiteStartedEvent"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "version",
                "time"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^security$": true,
                "^type$": true,
                "^id$": true,
                "^time$": true,
                "^source$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": true
              },
              "required": [
                "key",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "uri"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^uri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "serializer": {
                  "$ref": "#/$defs/modern_4"
                },
                "domainId": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^host$": true,
                "^name$": true,
                "^domainId$": true,
                "^serializer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "groupId": {
                  "type": "string"
                },
                "artifactId": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "groupId",
                "artifactId",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^groupId$": true,
                "^artifactId$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
