{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Bozr test suite schema definition",
  "type": "array",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "enum": [
                    200,
                    201,
                    202,
                    203,
                    204,
                    205,
                    206,
                    207,
                    208,
                    209,
                    226,
                    300,
                    301,
                    302,
                    303,
                    304,
                    305,
                    306,
                    307,
                    308,
                    400,
                    401,
                    402,
                    403,
                    404,
                    405,
                    406,
                    407,
                    408,
                    409,
                    410,
                    411,
                    412,
                    413,
                    414,
                    415,
                    416,
                    417,
                    418,
                    421,
                    422,
                    423,
                    424,
                    426,
                    428,
                    429,
                    431,
                    451,
                    500,
                    501,
                    502,
                    503,
                    504,
                    505,
                    506,
                    507,
                    508,
                    510,
                    511
                  ]
                },
                "body": {
                  "type": "object",
                  "minProperties": 1
                },
                "absent": {
                  "type": "array",
                  "minItems": 1
                },
                "exactBody": {
                  "type": "object",
                  "minProperties": 1
                },
                "contentType": {
                  "type": "string"
                },
                "bodySchemaFile": {
                  "type": "string"
                },
                "bodySchema": {
                  "type": "string"
                },
                "bodySchemaURI": {
                  "type": "string"
                },
                "headers": {
                  "type": "object",
                  "minProperties": 1
                },
                "bodyPath": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            },
            {
              "patternProperties": {
                "^absent$": true,
                "^headers$": true,
                "^bodySchemaURI$": true,
                "^body$": true,
                "^bodySchema$": true,
                "^bodySchemaFile$": true,
                "^bodyPath$": true,
                "^exactBody$": true,
                "^contentType$": true,
                "^statusCode$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Short name of the test that will be used in reports."
                },
                "description": {
                  "type": "string",
                  "description": "Long description of the test."
                },
                "ignore": {
                  "type": "string",
                  "description": "Ignore test due to a reason",
                  "minLength": 10
                },
                "calls": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "calls"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^description$": true,
                "^ignore$": true,
                "^calls$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "remember": {
                  "$ref": "#/$defs/modern_3"
                },
                "description": {
                  "type": "string",
                  "description": "Description of the test call"
                },
                "on": {
                  "$ref": "#/$defs/modern_4"
                },
                "expect": {
                  "$ref": "#/$defs/modern_5"
                },
                "args": {
                  "type": "object",
                  "minProperties": 1
                }
              },
              "required": [
                "on",
                "expect"
              ]
            },
            {
              "patternProperties": {
                "^args$": true,
                "^description$": true,
                "^remember$": true,
                "^expect$": true,
                "^on$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "bodyPath": {
                  "type": "object",
                  "minProperties": 1
                },
                "headers": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            },
            {
              "patternProperties": {
                "^bodyPath$": true,
                "^headers$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "bodyFile": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "params": {
                  "type": "object",
                  "minProperties": 1
                },
                "headers": {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "Accept": {
                      "type": "string"
                    },
                    "Content-Type": {
                      "type": "string"
                    },
                    "Authorization": {
                      "type": "string"
                    }
                  }
                },
                "method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE",
                    "HEAD",
                    "OPTIONS",
                    "PATCH",
                    "CONNECT",
                    "TRACE"
                  ]
                },
                "body": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              },
              "required": [
                "method",
                "url"
              ]
            },
            {
              "patternProperties": {
                "^headers$": true,
                "^method$": true,
                "^body$": true,
                "^url$": true,
                "^params$": true,
                "^bodyFile$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
