{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "price": {
                  "type": "string"
                },
                "brand": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "schema": {
                  "format": "url",
                  "type": "string"
                },
                "category": {
                  "type": "string"
                }
              },
              "required": [
                "schema",
                "id",
                "brand",
                "name",
                "description",
                "category"
              ],
              "self": {
                "format": "jsonschema",
                "name": "product/create",
                "vendor": "com.nordstrom",
                "version": "1-0-0"
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^description$": true,
                "^category$": true,
                "^name$": true,
                "^id$": true,
                "^brand$": true,
                "^price$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
