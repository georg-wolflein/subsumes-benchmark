{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "isPurchasableFromMarketplace": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "isFeatured": {
                  "type": "boolean"
                },
                "flair": {
                  "type": "null"
                },
                "isPurchasableWithCredits": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string"
                },
                "isNew": {
                  "type": "boolean"
                },
                "xboxMarketplaceProductId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stackedRequisitionPacks": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/StackedRequisitionPack"
                  }
                },
                "merchandisingOrder": {
                  "type": "integer"
                },
                "xboxMarketplaceProductUrl": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "isStack": {
                  "type": "boolean"
                },
                "creditPrice": {
                  "type": "integer"
                },
                "largeImageUrl": {
                  "type": "string"
                },
                "contentId": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description",
                "largeImageUrl",
                "isStack",
                "isFeatured",
                "isNew",
                "creditPrice",
                "isPurchasableWithCredits",
                "isPurchasableFromMarketplace",
                "xboxMarketplaceProductId",
                "xboxMarketplaceProductUrl",
                "merchandisingOrder",
                "flair",
                "stackedRequisitionPacks",
                "id",
                "contentId"
              ]
            },
            {
              "patternProperties": {
                "^stackedRequisitionPacks$": true,
                "^isFeatured$": true,
                "^isPurchasableFromMarketplace$": true,
                "^flair$": true,
                "^id$": true,
                "^isPurchasableWithCredits$": true,
                "^largeImageUrl$": true,
                "^contentId$": true,
                "^xboxMarketplaceProductId$": true,
                "^isNew$": true,
                "^xboxMarketplaceProductUrl$": true,
                "^description$": true,
                "^isStack$": true,
                "^name$": true,
                "^creditPrice$": true,
                "^merchandisingOrder$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "StackedRequisitionPack": {
      "$ref": "#"
    }
  }
}
