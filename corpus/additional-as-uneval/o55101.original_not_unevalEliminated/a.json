{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "port": {
                  "default": 80,
                  "type": "integer"
                },
                "role": {
                  "default": "slave_public",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^port$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
