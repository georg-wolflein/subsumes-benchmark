{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "users",
    "releases",
    "companies",
    "repos",
    "project_types"
  ],
  "properties": {
    "users": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "module_groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_3"
      }
    },
    "releases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_4"
      }
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_5"
      }
    },
    "companies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_6"
      }
    },
    "mail_lists": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_types": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_7"
      }
    },
    "project_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_8"
      }
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string"
                },
                "organization": {
                  "type": "string"
                },
                "module": {
                  "type": "string"
                },
                "releases": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "branch": {
                        "type": "string"
                      },
                      "tag_from": {
                        "type": "string"
                      },
                      "tag_to": {
                        "type": "string"
                      },
                      "release_name": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "tag_from",
                      "tag_to",
                      "release_name"
                    ]
                  }
                }
              },
              "required": [
                "uri",
                "module",
                "organization"
              ]
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^organization$": true,
                "^module$": true,
                "^releases$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "company_name": {
                  "type": "string"
                },
                "domains": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z\\d\\.-]*$"
                  }
                }
              },
              "required": [
                "company_name",
                "domains"
              ]
            },
            {
              "patternProperties": {
                "^company_name$": true,
                "^domains$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "emails": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z\\d_\\.-]+@([a-z\\d\\.-]+\\.)+[a-z]+$"
                  },
                  "minItems": 1
                },
                "gerrit_id": {
                  "type": "string"
                },
                "user_name": {
                  "type": "string"
                },
                "companies": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "minItems": 1
                },
                "launchpad_id": {
                  "type": "string",
                  "pattern": "^[a-z\\d\\.-]+$"
                }
              },
              "required": [
                "launchpad_id",
                "user_name",
                "emails"
              ]
            },
            {
              "patternProperties": {
                "^user_name$": true,
                "^emails$": true,
                "^launchpad_id$": true,
                "^companies$": true,
                "^gerrit_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[\\w-]+$"
                },
                "child": {
                  "type": "boolean"
                },
                "title": {
                  "type": "string"
                },
                "modules": {
                  "type": [
                    "array"
                  ],
                  "items": {
                    "type": "string",
                    "pattern": "^[\\w-]+$"
                  }
                }
              },
              "required": [
                "id",
                "title",
                "modules"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^child$": true,
                "^title$": true,
                "^modules$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "company_name": {
                  "type": "string"
                },
                "end_date": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^20\\d{2}-\\w{3}-[0-3]\\d$"
                }
              },
              "required": [
                "company_name",
                "end_date"
              ]
            },
            {
              "patternProperties": {
                "^company_name$": true,
                "^end_date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "organization": {
                  "type": "string"
                },
                "module_group_name": {
                  "type": "string",
                  "pattern": "^[\\w-]+$"
                },
                "exclude": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "organization"
              ]
            },
            {
              "patternProperties": {
                "^organization$": true,
                "^module_group_name$": true,
                "^exclude$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "module_group_name": {
                  "type": "string",
                  "pattern": "^[\\w-]+$"
                },
                "modules": {
                  "type": [
                    "array"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "module_group_name",
                "modules"
              ]
            },
            {
              "patternProperties": {
                "^module_group_name$": true,
                "^modules$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "release_name": {
                  "type": "string"
                },
                "end_date": {
                  "type": "string",
                  "pattern": "^20\\d{2}-\\w{3}-[0-3]\\d$"
                }
              },
              "required": [
                "release_name",
                "end_date"
              ]
            },
            {
              "patternProperties": {
                "^release_name$": true,
                "^end_date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
