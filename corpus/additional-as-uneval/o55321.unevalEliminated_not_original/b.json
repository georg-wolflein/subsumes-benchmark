{
  "$id": "https://lnmp.khs1994.com",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "architecture": {
                  "$ref": "#/$defs/architecture"
                },
                "os": {
                  "$ref": "#/$defs/os"
                },
                "hash": {
                  "$ref": "#/$defs/hash"
                }
              }
            },
            {
              "patternProperties": {
                "^architecture$": true,
                "^os$": true,
                "^hash$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "soft package hash",
              "properties": {
                "sha512": {
                  "type": "string",
                  "description": "sha512 hash"
                },
                "sha256": {
                  "type": "string",
                  "description": "sha256 hash"
                }
              }
            },
            {
              "patternProperties": {
                "^sha512$": true,
                "^sha256$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "os": {
      "description": "os",
      "default": "windows",
      "type": "string",
      "enum": [
        "linux",
        "windows",
        "darwin"
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "JSON schema for configuring LWPM",
              "$comment": "https://docs.lnmp.khs1994.com/windows/lwpm.html",
              "description": "see https://docs.lnmp.khs1994.com/windows/lwpm.html",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "soft name"
                },
                "path": {
                  "type": "array",
                  "description": "insert path",
                  "items": {
                    "type": "string"
                  },
                  "default": [
                    "C:\\bin"
                  ]
                },
                "url": {
                  "description": "soft download url",
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "description": "soft description"
                },
                "os": {
                  "$ref": "#/$defs/os"
                },
                "url-mirror": {
                  "description": "soft download url mirror",
                  "type": "string"
                },
                "version": {
                  "type": "string",
                  "description": "soft version",
                  "default": "x.y.z"
                },
                "unix-path": {
                  "type": "array",
                  "description": "unix system(e.g. Linux/macOS) PATH, add to ~/.bashrc manual",
                  "items": {
                    "type": "string"
                  },
                  "default": [
                    "/path/bin"
                  ]
                },
                "download-filename": {
                  "type": "string",
                  "description": "download filename"
                },
                "homepage": {
                  "description": "soft homepage",
                  "type": "string"
                },
                "releases": {
                  "description": "soft releases pages",
                  "type": "string"
                },
                "$comment": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "description": "Comments from this package"
                },
                "github": {
                  "description": "soft github, example: user/repo",
                  "type": "string",
                  "default": "username/repo"
                },
                "pre-url-mirror": {
                  "description": "soft pre version download url mirror",
                  "type": "string"
                },
                "command": {
                  "type": "string",
                  "description": "what command this package provide"
                },
                "architecture": {
                  "$ref": "#/$defs/architecture"
                },
                "pre-url": {
                  "description": "soft pre version download url",
                  "type": "string"
                },
                "bug": {
                  "description": "soft bug report",
                  "type": "string"
                },
                "pre-version": {
                  "type": "string",
                  "description": "soft pre version",
                  "default": "x.y.z-alpha.1"
                },
                "hash-url": {
                  "$ref": "#/$defs/modern_3"
                },
                "scripts": {
                  "$ref": "#/$defs/modern_4"
                },
                "platform": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "_uniqueItems": true,
                  "minimum": 1.0
                }
              },
              "required": [
                "version"
              ]
            },
            {
              "patternProperties": {
                "^download-filename$": true,
                "^os$": true,
                "^github$": true,
                "^pre-version$": true,
                "^description$": true,
                "^$comment$": true,
                "^bug$": true,
                "^homepage$": true,
                "^url$": true,
                "^platform$": true,
                "^name$": true,
                "^releases$": true,
                "^pre-url$": true,
                "^path$": true,
                "^hash-url$": true,
                "^command$": true,
                "^url-mirror$": true,
                "^scripts$": true,
                "^version$": true,
                "^pre-url-mirror$": true,
                "^unix-path$": true,
                "^architecture$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "architecture": {
      "description": "architecture",
      "default": "amd64",
      "type": "string",
      "enum": [
        "arm",
        "arm64",
        "amd64"
      ]
    },
    "hash": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "hash url",
              "properties": {
                "sha256": {
                  "type": "string",
                  "description": "sha256 url"
                },
                "sha384": {
                  "type": "string",
                  "description": "sha384 url"
                },
                "sha512": {
                  "type": "string",
                  "description": "sha512 url"
                }
              }
            },
            {
              "patternProperties": {
                "^sha256$": true,
                "^sha384$": true,
                "^sha512$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "get-latest-version": {
                  "type": "string",
                  "description": "Function Get-LatestVersion(){ }",
                  "default": [
                    "Function Get-LatestVersion(){ }"
                  ]
                },
                "test": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "default": [
                    "printInfo $(command --version) install success"
                  ]
                },
                "get-version": {
                  "type": "string",
                  "description": "set arg $VERSION",
                  "default": [
                    "if($isPre){$VERSION='x.y.z-beta'}else{$VERSION='x.y.z'}"
                  ]
                },
                "postuninstall": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "version": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "description": "how to get version string"
                },
                "hash": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "description": "how to check soft package hash"
                },
                "preinstall": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "default": [
                    "# _cleanup \"$unzipDesc\""
                  ]
                },
                "install": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "default": [
                    "# Write-Host \"`nPlease download on this website: \\${releases\\}`n\" -ForegroundColor Green",
                    "# _unzip \\$filename \\$unzipDesc",
                    "# Copy-item -r -force \"\\$unzipDesc/\" \"\"",
                    "# cp \\$env:LWPM_PKG_ROOT\\dist\\file \\dest\\path",
                    "# Start-Process -FilePath \\$filename -wait",
                    "# _cleanup \"\\$unzipDesc\""
                  ]
                },
                "pretest": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "postinstall": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "preuninstall": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "posttest": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "pruneuninstall": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "uninstall": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "default": "# _cleanup /soft/path"
                },
                "download": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "description": "download",
                  "default": [
                    "# _mkdir \\$env:LWPM_PKG_ROOT/dist",
                    "# curl -L `",
                    "# \\$url `",
                    "# -o \\$env:LWPM_PKG_ROOT/dist/\\${env:lwpm_os\\}-\\${env:lwpm_architecture\\}/\\$filename"
                  ]
                },
                "platform-reqs": {
                  "type": [
                    "string",
                    "array"
                  ],
                  "description": "if last command echo $false, means not support this platform. e.g. echo $False",
                  "default": [
                    "if(!$IsWindows){echo $False}"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^get-latest-version$": true,
                "^preuninstall$": true,
                "^version$": true,
                "^postuninstall$": true,
                "^preinstall$": true,
                "^pretest$": true,
                "^uninstall$": true,
                "^get-version$": true,
                "^postinstall$": true,
                "^install$": true,
                "^pruneuninstall$": true,
                "^hash$": true,
                "^posttest$": true,
                "^platform-reqs$": true,
                "^download$": true,
                "^test$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
