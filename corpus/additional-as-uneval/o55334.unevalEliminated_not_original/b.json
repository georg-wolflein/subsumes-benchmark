{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Floating IP PTR",
              "properties": {
                "floatingip": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "floatingip"
              ],
              "title": "floatingip"
            },
            {
              "patternProperties": {
                "^floatingip$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "description": {
                  "description": "Description for the PTR",
                  "maxLength": 160,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "links": {
                  "$ref": "#/$defs/modern_3"
                },
                "id": {
                  "description": "Floating IP PTR identifier",
                  "pattern": "^[A-Za-z0-9\\.\\-_]{1,100}:([0-9a-fA-F]){8}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){12}$",
                  "readOnly": true,
                  "type": "string"
                },
                "ttl": {
                  "description": "Default time to live",
                  "maximum": 2147483647.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "action": {
                  "description": "Floating IP PTR Action",
                  "enum": [
                    "CREATE",
                    "DELETE",
                    "UPDATE",
                    "NONE"
                  ],
                  "readOnly": true,
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "status": {
                  "description": "Floating IP PTR Status",
                  "enum": [
                    "ACTIVE",
                    "PENDING",
                    "ERROR"
                  ],
                  "readOnly": true,
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "ptrdname": {
                  "format": "hostname",
                  "required:": true,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^action$": true,
                "^description$": true,
                "^ptrdname$": true,
                "^ttl$": true,
                "^status$": true,
                "^links$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "self": {
                  "format": "url",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^self$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
