{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "self": {
                  "format": "url",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^self$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Pool",
              "properties": {
                "pool": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "pool"
              ],
              "title": "pool"
            },
            {
              "patternProperties": {
                "^pool$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "description": "Pool name",
                  "immutable": true,
                  "maxLength": 50,
                  "type": "string"
                },
                "ns_records": {
                  "description": "List of NS Records for Zones in this pool",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "description": {
                  "description": "Description for the pool",
                  "maxLength": 160,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "attributes": {
                  "$ref": "#/$defs/modern_4"
                },
                "id": {
                  "description": "Pool identifier",
                  "pattern": "^([0-9a-fA-F]){8}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){12}$",
                  "readOnly": true,
                  "type": "string"
                },
                "project_id": {
                  "description": "Project identifier",
                  "immutable": true,
                  "maxLength": 36,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "created_at": {
                  "description": "Date and time of pool creation",
                  "format": "date-time",
                  "readOnly": true,
                  "type": "string"
                },
                "updated_at": {
                  "description": "Date and time of last pool modification",
                  "format": "date-time",
                  "readOnly": true,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "version": {
                  "description": "Pool version number",
                  "readOnly": true,
                  "type": "integer"
                },
                "links": {
                  "$ref": "#/$defs/modern_5"
                }
              },
              "required": [
                "name",
                "attributes",
                "ns_records"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^attributes$": true,
                "^created_at$": true,
                "^id$": true,
                "^project_id$": true,
                "^ns_records$": true,
                "^updated_at$": true,
                "^version$": true,
                "^links$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "hostname": {
                  "format": "hostname",
                  "maxLength": 255,
                  "type": "string"
                },
                "priority": {
                  "maximum": 1000.0,
                  "minimum": 0.0,
                  "type": "integer"
                }
              },
              "required": [
                "priority",
                "hostname"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^hostname$": true,
                "^priority$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Pool attributes as name value pairs",
              "properties": {
                "scope": {
                  "enum": [
                    "public",
                    "private"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^scope$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
