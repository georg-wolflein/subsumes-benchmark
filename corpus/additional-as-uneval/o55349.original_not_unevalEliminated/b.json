{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "algorithm": {
      "maximum": 2,
      "minimum": 1,
      "type": "integer"
    },
    "fingerprint": {
      "pattern": "^[0-9A-Fa-f]{40}$",
      "type": "string"
    },
    "type": {
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "algorithm",
    "type",
    "fingerprint"
  ]
}
