{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Zone Transfer Accept",
              "properties": {
                "transfer_accept": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "transfer_accept"
              ],
              "title": "zone_transfer_accept"
            },
            {
              "patternProperties": {
                "^transfer_accept$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "key": {
                  "description": "Password used to complete the transfer",
                  "maxLength": 160,
                  "type": "string"
                },
                "links": {
                  "$ref": "#/$defs/modern_3"
                },
                "id": {
                  "description": "Zone Transfer Request identifier",
                  "pattern": "^([0-9a-fA-F]){8}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){12}$",
                  "readOnly": true,
                  "type": "string"
                },
                "status": {
                  "description": "Zone Status",
                  "enum": [
                    "ACTIVE",
                    "PENDING",
                    "DELETED",
                    "ERROR",
                    "COMPLETE"
                  ],
                  "readOnly": true,
                  "type": "string"
                },
                "created_at": {
                  "description": "Date and time of Request creation",
                  "format": "date-time",
                  "readOnly": true,
                  "type": "string"
                },
                "zone_transfer_request_id": {
                  "description": "Request identifier",
                  "pattern": "^([0-9a-fA-F]){8}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){4}-([0-9a-fA-F]){12}$",
                  "type": "string"
                },
                "updated_at": {
                  "description": "Date and time of last Request modification",
                  "format": "date-time",
                  "readOnly": true,
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "zone_transfer_request_id",
                "key"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^zone_transfer_request_id$": true,
                "^updated_at$": true,
                "^status$": true,
                "^links$": true,
                "^created_at$": true,
                "^id$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "self": {
                  "format": "url",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^self$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
