{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Update Post",
  "type": "object",
  "required": [
    "post"
  ],
  "properties": {
    "post": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "title",
                "body"
              ],
              "properties": {
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^title$": true,
                "^body$": true,
                "^author$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
