{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Fibaro Home Center Settings Info JSON Schema",
              "name": "info",
              "type": "object",
              "properties": {
                "newestStableVersion": {
                  "description": "Newest Stable Version",
                  "type": "string"
                },
                "batteryLowNotification": {
                  "description": "Low Batery Notification Flag",
                  "type": "boolean"
                },
                "updateStableAvailable": {
                  "description": "Stable Image Update Availability Flag",
                  "type": "boolean"
                },
                "hotelMode": {
                  "description": "Hotel Mode Flag",
                  "type": "boolean"
                },
                "newestBetaVersion": {
                  "description": "Newest Beta Version",
                  "type": "string"
                },
                "softVersion": {
                  "description": "Home Center Software Version",
                  "type": "string",
                  "maxLength": 10
                },
                "zwaveVersion": {
                  "description": "Home Center ZWave Version",
                  "type": "string",
                  "maxLength": 10
                },
                "temperatureUnit": {
                  "description": "Default temperature units",
                  "type": "string",
                  "maxLength": 1,
                  "minLength": 1
                },
                "serverStatus": {
                  "description": "Home Center Server Timestamp",
                  "type": "integer"
                },
                "serialNumber": {
                  "description": "Home Center Serial Number",
                  "type": "string",
                  "maxLength": 10
                },
                "sunriseHour": {
                  "description": "Sunrise Hour",
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}$"
                },
                "mac": {
                  "description": "Home Center MAC Address",
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]{2}(:[A-Za-z0-9]{2}){5}$"
                },
                "sunsetHour": {
                  "description": "Sunset Hour",
                  "type": "string",
                  "pattern": "^[0-9]{2}:[0-9]{2}$"
                },
                "updateBetaAvailable": {
                  "description": "Beta Image Update Availability Flag",
                  "type": "boolean"
                },
                "beta": {
                  "description": "Home Center Beta Software Flag",
                  "type": "boolean"
                },
                "defaultLanguage": {
                  "description": "Default Home Center Language",
                  "type": "string",
                  "pattern": "^[a-z]{2}$"
                }
              }
            },
            {
              "patternProperties": {
                "^newestBetaVersion$": true,
                "^temperatureUnit$": true,
                "^updateStableAvailable$": true,
                "^zwaveVersion$": true,
                "^softVersion$": true,
                "^beta$": true,
                "^updateBetaAvailable$": true,
                "^mac$": true,
                "^serverStatus$": true,
                "^hotelMode$": true,
                "^batteryLowNotification$": true,
                "^serialNumber$": true,
                "^sunriseHour$": true,
                "^sunsetHour$": true,
                "^defaultLanguage$": true,
                "^newestStableVersion$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
