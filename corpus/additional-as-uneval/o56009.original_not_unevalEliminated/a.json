{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Fibaro Home Center Login JSON Schema",
              "name": "login",
              "type": "object",
              "properties": {
                "status": {
                  "description": "User Authorized Flag",
                  "type": "boolean"
                },
                "userID": {
                  "description": "Identifier for the user",
                  "type": "number",
                  "minimum": 0.0
                },
                "username": {
                  "description": "Name of the user",
                  "type": "string",
                  "maxLength": 20
                },
                "type": {
                  "description": "User type",
                  "enum": [
                    "user",
                    "superuser"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            {
              "patternProperties": {
                "^status$": true,
                "^userID$": true,
                "^username$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
