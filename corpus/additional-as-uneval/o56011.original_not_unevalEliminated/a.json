{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Aeon Labs Multi Level Sensor JSON Schema",
              "name": "multi_level_sensor",
              "type": "object",
              "properties": {
                "roomID": {
                  "description": "Room ID defined in Home Center GUI",
                  "type": "integer",
                  "minimum": 0.0
                },
                "name": {
                  "description": "Device name",
                  "type": "string",
                  "maxLength": 20
                },
                "modified": {
                  "type": "number"
                },
                "id": {
                  "description": "Fibaro Home Center device ID",
                  "type": "integer",
                  "minimum": 2.0
                },
                "properties": {
                  "$ref": "#/$defs/modern_2"
                },
                "sortOrder": {
                  "type": "number"
                },
                "actions": {
                  "$ref": "#/$defs/modern_3"
                },
                "remoteDeviceID": {
                  "description": "Remote Device ID",
                  "type": "integer",
                  "minimum": 0.0
                },
                "type": {
                  "description": "Zwave device type",
                  "enum": [
                    "multi_level_sensor"
                  ]
                },
                "remoteGatewayId": {
                  "description": "Remote Gateway ID",
                  "type": "integer",
                  "minimum": 0.0
                },
                "created": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^sortOrder$": true,
                "^remoteGatewayId$": true,
                "^roomID$": true,
                "^name$": true,
                "^created$": true,
                "^modified$": true,
                "^properties$": true,
                "^type$": true,
                "^actions$": true,
                "^remoteDeviceID$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "endPoint": {
                  "type": "string"
                },
                "showChildren": {
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                "dead": {
                  "type": "string"
                },
                "saveLogs": {
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                "valueSensor": {
                  "type": "string"
                },
                "associationView": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 3,
                  "items": {
                    "$ref": "#/$defs/associationItem"
                  }
                },
                "pollingTime": {
                  "type": "string"
                },
                "pushNotificationType": {
                  "type": "string"
                },
                "pollingTimeNext": {
                  "type": "string"
                },
                "sortOrder": {
                  "type": "string"
                },
                "classSupport": {
                  "type": "string"
                },
                "meterSupport": {
                  "type": "string"
                },
                "UIMessageSendTime": {
                  "type": "string"
                },
                "deviceIcon": {
                  "type": "string"
                },
                "userDescription": {
                  "type": "string"
                },
                "smsNotificationType": {
                  "type": "string"
                },
                "zwaveInfo": {
                  "type": "string"
                },
                "useTemplate": {
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                "emailNotificationType": {
                  "type": "string"
                },
                "pushNotificationID": {
                  "type": "string"
                },
                "productInfo": {
                  "type": "string"
                },
                "showEnergy": {
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                "logTemp": {
                  "type": "string"
                },
                "valueMeter": {
                  "type": "string"
                },
                "classConfigure": {
                  "type": "string"
                },
                "sensorSupport": {
                  "type": "string"
                },
                "pollingRetryError": {
                  "type": "string"
                },
                "unitMeter": {
                  "type": "string"
                },
                "needConfigure": {
                  "type": "string"
                },
                "disabled": {
                  "type": "string"
                },
                "pollingTimeSec": {
                  "type": "string"
                },
                "emailNotificationID": {
                  "type": "string"
                },
                "unit": {
                  "type": "string"
                },
                "unitSensor": {
                  "type": "string"
                },
                "requestNodeNeighborStateTimeStemp": {
                  "type": "string"
                },
                "deviceControlType": {
                  "type": "string"
                },
                "nodeID": {
                  "type": "string"
                },
                "parentID": {
                  "type": "string"
                },
                "isBatteryOperated": {
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                "smsNotificationID": {
                  "type": "string"
                },
                "associationSet": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 3,
                  "items": {
                    "$ref": "#/$defs/associationItem"
                  }
                },
                "classVersion": {
                  "type": "string"
                },
                "parameters": {
                  "type": "array",
                  "minItems": 0,
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "number"
                      },
                      "size": {
                        "type": "number"
                      },
                      "value": {
                        "type": "number"
                      },
                      "lastSetValue": {
                        "type": "number"
                      }
                    }
                  },
                  "_uniqueItems": false
                },
                "zwaveCompany": {
                  "type": "string"
                },
                "zwaveVersion": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                },
                "parametersTemplate": {
                  "type": "string"
                },
                "log": {
                  "type": "string"
                },
                "classGeneric": {
                  "type": "string"
                },
                "requestNodeNeighborState": {
                  "type": "string"
                }
              },
              "required": [
                "UIMessageSendTime",
                "classConfigure",
                "classGeneric",
                "classSupport",
                "classVersion",
                "dead",
                "deviceControlType",
                "deviceIcon",
                "disabled",
                "emailNotificationID",
                "emailNotificationType",
                "endPoint",
                "isBatteryOperated",
                "log",
                "logTemp",
                "needConfigure",
                "parametersTemplate",
                "parentID",
                "pollingRetryError",
                "pollingTime",
                "pollingTimeNext",
                "pollingTimeSec",
                "productInfo",
                "pushNotificationID",
                "pushNotificationType",
                "requestNodeNeighborState",
                "requestNodeNeighborStateTimeStemp",
                "saveLogs",
                "showChildren",
                "smsNotificationID",
                "smsNotificationType",
                "sortOrder",
                "unit",
                "useTemplate",
                "userDescription",
                "value",
                "zwaveCompany",
                "zwaveInfo",
                "zwaveVersion"
              ]
            },
            {
              "patternProperties": {
                "^emailNotificationType$": true,
                "^sortOrder$": true,
                "^unitMeter$": true,
                "^smsNotificationID$": true,
                "^isBatteryOperated$": true,
                "^requestNodeNeighborState$": true,
                "^productInfo$": true,
                "^disabled$": true,
                "^parametersTemplate$": true,
                "^classSupport$": true,
                "^classConfigure$": true,
                "^nodeID$": true,
                "^emailNotificationID$": true,
                "^smsNotificationType$": true,
                "^needConfigure$": true,
                "^parentID$": true,
                "^deviceIcon$": true,
                "^unitSensor$": true,
                "^pushNotificationID$": true,
                "^pollingTimeNext$": true,
                "^deviceControlType$": true,
                "^zwaveInfo$": true,
                "^saveLogs$": true,
                "^meterSupport$": true,
                "^pollingTimeSec$": true,
                "^zwaveCompany$": true,
                "^dead$": true,
                "^pushNotificationType$": true,
                "^UIMessageSendTime$": true,
                "^zwaveVersion$": true,
                "^showEnergy$": true,
                "^classVersion$": true,
                "^classGeneric$": true,
                "^useTemplate$": true,
                "^unit$": true,
                "^sensorSupport$": true,
                "^endPoint$": true,
                "^log$": true,
                "^showChildren$": true,
                "^value$": true,
                "^userDescription$": true,
                "^parameters$": true,
                "^valueMeter$": true,
                "^requestNodeNeighborStateTimeStemp$": true,
                "^logTemp$": true,
                "^pollingRetryError$": true,
                "^pollingTime$": true,
                "^valueSensor$": true,
                "^associationSet$": true,
                "^associationView$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "associationItem": {
      "properties": {
        "groupID": {
          "type": "number"
        },
        "devices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 254,
          "items": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 254.0
          }
        }
      }
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "pollingTimeSec": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 1.0
                },
                "requestNodeNeighborUpdate": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 0.0
                },
                "resetMeter": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 0.0
                }
              },
              "required": [
                "pollingTimeSec",
                "requestNodeNeighborUpdate"
              ]
            },
            {
              "patternProperties": {
                "^pollingTimeSec$": true,
                "^requestNodeNeighborUpdate$": true,
                "^resetMeter$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
