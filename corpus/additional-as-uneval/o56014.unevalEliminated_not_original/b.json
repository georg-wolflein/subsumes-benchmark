{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Fibaro Home Center Scene JSON Schema",
              "name": "scene",
              "type": "object",
              "properties": {
                "roomID": {
                  "description": "Identifier for room belongs to",
                  "type": "integer",
                  "minimum": 0.0
                },
                "name": {
                  "description": "Name for the scene",
                  "type": "string",
                  "maxLength": 20
                },
                "protectedByPIN": {
                  "description": "Scene protected by PIN flag",
                  "type": "boolean"
                },
                "isLua": {
                  "description": "Is scene written in LUA",
                  "type": "boolean"
                },
                "runningInstances": {
                  "description": "Number of running instances of the scene",
                  "type": "integer",
                  "minimum": 0.0
                },
                "autostart": {
                  "description": "Autostart flag",
                  "type": "boolean"
                },
                "liliStopCommand": {
                  "description": "Lili stop command",
                  "type": "string"
                },
                "html": {
                  "description": "Html code",
                  "type": "string"
                },
                "killable": {
                  "description": "Is scene killable flag",
                  "type": "boolean"
                },
                "visible": {
                  "description": "Is scene visible flag",
                  "type": "boolean"
                },
                "liliStartCommand": {
                  "description": "Lili start command",
                  "type": "string"
                },
                "enabled": {
                  "description": "Scene enabled flag",
                  "type": "boolean"
                },
                "iconID": {
                  "description": "Icon name defined",
                  "type": "integer",
                  "minimum": 0.0
                },
                "triggers": {
                  "description": "Scene triggers",
                  "type": "object",
                  "properties": {
                    "properties": {
                      "description": "List of properities triggering the scene",
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "description": "Identifier for the device",
                            "type": "integer",
                            "minimum": 0.0
                          },
                          "name": {
                            "description": "Identifier for the device's property",
                            "type": "string"
                          }
                        }
                      }
                    },
                    "globals": {
                      "description": "List of variables triggering the scene",
                      "type": "array",
                      "items": {
                        "description": "Variable name",
                        "type": "string"
                      }
                    }
                  }
                },
                "id": {
                  "description": "Identifier for the scene",
                  "type": "integer",
                  "minimum": 0.0
                },
                "lua": {
                  "description": "LUA code",
                  "type": "string"
                },
                "sortOrder": {
                  "description": "Sort order when displayed in GUI",
                  "type": "integer",
                  "minimum": 0.0
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^iconID$": true,
                "^isLua$": true,
                "^roomID$": true,
                "^protectedByPIN$": true,
                "^id$": true,
                "^liliStartCommand$": true,
                "^runningInstances$": true,
                "^enabled$": true,
                "^triggers$": true,
                "^autostart$": true,
                "^liliStopCommand$": true,
                "^sortOrder$": true,
                "^name$": true,
                "^lua$": true,
                "^html$": true,
                "^visible$": true,
                "^killable$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
