{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o56015.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Fibaro Home Center Section JSON Schema",
                "name": "section",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Name for the section",
                    "type": "string",
                    "maxLength": 20
                  },
                  "modified": {
                    "description": "Section modification timestamp",
                    "type": "integer",
                    "minimum": 0.0
                  },
                  "id": {
                    "description": "Identifier for the section",
                    "type": "integer",
                    "minimum": 0.0
                  },
                  "sortOrder": {
                    "description": "Sort order when displayed in GUI",
                    "type": "integer",
                    "minimum": 0.0
                  },
                  "created": {
                    "description": "Section creation timestamp",
                    "type": "integer",
                    "minimum": 0.0
                  }
                },
                "required": [
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^sortOrder$": true,
                  "^name$": true,
                  "^id$": true,
                  "^created$": true,
                  "^modified$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Fibaro Home Center Section JSON Schema",
    "name": "section",
    "type": "object",
    "properties": {
      "id": {
        "description": "Identifier for the section",
        "type": "integer",
        "minimum": 0
      },
      "name": {
        "description": "Name for the section",
        "type": "string",
        "maxLength": 20
      },
      "created": {
        "description": "Section creation timestamp",
        "type": "integer",
        "minimum": 0
      },
      "modified": {
        "description": "Section modification timestamp",
        "type": "integer",
        "minimum": 0
      },
      "sortOrder": {
        "description": "Sort order when displayed in GUI",
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "name"
    ],
    "additionalProperties": false
  }
}
