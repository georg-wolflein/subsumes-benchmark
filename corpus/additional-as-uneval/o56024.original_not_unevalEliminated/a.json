{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Fibaro Home Center Weather JSON Schema",
              "name": "weather",
              "type": "object",
              "properties": {
                "PreviousWeatherConditionConverted": {
                  "type": "string"
                },
                "Wind": {
                  "type": "string"
                },
                "Humidity": {
                  "type": "string"
                },
                "PreviousConditionCode": {
                  "type": "string"
                },
                "PreviousHumidity": {
                  "type": "string"
                },
                "PreviousTemperature": {
                  "type": "string"
                },
                "WeatherConditionConverted": {
                  "type": "string"
                },
                "WeatherCondition": {
                  "type": "string"
                },
                "PreviousWind": {
                  "type": "string"
                },
                "saveLogs": {
                  "enum": [
                    "0",
                    "1"
                  ]
                },
                "ConditionCode": {
                  "type": "string"
                },
                "Temperature": {
                  "type": "string"
                },
                "TemperatureUnit": {
                  "enum": [
                    "C",
                    "F"
                  ]
                }
              },
              "required": [
                "ConditionCode",
                "Humidity",
                "PreviousConditionCode",
                "PreviousHumidity",
                "PreviousTemperature",
                "PreviousWeatherConditionConverted",
                "PreviousWind",
                "Temperature",
                "WeatherCondition",
                "WeatherConditionConverted",
                "Wind",
                "saveLogs",
                "TemperatureUnit"
              ]
            },
            {
              "patternProperties": {
                "^WeatherCondition$": true,
                "^PreviousHumidity$": true,
                "^ConditionCode$": true,
                "^PreviousTemperature$": true,
                "^PreviousWeatherConditionConverted$": true,
                "^Temperature$": true,
                "^WeatherConditionConverted$": true,
                "^Wind$": true,
                "^TemperatureUnit$": true,
                "^saveLogs$": true,
                "^Humidity$": true,
                "^PreviousWind$": true,
                "^PreviousConditionCode$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
