{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "minItems",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o56232.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "JSON representation of /etc/fstab",
    "patternProperties": {
      "^/([^/]+(/[^/]+)*)?$": {
        "$ref": "#/$defs/mntent"
      }
    },
    "properties": {
      "swap": {
        "$ref": "#/$defs/mntent"
      }
    },
    "required": [
      "/",
      "swap"
    ],
    "title": "/etc/fstab",
    "type": "object",
    "$defs": {
      "mntent": {
        "description": "An fstab entry",
        "properties": {
          "device": {
            "type": "string"
          },
          "dump": {
            "minimum": 0,
            "type": "integer"
          },
          "fsck": {
            "minimum": 0,
            "type": "integer"
          },
          "fstype": {
            "type": "string"
          },
          "options": {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "device",
          "fstype"
        ],
        "title": "mntent",
        "type": "object"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "An fstab entry",
                "properties": {
                  "dump": {
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "fstype": {
                    "type": "string"
                  },
                  "device": {
                    "type": "string"
                  },
                  "options": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "fsck": {
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "required": [
                  "device",
                  "fstype"
                ],
                "title": "mntent",
                "type": "object"
              },
              {
                "items": {
                  "anyOf": [
                    false,
                    false
                  ]
                }
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "JSON representation of /etc/fstab",
                "patternProperties": {
                  "^/([^/]+(/[^/]+)*)?$": {
                    "$ref": "#/$defs/mntent"
                  }
                },
                "properties": {
                  "swap": {
                    "$ref": "#/$defs/mntent"
                  }
                },
                "required": [
                  "/",
                  "swap"
                ],
                "title": "/etc/fstab",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^/([^/]+(/[^/]+)*)?$": true,
                  "^swap$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "mntent": {
        "$ref": "#/$defs/modern_1"
      }
    }
  }
}
