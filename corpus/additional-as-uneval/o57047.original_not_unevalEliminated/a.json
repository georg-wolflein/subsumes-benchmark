{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "username",
                "password",
                "roles"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^username$": true,
                "^password$": true,
                "^roles$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
