{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "customer": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "recipients": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "sender": {
                  "type": "string"
                }
              },
              "required": [
                "customer",
                "message",
                "recipients"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^customer$": true,
                "^message$": true,
                "^recipients$": true,
                "^sender$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
