{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o57435.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Claim",
    "description": "Claim provided by a service",
    "type": "object",
    "properties": {
      "claimant": {
        "description": "Short name of the service used for subscription",
        "value": "string"
      },
      "subject": {
        "description": "subject of the predicate (claim)",
        "type": "object",
        "properties": {
          "type": {
            "description": "Type of persistent identifier (e.g. INSPIRE_RECORD_ID)",
            "type": "string"
          },
          "value": {
            "description": "Actual value of the identifier",
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      },
      "claim": {
        "description": "type of claim",
        "type": "object",
        "properties": {
          "predicate": {
            "description": "predicate of the claim",
            "type": "string",
            "enum": [
              "is_same_as",
              "is_different_than",
              "is_erratum_of",
              "is_superseded_by",
              "is_cited_by",
              "is_software_for",
              "is_dataset_for"
            ]
          },
          "datetime": {
            "description": "#TODO: which date time is this?",
            "type": "string"
          },
          "certainty": {
            "description": "certainty of the claim",
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "arguments": {
            "description": "arguments supporting the certainty",
            "type": "object",
            "properties": {
              "human": {
                "description": "the claim was done by a human or an algorithm",
                "type": "string",
                "enum": [
                  "True",
                  "False"
                ]
              },
              "actor": {
                "description": "who assessed the certainty",
                "type": "string"
              },
              "role": {
                "description": "role of the actor",
                "type": "string"
              }
            }
          }
        },
        "required": [
          "predicate",
          "certainty"
        ]
      },
      "object": {
        "description": "object of the predicate (claim)",
        "type": "object",
        "properties": {
          "type": {
            "description": "Type of persistent identifier (e.g. INSPIRE_RECORD_ID)",
            "type": "string"
          },
          "value": {
            "description": "Actual value of the identifier",
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "claimant",
      "subject",
      "claim",
      "object"
    ],
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Claim",
                "description": "Claim provided by a service",
                "type": "object",
                "properties": {
                  "claimant": {
                    "description": "Short name of the service used for subscription",
                    "value": "string"
                  },
                  "subject": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "claim": {
                    "description": "type of claim",
                    "type": "object",
                    "properties": {
                      "predicate": {
                        "description": "predicate of the claim",
                        "type": "string",
                        "enum": [
                          "is_same_as",
                          "is_different_than",
                          "is_erratum_of",
                          "is_superseded_by",
                          "is_cited_by",
                          "is_software_for",
                          "is_dataset_for"
                        ]
                      },
                      "datetime": {
                        "description": "#TODO: which date time is this?",
                        "type": "string"
                      },
                      "certainty": {
                        "description": "certainty of the claim",
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 100.0
                      },
                      "arguments": {
                        "description": "arguments supporting the certainty",
                        "type": "object",
                        "properties": {
                          "human": {
                            "description": "the claim was done by a human or an algorithm",
                            "type": "string",
                            "enum": [
                              "True",
                              "False"
                            ]
                          },
                          "actor": {
                            "description": "who assessed the certainty",
                            "type": "string"
                          },
                          "role": {
                            "description": "role of the actor",
                            "type": "string"
                          }
                        }
                      }
                    },
                    "required": [
                      "predicate",
                      "certainty"
                    ]
                  },
                  "object": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "claimant",
                  "subject",
                  "claim",
                  "object"
                ]
              },
              {
                "patternProperties": {
                  "^claimant$": true,
                  "^subject$": true,
                  "^claim$": true,
                  "^object$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "subject of the predicate (claim)",
                "type": "object",
                "properties": {
                  "type": {
                    "description": "Type of persistent identifier (e.g. INSPIRE_RECORD_ID)",
                    "type": "string"
                  },
                  "value": {
                    "description": "Actual value of the identifier",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value"
                ]
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^value$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "object of the predicate (claim)",
                "type": "object",
                "properties": {
                  "type": {
                    "description": "Type of persistent identifier (e.g. INSPIRE_RECORD_ID)",
                    "type": "string"
                  },
                  "value": {
                    "description": "Actual value of the identifier",
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value"
                ]
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^value$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
