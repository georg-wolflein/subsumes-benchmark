{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "children": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "id": {
      "_format": "uri",
      "type": "string"
    },
    "internal_id": {
      "type": "string"
    },
    "parent": {
      "type": "object"
    },
    "schema.org": {
      "_format": "uri",
      "type": "string"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "title_plural": {
      "$ref": "#/$defs/title"
    }
  },
  "required": [
    "interal_id",
    "id",
    "title",
    "title_plural",
    "schema.org"
  ],
  "type": "object",
  "$defs": {
    "title": {
      "additionalProperties": false,
      "patternProperties": {
        "^([a-z_]){2,5}$": {
          "type": "string"
        }
      },
      "title": "Mapping of language code to translation of title",
      "type": "object"
    }
  }
}
