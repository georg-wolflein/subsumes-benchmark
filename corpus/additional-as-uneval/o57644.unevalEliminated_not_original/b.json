{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "O3D3xx Logic Layer format",
  "type": "object",
  "properties": {
    "blocks": {
      "$ref": "#/$defs/modern_1"
    },
    "connectors": {
      "$ref": "#/$defs/modern_2"
    },
    "IOMap": {
      "$ref": "#/$defs/modern_3"
    }
  },
  "required": [
    "blocks"
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1,
              "patternProperties": {
                "^B[0-9]+$": {
                  "$ref": "#/$defs/block"
                }
              }
            },
            {
              "patternProperties": {
                "^B[0-9]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1,
              "patternProperties": {
                "^C[0-9]+$": {
                  "$ref": "#/$defs/connector"
                }
              }
            },
            {
              "patternProperties": {
                "^C[0-9]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "block": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "properties": {
          "type": "object"
        }
      }
    },
    "connector": {
      "type": "object",
      "properties": {
        "src": {
          "type": "string"
        },
        "srcEP": {
          "type": "number"
        },
        "dst": {
          "type": "string"
        },
        "dstEP": {
          "type": "number"
        }
      },
      "required": [
        "src",
        "srcEP",
        "dst",
        "dstEP"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^(OUT1|OUT2|OUT3|IO1|IO2)$": {
                  "type": "string",
                  "pattern": "^(NONE|ERRPIN|RFT|AQUFIN|EVAFIN|USEROUT|ANALOG|PCIC|USERIN)$"
                }
              }
            },
            {
              "patternProperties": {
                "^(OUT1|OUT2|OUT3|IO1|IO2)$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
