{
  "$id": "http://luciozambon.altervista.org/egiga2m/schemas/tree_key.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "icon": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "folder": {
                  "type": "boolean"
                },
                "tooltip": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "lazy": {
                  "type": "boolean"
                },
                "isArray": {
                  "type": "boolean"
                }
              },
              "required": [
                "title",
                "key",
                "lazy",
                "folder"
              ]
            },
            {
              "patternProperties": {
                "^lazy$": true,
                "^isArray$": true,
                "^icon$": true,
                "^tooltip$": true,
                "^folder$": true,
                "^title$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
