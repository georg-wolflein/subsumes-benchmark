{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "individuals"
  ],
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "individuals": {
      "$ref": "#/$defs/modern_1"
    },
    "customIndividualPropertySchemas": {
      "$ref": "#/$defs/modern_2"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Individuals",
              "description": "Individuals in a pedigree.",
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/individual"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "additionalProperties": {
        "$ref": "#/$defs/customIndividualPropertySchema"
      }
    },
    "individual": {
      "title": "Individual",
      "type": "object",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dizygote": {
          "title": "Dizygote twin key",
          "type": "string"
        },
        "dateOfDeath": {
          "title": "Date of death",
          "type": "string",
          "format": "date"
        },
        "dateOfBirth": {
          "title": "Date of birth",
          "type": "string",
          "format": "date"
        },
        "consultand": {
          "title": "Consultand",
          "type": "boolean"
        },
        "father": {
          "title": "Father",
          "type": "string"
        },
        "Carrier": {
          "title": "Carrier",
          "type": "boolean"
        },
        "gender": {
          "title": "Gender",
          "type": "string",
          "enum": [
            "unknown",
            "male",
            "female"
          ],
          "enumNames": [
            "Unknown or ambiguous",
            "Male",
            "Female"
          ]
        },
        "proband": {
          "title": "Proband",
          "type": "boolean"
        },
        "mother": {
          "title": "Mother",
          "type": "string"
        },
        "affected": {
          "title": "Affected",
          "type": "string"
        },
        "sampled": {
          "title": "Sampled",
          "type": "boolean"
        },
        "monozygote": {
          "title": "Monozygote twin key",
          "type": "string"
        },
        "deceased": {
          "title": "Deceased",
          "type": "boolean"
        }
      }
    },
    "customIndividualPropertySchema": {
      "title": "Custom individual property schema",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "boolean",
          "default": false
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "_uniqueItems": true
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0.0
        },
        "exclusiveMaximum": {
          "type": "boolean",
          "default": false
        },
        "format": {
          "type": "string"
        },
        "enumNames": {
          "type": "array",
          "minItems": 1,
          "_uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0.0
        },
        "title": {
          "type": "string"
        },
        "minimum": {
          "type": "number"
        },
        "type": {
          "type": "string",
          "enum": [
            "string",
            "boolean",
            "integer",
            "number"
          ]
        }
      }
    }
  }
}
