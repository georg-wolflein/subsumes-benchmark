{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "schema for an algorithm overview entry",
              "properties": {
                "description": {
                  "maxLength": 255,
                  "minLength": 5,
                  "type": "string"
                },
                "name": {
                  "maxLength": 50,
                  "minLength": 2,
                  "type": "string"
                },
                "type": {
                  "maxLength": 50,
                  "minLength": 2,
                  "type": "string"
                },
                "url": {
                  "_format": "uri",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description",
                "url"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^name$": true,
                "^type$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
