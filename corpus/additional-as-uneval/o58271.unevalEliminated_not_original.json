        "minItems": 0,
        "required": [
          "ldapName",
          "dataType",
          "required"
        ],
        "type": "array",
        "_uniqueItems": false
      }
    },
    "required": [],
    "title": "Import person configuration",
    "type": "object"
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "mappings": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "required": [],
    "title": "Import person configuration",
    "type": "object",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "items": {
                  "$ref": "#/$defs/modern_2"
                },
                "minItems": 0,
                "required": [
                  "ldapName",
                  "dataType",
                  "required"
                ],
                "type": "array",
                "_uniqueItems": false
              },
              {
                "items": {
                  "anyOf": [
                    true,
                    true
                  ]
                }
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "dataType": {
                    "enum": [
                      "string",
                      "numeric"
                    ],
                    "type": "string"
                  },
                  "displayName": {
                    "type": "string"
                  },
                  "ldapName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^dataType$": true,
                  "^displayName$": true,
                  "^ldapName$": true,
                  "^required$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
