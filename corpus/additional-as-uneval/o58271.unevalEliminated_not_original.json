    "properties": {
      "mappings": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "dataType": {
              "enum": [
                "string",
                "numeric"
              ],
              "type": "string"
            },
            "displayName": {
              "type": "string"
            },
            "ldapName": {
              "minLength": 1,
              "type": "string"
            },
            "required": {
              "type": "boolean"
            }
          },
          "type": "object"
