{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "content": {
    "MediaType": {
      "description": "Media type",
      "properties": {
        "codecs": {
          "description": "Media codec",
          "type": "string"
        },
        "type": {
          "description": "Media type MIME designatation",
          "format": "MIME",
          "type": "string"
        }
      },
      "type": "object"
    },
    "MediaTypes": {
      "description": "Array of media types",
      "items": {
        "$ref": "#/content/MediaType"
      },
      "type": "array"
    }
  },
  "description": "Application settings and user preferences",
  "properties": {
    "modifiedAt": {
      "default": null,
      "description": "File modification date",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "playlist": {
      "$ref": "#/$defs/PlayList",
      "default": {},
      "description": "Playlist options"
    },
    "plugins": {
      "$ref": "#/$defs/Plugins",
      "default": {},
      "description": "Plugin manager options"
    },
    "audio": {
      "$ref": "#/$defs/Audio",
      "default": {},
      "description": "Audio options"
    },
    "player": {
      "$ref": "#/$defs/Player",
      "default": {},
      "description": "Player options"
    },
    "inspector": {
      "$ref": "#/$defs/Inspector",
      "default": {},
      "description": "Inspector options"
    },
    "createdAt": {
      "default": null,
      "description": "File creation date",
      "format": "date-time",
      "type": [
        "string",
        "null"
      ]
    },
    "download": {
      "$ref": "#/$defs/Download",
      "default": {},
      "description": "Download manager options"
    }
  },
  "title": "Settings Schema",
  "type": "object",
  "$defs": {
    "Player": {
      "description": "Player options",
      "properties": {
        "autoPlay": {
          "default": false,
          "description": "If true will automatically start playing",
          "type": "boolean"
        },
        "preload": {
          "description": "Preload remote content",
          "properties": {
            "active": {
              "default": false,
              "description": "enables preload",
              "type": "boolean"
            },
            "concurrency": {
              "default": 1,
              "description": "Number of parallel operations",
              "maximum": 10.0,
              "minimum": 1.0,
              "type": "number"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "Preset": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "quality",
                    "format"
                  ]
                },
                {
                  "required": [
                    "bitrate",
                    "format"
                  ]
                }
              ],
              "description": "Transcode preset",
              "properties": {
                "channels": {
                  "default": 2,
                  "description": "Audio channel count",
                  "maximum": 99.0,
                  "minimum": 1.0,
                  "type": "number"
                },
                "bitrate": {
                  "default": 128,
                  "description": "Audio bitrate in kbps",
                  "maximum": 320.0,
                  "minimum": 32.0,
                  "type": "number"
                },
                "options": {
                  "description": "Custom output options",
                  "type": "string"
                },
                "codec": {
                  "description": "Audio codec name",
                  "type": "string"
                },
                "frequency": {
                  "default": 44100,
                  "description": "Audio frequency in Hz",
                  "enum": [
                    8000,
                    11025,
                    12000,
                    16000,
                    22050,
                    24000,
                    32000,
                    44100,
                    48000
                  ],
                  "maximum": 48000.0,
                  "minimum": 8000.0,
                  "type": "number"
                },
                "quality": {
                  "default": 1,
                  "description": "Audio quality factor",
                  "maximum": 32767.0,
                  "minimum": 1.0,
                  "type": "number"
                },
                "format": {
                  "description": "Audio output format",
                  "enum": [
                    "aac",
                    "mp3",
                    "mp4",
                    "wav",
                    "webm",
                    "mpeg"
                  ],
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^channels$": true,
                "^options$": true,
                "^frequency$": true,
                "^quality$": true,
                "^codec$": true,
                "^format$": true,
                "^bitrate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Path": {
      "description": "Default download save path",
      "oneOf": [
        {
          "enum": [
            "home",
            "temp",
            "desktop",
            "documents",
            "downloads",
            "music",
            "pictures",
            "videos"
          ],
          "resolve": true,
          "type": "string",
          "_uniqueItems": true
        },
        {
          "exists": {
            "root": "/",
            "type": "isDirectory"
          },
          "format": "path",
          "type": "string"
        }
      ]
    },
    "Provider": {
      "description": "Service provider",
      "properties": {
        "name": {
          "description": "Provider name",
          "type": "string"
        },
        "security": {
          "description": "Provider security",
          "type": "object"
        },
        "settings": {
          "description": "Provider settings",
          "type": "object"
        }
      },
      "type": "object"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Download manager options",
              "properties": {
                "force": {
                  "default": false,
                  "description": "Force overwrite without prompt when output file name already exists",
                  "type": "boolean"
                },
                "preview": {
                  "description": "Media preview options",
                  "properties": {
                    "bufferDuration": {
                      "default": 30,
                      "description": "Buffer duration, in seconds",
                      "minimum": 1.0
                    }
                  },
                  "type": "object"
                },
                "savePath": {
                  "$ref": "#/$defs/Path",
                  "default": "downloads",
                  "description": "The output directory to hold the downloaded files"
                },
                "rename": {
                  "default": null,
                  "description": "Custom file naming rules",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tempPath": {
                  "$ref": "#/$defs/Path",
                  "default": "temp",
                  "description": "Temporary output directory directory"
                },
                "concurrency": {
                  "default": 1,
                  "description": "Limits the number of concurrent operations.",
                  "maximum": 10.0,
                  "minimum": 1.0,
                  "type": "number"
                },
                "transcode": {
                  "default": false,
                  "description": "Media transcoding options",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Transcoder"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                "notifications": {
                  "description": "Notification options",
                  "properties": {
                    "completed": {
                      "default": true,
                      "description": "Notify when download has finished",
                      "type": "boolean"
                    },
                    "error": {
                      "default": true,
                      "description": "Notify when download has failed",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "savePath",
                "tempPath"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^preview$": true,
                "^savePath$": true,
                "^tempPath$": true,
                "^concurrency$": true,
                "^transcode$": true,
                "^force$": true,
                "^notifications$": true,
                "^rename$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Transcoder": {
      "description": "Transcoder options",
      "properties": {
        "keep": {
          "default": false,
          "description": "Keep original files",
          "type": "boolean"
        },
        "preset": {
          "default": null,
          "description": "Available transcoding presets",
          "oneOf": [
            {
              "$ref": "#/$defs/Preset"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "default": 0,
          "description": "Process priority",
          "maximum": 20.0,
          "minimum": -20.0,
          "type": "number"
        },
        "savePath": {
          "default": null,
          "description": "Directory to hold the transcoded files",
          "oneOf": [
            {
              "$ref": "#/$defs/Path"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "FileExtensions": {
      "default": [
        "mp3",
        "mp4",
        "m4a",
        "aac",
        "flac",
        "wav",
        "ogg",
        "3gpp"
      ],
      "description": "Supported audio input formats",
      "items": {
        "type": "string",
        "_uniqueItems": true
      },
      "type": "array"
    },
    "FileFormat": {
      "description": "File format filter",
      "properties": {
        "extensions": {
          "default": [
            "*"
          ],
          "description": "Valid extensions without wildcards or dots",
          "items": {
            "type": "string",
            "_uniqueItems": true
          },
          "type": "array"
        },
        "name": {
          "default": "All Files",
          "description": "Format name",
          "type": "string"
        }
      },
      "type": "object"
    },
    "PlayList": {
      "description": "PlayList options",
      "properties": {
        "recent": {
          "description": "Recently playlists",
          "items": {
            "$ref": "#/$defs/Path"
          },
          "type": "array"
        },
        "savePath": {
          "$ref": "#/$defs/Path",
          "default": "music",
          "description": "Default path for music libraries"
        },
        "scanDirs": {
          "default": [
            "music",
            "videos"
          ],
          "description": "Default folders to search for playlist files",
          "items": {
            "$ref": "#/$defs/Path"
          },
          "type": "array"
        },
        "formats": {
          "default": [
            "json"
          ],
          "description": "Supported playlist formats",
          "items": {
            "type": "string",
            "_uniqueItems": true
          },
          "type": "array"
        },
        "current": {
          "description": "Current playlist file",
          "exists": {
            "root": "/",
            "type": "isFile"
          },
          "format": "path",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Inspector": {
      "description": "Inspector options",
      "properties": {
        "matchBrackets": {
          "default": true,
          "type": "boolean"
        },
        "autofocus": {
          "default": true,
          "type": "boolean"
        },
        "mode": {
          "default": "javascript",
          "type": "string"
        },
        "lineNumbers": {
          "default": true,
          "type": "boolean"
        },
        "theme": {
          "default": "monokai",
          "type": "string"
        },
        "indentUnit": {
          "default": 2,
          "type": "number"
        },
        "styleActiveLine": {
          "default": true,
          "type": "boolean"
        },
        "keyMap": {
          "default": "sublime",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Download": {
      "$ref": "#/$defs/modern_2"
    },
    "Audio": {
      "description": "Audio options",
      "properties": {
        "formats": {
          "default": [
            "mp3",
            "mp4",
            "m4a",
            "aac",
            "flac",
            "wav",
            "ogg",
            "3gpp"
          ],
          "description": "Supported audio formats",
          "items": {
            "type": "string",
            "_uniqueItems": true
          },
          "type": "array"
        },
        "mute": {
          "default": false,
          "description": "Toggle audio output",
          "type": "boolean"
        },
        "volume": {
          "default": 0.5,
          "description": "Playback volume (0 = silent, 1 = maximum)",
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "type": "object"
    },
    "Plugins": {
      "description": "Plugin manager options",
      "properties": {
        "checkForUpdates": {
          "default": true,
          "description": "Automatically check for newer versions",
          "type": "boolean"
        },
        "force": {
          "default": false,
          "description": "Force application reload after successful update",
          "type": "boolean"
        },
        "interval": {
          "default": 18000000,
          "description": "Plugin update interval",
          "maximum": 86400000.0,
          "minimum": 3600000.0,
          "type": "number"
        },
        "pluginsDir": {
          "$ref": "#/$defs/Path",
          "default": "userData",
          "description": "Default folders to search for plugins"
        }
      },
      "required": [
        "pluginsDir"
      ],
      "type": "object"
    }
  }
}
