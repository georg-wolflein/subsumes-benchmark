{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "lastId": {
      "type": "integer"
    },
    "links": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "centerText": {
            "optional": true,
            "type": "string"
          },
          "dashed": {
            "optional": true,
            "type": "boolean"
          },
          "source": {
            "$ref": "#/$defs/node"
          },
          "sourceText": {
            "optional": true,
            "type": "string"
          },
          "strength": {
            "type": [
              "integer",
              "string"
            ]
          },
          "target": {
            "$ref": "#/$defs/node"
          },
          "targetText": {
            "optional": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "type": "array"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/node"
      },
      "type": "array"
    },
    "scale": {
      "type": "number"
    },
    "translate": {
      "items": {
        "type": "number"
      },
      "type": "array"
    }
  },
  "type": "object",
  "$defs": {
    "node": {
      "additionalProperties": false,
      "properties": {
        "dashed": {
          "optional": true,
          "type": "boolean"
        },
        "fixed": {
          "type": "integer"
        },
        "id": {
          "type": "integer"
        },
        "index": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "px": {
          "type": "number"
        },
        "py": {
          "type": "number"
        },
        "r": {
          "description": "Radius",
          "type": [
            "integer",
            "string"
          ]
        },
        "weight": {
          "type": "integer"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "type": "object"
    }
  }
}
