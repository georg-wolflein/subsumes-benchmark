{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Dev Server target options for Build Facade.",
              "properties": {
                "poll": {
                  "description": "Enable and define the file watching poll time period in milliseconds.",
                  "type": "number"
                },
                "commonChunk": {
                  "description": "Use a separate bundle containing code used across multiple bundles.",
                  "type": "boolean"
                },
                "evalSourceMap": {
                  "description": "Output in-file eval sourcemaps.",
                  "type": "boolean",
                  "x-deprecated": true
                },
                "open": {
                  "alias": "o",
                  "default": false,
                  "description": "Opens the url in default browser.",
                  "type": "boolean"
                },
                "port": {
                  "default": 4200,
                  "description": "Port to listen on.",
                  "type": "number"
                },
                "browserTarget": {
                  "description": "Target to serve.",
                  "pattern": "^[^:\\s]+:[^:\\s]+(:[^\\s]+)?$",
                  "type": "string"
                },
                "hmrWarning": {
                  "default": true,
                  "description": "Show a warning when the --hmr option is enabled.",
                  "type": "boolean"
                },
                "sslKey": {
                  "description": "SSL key to use for serving HTTPS.",
                  "type": "string"
                },
                "proxyConfig": {
                  "description": "Proxy configuration file.",
                  "type": "string"
                },
                "hmr": {
                  "default": false,
                  "description": "Enable hot module replacement.",
                  "type": "boolean"
                },
                "aot": {
                  "description": "Build using Ahead of Time compilation.",
                  "type": "boolean",
                  "x-user-analytics": 13
                },
                "servePathDefaultWarning": {
                  "default": true,
                  "description": "Show a warning when deploy-url/base-href use unsupported serve path values.",
                  "type": "boolean"
                },
                "vendorChunk": {
                  "description": "Use a separate bundle containing only vendor libraries.",
                  "type": "boolean"
                },
                "verbose": {
                  "description": "Adds more details to output logging.",
                  "type": "boolean"
                },
                "disableHostCheck": {
                  "default": false,
                  "description": "Don't verify connected clients are part of allowed hosts.",
                  "type": "boolean"
                },
                "host": {
                  "default": "localhost",
                  "description": "Host to listen on.",
                  "type": "string"
                },
                "ssl": {
                  "default": false,
                  "description": "Serve using HTTPS.",
                  "type": "boolean"
                },
                "watch": {
                  "default": true,
                  "description": "Rebuild on change.",
                  "type": "boolean"
                },
                "liveReload": {
                  "default": true,
                  "description": "Whether to reload the page on change, using live-reload.",
                  "type": "boolean"
                },
                "deployUrl": {
                  "description": "URL where files will be deployed.",
                  "type": "string"
                },
                "publicHost": {
                  "description": "The URL that the browser client (or live-reload client, if enabled) should use to connect to the development server. Use for a complex dev server setup, such as one with reverse proxies.",
                  "type": "string"
                },
                "allowedHosts": {
                  "default": [],
                  "description": "Whitelist of hosts that are allowed to access the dev server.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "baseHref": {
                  "description": "Base url for the application being built.",
                  "type": "string"
                },
                "progress": {
                  "description": "Log progress to the console while building.",
                  "type": "boolean"
                },
                "optimization": {
                  "description": "Enables optimization of the build output.",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_2"
                    },
                    {
                      "type": "boolean"
                    }
                  ],
                  "x-user-analytics": 16
                },
                "servePath": {
                  "description": "The pathname where the app will be served.",
                  "type": "string"
                },
                "vendorSourceMap": {
                  "description": "Resolve vendor packages sourcemaps.",
                  "type": "boolean",
                  "x-deprecated": true
                },
                "sslCert": {
                  "description": "SSL certificate to use for serving HTTPS.",
                  "type": "string"
                },
                "sourceMap": {
                  "description": "Output sourcemaps.",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_3"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              },
              "required": [
                "browserTarget"
              ],
              "title": "Dev Server Target",
              "type": "object"
            },
            {
              "patternProperties": {
                "^browserTarget$": true,
                "^watch$": true,
                "^host$": true,
                "^hmr$": true,
                "^baseHref$": true,
                "^sslKey$": true,
                "^servePath$": true,
                "^vendorSourceMap$": true,
                "^port$": true,
                "^progress$": true,
                "^commonChunk$": true,
                "^vendorChunk$": true,
                "^allowedHosts$": true,
                "^aot$": true,
                "^servePathDefaultWarning$": true,
                "^hmrWarning$": true,
                "^sslCert$": true,
                "^disableHostCheck$": true,
                "^liveReload$": true,
                "^verbose$": true,
                "^open$": true,
                "^deployUrl$": true,
                "^evalSourceMap$": true,
                "^publicHost$": true,
                "^ssl$": true,
                "^sourceMap$": true,
                "^proxyConfig$": true,
                "^poll$": true,
                "^optimization$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "scripts": {
                  "default": true,
                  "description": "Enables optimization of the scripts output.",
                  "type": "boolean"
                },
                "styles": {
                  "default": true,
                  "description": "Enables optimization of the styles output.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^scripts$": true,
                "^styles$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "hidden": {
                  "default": false,
                  "description": "Output sourcemaps used for error reporting tools.",
                  "type": "boolean"
                },
                "scripts": {
                  "default": true,
                  "description": "Output sourcemaps for all scripts.",
                  "type": "boolean"
                },
                "styles": {
                  "default": true,
                  "description": "Output sourcemaps for all styles.",
                  "type": "boolean"
                },
                "vendor": {
                  "default": false,
                  "description": "Resolve vendor packages sourcemaps.",
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^hidden$": true,
                "^scripts$": true,
                "^styles$": true,
                "^vendor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
