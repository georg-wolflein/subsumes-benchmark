{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_7",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Project options.",
              "properties": {
                "i18n": {
                  "$ref": "#/$defs/i18n",
                  "default": {}
                },
                "targets": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                },
                "root": {
                  "description": "Root of the project sourcefiles.",
                  "type": "string"
                },
                "prefix": {
                  "description": "The prefix to apply to generated selectors.",
                  "type": "string"
                },
                "sourceRoot": {
                  "description": "The root of the source files, assets and index.html file structure.",
                  "type": "string"
                },
                "schematics": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                },
                "cli": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                },
                "architect": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                },
                "projectType": {
                  "description": "Project type.",
                  "enum": [
                    "application",
                    "library"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "root",
                "projectType"
              ],
              "type": "object",
              "anyOf": [
                {
                  "allOf": [
                    {
                      "properties": {
                        "projectType": {
                          "const": "library"
                        }
                      }
                    },
                    {
                      "not": {
                        "required": [
                          "i18n"
                        ]
                      }
                    }
                  ]
                },
                {
                  "not": {
                    "properties": {
                      "projectType": {
                        "const": "library"
                      }
                    }
                  }
                }
              ]
            },
            {
              "patternProperties": {
                "^cli$": true,
                "^targets$": true,
                "^schematics$": true,
                "^i18n$": true,
                "^root$": true,
                "^projectType$": true,
                "^sourceRoot$": true,
                "^architect$": true,
                "^prefix$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "newProjectRoot": {
                  "default": "./",
                  "description": "New project root.",
                  "type": "string"
                },
                "targets": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                },
                "version": {
                  "description": "Workspace Schema version.",
                  "type": "number"
                },
                "schematics": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                },
                "cli": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                },
                "projects": {
                  "$ref": "#/$defs/modern_8"
                },
                "defaultProject": {
                  "description": "The default project.",
                  "type": "string"
                },
                "$schema": {
                  "description": "Link to schema.",
                  "type": "string"
                },
                "architect": {
                  "$ref": "#/$defs/tool",
                  "default": {}
                }
              },
              "required": [
                "version"
              ],
              "title": "Angular Devkit Workspace Schema for validating workspace JSON.",
              "type": "object"
            },
            {
              "patternProperties": {
                "^cli$": true,
                "^targets$": true,
                "^schematics$": true,
                "^defaultProject$": true,
                "^$schema$": true,
                "^version$": true,
                "^projects$": true,
                "^architect$": true,
                "^newProjectRoot$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "^[a-zA-Z]{2,3}(-[a-zA-Z]{4})?(-([a-zA-Z]{2}|[0-9]{3}))?(-[a-zA-Z]{5,8})?(-x(-[a-zA-Z0-9]{1,8})+)?$": {
                  "oneOf": [
                    {
                      "description": "Localization file to use for i18n",
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/modern_3"
                    }
                  ]
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^[a-zA-Z]{2,3}(-[a-zA-Z]{4})?(-([a-zA-Z]{2}|[0-9]{3}))?(-[a-zA-Z]{5,8})?(-x(-[a-zA-Z0-9]{1,8})+)?$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": {},
              "description": "A map of project names to project options.",
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/project"
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Localization options to use for the locale",
              "properties": {
                "baseHref": {
                  "description": "HTML base HREF to use for the locale (defaults to the locale code)",
                  "type": "string"
                },
                "translation": {
                  "description": "Localization file to use for i18n",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^baseHref$": true,
                "^translation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Localization options to use for the source locale",
              "properties": {
                "baseHref": {
                  "description": "HTML base HREF to use for the locale (defaults to the locale code)",
                  "type": "string"
                },
                "code": {
                  "description": "Specifies the locale code of the source locale",
                  "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z]{4})?(-([a-zA-Z]{2}|[0-9]{3}))?(-[a-zA-Z]{5,8})?(-x(-[a-zA-Z0-9]{1,8})+)?$",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^baseHref$": true,
                "^code$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "i18n": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Tool options.",
              "properties": {
                "$schema": {
                  "description": "Link to schema.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^$schema$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "locales": {
                  "$ref": "#/$defs/modern_2"
                },
                "sourceLocale": {
                  "oneOf": [
                    {
                      "default": "en-US",
                      "description": "Specifies the source locale of the application.",
                      "pattern": "^[a-zA-Z]{2,3}(-[a-zA-Z]{4})?(-([a-zA-Z]{2}|[0-9]{3}))?(-[a-zA-Z]{5,8})?(-x(-[a-zA-Z0-9]{1,8})+)?$",
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/modern_4"
                    }
                  ]
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^locales$": true,
                "^sourceLocale$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "project": {
      "$ref": "#/$defs/modern_5"
    },
    "tool": {
      "$ref": "#/$defs/modern_6"
    }
  }
}
