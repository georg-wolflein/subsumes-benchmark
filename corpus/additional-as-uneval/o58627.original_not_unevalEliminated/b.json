{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "top level oneOf object",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "sport": {
            "type": "string"
          }
        },
        "required": [
          "firstName"
        ]
      },
      {
        "properties": {
          "vehicle": {
            "type": "string"
          },
          "price": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      }
    ]
  }
}
