{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "top level oneOf object",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "properties": {
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "sport": {
            "type": "string"
          }
        },
        "required": [
          "firstName"
        ]
      },
      {
        "$ref": "#/$defs/modern_1"
      }
    ]
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "vehicle": {
                  "type": "string"
                },
                "price": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^vehicle$": true,
                "^price$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
