{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Individual packet definitions4.",
              "minProperties": 1
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/modern_6"
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "identifier": {
                  "type": "boolean",
                  "default": false
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "version": {
                  "$ref": "#/$defs/version"
                },
                "endianness": {
                  "$ref": "#/$defs/endianness"
                },
                "structure": {
                  "$ref": "#/$defs/modern_7"
                },
                "intermediate": {
                  "type": "boolean",
                  "default": false
                },
                "title": {
                  "$ref": "#/$defs/title"
                }
              },
              "required": [
                "structure"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^description$": true,
                "^identifier$": true,
                "^endianness$": true,
                "^title$": true,
                "^intermediate$": true,
                "^structure$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "StructSpec Schema",
              "description": "This is a schema that defines binary packet formats.",
              "type": "object",
              "properties": {
                "author": {
                  "type": "string",
                  "maxLength": 65
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "documentation": {
                  "type": "string",
                  "format": "uri"
                },
                "version": {
                  "$ref": "#/$defs/version"
                },
                "date": {
                  "type": "string",
                  "format": "date-time"
                },
                "enums": {
                  "$ref": "#/$defs/modern_2"
                },
                "metadata": {
                  "type": "string",
                  "format": "uri"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "packets": {
                  "$ref": "#/$defs/modern_5"
                },
                "endianness": {
                  "$ref": "#/$defs/endianness"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z_0-9]+$"
                }
              },
              "required": [
                "id",
                "title",
                "packets"
              ]
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^version$": true,
                "^documentation$": true,
                "^description$": true,
                "^packets$": true,
                "^author$": true,
                "^date$": true,
                "^id$": true,
                "^endianness$": true,
                "^enums$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Packet component definitions4.",
              "minProperties": 1
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/modern_8"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Enumerated type definitions4.",
              "minProperties": 1
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/modern_3"
              }
            }
          ]
        }
      ]
    },
    "version": {
      "type": [
        "string",
        "number"
      ]
    },
    "endianness": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "big",
            "little",
            "network",
            "native"
          ],
          "default": "native"
        },
        {
          "type": "string",
          "pattern": "^#/"
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "count": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 2.0,
                      "multipleOf": 1.0
                    },
                    {
                      "type": "string",
                      "pattern": "^#/.+/value$"
                    },
                    {
                      "type": "string",
                      "pattern": "^(.+)$"
                    }
                  ]
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1.0,
                      "multipleOf": 1.0
                    },
                    {
                      "type": "string",
                      "pattern": "^#/.+/value$"
                    },
                    {
                      "type": "string",
                      "pattern": "^(.+)$"
                    }
                  ]
                },
                "description": {
                  "$ref": "#/$defs/description"
                },
                "min": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^#/.+/value$"
                    },
                    {
                      "type": "string",
                      "pattern": "^(.+)$"
                    }
                  ]
                },
                "endianness": {
                  "$ref": "#/$defs/endianness"
                },
                "max": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string",
                      "pattern": "^#/.+/value$"
                    },
                    {
                      "type": "string",
                      "pattern": "^(.+)$"
                    }
                  ]
                },
                "member": {
                  "anyOf": [
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      },
                      "_uniqueItems": true
                    },
                    {
                      "type": "string",
                      "pattern": "^#/"
                    }
                  ]
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "type": {
                  "$ref": "#/$defs/type"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^member$": true,
                "^type$": true,
                "^endianness$": true,
                "^min$": true,
                "^title$": true,
                "^size$": true,
                "^count$": true,
                "^max$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "description": {
                  "$ref": "#/$defs/description"
                },
                "preprocessor": {
                  "type": "boolean",
                  "default": false
                },
                "options": {
                  "$ref": "#/$defs/modern_4"
                },
                "version": {
                  "$ref": "#/$defs/version"
                },
                "title": {
                  "$ref": "#/$defs/title"
                },
                "type": {
                  "$ref": "#/$defs/type"
                }
              },
              "required": [
                "options"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^preprocessor$": true,
                "^description$": true,
                "^options$": true,
                "^type$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Individual enumeration definitions4.",
              "minProperties": 1
            },
            {
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "title": {
                    "$ref": "#/$defs/title"
                  },
                  "description": {
                    "$ref": "#/$defs/description"
                  },
                  "type": {
                    "$ref": "#/$defs/type"
                  },
                  "value": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 65
    },
    "type": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "char",
            "signed char",
            "unsigned char",
            "short",
            "signed short",
            "unsigned short",
            "short int",
            "signed short int",
            "unsigned short int",
            "int",
            "signed int",
            "unsigned int",
            "long",
            "signed long",
            "unsigned long",
            "long int",
            "signed long int",
            "unsigned long int",
            "long long",
            "signed long long",
            "unsigned long long",
            "long long int",
            "signed long long int",
            "unsigned long long int",
            "float",
            "double",
            "long double",
            "bool",
            "boolean",
            "_Bool",
            "int8_t",
            "uint8_t",
            "int16_t",
            "uint16_t",
            "int24_t",
            "uint24_t",
            "int32_t",
            "uint32_t",
            "int64_t",
            "uint64_t",
            "hollerith",
            "string",
            "str",
            "pascal",
            "pointer",
            "void",
            "padding"
          ]
        },
        {
          "type": "string",
          "pattern": "^#/"
        }
      ]
    }
  }
}
