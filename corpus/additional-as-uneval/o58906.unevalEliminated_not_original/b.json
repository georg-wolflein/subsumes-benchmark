{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "account": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "account"
              ]
            },
            {
              "patternProperties": {
                "^account$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 255
                },
                "synchronize_people_with_integration_id": {
                  "type": "integer"
                },
                "contact_phone_number": {
                  "type": "string",
                  "minLength": 7,
                  "maxLength": 20
                },
                "contact_name": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 255
                },
                "contact_email": {
                  "type": "string",
                  "format": "email"
                }
              },
              "minProperties": 1
            },
            {
              "patternProperties": {
                "^name$": true,
                "^contact_email$": true,
                "^synchronize_people_with_integration_id$": true,
                "^contact_phone_number$": true,
                "^contact_name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
