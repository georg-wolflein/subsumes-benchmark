{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "authentication": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "authentication"
              ]
            },
            {
              "patternProperties": {
                "^authentication$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "minLength": 3,
                  "maxLength": 255
                },
                "password": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 255
                }
              },
              "required": [
                "email",
                "password"
              ]
            },
            {
              "patternProperties": {
                "^email$": true,
                "^password$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
