{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "integration": {
      "properties": {
        "is_active": {
          "type": "boolean"
        },
        "name": {
          "enum": [
            "hipchat",
            "hub",
            "mailgun",
            "nexmo",
            "postmark",
            "slack",
            "twilio"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "integration"
  ],
  "additionalProperties": false
}
