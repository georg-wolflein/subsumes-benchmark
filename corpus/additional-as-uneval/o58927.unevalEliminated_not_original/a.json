{
  "$id": "https://mastert.github.io/bandcamp-scraper/schemas/album-info.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The JSON schema that matches album info.",
  "properties": {
    "artist": {
      "type": "string"
    },
    "imageUrl": {
      "_format": "uri",
      "type": "string"
    },
    "raw": {
      "type": "object"
    },
    "tags": {
      "items": {
        "$ref": "#/$defs/tag"
      },
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "tracks": {
      "items": {
        "$ref": "#/$defs/track"
      },
      "type": "array"
    },
    "url": {
      "_format": "uri",
      "type": "string"
    }
  },
  "required": [
    "artist",
    "title",
    "url",
    "tracks",
    "raw"
  ],
  "title": "album-info",
  "type": "object",
  "$defs": {
    "tag": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "track": {
      "additionalProperties": false,
      "properties": {
        "duration": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "_format": "uri",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    }
  }
}
