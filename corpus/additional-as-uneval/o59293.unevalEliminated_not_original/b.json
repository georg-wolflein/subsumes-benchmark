{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "local",
                "targets"
              ],
              "properties": {
                "local": {
                  "$ref": "#/$defs/localTarget"
                },
                "targets": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^local$": true,
                "^targets$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "localTarget": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "defaultTarget": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "deleteRemoteFiles": {
          "type": "boolean",
          "default": false
        },
        "files": {
          "type": "string",
          "default": "**/**"
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "remoteTarget": {
      "type": "object",
      "required": [
        "host",
        "path",
        "user"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "prompt": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "default": true
        },
        "cache": {
          "type": "string",
          "description": "Name of checksum list file. (Default = '.synco-filelist')",
          "default": ".synco-filelist"
        },
        "port": {
          "type": "number",
          "description": "(Default = 21)",
          "default": 21
        },
        "pass": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "(reservered for future use)"
        },
        "user": {
          "type": "string"
        }
      }
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/remoteTarget"
              }
            }
          ]
        }
      ]
    }
  }
}
