{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "maxProperties": 100,
              "type": "object"
            },
            {
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "undoOf": {
                  "$ref": "#/$defs/guid"
                },
                "to": {
                  "$ref": "#/$defs/shape"
                },
                "id": {
                  "$ref": "#/$defs/guid"
                },
                "from": {
                  "$ref": "#/$defs/shape"
                },
                "type": {
                  "enum": [
                    "addition",
                    "removal",
                    "replacement",
                    "mutation"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "id",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^to$": true,
                "^undoOf$": true,
                "^type$": true,
                "^id$": true,
                "^from$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "shape": {
      "$ref": "#/$defs/modern_1"
    },
    "guid": {
      "pattern": "^[a-f][a-f0-9]{31}$",
      "type": "string"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "children": {
                  "items": {
                    "$ref": "#/$defs/shape"
                  },
                  "type": "array"
                },
                "name": {
                  "enum": [
                    "text",
                    "tspan",
                    "polygon",
                    "polyline",
                    "line",
                    "rect",
                    "ellipse",
                    "circle",
                    "path"
                  ],
                  "type": "string"
                },
                "bbox": {
                  "properties": {
                    "height": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "text": {
                  "maxLength": 1000,
                  "type": "string"
                },
                "attr": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "name",
                "attr"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^children$": true,
                "^name$": true,
                "^text$": true,
                "^attr$": true,
                "^bbox$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
