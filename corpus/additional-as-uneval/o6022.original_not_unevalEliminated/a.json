{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "x": {
                  "description": "in SVG coordinates",
                  "type": "number"
                },
                "char": {
                  "description": "keycode",
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "maxLength": 20,
                      "type": "string"
                    }
                  ]
                },
                "element": {
                  "description": "id attribute",
                  "pattern": "^[a-f][a-f0-9]{31}$",
                  "type": "string"
                },
                "time": {
                  "description": "millis per Date.getTime",
                  "type": "integer"
                },
                "active": {
                  "description": "e.g. mouse button is down",
                  "type": "boolean"
                },
                "y": {
                  "description": "in SVG coordinates",
                  "type": "number"
                },
                "tool": {
                  "enum": [
                    "Pen",
                    "Hand",
                    "Eraser"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "time",
                "tool",
                "active"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^char$": true,
                "^tool$": true,
                "^x$": true,
                "^active$": true,
                "^time$": true,
                "^element$": true,
                "^y$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
