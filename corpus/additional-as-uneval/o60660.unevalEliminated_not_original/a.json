{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "number": {
      "type": "integer",
      "minimum": 0
    },
    "stuff": {
      "type": "array",
      "_uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "url": {
      "type": "string",
      "format": "uri"
    }
  },
  "required": [
    "name"
  ]
}
