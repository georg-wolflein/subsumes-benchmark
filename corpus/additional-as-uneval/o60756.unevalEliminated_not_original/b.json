                "updated": {
                  "type": "number"
                },
                "instructions": {
                  "type": "string",
                  "default": ""
                },
                "title": {
                  "type": "string"
                },
                "created": {
                  "type": "number"
                },
                "triggers": {
                  "$ref": "#/$defs/modern_27"
                },
                "id": {
                  "type": "string"
                },
                "invitations": {
                  "$ref": "#/$defs/modern_28"
                },
                "roles": {
                  "$ref": "#/$defs/modern_29"
                }
              }
            },
            {
              "patternProperties": {
                "^instructions$": true,
                "^description$": true,
                "^stages$": true,
                "^options$": true,
                "^title$": true,
                "^updated$": true,
                "^roles$": true,
                "^statuses$": true,
                "^invitations$": true,
                "^status_id$": true,
                "^id$": true,
                "^defaults$": true,
                "^assignments$": true,
                "^created$": true,
                "^triggers$": true,
                "^permissions$": true
              },
              "additionalProperties": false
            }
