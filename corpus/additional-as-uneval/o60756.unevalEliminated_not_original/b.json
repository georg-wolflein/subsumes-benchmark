                  "properties": {
                    "open": {
                      "type": [
                        "boolean",
                        "number"
                      ],
                      "default": true
                    },
                    "close": {
                      "type": [
                        "boolean",
                        "number"
                      ],
                      "default": false
                    }
                  }
