{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "name",
                "mimetype",
                "encoding",
                "path",
                "extension",
                "size"
              ],
              "properties": {
                "mimetype": {
                  "type": "string",
                  "default": ""
                },
                "name": {
                  "type": "string",
                  "default": ""
                },
                "lock": {
                  "type": "boolean",
                  "default": false
                },
                "encoding": {
                  "type": "string",
                  "default": ""
                },
                "user_id": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "updated": {
                  "type": "number"
                },
                "path": {
                  "type": "string",
                  "default": ""
                },
                "size": {
                  "type": "number"
                },
                "created": {
                  "type": "number"
                },
                "extension": {
                  "type": "string",
                  "default": ""
                }
              }
            },
            {
              "patternProperties": {
                "^updated$": true,
                "^extension$": true,
                "^name$": true,
                "^id$": true,
                "^size$": true,
                "^created$": true,
                "^user_id$": true,
                "^lock$": true,
                "^mimetype$": true,
                "^path$": true,
                "^encoding$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
