{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60758.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60758.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "user_id",
                  "subject",
                  "content"
                ],
                "properties": {
                  "subject": {
                    "type": "string"
                  },
                  "status_id": {
                    "type": "string",
                    "enum": [
                      "unread",
                      "read",
                      "archived"
                    ],
                    "default": "unread"
                  },
                  "user_id": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "updated": {
                    "type": "number"
                  },
                  "content": {
                    "type": "string"
                  },
                  "created": {
                    "type": "number"
                  }
                }
              },
              {
                "patternProperties": {
                  "^updated$": true,
                  "^content$": true,
                  "^subject$": true,
                  "^created$": true,
                  "^user_id$": true,
                  "^status_id$": true,
                  "^id$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://www.gandhi.io/schema/notification",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "id",
      "user_id",
      "subject",
      "content"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      },
      "user_id": {
        "type": "string"
      },
      "subject": {
        "type": "string"
      },
      "content": {
        "type": "string"
      },
      "status_id": {
        "type": "string",
        "enum": [
          "unread",
          "read",
          "archived"
        ],
        "default": "unread"
      },
      "created": {
        "type": "number"
      },
      "updated": {
        "type": "number"
      }
    }
  }
}
