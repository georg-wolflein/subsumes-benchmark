{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "user_id",
                "subject",
                "content"
              ],
              "properties": {
                "subject": {
                  "type": "string"
                },
                "status_id": {
                  "type": "string",
                  "enum": [
                    "unread",
                    "read",
                    "archived"
                  ],
                  "default": "unread"
                },
                "user_id": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "updated": {
                  "type": "number"
                },
                "content": {
                  "type": "string"
                },
                "created": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^updated$": true,
                "^content$": true,
                "^subject$": true,
                "^created$": true,
                "^user_id$": true,
                "^status_id$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
