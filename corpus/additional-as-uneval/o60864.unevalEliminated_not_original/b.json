{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "avalon-core:config-1.0",
              "description": "A project configuration.",
              "type": "object",
              "required": [
                "template",
                "tasks",
                "apps"
              ],
              "properties": {
                "groups": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "icon": {
                        "type": "string"
                      },
                      "color": {
                        "type": "string"
                      },
                      "order": {
                        "type": [
                          "integer",
                          "number"
                        ]
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "apps": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "icon": {
                        "type": "string"
                      },
                      "group": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "schema": {
                  "description": "Schema identifier for payload",
                  "type": "string"
                },
                "tasks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "icon": {
                        "type": "string"
                      },
                      "group": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "families": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "icon": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      },
                      "hideFilter": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  }
                },
                "copy": {
                  "type": "object"
                },
                "template": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^apps$": true,
                "^schema$": true,
                "^template$": true,
                "^copy$": true,
                "^families$": true,
                "^groups$": true,
                "^tasks$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^.*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
