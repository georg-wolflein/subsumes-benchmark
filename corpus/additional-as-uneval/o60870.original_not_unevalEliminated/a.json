{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "avalon-core:representation-2.0",
              "description": "The inverse of an instance",
              "type": "object",
              "required": [
                "schema",
                "type",
                "parent",
                "name",
                "data"
              ],
              "properties": {
                "parent": {
                  "description": "Unique identifier to parent document",
                  "example": "592c33475f8c1b064c4d1696"
                },
                "name": {
                  "description": "Name of representation",
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_.]*$",
                  "example": "abc"
                },
                "schema": {
                  "description": "Schema identifier for payload",
                  "type": "string",
                  "enum": [
                    "avalon-core:representation-2.0"
                  ],
                  "example": "avalon-core:representation-2.0"
                },
                "type": {
                  "description": "The type of document",
                  "type": "string",
                  "enum": [
                    "representation"
                  ],
                  "example": "representation"
                },
                "dependencies": {
                  "description": "Other representation that this representation depends on",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "592d547a5f8c1b388093c145"
                  ]
                },
                "context": {
                  "description": "Summary of the context to which this representation belong.",
                  "type": "object",
                  "properties": {
                    "project": {
                      "type": "string"
                    },
                    "silo": {
                      "type": "string"
                    },
                    "version": {
                      "type": "number"
                    },
                    "subset": {
                      "type": "string"
                    },
                    "asset": {
                      "type": "string"
                    },
                    "representation": {
                      "type": "string"
                    }
                  },
                  "example": {
                    "project": "hulk",
                    "asset": "Bruce",
                    "silo": "assets",
                    "subset": "rigDefault",
                    "version": 12,
                    "representation": "ma"
                  }
                },
                "data": {
                  "description": "Document metadata",
                  "type": "object",
                  "example": {
                    "label": "Alembic"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^dependencies$": true,
                "^name$": true,
                "^parent$": true,
                "^data$": true,
                "^context$": true,
                "^type$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
