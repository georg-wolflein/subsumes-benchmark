{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60885.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60885.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "common schema for user application started and complete volumes - used for MI data based save and return completion-rate calculation",
                "properties": {
                  "count": {
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "state": {
                    "enum": [
                      "started",
                      "completed"
                    ]
                  },
                  "_id": {
                    "description": "unique url-friendly base64 encoded, utf8 endoded concatenation identifier",
                    "type": "string"
                  },
                  "_timestamp": {
                    "_format": "date-time",
                    "description": "ISO8601 combined date and time in UTC e.g. '2014-12-01T00:00:00+00:00'",
                    "type": "string"
                  },
                  "period": {
                    "description": "The period covered by each data point from the _timestamp",
                    "enum": [
                      "hour",
                      "day",
                      "week",
                      "month",
                      "quarter"
                    ]
                  }
                },
                "required": [
                  "_id",
                  "_timestamp",
                  "period",
                  "state",
                  "count"
                ],
                "title": "application-state-volumes",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^_timestamp$": true,
                  "^state$": true,
                  "^count$": true,
                  "^period$": true,
                  "^_id$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "common schema for user application started and complete volumes - used for MI data based save and return completion-rate calculation",
    "properties": {
      "_id": {
        "description": "unique url-friendly base64 encoded, utf8 endoded concatenation identifier",
        "type": "string"
      },
      "_timestamp": {
        "_format": "date-time",
        "description": "ISO8601 combined date and time in UTC e.g. '2014-12-01T00:00:00+00:00'",
        "type": "string"
      },
      "count": {
        "minimum": 0,
        "type": "integer"
      },
      "period": {
        "description": "The period covered by each data point from the _timestamp",
        "enum": [
          "hour",
          "day",
          "week",
          "month",
          "quarter"
        ]
      },
      "state": {
        "enum": [
          "started",
          "completed"
        ]
      }
    },
    "required": [
      "_id",
      "_timestamp",
      "period",
      "state",
      "count"
    ],
    "title": "application-state-volumes",
    "type": "object"
  }
}
