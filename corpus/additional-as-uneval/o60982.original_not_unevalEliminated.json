{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "format",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60982.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60982.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_3",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Details of Github inspection",
                "properties": {
                  "topics": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "license": {
                    "type": "object"
                  },
                  "forks_count": {
                    "type": "integer"
                  },
                  "open_issues_count": {
                    "type": "integer"
                  },
                  "stargazers_count": {
                    "type": "integer"
                  },
                  "subscribers_count": {
                    "type": "integer"
                  },
                  "contributors_count": {
                    "type": "integer"
                  },
                  "last_year_commits": {
                    "$ref": "#/$defs/github_last_year_commits_details"
                  }
                }
              },
              {
                "patternProperties": {
                  "^open_issues_count$": true,
                  "^subscribers_count$": true,
                  "^stargazers_count$": true,
                  "^contributors_count$": true,
                  "^license$": true,
                  "^last_year_commits$": true,
                  "^topics$": true,
                  "^forks_count$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "github_extracted_details": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Details of last year Github commits",
                "properties": {
                  "sum": {
                    "type": "integer"
                  },
                  "weekly": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                },
                "required": [
                  "sum",
                  "weekly"
                ]
              },
              {
                "patternProperties": {
                  "^sum$": true,
                  "^weekly$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "github_last_year_commits_details": {
        "$ref": "#/$defs/modern_2"
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Result of Github worker",
                "properties": {
                  "schema": {
                    "$ref": "#/$defs/modern_4"
                  },
                  "_release": {
                    "type": "string",
                    "description": "Unique release id in form of \"ecosystem:package:version\""
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "success",
                      "error",
                      "unknown"
                    ]
                  },
                  "details": {
                    "$ref": "#/$defs/github_extracted_details"
                  },
                  "summary": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "status",
                  "details",
                  "summary"
                ],
                "title": "github_details-v2-0-1"
              },
              {
                "patternProperties": {
                  "^schema$": true,
                  "^_release$": true,
                  "^details$": true,
                  "^status$": true,
                  "^summary$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Name of the schema",
                    "pattern": "^[a-zA-Z0-9_]+$"
                  },
                  "version": {
                    "type": "string",
                    "description": "Version of the schema",
                    "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
                  },
                  "url": {
                    "type": "string",
                    "description": "Full URL of the schema",
                    "format": "uri"
                  }
                },
                "required": [
                  "name",
                  "version"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^version$": true,
                  "^url$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Result of Github worker",
    "properties": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the schema",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "version": {
            "type": "string",
            "description": "Version of the schema",
            "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
          },
          "url": {
            "type": "string",
            "description": "Full URL of the schema",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "_release": {
        "type": "string",
        "description": "Unique release id in form of \"ecosystem:package:version\""
      },
      "status": {
        "type": "string",
        "enum": [
          "success",
          "error",
          "unknown"
        ]
      },
      "details": {
        "$ref": "#/$defs/github_extracted_details"
      },
      "summary": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "status",
      "details",
      "summary"
    ],
    "additionalProperties": false,
    "title": "github_details-v2-0-1",
    "$defs": {
      "github_extracted_details": {
        "type": "object",
        "description": "Details of Github inspection",
        "properties": {
          "forks_count": {
            "type": "integer"
          },
          "last_year_commits": {
            "$ref": "#/$defs/github_last_year_commits_details"
          },
          "open_issues_count": {
            "type": "integer"
          },
          "stargazers_count": {
            "type": "integer"
          },
          "subscribers_count": {
            "type": "integer"
          },
          "contributors_count": {
            "type": "integer"
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "object"
          }
        },
        "additionalProperties": false
      },
      "github_last_year_commits_details": {
        "type": "object",
        "description": "Details of last year Github commits",
        "properties": {
          "sum": {
            "type": "integer"
          },
          "weekly": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          }
        },
        "required": [
          "sum",
          "weekly"
        ],
        "additionalProperties": false
      }
    }
  }
}
