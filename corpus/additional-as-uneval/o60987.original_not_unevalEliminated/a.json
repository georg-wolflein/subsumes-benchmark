{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$"
                },
                "version": {
                  "type": "string",
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
                },
                "url": {
                  "type": "string",
                  "description": "Full URL of the schema",
                  "format": "uri"
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "npm_shrinkwrap": {
      "$ref": "#/$defs/modern_2"
    },
    "metadata_code_repository": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Code repository description",
              "properties": {
                "type": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "url"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "npm-shrinkwrap description",
              "properties": {
                "name": {
                  "type": "string"
                },
                "npm_shrinkwrap_version": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "resolved_dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "node_version": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^npm_shrinkwrap_version$": true,
                "^resolved_dependencies$": true,
                "^name$": true,
                "^node_version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Result of Mercator worker",
              "properties": {
                "author": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "name": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "npm_shrinkwrap": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/npm_shrinkwrap"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "maintainers": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "code_repository": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/metadata_code_repository"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "files": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "version": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "engines": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_4"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "schema": {
                  "$ref": "#/$defs/modern_5"
                },
                "_release": {
                  "type": "string",
                  "description": "Unique release id in form of \"ecosystem:package:version\""
                },
                "devel_dependencies": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "readme": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "bug_reporting": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dependencies": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "description": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "git_head": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "homepage": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "declared_license": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "keywords": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "metadata": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_6"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "scripts": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_7"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "platform": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "contributors": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "title": "metadata-v1-1-0"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^schema$": true,
                "^author$": true,
                "^code_repository$": true,
                "^platform$": true,
                "^name$": true,
                "^readme$": true,
                "^scripts$": true,
                "^maintainers$": true,
                "^version$": true,
                "^_release$": true,
                "^keywords$": true,
                "^dependencies$": true,
                "^files$": true,
                "^description$": true,
                "^contributors$": true,
                "^homepage$": true,
                "^bug_reporting$": true,
                "^devel_dependencies$": true,
                "^git_head$": true,
                "^declared_license$": true,
                "^npm_shrinkwrap$": true,
                "^engines$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
