{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/failed_license_scan"
    },
    {
      "$ref": "#/$defs/successful_license_scan"
    },
    {
      "$ref": "#/$defs/modern_14"
    }
  ],
  "title": "source_licenses-v2-0-0",
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$",
                  "type": "string"
                },
                "url": {
                  "_format": "uri",
                  "description": "Full URL of the schema",
                  "type": "string"
                },
                "version": {
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^url$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$",
                  "type": "string"
                },
                "url": {
                  "_format": "uri",
                  "description": "Full URL of the schema",
                  "type": "string"
                },
                "version": {
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^url$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "oslc_stats": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "files": {
                  "items": {
                    "$ref": "#/$defs/file_details"
                  },
                  "type": "array"
                },
                "license_stats": {
                  "items": {
                    "$ref": "#/$defs/license_details_pre_3_0"
                  },
                  "type": "array"
                },
                "oslc_stats": {
                  "$ref": "#/$defs/oslc_stats"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^files$": true,
                "^license_stats$": true,
                "^oslc_stats$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "file_details": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Detected license with occurrence count",
              "properties": {
                "count": {
                  "description": "Combined count of detected variants",
                  "type": "number"
                },
                "license_name": {
                  "description": "Common name of the detected license",
                  "type": "string"
                }
              },
              "required": [
                "count",
                "license_name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^count$": true,
                "^license_name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "license_count": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "all_files": {
                  "description": "Total number of files analysed",
                  "type": "number"
                },
                "source_files": {
                  "type": "number"
                },
                "licensed_files": {
                  "type": "number"
                },
                "sure_licenses": {
                  "description": "Licenses detected with high match confidence",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "license_files": {
                  "type": "number"
                },
                "distinct_licenses": {
                  "items": {
                    "$ref": "#/$defs/license_count"
                  },
                  "type": "array"
                }
              },
              "required": [
                "distinct_licenses",
                "sure_licenses"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^all_files$": true,
                "^licensed_files$": true,
                "^distinct_licenses$": true,
                "^source_files$": true,
                "^license_files$": true,
                "^sure_licenses$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Failed automated software copyright license scan",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_10"
                },
                "_release": {
                  "description": "Unique release id in form of \"ecosystem:package:version\"",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "error"
                  ],
                  "type": "string"
                },
                "details": {
                  "$ref": "#/$defs/modern_11"
                },
                "summary": {
                  "$ref": "#/$defs/modern_12"
                }
              },
              "required": [
                "status",
                "summary",
                "details"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true,
                "^details$": true,
                "^status$": true,
                "^summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "count": {
                  "description": "Number of occurrences of this variant",
                  "type": "number"
                },
                "license_name": {
                  "description": "Common name of the detected license",
                  "type": "string"
                },
                "variant_id": {
                  "description": "Specific license variant detected",
                  "type": "string"
                }
              },
              "required": [
                "count",
                "license_name",
                "variant_id"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^count$": true,
                "^license_name$": true,
                "^variant_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "path": {
                  "type": "string"
                },
                "result": {
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  },
                  "type": "array"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^path$": true,
                "^result$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "license_scan_summary": {
      "$ref": "#/$defs/modern_8"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Successful automated software copyright license scan",
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Successful automated software copyright license scan",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_6"
                },
                "_release": {
                  "description": "Unique release id in form of \"ecosystem:package:version\"",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "success"
                  ],
                  "type": "string"
                },
                "details": {
                  "$ref": "#/$defs/license_scan_details"
                },
                "summary": {
                  "$ref": "#/$defs/license_scan_summary"
                }
              },
              "required": [
                "status",
                "summary",
                "details"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true,
                "^details$": true,
                "^status$": true,
                "^summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "license_scan_details": {
      "$ref": "#/$defs/modern_1"
    },
    "failed_license_scan": {
      "$ref": "#/$defs/modern_9"
    },
    "license_details_pre_3_0": {
      "$ref": "#/$defs/modern_13"
    },
    "successful_license_scan": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
