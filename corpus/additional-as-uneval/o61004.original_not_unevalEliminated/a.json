{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/failed_license_scan"
    },
    {
      "$ref": "#/$defs/successful_license_scan"
    },
    {
      "$ref": "#/$defs/modern_9"
    }
  ],
  "title": "source_licenses-v3-0-0",
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "sure_licenses": {
                  "description": "Licenses detected with high match confidence",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "sure_licenses"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^sure_licenses$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "failed_license_scan": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Failed automated software copyright license scan",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_2"
                },
                "_release": {
                  "description": "Unique release id in form of \"ecosystem:package:version\"",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "error"
                  ],
                  "type": "string"
                },
                "details": {
                  "$ref": "#/$defs/modern_3"
                },
                "summary": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "required": [
                "status",
                "summary",
                "details"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true,
                "^details$": true,
                "^status$": true,
                "^summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Successful automated software copyright license scan",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_8"
                },
                "_release": {
                  "description": "Unique release id in form of \"ecosystem:package:version\"",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "success"
                  ],
                  "type": "string"
                },
                "details": {
                  "$ref": "#/$defs/license_scan_details"
                },
                "summary": {
                  "$ref": "#/$defs/license_scan_summary"
                }
              },
              "required": [
                "status",
                "summary",
                "details"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^_release$": true,
                "^details$": true,
                "^status$": true,
                "^summary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$",
                  "type": "string"
                },
                "url": {
                  "_format": "uri",
                  "description": "Full URL of the schema",
                  "type": "string"
                },
                "version": {
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^url$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Successful automated software copyright license scan",
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "license_scan_summary": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "files_count": {
                  "type": "integer"
                },
                "licenses": {
                  "type": "object"
                },
                "scancode_notice": {
                  "type": "string"
                },
                "scancode_version": {
                  "type": "string"
                }
              },
              "required": [
                "files_count",
                "licenses",
                "scancode_notice",
                "scancode_version"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^files_count$": true,
                "^licenses$": true,
                "^scancode_notice$": true,
                "^scancode_version$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "license_scan_details": {
      "$ref": "#/$defs/modern_5"
    },
    "successful_license_scan": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "description": "Name of the schema",
                  "pattern": "^[a-zA-Z0-9_]+$",
                  "type": "string"
                },
                "url": {
                  "_format": "uri",
                  "description": "Full URL of the schema",
                  "type": "string"
                },
                "version": {
                  "description": "Version of the schema",
                  "pattern": "^[0-9]+-[0-9]+-[0-9]+$",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^url$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
