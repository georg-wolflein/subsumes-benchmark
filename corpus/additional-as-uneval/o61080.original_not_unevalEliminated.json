{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o61080.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o61080.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "carrier": {
                    "type": "string",
                    "enum": [
                      "dhl",
                      "ups",
                      "dpd",
                      "hermes",
                      "gls"
                    ],
                    "description": "acronym of the carrier you want to use"
                  },
                  "pickup_date": {
                    "type": "string",
                    "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$"
                  }
                },
                "required": [
                  "carrier",
                  "pickup_date"
                ]
              },
              {
                "patternProperties": {
                  "^carrier$": true,
                  "^pickup_date$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "carrier": {
        "type": "string",
        "enum": [
          "dhl",
          "ups",
          "dpd",
          "hermes",
          "gls"
        ],
        "description": "acronym of the carrier you want to use"
      },
      "pickup_date": {
        "type": "string",
        "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$"
      }
    },
    "required": [
      "carrier",
      "pickup_date"
    ],
    "additionalProperties": false
  }
}
