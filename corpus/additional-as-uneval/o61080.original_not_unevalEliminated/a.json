{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "carrier": {
                  "type": "string",
                  "enum": [
                    "dhl",
                    "ups",
                    "dpd",
                    "hermes",
                    "gls"
                  ],
                  "description": "acronym of the carrier you want to use"
                },
                "pickup_date": {
                  "type": "string",
                  "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$"
                }
              },
              "required": [
                "carrier",
                "pickup_date"
              ]
            },
            {
              "patternProperties": {
                "^carrier$": true,
                "^pickup_date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
