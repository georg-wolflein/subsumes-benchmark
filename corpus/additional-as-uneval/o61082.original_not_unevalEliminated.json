{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o61082.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "weight": {
                    "type": "number"
                  },
                  "carrier": {
                    "type": "string",
                    "enum": [
                      "dhl",
                      "ups",
                      "dpd",
                      "hermes",
                      "gls"
                    ],
                    "description": "acronym of the carrier you want to use"
                  },
                  "height": {
                    "type": "number"
                  },
                  "length": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number"
                  }
                },
                "required": [
                  "carrier",
                  "width",
                  "height",
                  "length",
                  "weight"
                ]
              },
              {
                "patternProperties": {
                  "^carrier$": true,
                  "^width$": true,
                  "^length$": true,
                  "^weight$": true,
                  "^height$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "carrier": {
        "type": "string",
        "enum": [
          "dhl",
          "ups",
          "dpd",
          "hermes",
          "gls"
        ],
        "description": "acronym of the carrier you want to use"
      },
      "width": {
        "type": "number"
      },
      "height": {
        "type": "number"
      },
      "length": {
        "type": "number"
      },
      "weight": {
        "type": "number"
      }
    },
    "required": [
      "carrier",
      "width",
      "height",
      "length",
      "weight"
    ],
    "additionalProperties": false
  }
}
