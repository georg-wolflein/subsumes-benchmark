{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "weight": {
                  "type": "number"
                },
                "carrier": {
                  "type": "string",
                  "enum": [
                    "dhl",
                    "ups",
                    "dpd",
                    "hermes",
                    "gls"
                  ],
                  "description": "acronym of the carrier you want to use"
                },
                "height": {
                  "type": "number"
                },
                "length": {
                  "type": "number"
                },
                "width": {
                  "type": "number"
                }
              },
              "required": [
                "carrier",
                "width",
                "height",
                "length",
                "weight"
              ]
            },
            {
              "patternProperties": {
                "^carrier$": true,
                "^width$": true,
                "^length$": true,
                "^weight$": true,
                "^height$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
