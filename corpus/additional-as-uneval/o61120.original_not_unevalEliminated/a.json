{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "dependencies": {
                  "type": "object",
                  "description": "List of locked dependencies.",
                  "items": {
                    "type": "string",
                    "description": "Each item contains the package name and version."
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^dependencies$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
