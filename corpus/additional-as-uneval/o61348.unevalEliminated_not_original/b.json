                    "$ref": "#/$defs/param"
                  },
                  "minItems": 0,
                  "type": "array",
                  "_uniqueItems": false
                },
                "returnWithFactory": {
                  "description": "True if the decode method should return with factory instead of the constructor",
                  "type": "boolean"
                },
                "since": {
                  "$ref": "#/$defs/since"
                }
              },
              "required": [
                "name",
                "since",
                "params"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^params$": true,
                "^returnWithFactory$": true,
                "^since$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "since": {
      "default": 2.0,
      "enum": [
        2.0
      ]
    },
