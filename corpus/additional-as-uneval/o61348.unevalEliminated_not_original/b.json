{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "customTypes": {
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "type": "array"
                }
              },
              "required": [
                "customTypes"
              ],
              "title": "Hazelcast Client Protocol Custom Codec Definitions",
              "type": "object"
            },
            {
              "patternProperties": {
                "^customTypes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "description": "Name of the custom type",
                  "type": "string"
                },
                "params": {
