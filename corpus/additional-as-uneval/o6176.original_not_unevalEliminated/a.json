{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "orgId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "description": {
                  "type": "string",
                  "maxLength": 32767
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^orgId$": true,
                "^name$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
