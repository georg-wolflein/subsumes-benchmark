{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "object",
                "required": [
                  "launch_path",
                  "name",
                  "description",
                  "types"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "launch_path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locales": {
                    "$ref": "#/$defs/modern_6"
                  },
                  "types": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "oneOf": [
                        {
                          "enum": [
                            "text"
                          ]
                        },
                        {
                          "enum": [
                            "url"
                          ]
                        },
                        {
                          "enum": [
                            "email"
                          ]
                        },
                        {
                          "enum": [
                            "password"
                          ]
                        },
                        {
                          "enum": [
                            "number"
                          ]
                        },
                        {
                          "enum": [
                            "option"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/modern_7"
              }
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Marketplace",
              "description": "Firefox Marketplace manifest.webapp file - shared",
              "type": "object",
              "required": [
                "description",
                "name"
              ],
              "dependentRequired": {
                "default_locale": [
                  "locales"
                ]
              },
              "properties": {
                "messages": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "required_features": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "name": {
                  "description": "App name",
                  "type": "string",
                  "maxLength": 128,
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "oneOf": [
                    {
                      "enum": [
                        "system"
                      ]
                    },
                    {
                      "enum": [
                        "input"
                      ]
                    },
                    {
                      "enum": [
                        "homescreen"
                      ]
                    }
                  ]
                },
                "installs_allowed_from": {
                  "type": "array"
                },
                "activities": {
                  "$ref": "#/$defs/modern_2"
                },
                "developer": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "fullscreen": {
                  "type": "string",
                  "oneOf": [
                    {
                      "enum": [
                        "true"
                      ]
                    },
                    {
                      "enum": [
                        "false"
                      ]
                    }
                  ]
                },
                "icons": {
                  "type": "object"
                },
                "chrome": {
                  "$ref": "#/$defs/modern_4"
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "inputs": {
                  "$ref": "#/$defs/modern_5"
                },
                "origin": {
                  "type": "string",
                  "pattern": "\\w+$"
                },
                "orientation": {
                  "type": "string",
                  "anyOf": [
                    {
                      "enum": [
                        "portrait"
                      ]
                    },
                    {
                      "enum": [
                        "landscape"
                      ]
                    },
                    {
                      "enum": [
                        "portrait-secondary"
                      ]
                    },
                    {
                      "enum": [
                        "landscape-secondary"
                      ]
                    },
                    {
                      "enum": [
                        "portrait-primary"
                      ]
                    },
                    {
                      "enum": [
                        "landscape-primary"
                      ]
                    }
                  ]
                },
                "locales": {
                  "type": "object"
                },
                "type": {
                  "type": "string",
                  "oneOf": [
                    {
                      "enum": [
                        "web"
                      ]
                    },
                    {
                      "enum": [
                        "privileged"
                      ]
                    },
                    {
                      "enum": [
                        "certified"
                      ]
                    }
                  ]
                },
                "redirects": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                },
                "csp": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "description": "Description of app",
                  "type": "string",
                  "maxLength": 1024,
                  "minLength": 1
                },
                "precompile": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "permissions": {
                  "type": "object"
                },
                "default_locale": {
                  "type": "string",
                  "minLength": 1
                },
                "launch_path": {
                  "type": "string",
                  "pattern": "^(/[^/]+)*/?$",
                  "minLength": 1
                },
                "appcache_path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "patternProperties": {
                "^locales$": true,
                "^origin$": true,
                "^version$": true,
                "^developer$": true,
                "^default_locale$": true,
                "^activities$": true,
                "^role$": true,
                "^inputs$": true,
                "^icons$": true,
                "^launch_path$": true,
                "^type$": true,
                "^appcache_path$": true,
                "^permissions$": true,
                "^required_features$": true,
                "^redirects$": true,
                "^description$": true,
                "^csp$": true,
                "^chrome$": true,
                "^name$": true,
                "^messages$": true,
                "^orientation$": true,
                "^installs_allowed_from$": true,
                "^fullscreen$": true,
                "^precompile$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/modern_3"
              }
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^from$": true,
                "^to$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "href"
              ],
              "properties": {
                "href": {
                  "type": "string"
                },
                "returnValue": {
                  "type": "boolean"
                },
                "disposition": {
                  "type": "string",
                  "oneOf": [
                    {
                      "enum": [
                        "window"
                      ]
                    },
                    {
                      "enume": [
                        "inline"
                      ]
                    }
                  ]
                },
                "filters": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            },
            {
              "patternProperties": {
                "^href$": true,
                "^returnValue$": true,
                "^disposition$": true,
                "^filters$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "navigation": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^navigation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
