{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FxA Push Payload schema",
  "description": "This schema defines what is acceptable to send as a payload data with the Push API from the FxA servers to a device connected to FxA",
  "type": "object",
  "anyOf": [
    {
      "$ref": "#/$defs/deviceConnected"
    },
    {
      "$ref": "#/$defs/deviceDisconnected"
    },
    {
      "$ref": "#/$defs/profileUpdated"
    },
    {
      "$ref": "#/$defs/collectionsChanged"
    },
    {
      "$ref": "#/$defs/passwordChanged"
    },
    {
      "$ref": "#/$defs/passwordReset"
    },
    {
      "$ref": "#/$defs/accountDestroyed"
    },
    {
      "$ref": "#/$defs/commandReceived"
    }
  ],
  "$defs": {
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command",
                "data"
              ],
              "properties": {
                "version": {
                  "type": "integer"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "sync:collection_changed"
                  ]
                },
                "data": {
                  "$ref": "#/$defs/modern_11"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command",
                "data"
              ],
              "properties": {
                "version": {
                  "type": "integer"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "fxaccounts:device_disconnected"
                  ]
                },
                "data": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "passwordChanged": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command",
                "data"
              ],
              "properties": {
                "version": {
                  "type": "integer"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "fxaccounts:command_received"
                  ]
                },
                "data": {
                  "$ref": "#/$defs/modern_8"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "The id of the device who was disconnected remotely"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "profileUpdated": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command",
                "data"
              ],
              "properties": {
                "version": {
                  "type": "integer"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "fxaccounts:account_destroyed"
                  ]
                },
                "data": {
                  "$ref": "#/$defs/modern_13"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "command",
                "index",
                "url"
              ],
              "properties": {
                "command": {
                  "type": "string",
                  "description": "URI identifying the command that was invoked"
                },
                "index": {
                  "type": "integer",
                  "description": "index of this command in the device's command queue"
                },
                "sender": {
                  "type": "string",
                  "description": "The device ID from which the command was sent, if known"
                },
                "url": {
                  "type": "string",
                  "description": "URL at which to fetch the full command payload"
                }
              }
            },
            {
              "patternProperties": {
                "^command$": true,
                "^index$": true,
                "^sender$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command"
              ],
              "properties": {
                "version": {
                  "type": "integer"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "fxaccounts:password_reset"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "accountDestroyed": {
      "$ref": "#/$defs/modern_12"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "deviceName"
              ],
              "properties": {
                "deviceName": {
                  "type": "string",
                  "description": "The name of the device who joined this account"
                }
              }
            },
            {
              "patternProperties": {
                "^deviceName$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command"
              ],
              "properties": {
                "version": {
                  "type": "integer"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "fxaccounts:password_changed"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "deviceDisconnected": {
      "$ref": "#/$defs/modern_1"
    },
    "deviceConnected": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command"
              ],
              "properties": {
                "version": {
                  "type": "integer"
                },
                "command": {
                  "type": "string",
                  "enum": [
                    "fxaccounts:profile_updated"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "commandReceived": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "uid"
              ],
              "properties": {
                "uid": {
                  "type": "string",
                  "description": "The UID of the account which was destroyed"
                }
              }
            },
            {
              "patternProperties": {
                "^uid$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "version",
                "command",
                "data"
              ],
              "properties": {
                "version": {
                  "type": "integer",
                  "description": "The version of this push payload data instance. Bump this if you make changes to any part of this schema."
                },
                "command": {
                  "type": "string",
                  "description": "Helps the receiving device discriminate payloads",
                  "enum": [
                    "fxaccounts:device_connected"
                  ]
                },
                "data": {
                  "$ref": "#/$defs/modern_4"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^command$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "passwordReset": {
      "$ref": "#/$defs/modern_9"
    },
    "collectionsChanged": {
      "$ref": "#/$defs/modern_10"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "collections"
              ],
              "properties": {
                "collections": {
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "description": "A list of collections that were changed",
                  "items": {
                    "enum": [
                      "addons",
                      "bookmarks",
                      "history",
                      "forms",
                      "prefs",
                      "tabs",
                      "passwords",
                      "clients"
                    ]
                  }
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "sendtab",
                    "firstsync"
                  ],
                  "description": "Event that lead to this push notification"
                }
              }
            },
            {
              "patternProperties": {
                "^collections$": true,
                "^reason$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
