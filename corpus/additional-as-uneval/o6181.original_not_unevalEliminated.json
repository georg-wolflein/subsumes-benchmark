                        },
                        "applicationId": {
                          "type": "string",
                          "pattern": "^[A-Fa-f\\d]{24}$"
                        },
                        "height": {
                          "type": "integer"
                        },
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string",
                          "maxLength": 255
                        },
                        "startX": {
                          "type": "integer"
                        },
                        "width": {
                          "type": "integer"
                        },
                        "blockType": {
                          "type": "string"
                        },
                        "config": {
                          "type": "object"
                        }
                      },
                      "required": [
                        "id",
                        "blockType",
                        "startX",
                        "startY",
                        "width",
                        "height"
                      ]
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^blocks$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
