{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "orgId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "blocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "startY": {
                        "type": "integer"
                      },
                      "applicationId": {
                        "type": "string",
                        "pattern": "^[A-Fa-f\\d]{24}$"
                      },
                      "height": {
                        "type": "integer"
                      },
                      "id": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string",
                        "maxLength": 255
                      },
                      "startX": {
                        "type": "integer"
                      },
                      "width": {
                        "type": "integer"
                      },
                      "blockType": {
                        "type": "string"
                      },
                      "config": {
                        "type": "object"
                      }
                    },
                    "required": [
                      "id",
                      "blockType",
                      "startX",
                      "startY",
                      "width",
                      "height"
                    ]
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^orgId$": true,
                "^name$": true,
                "^blocks$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
