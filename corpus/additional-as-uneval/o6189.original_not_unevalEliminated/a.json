{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "connectionInfo": {
      "$ref": "#/$defs/connectionInfo"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "masterId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "deviceClass": {
      "$ref": "#/$defs/deviceClass"
    },
    "attributes": {
      "$ref": "#/$defs/attributes"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "creationDate": {
      "type": "string",
      "format": "date-time"
    },
    "deviceId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "description": {
      "type": "string",
      "maxLength": 32767
    },
    "tags": {
      "$ref": "#/$defs/tags"
    }
  },
  "$defs": {
    "connectionInfo": {
      "type": "object",
      "properties": {
        "time": {
          "type": "string",
          "format": "date-time"
        },
        "connected": {
          "type": "number"
        }
      }
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              },
              "required": [
                "key",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "attributes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_2"
      }
    },
    "deviceClass": {
      "type": "string",
      "enum": [
        "standalone",
        "master",
        "owned",
        "floating",
        "virtual"
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "dataType": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "gps",
                    "boolean"
                  ]
                }
              },
              "required": [
                "name",
                "dataType"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^dataType$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
