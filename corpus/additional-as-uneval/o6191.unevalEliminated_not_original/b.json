{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string",
                  "format": "date-time"
                },
                "name": {
                  "type": "string"
                },
                "payload": {
                  "type": "object"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^time$": true,
                "^name$": true,
                "^payload$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
