{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "openSource": {
                  "type": "boolean"
                },
                "datacentresEUCode": {
                  "type": "boolean"
                },
                "serviceName": {
                  "type": "string"
                },
                "trialOption": {
                  "type": "boolean"
                },
                "priceUnit": {
                  "type": "string"
                },
                "openStandardsSupported": {
                  "type": "boolean"
                },
                "pricingDocumentURL": {
                  "type": "string",
                  "_format": "uri"
                },
                "title": {
                  "type": "string"
                },
                "dataBackupRecovery": {
                  "type": "boolean"
                },
                "serviceSummary": {
                  "type": "string"
                },
                "minimumContractPeriod": {
                  "enum": [
                    "hour",
                    "day",
                    "month",
                    "year",
                    "other"
                  ]
                },
                "serviceOnboarding": {
                  "type": "boolean"
                },
                "serviceDefinitionDocumentURL": {
                  "type": "string",
                  "_format": "uri"
                },
                "priceString": {
                  "type": "string"
                },
                "serviceTypes": {
                  "oneOf": [
                    {
                      "type": "array",
                      "_uniqueItems": true,
                      "maxItems": 25,
                      "items": {
                        "enum": [
                          "Accessibility",
                          "Agile Tools",
                          "Analytics",
                          "Antispam / CAPTCHA",
                          "Asset Management",
                          "Content Management Systems (CMS)",
                          "Customer Relationship Management (CRM)",
                          "Data Visualisation",
                          "EDRM / Collaboration",
                          "Email",
                          "End User Device (EUD)",
                          "Enterprise Resource Planning",
                          "Forms",
                          "Gamification",
                          "Geographic Search",
                          "Identity",
                          "Learning Management Systems (LMS)",
                          "Office Productivity",
                          "Polls/Surveys",
                          "Search",
                          "Service Monitoring",
                          "Simulation & Training",
                          "Un-listed",
                          "User Alerts"
                        ]
                      }
                    },
                    {
                      "type": "array",
                      "_uniqueItems": true,
                      "maxItems": 25,
                      "items": {
                        "enum": [
                          "Accounting and finance",
                          "Business intelligence and analytics",
                          "Collaboration",
                          "Customer relationship management (CRM)",
                          "Creative and design",
                          "Data management",
                          "Electronic document and records management (EDRM)",
                          "Energy and environment",
                          "Healthcare",
                          "Human resources and employee management",
                          "IT management",
                          "Legal",
                          "Libraries",
                          "Marketing",
                          "Operations management",
                          "Project management and planning",
                          "Sales",
                          "Schools and education",
                          "Security",
                          "Software development tools",
                          "Telecoms",
                          "Transport and logistics"
                        ]
                      }
                    },
                    {
                      "type": "array",
                      "_uniqueItems": true,
                      "maxItems": 25,
                      "items": {
                        "enum": [
                          "Application Deployment",
                          "Components"
                        ]
                      }
                    },
                    {
                      "type": "array",
                      "_uniqueItems": true,
                      "maxItems": 25,
                      "items": {
                        "enum": [
                          "Compute",
                          "Content Delivery Network (CDN)",
                          "Storage",
                          "Other"
                        ]
                      }
                    },
                    {
                      "type": "array",
                      "_uniqueItems": true,
                      "maxItems": 25,
                      "items": {
                        "enum": [
                          "Business Analysis",
                          "Deployment",
                          "Design and Development",
                          "Design Authority",
                          "Enterprise Architecture",
                          "Helpdesk",
                          "Onboarding services",
                          "Project Management, Programme Management and Governance",
                          "Project Specification and Selection",
                          "Service Integration and Management Services (SIAM)",
                          "Service Management",
                          "Software Support",
                          "Specialist Cloud Services",
                          "Transition Management",
                          "User Management"
                        ]
                      }
                    },
                    {
                      "type": "array",
                      "_uniqueItems": true,
                      "maxItems": 25,
                      "items": {
                        "enum": [
                          "Implementation",
                          "Ongoing Support",
                          "Planning",
                          "Testing",
                          "Training"
                        ]
                      }
                    }
                  ]
                },
                "termsAndConditionsDocumentURL": {
                  "type": "string",
                  "_format": "uri"
                },
                "persistentStorage": {
                  "type": "boolean"
                },
                "guaranteedResources": {
                  "type": "boolean"
                },
                "apiAccess": {
                  "type": "boolean"
                },
                "dataExtractionRemoval": {
                  "type": "boolean"
                },
                "datacentreTier": {
                  "type": "string"
                },
                "additionalDocumentURLs": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "type": "string",
                    "_format": "uri"
                  }
                },
                "sfiaRateDocumentURL": {
                  "type": "string",
                  "_format": "uri"
                },
                "supportForThirdParties": {
                  "type": "boolean"
                },
                "educationPricing": {
                  "type": "boolean"
                },
                "id": {
                  "type": "string",
                  "pattern": "^4\\-.*"
                },
                "networksConnected": {
                  "type": "array",
                  "_uniqueItems": true,
                  "maxItems": 7,
                  "items": {
                    "enum": [
                      "Internet",
                      "Public Services Network (PSN)",
                      "Government Secure intranet (GSi)",
                      "Police National Network (PNN)",
                      "New NHS Network (N3)",
                      "Joint Academic Network (JANET)",
                      "Other"
                    ]
                  }
                },
                "selfServiceProvisioning": {
                  "type": "boolean"
                },
                "serviceOffboarding": {
                  "type": "boolean"
                },
                "serviceBenefits": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "string"
                  }
                },
                "elasticCloud": {
                  "type": "boolean"
                },
                "status": {
                  "enum": [
                    "disabled",
                    "enabled",
                    "published"
                  ]
                },
                "serviceFeatures": {
                  "type": "array",
                  "maxItems": 10,
                  "items": {
                    "type": "string"
                  }
                },
                "priceMin": {
                  "type": "number"
                },
                "lot": {
                  "enum": [
                    "SaaS",
                    "PaaS",
                    "IaaS",
                    "SCS"
                  ]
                },
                "freeOption": {
                  "type": "boolean"
                },
                "supplierId": {
                  "type": "integer"
                },
                "terminationCost": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "status",
                "supplierId",
                "lot",
                "title",
                "serviceName",
                "serviceSummary",
                "serviceDefinitionDocumentURL",
                "termsAndConditionsDocumentURL",
                "pricingDocumentURL",
                "minimumContractPeriod",
                "freeOption",
                "trialOption",
                "terminationCost",
                "priceMin",
                "priceUnit",
                "priceString"
              ]
            },
            {
              "patternProperties": {
                "^pricingDocumentURL$": true,
                "^educationPricing$": true,
                "^datacentreTier$": true,
                "^openStandardsSupported$": true,
                "^serviceDefinitionDocumentURL$": true,
                "^priceUnit$": true,
                "^status$": true,
                "^termsAndConditionsDocumentURL$": true,
                "^dataBackupRecovery$": true,
                "^additionalDocumentURLs$": true,
                "^serviceOnboarding$": true,
                "^serviceOffboarding$": true,
                "^serviceSummary$": true,
                "^supportForThirdParties$": true,
                "^serviceTypes$": true,
                "^apiAccess$": true,
                "^datacentresEUCode$": true,
                "^minimumContractPeriod$": true,
                "^terminationCost$": true,
                "^persistentStorage$": true,
                "^serviceName$": true,
                "^openSource$": true,
                "^networksConnected$": true,
                "^sfiaRateDocumentURL$": true,
                "^priceString$": true,
                "^serviceFeatures$": true,
                "^lot$": true,
                "^id$": true,
                "^supplierId$": true,
                "^selfServiceProvisioning$": true,
                "^dataExtractionRemoval$": true,
                "^trialOption$": true,
                "^elasticCloud$": true,
                "^priceMin$": true,
                "^title$": true,
                "^serviceBenefits$": true,
                "^guaranteedResources$": true,
                "^freeOption$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
