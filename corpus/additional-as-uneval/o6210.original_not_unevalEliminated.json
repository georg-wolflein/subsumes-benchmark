{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maxLength",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o6210.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning",
                      "error",
                      "critical"
                    ]
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "new",
                      "acknowledged",
                      "resolved"
                    ]
                  },
                  "subject": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "required": [
                  "level",
                  "state",
                  "subject"
                ]
              },
              {
                "patternProperties": {
                  "^level$": true,
                  "^state$": true,
                  "^subject$": true,
                  "^message$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "level": {
        "type": "string",
        "enum": [
          "info",
          "warning",
          "error",
          "critical"
        ]
      },
      "state": {
        "type": "string",
        "enum": [
          "new",
          "acknowledged",
          "resolved"
        ]
      },
      "subject": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "message": {
        "type": "string"
      }
    },
    "required": [
      "level",
      "state",
      "subject"
    ],
    "additionalProperties": false
  }
}
