{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "level": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warning",
                    "error",
                    "critical"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "new",
                    "acknowledged",
                    "resolved"
                  ]
                },
                "subject": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "level",
                "state",
                "subject"
              ]
            },
            {
              "patternProperties": {
                "^level$": true,
                "^state$": true,
                "^subject$": true,
                "^message$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
