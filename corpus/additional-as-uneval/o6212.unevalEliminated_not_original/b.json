{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 32767
    },
    "nodes": {
      "$ref": "#/$defs/nodes"
    },
    "globals": {
      "$ref": "#/$defs/globals"
    },
    "creationDate": {
      "type": "string",
      "format": "date-time"
    },
    "flowId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "enabled": {
      "$ref": "#/$defs/enabled"
    },
    "triggers": {
      "$ref": "#/$defs/triggers"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "object"
                },
                "outputIds": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "key": {
                  "type": "string"
                },
                "meta": {
                  "type": "object"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^outputIds$": true,
                "^config$": true,
                "^meta$": true,
                "^type$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "object"
                },
                "outputIds": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "meta": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^outputIds$": true,
                "^config$": true,
                "^meta$": true,
                "^type$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_2"
      }
    },
    "globals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_3"
      }
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "json": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "json"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^json$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
