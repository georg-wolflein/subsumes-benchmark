{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "description": {
                  "type": "string",
                  "maxLength": 32767
                },
                "enabled": {
                  "type": "boolean"
                },
                "triggers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "nodes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "globals": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^triggers$": true,
                "^name$": true,
                "^nodes$": true,
                "^enabled$": true,
                "^globals$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "object"
                },
                "outputIds": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "key": {
                  "type": "string"
                },
                "meta": {
                  "type": "object"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^outputIds$": true,
                "^config$": true,
                "^meta$": true,
                "^type$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "config": {
                  "type": "object"
                },
                "outputIds": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "type": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "meta": {
                  "type": "object"
                }
              },
              "required": [
                "id",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^outputIds$": true,
                "^config$": true,
                "^meta$": true,
                "^type$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "json": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "json"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^json$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
