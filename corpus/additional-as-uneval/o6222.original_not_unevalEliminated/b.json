{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "gpsCheck": {
          "$ref": "#/$defs/_gpsCheck"
        },
        "gpsCenter": {
          "$ref": "#/$defs/_gpsCenter"
        },
        "radius": {
          "$ref": "#/$defs/radius"
        },
        "resultPath": {
          "$ref": "#/$defs/resultPath"
        }
      },
      "additionalProperties": false,
      "required": [
        "radius",
        "gpsCheck",
        "gpsCenter"
      ]
    },
    {
      "properties": {
        "gpsCheck": {
          "$ref": "#/$defs/_gpsCheck"
        },
        "latCenter": {
          "$ref": "#/$defs/_latCenter"
        },
        "lonCenter": {
          "$ref": "#/$defs/_lonCenter"
        },
        "radius": {
          "$ref": "#/$defs/radius"
        },
        "resultPath": {
          "$ref": "#/$defs/resultPath"
        }
      },
      "additionalProperties": false,
      "required": [
        "radius",
        "gpsCheck",
        "latCenter",
        "lonCenter"
      ]
    },
    {
      "properties": {
        "latCheck": {
          "$ref": "#/$defs/_latCheck"
        },
        "lonCheck": {
          "$ref": "#/$defs/_lonCheck"
        },
        "gpsCenter": {
          "$ref": "#/$defs/_gpsCenter"
        },
        "radius": {
          "$ref": "#/$defs/radius"
        },
        "resultPath": {
          "$ref": "#/$defs/resultPath"
        }
      },
      "additionalProperties": false,
      "required": [
        "radius",
        "latCheck",
        "lonCheck",
        "gpsCenter"
      ]
    },
    {
      "properties": {
        "latCheck": {
          "$ref": "#/$defs/_latCheck"
        },
        "lonCheck": {
          "$ref": "#/$defs/_lonCheck"
        },
        "latCenter": {
          "$ref": "#/$defs/_latCenter"
        },
        "lonCenter": {
          "$ref": "#/$defs/_lonCenter"
        },
        "radius": {
          "$ref": "#/$defs/radius"
        },
        "resultPath": {
          "$ref": "#/$defs/resultPath"
        }
      },
      "additionalProperties": false,
      "required": [
        "radius",
        "latCheck",
        "lonCheck",
        "latCenter",
        "lonCenter"
      ]
    }
  ],
  "$defs": {
    "_gpsCheck": {
      "title": "Point A GPS Formatted String",
      "type": "string",
      "minLength": 1
    },
    "_latCheck": {
      "title": "Point A Latitude / Template",
      "type": "string",
      "minLength": 1
    },
    "_lonCheck": {
      "title": "Point A Longitude / Template",
      "type": "string",
      "minLength": 1
    },
    "_gpsCenter": {
      "title": "Point B GPS Formatted String",
      "type": "string",
      "minLength": 1
    },
    "_latCenter": {
      "title": "Point B Latitude / Template",
      "type": "string",
      "minLength": 1
    },
    "_lonCenter": {
      "title": "Point B Longitude / Template",
      "type": "string",
      "minLength": 1
    },
    "radius": {
      "title": "Radius (meters) / Template",
      "type": "string"
    },
    "resultPath": {
      "title": "Result Path",
      "description": "JSON Path for where to put the distance between the two coordinates",
      "type": "string"
    }
  }
}
