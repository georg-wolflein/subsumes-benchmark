{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "title": "Source",
                  "description": "JSON path for source that contains the input",
                  "type": "string",
                  "minLength": 1
                },
                "destination": {
                  "title": "Destination",
                  "description": "JSON path for destination to place output",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "source",
                "destination"
              ]
            },
            {
              "patternProperties": {
                "^source$": true,
                "^destination$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
