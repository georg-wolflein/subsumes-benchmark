{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "statements": {
                  "title": "Statements",
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "statements"
              ]
            },
            {
              "patternProperties": {
                "^statements$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Statement",
              "type": "object",
              "properties": {
                "expression": {
                  "title": "Expression",
                  "description": "JSON Paths are allowed, wrapped in {{this.is.a.path}}",
                  "type": "string",
                  "minLength": 1
                },
                "resultPath": {
                  "title": "Result Path",
                  "description": "JSON path to place result of evaluated expression",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "expression",
                "resultPath"
              ]
            },
            {
              "patternProperties": {
                "^expression$": true,
                "^resultPath$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
