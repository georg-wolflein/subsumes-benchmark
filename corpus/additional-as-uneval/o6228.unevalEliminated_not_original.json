{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minLength",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o6228.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "type": "object",
    "properties": {
      "timeSincePath": {
        "title": "Time Since Path",
        "description": "JSON path to store the time since last not throttled payload",
        "type": "string",
        "minLength": 1
      },
      "ratePerMinute": {
        "title": "Rate (per minute)",
        "description": "Number of payloads to allow per minute",
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "ratePerMinute"
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "timeSincePath": {
                    "title": "Time Since Path",
                    "description": "JSON path to store the time since last not throttled payload",
                    "type": "string",
                    "minLength": 1
                  },
                  "ratePerMinute": {
                    "title": "Rate (per minute)",
                    "description": "Number of payloads to allow per minute",
                    "type": "integer",
                    "minimum": 1.0
                  }
                },
                "required": [
                  "ratePerMinute"
                ]
              },
              {
                "patternProperties": {
                  "^timeSincePath$": true,
                  "^ratePerMinute$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
