{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "location": {
                  "type": "string",
                  "maxLength": 1024
                },
                "phoneNumber": {
                  "type": "string",
                  "maxLength": 1024
                },
                "lastName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "firstName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "companyName": {
                  "type": "string",
                  "maxLength": 1024
                },
                "password": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 2048
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "maxLength": 1024
                },
                "url": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            },
            {
              "patternProperties": {
                "^lastName$": true,
                "^companyName$": true,
                "^url$": true,
                "^password$": true,
                "^firstName$": true,
                "^phoneNumber$": true,
                "^location$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
