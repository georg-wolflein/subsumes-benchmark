{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maxLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o6235.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "email": {
        "_format": "email",
        "maxLength": 1024,
        "type": "string"
      },
      "role": {
        "enum": [
          "admin",
          "edit",
          "view"
        ],
        "type": "string"
      }
    },
    "required": [
      "email",
      "role"
    ],
    "type": "object"
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "email": {
                    "_format": "email",
                    "maxLength": 1024,
                    "type": "string"
                  },
                  "role": {
                    "enum": [
                      "admin",
                      "edit",
                      "view"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "role"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^email$": true,
                  "^role$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
