{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "message": {
                  "title": "message",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "message"
              ]
            },
            {
              "patternProperties": {
                "^message$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
