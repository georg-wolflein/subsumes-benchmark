{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "level": {
                  "title": "Level",
                  "enum": [
                    "info",
                    "warning",
                    "error",
                    "critical"
                  ]
                },
                "subjectTemplate": {
                  "title": "Subject Template",
                  "type": "string",
                  "minLength": 1
                },
                "messageTemplate": {
                  "title": "Message Template",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "level",
                "subjectTemplate",
                "messageTemplate"
              ]
            },
            {
              "patternProperties": {
                "^level$": true,
                "^subjectTemplate$": true,
                "^messageTemplate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
