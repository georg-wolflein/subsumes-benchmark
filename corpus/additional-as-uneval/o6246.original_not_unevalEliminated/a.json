{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "topicTemplate": {
                  "title": "Topic Template",
                  "type": "string",
                  "minLength": 1
                },
                "messageTemplate": {
                  "title": "Message Template",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "topicTemplate",
                "messageTemplate"
              ]
            },
            {
              "patternProperties": {
                "^topicTemplate$": true,
                "^messageTemplate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
