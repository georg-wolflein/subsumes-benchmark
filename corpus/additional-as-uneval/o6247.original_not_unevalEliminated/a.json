{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "allOf": [
                {
                  "required": [
                    "bodyTemplate",
                    "subjectTemplate",
                    "fromTemplate",
                    "sendgridApiKey"
                  ]
                },
                {
                  "anyOf": [
                    {
                      "required": [
                        "toAddresses"
                      ]
                    },
                    {
                      "required": [
                        "ccAddresses"
                      ]
                    },
                    {
                      "required": [
                        "bccAddresses"
                      ]
                    }
                  ]
                }
              ],
              "properties": {
                "bodyTemplate": {
                  "minLength": 1,
                  "title": "Body Template",
                  "type": "string"
                },
                "toAddresses": {
                  "items": {
                    "_format": "email",
                    "minLength": 1,
                    "title": "Email Address",
                    "type": "string"
                  },
                  "minItems": 1,
                  "title": "To Addresses",
                  "type": "array"
                },
                "replyToTemplate": {
                  "minLength": 1,
                  "title": "Reply-To Template",
                  "type": "string"
                },
                "resultPath": {
                  "description": "JSON path to store SendGrid response",
                  "minLength": 1,
                  "title": "Result Path",
                  "type": "string"
                },
                "sendgridApiKey": {
                  "minLength": 1,
                  "title": "SendGrid API Key",
                  "type": "string"
                },
                "bccAddresses": {
                  "items": {
                    "_format": "email",
                    "minLength": 1,
                    "title": "Email Address",
                    "type": "string"
                  },
                  "minItems": 1,
                  "title": "BCC Addresses",
                  "type": "array"
                },
                "ccAddresses": {
                  "items": {
                    "_format": "email",
                    "minLength": 1,
                    "title": "Email Address",
                    "type": "string"
                  },
                  "minItems": 1,
                  "title": "CC Addresses",
                  "type": "array"
                },
                "fromTemplate": {
                  "minLength": 1,
                  "title": "From Template",
                  "type": "string"
                },
                "subjectTemplate": {
                  "minLength": 1,
                  "title": "Subject Template",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^toAddresses$": true,
                "^replyToTemplate$": true,
                "^fromTemplate$": true,
                "^sendgridApiKey$": true,
                "^resultPath$": true,
                "^subjectTemplate$": true,
                "^ccAddresses$": true,
                "^bodyTemplate$": true,
                "^bccAddresses$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
