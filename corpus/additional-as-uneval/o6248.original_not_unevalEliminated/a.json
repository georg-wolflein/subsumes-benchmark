{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "urlPathTemplate": {
                  "title": "Service Path",
                  "type": "string",
                  "minLength": 1
                },
                "textTemplate": {
                  "title": "Message",
                  "type": "string",
                  "minLength": 1
                },
                "channelTemplate": {
                  "title": "Channel Name",
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "urlPathTemplate"
              ]
            },
            {
              "patternProperties": {
                "^urlPathTemplate$": true,
                "^textTemplate$": true,
                "^channelTemplate$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
