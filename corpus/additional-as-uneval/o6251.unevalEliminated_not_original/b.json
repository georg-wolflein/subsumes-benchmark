{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "email": {
                  "_format": "email",
                  "maxLength": 1024,
                  "type": "string"
                },
                "password": {
                  "maxLength": 2048,
                  "minLength": 8,
                  "type": "string"
                },
                "token": {
                  "type": "string"
                }
              },
              "required": [
                "token",
                "email",
                "password"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^email$": true,
                "^password$": true,
                "^token$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
