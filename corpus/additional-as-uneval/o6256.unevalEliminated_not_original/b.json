{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "end": {
                  "_format": "date-time",
                  "type": "string"
                },
                "start": {
                  "_format": "date-time",
                  "type": "string"
                },
                "devices": {
                  "$ref": "#/$defs/modern_2"
                },
                "resolution": {
                  "type": "number"
                },
                "aggregation": {
                  "type": "string"
                }
              },
              "required": [
                "start",
                "end",
                "resolution",
                "aggregation",
                "devices"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^aggregation$": true,
                "^end$": true,
                "^start$": true,
                "^devices$": true,
                "^resolution$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "^[A-Fa-f\\d]{24}$": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^[A-Fa-f\\d]{24}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "points": {
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  },
                  "type": "array"
                }
              },
              "required": [
                "name",
                "points"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^points$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "data": {
                  "$ref": "#/$defs/modern_5"
                },
                "time": {
                  "_format": "date-time",
                  "type": "string"
                }
              },
              "required": [
                "data",
                "time"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^data$": true,
                "^time$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
