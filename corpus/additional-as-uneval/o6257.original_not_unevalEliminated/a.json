{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "duration": {
                  "type": "number"
                },
                "deviceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Fa-f\\d]{24}$"
                  }
                },
                "attributes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                  }
                },
                "end": {
                  "type": "number"
                },
                "start": {
                  "type": "number"
                },
                "deviceTags": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255
                      }
                    }
                  }
                },
                "resolution": {
                  "type": "number"
                },
                "aggregation": {
                  "type": "string",
                  "enum": [
                    "FIRST",
                    "LAST",
                    "COUNT",
                    "MAX",
                    "MIN",
                    "MEDIAN",
                    "MEAN",
                    "SUM"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^deviceTags$": true,
                "^aggregation$": true,
                "^attributes$": true,
                "^end$": true,
                "^duration$": true,
                "^start$": true,
                "^deviceIds$": true,
                "^resolution$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
