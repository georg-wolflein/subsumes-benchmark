{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "virtualButton"
                  ]
                },
                "outputIds": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "meta": {
                  "type": "object"
                },
                "config": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^outputIds$": true,
                "^meta$": true,
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
