{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "CollectionIdType": {
      "type": "object",
      "properties": {
        "short-name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "short-name",
        "version"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Ingest Bulk Update",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "update-value": {
                  "oneOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "minItems": 1
                    }
                  ]
                },
                "concept-ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                },
                "find-value": {
                  "type": "object"
                },
                "collection-ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/CollectionIdType"
                  },
                  "minItems": 1
                },
                "update-field": {
                  "$ref": "#/$defs/UpdateFieldEnum"
                },
                "update-type": {
                  "$ref": "#/$defs/UpdateTypeEnum"
                }
              },
              "required": [
                "update-type",
                "update-field",
                "concept-ids"
              ]
            },
            {
              "patternProperties": {
                "^update-type$": true,
                "^concept-ids$": true,
                "^collection-ids$": true,
                "^name$": true,
                "^update-field$": true,
                "^find-value$": true,
                "^update-value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "UpdateFieldEnum": {
      "type": "string",
      "enum": [
        "SCIENCE_KEYWORDS",
        "LOCATION_KEYWORDS",
        "DATA_CENTERS",
        "PLATFORMS",
        "INSTRUMENTS"
      ]
    },
    "UpdateTypeEnum": {
      "type": "string",
      "enum": [
        "ADD_TO_EXISTING",
        "CLEAR_FIELD",
        "CLEAR_ALL_AND_REPLACE",
        "FIND_AND_REMOVE",
        "FIND_AND_REPLACE",
        "FIND_AND_UPDATE",
        "FIND_AND_UPDATE_HOME_PAGE_URL"
      ]
    }
  }
}
