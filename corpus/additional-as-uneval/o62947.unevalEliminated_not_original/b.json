{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_11",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "file",
                "hash.sha1",
                "label"
              ],
              "properties": {
                "id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^screen\\.(loading|ingame\\.(menu|end|\\d+))$"
                    },
                    {
                      "type": "string",
                      "pattern": "^scan\\.tape\\d+\\.(inlay(Front|Back)|side[A-B])$"
                    },
                    {
                      "type": "string",
                      "pattern": "^scan\\.disk\\d+$"
                    },
                    {
                      "type": "string",
                      "pattern": "^scan\\.rom\\.(inlay(Front|Back))$"
                    },
                    {
                      "type": "string",
                      "pattern": "^scan\\.manual\\d+$"
                    },
                    {
                      "type": "string",
                      "pattern": "^custom\\.(coverhd|gamemap)$"
                    }
                  ]
                },
                "file": {
                  "$ref": "#/$defs/imageFileType"
                },
                "hash.sha1": {
                  "$ref": "#/$defs/sha1Type"
                },
                "default": {
                  "type": "boolean"
                }
              },
              "patternProperties": {
                "^label(\\.[a-z]{2}){0,1}$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^file$": true,
                "^id$": true,
                "^hash.sha1$": true,
                "^default$": true,
                "^label(\\.[a-z]{2}){0,1}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Catalog info definition",
              "type": "object",
              "required": [
                "id",
                "updated",
                "platform",
                "type",
                "name",
                "license"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "genre": {
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "enum": [
                      "action",
                      "adventure",
                      "isometric",
                      "puzzle",
                      "shooter",
                      "arcade",
                      "platforms",
                      "strategy",
                      "others"
                    ]
                  }
                },
                "country": {
                  "type": "string"
                },
                "name.transliterated": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "id": {
                  "$ref": "#/$defs/idCatalogType"
                },
                "date": {
                  "type": "integer",
                  "minimum": 1982.0
                },
                "publisher": {
                  "type": "string"
                },
                "developers": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/developerType"
                  }
                },
                "instructions": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "game",
                    "application",
                    "demoscene"
                  ]
                },
                "platform": {
                  "enum": [
                    "MSX",
                    "MSX2",
                    "MSX2+",
                    "Turbo-R"
                  ]
                },
                "controls": {
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "enum": [
                      "keyboard",
                      "joystick",
                      "mouse"
                    ]
                  }
                },
                "code": {
                  "type": "string",
                  "description": "Game serial code"
                },
                "license": {
                  "enum": [
                    "unknown",
                    "copyleft",
                    "commercial"
                  ]
                },
                "updated": {
                  "$ref": "#/$defs/datetimeType"
                },
                "language": {
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "enum": [
                      "en",
                      "jp",
                      "es",
                      "nl",
                      "br",
                      "fr",
                      "it"
                    ]
                  }
                },
                "sound": {
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "enum": [
                      "PSG",
                      "OPLL",
                      "SCC",
                      "SCC+",
                      "MSX-Audio",
                      "OPL4"
                    ]
                  }
                },
                "name.original": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^updated$": true,
                "^name$": true,
                "^type$": true,
                "^id$": true,
                "^company$": true,
                "^language$": true,
                "^license$": true,
                "^controls$": true,
                "^name.transliterated$": true,
                "^code$": true,
                "^instructions$": true,
                "^publisher$": true,
                "^name.original$": true,
                "^developers$": true,
                "^date$": true,
                "^sound$": true,
                "^platform$": true,
                "^genre$": true,
                "^country$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "mimetype",
                "file",
                "hash.sha1"
              ],
              "properties": {
                "id": {
                  "$rel": "#/definitions4/idContentType"
                },
                "hash.sha1": {
                  "$ref": "#/$defs/sha1Type"
                },
                "file": {
                  "$ref": "#/$defs/contentFileType"
                },
                "mimetype": {
                  "type": "string"
                },
                "format": {
                  "type": "string",
                  "description": "Aditional content format info."
                }
              },
              "patternProperties": {
                "^comment(\\.[a-z]{2}){0,1}$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^file$": true,
                "^format$": true,
                "^id$": true,
                "^comment(\\.[a-z]{2}){0,1}$": true,
                "^mimetype$": true,
                "^hash.sha1$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Header definition",
              "type": "object",
              "required": [
                "mimecrc",
                "mimetype",
                "version"
              ],
              "properties": {
                "mimecrc": {
                  "$ref": "#/$defs/crc32Type",
                  "description": "CRC32 of mimetype"
                },
                "mimetype": {
                  "type": "string",
                  "pattern": "^application/x-metacatalog-(tape|cartridge|disk)$"
                },
                "version": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d{1,2}\\.\\d{1,2}$"
                }
              }
            },
            {
              "patternProperties": {
                "^mimecrc$": true,
                "^mimetype$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "headerType": {
      "$ref": "#/$defs/modern_1"
    },
    "idContentType": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^tape\\d+(\\.side[A-Z](\\.part\\d+){0,1}){0,1}$(\\.alt\\d+){0,1}"
        },
        {
          "type": "string",
          "pattern": "^disk\\d+(\\.alt\\d+){0,1}$"
        },
        {
          "type": "string",
          "pattern": "^rom\\d+(\\.alt\\d+){0,1}$"
        }
      ],
      "description": "Use https://regex101.com to validate ids"
    },
    "datetimeType": {
      "type": "string",
      "pattern": "^\\d{4}(-\\d{2}){0,2}( \\d{2}(:\\d{2}){1,2}){0,1}$",
      "description": "Date-time format 'YYYY-MM-DD [HH:MM:[SS]]'"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Extra content",
              "type": "object",
              "properties": {
                "maintheme": {
                  "$ref": "#/$defs/extraFileType"
                },
                "images": {
                  "$ref": "#/$defs/imageArrayType"
                },
                "tips": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/tipsType"
                  }
                },
                "cheats": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/cheatsType"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^maintheme$": true,
                "^images$": true,
                "^tips$": true,
                "^cheats$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "tipsType": {
      "$ref": "#/$defs/modern_3"
    },
    "idCatalogType": {
      "$ref": "#/$defs/modern_4"
    },
    "sha1Type": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "To generate SHA1 use: http://hash-functions.online-domain-tools.com/"
    },
    "md5Type": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$",
      "description": "To generate MD5 use: http://hash-functions.online-domain-tools.com/"
    },
    "imageItemType": {
      "$ref": "#/$defs/modern_5"
    },
    "contentItemType": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "name": "metacatalog-msx",
              "title": "",
              "type": "object",
              "description": "Schema for 8-bit-computer software metacataloguing",
              "required": [
                "header",
                "catalog",
                "content"
              ],
              "properties": {
                "catalog": {
                  "$ref": "#/$defs/catalogType"
                },
                "header": {
                  "$ref": "#/$defs/headerType"
                },
                "$schema": {
                  "type": "string"
                },
                "content": {
                  "$ref": "#/$defs/contentArrayType"
                },
                "extras": {
                  "$ref": "#/$defs/extrasType"
                }
              }
            },
            {
              "patternProperties": {
                "^$schema$": true,
                "^header$": true,
                "^content$": true,
                "^catalog$": true,
                "^extras$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "developerType": {
      "$ref": "#/$defs/modern_8"
    },
    "contentFileType": {
      "type": "string",
      "pattern": "^content/[^/]+\\.(cas|rom|dsk)$"
    },
    "extrasType": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Item file of main content folder",
              "type": "object",
              "required": [
                "id",
                "mimetype",
                "file",
                "hash.sha1"
              ],
              "properties": {
                "start.command": {
                  "type": "string",
                  "description": "BLOAD or RUN commands"
                },
                "alternates": {
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "$rel": "#/definitions4/contentAlternateType"
                  }
                },
                "hash.sha1": {
                  "$ref": "#/$defs/sha1Type"
                },
                "file": {
                  "$ref": "#/$defs/contentFileType"
                },
                "mimetype": {
                  "type": "string"
                },
                "format": {
                  "type": "string",
                  "description": "Aditional content format info."
                },
                "related.images": {
                  "description": "Im\u00e1genes relacionadas",
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "type": "string"
                  }
                },
                "id": {
                  "$rel": "#/definitions4/idContentType"
                }
              },
              "patternProperties": {
                "^label(\\.[a-z]{2}){0,1}$": {
                  "type": "string"
                },
                "^comment(\\.[a-z]{2}){0,1}$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^format$": true,
                "^alternates$": true,
                "^id$": true,
                "^start.command$": true,
                "^label(\\.[a-z]{2}){0,1}$": true,
                "^comment(\\.[a-z]{2}){0,1}$": true,
                "^file$": true,
                "^related.images$": true,
                "^mimetype$": true,
                "^hash.sha1$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "contentArrayType": {
      "description": "Content to catalog.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$rel": "#/definitions4/contentItemType"
      }
    },
    "cheatsType": {
      "description": "Need definition"
    },
    "extraFileType": {
      "type": "string",
      "pattern": "^extras/[^/]+$"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Developer name, task and an optional email",
              "type": "object",
              "required": [
                "name",
                "task"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "task": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^task$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "File hash",
              "type": "object",
              "required": [
                "crc32",
                "md5",
                "sha1"
              ],
              "properties": {
                "crc32": {
                  "$ref": "#/$defs/crc32Type"
                },
                "md5": {
                  "$ref": "#/$defs/md5Type"
                },
                "sha1": {
                  "$ref": "#/$defs/sha1Type"
                }
              }
            },
            {
              "patternProperties": {
                "^crc32$": true,
                "^md5$": true,
                "^sha1$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "catalogType": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Tips item",
              "type": "object",
              "required": [
                "label",
                "description"
              ],
              "patternProperties": {
                "^label(\\.[a-z]{2}){0,1}$": {
                  "type": "string"
                },
                "^description(\\.[a-z]{2}){0,1}$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^label(\\.[a-z]{2}){0,1}$": true,
                "^description(\\.[a-z]{2}){0,1}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "crc32Type": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}$",
      "description": "To generate CRC32 use: http://hash-functions.online-domain-tools.com/"
    },
    "hashType": {
      "$ref": "#/$defs/modern_9"
    },
    "imageFileType": {
      "type": "string",
      "pattern": "^extras/[^/]+\\.(jpg|png|gif)$"
    },
    "contentAlternateType": {
      "$ref": "#/$defs/modern_10"
    },
    "imageArrayType": {
      "description": "To launchers: get main game image in this order by availability 'screen.loading', 'screen.ingame.menu', 'screen.ingame.1', and the image with true default attribute.",
      "type": "array",
      "minItems": 1,
      "_uniqueItems": true,
      "items": {
        "$ref": "#/$defs/imageItemType"
      }
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Id for catalogType object",
              "type": "object",
              "required": [
                "string",
                "crc32",
                "md5",
                "sha1"
              ],
              "properties": {
                "string": {
                  "type": "string",
                  "pattern": "^\\w+(|\\.[\\w,]+)*$"
                },
                "crc32": {
                  "$ref": "#/$defs/crc32Type"
                },
                "md5": {
                  "$ref": "#/$defs/md5Type"
                },
                "sha1": {
                  "$ref": "#/$defs/sha1Type"
                }
              }
            },
            {
              "patternProperties": {
                "^string$": true,
                "^crc32$": true,
                "^md5$": true,
                "^sha1$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
