{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Annotation Value Resource",
              "description": "A single annotation value within a BEL Annotation.",
              "type": "object",
              "required": [
                "annotation_value"
              ],
              "properties": {
                "annotation_value": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^annotation_value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type",
                "identifier",
                "name"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "identifier": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "match_text": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^identifier$": true,
                "^name$": true,
                "^match_text$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
