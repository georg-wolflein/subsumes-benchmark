{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "pattern": {
                  "type": "string"
                },
                "mediaType": {
                  "type": "string"
                },
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "multiple": {
                  "default": false,
                  "type": "boolean"
                },
                "required": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "name",
                "pattern"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^multiple$": true,
                "^required$": true,
                "^mediaType$": true,
                "^name$": true,
                "^pattern$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "key": {
                  "type": "string"
                },
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "required": {
                  "default": true,
                  "type": "boolean"
                },
                "type": {
                  "enum": [
                    "array",
                    "boolean",
                    "integer",
                    "number",
                    "object",
                    "string"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^key$": true,
                "^name$": true,
                "^required$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "mode": {
                  "default": "ro",
                  "enum": [
                    "ro",
                    "rw"
                  ]
                },
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "path"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^mode$": true,
                "^name$": true,
                "^path$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "inputMultiplier": {
                  "type": "number"
                },
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "value"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^inputMultiplier$": true,
                "^name$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "job": {
                  "$ref": "#/$defs/modern_2"
                },
                "seedVersion": {
                  "pattern": "^SEED_VERSION$",
                  "type": "string"
                }
              },
              "required": [
                "seedVersion",
                "job"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^job$": true,
                "^seedVersion$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "files": {
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  },
                  "type": "array"
                },
                "json": {
                  "items": {
                    "$ref": "#/$defs/modern_9"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^files$": true,
                "^json$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "packageVersion": {
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$",
                  "type": "string"
                },
                "name": {
                  "pattern": "^[a-zA-Z0-9-]+$",
                  "type": "string"
                },
                "interface": {
                  "$ref": "#/$defs/modern_3"
                },
                "maintainer": {
                  "$ref": "#/$defs/modern_12"
                },
                "errors": {
                  "items": {
                    "$ref": "#/$defs/modern_13"
                  },
                  "type": "array"
                },
                "resources": {
                  "$ref": "#/$defs/modern_14"
                },
                "jobVersion": {
                  "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*)?(\\+[0-9a-zA-Z-]+(\\.[0-9a-zA-Z-]+)*)?$",
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "timeout": {
                  "type": "integer"
                },
                "description": {
                  "type": "string"
                },
                "tags": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "name",
                "jobVersion",
                "packageVersion",
                "title",
                "description",
                "maintainer",
                "timeout"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^interface$": true,
                "^jobVersion$": true,
                "^errors$": true,
                "^resources$": true,
                "^name$": true,
                "^packageVersion$": true,
                "^title$": true,
                "^maintainer$": true,
                "^tags$": true,
                "^timeout$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "organization": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "email"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^phone$": true,
                "^url$": true,
                "^name$": true,
                "^organization$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "partial": {
                  "default": false,
                  "type": "boolean"
                },
                "mediaTypes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "multiple": {
                  "default": false,
                  "type": "boolean"
                },
                "required": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^multiple$": true,
                "^required$": true,
                "^name$": true,
                "^partial$": true,
                "^mediaTypes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "required": {
                  "default": true,
                  "type": "boolean"
                },
                "type": {
                  "enum": [
                    "array",
                    "boolean",
                    "integer",
                    "number",
                    "object",
                    "string"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^required$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "code": {
                  "type": "integer"
                },
                "category": {
                  "default": "job",
                  "enum": [
                    "job",
                    "data"
                  ],
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^code$": true,
                "^description$": true,
                "^category$": true,
                "^name$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "outputs": {
                  "$ref": "#/$defs/modern_4"
                },
                "command": {
                  "type": "string"
                },
                "inputs": {
                  "$ref": "#/$defs/modern_7"
                },
                "mounts": {
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  },
                  "type": "array"
                },
                "settings": {
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^outputs$": true,
                "^inputs$": true,
                "^mounts$": true,
                "^settings$": true,
                "^command$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "pattern": "^[a-zA-Z0-9_-]+$",
                  "type": "string"
                },
                "secret": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^secret$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "scalar": {
                  "items": {
                    "$ref": "#/$defs/modern_15"
                  },
                  "required": [
                    "scalar"
                  ],
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^scalar$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "files": {
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "type": "array"
                },
                "json": {
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^files$": true,
                "^json$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
