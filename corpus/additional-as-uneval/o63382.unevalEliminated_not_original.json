            "type": "object",
            "format": "minimal_user"
          }
        },
        "additionalProperties": false
      },
      "pull_requests_in_organization": {
        "type": "object",
        "patternProperties": {
          "^[^/#]+/[^/#]+#[012456789]+$": {
