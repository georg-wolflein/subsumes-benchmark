{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "format": "minimal",
  "properties": {
    "number_of_pull_requests_in_organization": {
      "format": "positiveInteger"
    },
    "number_of_repositories": {
      "format": "positiveInteger"
    },
    "first_timers": {
      "$ref": "#/$defs/modern_1"
    },
    "pull_requests_in_organization": {
      "$ref": "#/$defs/modern_2"
    },
    "number_of_first_timers": {
      "format": "positiveInteger"
    },
    "repositories": {
      "$ref": "#/$defs/modern_3"
    }
  },
  "required": [
    "repositories",
    "number_of_pull_requests_in_organization",
    "pull_requests_in_organization",
    "first_timers",
    "number_of_first_timers",
    "number_of_repositories"
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[^/#]+$": {
                  "type": "object",
                  "format": "minimal_user"
                }
              }
            },
            {
              "patternProperties": {
                "^[^/#]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[^/#]+/[^/#]+#[012456789]+$": {
                  "type": "object",
                  "format": "minimal_pullrequest"
                }
              }
            },
            {
              "patternProperties": {
                "^[^/#]+/[^/#]+#[012456789]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[^/#]+$": {
                  "type": "object",
                  "format": "minimal_repository"
                }
              }
            },
            {
              "patternProperties": {
                "^[^/#]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
