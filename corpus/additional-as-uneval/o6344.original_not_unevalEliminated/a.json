{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/SkaffoldConfig"
    }
  ],
  "type": "object",
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": "{}",
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "projectId"
              ],
              "properties": {
                "projectId": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^projectId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "contains the configuration needed for deploying with `kubectl apply`",
              "preferredOrder": [
                "manifests"
              ],
              "properties": {
                "manifests": {
                  "items": {
                    "$ref": "#/$defs/Manifest"
                  },
                  "type": "array"
                }
              },
              "x-intellij-html-description": "contains the configuration needed for deploying with <code>kubectl apply</code>"
            },
            {
              "patternProperties": {
                "^manifests$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "HelmDeploy": {
      "$ref": "#/$defs/modern_4"
    },
    "KubectlDeploy": {
      "$ref": "#/$defs/modern_7"
    },
    "LocalBuild": {
      "$ref": "#/$defs/modern_17"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "artifacts",
                "tagPolicy"
              ],
              "properties": {
                "artifacts": {
                  "items": {
                    "$ref": "#/$defs/Artifact"
                  },
                  "type": "array"
                },
                "tagPolicy": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^artifacts$": true,
                "^tagPolicy$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "releases"
              ],
              "properties": {
                "releases": {
                  "items": {
                    "$ref": "#/$defs/HelmRelease"
                  },
                  "type": "array"
                }
              }
            },
            {
              "patternProperties": {
                "^releases$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "represents items that need should be built, along with the context in which they should be built.",
              "preferredOrder": [
                "imageName",
                "dockerfilePath",
                "workspace",
                "buildArgs"
              ],
              "properties": {
                "buildArgs": {
                  "$ref": "#/$defs/modern_6"
                },
                "dockerfilePath": {
                  "type": "string"
                },
                "imageName": {
                  "type": "string"
                },
                "workspace": {
                  "type": "string"
                }
              },
              "x-intellij-html-description": "represents items that need should be built, along with the context in which they should be built."
            },
            {
              "patternProperties": {
                "^buildArgs$": true,
                "^dockerfilePath$": true,
                "^imageName$": true,
                "^workspace$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "GoogleCloudBuild": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": "{}",
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "HelmRelease": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "artifacts",
                "tagPolicy",
                "googleCloudBuild"
              ],
              "properties": {
                "artifacts": {
                  "items": {
                    "$ref": "#/$defs/Artifact"
                  },
                  "type": "array"
                },
                "googleCloudBuild": {
                  "$ref": "#/$defs/GoogleCloudBuild"
                },
                "tagPolicy": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^artifacts$": true,
                "^googleCloudBuild$": true,
                "^tagPolicy$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "artifacts",
                "tagPolicy",
                "local"
              ],
              "properties": {
                "artifacts": {
                  "items": {
                    "$ref": "#/$defs/Artifact"
                  },
                  "type": "array"
                },
                "local": {
                  "$ref": "#/$defs/LocalBuild"
                },
                "tagPolicy": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^artifacts$": true,
                "^local$": true,
                "^tagPolicy$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "contains the fields needed to do a build on the local docker daemon and optionally push to a repository.",
              "preferredOrder": [
                "skipPush"
              ],
              "properties": {
                "skipPush": {
                  "type": "boolean"
                }
              },
              "x-intellij-html-description": "contains the fields needed to do a build on the local docker daemon and optionally push to a repository."
            },
            {
              "patternProperties": {
                "^skipPush$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "name",
                "chartPath",
                "valuesFilePath",
                "values",
                "namespace",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "chartPath": {
                  "type": "string"
                },
                "values": {
                  "$ref": "#/$defs/modern_3"
                },
                "valuesFilePath": {
                  "type": "string"
                },
                "namespace": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^valuesFilePath$": true,
                "^name$": true,
                "^values$": true,
                "^chartPath$": true,
                "^namespace$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Artifact": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "name",
                "helm"
              ],
              "properties": {
                "helm": {
                  "$ref": "#/$defs/HelmDeploy"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^helm$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "SkaffoldConfig": {
      "$ref": "#/$defs/modern_8"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "top level config object that is parsed from a skaffold.yaml",
              "preferredOrder": [
                "apiVersion",
                "kind",
                "build",
                "deploy"
              ],
              "properties": {
                "apiVersion": {
                  "type": "string"
                },
                "build": {
                  "$ref": "#/$defs/BuildConfig"
                },
                "deploy": {
                  "$ref": "#/$defs/DeployConfig"
                },
                "kind": {
                  "type": "string"
                }
              },
              "x-intellij-html-description": "top level config object that is parsed from a skaffold.yaml"
            },
            {
              "patternProperties": {
                "^apiVersion$": true,
                "^build$": true,
                "^deploy$": true,
                "^kind$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "paths",
                "parameters"
              ],
              "properties": {
                "parameters": {
                  "$ref": "#/$defs/modern_10"
                },
                "paths": {
                  "default": "[]",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              }
            },
            {
              "patternProperties": {
                "^parameters$": true,
                "^paths$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Manifest": {
      "$ref": "#/$defs/modern_9"
    },
    "DeployConfig": {
      "anyOf": [
        {
          "$ref": "#/$defs/modern_11"
        },
        {
          "$ref": "#/$defs/modern_12"
        },
        {
          "$ref": "#/$defs/modern_13"
        }
      ],
      "description": "contains all the configuration needed by the deploy steps",
      "x-intellij-html-description": "contains all the configuration needed by the deploy steps"
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "name",
                "kubectl"
              ],
              "properties": {
                "kubectl": {
                  "$ref": "#/$defs/KubectlDeploy"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^kubectl$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": "{}",
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "BuildConfig": {
      "anyOf": [
        {
          "$ref": "#/$defs/modern_14"
        },
        {
          "$ref": "#/$defs/modern_15"
        },
        {
          "$ref": "#/$defs/modern_16"
        }
      ],
      "description": "contains all the configuration for the build steps",
      "x-intellij-html-description": "contains all the configuration for the build steps"
    }
  }
}
