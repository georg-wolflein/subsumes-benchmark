{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "patternProperties": {
    ".*": {
      "additionalProperties": false,
      "properties": {
        "unusedActions": {
          "$ref": "#/$defs/stringArray"
        },
        "unusedFormParameters": {
          "$ref": "#/$defs/stringArray"
        },
        "unusedQueryParameters": {
          "$ref": "#/$defs/stringArray"
        },
        "unusedRequestHeaders": {
          "$ref": "#/$defs/stringArray"
        },
        "unusedResources": {
          "$ref": "#/$defs/stringArray"
        },
        "unusedResponseCodes": {
          "$ref": "#/$defs/stringArray"
        },
        "unusedResponseHeaders": {
          "$ref": "#/$defs/stringArray"
        }
      },
      "required": [
        "unusedActions",
        "unusedResources",
        "unusedRequestHeaders",
        "unusedQueryParameters",
        "unusedFormParameters",
        "unusedResponseHeaders",
        "unusedResponseCodes"
      ],
      "type": "object"
    }
  },
  "type": "object",
  "$defs": {
    "stringArray": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  }
}
