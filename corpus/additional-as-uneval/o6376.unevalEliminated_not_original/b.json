{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/TestStruct"
    }
  ],
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "reqField"
              ],
              "properties": {
                "reqField": {
                  "description": "should be required",
                  "type": "string",
                  "x-intellij-html-description": "should be required"
                }
              }
            },
            {
              "patternProperties": {
                "^reqField$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "reqField",
                "field1"
              ],
              "properties": {
                "field1": {
                  "description": "should be the first choice",
                  "type": "string",
                  "x-intellij-html-description": "should be the first choice"
                },
                "reqField": {
                  "description": "should be required",
                  "type": "string",
                  "x-intellij-html-description": "should be required"
                }
              }
            },
            {
              "patternProperties": {
                "^field1$": true,
                "^reqField$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "TestStruct": {
      "anyOf": [
        {
          "$ref": "#/$defs/modern_1"
        },
        {
          "$ref": "#/$defs/modern_2"
        },
        {
          "$ref": "#/$defs/modern_3"
        }
      ],
      "description": "for testing the schema generator.",
      "required": [
        "reqField"
      ],
      "x-intellij-html-description": "for testing the schema generator."
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "preferredOrder": [
                "reqField",
                "field2"
              ],
              "properties": {
                "field2": {
                  "description": "should be the second choice",
                  "type": "string",
                  "x-intellij-html-description": "should be the second choice"
                },
                "reqField": {
                  "description": "should be required",
                  "type": "string",
                  "x-intellij-html-description": "should be required"
                }
              }
            },
            {
              "patternProperties": {
                "^field2$": true,
                "^reqField$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
