{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "x": {
                  "description": "Change the watermark position. In pixels",
                  "type": "number"
                },
                "size": {
                  "description": "Size of the watermark in the video result ([width]x[height])",
                  "pattern": "^[0-9]+x[0-9]+$",
                  "type": "string"
                },
                "y": {
                  "description": "Change the watermark position. In pixels",
                  "type": "number"
                },
                "input_bucket": {
                  "description": "Bucket name and path where the watermark is located",
                  "maxLength": 63,
                  "minLength": 3,
                  "pattern": "^[0-9a-zA-Z\\.\\-_]+$",
                  "type": "string"
                },
                "opacity": {
                  "description": "Change the default watermark opacity",
                  "type": "number"
                },
                "input_file": {
                  "description": "Filename of the file containing the watermark",
                  "maxLength": 1024,
                  "minLength": 1,
                  "pattern": "^[\\w /-]+\\.[0-9a-zA-Z]+$",
                  "type": "string"
                }
              },
              "required": [
                "input_bucket",
                "input_file"
              ],
              "title": "CT transcode specification for watermark",
              "type": "object"
            },
            {
              "patternProperties": {
                "^input_file$": true,
                "^input_bucket$": true,
                "^size$": true,
                "^y$": true,
                "^x$": true,
                "^opacity$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
