{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maxLength",
    "maximum",
    "minLength",
    "minimum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o63941.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Schemas for workflow section in main config file",
                "type": "object",
                "properties": {
                  "defaultTaskStartToCloseTimeout": {
                    "description": "Max time from start to close for a task",
                    "type": "integer",
                    "minimum": 1.0,
                    "maximum": 31536000.0
                  },
                  "name": {
                    "description": "Workflow name",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64
                  },
                  "description": {
                    "description": "Workflow description",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "domain": {
                    "description": "SWF domain",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64,
                    "pattern": "^[\\w\\.\\- ]+$"
                  },
                  "version": {
                    "description": "Workflow version",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[\\w\\.\\- ]+$"
                  },
                  "defaultExecutionStartToCloseTimeout": {
                    "description": "Max time from start to close for a workflow",
                    "type": "integer",
                    "minimum": 1.0,
                    "maximum": 31536000.0
                  },
                  "decisionTaskList": {
                    "description": "Workflow decision tasklist",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64,
                    "pattern": "^[\\w\\.\\- ]+$"
                  },
                  "defaultChildPolicy": {
                    "description": "How to terminated children if workflow is terminated",
                    "type": "string",
                    "enum": [
                      "TERMINATE",
                      "REQUEST_CANCEL",
                      "ABANDON"
                    ]
                  }
                },
                "required": [
                  "domain",
                  "decisionTaskList",
                  "name",
                  "version",
                  "description",
                  "defaultExecutionStartToCloseTimeout",
                  "defaultTaskStartToCloseTimeout",
                  "defaultChildPolicy"
                ]
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^description$": true,
                  "^defaultExecutionStartToCloseTimeout$": true,
                  "^defaultChildPolicy$": true,
                  "^domain$": true,
                  "^defaultTaskStartToCloseTimeout$": true,
                  "^decisionTaskList$": true,
                  "^name$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://sport-archive.com/input-schema/workflow",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Schemas for workflow section in main config file",
    "type": "object",
    "properties": {
      "domain": {
        "description": "SWF domain",
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[\\w\\.\\- ]+$"
      },
      "decisionTaskList": {
        "description": "Workflow decision tasklist",
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[\\w\\.\\- ]+$"
      },
      "name": {
        "description": "Workflow name",
        "type": "string",
        "minLength": 3,
        "maxLength": 64
      },
      "version": {
        "description": "Workflow version",
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[\\w\\.\\- ]+$"
      },
      "description": {
        "description": "Workflow description",
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "defaultExecutionStartToCloseTimeout": {
        "description": "Max time from start to close for a workflow",
        "type": "integer",
        "minimum": 1,
        "maximum": 31536000
      },
      "defaultTaskStartToCloseTimeout": {
        "description": "Max time from start to close for a task",
        "type": "integer",
        "minimum": 1,
        "maximum": 31536000
      },
      "defaultChildPolicy": {
        "description": "How to terminated children if workflow is terminated",
        "type": "string",
        "enum": [
          "TERMINATE",
          "REQUEST_CANCEL",
          "ABANDON"
        ]
      }
    },
    "required": [
      "domain",
      "decisionTaskList",
      "name",
      "version",
      "description",
      "defaultExecutionStartToCloseTimeout",
      "defaultTaskStartToCloseTimeout",
      "defaultChildPolicy"
    ],
    "additionalProperties": false
  }
}
