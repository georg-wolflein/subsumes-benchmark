{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "default": [],
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "channels": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "bundleName": {
                  "type": "string"
                },
                "defaultFile": {
                  "$ref": "#/$defs/cueFile"
                },
                "defaultVolume": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "assignable": {
                  "type": "boolean"
                },
                "file": {
                  "$ref": "#/$defs/cueFile"
                },
                "volume": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "volume",
                "file",
                "assignable"
              ]
            },
            {
              "patternProperties": {
                "^file$": true,
                "^channels$": true,
                "^assignable$": true,
                "^name$": true,
                "^volume$": true,
                "^bundleName$": true,
                "^defaultVolume$": true,
                "^defaultFile$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "cueFile": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "base": {
          "type": "string"
        },
        "default": {
          "type": "boolean"
        },
        "ext": {
          "type": "string"
        },
        "sum": {
          "type": "string"
        }
      }
    }
  }
}
