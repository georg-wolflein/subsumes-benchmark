{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "string": {
      "type": "string",
      "default": ""
    },
    "object": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "numA": {
                  "type": "number",
                  "default": 0
                },
                "numB": {
                  "type": "number",
                  "default": 0
                }
              },
              "required": [
                "numA"
              ]
            },
            {
              "patternProperties": {
                "^numA$": true,
                "^numB$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
