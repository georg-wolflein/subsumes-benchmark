{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "string": {
      "type": "string",
      "default": ""
    },
    "object": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "numA": {
                  "$ref": "#/$defs/numA"
                },
                "hasDeepRef": {
                  "$ref": "#/$defs/hasDeepRef"
                }
              }
            },
            {
              "patternProperties": {
                "^numA$": true,
                "^hasDeepRef$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "hasDeepRef": {
      "type": "object",
      "properties": {
        "numA": {
          "$ref": "#/$defs/numA"
        }
      }
    },
    "numA": {
      "type": "number",
      "default": 0
    }
  }
}
