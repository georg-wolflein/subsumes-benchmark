{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "name": {
                  "type": "string"
                },
                "parentGroupName": {
                  "type": "string"
                },
                "y": {
                  "type": "number"
                },
                "cx": {
                  "type": "number"
                },
                "source_cx": {
                  "type": "number"
                },
                "locked": {
                  "type": "boolean"
                },
                "cy": {
                  "type": "number"
                },
                "id": {
                  "type": "number"
                },
                "groupChildren": {
                  "type": "array",
                  "items": true
                },
                "source_cy": {
                  "type": "number"
                },
                "volume": {
                  "type": "number"
                },
                "type": {
                  "type": "string"
                },
                "render": {
                  "type": "boolean"
                }
              },
              "required": [
                "cx",
                "cy",
                "id",
                "locked",
                "name",
                "render",
                "source_cx",
                "source_cy",
                "type",
                "volume",
                "x",
                "y"
              ]
            },
            {
              "patternProperties": {
                "^x$": true,
                "^cx$": true,
                "^source_cx$": true,
                "^name$": true,
                "^id$": true,
                "^volume$": true,
                "^cy$": true,
                "^render$": true,
                "^locked$": true,
                "^y$": true,
                "^parentGroupName$": true,
                "^type$": true,
                "^groupChildren$": true,
                "^source_cy$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
