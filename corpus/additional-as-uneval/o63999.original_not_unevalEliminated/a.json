{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Login information for OBS Websocket, used to communicate with and remotely control OBS Studio.",
              "properties": {
                "ip": {
                  "type": "string",
                  "default": "localhost"
                },
                "port": {
                  "type": "number",
                  "default": 4444
                },
                "password": {
                  "type": "string",
                  "default": ""
                },
                "status": {
                  "$ref": "#/$defs/Status"
                }
              },
              "required": [
                "ip",
                "port",
                "password",
                "status"
              ]
            },
            {
              "patternProperties": {
                "^ip$": true,
                "^port$": true,
                "^password$": true,
                "^status$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Status": {
      "type": "string",
      "enum": [
        "connected",
        "connecting",
        "disconnected",
        "error"
      ],
      "default": "disconnected"
    }
  }
}
