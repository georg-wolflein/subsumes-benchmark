                    "type": "integer"
                  },
                  "rx": {
                    "type": "integer"
                  },
                  "rxerrs": {
                    "type": "integer"
                  },
                  "rxbytes": {
                    "type": "integer"
                  },
                  "req_timeouts": {
                    "type": "integer"
                  },
                  "rxcorriderrs": {
                    "type": "integer"
                  },
                  "txretries": {
                    "type": "integer"
                  },
                  "stateage": {
                    "type": "integer"
                  },
                  "rtt": {
