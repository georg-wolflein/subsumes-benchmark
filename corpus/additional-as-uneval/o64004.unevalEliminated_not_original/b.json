                    "type": "integer"
                  },
                  "nodeid": {
                    "type": "integer"
                  },
                  "txerrs": {
                    "type": "integer"
                  },
                  "wakeups": {
                    "type": "integer"
                  },
                  "throttle": {
                    "$ref": "#/$defs/window"
                  },
                  "toppars": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "tx": {
                    "type": "integer"
                  },
                  "rxpartial": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "nodeid",
                  "state",
                  "stateage",
                  "outbuf_cnt",
                  "outbuf_msg_cnt",
                  "waitresp_cnt",
                  "waitresp_msg_cnt",
                  "tx",
                  "txbytes",
                  "txerrs",
                  "txretries",
                  "req_timeouts",
                  "rx",
                  "rxbytes",
                  "rxerrs",
                  "rxcorriderrs",
                  "rxpartial",
                  "zbuf_grow",
                  "buf_grow",
                  "wakeups",
                  "int_latency",
                  "rtt",
                  "throttle",
                  "toppars"
                ],
                "title": "Broker object keyed by the broker \"name:port/id\"",
                "type": "object"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "properties": {
                  "partition": {
                    "type": "integer"
                  },
                  "topic": {
                    "type": "string"
                  }
                },
                "required": [
                  "topic",
                  "partition"
                ],
                "type": "object"
              }
            }
          ]
        }
      ]
