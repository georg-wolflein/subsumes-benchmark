    "window": {
      "description": "The values are in microseconds unless otherwise stated.",
      "properties": {
        "properties": {
          "avg": {
            "type": "integer"
          },
          "cnt": {
            "type": "integer"
          },
          "hdrsize": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "min": {
            "type": "integer"
          },
          "outofrange": {
            "type": "integer"
          },
          "p50": {
            "type": "integer"
          },
          "p75": {
            "type": "integer"
          },
          "p90": {
            "type": "integer"
          },
          "p95": {
            "type": "integer"
          },
          "p99": {
            "type": "integer"
          },
          "p99_99": {
            "type": "integer"
          },
          "stddev": {
            "type": "integer"
          },
          "sum": {
            "type": "integer"
          }
        }
      },
      "title": "Rolling window statistics",
      "type": "object"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
