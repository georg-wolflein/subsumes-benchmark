{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the metadata property"
    },
    "value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        }
      ]
    },
    "immutable": {
      "type": "boolean",
      "default": false,
      "description": "If true, you are unable to alter this value"
    }
  },
  "required": [
    "name",
    "value"
  ]
}
