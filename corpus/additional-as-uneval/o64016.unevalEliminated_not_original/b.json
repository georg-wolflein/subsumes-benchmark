{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the metadata property"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "integer"
                    }
                  ]
                },
                "immutable": {
                  "type": "boolean",
                  "default": false,
                  "description": "If true, you are unable to alter this value"
                }
              },
              "required": [
                "name",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^value$": true,
                "^immutable$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
