{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "rel": {
                  "type": "string",
                  "default": "related"
                },
                "title": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "type": {
                  "type": "string",
                  "default": "text/html"
                },
                "href": {
                  "type": "string",
                  "format": "uri"
                },
                "hreflang": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^rel$": true,
                "^hreflang$": true,
                "^type$": true,
                "^title$": true,
                "^href$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "location": {
                  "type": "string"
                },
                "roles": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "enum": [
                      "publisher",
                      "originator",
                      "owner",
                      "resourceProvider",
                      "funder"
                    ]
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^name$": true,
                "^location$": true,
                "^roles$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Publication data model",
              "description": "A publication reference",
              "type": "object",
              "required": [
                "title",
                "schema",
                "collection",
                "publication_type"
              ],
              "properties": {
                "locations": {
                  "$ref": "#/$defs/modern_2"
                },
                "collection": {
                  "enum": [
                    "publication"
                  ]
                },
                "state": {
                  "enum": [
                    "submitted",
                    "accepted",
                    "published"
                  ],
                  "default": "published"
                },
                "pages": {
                  "$ref": "#/$defs/modern_4"
                },
                "draft": {
                  "enum": [
                    "yes",
                    "no"
                  ],
                  "default": "no"
                },
                "links": {
                  "$ref": "#/$defs/modern_5"
                },
                "printed": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "/^[0-9]{4}/"
                },
                "overview": {
                  "_uniqueItems": true,
                  "type": "array",
                  "description": "Summary for non-scientists. Markdown accepted",
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  }
                },
                "conference": {
                  "$ref": "#/$defs/modern_8"
                },
                "organisations": {
                  "$ref": "#/$defs/modern_9"
                },
                "volume": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "subtitle": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "created_by": {
                  "type": "string"
                },
                "people": {
                  "$ref": "#/$defs/modern_11"
                },
                "topics": {
                  "$ref": "#/$defs/modern_15"
                },
                "publication_type": {
                  "enum": [
                    "peer-reviewed",
                    "editorial",
                    "review",
                    "correction",
                    "book",
                    "in-book",
                    "poster",
                    "report",
                    "in-report",
                    "abstract",
                    "phd",
                    "master",
                    "map",
                    "proceedings",
                    "popular",
                    "other"
                  ]
                },
                "updated_by": {
                  "type": "string"
                },
                "art_no": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "_id": {
                  "type": "string"
                },
                "_attachments": {
                  "type": "object"
                },
                "tags": {
                  "$ref": "#/$defs/modern_16"
                },
                "journal": {
                  "$ref": "#/$defs/modern_17"
                },
                "published": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "/^[0-9]{4}/"
                },
                "page_count": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "abstract": {
                  "_uniqueItems": true,
                  "type": "array",
                  "description": "Scientific abstract. Markdown accepted.",
                  "items": {
                    "$ref": "#/$defs/modern_18"
                  }
                },
                "suppl": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "research_stations": {
                  "$ref": "#/$defs/modern_19"
                },
                "files": {
                  "type": "array",
                  "_uniqueItems": true,
                  "description": "",
                  "items": {
                    "type": "object",
                    "properties": {
                      "uri": {
                        "type": "string",
                        "description": "URI of the attached file",
                        "format": "uri"
                      },
                      "hash": {
                        "type": "string",
                        "description": ""
                      },
                      "filename": {
                        "type": "string",
                        "description": "File name"
                      },
                      "length": {
                        "type": "integer",
                        "description": "File size in bytes"
                      },
                      "title": {
                        "type": "string",
                        "description": "Title"
                      },
                      "type": {
                        "type": "string",
                        "description": "Media type (e.g. image/png)"
                      }
                    }
                  }
                },
                "programme": {
                  "$ref": "#/$defs/modern_20"
                },
                "issue": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "license": {
                  "description": "License of the publication",
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    null,
                    "https://creativecommons.org/licenses/by/4.0/",
                    "https://creativecommons.org/licenses/by-nc-sa/4.0/",
                    "https://creativecommons.org/licenses/by-nc-nd/4.0/",
                    "https://creativecommons.org/publicdomain/zero/1.0/"
                  ]
                },
                "publication_lang": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "default": "en"
                },
                "id": {
                  "description": "Identifier (UUID | URI)",
                  "type": "string"
                },
                "schema": {
                  "type": "string",
                  "pattern": "^http(s)?://"
                },
                "updated": {
                  "description": "Document was updated",
                  "type": "string",
                  "format": "date-time"
                },
                "comment": {
                  "description": "Markdown accepted",
                  "type": "string"
                },
                "isbn": {
                  "$ref": "#/$defs/modern_21"
                },
                "title": {
                  "description": "Title - exactly as published in the original language. Markdown accepted.",
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "peer-reviewed",
                    "editorial",
                    "review",
                    "correction",
                    "book",
                    "in-book",
                    "poster",
                    "report",
                    "in-report",
                    "abstract",
                    "phd",
                    "master",
                    "map",
                    "proceedings",
                    "popular",
                    "other"
                  ]
                },
                "doi": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^10\\.[0-9]{2,}/.+$"
                },
                "_rev": {
                  "type": "string"
                },
                "issn": {
                  "$ref": "#/$defs/modern_22"
                },
                "created": {
                  "description": "Document was published",
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            {
              "patternProperties": {
                "^collection$": true,
                "^updated$": true,
                "^suppl$": true,
                "^conference$": true,
                "^doi$": true,
                "^organisations$": true,
                "^page_count$": true,
                "^created$": true,
                "^journal$": true,
                "^printed$": true,
                "^locations$": true,
                "^_rev$": true,
                "^schema$": true,
                "^files$": true,
                "^research_stations$": true,
                "^overview$": true,
                "^isbn$": true,
                "^published$": true,
                "^topics$": true,
                "^state$": true,
                "^publication_lang$": true,
                "^publication_type$": true,
                "^links$": true,
                "^updated_by$": true,
                "^pages$": true,
                "^_id$": true,
                "^type$": true,
                "^draft$": true,
                "^issn$": true,
                "^id$": true,
                "^comment$": true,
                "^abstract$": true,
                "^_attachments$": true,
                "^issue$": true,
                "^volume$": true,
                "^people$": true,
                "^subtitle$": true,
                "^title$": true,
                "^programme$": true,
                "^license$": true,
                "^tags$": true,
                "^created_by$": true,
                "^art_no$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "@language": {
                  "type": "string",
                  "default": "en"
                },
                "@value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^@language$": true,
                "^@value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_20": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Programmes",
              "description": "Select programmes affiliated with the publication",
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "Fram Strait",
                  "Biodiversity",
                  "Environmental management",
                  "Environmental pollutants",
                  "Geology and geophysics",
                  "Oceans and sea ice",
                  "Arctic ocean",
                  "Svalbard",
                  "Antarctic",
                  "Ny-\u00c5lesund"
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "homepage": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "first_name": {
                  "type": "string"
                },
                "organisation": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "email": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "affiliation": {
                  "$ref": "#/$defs/modern_13"
                },
                "last_name": {
                  "type": "string"
                },
                "roles": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "author",
                      "editor",
                      "co-author",
                      "translator",
                      "advisor",
                      "correspondent"
                    ]
                  },
                  "default": [
                    "author"
                  ],
                  "minItems": 1,
                  "maxItems": 6,
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^roles$": true,
                "^organisation$": true,
                "^homepage$": true,
                "^last_name$": true,
                "^affiliation$": true,
                "^email$": true,
                "^first_name$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Conference",
              "description": "For abstracts and proceedings",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "dates": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time"
                  }
                },
                "place": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^dates$": true,
                "^name$": true,
                "^place$": true,
                "^id$": true,
                "^country$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Organisations involved",
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "$ref": "#/$defs/modern_10"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "placename": {
                  "type": "string"
                },
                "area": {
                  "type": "string"
                },
                "country": {
                  "description": "[Country code](http://en.wikipedia.org/wiki/ISO_3166-1_alpha-2), use 'NO' for Norway, including Svalbard and Jan Mayen, Bouvet\u00f8ya, and Peter I \u00d8y. 'AQ' = Antarctica and 'XZ' = International waters",
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^(([A-Z]|[a-z]){2})$"
                },
                "hemisphere": {
                  "description": "Hemisphere: N or S",
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[NSns]{1}$"
                }
              }
            },
            {
              "patternProperties": {
                "^placename$": true,
                "^area$": true,
                "^country$": true,
                "^hemisphere$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_22": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "People involved in creating the publication",
              "type": "array",
              "_uniqueItems": true,
              "required": [
                "first_name",
                "last_name",
                "roles"
              ],
              "items": {
                "$ref": "#/$defs/modern_12"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "@id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "name": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^@id$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_21": {
      "anyOf": [
        {
          "allOf": [
            {
              "_uniqueItems": true,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "$ref": "#/$defs/modern_6"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "NPI topics",
              "description": "See https://github.com/npolar/api.npolar.no/blob/master/schema/dataset.json",
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "acidification",
                  "atmosphere",
                  "biology",
                  "biogeochemistry",
                  "chemistry",
                  "climate",
                  "conservation",
                  "ecology",
                  "ecotoxicology",
                  "environment",
                  "geophysics",
                  "geology",
                  "glaciology",
                  "history",
                  "human-dimension",
                  "management",
                  "marine",
                  "modelling",
                  "maps",
                  "oceanography",
                  "other",
                  "paleoclimate",
                  "remote-sensing",
                  "seaice",
                  "snow",
                  "terrestrial",
                  "topography",
                  "vegetation"
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Journal",
              "description": "Peer-reviewed journal",
              "type": "object",
              "properties": {
                "series": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "np_series": {
                  "type": "string"
                },
                "series_no": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^series_no$": true,
                "^name$": true,
                "^id$": true,
                "^np_series$": true,
                "^series$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "$ref": "#/$defs/modern_3"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_18": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "@language": {
                  "type": "string",
                  "default": "en"
                },
                "@value": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^@language$": true,
                "^@value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Affilated organisations ",
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "$ref": "#/$defs/modern_14"
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_19": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "NP research stations",
              "description": "NPs research stations",
              "type": "array",
              "_uniqueItems": true,
              "items": {
                "type": "string",
                "enum": [
                  "Troll",
                  "Ny-\u00c5lesund",
                  "Sverdrupstasjonen",
                  "Zeppelin",
                  "Bouvet\u00f8ya",
                  "Svarthamaren"
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Publication pages",
              "description": "Either to and from page or the total no of pages",
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
