{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Schema for Oceanography measurement point documents",
              "properties": {
                "sea_floor_depth_below_sea_surface": {
                  "description": "Sea depth",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "sea_water_temperature": {
                  "description": "Temperature in degrees Celsius ITS-90",
                  "maximum": 50.0,
                  "minimum": -5.0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "sea_water_salinity": {
                  "description": "Salinity in particle salinity units (PSU) PPS-78",
                  "maximum": 45.0,
                  "minimum": 0.0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "instrument_type": {
                  "description": "Instrument type",
                  "type": "string"
                },
                "direction_of_sea_water_velocity": {
                  "description": "Degrees from north",
                  "maximum": 360.0,
                  "minimum": 0.0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "id": {
                  "description": "UUID of this doc",
                  "type": "string"
                },
                "schema": {
                  "_format": "uri",
                  "description": "Oceanography json schema uri",
                  "type": "string"
                },
                "northward_sea_water_velocity": {
                  "description": "Northward sea water velocity in m/s",
                  "maximum": 10.0,
                  "minimum": -10.0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "sea_water_pressure": {
                  "description": "Pressure in decibar",
                  "maximum": 5000.0,
                  "minimum": 0.0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "measured": {
                  "_format": "date-time",
                  "description": "Date and time of measurement serie",
                  "type": "string"
                },
                "platform": {
                  "description": "Platform from which the instrument was deployed. Example: RV Lance, sea-ice",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "collection": {
                  "description": "Collection type",
                  "enum": [
                    "cast",
                    "mooring"
                  ],
                  "type": "string"
                },
                "latitude": {
                  "description": "Location latitude in WGS-84",
                  "maximum": 90.0,
                  "minimum": -90.0,
                  "type": "number"
                },
                "cruise": {
                  "description": "Cruise identifier",
                  "type": "string"
                },
                "eastward_sea_water_velocity": {
                  "description": "Eastward sea water velocity in m/s",
                  "maximum": 10.0,
                  "minimum": -10.0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "mooring": {
                  "description": "Mooring id",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "tilt": {
                  "description": "Instrument tilt in degrees",
                  "maximum": 360.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "longitude": {
                  "description": "Location longitude in WGS-84",
                  "maximum": 180.0,
                  "minimum": -180.0,
                  "type": "number"
                },
                "sea_water_electrical_conductivity": {
                  "description": "Conductivity in Siemens per meter (S/m)",
                  "maximum": 10.0,
                  "minimum": 0.0,
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "original_station": {
                  "description": "Station identifier",
                  "type": "string"
                },
                "serial_number": {
                  "description": "Instrument serial number",
                  "type": "string"
                },
                "depth": {
                  "description": "Measurement depth",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "station": {
                  "description": "Station identifier",
                  "type": "string"
                },
                "comments": {
                  "description": "Comments",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "collection",
                "longitude",
                "latitude",
                "id",
                "measured",
                "schema"
              ],
              "title": "Oceanography measurement point Schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^sea_water_pressure$": true,
                "^longitude$": true,
                "^cruise$": true,
                "^latitude$": true,
                "^mooring$": true,
                "^platform$": true,
                "^sea_water_temperature$": true,
                "^tilt$": true,
                "^id$": true,
                "^comments$": true,
                "^serial_number$": true,
                "^instrument_type$": true,
                "^measured$": true,
                "^sea_floor_depth_below_sea_surface$": true,
                "^original_station$": true,
                "^station$": true,
                "^northward_sea_water_velocity$": true,
                "^collection$": true,
                "^direction_of_sea_water_velocity$": true,
                "^depth$": true,
                "^sea_water_electrical_conductivity$": true,
                "^eastward_sea_water_velocity$": true,
                "^sea_water_salinity$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
