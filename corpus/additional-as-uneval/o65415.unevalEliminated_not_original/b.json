{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_8",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An entity which is a distinct organisation, but is not a company nor an individual. Examples include governments and governmental entities (e.g. Multilateral Development Banks, Government Departments, municipalities, etc), and also membership organisations",
              "type": "object",
              "properties": {
                "jurisdiction": {
                  "type": "string",
                  "description": "Name of the jurisdiction in which the entity is incorporated/domiciled (use global for global entities, e.g. UN)"
                },
                "website": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 5
                    },
                    {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string",
                        "minLength": 5
                      }
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "Name of the entity",
                  "minLength": 1
                },
                "headquarters_address": {
                  "$ref": "#/$defs/address"
                },
                "alternative_names": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/alternative-name"
                  }
                },
                "mailing_address": {
                  "$ref": "#/$defs/address"
                },
                "legal_form": {
                  "type": "string",
                  "description": "legal form of organisation, e.g. municipality, government department, trust, etc"
                },
                "registered_address": {
                  "$ref": "#/$defs/address"
                },
                "identifiers": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "$ref": "#/$defs/identifier"
                  }
                },
                "fax_number": {
                  "type": "string",
                  "minLength": 4
                },
                "telephone_number": {
                  "type": "string",
                  "minLength": 4
                },
                "other_attributes": {
                  "description": "Use for other attributes for which we don't yet have curated schema attributes",
                  "type": "object"
                },
                "industry_codes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/industry-code"
                  }
                },
                "previous_names": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/previous-name"
                  }
                },
                "addresses": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/address-with-type"
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^headquarters_address$": true,
                "^legal_form$": true,
                "^alternative_names$": true,
                "^industry_codes$": true,
                "^fax_number$": true,
                "^name$": true,
                "^website$": true,
                "^identifiers$": true,
                "^registered_address$": true,
                "^addresses$": true,
                "^mailing_address$": true,
                "^other_attributes$": true,
                "^previous_names$": true,
                "^jurisdiction$": true,
                "^telephone_number$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "identifier": {
      "description": "An identifier for an entity (possibly other things, e.g. securities in the future). Examples are tax IDs, non-profit IDs, SEC CIK numbers, Federal Reserve RSSD id. The main requirements for an identifier is that they should be well-defined, and issued by a government or have statutory standing",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The unique identifier given by the identifier system \u2013 it should be unique in the context of the identifier_system",
          "minLength": 1
        },
        "identifier_system_code": {
          "type": "string",
          "description": "An identifier representing the identifier scheme. Some examples of this are us_fein (US Federal tax number), us_sec_cik (US Securities and Exchange Commission CIK), uk_ew_cc (Charity Commission of England & Wales), lei (Global Legal Entity Identifier System)"
        }
      },
      "required": [
        "uid",
        "identifier_system_code"
      ]
    },
    "filing": {
      "description": "A statutory filing",
      "type": "object",
      "properties": {
        "description": {
          "type": "string"
        },
        "other_attributes": {
          "type": "object"
        },
        "uid": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "filing_type_name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "_format": "date"
        },
        "filing_type_code": {
          "type": "string"
        }
      },
      "required": [
        "date"
      ],
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "filing_type_name"
          ]
        }
      ]
    },
    "industry-code": {
      "description": "An industry code from a standard code list (e.g. NAICS 2007 or NACE 2). This schema is a sub-schema of Classification.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "start_date": {
          "type": "string",
          "_format": "date"
        },
        "code_scheme_id": {
          "type": "string",
          "description": "An identifier representing industry code scheme. At the moment these are eu_nace_2, uk_sic_2003, uk_sic_2007, us_naics_2002, us_naics_2007, be_nace_2008, dk_db_2007, nz_bic_2006, no_sic_2007, anz_sic_2006, nz_bic_2006, in_nic_2004_mca, ca_qc_cae, lu_nace_2. For other code schemes, or details of these, contact info@opencorporates.com"
        },
        "code": {
          "type": "string"
        },
        "end_date": {
          "type": "string",
          "_format": "date"
        }
      },
      "required": [
        "code",
        "code_scheme_id"
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A person, for example, referenced in some other context, e.g. director of a company, shareholder, licence-holder, lobbyist. This should be used only if the person is the subject of the datum",
              "type": "object",
              "properties": {
                "jurisdiction": {
                  "type": "string",
                  "description": "Name of the jurisdiction in which the entity is based"
                },
                "website": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 5
                    },
                    {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string",
                        "minLength": 5
                      }
                    }
                  ]
                },
                "name": {
                  "$ref": "#/$defs/person-name"
                },
                "headquarters_address": {
                  "$ref": "#/$defs/address"
                },
                "alternative_names": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/alternative-name"
                  }
                },
                "mailing_address": {
                  "$ref": "#/$defs/address"
                },
                "registered_address": {
                  "description": "address for service (or address given in the context of legal requirement)",
                  "$ref": "#/$defs/address"
                },
                "identifiers": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "$ref": "#/$defs/identifier"
                  }
                },
                "telephone_number": {
                  "type": "string",
                  "minLength": 4
                },
                "nationality": {
                  "description": "The person's nationality",
                  "type": "string",
                  "_format": "non-blank"
                },
                "country_of_residence": {
                  "description": "The normal country of residence for the person",
                  "type": "string",
                  "_format": "non-blank"
                },
                "uid": {
                  "description": "Unique id of the person. Note: the unique id is not expected to be globally unique, but only unique with reference to the source from which it is derived. No check is made for uniqueness",
                  "type": "string",
                  "minLength": 1
                },
                "industry_codes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/industry-code"
                  }
                },
                "addresses": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/address-with-type"
                  }
                },
                "company": {
                  "description": "Company the person is representing. NB If the licence holder is a company, and the individual is a just a contact, then use the company-schema for the entity. This is where the individual themselves are the subject entity (e.g. licence holder, disqualified director)",
                  "$ref": "#/$defs/company-for-nesting"
                },
                "relationship_with_company": {
                  "enum": [
                    "employee",
                    "director",
                    "shareholder",
                    null
                  ]
                },
                "fax_number": {
                  "type": "string",
                  "minLength": 4
                },
                "other_attributes": {
                  "description": "Use for other attributes for which we don't yet have curated schema attributes",
                  "type": "object"
                },
                "date_of_birth": {
                  "anyOf": [
                    {
                      "type": "string",
                      "_format": "date"
                    },
                    {
                      "$ref": "#/$defs/date"
                    }
                  ]
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^nationality$": true,
                "^other_attributes$": true,
                "^relationship_with_company$": true,
                "^alternative_names$": true,
                "^industry_codes$": true,
                "^fax_number$": true,
                "^name$": true,
                "^country_of_residence$": true,
                "^uid$": true,
                "^identifiers$": true,
                "^registered_address$": true,
                "^addresses$": true,
                "^mailing_address$": true,
                "^jurisdiction$": true,
                "^telephone_number$": true,
                "^date_of_birth$": true,
                "^headquarters_address$": true,
                "^website$": true,
                "^company$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "address-with-type": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A representation of multiple registrations for the same entity",
              "type": "object",
              "properties": {
                "source_url": {
                  "description": "URL of the source of the data (e.g. download URL), or if there is not persistent URL the page from which it can be found (e.g. search page)",
                  "type": "string"
                },
                "start_date": {
                  "description": "date when alternate registration was valid from",
                  "type": "string",
                  "_format": "date"
                },
                "alternate_registration_start_date": {
                  "description": "date when alternate registration started",
                  "type": "string",
                  "_format": "date"
                },
                "sample_date": {
                  "description": "date when alternate registration was sampled",
                  "type": "string",
                  "_format": "date"
                },
                "confidence": {
                  "description": "Confidence in accuracy of data",
                  "enum": [
                    "HIGH",
                    "MEDIUM",
                    "LOW"
                  ]
                },
                "alternate_registration_end_date": {
                  "description": "date when alternate registration ended",
                  "type": "string",
                  "_format": "date"
                },
                "publication_date": {
                  "description": "the publication date of the filing/notice that gives details of the alternate registration",
                  "type": "string",
                  "_format": "date"
                },
                "start_date_type": {
                  "enum": [
                    "at",
                    "before",
                    "after"
                  ]
                },
                "alternate_entities": {
                  "description": "array of entities that are linked via alternate registrations",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/entity",
                    "minLength": 2
                  }
                },
                "retrieved_at": {
                  "description": "date when alternate registration was retrieved",
                  "type": "string",
                  "_format": "date"
                },
                "data_type": {
                  "enum": [
                    "alternate-registration"
                  ]
                }
              },
              "required": [
                "data_type",
                "alternate_entities",
                "retrieved_at",
                "confidence"
              ],
              "anyOf": [
                {
                  "required": [
                    "start_date"
                  ]
                },
                {
                  "required": [
                    "sample_date"
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^publication_date$": true,
                "^confidence$": true,
                "^alternate_entities$": true,
                "^alternate_registration_end_date$": true,
                "^start_date$": true,
                "^alternate_registration_start_date$": true,
                "^data_type$": true,
                "^source_url$": true,
                "^start_date_type$": true,
                "^sample_date$": true,
                "^retrieved_at$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "previous-name": {
      "name": "PreviousName",
      "description": "A previous name of a company",
      "type": "object",
      "properties": {
        "company_name": {
          "type": "string",
          "minLength": 1
        },
        "con_date": {
          "type": "string",
          "_format": "date",
          "description": "The end (conversion) date of the name"
        },
        "start_date": {
          "type": "string",
          "_format": "date"
        }
      },
      "required": [
        "company_name"
      ]
    },
    "unknown-entity-type": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An entity of unknown type - potentially a company, a person, government entity, or some unincorporated organisation",
              "type": "object",
              "properties": {
                "jurisdiction": {
                  "type": "string",
                  "description": "Name of the jurisdiction in which the entity is incorporated/domiciled"
                },
                "website": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 5
                    },
                    {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string",
                        "minLength": 5
                      }
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "Name of the entity",
                  "minLength": 1
                },
                "headquarters_address": {
                  "$ref": "#/$defs/address"
                },
                "alternative_names": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/alternative-name"
                  }
                },
                "mailing_address": {
                  "$ref": "#/$defs/address"
                },
                "registered_address": {
                  "$ref": "#/$defs/address"
                },
                "identifiers": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "$ref": "#/$defs/identifier"
                  }
                },
                "fax_number": {
                  "type": "string",
                  "minLength": 4
                },
                "telephone_number": {
                  "type": "string",
                  "minLength": 4
                },
                "other_attributes": {
                  "description": "Use for other attributes for which we don't yet have curated schema attributes",
                  "type": "object"
                },
                "uid": {
                  "description": "Unique id for the entity if it has one",
                  "type": "string"
                },
                "industry_codes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/industry-code"
                  }
                },
                "previous_names": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/previous-name"
                  }
                },
                "addresses": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/address-with-type"
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^headquarters_address$": true,
                "^alternative_names$": true,
                "^industry_codes$": true,
                "^fax_number$": true,
                "^name$": true,
                "^website$": true,
                "^uid$": true,
                "^identifiers$": true,
                "^registered_address$": true,
                "^addresses$": true,
                "^mailing_address$": true,
                "^other_attributes$": true,
                "^previous_names$": true,
                "^jurisdiction$": true,
                "^telephone_number$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "person-name": {
      "oneOf": [
        {
          "type": [
            "string",
            "null"
          ],
          "_format": "non-blank"
        },
        {
          "description": "The name of a person as an object",
          "type": "object",
          "properties": {
            "first_name": {
              "type": [
                "string",
                "null"
              ],
              "_format": "non-blank"
            },
            "family_name": {
              "type": [
                "string",
                "null"
              ],
              "_format": "non-blank",
              "description": "The family name (often last name) of a person, as opposed to their family name. Following FOAF practice, this is preferred to last_name"
            },
            "last_name": {
              "type": [
                "string",
                "null"
              ],
              "_format": "non-blank"
            },
            "middle_name": {
              "type": [
                "string",
                "null"
              ],
              "_format": "non-blank"
            },
            "suffixes": {
              "type": [
                "string",
                "null"
              ],
              "_format": "non-blank",
              "description": "Any suffixes, including degrees, honours (OBE), ordinals (John Smith Jr, Bill Jones II) etc"
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "_format": "non-blank",
              "description": "Title such as Mr, Ms, Dr etc"
            },
            "given_name": {
              "type": [
                "string",
                "null"
              ],
              "_format": "non-blank",
              "description": "The given name(s) (often first name) of a person, as opposed to their family name. Following FOAF practice, this is preferred to first_name"
            }
          }
        }
      ]
    },
    "officer": {
      "description": "An officer (director, senior executive) of a company",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^[\\.\\,\\*\\\\\\-\\s\\{\\}\\(\\)]+$"
          }
        },
        "start_date": {
          "anyOf": [
            {
              "type": "string",
              "_format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_attributes": {
          "type": "object",
          "properties": {
            "date_of_birth": {
              "type": "string",
              "_format": "date"
            },
            "address": {
              "$ref": "#/$defs/address"
            },
            "type": {
              "type": "string",
              "enum": [
                "Person",
                "Company"
              ],
              "description": "The type of entity that is the officer (either 'Person' or 'Company')"
            },
            "person_uid": {
              "type": "string",
              "description": "a unique identifier given to the individual (as opposed to the officership)"
            },
            "nationality": {
              "type": "string"
            }
          }
        },
        "end_date": {
          "anyOf": [
            {
              "type": "string",
              "_format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "uid": {
          "type": "string",
          "description": "a unique identifier given to the officership"
        },
        "position": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "organisation": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A parsed date object. This allows us to represent not just normal dates, but also partial dates too",
              "type": "object",
              "properties": {
                "year": {
                  "type": "number",
                  "description": "year part as YYYY"
                },
                "month": {
                  "type": "number",
                  "description": "month part of date in numbers e.g. 11 for November, 4 for April"
                },
                "day": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "day part of date in numbers"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "year",
                    "month"
                  ]
                },
                {
                  "required": [
                    "month",
                    "day"
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^year$": true,
                "^month$": true,
                "^day$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A company in OpenCorporates",
              "type": "object",
              "properties": {
                "website": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 5
                    },
                    {
                      "type": [
                        "array",
                        "null"
                      ],
                      "items": {
                        "type": "string",
                        "minLength": 5
                      }
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "description": "Legal name of the company",
                  "minLength": 1
                },
                "officers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/officer"
                  }
                },
                "headquarters_address": {
                  "$ref": "#/$defs/address"
                },
                "mailing_address": {
                  "$ref": "#/$defs/address"
                },
                "branch": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "A flag to denote whether a company is a branch entity. This should only be set if the company is a type of branch (otherwise should be null). In general the only option here is 'F' for a 'Foreign' branch, i.e. an out-of-jurisdiction entity that has registered as having a presence in the jurisdiction. In the US this is sometimes called a Foreign Corporation",
                  "enum": [
                    "F",
                    "L",
                    null
                  ]
                },
                "registered_address": {
                  "$ref": "#/$defs/address"
                },
                "share_parcels": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/share-parcel"
                  }
                },
                "total_shares": {
                  "$ref": "#/$defs/total-shares"
                },
                "dissolution_date": {
                  "type": "string",
                  "_format": "date"
                },
                "industry_codes": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/industry-code"
                  }
                },
                "company_number": {
                  "type": "string",
                  "description": "unique identifier given by the corporate register with which it is incorporated",
                  "minLength": 1
                },
                "addresses": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/address-with-type"
                  }
                },
                "company_type": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "jurisdiction": {
                  "type": "string",
                  "description": "A free text field for the jurisdiction where the company is registered \u2013 this can be either the ISO 3166-2 code, the underscored version, or the standard name for the jurisdiction, e.g. France"
                },
                "jurisdiction_code": {
                  "type": "string",
                  "description": "Code representing the jurisdiction/company register which is the canonical record of the company\u2019s existence. Uses underscored ISO 3166-2 to represent it, e.g. es for Spain, us_de for Delaware",
                  "minLength": 2,
                  "maxLength": 5
                },
                "alternative_names": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/alternative-name"
                  }
                },
                "filings": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/filing"
                  }
                },
                "identifiers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/identifier"
                  }
                },
                "all_attributes": {
                  "type": "object",
                  "description": "Other arbitrary attributes for a given company",
                  "properties": {
                    "home_legal_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The legal name of the 'home' company in its jurisdiction if this is a branch, and the name is different from the legal name of the branch",
                      "minLength": 1
                    },
                    "jurisdiction_of_origin": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The jurisdiction of the 'home' company if this is a branch",
                      "minLength": 1
                    },
                    "number_of_employees": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "number",
                          "minimum": 0.0
                        }
                      ],
                      "description": "The number of employees"
                    },
                    "registered_agent_address": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The address of the 'Agent', a public address to which legal papers can be served",
                      "minLength": 1
                    },
                    "home_company_number": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "If the entity is a 'branch', this is the company_number of the 'home' company in the home company's jurisdiction",
                      "minLength": 1
                    },
                    "merged_into": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "registered_agent_name": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "The 'Agent' of the company \u2013 a person or entity that is empowered to accept service for the company",
                      "minLength": 1
                    }
                  }
                },
                "incorporation_date": {
                  "type": "string",
                  "_format": "date"
                },
                "registry_url": {
                  "type": "string"
                },
                "fax_number": {
                  "type": "string",
                  "minLength": 4
                },
                "retrieved_at": {
                  "type": "string",
                  "_format": "date"
                },
                "telephone_number": {
                  "type": "string",
                  "minLength": 4
                },
                "previous_names": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/previous-name"
                  }
                },
                "current_status": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "anyOf": [
                {
                  "required": [
                    "name"
                  ]
                },
                {
                  "required": [
                    "company_number"
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^all_attributes$": true,
                "^officers$": true,
                "^previous_names$": true,
                "^company_number$": true,
                "^headquarters_address$": true,
                "^jurisdiction_code$": true,
                "^dissolution_date$": true,
                "^total_shares$": true,
                "^alternative_names$": true,
                "^website$": true,
                "^current_status$": true,
                "^registered_address$": true,
                "^share_parcels$": true,
                "^jurisdiction$": true,
                "^telephone_number$": true,
                "^industry_codes$": true,
                "^branch$": true,
                "^company_type$": true,
                "^fax_number$": true,
                "^incorporation_date$": true,
                "^name$": true,
                "^registry_url$": true,
                "^identifiers$": true,
                "^addresses$": true,
                "^filings$": true,
                "^mailing_address$": true,
                "^retrieved_at$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "company-for-nesting": {
      "$ref": "#/$defs/modern_1"
    },
    "share-parcel": {
      "type": "object",
      "description": "A parcel of shares in a company",
      "properties": {
        "start_date": {
          "type": "string",
          "_format": "date"
        },
        "sample_date": {
          "type": "string",
          "_format": "date"
        },
        "shareholders": {
          "description": "Legal persons who own this share parcel",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "name": "shareholder",
            "required": [
              "name"
            ],
            "properties": {
              "jurisdiction": {
                "description": "Jurisdiction of registration, if company",
                "type": "string"
              },
              "name": {
                "description": "Name of natural person or company",
                "type": "string",
                "minLength": 1
              },
              "identifier": {
                "description": "Unique identifier of person",
                "type": "string"
              },
              "address_country": {
                "description": "Country part of owner's address (for example if address not given)",
                "type": "string"
              },
              "address": {
                "description": "Address given for shareholder",
                "$ref": "#/$defs/address"
              },
              "type": {
                "description": "Type of person if known (company or natural person)",
                "enum": [
                  "Company",
                  "Person"
                ]
              },
              "company_number": {
                "description": "Company number, if company and known",
                "type": "string"
              }
            }
          }
        },
        "voting_percentage_min": {
          "description": "Minimum percentage of votes (if for example a band of votes is given)",
          "type": [
            "number",
            "null"
          ],
          "maximum": 100.0,
          "minimum": 0.0
        },
        "end_date": {
          "type": "string",
          "_format": "date"
        },
        "number_of_shares": {
          "description": "Number of shares, if known",
          "type": "integer"
        },
        "percentage_of_shares_min": {
          "description": "Minimum percentage of shares (if for example a band of percentage is given)",
          "type": [
            "number",
            "null"
          ],
          "maximum": 100.0,
          "minimum": 0.0
        },
        "share_class": {
          "description": "Share class or classes, if known",
          "type": "string"
        },
        "voting_percentage_max": {
          "description": "Maximum percentage of votes (if for example a band of votes is given)",
          "type": [
            "number",
            "null"
          ],
          "maximum": 100.0,
          "minimum": 0.0
        },
        "percentage_of_shares_max": {
          "description": "Maximum percentage of shares (if for example a band of percentage is given)",
          "type": [
            "number",
            "null"
          ],
          "maximum": 100.0,
          "minimum": 0.0
        },
        "voting_percentage": {
          "description": "Percentage of votes, if known",
          "type": "number",
          "maximum": 100.0,
          "minimum": 0.0
        },
        "percentage_of_shares": {
          "description": "Percentage of shares, if known",
          "type": "number",
          "maximum": 100.0,
          "minimum": 0.0
        }
      }
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Information on the merger of this company into a 'survivor' company",
              "properties": {
                "surviving_company": {
                  "type": [
                    "object"
                  ],
                  "description": "the surviving_company that this has been merged into",
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "The legal name of the surviving company",
                      "minLength": 1
                    },
                    "company_number": {
                      "type": "string",
                      "description": "The company_number of the surviving company, if known",
                      "minLength": 1
                    },
                    "jurisdiction": {
                      "type": "string",
                      "description": "The jurisdiction of incorporation of the surviving company",
                      "minLength": 2
                    }
                  },
                  "anyOf": [
                    {
                      "required": [
                        "name"
                      ]
                    },
                    {
                      "required": [
                        "company_number"
                      ]
                    }
                  ]
                },
                "effective_date": {
                  "description": "The date of the merger",
                  "type": "string",
                  "_format": "date"
                }
              },
              "required": [
                "surviving_company"
              ]
            },
            {
              "patternProperties": {
                "^surviving_company$": true,
                "^effective_date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "total-shares": {
      "description": "The total number of shares a company has issued",
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "share_class": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "number"
      ]
    },
    "alternative-name": {
      "description": "An alternative name of a company, e.g. abbreviation, trading (including dba or doing business as), legal. As well as trading names etc, it can be used for storing alternative language representations of the legal name, in which case the language should be represented as two-letter ISO-639 code",
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string",
          "_format": "date"
        },
        "company_name": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 2
        },
        "end_date": {
          "type": "string",
          "_format": "date"
        },
        "type": {
          "type": "string",
          "enum": [
            "trading",
            "abbreviation",
            "legal",
            "unknown",
            "alias"
          ]
        }
      },
      "required": [
        "company_name",
        "type"
      ]
    },
    "date": {
      "$ref": "#/$defs/modern_6"
    },
    "person": {
      "$ref": "#/$defs/modern_7"
    },
    "entity": {
      "type": "object",
      "required": [
        "entity_type",
        "entity_properties"
      ],
      "oneOf": [
        {
          "properties": {
            "entity_type": {
              "enum": [
                "company"
              ]
            },
            "entity_properties": {
              "$ref": "#/$defs/company-for-nesting"
            }
          }
        },
        {
          "properties": {
            "entity_type": {
              "enum": [
                "person"
              ]
            },
            "entity_properties": {
              "$ref": "#/$defs/person"
            }
          }
        },
        {
          "properties": {
            "entity_type": {
              "enum": [
                "organisation"
              ]
            },
            "entity_properties": {
              "$ref": "#/$defs/organisation"
            }
          }
        },
        {
          "properties": {
            "entity_type": {
              "enum": [
                "unknown"
              ]
            },
            "entity_properties": {
              "$ref": "#/$defs/unknown-entity-type"
            }
          }
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An address with a type",
              "type": "object",
              "properties": {
                "address": {
                  "$ref": "#/$defs/address"
                },
                "type": {
                  "enum": [
                    "registered",
                    "headquarters",
                    "mailing",
                    "trading",
                    "unknown"
                  ]
                }
              },
              "required": [
                "address",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^address$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "address": {
      "oneOf": [
        {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2
        },
        {
          "name": "Address",
          "description": "An address object",
          "type": "object",
          "properties": {
            "country": {
              "type": "string"
            },
            "country_code": {
              "description": "ISO 3166-2 code for country",
              "type": "string"
            },
            "postal_code": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "street_address": {
              "type": "string"
            },
            "locality": {
              "type": "string"
            }
          },
          "anyOf": [
            {
              "required": [
                "street_address"
              ]
            },
            {
              "required": [
                "postal_code"
              ]
            },
            {
              "required": [
                "locality",
                "country"
              ]
            }
          ]
        }
      ]
    }
  }
}
