{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Classification",
              "description": "A classification from a code list",
              "type": "object",
              "properties": {
                "code_scheme_id": {
                  "description": "The scheme of the classification",
                  "type": "string"
                },
                "code": {
                  "description": "The classification",
                  "type": "string"
                },
                "name": {
                  "description": "A title or description of the classification, especially if the value is a code",
                  "type": "string"
                }
              },
              "anyOf": [
                {
                  "required": [
                    "name"
                  ]
                },
                {
                  "required": [
                    "code",
                    "code_scheme_id"
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^code_scheme_id$": true,
                "^code$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
