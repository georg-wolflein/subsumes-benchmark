{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o65448.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "A parsed date object. This allows us to represent not just normal dates, but also partial dates too",
                "type": "object",
                "properties": {
                  "year": {
                    "type": "number",
                    "description": "year part as YYYY"
                  },
                  "month": {
                    "type": "number",
                    "description": "month part of date in numbers e.g. 11 for November, 4 for April"
                  },
                  "day": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "day part of date in numbers"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "year",
                      "month"
                    ]
                  },
                  {
                    "required": [
                      "month",
                      "day"
                    ]
                  }
                ]
              },
              {
                "patternProperties": {
                  "^year$": true,
                  "^month$": true,
                  "^day$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A parsed date object. This allows us to represent not just normal dates, but also partial dates too",
    "type": "object",
    "properties": {
      "year": {
        "type": "number",
        "description": "year part as YYYY"
      },
      "month": {
        "type": "number",
        "description": "month part of date in numbers e.g. 11 for November, 4 for April"
      },
      "day": {
        "type": [
          "number",
          "null"
        ],
        "description": "day part of date in numbers"
      }
    },
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "year",
          "month"
        ]
      },
      {
        "required": [
          "month",
          "day"
        ]
      }
    ]
  }
}
