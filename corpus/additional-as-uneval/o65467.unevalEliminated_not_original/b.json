{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "data_type": {
      "enum": [
        "subsidiary_relationship"
      ]
    },
    "properties": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "subsidiary"
              ],
              "properties": {
                "direct": {
                  "description": "If the control is direct (if via an intermediary, this value should be false; if unknown, left blank)",
                  "type": "boolean"
                },
                "percentage_controlled": {
                  "description": "Percentage controlled, either directly or indirectly",
                  "type": "string"
                },
                "significant": {
                  "description": "Does the source define the control as somehow significant?",
                  "type": "boolean"
                },
                "subsidiary": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^direct$": true,
                "^percentage_controlled$": true,
                "^significant$": true,
                "^subsidiary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Company that is controlled",
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "description": "Name of company",
                  "type": "string"
                },
                "jurisdiction": {
                  "description": "Jurisdiction of registration",
                  "type": "string"
                },
                "company_number": {
                  "description": "Company number, if company and known",
                  "type": "string"
                },
                "identifier": {
                  "description": "Unique identifier of company",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^jurisdiction$": true,
                "^company_number$": true,
                "^identifier$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
