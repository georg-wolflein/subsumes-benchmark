{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "species": {
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "type": "string"
        },
        "taxonomy": {
          "type": "string"
        },
        "identification": {
          "type": "string"
        },
        "bova_id": {
          "type": "number"
        },
        "images": {
          "items": {
            "properties": {
              "credit": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "_format": "uri",
                "type": "string"
              }
            },
            "required": [
              "url"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "bova_id",
        "name",
        "taxonomy"
      ],
      "type": "object"
    },
    "fishing_techniques": {
      "type": "string"
    },
    "state": {
      "maxLength": 2,
      "minLength": 2,
      "pattern": "([A-Z]{2})",
      "type": "string"
    },
    "best_fishing": {
      "properties": {
        "description": {
          "type": "string"
        },
        "lakes": {
          "$ref": "#/$defs/modern_1"
        },
        "rivers": {
          "type": "object"
        }
      },
      "type": "object"
    },
    "schema_version": {
      "type": "string"
    },
    "conformsTo": {
      "_format": "uri",
      "type": "string"
    },
    "date_expires": {
      "_format": "date-time",
      "type": "string"
    },
    "date_effective": {
      "_format": "date-time",
      "type": "string"
    },
    "limits": {
      "properties": {
        "description": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "agency": {
      "type": "string"
    },
    "documentation": {
      "_format": "uri",
      "type": "string"
    }
  },
  "required": [
    "agency",
    "date_effective",
    "date_expires",
    "documentation",
    "schema_version",
    "conformsTo",
    "state",
    "species"
  ],
  "title": "fishing",
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "properties": {
                  "comment": {
                    "type": "string"
                  },
                  "gnis_id": {
                    "type": "number"
                  },
                  "latitude": {
                    "type": "number"
                  },
                  "longitude": {
                    "type": "number"
                  }
                },
                "type": "object"
              }
            }
          ]
        }
      ]
    }
  }
}
