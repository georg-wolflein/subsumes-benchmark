{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "bid"
              ],
              "properties": {
                "bid": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/bid"
                  }
                },
                "seat": {
                  "type": "string"
                },
                "group": {
                  "$ref": "#/$defs/boolean_int"
                }
              }
            },
            {
              "patternProperties": {
                "^bid$": true,
                "^seat$": true,
                "^group$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "creative_attribute": {
      "type": "integer",
      "minimum": 1.0,
      "maximum": 16.0
    },
    "seatbid": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "id",
                "impid",
                "price"
              ],
              "properties": {
                "adid": {
                  "type": "string"
                },
                "iurl": {
                  "type": "string"
                },
                "adomain": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "adm": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "cid": {
                  "type": "string"
                },
                "attr": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/creative_attribute"
                  }
                },
                "ext": {
                  "type": "object"
                },
                "impid": {
                  "type": "string"
                },
                "crid": {
                  "type": "string"
                },
                "nurl": {
                  "type": "string"
                },
                "price": {
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            {
              "patternProperties": {
                "^adid$": true,
                "^id$": true,
                "^cid$": true,
                "^impid$": true,
                "^attr$": true,
                "^crid$": true,
                "^ext$": true,
                "^adm$": true,
                "^iurl$": true,
                "^nurl$": true,
                "^adomain$": true,
                "^price$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "openrtb-v2_0-schema-bid_response",
              "description": "json schema for an openrtb v2.0 bid response (http://www.iab.net/media/file/OpenRTB_API_Specification_Version2.0_FINAL.PDF)",
              "type": "object",
              "required": [
                "id",
                "seatbid"
              ],
              "properties": {
                "bidid": {
                  "type": "string"
                },
                "seatbid": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/seatbid"
                  }
                },
                "id": {
                  "type": "string"
                },
                "customdata": {
                  "type": "string"
                },
                "cur": {
                  "$ref": "#/$defs/currency"
                },
                "ext": {
                  "type": "object"
                }
              }
            },
            {
              "patternProperties": {
                "^customdata$": true,
                "^cur$": true,
                "^id$": true,
                "^seatbid$": true,
                "^bidid$": true,
                "^ext$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3,
      "pattern": "[a-zA-Z]{3}"
    },
    "boolean_int": {
      "type": "integer",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "bid": {
      "$ref": "#/$defs/modern_2"
    }
  }
}
