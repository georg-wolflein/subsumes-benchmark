{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "^@.*": {
                  "description": "Data Array Time Series Custom Feature",
                  "title": "Custom Feature Type 2"
                }
              },
              "properties": {
                "x": {
                  "$ref": "#/$defs/array_of_numbers_or_arrays"
                },
                "oy": {
                  "$ref": "#/$defs/array_of_numbers"
                },
                "y": {
                  "$ref": "#/$defs/array_of_numbers_or_arrays"
                },
                "id": {
                  "type": "string"
                },
                "py": {
                  "$ref": "#/$defs/array_of_numbers_or_arrays"
                },
                "cx": {
                  "$ref": "#/$defs/array_of_numbers"
                },
                "t": {
                  "$ref": "#/$defs/array_of_numbers"
                },
                "head": {
                  "oneOf": [
                    {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "enum": [
                            "L",
                            "R",
                            "?"
                          ],
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "items": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "enum": [
                              "L",
                              "R",
                              "?"
                            ],
                            "type": "string"
                          }
                        ]
                      },
                      "type": "array"
                    }
                  ]
                },
                "walk": {
                  "items": {
                    "$ref": "#/$defs/pixel_walk_record"
                  },
                  "type": "array"
                },
                "ventral": {
                  "oneOf": [
                    {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "enum": [
                            "CW",
                            "CCW",
                            "?"
                          ],
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "items": {
                        "oneOf": [
                          {
                            "type": "null"
                          },
                          {
                            "enum": [
                              "CW",
                              "CCW",
                              "?"
                            ],
                            "type": "string"
                          }
                        ]
                      },
                      "type": "array"
                    }
                  ]
                },
                "px": {
                  "$ref": "#/$defs/array_of_numbers_or_arrays"
                },
                "cy": {
                  "$ref": "#/$defs/array_of_numbers"
                },
                "ptail": {
                  "$ref": "#/$defs/array_or_number"
                },
                "ox": {
                  "$ref": "#/$defs/array_of_numbers"
                }
              },
              "required": [
                "id",
                "t",
                "x",
                "y"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^ptail$": true,
                "^ox$": true,
                "^walk$": true,
                "^cx$": true,
                "^@.*": true,
                "^cy$": true,
                "^ventral$": true,
                "^head$": true,
                "^y$": true,
                "^x$": true,
                "^t$": true,
                "^px$": true,
                "^oy$": true,
                "^py$": true,
                "^id$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "data_record": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "A text-based data interchange format for *C. elegans* trackers. It is a constrained subset of JSON. It is designed to be both human and machine readable and to facilitate data exchange and inter-operability for worm tracking data that is independent of platform and the language used for implementation.",
              "patternProperties": {
                "^@.*": {
                  "description": "Top-Level Custom Feature",
                  "title": "Custom Feature Type 1"
                }
              },
              "properties": {
                "data": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/data_record"
                    },
                    {
                      "items": {
                        "$ref": "#/$defs/data_record"
                      },
                      "type": "array"
                    }
                  ]
                },
                "files": {
                  "$ref": "#/$defs/modern_3"
                },
                "metadata": {
                  "$ref": "#/$defs/modern_4"
                },
                "units": {
                  "$ref": "#/$defs/modern_5"
                }
              },
              "required": [
                "units",
                "data"
              ],
              "title": "Worm tracker Commons Object Notation (WCON)",
              "type": "object"
            },
            {
              "patternProperties": {
                "^metadata$": true,
                "^files$": true,
                "^units$": true,
                "^@.*": true,
                "^data$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "array_of_numbers_or_arrays": {
      "oneOf": [
        {
          "$ref": "#/$defs/array_of_numbers"
        },
        {
          "items": {
            "$ref": "#/$defs/array_of_numbers"
          },
          "type": "array"
        }
      ]
    },
    "software_metadata": {
      "properties": {
        "featureID": {
          "description": "i.e. the lab strain designation followed by an optional suffix (e.g. '@OMG')",
          "type": "string"
        },
        "settings": true,
        "tracker": {
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "description": "Supports semantic versioning (MAJOR.MINOR.PATCH) (http://semver.org/), written as a string, or any other string.",
              "type": "string"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "For very long tracking experiments, it may be convenient to split a single experiment across multiple WCON files. To make it easier to reconstruct tracks across files, we support a 'files' object.",
              "properties": {
                "current": {
                  "type": "string"
                },
                "next": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "prev": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                }
              },
              "required": [
                "current"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^current$": true,
                "^next$": true,
                "^prev$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "string_or_array_of_strings": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    },
    "interpolate_metadata": {
      "properties": {
        "method": {
          "type": "string"
        },
        "values": {
          "$ref": "#/$defs/string_or_array_of_strings"
        }
      },
      "type": "object"
    },
    "array_or_number": {
      "oneOf": [
        {
          "$ref": "#/$defs/nullable_number"
        },
        {
          "items": {
            "$ref": "#/$defs/nullable_number"
          },
          "type": "array"
        }
      ]
    },
    "nullable_number": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "pixel_walk_record": {
      "properties": {
        "4": {
          "type": "string"
        },
        "n": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "type": "array"
            }
          ]
        },
        "px": {
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "type": "array"
        }
      },
      "type": "object"
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Defines the dimensions (temporal, spatial, etc) of the experiment.",
              "properties": {
                "t": {
                  "type": "string"
                },
                "x": {
                  "type": "string"
                },
                "y": {
                  "type": "string"
                }
              },
              "required": [
                "t",
                "x",
                "y"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^t$": true,
                "^x$": true,
                "^y$": true
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "array_of_numbers": {
      "items": {
        "$ref": "#/$defs/nullable_number"
      },
      "type": "array"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Information about experimental conditions and software versions; critical for reproducibility across labs.",
              "properties": {
                "stage": {
                  "enum": [
                    "L1",
                    "L2",
                    "L3",
                    "L4",
                    "adult",
                    "dauer"
                  ],
                  "type": "string"
                },
                "strain": {
                  "type": "string"
                },
                "timestamp": {
                  "format": "date-time",
                  "type": "string"
                },
                "lab": {
                  "type": "object"
                },
                "temperature": {
                  "type": "number"
                },
                "age": {
                  "type": "number"
                },
                "sex": {
                  "enum": [
                    "hermaphrodite",
                    "male"
                  ],
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "humidity": {
                  "type": "number"
                },
                "who": {
                  "$ref": "#/$defs/string_or_array_of_strings"
                },
                "software": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/software_metadata"
                    },
                    {
                      "items": {
                        "$ref": "#/$defs/software_metadata"
                      },
                      "type": "array"
                    }
                  ]
                },
                "media": {
                  "type": "string"
                },
                "arena": {
                  "properties": {
                    "orientation": {
                      "type": "string"
                    },
                    "size": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "items": {
                            "type": "string"
                          },
                          "minItems": 2,
                          "type": "array"
                        }
                      ]
                    },
                    "style": {
                      "default": "petri",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "protocol": {
                  "$ref": "#/$defs/string_or_array_of_strings"
                },
                "food": {
                  "type": "string"
                },
                "interpolate": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/interpolate_metadata"
                    },
                    {
                      "items": {
                        "$ref": "#/$defs/interpolate_metadata"
                      },
                      "type": "array"
                    }
                  ]
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^food$": true,
                "^timestamp$": true,
                "^stage$": true,
                "^protocol$": true,
                "^who$": true,
                "^media$": true,
                "^age$": true,
                "^humidity$": true,
                "^arena$": true,
                "^id$": true,
                "^temperature$": true,
                "^interpolate$": true,
                "^strain$": true,
                "^lab$": true,
                "^sex$": true,
                "^software$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
