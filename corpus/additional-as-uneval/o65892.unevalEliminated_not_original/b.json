{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_31",
  "$defs": {
    "Position": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_20": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Clears the edits for this change.",
              "type": "object",
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_28": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "uri": {
                  "description": "The text document's uri.",
                  "type": "string"
                }
              },
              "required": [
                "uri"
              ]
            },
            {
              "patternProperties": {
                "^uri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "range": {
                  "$ref": "#/$defs/Range",
                  "description": "The range of the text document to be manipulated. To insert\n\ntext into a document create a range where start === end."
                },
                "newText": {
                  "description": "The string to be inserted. For delete operations use an\n\nempty string.",
                  "type": "string"
                }
              },
              "required": [
                "range",
                "newText"
              ]
            },
            {
              "patternProperties": {
                "^range$": true,
                "^newText$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_30": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "range": {
                  "$ref": "#/$defs/Range",
                  "description": "The range this highlight applies to."
                },
                "kind": {
                  "description": "The highlight kind, default is [text](#DocumentHighlightKind.Text).",
                  "type": "number"
                }
              },
              "required": [
                "range"
              ]
            },
            {
              "patternProperties": {
                "^range$": true,
                "^kind$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "language",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^language$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_22": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Title of the command, like `save`.",
                  "type": "string"
                },
                "command": {
                  "description": "The identifier of the actual command handler.",
                  "type": "string"
                },
                "arguments": {
                  "description": "Arguments that the command handler should be\n\ninvoked with.",
                  "type": "array",
                  "items": true
                }
              },
              "required": [
                "title",
                "command"
              ]
            },
            {
              "patternProperties": {
                "^title$": true,
                "^command$": true,
                "^arguments$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_26": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "diagnostics": {
                  "description": "An array of diagnostics.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/Diagnostic",
                    "description": "Represents a diagnostic, such as a compiler error or warning. Diagnostic objects\n\nare only valid in the scope of a resource.\n\nThe Diagnostic namespace provides helper functions to work with\n\n[Diagnostic](#Diagnostic) literals."
                  }
                }
              },
              "required": [
                "diagnostics"
              ]
            },
            {
              "patternProperties": {
                "^diagnostics$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "uri": {
                  "type": "string"
                },
                "range": {
                  "$ref": "#/$defs/Range"
                }
              },
              "required": [
                "uri",
                "range"
              ]
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^range$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_21": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Gets all text edits for this change.",
              "type": "object",
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "SymbolKind": {
      "type": "string"
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "changes": {
                  "$ref": "#/$defs/modern_6"
                }
              },
              "required": [
                "changes"
              ]
            },
            {
              "patternProperties": {
                "^changes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_32": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "language",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^language$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "TextEdit": {
      "$ref": "#/$defs/modern_12"
    },
    "SignatureInformation": {
      "$ref": "#/$defs/modern_13"
    },
    "Location": {
      "$ref": "#/$defs/modern_14"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Holds changes to existing resources.",
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/TextEdit",
                  "description": "A text edit applicable to a text document.\n\nThe TextEdit namespace provides helper function to create replace,\n\ninsert and delete edits more easily."
                }
              }
            }
          ]
        }
      ]
    },
    "CompletionItem": {
      "$ref": "#/$defs/modern_15"
    },
    "DiagnosticSeverity": {
      "type": "string"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "description": "The label of this signature. Will be shown in\n\nthe UI.",
                  "type": "string"
                },
                "documentation": {
                  "description": "The human-readable doc-comment of this signature. Will be shown\n\nin the UI but can be omitted.",
                  "type": "string"
                }
              },
              "required": [
                "label"
              ]
            },
            {
              "patternProperties": {
                "^label$": true,
                "^documentation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Hover": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "replace": {
                  "$ref": "#/$defs/modern_17"
                },
                "insert": {
                  "$ref": "#/$defs/modern_18"
                },
                "delete": {
                  "$ref": "#/$defs/modern_19"
                },
                "clear": {
                  "$ref": "#/$defs/modern_20"
                },
                "all": {
                  "$ref": "#/$defs/modern_21"
                }
              },
              "required": [
                "all",
                "clear",
                "insert",
                "replace",
                "delete"
              ]
            },
            {
              "patternProperties": {
                "^insert$": true,
                "^replace$": true,
                "^all$": true,
                "^clear$": true,
                "^delete$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "label": {
                  "description": "The label of this completion item. By default\n\nalso the text that is inserted when selecting\n\nthis completion.",
                  "type": "string"
                },
                "textEdit": {
                  "$ref": "#/$defs/TextEdit",
                  "description": "An [edit](#TextEdit) which is applied to a document when selecting\n\nthis completion. When an edit is provided the value of\n\n[insertText](#CompletionItem.insertText) is ignored."
                },
                "detail": {
                  "description": "A human-readable string with additional information\n\nabout this item, like type or symbol information.",
                  "type": "string"
                },
                "kind": {
                  "description": "The kind of this completion item. Based of the kind\n\nan icon is chosen by the editor.",
                  "type": "number"
                },
                "insertText": {
                  "description": "A string that should be inserted a document when selecting\n\nthis completion. When `falsy` the [label](#CompletionItem.label)\n\nis used.",
                  "type": "string"
                },
                "filterText": {
                  "description": "A string that should be used when filtering a set of\n\ncompletion items. When `falsy` the [label](#CompletionItem.label)\n\nis used.",
                  "type": "string"
                },
                "sortText": {
                  "description": "A string that shoud be used when comparing this item\n\nwith other items. When `falsy` the [label](#CompletionItem.label)\n\nis used.",
                  "type": "string"
                },
                "documentation": {
                  "description": "A human-readable string that represents a doc-comment.",
                  "type": "string"
                },
                "data": {
                  "description": "An data entry field that is preserved on a completion item between\n\na [CompletionRequest](#CompletionRequest) and a [CompletionResolveRequest]\n\n(#CompletionResolveRequest)"
                }
              },
              "required": [
                "label"
              ]
            },
            {
              "patternProperties": {
                "^kind$": true,
                "^documentation$": true,
                "^insertText$": true,
                "^label$": true,
                "^filterText$": true,
                "^textEdit$": true,
                "^data$": true,
                "^detail$": true,
                "^sortText$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_27": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "source": {
                  "description": "A human-readable string describing the source of this\n\ndiagnostic, e.g. 'typescript' or 'super lint'.",
                  "type": "string"
                },
                "code": {
                  "description": "The diagnostic's code. Can be omitted.",
                  "oneOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "string"
                    }
                  ]
                },
                "range": {
                  "$ref": "#/$defs/Range",
                  "description": "The range at which the message applies"
                },
                "message": {
                  "description": "The diagnostic's message.",
                  "type": "string"
                },
                "severity": {
                  "description": "The diagnostic's severity. Can be omitted. If omitted it is up to the\n\nclient to interpret diagnostics as error, warning, info or hint.",
                  "type": "number"
                }
              },
              "required": [
                "range",
                "message"
              ]
            },
            {
              "patternProperties": {
                "^code$": true,
                "^severity$": true,
                "^range$": true,
                "^message$": true,
                "^source$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "contents": {
                  "description": "The hover's content",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/modern_2"
                    },
                    {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "$ref": "#/$defs/modern_3"
                          }
                        ]
                      }
                    }
                  ]
                },
                "range": {
                  "$ref": "#/$defs/Range",
                  "description": "An optional range"
                }
              },
              "required": [
                "contents"
              ]
            },
            {
              "patternProperties": {
                "^contents$": true,
                "^range$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "CompletionItemKind": {
      "type": "string"
    },
    "TextEditChange": {
      "$ref": "#/$defs/modern_16"
    },
    "Command": {
      "$ref": "#/$defs/modern_22"
    },
    "modern_31": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "codeActionContext": {
                  "$ref": "#/$defs/CodeActionContext"
                },
                "parameterInformation": {
                  "$ref": "#/$defs/ParameterInformation"
                },
                "location": {
                  "$ref": "#/$defs/Location"
                },
                "completionList": {
                  "$ref": "#/$defs/CompletionList"
                },
                "textDocumentIdentifier": {
                  "$ref": "#/$defs/TextDocumentIdentifier"
                },
                "documentHighlight": {
                  "$ref": "#/$defs/DocumentHighlight"
                },
                "symbolInformation": {
                  "$ref": "#/$defs/SymbolInformation"
                },
                "range": {
                  "$ref": "#/$defs/Range"
                },
                "completionItem": {
                  "$ref": "#/$defs/CompletionItem"
                },
                "position": {
                  "$ref": "#/$defs/Position"
                },
                "signatureHelp": {
                  "$ref": "#/$defs/SignatureHelp"
                },
                "markedString": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/modern_32"
                    }
                  ]
                },
                "textEditChange": {
                  "$ref": "#/$defs/TextEditChange"
                },
                "DiagnosticSeverity": {
                  "$ref": "#/$defs/DiagnosticSeverity"
                },
                "completionItemKind": {
                  "$ref": "#/$defs/CompletionItemKind"
                },
                "formattingOptions": {
                  "$ref": "#/$defs/FormattingOptions"
                },
                "hover": {
                  "$ref": "#/$defs/Hover"
                },
                "command": {
                  "$ref": "#/$defs/Command"
                },
                "symbolKind": {
                  "$ref": "#/$defs/SymbolKind"
                },
                "textEdit": {
                  "$ref": "#/$defs/TextEdit"
                },
                "documentHighlightKind": {
                  "$ref": "#/$defs/DocumentHighlightKind"
                },
                "diagnostic": {
                  "$ref": "#/$defs/Diagnostic"
                },
                "workspaceEdit": {
                  "$ref": "#/$defs/WorkspaceEdit"
                },
                "workspaceChange": {
                  "$ref": "#/$defs/WorkspaceChange"
                },
                "codeLens": {
                  "$ref": "#/$defs/CodeLens"
                },
                "definition": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Location",
                      "description": "Represents a location inside a resource, such as a line\n\ninside a text file.\n\nThe Location namespace provides helper functions to work with\n\n[Location](#Location) literals."
                    },
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/Location",
                        "description": "Represents a location inside a resource, such as a line\n\ninside a text file.\n\nThe Location namespace provides helper functions to work with\n\n[Location](#Location) literals."
                      }
                    }
                  ]
                },
                "signatureInformation": {
                  "$ref": "#/$defs/SignatureInformation"
                }
              },
              "required": [
                "range",
                "position",
                "location",
                "diagnostic",
                "DiagnosticSeverity",
                "command",
                "textEdit",
                "workspaceEdit",
                "workspaceChange",
                "textEditChange",
                "textDocumentIdentifier",
                "completionItemKind",
                "completionItem",
                "completionList",
                "hover",
                "markedString",
                "signatureHelp",
                "signatureInformation",
                "parameterInformation",
                "definition",
                "codeActionContext",
                "documentHighlight",
                "documentHighlightKind",
                "symbolInformation",
                "symbolKind",
                "codeLens",
                "formattingOptions"
              ]
            },
            {
              "patternProperties": {
                "^diagnostic$": true,
                "^hover$": true,
                "^completionList$": true,
                "^documentHighlightKind$": true,
                "^textEdit$": true,
                "^signatureInformation$": true,
                "^completionItem$": true,
                "^markedString$": true,
                "^symbolKind$": true,
                "^formattingOptions$": true,
                "^documentHighlight$": true,
                "^textDocumentIdentifier$": true,
                "^codeActionContext$": true,
                "^workspaceChange$": true,
                "^workspaceEdit$": true,
                "^DiagnosticSeverity$": true,
                "^signatureHelp$": true,
                "^symbolInformation$": true,
                "^range$": true,
                "^codeLens$": true,
                "^parameterInformation$": true,
                "^definition$": true,
                "^completionItemKind$": true,
                "^textEditChange$": true,
                "^location$": true,
                "^command$": true,
                "^position$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "workspaceEdit": true,
                "textEditChanges": true,
                "edit": {
                  "$ref": "#/$defs/WorkspaceEdit",
                  "description": "Returns the underlying [WorkspaceEdit](#WorkspaceEdit) literal\n\nuse to be returned from a workspace edit operation like rename."
                },
                "getTextEditChange": {
                  "$ref": "#/$defs/modern_8"
                }
              },
              "required": [
                "workspaceEdit",
                "textEditChanges",
                "edit",
                "getTextEditChange"
              ]
            },
            {
              "patternProperties": {
                "^workspaceEdit$": true,
                "^textEditChanges$": true,
                "^edit$": true,
                "^getTextEditChange$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_23": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "range": {
                  "$ref": "#/$defs/Range",
                  "description": "The range in which this code lens is valid. Should only span a single line."
                },
                "command": {
                  "$ref": "#/$defs/Command",
                  "description": "The command this code lens represents."
                },
                "data": {
                  "description": "An data entry field that is preserved on a code lens item between\n\na [CodeLensRequest](#CodeLensRequest) and a [CodeLensResolveRequest]\n\n(#CodeLensResolveRequest)"
                }
              },
              "required": [
                "range"
              ]
            },
            {
              "patternProperties": {
                "^range$": true,
                "^command$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Replace the given range with given text for the given resource.",
              "type": "object",
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "language": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "language",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^language$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "CodeLens": {
      "$ref": "#/$defs/modern_23"
    },
    "DocumentHighlightKind": {
      "type": "string"
    },
    "FormattingOptions": {
      "$ref": "#/$defs/modern_24"
    },
    "SignatureHelp": {
      "$ref": "#/$defs/modern_25"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Returns the [TextEditChange](#TextEditChange) to manage text edits\n\nfor resources.",
              "type": "object",
              "properties": {}
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "WorkspaceEdit": {
      "$ref": "#/$defs/modern_5"
    },
    "CodeActionContext": {
      "$ref": "#/$defs/modern_26"
    },
    "modern_24": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tabSize": {
                  "description": "Size of a tab in spaces.",
                  "type": "number"
                },
                "insertSpaces": {
                  "description": "Prefer spaces over tabs.",
                  "type": "boolean"
                }
              },
              "required": [
                "tabSize",
                "insertSpaces"
              ]
            },
            {
              "patternProperties": {
                "^tabSize$": true,
                "^insertSpaces$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Diagnostic": {
      "$ref": "#/$defs/modern_27"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "isIncomplete": {
                  "description": "This list it not complete. Further typing should result in recomputing\n\nthis list.",
                  "type": "boolean"
                },
                "items": {
                  "description": "The completion items.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/CompletionItem",
                    "description": "A completion item represents a text snippet that is\n\nproposed to complete text that is being typed.\n\nThe CompletionItem namespace provides functions to deal with\n\ncompletion items."
                  }
                }
              },
              "required": [
                "isIncomplete",
                "items"
              ]
            },
            {
              "patternProperties": {
                "^isIncomplete$": true,
                "^items$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_29": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "description": "The name of this symbol.",
                  "type": "string"
                },
                "kind": {
                  "description": "The kind of this symbol.",
                  "type": "number"
                },
                "location": {
                  "$ref": "#/$defs/Location",
                  "description": "The location of this symbol."
                },
                "containerName": {
                  "description": "The name of the symbol containing this symbol.",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "kind",
                "location"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^kind$": true,
