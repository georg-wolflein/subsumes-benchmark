{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o65953.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "meta"
    ],
    "properties": {
      "meta": {
        "required": [
          "format_version"
        ],
        "properties": {
          "format_version": {
            "type": "integer",
            "minimum": 1
          },
          "filters": {
            "type": "object",
            "required": [
              "inspect"
            ],
            "properties": {
              "inspect": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "additionalProperties": {
          "type": "object",
          "required": [
            "modified",
            "hostname"
          ],
          "properties": {
            "modified": {
              "type": "string",
              "format": "date-time"
            },
            "hostname": {
              "type": "string",
              "format": "hostname"
            }
          }
        }
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "meta"
    ],
    "properties": {
      "meta": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "required": [
                  "format_version"
                ],
                "properties": {
                  "format_version": {
                    "type": "integer",
                    "minimum": 1.0
                  },
                  "filters": {
                    "type": "object",
                    "required": [
                      "inspect"
                    ],
                    "properties": {
                      "inspect": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^format_version$": true,
                  "^filters$": true
                },
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "modified",
                    "hostname"
                  ],
                  "properties": {
                    "modified": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "hostname": {
                      "type": "string",
                      "format": "hostname"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  }
}
