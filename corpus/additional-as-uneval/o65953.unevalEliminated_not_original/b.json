{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "meta"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "format_version"
              ],
              "properties": {
                "format_version": {
                  "type": "integer",
                  "minimum": 1.0
                },
                "filters": {
                  "type": "object",
                  "required": [
                    "inspect"
                  ],
                  "properties": {
                    "inspect": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^format_version$": true,
                "^filters$": true
              },
              "additionalProperties": {
                "type": "object",
                "required": [
                  "modified",
                  "hostname"
                ],
                "properties": {
                  "modified": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "hostname": {
                    "type": "string",
                    "format": "hostname"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}
