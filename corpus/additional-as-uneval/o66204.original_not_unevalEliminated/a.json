{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "PaperHive annotation schema for POSTing",
              "type": "object",
              "properties": {
                "$schema": {
                  "enum": [
                    "http://paperhive.org/api/v0/schemas/annotation_post.json#"
                  ]
                },
                "publication_id": {
                  "type": "string"
                },
                "target": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_2"
                    }
                  ]
                },
                "body": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "publication_id",
                "target",
                "body"
              ]
            },
            {
              "patternProperties": {
                "^$schema$": true,
                "^publication_id$": true,
                "^target$": true,
                "^body$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "page": {
                  "type": "integer",
                  "minimum": 1.0
                },
                "h": {
                  "type": "number"
                },
                "type": {
                  "enum": [
                    "FragmentSelector"
                  ]
                },
                "w": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "page",
                "x",
                "y",
                "w",
                "h"
              ]
            },
            {
              "patternProperties": {
                "^page$": true,
                "^x$": true,
                "^type$": true,
                "^w$": true,
                "^h$": true,
                "^y$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "enum": [
                    "markdown"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^value$": true,
                "^language$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
