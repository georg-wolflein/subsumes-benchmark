{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "working_dir": {
                  "type": [
                    "null",
                    "string"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^path$": true,
                "^args$": true,
                "^env$": true,
                "^working_dir$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Command": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "CiBuildSettings",
              "type": "object",
              "required": [
                "build"
              ],
              "properties": {
                "prepare": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/Command"
                    }
                  ]
                },
                "build": {
                  "minLength": 1,
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Command"
                    }
                  ]
                },
                "post_build": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/Command"
                    }
                  ]
                },
                "emails": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "env": {
                  "type": [
                    "array",
                    "null"
                  ],
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^post_build$": true,
                "^prepare$": true,
                "^env$": true,
                "^emails$": true,
                "^build$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
