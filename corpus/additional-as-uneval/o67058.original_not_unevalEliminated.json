{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o67058.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "request",
                  "response"
                ],
                "properties": {
                  "request": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "response": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              },
              {
                "patternProperties": {
                  "^request$": true,
                  "^response$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "method",
                  "url",
                  "headers"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "_format": "uri"
                  },
                  "params": {
                    "type": "object"
                  },
                  "headers": {
                    "type": "object"
                  },
                  "method": {
                    "type": "string",
                    "enum": [
                      "GET",
                      "POST",
                      "PUT",
                      "DELETE"
                    ]
                  },
                  "body": {
                    "type": "object"
                  }
                }
              },
              {
                "patternProperties": {
                  "^headers$": true,
                  "^method$": true,
                  "^body$": true,
                  "^url$": true,
                  "^params$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "headers"
                ],
                "properties": {
                  "headers": {
                    "type": "object"
                  },
                  "body": true
                }
              },
              {
                "patternProperties": {
                  "^headers$": true,
                  "^body$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://flynn.io/schema/examples/base",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "request",
      "response"
    ],
    "properties": {
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method",
          "url",
          "headers"
        ],
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "DELETE"
            ]
          },
          "url": {
            "type": "string",
            "_format": "uri"
          },
          "headers": {
            "type": "object"
          },
          "params": {
            "type": "object"
          },
          "body": {
            "type": "object"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "headers"
        ],
        "properties": {
          "headers": {
            "type": "object"
          },
          "body": {}
        }
      }
    }
  }
}
