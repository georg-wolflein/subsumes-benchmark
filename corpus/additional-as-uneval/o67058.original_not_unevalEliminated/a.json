{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "request",
                "response"
              ],
              "properties": {
                "request": {
                  "$ref": "#/$defs/modern_2"
                },
                "response": {
                  "$ref": "#/$defs/modern_3"
                }
              }
            },
            {
              "patternProperties": {
                "^request$": true,
                "^response$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "method",
                "url",
                "headers"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "_format": "uri"
                },
                "params": {
                  "type": "object"
                },
                "headers": {
                  "type": "object"
                },
                "method": {
                  "type": "string",
                  "enum": [
                    "GET",
                    "POST",
                    "PUT",
                    "DELETE"
                  ]
                },
                "body": {
                  "type": "object"
                }
              }
            },
            {
              "patternProperties": {
                "^headers$": true,
                "^method$": true,
                "^body$": true,
                "^url$": true,
                "^params$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "headers"
              ],
              "properties": {
                "headers": {
                  "type": "object"
                },
                "body": true
              }
            },
            {
              "patternProperties": {
                "^headers$": true,
                "^body$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
