{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_4",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The full name of the author."
                },
                "email": {
                  "type": "string",
                  "description": "The e-mail address of the author.",
                  "format": "email"
                },
                "role": {
                  "type": "string",
                  "description": "The role of the author in the project."
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "The repository type."
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "The project's source",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of this source definition. This is used to create filters in the IDE."
                },
                "paths": {
                  "type": "array",
                  "description": "A list with directories to include source files from.",
                  "items": {
                    "type": "string"
                  }
                },
                "files": {
                  "type": "array",
                  "description": "A list with files to add.",
                  "items": {
                    "type": "string"
                  }
                },
                "extensions": {
                  "type": "array",
                  "description": "A list with extensions to add to this filter.",
                  "items": {
                    "type": "string"
                  }
                },
                "sources": {
                  "type": [
                    "array",
                    "boolean"
                  ],
                  "description": "A list with sources that should act as sub filters.",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^paths$": true,
                "^files$": true,
                "^sources$": true,
                "^name$": true,
                "^extensions$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the project."
                },
                "source": {
                  "type": "object",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/source"
                    }
                  ]
                },
                "dependencies-dev": {
                  "type": "array",
                  "description": "The list with development dependencies.",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                },
                "paths": {
                  "type": "object",
                  "description": "The paths for this project",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/paths"
                    }
                  ]
                },
                "definitions4": {
                  "type": "array",
                  "description": "A list with definitions4 to add to the project.",
                  "items": {
                    "type": "string"
                  }
                },
                "configurations": {
                  "type": "array",
                  "description": "The list with configurations.",
                  "items": {
                    "$ref": "#/$defs/modern_9"
                  }
                },
                "dependencies": {
                  "type": "array",
                  "description": "The list with dependencies.",
                  "items": {
                    "$ref": "#/$defs/modern_12"
                  }
                },
                "pch": {
                  "type": "object",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/pch"
                    }
                  ]
                },
                "subsystem": {
                  "type": "string",
                  "description": "The project's subsystem"
                },
                "type": {
                  "type": "string",
                  "description": "The type of the project."
                }
              }
            },
            {
              "patternProperties": {
                "^dependencies-dev$": true,
                "^paths$": true,
                "^pch$": true,
                "^dependencies$": true,
                "^definitions4$": true,
                "^configurations$": true,
                "^name$": true,
                "^type$": true,
                "^subsystem$": true,
                "^source$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "array",
                  "description": "An array with paths of where to find reference files.",
                  "items": {
                    "type": "string"
                  }
                },
                "source": {
                  "type": "array",
                  "description": "An array with paths of where to find source files.",
                  "items": {
                    "type": "string"
                  }
                },
                "library": {
                  "type": "array",
                  "description": "An array with paths of where to find libraries.",
                  "items": {
                    "type": "string"
                  }
                },
                "include": {
                  "type": "array",
                  "description": "An array with paths of where to find include files.",
                  "items": {
                    "type": "string"
                  }
                },
                "exclude": {
                  "type": "array",
                  "description": "An array with paths to exclude.",
                  "items": {
                    "type": "string"
                  }
                },
                "executable": {
                  "type": "array",
                  "description": "An array with paths of where to find executables.",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^executable$": true,
                "^library$": true,
                "^include$": true,
                "^source$": true,
                "^reference$": true,
                "^exclude$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "paths": {
      "$ref": "#/$defs/modern_2"
    },
    "project-dependency": {
      "type": "object",
      "required": [
        "name2",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the dependency."
        },
        "version": {
          "type": "string",
          "description": "The version of the dependency."
        }
      }
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "oneOf": [
                {
                  "$ref": "#/$defs/project-dependency"
                }
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "oneOf": [
                {
                  "$ref": "#/$defs/project-dependency"
                }
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "platform",
                "output"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the configuration (e.g. Debug, Release, etc.)."
                },
                "warning-level": {
                  "type": "integer",
                  "description": "The warning level used for this configuration."
                },
                "paths": {
                  "type": "object",
                  "description": "The map with all paths.",
                  "oneOf": [
                    {
                      "$ref": "#/$defs/paths"
                    }
                  ]
                },
                "debug": {
                  "type": "boolean",
                  "description": "Whether or not this is a debug configuration."
                },
                "intermediate-dir": {
                  "type": "string",
                  "description": "The directory to output intermediate data to."
                },
                "definitions4": {
                  "type": "array",
                  "description": "A list with definitions4.",
                  "items": {
                    "type": "string"
                  }
                },
                "platform": {
                  "type": "string",
                  "description": "The platform that this configuration is configured for."
                },
                "dependencies": {
                  "type": "array",
                  "description": "A list with project specific dependencies.",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                },
                "pch": {
                  "$ref": "#/$defs/modern_11"
                },
                "output": {
                  "type": "string",
                  "description": "The file or directory to output the compiled binary to."
                }
              }
            },
            {
              "patternProperties": {
                "^dependencies$": true,
                "^definitions4$": true,
                "^name$": true,
                "^warning-level$": true,
                "^paths$": true,
                "^debug$": true,
                "^pch$": true,
                "^intermediate-dir$": true,
                "^output$": true,
                "^platform$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "The precompiled header for this project",
              "required": [
                "header",
                "source"
              ],
              "properties": {
                "header": {
                  "type": "string",
                  "description": "The path that represents the precompiled header."
                },
                "memory": {
                  "type": "integer",
                  "description": "The amount of bytes that is used for the compiler's memory."
                },
                "name": {
                  "type": "string",
                  "description": "The name of the precompiled header."
                },
                "source": {
                  "type": "string",
                  "description": "The path to the source file that compiles the precompiled header."
                }
              }
            },
            {
              "patternProperties": {
                "^header$": true,
                "^memory$": true,
                "^name$": true,
                "^source$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Resolver Package",
              "type": "object",
              "required": [
                "name",
                "description",
                "license",
                "projects"
              ],
              "properties": {
                "website": {
                  "type": "string",
                  "description": "The website for the project.",
                  "format": "uri"
                },
                "name": {
                  "type": "string",
                  "description": "The name of the package."
                },
                "project-dir": {
                  "type": "string",
                  "description": "The name of the ide projects directory."
                },
                "description": {
                  "type": "string",
                  "description": "A description of the package."
                },
                "license": {
                  "type": "string",
                  "description": "The license of the package."
                },
                "authors": {
                  "type": "array",
                  "description": "A list with authors that contributed to the package.",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  }
                },
                "repositories": {
                  "type": "array",
                  "description": "A set of additional repositories where packages can be found.",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                },
                "keywords": {
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "type": "string",
                    "description": "A tag/keyword that this package relates to."
                  }
                },
                "definitions4": {
                  "type": "array",
                  "description": "A list with definitions4 to add to all projects.",
                  "items": {
                    "type": "string"
                  }
                },
                "projects": {
                  "type": "array",
                  "description": "A set with projects that shouls be created in the IDE.",
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  }
                },
                "vendor-dir": {
                  "type": "string",
                  "description": "The name of the vendor directory."
                }
              }
            },
            {
              "patternProperties": {
                "^authors$": true,
                "^projects$": true,
                "^keywords$": true,
                "^description$": true,
                "^definitions4$": true,
                "^repositories$": true,
                "^name$": true,
                "^website$": true,
                "^vendor-dir$": true,
                "^license$": true,
                "^project-dir$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "source": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": [
                "object",
                "string"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the dependency."
                },
                "config": {
                  "type": "string",
                  "description": "The name of the configuration to reference."
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "pch": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "The precompiled header settings.",
              "oneOf": [
                {
                  "$ref": "#/$defs/pch"
                }
              ]
            },
            {
              "patternProperties": {
                ".*": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
