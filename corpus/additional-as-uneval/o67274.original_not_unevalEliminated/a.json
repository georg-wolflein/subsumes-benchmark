{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Resolver Package Repository",
              "type": "object",
              "required": [
                "name",
                "description",
                "homepage"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "The name of the repository."
                },
                "auth": {
                  "$ref": "#/$defs/modern_2"
                },
                "description": {
                  "type": "string",
                  "description": "The description of the repository."
                },
                "web_template": {
                  "type": "string",
                  "description": "The template to use when generating HTML. This can be a name or a path to a template."
                },
                "web_target": {
                  "type": "string",
                  "description": "The directory where the generated HTML will be stored."
                },
                "package_target": {
                  "type": "string",
                  "description": "The directory where the resolver-packages.json file should be generated."
                },
                "homepage": {
                  "type": "string",
                  "description": "The url of the repository."
                },
                "packages": {
                  "type": "array",
                  "description": "The list with packages that exists.",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^description$": true,
                "^web_template$": true,
                "^homepage$": true,
                "^name$": true,
                "^web_target$": true,
                "^packages$": true,
                "^package_target$": true,
                "^auth$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Optional authentication tokens used to request the packages.",
              "properties": {
                "github": {
                  "type": "string",
                  "description": "The Github access token."
                }
              }
            },
            {
              "patternProperties": {
                "^github$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type",
                "url"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "description": "The type of the package."
                },
                "url": {
                  "type": "string",
                  "description": "The url of the package."
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^url$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
