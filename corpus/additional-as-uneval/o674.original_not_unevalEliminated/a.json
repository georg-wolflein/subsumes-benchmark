{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "SemanticVersion": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "major": {
                  "type": "integer",
                  "format": "int32"
                },
                "minor": {
                  "type": "integer",
                  "format": "int32"
                },
                "patch": {
                  "type": "integer",
                  "format": "int32"
                }
              }
            },
            {
              "patternProperties": {
                "^major$": true,
                "^minor$": true,
                "^patch$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Manifest",
              "type": "object",
              "properties": {
                "copyright": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "website": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "repository": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "icon": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "license": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "id": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "authors": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "releaseNotes": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "name": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "branchVersionMap": {
                  "$ref": "#/$defs/modern_3"
                },
                "description": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "tags": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "company": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "version": {
                  "$ref": "#/$defs/SemanticVersion"
                }
              }
            },
            {
              "patternProperties": {
                "^authors$": true,
                "^version$": true,
                "^releaseNotes$": true,
                "^description$": true,
                "^name$": true,
                "^icon$": true,
                "^id$": true,
                "^copyright$": true,
                "^branchVersionMap$": true,
                "^website$": true,
                "^repository$": true,
                "^company$": true,
                "^license$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": [
                "null",
                "object"
              ]
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    }
  }
}
