{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tileType": {
                  "type": "string"
                },
                "ingestType": {
                  "type": "string"
                }
              },
              "required": [
                "tileType",
                "ingestType"
              ]
            },
            {
              "patternProperties": {
                "^tileType$": true,
                "^ingestType$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "properties": {
                "input": {
                  "$ref": "#/$defs/modern_2"
                },
                "output": {
                  "$ref": "#/$defs/modern_3"
                },
                "validation": {
                  "$ref": "#/$defs/modern_4"
                },
                "attributes": {
                  "$ref": "#/$defs/modern_5"
                }
              },
              "required": [
                "input",
                "output",
                "validation",
                "attributes"
              ]
            },
            {
              "patternProperties": {
                "^input$": true,
                "^output$": true,
                "^validation$": true,
                "^attributes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "properties": {
                "format": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "cache": {
                  "type": "string"
                },
                "noData": {
                  "type": "integer"
                },
                "backend": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ]
                },
                "clip": {
                  "type": "object",
                  "properties": {
                    "xmin": {
                      "type": "number"
                    },
                    "ymin": {
                      "type": "number"
                    },
                    "xmax": {
                      "type": "number"
                    },
                    "ymax": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "xmin",
                    "ymin",
                    "xmax",
                    "ymax"
                  ]
                }
              },
              "required": [
                "format",
                "name",
                "backend"
              ]
            },
            {
              "patternProperties": {
                "^clip$": true,
                "^name$": true,
                "^backend$": true,
                "^noData$": true,
                "^cache$": true,
                "^format$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "breaks": {
                  "type": "string"
                },
                "reprojectMethod": {
                  "type": "string"
                },
                "cellSize": {
                  "type": "object",
                  "properties": {
                    "width": {
                      "type": "number"
                    },
                    "height": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "width",
                    "height"
                  ]
                },
                "encoding": {
                  "type": "string"
                },
                "tileSize": {
                  "type": "integer"
                },
                "backend": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "path": {
                      "type": "string"
                    },
                    "profile": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "path"
                  ]
                },
                "partitions": {
                  "type": "integer"
                },
                "crs": {
                  "type": "string"
                },
                "layoutExtent": {
                  "type": "object",
                  "properties": {
                    "xmin": {
                      "type": "number"
                    },
                    "ymin": {
                      "type": "number"
                    },
                    "xmax": {
                      "type": "number"
                    },
                    "ymax": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "xmin",
                    "ymin",
                    "xmax",
                    "ymax"
                  ]
                },
                "maxZoom": {
                  "type": "integer"
                },
                "resolutionThreshold": {
                  "type": "number"
                },
                "pyramid": {
                  "type": "boolean"
                },
                "resampleMethod": {
                  "type": "string"
                },
                "keyIndexMethod": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "layoutScheme": {
                  "type": "string"
                },
                "cellType": {
                  "type": "string"
                }
              },
              "required": [
                "backend",
                "reprojectMethod",
                "tileSize",
                "pyramid",
                "resampleMethod",
                "keyIndexMethod"
              ]
            },
            {
              "patternProperties": {
                "^layoutScheme$": true,
                "^cellSize$": true,
                "^maxZoom$": true,
                "^tileSize$": true,
                "^pyramid$": true,
                "^layoutExtent$": true,
                "^cellType$": true,
                "^crs$": true,
                "^partitions$": true,
                "^encoding$": true,
                "^resampleMethod$": true,
                "^backend$": true,
                "^reprojectMethod$": true,
                "^resolutionThreshold$": true,
                "^breaks$": true,
                "^keyIndexMethod$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tiffLocal": {
                  "type": "string"
                },
                "dateTime": {
                  "type": "string"
                },
                "sampleScale": {
                  "type": "number"
                },
                "resolutionThreshold": {
                  "type": "number"
                },
                "tmpDir": {
                  "type": "string"
                }
              },
              "required": [
                "sampleScale",
                "resolutionThreshold",
                "tmpDir",
                "tiffLocal"
              ]
            },
            {
              "patternProperties": {
                "^tmpDir$": true,
                "^sampleScale$": true,
                "^dateTime$": true,
                "^resolutionThreshold$": true,
                "^tiffLocal$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
