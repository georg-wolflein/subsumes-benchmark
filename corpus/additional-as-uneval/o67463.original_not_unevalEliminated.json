{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minItems",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o67463.original_not_unevalEliminated.json",
  "a": {
    "$id": "http://jslicense.org/schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jslicense",
    "description": "schema for open-source license templates",
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "description": "arrays describing a line of text",
        "oneOf": [
          {
            "description": "non-empty strings",
            "type": "string",
            "pattern": ".+"
          },
          {
            "$ref": "#/$defs/modern_1"
          }
        ]
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "field",
                "type": "object",
                "properties": {
                  "default": {
                    "type": "string"
                  },
                  "field": {
                    "enum": [
                      "year",
                      "organization",
                      "owners"
                    ]
                  },
                  "transform": {
                    "enum": [
                      "upper"
                    ]
                  }
                },
                "required": [
                  "field"
                ]
              },
              {
                "patternProperties": {
                  "^default$": true,
                  "^field$": true,
                  "^transform$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://jslicense.org/schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "jslicense",
    "description": "schema for open-source license templates",
    "type": "array",
    "minItems": 1,
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "description": "arrays describing a line of text",
        "oneOf": [
          {
            "description": "non-empty strings",
            "type": "string",
            "pattern": ".+"
          },
          {
            "description": "field",
            "type": "object",
            "properties": {
              "default": {
                "type": "string"
              },
              "field": {
                "enum": [
                  "year",
                  "organization",
                  "owners"
                ]
              },
              "transform": {
                "enum": [
                  "upper"
                ]
              }
            },
            "required": [
              "field"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
