{
  "$id": "http://jslicense.org/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jslicense",
  "description": "schema for open-source license templates",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "array",
    "minItems": 0,
    "items": {
      "description": "arrays describing a line of text",
      "oneOf": [
        {
          "description": "non-empty strings",
          "type": "string",
          "pattern": ".+"
        },
        {
          "$ref": "#/$defs/modern_1"
        }
      ]
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "field",
              "type": "object",
              "properties": {
                "default": {
                  "type": "string"
                },
                "field": {
                  "enum": [
                    "year",
                    "organization",
                    "owners"
                  ]
                },
                "transform": {
                  "enum": [
                    "upper"
                  ]
                }
              },
              "required": [
                "field"
              ]
            },
            {
              "patternProperties": {
                "^default$": true,
                "^field$": true,
                "^transform$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
