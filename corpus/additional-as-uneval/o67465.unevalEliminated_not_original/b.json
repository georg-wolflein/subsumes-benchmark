{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "name": {
      "type": "string"
    },
    "notify_endpoints": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "description": {
      "type": "string"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[\\w]+:{1}[A-Z][\\w]+$": {
                  "type": "object",
                  "properties": {
                    "notify": {
                      "$ref": "#/$defs/notify"
                    }
                  },
                  "minProperties": 1
                }
              }
            },
            {
              "patternProperties": {
                "^[\\w]+:{1}[A-Z][\\w]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "step_string": {
      "type": "string",
      "pattern": "^[\\w]+:{1}[A-Z][\\w]+$"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "hosts",
                "steps",
                "description"
              ],
              "properties": {
                "hosts": {
                  "$ref": "#/$defs/hosts"
                },
                "steps": {
                  "$ref": "#/$defs/steps"
                },
                "preflight": {
                  "$ref": "#/$defs/steps"
                },
                "description": {
                  "$ref": "#/$defs/description"
                }
              }
            },
            {
              "patternProperties": {
                "^hosts$": true,
                "^steps$": true,
                "^preflight$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step_types"
      }
    },
    "step_object": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Playbook syntax definition",
              "description": "Playbooks are documents which describe the exact set of steps required to successfully start and finish a given software release. When the Release Engine begins a deployment, the actions it takes come directly from playbooks. For more information: http://release-engine.readthedocs.org/en/latest/playbooks.html",
              "properties": {
                "execution": {
                  "$ref": "#/$defs/execution"
                },
                "group": {
                  "$ref": "#/$defs/group"
                },
                "name": {
                  "$ref": "#/$defs/name"
                }
              },
              "required": [
                "execution",
                "name",
                "group"
              ]
            },
            {
              "patternProperties": {
                "^execution$": true,
                "^group$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "execution": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_3"
      }
    },
    "notify": {
      "$ref": "#/$defs/modern_4"
    },
    "group": {
      "type": "string"
    },
    "step_types": {
      "anyOf": [
        {
          "$ref": "#/$defs/step_string"
        },
        {
          "$ref": "#/$defs/step_object"
        }
      ]
    },
    "dynamic": {
      "type": "array",
      "items": {
        "type": "string",
        "minItems": 1
      }
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "started": {
                  "$ref": "#/$defs/notify_endpoints"
                },
                "completed": {
                  "$ref": "#/$defs/notify_endpoints"
                },
                "failed": {
                  "$ref": "#/$defs/notify_endpoints"
                }
              }
            },
            {
              "patternProperties": {
                "^started$": true,
                "^completed$": true,
                "^failed$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
