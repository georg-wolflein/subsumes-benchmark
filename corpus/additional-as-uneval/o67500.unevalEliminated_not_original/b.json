{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "glob": {
                  "description": "The pattern to match.",
                  "type": "string"
                },
                "input": {
                  "description": "The input directory path in which to apply 'glob'. Defaults to the project root.",
                  "type": "string"
                },
                "output": {
                  "description": "Absolute path within the output.",
                  "type": "string"
                }
              },
              "required": [
                "glob",
                "input",
                "output"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^glob$": true,
                "^input$": true,
                "^output$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "additionalTargets": {
                  "default": [],
                  "description": "List of additional targets that should be run",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "buildTarget": {
                  "default": "packagr",
                  "description": "The target used to build the library with the ng-packagr",
                  "type": "string"
                },
                "ngVersionPlaceholder": {
                  "default": "{{NG_VERSION}}",
                  "description": "The placeholder string that gets replaced by the corresponding angular versions for the package in your package.json",
                  "type": "string"
                },
                "versionPlaceholder": {
                  "default": "{{VERSION}}",
                  "description": "The placeholder string that gets replaced by the corresponding version in your package.json",
                  "type": "string"
                }
              },
              "required": [
                "buildTarget"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^additionalTargets$": true,
                "^buildTarget$": true,
                "^ngVersionPlaceholder$": true,
                "^versionPlaceholder$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "assetPattern": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
