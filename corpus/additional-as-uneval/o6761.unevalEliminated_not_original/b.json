{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "This section is optional for the provision of information about the overall submission.",
              "description": "An explanation about the purpose of this instance described by this schema.",
              "name": "/",
              "properties": {
                "record_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "preprintyear": {
                  "type": "string",
                  "title": "Preprint Year",
                  "description": "Indicates the year when the submission preprint was first available.",
                  "name": "preprintyear"
                },
                "associated_records": {
                  "type": "array",
                  "description": "Links to other HEPData Submissions or INSPIRE Records that relate to this submission.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "identifier": {
                        "type": [
                          "string",
                          "number"
                        ]
                      },
                      "description": {
                        "type": "string"
                      },
                      "url": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "identifier",
                      "type"
                    ]
                  }
                },
                "modifications": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "comment": {
                  "type": "string",
                  "title": "Comment.",
                  "description": "Information that applies to all data tables.",
                  "name": "comment"
                },
                "dateupdated": {
                  "type": "string",
                  "title": "Date Updated",
                  "description": "Indicates when the submission was last updated.",
                  "name": "dateupdated"
                },
                "additional_resources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "location": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "license": {
                        "$ref": "#/$defs/modern_4"
                      }
                    },
                    "required": [
                      "location"
                    ]
                  }
                },
                "publicationyear": {
                  "type": "string",
                  "title": "Publication Year",
                  "description": "Indicates the year when the submission publication was available.",
                  "name": "publicationyear"
                }
              }
            },
            {
              "patternProperties": {
                "^dateupdated$": true,
                "^additional_resources$": true,
                "^preprintyear$": true,
                "^modifications$": true,
                "^associated_records$": true,
                "^publicationyear$": true,
                "^comment$": true,
                "^record_ids$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": [
                    "string"
                  ]
                },
                "id": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "required": [
                "type",
                "id"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "action": {
                  "type": "string"
                },
                "who": {
                  "type": "string"
                }
              },
              "required": [
                "action",
                "who"
              ]
            },
            {
              "patternProperties": {
                "^action$": true,
                "^who$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "url"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^url$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
