{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "header": {
                  "$ref": "#/$defs/modern_6"
                },
                "qualifiers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  }
                },
                "values": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^header$": true,
                "^qualifiers$": true,
                "^values$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^units$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "independent_variables": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "required": [
                    "0"
                  ]
                },
                "dependent_variables": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  }
                },
                "name": {
                  "type": "string",
                  "title": "Name.",
                  "description": "Used to reference a data record when everything is in the same file.",
                  "name": "name"
                }
              },
              "required": [
                "independent_variables",
                "dependent_variables"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^independent_variables$": true,
                "^dependent_variables$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "units": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^value$": true,
                "^units$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "header": {
                  "$ref": "#/$defs/modern_3"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "header",
                "values"
              ]
            },
            {
              "patternProperties": {
                "^header$": true,
                "^values$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_9"
                  }
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^errors$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "symerror": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "asymerror": {
                  "type": "object",
                  "properties": {
                    "minus": {
                      "type": [
                        "number",
                        "string"
                      ]
                    },
                    "plus": {
                      "type": [
                        "number",
                        "string"
                      ]
                    }
                  }
                },
                "label": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^symerror$": true,
                "^asymerror$": true,
                "^label$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^units$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^value$": true,
                "^low$": true,
                "^high$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
