{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "some_variables": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "required": [
                    "0"
                  ]
                },
                "name": {
                  "type": "string",
                  "title": "Name.",
                  "description": "Used to reference a data record when everything is in the same file.",
                  "name": "name"
                }
              },
              "required": [
                "some_variables"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^some_variables$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "header": {
                  "$ref": "#/$defs/modern_3"
                },
                "values": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "header",
                "values"
              ]
            },
            {
              "patternProperties": {
                "^header$": true,
                "^values$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "units": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^units$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": [
                    "string",
                    "number"
                  ]
                },
                "low": {
                  "type": "number"
                },
                "high": {
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^value$": true,
                "^low$": true,
                "^high$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
