{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Artifacts to be fetched from Koji builds",
  "type": [
    "array",
    "null"
  ],
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "A specific Koji buid and archives to be fetched",
              "properties": {
                "nvr": {
                  "description": "The Name-Version-Release of a Koji build",
                  "type": "string"
                },
                "archives": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "nvr"
              ]
            },
            {
              "patternProperties": {
                "^nvr$": true,
                "^archives$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Matcher for archives in Koji build",
              "properties": {
                "filename": {
                  "description": "Match by archive filename - supports glob matching",
                  "type": "string"
                },
                "group_id": {
                  "description": "Match by archive group_id",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^filename$": true,
                "^group_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
