{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "type": "array",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "helpUrl": {
                  "type": "string"
                },
                "componentClasses": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "screenshotUrl": {
                  "type": "string"
                },
                "installerClass": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "markerClass": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "canUninstall": {
                  "type": "boolean"
                },
                "vendor": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "versions": {
                  "patternProperties": {
                    "^\\d+(\\.\\d+)*(-\\w+)?$": {
                      "$ref": "#/$defs/modern_2"
                    }
                  },
                  "properties": {
                    "": {
                      "$ref": "#/$defs/modern_3"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "description",
                "helpUrl",
                "id",
                "markerClass",
                "name",
                "screenshotUrl",
                "vendor",
                "versions"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^helpUrl$": true,
                "^componentClasses$": true,
                "^name$": true,
                "^id$": true,
                "^installerClass$": true,
                "^vendor$": true,
                "^canUninstall$": true,
                "^markerClass$": true,
                "^description$": true,
                "^screenshotUrl$": true,
                "^versions$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "changes": {
                  "type": "string"
                },
                "depends": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "downloadUrl": {
                  "type": [
                    "null",
                    "string"
                  ]
                },
                "libs": {
                  "patternProperties": {
                    ".+": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "downloadUrl"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^changes$": true,
                "^depends$": true,
                "^downloadUrl$": true,
                "^libs$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "downloadUrl": {
                  "type": "string"
                },
                "libs": {
                  "patternProperties": {
                    ".+": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                }
              },
              "required": [
                "downloadUrl"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^downloadUrl$": true,
                "^libs$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
