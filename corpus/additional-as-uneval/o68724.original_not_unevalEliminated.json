{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o68724.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Environment Transports",
                "description": "Information about the Resource API Transports in a Puppet code environment",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "The name of the environment queried",
                    "type": "string"
                  },
                  "transports": {
                    "description": "A list of available transports for this environment",
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additonalProperties": false,
                      "properties": {
                        "name": {
                          "description": "The machine readable name of the transport",
                          "type": "string"
                        },
                        "desc": {
                          "description": "The human readable description of the transport this schema specifies",
                          "type": "string"
                        },
                        "connection_info": {
                          "$ref": "#/$defs/modern_2"
                        }
                      }
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^transports$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object"
              },
              {
                "additionalProperties": {
                  "type": "object",
                  "required": [
                    "type",
                    "desc"
                  ],
                  "properties": {
                    "type": {
                      "description": "The PCore type of the connection info property",
                      "type": "string"
                    },
                    "desc": {
                      "description": "The description of the connection info property",
                      "type": "string"
                    },
                    "sensitive": {
                      "description": "Whether or not the connection info property should be considered sensitive",
                      "type": "boolean"
                    }
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Environment Transports",
    "description": "Information about the Resource API Transports in a Puppet code environment",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "name": {
        "description": "The name of the environment queried",
        "type": "string"
      },
      "transports": {
        "description": "A list of available transports for this environment",
        "type": "array",
        "items": {
          "type": "object",
          "additonalProperties": false,
          "properties": {
            "name": {
              "description": "The machine readable name of the transport",
              "type": "string"
            },
            "desc": {
              "description": "The human readable description of the transport this schema specifies",
              "type": "string"
            },
            "connection_info": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "type",
                  "desc"
                ],
                "properties": {
                  "type": {
                    "description": "The PCore type of the connection info property",
                    "type": "string"
                  },
                  "desc": {
                    "description": "The description of the connection info property",
                    "type": "string"
                  },
                  "sensitive": {
                    "description": "Whether or not the connection info property should be considered sensitive",
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
