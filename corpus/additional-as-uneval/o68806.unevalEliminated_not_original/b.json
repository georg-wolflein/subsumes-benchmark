{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Result from processing a (plugin, instance) pair",
              "properties": {
                "plugin": {
                  "description": "Name of processed plug-in",
                  "type": "string"
                },
                "duration": {
                  "description": "Time in milliseconds taken to process a pair",
                  "type": "number"
                },
                "success": {
                  "description": "Status of processing",
                  "type": "boolean"
                },
                "instance": {
                  "description": "Name of processed instance or null if no instance were processed",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "error": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/Error"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "records": {
                  "items": {
                    "$ref": "#/$defs/Record"
                  },
                  "type": "array"
                }
              },
              "title": "Result",
              "type": "object"
            },
            {
              "patternProperties": {
                "^duration$": true,
                "^success$": true,
                "^plugin$": true,
                "^instance$": true,
                "^error$": true,
                "^records$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Error": {
      "properties": {
        "fname": {
          "description": "Name of file from which the exception was thrown",
          "type": "string"
        },
        "line_number": {
          "description": "Line at which exception occurred",
          "type": "number"
        },
        "message": {
          "description": "Message passed to exception",
          "type": "string"
        },
        "func": {
          "description": "Name of function from which the exception was thrown",
          "type": "string"
        },
        "exc": {
          "description": "Message from extracted traceback (should be identical to `message`)",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "type": "object"
    },
    "Record": {
      "properties": {
        "name": true,
        "msecs": true,
        "exc_text": true,
        "funcName": true,
        "thread": true,
        "filename": true,
        "levelno": true,
        "exc_info": true,
        "created": true,
        "lineno": true,
        "module": true,
        "process": true,
        "pathname": true,
        "levelname": true,
        "processName": true,
        "message": {
          "type": "string"
        },
        "args": true,
        "relativeCreated": true,
        "threadName": true
      },
      "required": [
        "message"
      ],
      "type": "object"
    }
  }
}
