{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "number": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "questions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  }
                },
                "id": {
                  "$ref": "#/$defs/id"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "questions"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^number$": true,
                "^id$": true,
                "^questions$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "meta": {
                  "type": "string"
                },
                "condition": {
                  "enum": [
                    "equals",
                    "not equals",
                    "contains",
                    "not set"
                  ]
                },
                "value": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                }
              },
              "required": [
                "condition"
              ],
              "oneOf": [
                {
                  "required": [
                    "id"
                  ]
                },
                {
                  "required": [
                    "meta"
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^meta$": true,
                "^condition$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "number": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "answers": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                },
                "guidance": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "title": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string"
                      },
                      "list": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "id": {
                  "$ref": "#/$defs/id"
                },
                "skip_condition": {
                  "$ref": "#/$defs/modern_9"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "General",
                    "DateRange",
                    "RepeatingAnswer",
                    "Relationship"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "type",
                "answers"
              ]
            },
            {
              "patternProperties": {
                "^skip_condition$": true,
                "^description$": true,
                "^type$": true,
                "^id$": true,
                "^answers$": true,
                "^title$": true,
                "^guidance$": true,
                "^number$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "id": {
      "type": "string",
      "description": "A lowercase alphanumeric string separated by hyphens.",
      "pattern": "^[a-z0-9][a-z0-9\\-]*[a-z0-9]$"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "mandatory": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "id": {
                  "$ref": "#/$defs/id"
                },
                "repeats": {
                  "type": "boolean"
                },
                "type": {
                  "enum": [
                    "Checkbox",
                    "Currency",
                    "Date",
                    "MonthYearDate",
                    "Integer",
                    "Percentage",
                    "PositiveInteger",
                    "Radio",
                    "TextArea",
                    "TextField",
                    "Relationship"
                  ]
                },
                "options": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "value": {
                        "type": "string"
                      },
                      "q_code": {
                        "type": "string",
                        "pattern": "[0-9]+"
                      }
                    },
                    "required": [
                      "label",
                      "value"
                    ]
                  }
                },
                "alias": {
                  "type": "string"
                },
                "guidance": {
                  "type": "string"
                },
                "q_code": {
                  "type": "string",
                  "pattern": "[0-9]+"
                },
                "validation": {
                  "type": "object",
                  "properties": {
                    "messages": {
                      "$ref": "#/$defs/messages"
                    }
                  }
                }
              },
              "required": [
                "id",
                "type",
                "mandatory"
              ]
            },
            {
              "patternProperties": {
                "^repeats$": true,
                "^options$": true,
                "^label$": true,
                "^guidance$": true,
                "^type$": true,
                "^id$": true,
                "^validation$": true,
                "^mandatory$": true,
                "^q_code$": true,
                "^alias$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Allows a question to be skipped when a condition has been met.",
              "type": "object",
              "properties": {
                "when": {
                  "$ref": "#/$defs/when"
                }
              },
              "required": [
                "when"
              ]
            },
            {
              "patternProperties": {
                "^when$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "mime_type",
                "schema_version",
                "data_version",
                "questionnaire_id",
                "survey_id",
                "title",
                "groups",
                "theme",
                "legal_basis"
              ],
              "properties": {
                "messages": {
                  "$ref": "#/$defs/messages"
                },
                "introduction": {
                  "type": "object",
                  "properties": {
                    "description": {
                      "type": "string"
                    },
                    "information_to_provide": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "_uniqueItems": true
                    }
                  }
                },
                "data_version": {
                  "enum": [
                    "0.0.1",
                    "0.0.2"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "schema_version": {
                  "type": "string"
                },
                "legal_basis": {
                  "enum": [
                    "Voluntary",
                    "StatisticsOfTradeAct"
                  ]
                },
                "groups": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                },
                "questionnaire_id": {
                  "type": "string"
                },
                "mime_type": {
                  "type": "string"
                },
                "navigation": {
                  "type": "boolean"
                },
                "title": {
                  "type": "string"
                },
                "theme": {
                  "type": "string"
                },
                "survey_id": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^theme$": true,
                "^description$": true,
                "^groups$": true,
                "^questionnaire_id$": true,
                "^messages$": true,
                "^mime_type$": true,
                "^navigation$": true,
                "^survey_id$": true,
                "^schema_version$": true,
                "^legal_basis$": true,
                "^introduction$": true,
                "^title$": true,
                "^data_version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "when": {
      "type": "array",
      "description": "Configure conditional rules. By adding more than one `condition` element it will evaluate as an and rule.",
      "items": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "blocks": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  }
                },
                "routing_rules": {
                  "ref": "#/definitions4/routing_rules"
                },
                "completed_id": {
                  "type": "string"
                },
                "id": {
                  "$ref": "#/$defs/id"
                },
                "highlight_when": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "_uniqueItems": true
                },
                "title": {
                  "type": "string"
                },
                "hide_in_navigation": {
                  "type": "boolean"
                },
                "skip_condition": {
                  "description": "Allows a group to be skipped when a condition has been met. By adding more than one `when` element it will evaluate as an or rule.",
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "properties": {
                    "when": {
                      "$ref": "#/$defs/when"
                    }
                  },
                  "required": [
                    "when"
                  ]
                }
              },
              "required": [
                "id",
                "title",
                "blocks"
              ]
            },
            {
              "patternProperties": {
                "^skip_condition$": true,
                "^highlight_when$": true,
                "^routing_rules$": true,
                "^blocks$": true,
                "^hide_in_navigation$": true,
                "^title$": true,
                "^completed_id$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "sections": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                },
                "description": {
                  "type": "string"
                },
                "routing_rules": {
                  "ref": "#/definitions4/routing_rules"
                },
                "id": {
                  "$ref": "#/$defs/id"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "sections"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^routing_rules$": true,
                "^type$": true,
                "^id$": true,
                "^sections$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "messages": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "INVALID_DATE": {
                  "type": "string"
                },
                "INTEGER_TOO_LARGE": {
                  "type": "string"
                },
                "NOT_STRING": {
                  "type": "string"
                },
                "NOT_INTEGER": {
                  "type": "string"
                },
                "MANDATORY": {
                  "type": "string"
                },
                "INVALID_DATE_RANGE_TO_FROM_SAME": {
                  "type": "string"
                },
                "INVALID_DATE_RANGE_TO_BEFORE_FROM": {
                  "type": "string"
                },
                "NEGATIVE_INTEGER": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^INTEGER_TOO_LARGE$": true,
                "^INVALID_DATE_RANGE_TO_FROM_SAME$": true,
                "^NOT_INTEGER$": true,
                "^NEGATIVE_INTEGER$": true,
                "^NOT_STRING$": true,
                "^INVALID_DATE_RANGE_TO_BEFORE_FROM$": true,
                "^INVALID_DATE$": true,
                "^MANDATORY$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "routing_rules": {
      "type": "array",
      "navigation_label_answer_ids": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "_uniqueItems": true
      },
      "items": {
        "type": "object",
        "properties": {
          "goto": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "when": {
                "$ref": "#/$defs/when"
              }
            },
            "required": [
              "id"
            ]
          },
          "repeat": {
            "type": "object",
            "properties": {
              "answer_id": {
                "type": "string"
              },
              "goto": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "answer_value",
                  "answer_count",
                  "answer_count_minus_one"
                ]
              }
            },
            "required": [
              "answer_id"
            ]
          }
        },
        "oneOf": [
          {
            "required": [
              "goto"
            ]
          },
          {
            "required": [
              "repeat"
            ]
          }
        ]
      }
    }
  }
}
