{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "_comment": "The contents of this file must be in sync with the parameters of the add_interface command",
              "dependentRequired": {
                "vendor": [
                  "model"
                ]
              },
              "properties": {
                "mac": {
                  "type": "string"
                },
                "model": {
                  "type": "string"
                },
                "boot": {
                  "type": "boolean"
                },
                "iftype": {
                  "type": "string"
                },
                "bus_address": {
                  "type": "string"
                },
                "vendor": {
                  "type": "string"
                },
                "automac": {
                  "type": "boolean"
                },
                "comments": {
                  "type": "string"
                },
                "autopg": {
                  "type": "boolean"
                },
                "pg": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^model$": true,
                "^autopg$": true,
                "^iftype$": true,
                "^boot$": true,
                "^vendor$": true,
                "^bus_address$": true,
                "^comments$": true,
                "^automac$": true,
                "^mac$": true,
                "^pg$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
