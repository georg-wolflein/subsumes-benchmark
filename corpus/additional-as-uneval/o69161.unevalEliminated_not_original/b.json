{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Network device discovery schema",
  "type": "object",
  "properties": {
    "serial": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interfaces": {
      "$ref": "#/$defs/modern_1"
    },
    "router_ips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "vendor": {
      "type": "string"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "ip": {
                      "$ref": "#/$defs/modern_2"
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^.*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
