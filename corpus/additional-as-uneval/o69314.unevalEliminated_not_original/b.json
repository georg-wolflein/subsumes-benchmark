{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "firstname": {
                  "type": "string"
                },
                "id": {
                  "type": "integer"
                },
                "lastname": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^firstname$": true,
                "^id$": true,
                "^lastname$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
