{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "containerPort": {
                  "maximum": 65535.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "hostPort": {
                  "maximum": 65535.0,
                  "minimum": 0.0,
                  "type": "integer"
                },
                "protocol": {
                  "type": "string"
                },
                "servicePort": {
                  "maximum": 65535.0,
                  "minimum": 0.0,
                  "type": "integer"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^containerPort$": true,
                "^hostPort$": true,
                "^protocol$": true,
                "^servicePort$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "value"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "maximumOverCapacity": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                },
                "minimumHealthCapacity": {
                  "maximum": 1.0,
                  "minimum": 0.0,
                  "type": "number"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^maximumOverCapacity$": true,
                "^minimumHealthCapacity$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "not": {
                "allOf": [
                  {
                    "required": [
                      "cmd"
                    ]
                  },
                  {
                    "required": [
                      "args"
                    ]
                  }
                ]
              },
              "properties": {
                "storeUrls": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "acceptedResourceRoles": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "instances": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "cmd": {
                  "minLength": 1,
                  "type": "string"
                },
                "id": {
                  "pattern": "^/?(([a-z0-9]|[a-z0-9][a-z0-9\\-]*[a-z0-9])\\.)*([a-z0-9]|[a-z0-9][a-z0-9\\-]*[a-z0-9])$",
                  "type": "string"
                },
                "backoffFactor": {
                  "minimum": 1.0,
                  "type": "number"
                },
                "labels": {
                  "$ref": "#/$defs/modern_2"
                },
                "cpus": {
                  "minimum": 0.0,
                  "type": "number"
                },
                "maxLaunchDelaySeconds": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "executor": {
                  "pattern": "^(|\\/\\/cmd|\\/?[^\\/]+(\\/[^\\/]+)*)$",
                  "type": "string"
                },
                "env": {
                  "patternProperties": {
                    ".*": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "backoffSeconds": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "requirePorts": {
                  "type": "boolean"
                },
                "disk": {
                  "minimum": 0.0,
                  "type": "number"
                },
                "container": {
                  "$ref": "#/$defs/modern_3"
                },
                "ports": {
                  "items": {
                    "maximum": 65535.0,
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "uris": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "healthChecks": {
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  },
                  "type": "array"
                },
                "version": {
                  "format": "date-time",
                  "type": "string"
                },
                "constraints": true,
                "mem": {
                  "minimum": 0.0,
                  "type": "number"
                },
                "upgradeStrategy": {
                  "$ref": "#/$defs/modern_10"
                },
                "args": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "dependencies": {
                  "items": {
                    "$ref": "#/$defs/pathType"
                  },
                  "type": "array"
                },
                "user": {
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^version$": true,
                "^cpus$": true,
                "^dependencies$": true,
                "^instances$": true,
                "^container$": true,
                "^labels$": true,
                "^maxLaunchDelaySeconds$": true,
                "^uris$": true,
                "^cmd$": true,
                "^id$": true,
                "^executor$": true,
                "^disk$": true,
                "^requirePorts$": true,
                "^constraints$": true,
                "^backoffFactor$": true,
                "^ports$": true,
                "^args$": true,
                "^user$": true,
                "^env$": true,
                "^upgradeStrategy$": true,
                "^backoffSeconds$": true,
                "^healthChecks$": true,
                "^mem$": true,
                "^acceptedResourceRoles$": true,
                "^storeUrls$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "containerPath": {
                  "type": "string"
                },
                "hostPath": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^containerPath$": true,
                "^hostPath$": true,
                "^mode$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "timeoutSeconds": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "path": {
                  "type": "string"
                },
                "portIndex": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "command": {
                  "items": {
                    "$ref": "#/$defs/modern_9"
                  },
                  "type": "object"
                },
                "gracePeriodSeconds": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "maxConsecutiveFailures": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "ignoreHttp1xx": {
                  "type": "boolean"
                },
                "intervalSeconds": {
                  "minimum": 0.0,
                  "type": "integer"
                },
                "protocol": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^ignoreHttp1xx$": true,
                "^portIndex$": true,
                "^timeoutSeconds$": true,
                "^gracePeriodSeconds$": true,
                "^protocol$": true,
                "^intervalSeconds$": true,
                "^path$": true,
                "^command$": true,
                "^maxConsecutiveFailures$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "value": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "docker": {
                  "$ref": "#/$defs/modern_4"
                },
                "type": {
                  "type": "string"
                },
                "volumes": {
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^docker$": true,
                "^type$": true,
                "^volumes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "pathType": {
      "pattern": "^(\\/?((\\.{2})|([a-z0-9\\-]*))($|\\/))*$",
      "type": "string"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "network": {
                  "type": "string"
                },
                "portMappings": {
                  "items": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "type": "array"
                },
                "image": {
                  "type": "string"
                },
                "forcePullImage": {
                  "type": "boolean"
                },
                "privileged": {
                  "type": "boolean"
                },
                "parameters": {
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  },
                  "type": "array"
                }
              },
              "required": [
                "image"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^forcePullImage$": true,
                "^parameters$": true,
                "^network$": true,
                "^portMappings$": true,
                "^image$": true,
                "^privileged$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
