{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "^[a-zA-Z0-9._-]+$": {
                  "$ref": "#/$defs/service"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^[a-zA-Z0-9._-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "list_or_dict": {
      "oneOf": [
        {
          "$ref": "#/$defs/modern_1"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                ".+": {
                  "type": [
                    "string",
                    "number",
                    "null",
                    "boolean"
                  ]
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                ".+": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "dependentRequired": {
                "memswap_limit": [
                  "mem_limit"
                ]
              },
              "properties": {
                "device_read_bps": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "image": {
                  "type": "string"
                },
                "lb_config": {
                  "type": "object"
                },
                "volume_driver": {
                  "type": "string"
                },
                "blkio_weight": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "user": {
                  "type": "string"
                },
                "dns": {
                  "$ref": "#/$defs/string_or_list"
                },
                "userdata": {
                  "type": "string"
                },
                "ulimits": {
                  "patternProperties": {
                    "^[a-z]+$": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "$ref": "#/$defs/modern_3"
                        }
                      ]
                    }
                  },
                  "type": "object"
                },
                "stop_signal": {
                  "type": "string"
                },
                "device_read_iops": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "group_add": {
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "sysctls": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "network_driver": {
                  "type": "object"
                },
                "certs": {
                  "$ref": "#/$defs/list_of_strings"
                },
                "dockerfile": {
                  "type": "string"
                },
                "cpu_quota": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "shm_size": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "hostname": {
                  "type": "string"
                },
                "log_opt": {
                  "type": "object"
                },
                "blkio_weight_device": {
                  "$ref": "#/$defs/list_of_strings"
                },
                "dns_search": {
                  "$ref": "#/$defs/string_or_list"
                },
                "scale": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "external_ips": {
                  "$ref": "#/$defs/list_of_strings"
                },
                "scale_policy": {
                  "type": "object"
                },
                "read_only": {
                  "type": "boolean"
                },
                "cgroup_parent": {
                  "type": "string"
                },
                "env_file": {
                  "$ref": "#/$defs/string_or_list"
                },
                "domainname": {
                  "type": "string"
                },
                "isolation": {
                  "type": "string"
                },
                "build": {
                  "type": "string"
                },
                "ports": {
                  "items": {
                    "format": "ports",
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "load_balancer_config": {
                  "type": "object"
                },
                "extra_hosts": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "cap_drop": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "health_check": {
                  "type": "object"
                },
                "ipc": {
                  "type": "string"
                },
                "cpu_shares": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "mem_reservation": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "upgrade_strategy": {
                  "type": "object"
                },
                "disks": {
                  "type": "array"
                },
                "command": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "oom_score_adj": {
                  "maximum": 1000.0,
                  "minimum": -1000.0,
                  "type": "integer"
                },
                "volumes": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "net": {
                  "type": "string"
                },
                "mac_address": {
                  "type": "string"
                },
                "entrypoint": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "cpuset": {
                  "type": "string"
                },
                "links": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "default_cert": {
                  "type": "string"
                },
                "log_driver": {
                  "type": "string"
                },
                "pid": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stdin_open": {
                  "type": "boolean"
                },
                "labels": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "cpu_period": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "container_name": {
                  "type": "string"
                },
                "memswap_limit": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "environment": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "expose": {
                  "items": {
                    "format": "expose",
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "security_opt": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "dns_opt": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "uts": {
                  "type": "string"
                },
                "working_dir": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object"
                },
                "extends": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/modern_4"
                    }
                  ]
                },
                "tty": {
                  "type": "boolean"
                },
                "device_write_iops": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "external_links": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "start_on_create": {
                  "type": "boolean"
                },
                "device_write_bps": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "privileged": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string"
                },
                "restart": {
                  "type": "string"
                },
                "vcpu": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "storage_driver": {
                  "type": "object"
                },
                "oom_kill_disable": {
                  "type": "boolean"
                },
                "init": {
                  "type": "boolean"
                },
                "devices": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "volumes_from": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "mem_swappiness": {
                  "type": "integer"
                },
                "cap_add": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "mem_limit": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "memory": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "retain_ip": {
                  "type": "boolean"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^lb_config$": true,
                "^description$": true,
                "^memswap_limit$": true,
                "^env_file$": true,
                "^device_read_iops$": true,
                "^mem_swappiness$": true,
                "^metadata$": true,
                "^volumes$": true,
                "^tty$": true,
                "^group_add$": true,
                "^net$": true,
                "^health_check$": true,
                "^vcpu$": true,
                "^cpu_period$": true,
                "^extends$": true,
                "^pid$": true,
                "^external_links$": true,
                "^volumes_from$": true,
                "^extra_hosts$": true,
                "^ports$": true,
                "^user$": true,
                "^default_cert$": true,
                "^ipc$": true,
                "^uts$": true,
                "^container_name$": true,
                "^image$": true,
                "^privileged$": true,
                "^mem_limit$": true,
                "^security_opt$": true,
                "^mac_address$": true,
                "^working_dir$": true,
                "^device_write_bps$": true,
                "^dns_opt$": true,
                "^init$": true,
                "^labels$": true,
                "^volume_driver$": true,
                "^cpuset$": true,
                "^log_opt$": true,
                "^cpu_quota$": true,
                "^hostname$": true,
                "^network_driver$": true,
                "^environment$": true,
                "^cap_drop$": true,
                "^oom_kill_disable$": true,
                "^dns_search$": true,
                "^stdin_open$": true,
                "^links$": true,
                "^upgrade_strategy$": true,
                "^stop_signal$": true,
                "^scale$": true,
                "^ulimits$": true,
                "^entrypoint$": true,
                "^blkio_weight_device$": true,
                "^type$": true,
                "^scale_policy$": true,
                "^external_ips$": true,
                "^retain_ip$": true,
                "^userdata$": true,
                "^shm_size$": true,
                "^cpu_shares$": true,
                "^dns$": true,
                "^devices$": true,
                "^cap_add$": true,
                "^memory$": true,
                "^domainname$": true,
                "^disks$": true,
                "^device_write_iops$": true,
                "^dockerfile$": true,
                "^start_on_create$": true,
                "^sysctls$": true,
                "^blkio_weight$": true,
                "^command$": true,
                "^load_balancer_config$": true,
                "^oom_score_adj$": true,
                "^device_read_bps$": true,
                "^cgroup_parent$": true,
                "^restart$": true,
                "^storage_driver$": true,
                "^expose$": true,
                "^read_only$": true,
                "^mem_reservation$": true,
                "^isolation$": true,
                "^certs$": true,
                "^log_driver$": true,
                "^build$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "string_or_list": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/list_of_strings"
        }
      ]
    },
    "service": {
      "$ref": "#/$defs/modern_2"
    },
    "constraints": {
      "service": {
        "anyOf": [
          {
            "not": {
              "required": [
                "image"
              ]
            },
            "required": [
              "build"
            ]
          },
          {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "build"
                  ]
                },
                {
                  "required": [
                    "dockerfile"
                  ]
                }
              ]
            },
            "required": [
              "image"
            ]
          }
        ],
        "id": "#/definitions4/constraints/service"
      }
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "hard": {
                  "type": "integer"
                },
                "soft": {
                  "type": "integer"
                }
              },
              "required": [
                "soft",
                "hard"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^hard$": true,
                "^soft$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "list_of_strings": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "file": {
                  "type": "string"
                },
                "service": {
                  "type": "string"
                }
              },
              "required": [
                "service"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^file$": true,
                "^service$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
