{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Subscribe user",
  "properties": {
    "users": {
      "items": {
        "$ref": "#/$defs/user_subscription"
      },
      "type": "array"
    }
  },
  "required": [
    "users"
  ],
  "title": "Bulk Subscribe",
  "type": "object",
  "$defs": {
    "user_subscription": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "list_id"
          ],
          "title": "Required list_id"
        },
        {
          "required": [
            "list_code"
          ],
          "title": "Required list_code"
        }
      ],
      "properties": {
        "email": {
          "format": "email",
          "type": "string"
        },
        "list_code": {
          "type": "string"
        },
        "list_id": {
          "type": "integer"
        },
        "subscribe": {
          "type": "boolean"
        },
        "user_id": {
          "type": "integer"
        },
        "utm_params": {
          "type": "object"
        },
        "variant_id": {
          "type": "integer"
        }
      },
      "required": [
        "email",
        "user_id",
        "subscribe"
      ],
      "type": "object"
    }
  }
}
