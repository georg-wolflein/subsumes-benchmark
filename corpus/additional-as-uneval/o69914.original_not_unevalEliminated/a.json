{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "anyOf": [
                {
                  "required": [
                    "list_id"
                  ],
                  "title": "Required list_id"
                },
                {
                  "required": [
                    "list_code"
                  ],
                  "title": "Required list_code"
                }
              ],
              "description": "Subscribe user",
              "examples": [
                {
                  "email": "test@test.com",
                  "list_id": 1,
                  "user_id": 1,
                  "variant_id": 1
                },
                {
                  "email": "test@test.com",
                  "list_code": "123",
                  "user_id": 1,
                  "variant_id": null
                }
              ],
              "properties": {
                "email": {
                  "_format": "email",
                  "type": "string"
                },
                "user_id": {
                  "type": "integer"
                },
                "variant_id": {
                  "type": "integer"
                },
                "list_code": {
                  "type": "string"
                },
                "list_id": {
                  "type": "integer"
                }
              },
              "required": [
                "email",
                "user_id"
              ],
              "title": "Subscribe",
              "type": "object"
            },
            {
              "patternProperties": {
                "^list_id$": true,
                "^variant_id$": true,
                "^list_code$": true,
                "^email$": true,
                "^user_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
