{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Get user preferences",
              "examples": [
                {
                  "email": "test@test.com",
                  "subscribed": true,
                  "user_id": 1
                }
              ],
              "properties": {
                "email": {
                  "_format": "email",
                  "type": "string"
                },
                "subscribed": {
                  "type": "boolean"
                },
                "user_id": {
                  "type": "integer"
                }
              },
              "required": [
                "email",
                "user_id"
              ],
              "title": "User preferences",
              "type": "object"
            },
            {
              "patternProperties": {
                "^email$": true,
                "^subscribed$": true,
                "^user_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
