{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Schema for loan",
              "type": "object",
              "required": [
                "pid",
                "$schema",
                "state"
              ],
              "properties": {
                "start_date": {
                  "type": "string",
                  "format": "date-time",
                  "title": "Transaction start date"
                },
                "state": {
                  "type": "string",
                  "title": "State name",
                  "enum": [
                    "CREATED",
                    "PENDING",
                    "ITEM_ON_LOAN",
                    "ITEM_RETURNED",
                    "ITEM_IN_TRANSIT_FOR_PICKUP",
                    "ITEM_IN_TRANSIT_TO_HOUSE",
                    "ITEM_AT_DESK",
                    "CANCELLED"
                  ],
                  "form": {
                    "options": [
                      {
                        "label": "CREATED",
                        "value": "CREATED"
                      },
                      {
                        "label": "PENDING",
                        "value": "PENDING"
                      },
                      {
                        "label": "ITEM_ON_LOAN",
                        "value": "ITEM_ON_LOAN"
                      },
                      {
                        "label": "ITEM_RETURNED",
                        "value": "ITEM_RETURNED"
                      },
                      {
                        "label": "ITEM_IN_TRANSIT_FOR_PICKUP",
                        "value": "ITEM_IN_TRANSIT_FOR_PICKUP"
                      },
                      {
                        "label": "ITEM_IN_TRANSIT_TO_HOUSE",
                        "value": "ITEM_IN_TRANSIT_TO_HOUSE"
                      },
                      {
                        "label": "ITEM_AT_DESK",
                        "value": "ITEM_AT_DESK"
                      },
                      {
                        "label": "CANCELLED",
                        "value": "CANCELLED"
                      }
                    ]
                  }
                },
                "patron_pid": {
                  "type": "string",
                  "title": "Patron PID"
                },
                "transaction_location_pid": {
                  "type": "string",
                  "title": "Transaction location PID"
                },
                "request_expiry_date": {
                  "type": "string",
                  "format": "date-time",
                  "title": "Request expiry date"
                },
                "pid": {
                  "type": "string",
                  "title": "Loan PID"
                },
                "transaction_date": {
                  "type": "string",
                  "format": "date-time",
                  "title": "Loan date"
                },
                "document_pid": {
                  "type": "string",
                  "title": "Document PID"
                },
                "item_pid": {
                  "type": "string",
                  "title": "Item PID"
                },
                "organisation": {
                  "title": "Organisation",
                  "type": "object",
                  "properties": {
                    "$ref": {
                      "title": "Organisation URI",
                      "type": "string",
                      "pattern": "^https://ils.rero.ch/api/organisations/.*?$"
                    }
                  }
                },
                "pickup_location_pid": {
                  "type": "string",
                  "title": "Request pickup location PID"
                },
                "transaction_user_pid": {
                  "type": "string",
                  "title": "Transaction user PID"
                },
                "end_date": {
                  "type": "string",
                  "format": "date-time",
                  "title": "Transaction end date"
                },
                "$schema": {
                  "type": "string",
                  "title": "Schema"
                },
                "extension_count": {
                  "type": "integer",
                  "title": "Loan extension count"
                },
                "item": {
                  "title": "Item",
                  "type": "object",
                  "properties": {
                    "$ref": {
                      "title": "Item URI",
                      "type": "string",
                      "pattern": "^https://ils.rero.ch/api/items/.+?$",
                      "default": "https://ils.rero.ch/api/items/"
                    }
                  }
                },
                "trigger": {
                  "type": "string",
                  "title": "The name of the explicit action that triggered the transition to current state"
                }
              }
            },
            {
              "patternProperties": {
                "^item_pid$": true,
                "^item$": true,
                "^organisation$": true,
                "^document_pid$": true,
                "^state$": true,
                "^transaction_date$": true,
                "^request_expiry_date$": true,
                "^start_date$": true,
                "^transaction_user_pid$": true,
                "^pickup_location_pid$": true,
                "^extension_count$": true,
                "^$schema$": true,
                "^pid$": true,
                "^transaction_location_pid$": true,
                "^trigger$": true,
                "^end_date$": true,
                "^patron_pid$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
