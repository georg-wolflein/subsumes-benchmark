{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "extensions": {
                  "type": "array",
                  "description": "Extension points",
                  "items": {
                    "properties": {
                      "type": {
                        "type": "string"
                      },
                      "order": {
                        "type": "number"
                      }
                    }
                  }
                },
                "resources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "experiment": {
                  "type": "string"
                },
                "scripts": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "skip_compilation": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^experiment$": true,
                "^scripts$": true,
                "^dependencies$": true,
                "^resources$": true,
                "^skip_compilation$": true,
                "^extensions$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
