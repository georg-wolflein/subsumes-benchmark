{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "port": {
                  "max": 65535,
                  "min": 0,
                  "type": "integer"
                },
                "priority": {
                  "max": 65535,
                  "min": 0,
                  "type": "integer"
                },
                "target": {
                  "format": "hostname",
                  "type": "string"
                },
                "weight": {
                  "max": 65535,
                  "min": 0,
                  "type": "integer"
                }
              },
              "required": [
                "priority",
                "weight",
                "port",
                "target"
              ]
            },
            {
              "patternProperties": {
                "^port$": true,
                "^priority$": true,
                "^target$": true,
                "^weight$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
