{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "port": {
      "max": 65535,
      "min": 0,
      "type": "integer"
    },
    "priority": {
      "max": 65535,
      "min": 0,
      "type": "integer"
    },
    "target": {
      "format": "hostname",
      "type": "string"
    },
    "weight": {
      "max": 65535,
      "min": 0,
      "type": "integer"
    }
  },
  "required": [
    "priority",
    "weight",
    "port",
    "target"
  ]
}
