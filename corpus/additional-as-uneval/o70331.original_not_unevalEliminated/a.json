{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "algorithm": {
                  "max": 2,
                  "min": 1,
                  "type": "integer"
                },
                "fingerprint": {
                  "pattern": "^[0-9A-Fa-f]{40}$",
                  "type": "string"
                },
                "type": {
                  "max": 1,
                  "min": 1,
                  "type": "integer"
                }
              },
              "required": [
                "algorithm",
                "type",
                "fingerprint"
              ]
            },
            {
              "patternProperties": {
                "^algorithm$": true,
                "^fingerprint$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
