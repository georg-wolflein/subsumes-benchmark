{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "LISAManagerReferenceNumber": {
      "$ref": "#/$defs/LISAManagerReferenceNumberType"
    },
    "LISAProviderName": {
      "type": "string"
    },
    "_links": {
      "type": "object"
    }
  },
  "required": [
    "LISAManagerReferenceNumber",
    "LISAProviderName"
  ],
  "type": "object",
  "$defs": {
    "LISAManagerReferenceNumberType": {
      "pattern": "^Z\\d{6}$",
      "type": "string"
    }
  }
}
