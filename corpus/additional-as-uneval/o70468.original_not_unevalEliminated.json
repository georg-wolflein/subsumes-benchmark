{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o70468.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o70468.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "generateXAddressParameters",
                "type": "object",
                "properties": {
                  "options": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^options$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Options to control how the address and secret are generated.",
                "properties": {
                  "entropy": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0.0,
                      "maximum": 255.0
                    },
                    "description": "The entropy to use to generate the seed. Must be an array of length 16 with values from 0-255 (16 bytes of entropy)"
                  },
                  "algorithm": {
                    "type": "string",
                    "enum": [
                      "ecdsa-secp256k1",
                      "ed25519"
                    ],
                    "description": "The digital signature algorithm to generate an address for. Can be `ecdsa-secp256k1` (default) or `ed25519`."
                  },
                  "test": {
                    "type": "boolean",
                    "description": "Specifies whether the address is intended for use on a test network such as Testnet or Devnet. If `true`, the address should only be used for testing, and will start with `T`. If `false`, the address should only be used on mainnet, and will start with `X`."
                  },
                  "includeClassicAddress": {
                    "type": "boolean",
                    "description": "Specifies whether the classic address should also be included in the returned payload."
                  }
                }
              },
              {
                "patternProperties": {
                  "^entropy$": true,
                  "^algorithm$": true,
                  "^test$": true,
                  "^includeClassicAddress$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "generateXAddressParameters",
    "type": "object",
    "properties": {
      "options": {
        "type": "object",
        "description": "Options to control how the address and secret are generated.",
        "properties": {
          "entropy": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "description": "The entropy to use to generate the seed. Must be an array of length 16 with values from 0-255 (16 bytes of entropy)"
          },
          "algorithm": {
            "type": "string",
            "enum": [
              "ecdsa-secp256k1",
              "ed25519"
            ],
            "description": "The digital signature algorithm to generate an address for. Can be `ecdsa-secp256k1` (default) or `ed25519`."
          },
          "test": {
            "type": "boolean",
            "description": "Specifies whether the address is intended for use on a test network such as Testnet or Devnet. If `true`, the address should only be used for testing, and will start with `T`. If `false`, the address should only be used on mainnet, and will start with `X`."
          },
          "includeClassicAddress": {
            "type": "boolean",
            "description": "Specifies whether the classic address should also be included in the returned payload."
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
