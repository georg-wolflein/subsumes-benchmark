{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "shared_secret": {
                  "type": "string"
                },
                "header": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]+[a-zA-Z0-9])?$"
                },
                "algorithm": {
                  "enum": [
                    "hmac-md5",
                    "hmac-sha1",
                    "hmac-sha256",
                    "hmac-sha384",
                    "hmac-sha512"
                  ]
                }
              },
              "required": [
                "shared_secret",
                "header",
                "algorithm"
              ]
            },
            {
              "patternProperties": {
                "^shared_secret$": true,
                "^header$": true,
                "^algorithm$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
