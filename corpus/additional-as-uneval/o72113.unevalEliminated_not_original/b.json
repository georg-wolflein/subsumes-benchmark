{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_4",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-z][\\$#a-z0-9_]*$": {
                  "$ref": "#/$defs/Dependency",
                  "description": "properties of dependencies object are package names"
                }
              },
              "minProperties": 1,
              "description": "collection of packages and their versionRange declarations"
            },
            {
              "patternProperties": {
                "^[a-z][\\$#a-z0-9_]*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Dependencies": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "person's name"
                },
                "email": {
                  "type": "string",
                  "format": "email",
                  "description": "person's email"
                }
              },
              "required": [
                "name",
                "email"
              ],
              "description": "person defined as person object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Person": {
      "oneOf": [
        {
          "$ref": "#/$defs/PersonLiteral",
          "description": "person defined as name <email>"
        },
        {
          "$ref": "#/$defs/PersonObject",
          "description": "person defined as person object"
        }
      ],
      "description": "person definition"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "version": {
                  "$ref": "#/$defs/SemverVersionRange",
                  "description": "Package semver versionRange declaration."
                },
                "peer": {
                  "type": "boolean",
                  "description": "Dependency should be deployed as peer dependency."
                }
              },
              "required": [
                "version"
              ],
              "description": "Package dependency object."
            },
            {
              "patternProperties": {
                "^version$": true,
                "^peer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "SemverVersion": {
      "type": "string",
      "format": "semverVersion",
      "description": "Valid semver version (https://github.com/npm/node-semver)."
    },
    "SemverVersionRange": {
      "type": "string",
      "format": "semverVersionRange",
      "description": "Valid semver versionRange (https://github.com/npm/node-semver)."
    },
    "Dependency": {
      "oneOf": [
        {
          "$ref": "#/$defs/SemverVersionRange",
          "description": "Package dependency as semver versionRange declaration literal."
        },
        {
          "$ref": "#/$defs/DependencyObject",
          "description": "Package dependency object."
        }
      ],
      "description": "Package dependency"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "JSON schema for OraDBPM Package",
              "description": "https://raw.githubusercontent.com/s-oravec/oradb-package/master/oradbpm-package-schema.json",
              "type": "object",
              "properties": {
                "author": {
                  "$ref": "#/$defs/Person",
                  "description": "package author"
                },
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][\\$#a-z0-9_]*$",
                  "description": "package name"
                },
                "repository": {
                  "type": "string",
                  "format": "uri",
                  "description": "package git repository uri"
                },
                "description": {
                  "type": "string",
                  "description": "package description"
                },
                "license": {
                  "type": "string",
                  "description": "package license"
                },
                "version": {
                  "$ref": "#/$defs/SemverVersion",
                  "description": "package version - must be valid semver version"
                },
                "language": {
                  "type": "string",
                  "enum": [
                    "sql",
                    "plsql",
                    "sqlplus"
                  ],
                  "description": "language in which is package implemented"
                },
                "homepage": {
                  "type": "string",
                  "format": "uri",
                  "description": "Package homepage."
                },
                "keywords": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "keyword"
                  },
                  "aditionalItems": "false",
                  "minItems": 1,
                  "description": "list of keywords",
                  "_uniqueItems": true
                },
                "dependencies": {
                  "$ref": "#/$defs/Dependencies",
                  "description": "Collection of package runtime dependencies declarations."
                },
                "devDependencies": {
                  "$ref": "#/$defs/Dependencies",
                  "description": "Collection of package development dependencies declarations."
                },
                "bugs": {
                  "type": "string",
                  "format": "uri",
                  "description": "package bug & issue tracking page"
                }
              },
              "required": [
                "name",
                "version",
                "language",
                "description",
                "license"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^keywords$": true,
                "^homepage$": true,
                "^author$": true,
                "^devDependencies$": true,
                "^repository$": true,
                "^language$": true,
                "^license$": true,
                "^dependencies$": true,
                "^description$": true,
                "^name$": true,
                "^bugs$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "PersonLiteral": {
      "type": "string",
      "pattern": "^.+\\<.+@.+\\..+\\>$",
      "description": "person defined as name <email>"
    },
    "PersonObject": {
      "$ref": "#/$defs/modern_2"
    },
    "DependencyObject": {
      "$ref": "#/$defs/modern_3"
    }
  }
}
