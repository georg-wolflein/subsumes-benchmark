{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "User Metric JSONata Context",
  "description": "Context provided to a custom user metric JSONata filter expression",
  "type": "object",
  "properties": {
    "user": {
      "title": "User Data",
      "type": "object",
      "properties": {
        "email": {
          "type": [
            "string",
            "null"
          ],
          "title": "Email Address"
        },
        "dateBlocked": {
          "type": [
            "integer",
            "null"
          ],
          "title": "Date User Blocked"
        },
        "fraudFlags": {
          "type": "array",
          "title": "Fraud Flags",
          "description": "Flags indicating whether this user was marked as a potentially fradulent user",
          "items": {
            "$ref": "#/$defs/modern_3"
          }
        },
        "customFields": {
          "$ref": "#/$defs/customFieldsContext"
        },
        "locale": {
          "type": [
            "string",
            "null"
          ],
          "title": "Locale"
        },
        "lastName": {
          "type": [
            "string",
            "null"
          ],
          "title": "Last Name"
        },
        "firstName": {
          "type": [
            "string",
            "null"
          ],
          "title": "First Name"
        },
        "dateCreated": {
          "type": [
            "integer",
            "null"
          ],
          "title": "Date User Created"
        },
        "segments": {
          "type": "array",
          "title": "Segments",
          "description": "A list of segments this user has been assigned to",
          "items": {
            "type": "string",
            "title": "Segment Key",
            "description": "A segment key this user has been assigned to (e.g. VIP)"
          }
        }
      }
    },
    "event": {
      "$ref": "#/$defs/eventContext"
    }
  },
  "$defs": {
    "eventFieldsContext": {
      "$ref": "#/$defs/modern_1"
    },
    "eventContext": {
      "type": "object",
      "title": "Event",
      "description": "The variables for the event that triggered the metric",
      "properties": {
        "key": {
          "type": "string",
          "title": "Event Key",
          "description": "The key of the evaluated event (e.g. purchase)"
        },
        "dateTriggered": {
          "type": "integer",
          "title": "Date Triggered",
          "description": "The date this event was created"
        },
        "fields": {
          "$ref": "#/$defs/eventFieldsContext"
        }
      }
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "User Custom Fields",
              "description": "The user's custom fields",
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Fraud Flag",
              "properties": {
                "type": {
                  "type": "string",
                  "title": "Flag Type",
                  "enum": [
                    "IP",
                    "EMAIL",
                    "NAME",
                    "RATE",
                    "DAILY_REFERRAL_REWARD_LIMIT",
                    "TEMP_EMAIL",
                    "BLOCKED_USER",
                    "BLOCKED_IP"
                  ]
                },
                "message": {
                  "type": "string",
                  "title": "Flag Description"
                }
              },
              "required": [
                "type",
                "message"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^message$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "customFieldsContext": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Event Fields",
              "description": "The event's fields",
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
