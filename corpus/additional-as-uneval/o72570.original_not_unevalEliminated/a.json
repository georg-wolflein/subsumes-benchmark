{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_4",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "A map where the keys are the element tag, and the value is the data about how to get the element"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/bowerElement"
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "A map where the keys is the page name, the value is the schema and the template"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/page"
              }
            }
          ]
        }
      ]
    },
    "bowerElement": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "schema": {
                  "$ref": "#/$defs/modern_2"
                },
                "template": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/templateElement"
                  },
                  "description": "an array of elements and their bindings to a schema field"
                }
              }
            },
            {
              "patternProperties": {
                "^schema$": true,
                "^template$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "page": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "A declaration of schema fields as the keys, the type of the field as a value"
            },
            {
              "additionalProperties": {
                "type": "string",
                "enum": [
                  "string",
                  "number",
                  "object",
                  "array",
                  "boolean"
                ]
              }
            }
          ]
        }
      ]
    },
    "templateElement": {
      "type": "object",
      "properties": {
        "elementTag": {
          "type": "string"
        },
        "propertyBindings": {
          "type": "object",
          "description": "A declaration of bindings for this template, keys are the schema field and values are the element property"
        }
      },
      "required": [
        "elementTag"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "bowerPackage": {
                  "type": "string",
                  "description": "The package to install with bower for this element"
                },
                "elementPath": {
                  "type": "string",
                  "description": "The path to the .html file to include (with root set to bower_components, no leading dotslash)"
                }
              }
            },
            {
              "patternProperties": {
                "^bowerPackage$": true,
                "^elementPath$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Kangrat",
              "description": "A schema for Kangrat",
              "type": "object",
              "properties": {
                "elements": {
                  "$ref": "#/$defs/modern_5"
                },
                "author": {
                  "type": "string",
                  "default": "somebody",
                  "description": "The author of the site"
                },
                "pages": {
                  "$ref": "#/$defs/modern_6"
                },
                "siteName": {
                  "type": "string",
                  "default": "My Kangrat Site",
                  "description": "The name of the site"
                },
                "basePage": {
                  "type": "string",
                  "default": "./basepage.html",
                  "description": "The base page to build the templates off of"
                }
              },
              "required": [
                "siteName",
                "author",
                "basePage",
                "pages",
                "elements"
              ]
            },
            {
              "patternProperties": {
                "^basePage$": true,
                "^author$": true,
                "^elements$": true,
                "^pages$": true,
                "^siteName$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
