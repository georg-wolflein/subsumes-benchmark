{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "id": {
                  "pattern": "^[a-z0-9-]+$",
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title"
              ],
              "title": "Category",
              "type": "object"
            },
            {
              "patternProperties": {
                "^id$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
