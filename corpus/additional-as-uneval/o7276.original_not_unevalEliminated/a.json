{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "name": "Package",
              "type": "object",
              "properties": {
                "formats": {
                  "type": "array",
                  "description": "List of available parsing formats confirguation.",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "config": {
                  "type": "object",
                  "description": "Composer options.",
                  "properties": {
                    "process-timeout": {
                      "type": "integer",
                      "description": "The timeout in seconds for process executions, defaults to 300 (5mins)."
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^formats$": true,
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Full name of the author."
                },
                "email": {
                  "type": "string",
                  "description": "Email address of the author.",
                  "format": "email"
                },
                "homepage": {
                  "type": "string",
                  "description": "Homepage URL for the author.",
                  "format": "uri"
                },
                "role": {
                  "type": "string",
                  "description": "Author's role in the project."
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true,
                "^homepage$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
