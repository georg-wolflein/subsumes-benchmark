{
  "$id": "http://www.pucomex.serpro.gov.br/catp/operador_estrangeiro_retorno.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "items": {
                  "type": "object",
                  "properties": {
                    "seq": {
                      "type": "integer"
                    },
                    "codigo": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "erros": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "sucesso": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^items$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
