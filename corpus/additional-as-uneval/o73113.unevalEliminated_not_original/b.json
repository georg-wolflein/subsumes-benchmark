{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The global configuration of the project.",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "protractor": {
                  "$ref": "#/$defs/modern_7"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^protractor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "environments": {
                  "$ref": "#/$defs/modern_11"
                },
                "root": {
                  "type": "string"
                },
                "prefix": {
                  "type": "string"
                },
                "styles": {
                  "$ref": "#/$defs/modern_12"
                },
                "main": {
                  "type": "string"
                },
                "deployUrl": {
                  "type": "string"
                },
                "tsconfig": {
                  "default": "tsconfig.json",
                  "type": "string"
                },
                "scripts": {
                  "$ref": "#/$defs/modern_14"
                },
                "mobile": {
                  "default": false,
                  "type": "boolean"
                },
                "outDir": {
                  "default": "dist/",
                  "type": "string"
                },
                "test": {
                  "type": "string"
                },
                "assets": {
                  "default": [],
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  ]
                },
                "polyfills": {
                  "type": "string"
                },
                "index": {
                  "default": "index.html",
                  "type": "string"
                },
                "stylePreprocessorOptions": {
                  "$ref": "#/$defs/modern_16"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^environments$": true,
                "^polyfills$": true,
                "^root$": true,
                "^tsconfig$": true,
                "^outDir$": true,
                "^index$": true,
                "^test$": true,
                "^stylePreprocessorOptions$": true,
                "^deployUrl$": true,
                "^assets$": true,
                "^prefix$": true,
                "^mobile$": true,
                "^styles$": true,
                "^scripts$": true,
                "^main$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "$comment": "Please run `npm run build-config-interface` after changing this file. Thanks!",
              "properties": {
                "test": {
                  "$ref": "#/$defs/modern_2"
                },
                "defaults": {
                  "$ref": "#/$defs/modern_4"
                },
                "project": {
                  "$ref": "#/$defs/modern_5"
                },
                "warnings": {
                  "description": "Allow people to disable console warnings.",
                  "properties": {
                    "nodeDeprecation": {
                      "default": true,
                      "description": "Show a warning when the node version is incompatible.",
                      "type": "boolean"
                    },
                    "packageDeprecation": {
                      "default": true,
                      "description": "Show a warning when the user installed angular-cli.",
                      "type": "boolean"
                    },
                    "versionMismatch": {
                      "default": true,
                      "description": "Show a warning when the global version is newer than the local one.",
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "e2e": {
                  "$ref": "#/$defs/modern_6"
                },
                "lint": {
                  "description": "Properties to be passed to TSLint.",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  },
                  "type": "array"
                },
                "apps": {
                  "$ref": "#/$defs/modern_9"
                },
                "packages": {
                  "description": "Configuration reserved for installed third party packages.",
                  "items": {
                    "$ref": "#/$defs/modern_17"
                  },
                  "type": "array"
                },
                "addons": {
                  "description": "Configuration reserved for installed third party addons.",
                  "items": {
                    "$ref": "#/$defs/modern_18"
                  },
                  "type": "array"
                }
              },
              "title": "Angular CLI Config Schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^apps$": true,
                "^lint$": true,
                "^addons$": true,
                "^warnings$": true,
                "^test$": true,
                "^packages$": true,
                "^defaults$": true,
                "^project$": true,
                "^e2e$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "config": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Global styles to be included in the build.",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/modern_13"
                  }
                ]
              },
              "type": "array"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "files": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "tslintConfig": {
                  "default": "tslint.json",
                  "type": "string"
                }
              },
              "required": [
                "files",
                "project"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^files$": true,
                "^project$": true,
                "^tslintConfig$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Properties of the different applications in this project.",
              "items": {
                "$ref": "#/$defs/modern_10"
              },
              "type": "array"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "config": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^config$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Name and corresponding file for environment config.",
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Global scripts to be included in the build.",
              "items": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/modern_15"
                  }
                ]
              },
              "type": "array"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "poll": {
                  "type": "number"
                },
                "serve": {
                  "description": "Properties to be passed to the serve command",
                  "properties": {
                    "host": {
                      "default": "localhost",
                      "description": "The host the application will be served on",
                      "type": "string"
                    },
                    "port": {
                      "default": 4200,
                      "description": "The port the application will be served on",
                      "type": "number"
                    }
                  },
                  "type": "object"
                },
                "viewEncapsulation": {
                  "type": "string"
                },
                "changeDetection": {
                  "type": "string"
                },
                "inline": {
                  "properties": {
                    "style": {
                      "default": false,
                      "type": "boolean"
                    },
                    "template": {
                      "default": false,
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                },
                "styleExt": {
                  "type": "string"
                },
                "prefixInterfaces": {
                  "type": "boolean"
                },
                "spec": {
                  "properties": {
                    "module": {
                      "default": false,
                      "type": "boolean"
                    },
                    "service": {
                      "default": true,
                      "type": "boolean"
                    },
                    "class": {
                      "default": false,
                      "type": "boolean"
                    },
                    "pipe": {
                      "default": true,
                      "type": "boolean"
                    },
                    "component": {
                      "default": true,
                      "type": "boolean"
                    },
                    "directive": {
                      "default": true,
                      "type": "boolean"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^styleExt$": true,
                "^serve$": true,
                "^changeDetection$": true,
                "^spec$": true,
                "^prefixInterfaces$": true,
                "^viewEncapsulation$": true,
                "^inline$": true,
                "^poll$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Options to pass to style preprocessors",
              "properties": {
                "includePaths": {
                  "default": [],
                  "description": "Paths to include. Paths will be resolved to project root.",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^includePaths$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "input": {
                  "type": "string"
                }
              },
              "required": [
                "input"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^input$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "karma": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^karma$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_18": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "input": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^input$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
