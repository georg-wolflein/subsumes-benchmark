{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "selectedInstance": {
                  "type": "string"
                },
                "instances": {
                  "description": "The extra imported instance path",
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "instances",
                "selectedInstance"
              ]
            },
            {
              "patternProperties": {
                "^selectedInstance$": true,
                "^instances$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
