{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "all": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/Java"
      }
    },
    "default": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    }
  },
  "required": [
    "all",
    "default"
  ],
  "additionalProperties": false,
  "$defs": {
    "Java": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "majorVersion": {
          "type": "number"
        }
      },
      "required": [
        "majorVersion",
        "path",
        "version"
      ]
    }
  }
}
