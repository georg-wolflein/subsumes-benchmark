{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "autoInstallOnAppQuit": {
                  "description": "Should launcher auto install new update after app quit",
                  "default": false,
                  "type": "boolean"
                },
                "roots": {
                  "description": "The root paths of all the minecraft",
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "useBmclAPI": {
                  "description": "Use bmcl API in China Mainland",
                  "default": true,
                  "type": "boolean"
                },
                "primaryRoot": {
                  "description": "The primary installation root",
                  "default": "",
                  "type": "string"
                },
                "locale": {
                  "description": "The display language of the launcher",
                  "default": "en",
                  "type": "string"
                },
                "allowPrerelease": {
                  "description": "Should launcher show the pre-release",
                  "default": false,
                  "type": "boolean"
                },
                "autoDownload": {
                  "description": "Should launcher auto download new update",
                  "default": false,
                  "type": "boolean"
                }
              },
              "required": [
                "allowPrerelease",
                "autoDownload",
                "autoInstallOnAppQuit",
                "locale",
                "primaryRoot",
                "roots",
                "useBmclAPI"
              ]
            },
            {
              "patternProperties": {
                "^autoDownload$": true,
                "^locale$": true,
                "^roots$": true,
                "^autoInstallOnAppQuit$": true,
                "^primaryRoot$": true,
                "^allowPrerelease$": true,
                "^useBmclAPI$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
