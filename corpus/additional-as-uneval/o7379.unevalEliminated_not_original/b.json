{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_4",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "All loaded auth services api. Used for yggdrisal auth",
              "default": {},
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/YggdrasilAuthAPI"
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "All loaded profile services api. Used for",
              "default": {},
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/ProfileServiceAPI"
              }
            }
          ]
        }
      ]
    },
    "UserProfile": {
      "type": "object",
      "properties": {
        "selectedProfile": {
          "description": "Selected profile uuid",
          "type": "string"
        },
        "username": {
          "description": "The username usually email",
          "type": "string"
        },
        "profileService": {
          "description": "The used profile service id",
          "type": "string"
        },
        "authService": {
          "description": "The used auth service id",
          "type": "string"
        },
        "id": {
          "description": "user id",
          "type": "string"
        },
        "profiles": {
          "$ref": "#/$defs/modern_1"
        },
        "accessToken": {
          "description": "The access token of the user",
          "type": "string"
        }
      },
      "required": [
        "accessToken",
        "authService",
        "id",
        "profileService",
        "profiles",
        "selectedProfile",
        "username"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "All avaiable game profiles",
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/GameProfileAndTexture"
              }
            }
          ]
        }
      ]
    },
    "GameProfile.Texture": {
      "description": "The data structure that hold the texture",
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "metadata": {
          "$ref": "#/$defs/modern_2"
        }
      },
      "required": [
        "url"
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "All saved user account through mutliple services",
              "default": {},
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/UserProfile"
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "model": {
                  "enum": [
                    "slim",
                    "steve"
                  ],
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^model$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "YggdrasilAuthAPI": {
      "type": "object",
      "properties": {
        "refresh": {
          "description": "Use to refresh access token",
          "type": "string"
        },
        "validate": {
          "description": "Use to validate the user access token",
          "type": "string"
        },
        "invalidate": {
          "description": "Use to logout user (invalidate user access token)",
          "type": "string"
        },
        "hostName": {
          "description": "The host url, like https://xxx.xxx.com",
          "type": "string"
        },
        "signout": {
          "description": "Use to logout user (by username and password)",
          "type": "string"
        },
        "authenticate": {
          "description": "Authenticate path, in the form of `/your-endpoint`.\nUse to login",
          "type": "string"
        }
      },
      "required": [
        "authenticate",
        "hostName",
        "invalidate",
        "refresh",
        "signout",
        "validate"
      ]
    },
    "GameProfileAndTexture": {
      "type": "object",
      "properties": {
        "legacy": {
          "type": "boolean"
        },
        "name": {
          "description": "This is in game displayed name",
          "type": "string"
        },
        "suspended": {
          "type": "boolean"
        },
        "migrated": {
          "type": "boolean"
        },
        "id": {
          "description": "game profile unique id",
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/modern_3"
        },
        "paid": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "number"
        },
        "legacyProfile": {
          "type": "boolean"
        },
        "textures": {
          "type": "object",
          "properties": {
            "SKIN": {
              "$ref": "#/$defs/GameProfile.Texture"
            },
            "CAPE": {
              "description": "The data structure that hold the texture",
              "$ref": "#/$defs/GameProfile.Texture"
            },
            "ELYTRA": {
              "description": "The data structure that hold the texture",
              "$ref": "#/$defs/GameProfile.Texture"
            }
          },
          "required": [
            "SKIN"
          ]
        },
        "userId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "textures"
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "ProfileServiceAPI": {
      "type": "object",
      "properties": {
        "publicKey": {
          "description": "The PEM public key",
          "type": "string"
        },
        "profile": {
          "description": "Full url to query profile by uuid. Place the uuid as `${uuid}` in this url",
          "type": "string"
        },
        "profileByName": {
          "description": "Full url to query profile by name. Place the name as `${name}` in this url",
          "type": "string"
        },
        "texture": {
          "description": "Full url to set texture by profile uuid and texture type. Place uuid as `${uuid}` and type as `${type}`",
          "type": "string"
        }
      },
      "required": [
        "profile",
        "profileByName",
        "texture"
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "authServices": {
                  "$ref": "#/$defs/modern_5"
                },
                "selectedUser": {
                  "description": "Contains the UUID-hashed account and the UUID of the currently selected user",
                  "default": {
                    "account": "",
                    "profile": ""
                  },
                  "type": "object",
                  "properties": {
                    "id": {
                      "description": "The UUID-hashed key of the currently selected user",
                      "default": "",
                      "type": "string"
                    },
                    "profile": {
                      "description": "The UUID of the currently selected player",
                      "default": "",
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "profile"
                  ]
                },
                "profileServices": {
                  "$ref": "#/$defs/modern_6"
                },
                "clientToken": {
                  "description": "The client token of current client. The launcher will generate one at first launch.",
                  "default": "",
                  "type": "string"
                },
                "users": {
                  "$ref": "#/$defs/modern_7"
                }
              },
              "required": [
                "authServices",
                "clientToken",
                "profileServices",
                "selectedUser",
                "users"
              ]
            },
            {
              "patternProperties": {
                "^selectedUser$": true,
                "^profileServices$": true,
                "^clientToken$": true,
                "^authServices$": true,
                "^users$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
