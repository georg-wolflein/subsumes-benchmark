{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "JSON schema for the ASP.NET global configuration files",
              "type": "object",
              "properties": {
                "sources": {
                  "description": "A list of source folders relative to this file.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "sources"
              ]
            },
            {
              "patternProperties": {
                "^sources$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
