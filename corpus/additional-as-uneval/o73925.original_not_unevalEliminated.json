{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minItems",
    "minLength",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o73925.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object"
              },
              {
                "additionalProperties": {
                  "type": [
                    "array",
                    "string"
                  ],
                  "items": {
                    "type": "string",
                    "minItems": 1,
                    "_uniqueItems": true
                  }
                }
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "JSON schema for any Grunt task",
                "type": "object",
                "properties": {
                  "options": {
                    "type": "object"
                  }
                }
              },
              {
                "patternProperties": {
                  "^options$": true
                },
                "additionalProperties": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/fileFormat"
                    },
                    {
                      "$ref": "#/$defs/dynamic"
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "fileFormat": {
        "properties": {
          "files": {
            "oneOf": [
              {
                "$ref": "#/$defs/modern_1"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dynamic"
                }
              }
            ]
          }
        }
      },
      "dynamic": {
        "type": "object",
        "properties": {
          "extDot": {
            "description": "Used to indicate where the period indicating the extension is located.",
            "enum": [
              "first",
              "last"
            ],
            "default": "first"
          },
          "nonull": {
            "description": "If set to 'true' then the operation will include non-matching patterns. Combined with grunt's '--verbose' flag, this option can help debug file path issues.",
            "type": "boolean",
            "default": false
          },
          "matchBase": {
            "description": "If set, patterns without slashes will be matched against the basename of the path if it contains slashes. For example, 'a?b' would match the path '/xyz/123/acb', but not '/xyz/acb/123'.",
            "type": "boolean",
            "default": false
          },
          "src": {
            "description": "Pattern(s) to match, relative to the 'cwd'.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "_uniqueItems": true
            }
          },
          "cwd": {
            "description": "All 'src' matches are relative to (but don't include) this path",
            "type": "string"
          },
          "ext": {
            "description": "Replace any existing extension with this value in generated 'dest' paths.",
            "type": "string"
          },
          "dest": {
            "description": "Destination path prefix.",
            "type": "string"
          },
          "flatten": {
            "description": "Remove all path parts from generated 'dest' paths",
            "type": "boolean",
            "default": false
          },
          "rename": {
            "description": "This function is called for each matched 'src' file, (after extension renaming and flattening). ",
            "type": "string"
          },
          "expand": {
            "description": "Must be set to true to use properties other than 'src' and 'dest'",
            "type": "boolean",
            "default": false
          },
          "filter": {
            "description": "The 'filter' property can help you target files with a greater level of detail",
            "enum": [
              "isFile",
              "isDirectory",
              "isBlockDevice",
              "isCharacterDevice",
              "isSymbolicLink",
              "isFIFO",
              "isSocket"
            ]
          }
        },
        "required": [
          "src"
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "JSON schema for any Grunt task",
    "type": "object",
    "properties": {
      "options": {
        "type": "object"
      }
    },
    "additionalProperties": {
      "anyOf": [
        {
          "$ref": "#/$defs/fileFormat"
        },
        {
          "$ref": "#/$defs/dynamic"
        }
      ]
    },
    "$defs": {
      "dynamic": {
        "type": "object",
        "properties": {
          "expand": {
            "description": "Must be set to true to use properties other than 'src' and 'dest'",
            "type": "boolean",
            "default": false
          },
          "cwd": {
            "description": "All 'src' matches are relative to (but don't include) this path",
            "type": "string"
          },
          "dest": {
            "description": "Destination path prefix.",
            "type": "string"
          },
          "ext": {
            "description": "Replace any existing extension with this value in generated 'dest' paths.",
            "type": "string"
          },
          "extDot": {
            "description": "Used to indicate where the period indicating the extension is located.",
            "enum": [
              "first",
              "last"
            ],
            "default": "first"
          },
          "filter": {
            "description": "The 'filter' property can help you target files with a greater level of detail",
            "enum": [
              "isFile",
              "isDirectory",
              "isBlockDevice",
              "isCharacterDevice",
              "isSymbolicLink",
              "isFIFO",
              "isSocket"
            ]
          },
          "flatten": {
            "description": "Remove all path parts from generated 'dest' paths",
            "type": "boolean",
            "default": false
          },
          "matchBase": {
            "description": "If set, patterns without slashes will be matched against the basename of the path if it contains slashes. For example, 'a?b' would match the path '/xyz/123/acb', but not '/xyz/acb/123'.",
            "type": "boolean",
            "default": false
          },
          "nonull": {
            "description": "If set to 'true' then the operation will include non-matching patterns. Combined with grunt's '--verbose' flag, this option can help debug file path issues.",
            "type": "boolean",
            "default": false
          },
          "rename": {
            "description": "This function is called for each matched 'src' file, (after extension renaming and flattening). ",
            "type": "string"
          },
          "src": {
            "description": "Pattern(s) to match, relative to the 'cwd'.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "_uniqueItems": true
            }
          }
        },
        "required": [
          "src"
        ]
      },
      "fileFormat": {
        "properties": {
          "files": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": [
                    "array",
                    "string"
                  ],
                  "items": {
                    "type": "string",
                    "minItems": 1,
                    "_uniqueItems": true
                  }
                }
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/dynamic"
                }
              }
            ]
          }
        }
      }
    }
  }
}
