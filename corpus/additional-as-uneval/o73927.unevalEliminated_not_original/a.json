{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "aliases": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "expires": {
      "_format": "date-time",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/link"
      },
      "type": "array"
    },
    "properties": {
      "$ref": "#/$defs/property"
    },
    "subject": {
      "_format": "uri",
      "type": "string"
    }
  },
  "required": [
    "subject"
  ],
  "title": "JSON schema for host-meta files",
  "type": "object",
  "$defs": {
    "link": {
      "properties": {
        "href": {
          "type": "string"
        },
        "properties": {
          "$ref": "#/$defs/property"
        },
        "rel": {
          "type": "string"
        },
        "template": {
          "_format": "uri",
          "type": "string"
        },
        "titles": {
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "default": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "type": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "property": {
      "additionalProperties": {
        "type": [
          "null",
          "string"
        ]
      },
      "type": "object"
    }
  }
}
