{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "JSON schema for SchemaStore.org catalog files",
              "type": "object",
              "properties": {
                "schemas": {
                  "description": "A list of JSON schema references.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "version": {
                  "description": "The schema version of the catalog",
                  "type": "number"
                }
              },
              "required": [
                "schemas",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^schemas$": true,
                "^version$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "fileMatch": {
                  "description": "A Mimimatch expression for matching up file names with a schema.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "url": {
                  "description": "An absolute URL to the schema location",
                  "type": "string"
                },
                "name": {
                  "description": "The name of the schema",
                  "type": "string"
                },
                "description": {
                  "description": "A description of the schema",
                  "type": "string"
                }
              },
              "minLength": 1,
              "required": [
                "name",
                "url",
                "description"
              ]
            },
            {
              "patternProperties": {
                "^fileMatch$": true,
                "^url$": true,
                "^name$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
