{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "cycles": {
                  "$ref": "#/$defs/CyclesType"
                },
                "version": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^cycles$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Greens": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "cycle": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/CycleType"
                  }
                },
                "period": {
                  "type": "integer"
                },
                "numsys": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^cycle$": true,
                "^period$": true,
                "^numsys$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "CyclesType": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "errno": {
                  "type": "integer"
                },
                "greens": {
                  "$ref": "#/$defs/Greens"
                },
                "geo": {
                  "type": "integer"
                },
                "std": {
                  "type": "integer"
                },
                "sys": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "valid": {
                  "type": "integer"
                },
                "send": {
                  "type": "string",
                  "enum": [
                    "OK",
                    "FAIL"
                  ]
                },
                "trans": {
                  "type": "integer"
                },
                "offcor": {
                  "type": "integer"
                },
                "num": {
                  "type": "integer"
                },
                "now": {
                  "type": "integer"
                },
                "err": {
                  "type": "integer"
                },
                "cyc": {
                  "type": "integer"
                },
                "node": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^err$": true,
                "^num$": true,
                "^offcor$": true,
                "^cyc$": true,
                "^send$": true,
                "^node$": true,
                "^trans$": true,
                "^geo$": true,
                "^sys$": true,
                "^errno$": true,
                "^id$": true,
                "^now$": true,
                "^valid$": true,
                "^std$": true,
                "^greens$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "CycleType": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "green": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/GreenType"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^green$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "GreenType": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tim": {
                  "type": "integer"
                },
                "ped": {
                  "type": "integer"
                },
                "id": {
                  "type": "string"
                },
                "max": {
                  "type": "integer"
                },
                "gap": {
                  "type": "integer"
                },
                "fo": {
                  "type": "integer"
                },
                "grn": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^ped$": true,
                "^max$": true,
                "^gap$": true,
                "^id$": true,
                "^tim$": true,
                "^fo$": true,
                "^grn$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
