{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_6",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "ovrPattern": {
                  "type": "integer"
                },
                "adaPlan": {
                  "type": "integer"
                },
                "tod": {
                  "type": "string",
                  "enum": [
                    "PLAN",
                    "PATTERN",
                    "STANDBY"
                  ]
                },
                "curPlan": {
                  "$ref": "#/$defs/TimingPlanType"
                },
                "override": {
                  "type": "string",
                  "enum": [
                    "PLAN",
                    "PATTERN",
                    "STANDBY"
                  ]
                },
                "ovrMode": {
                  "type": "string",
                  "enum": [
                    "FREE",
                    "FLASH"
                  ]
                },
                "todMode": {
                  "type": "string",
                  "enum": [
                    "FREE",
                    "FLASH"
                  ]
                },
                "id": {
                  "type": "integer"
                },
                "adaPattern": {
                  "type": "integer"
                },
                "adaptive": {
                  "type": "string",
                  "enum": [
                    "PLAN",
                    "PATTERN",
                    "STANDBY"
                  ]
                },
                "ovrPlan": {
                  "type": "integer"
                },
                "todnum": {
                  "type": "integer"
                },
                "op": {
                  "type": "string",
                  "enum": [
                    "PICKUP",
                    "OFFSET",
                    "NCS",
                    "TRANSITION"
                  ]
                },
                "todPlan": {
                  "type": "integer"
                },
                "fail": {
                  "type": "string",
                  "enum": [
                    "CONFLICT",
                    "CDI",
                    "PRE_EMPT",
                    "UNKNOWN",
                    "RESET"
                  ]
                },
                "to": {
                  "type": "integer"
                },
                "now": {
                  "type": "string",
                  "enum": [
                    "PATTERN",
                    "FLASH",
                    "TBC",
                    "STANDBY",
                    "FAIL",
                    "PLAN",
                    "UNKNOWN"
                  ]
                },
                "todPattern": {
                  "type": "integer"
                },
                "adaMode": {
                  "type": "string",
                  "enum": [
                    "FREE",
                    "FLASH"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^adaptive$": true,
                "^ovrPattern$": true,
                "^op$": true,
                "^id$": true,
                "^todMode$": true,
                "^todPlan$": true,
                "^ovrPlan$": true,
                "^override$": true,
                "^todnum$": true,
                "^adaMode$": true,
                "^adaPlan$": true,
                "^fail$": true,
                "^to$": true,
                "^adaPattern$": true,
                "^curPlan$": true,
                "^now$": true,
                "^todPattern$": true,
                "^ovrMode$": true,
                "^tod$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "phase": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/PhaseType"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^phase$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "TimingPlanType": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "phases": {
                  "$ref": "#/$defs/Phases"
                },
                "min": {
                  "type": "integer"
                },
                "id": {
                  "type": "string"
                },
                "offset": {
                  "type": "integer"
                },
                "cycle": {
                  "type": "integer"
                },
                "sigplan": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^phases$": true,
                "^sigplan$": true,
                "^id$": true,
                "^offset$": true,
                "^cycle$": true,
                "^min$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "TimingsType": {
      "$ref": "#/$defs/modern_3"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "timing": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/TimingType"
                  }
                },
                "numsys": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^timing$": true,
                "^numsys$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "minvar": {
                  "type": "integer"
                },
                "clear": {
                  "type": "integer"
                },
                "serves": {
                  "type": "integer"
                },
                "id": {
                  "type": "string"
                },
                "split": {
                  "type": "integer"
                },
                "variable": {
                  "type": "integer"
                },
                "fixed": {
                  "type": "integer"
                },
                "disp": {
                  "type": "string",
                  "enum": [
                    "EW_L",
                    "SB_L",
                    "NB_W",
                    "SB_W",
                    "WB_G",
                    "NB_L",
                    "EW_W",
                    "NS_W",
                    "EB_W",
                    "NS_E",
                    "NS_L",
                    "WB_L",
                    "SB_G",
                    "EB_L",
                    "WB_B",
                    "EW_G"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "rof": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^minvar$": true,
                "^rof$": true,
                "^serves$": true,
                "^split$": true,
                "^disp$": true,
                "^value$": true,
                "^variable$": true,
                "^id$": true,
                "^fixed$": true,
                "^clear$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Phases": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "timings": {
                  "$ref": "#/$defs/TimingsType"
                },
                "version": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^timings$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "PhaseType": {
      "$ref": "#/$defs/modern_4"
    },
    "TimingType": {
      "$ref": "#/$defs/modern_5"
    }
  }
}
