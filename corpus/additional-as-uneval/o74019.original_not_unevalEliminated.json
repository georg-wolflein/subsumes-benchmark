{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o74019.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o74019.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "title": "datasourcesCreate",
                "required": [
                  "config"
                ],
                "properties": {
                  "config": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "schoolId": {
                    "type": "string",
                    "pattern": "[a-f0-9]{24}"
                  },
                  "name": {
                    "type": "string"
                  },
                  "protected": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "description": "fields in the config that should recieve special protection. A field named password will always be protected"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^config$": true,
                  "^schoolId$": true,
                  "^name$": true,
                  "^protected$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "target"
                ],
                "properties": {
                  "target": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^target$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "datasourcesCreate",
    "required": [
      "config"
    ],
    "properties": {
      "config": {
        "type": "object",
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "schoolId": {
        "type": "string",
        "pattern": "[a-f0-9]{24}"
      },
      "name": {
        "type": "string"
      },
      "protected": {
        "type": "array",
        "items": {
          "type": "string",
          "description": "fields in the config that should recieve special protection. A field named password will always be protected"
        }
      }
    },
    "additionalProperties": false
  }
}
