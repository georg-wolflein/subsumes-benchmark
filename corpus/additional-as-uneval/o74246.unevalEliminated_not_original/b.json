{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "mimetype": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "integer"
                },
                "tags": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "measurements": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array",
                  "_uniqueItems": true
                },
                "info": {
                  "type": "object"
                },
                "modified": true,
                "hash": {
                  "type": "string"
                },
                "modality": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "created": true
              },
              "required": [
                "name",
                "created",
                "modified",
                "size",
                "hash"
              ],
              "key_fields": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^info$": true,
                "^measurements$": true,
                "^name$": true,
                "^type$": true,
                "^hash$": true,
                "^mimetype$": true,
                "^size$": true,
                "^created$": true,
                "^modified$": true,
                "^modality$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
