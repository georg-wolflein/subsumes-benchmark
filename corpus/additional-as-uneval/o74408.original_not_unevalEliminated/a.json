{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "assertions"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "context": true,
    "assertions": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "input",
                  "output"
                ],
                "properties": {
                  "input": true,
                  "output": true
                }
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
