{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Area",
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/simple_string"
                },
                "gid": {
                  "type": "integer"
                },
                "row": {
                  "type": "integer"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "area"
                  ]
                },
                "division_id": {
                  "type": "string",
                  "pattern": "^ocd-division/country:[a-z]{2}$"
                },
                "geonames_id": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "type",
                "division_id",
                "gid",
                "row",
                "id",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^geonames_id$": true,
                "^name$": true,
                "^type$": true,
                "^id$": true,
                "^division_id$": true,
                "^gid$": true,
                "^row$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "simple_string": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
