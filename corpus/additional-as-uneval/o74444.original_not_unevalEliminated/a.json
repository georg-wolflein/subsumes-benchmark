{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Event",
              "type": "object",
              "properties": {
                "perpetrator_name": {
                  "$ref": "#/$defs/simple_string"
                },
                "gid": {
                  "type": "integer"
                },
                "description": {
                  "$ref": "#/$defs/simple_string"
                },
                "row": {
                  "type": "integer"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
                },
                "admin_level_1_geonames_name": {
                  "$ref": "#/$defs/simple_string"
                },
                "end_date": {
                  "$ref": "#/$defs/simple_date"
                },
                "geonames_name": {
                  "$ref": "#/$defs/simple_string"
                },
                "perpetrator_organization_id": {
                  "$ref": "#/$defs/simple_string"
                },
                "classification": {
                  "$ref": "#/$defs/modern_6"
                },
                "admin_level_1_geonames_id": {
                  "$ref": "#/$defs/simple_integer"
                },
                "sources": {
                  "$ref": "#/$defs/simple_string_array"
                },
                "start_date": {
                  "$ref": "#/$defs/simple_date"
                },
                "location": {
                  "$ref": "#/$defs/simple_string"
                },
                "division_id": {
                  "type": "string",
                  "pattern": "^ocd-division/country:[a-z]{2}$"
                },
                "geonames_id": {
                  "$ref": "#/$defs/simple_integer"
                },
                "perpetrator_organization_classification": {
                  "$ref": "#/$defs/simple_string_array"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "event"
                  ]
                }
              },
              "required": [
                "type",
                "division_id",
                "gid",
                "row",
                "id",
                "start_date",
                "classification",
                "description"
              ]
            },
            {
              "patternProperties": {
                "^geonames_name$": true,
                "^description$": true,
                "^geonames_id$": true,
                "^start_date$": true,
                "^type$": true,
                "^division_id$": true,
                "^perpetrator_organization_id$": true,
                "^row$": true,
                "^end_date$": true,
                "^perpetrator_name$": true,
                "^classification$": true,
                "^sources$": true,
                "^admin_level_1_geonames_id$": true,
                "^id$": true,
                "^gid$": true,
                "^admin_level_1_geonames_name$": true,
                "^perpetrator_organization_classification$": true,
                "^location$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "Arbitrary Detention",
                      "Assault",
                      "Attacking Hospital",
                      "Beating",
                      "Death in Custody",
                      "Death in Detention",
                      "Denial of Medical Attention",
                      "Disappearance",
                      "Excessive Force",
                      "Illegal Detention",
                      "Inhuman Detention",
                      "Killing",
                      "Rape",
                      "Restricting freedom of speech and press",
                      "Restricting of freedom of association",
                      "Torture",
                      "Use of Child Soldiers",
                      "Violations against personal integrity",
                      "Violations against the right to liberty",
                      "Violations of rights of detained or imprisoned persons",
                      "Violations of the right to adequate housing",
                      "Violations of the right to life"
                    ]
                  }
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]{4}(-[0-9]{2}){0,2}$"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "simple_date": {
      "$ref": "#/$defs/modern_1"
    },
    "simple_string": {
      "$ref": "#/$defs/modern_3"
    },
    "simple_integer": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "simple_string_array": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
