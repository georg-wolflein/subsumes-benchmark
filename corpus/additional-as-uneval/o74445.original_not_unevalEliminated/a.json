{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Organization",
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/complex_string"
                },
                "gid": {
                  "type": "integer"
                },
                "parents": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_6"
                  }
                },
                "row": {
                  "type": "integer"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
                },
                "other_names": {
                  "$ref": "#/$defs/complex_string_array"
                },
                "division_id": {
                  "type": "string",
                  "pattern": "^ocd-division/country:[a-z]{2}$"
                },
                "root_name": {
                  "$ref": "#/$defs/simple_string"
                },
                "areas": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_8"
                  }
                },
                "notes": {
                  "$ref": "#/$defs/simple_string"
                },
                "classification": {
                  "$ref": "#/$defs/complex_string_array"
                },
                "memberships": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                },
                "sites": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  }
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "organization"
                  ]
                }
              },
              "required": [
                "type",
                "division_id",
                "gid",
                "row",
                "id",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^sites$": true,
                "^parents$": true,
                "^notes$": true,
                "^name$": true,
                "^id$": true,
                "^division_id$": true,
                "^gid$": true,
                "^row$": true,
                "^areas$": true,
                "^memberships$": true,
                "^root_name$": true,
                "^classification$": true,
                "^other_names$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/complex_string"
                },
                "date_first_cited": {
                  "$ref": "#/$defs/complex_date"
                },
                "date_last_cited": {
                  "$ref": "#/$defs/complex_date"
                },
                "classification": {
                  "$ref": "#/$defs/modern_7"
                }
              },
              "required": [
                "id"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^date_first_cited$": true,
                "^date_last_cited$": true,
                "^classification$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "organization_id": {
                  "$ref": "#/$defs/complex_string"
                },
                "date_first_cited": {
                  "$ref": "#/$defs/complex_date"
                },
                "date_last_cited": {
                  "$ref": "#/$defs/complex_date"
                }
              },
              "required": [
                "organization_id"
              ]
            },
            {
              "patternProperties": {
                "^organization_id$": true,
                "^date_first_cited$": true,
                "^date_last_cited$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "enum": [
                    "Administrative",
                    "Command",
                    "Informal",
                    "Organization/Administrative"
                  ]
                },
                "sources": {
                  "$ref": "#/$defs/sources"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^sources$": true,
                "^confidence$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "pattern": "^[0-9]{4}(-[0-9]{2}){0,2}$"
                },
                "sources": {
                  "$ref": "#/$defs/sources"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^sources$": true,
                "^confidence$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "Low",
        "Medium",
        "High"
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "sources": {
                  "$ref": "#/$defs/sources"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^sources$": true,
                "^confidence$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "complex_date": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/complex_string"
                },
                "date_first_cited": {
                  "$ref": "#/$defs/complex_date"
                },
                "date_last_cited": {
                  "$ref": "#/$defs/complex_date"
                }
              },
              "required": [
                "id"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^date_first_cited$": true,
                "^date_last_cited$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "sources": {
                  "$ref": "#/$defs/sources"
                },
                "confidence": {
                  "$ref": "#/$defs/confidence"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^sources$": true,
                "^confidence$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "complex_string_array": {
      "$ref": "#/$defs/modern_3"
    },
    "complex_string": {
      "$ref": "#/$defs/modern_4"
    },
    "simple_string": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "$ref": "#/$defs/complex_string"
                },
                "date_first_cited": {
                  "$ref": "#/$defs/complex_date"
                },
                "date_last_cited": {
                  "$ref": "#/$defs/complex_date"
                },
                "open_ended": {
                  "$ref": "#/$defs/modern_9"
                }
              },
              "required": [
                "id"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^date_first_cited$": true,
                "^date_last_cited$": true,
                "^open_ended$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
