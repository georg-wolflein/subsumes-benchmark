{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "format",
    "items",
    "maxItems",
    "maxLength",
    "maximum",
    "minItems",
    "minLength",
    "minimum",
    "multipleOf",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o74461.original_not_unevalEliminated.json",
  "a": {
    "$id": "http://api.example.com/profile.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "website": {
                    "format": "hostname",
                    "maxLength": 128,
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "name": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9\\-]+(\\s[a-zA-Z0-9\\-]+)*$",
                    "type": "string"
                  },
                  "location": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "email": {
                    "_format": "email",
                    "maxLength": 128,
                    "type": "string"
                  },
                  "available_for_hire": {
                    "type": "boolean"
                  },
                  "age": {
                    "maximum": 100.0,
                    "minimum": 9.0,
                    "type": "integer"
                  },
                  "id": {
                    "_format": "uuid",
                    "type": "string"
                  },
                  "interests": {
                    "items": {
                      "maxLength": 120,
                      "type": "string"
                    },
                    "maxItems": 100,
                    "minItems": 3,
                    "type": "array",
                    "_uniqueItems": true
                  },
                  "skills": {
                    "items": {
                      "$ref": "#/$defs/modern_3"
                    },
                    "maxItems": 100,
                    "type": "array",
                    "_uniqueItems": true
                  }
                },
                "required": [
                  "id",
                  "name",
                  "age",
                  "email",
                  "location",
                  "available_for_hire",
                  "interests",
                  "skills"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^interests$": true,
                  "^skills$": true,
                  "^name$": true,
                  "^age$": true,
                  "^id$": true,
                  "^website$": true,
                  "^location$": true,
                  "^available_for_hire$": true,
                  "^email$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "address": {
                    "maxLength": 128,
                    "type": "string"
                  },
                  "country": {
                    "enum": [
                      "US",
                      "CA",
                      "GB"
                    ]
                  }
                },
                "required": [
                  "country",
                  "address"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^address$": true,
                  "^country$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "name": {
                    "maxLength": 64,
                    "minLenght": 1,
                    "type": "string"
                  },
                  "value": {
                    "maximum": 100.0,
                    "minimum": 0.0,
                    "multipleOf": 0.25,
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "value"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^value$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://api.example.com/profile.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "age": {
        "maximum": 100,
        "minimum": 9,
        "type": "integer"
      },
      "available_for_hire": {
        "type": "boolean"
      },
      "email": {
        "_format": "email",
        "maxLength": 128,
        "type": "string"
      },
      "id": {
        "_format": "uuid",
        "type": "string"
      },
      "interests": {
        "items": {
          "maxLength": 120,
          "type": "string"
        },
        "maxItems": 100,
        "minItems": 3,
        "type": "array",
        "_uniqueItems": true
      },
      "location": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "maxLength": 128,
            "type": "string"
          },
          "country": {
            "enum": [
              "US",
              "CA",
              "GB"
            ]
          }
        },
        "required": [
          "country",
          "address"
        ],
        "type": "object"
      },
      "name": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-zA-Z0-9\\-]+(\\s[a-zA-Z0-9\\-]+)*$",
        "type": "string"
      },
      "skills": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "maxLength": 64,
              "minLenght": 1,
              "type": "string"
            },
            "value": {
              "maximum": 100,
              "minimum": 0,
              "multipleOf": 0.25,
              "type": "number"
            }
          },
          "required": [
            "name",
            "value"
          ],
          "type": "object"
        },
        "maxItems": 100,
        "type": "array",
        "_uniqueItems": true
      },
      "website": {
        "format": "hostname",
        "maxLength": 128,
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "name",
      "age",
      "email",
      "location",
      "available_for_hire",
      "interests",
      "skills"
    ],
    "type": "object"
  }
}
