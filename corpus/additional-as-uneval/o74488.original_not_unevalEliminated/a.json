{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "priority": {
      "_id": "/priority",
      "type": "number"
    },
    "enabled": {
      "_id": "/enabled",
      "type": "boolean"
    },
    "baseid": {
      "_id": "/baseid",
      "type": "string"
    },
    "title": {
      "_id": "/title",
      "type": "string"
    },
    "description": {
      "_id": "/description",
      "type": "string"
    },
    "criteria": {
      "$ref": "#/$defs/modern_3"
    },
    "_id": {
      "type": "string"
    }
  },
  "required": [
    "criteria",
    "title"
  ],
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "match_max": {
                  "_id": "/match_max",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "match_min": {
                  "_id": "/match_min",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "mfs": {
                  "_id": "/mf",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "type": {
                  "_id": "/type",
                  "enum": [
                    "all",
                    "count",
                    "none"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^match_max$": true,
                "^match_min$": true,
                "^mfs$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "_id": "/mf/items",
              "properties": {
                "expr": {
                  "_id": "/mf/expr",
                  "type": "string"
                },
                "max": {
                  "_id": "/mf/max",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "min": {
                  "_id": "/mf/min",
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "type": {
                  "_id": "/mf/type",
                  "enum": [
                    "pseudo",
                    "total",
                    "explicit",
                    "implicit",
                    "crafted",
                    "enchant",
                    "prophecy",
                    "leaguestone"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "type",
                "expr"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^expr$": true,
                "^max$": true,
                "^min$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "filter_group": {
      "$ref": "#/$defs/modern_1"
    },
