{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "package": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "zip_code": {
                  "type": "string"
                },
                "street_no": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                },
                "company": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "street": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "first_name",
                "last_name",
                "street",
                "street_no",
                "city",
                "zip_code",
                "country"
              ]
            },
            {
              "patternProperties": {
                "^city$": true,
                "^first_name$": true,
                "^company$": true,
                "^country$": true,
                "^last_name$": true,
                "^street_no$": true,
                "^street$": true,
                "^zip_code$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number"
                },
                "height": {
                  "type": "number"
                },
                "length": {
                  "type": "number"
                },
                "weight": {
                  "type": "number"
                }
              },
              "required": [
                "width",
                "height",
                "length",
                "weight"
              ],
              "description": "defines package dimensions"
            },
            {
              "patternProperties": {
                "^width$": true,
                "^height$": true,
                "^length$": true,
                "^weight$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "package": {
                  "$ref": "#/$defs/package"
                },
                "carrier": {
                  "type": "string",
                  "enum": [
                    "dhl",
                    "ups",
                    "dpd",
                    "hermes",
                    "gls"
                  ],
                  "description": "acronym of the carrier you want to use"
                },
                "service": {
                  "type": "string",
                  "enum": [
                    "standard",
                    "returns",
                    "one_day",
                    "one_day_early"
                  ],
                  "default": "standard",
                  "description": "additional service. With 'one_day' you get express delivery, 'one_day_early' is express delivery until 10am."
                },
                "to": {
                  "$ref": "#/$defs/address",
                  "description": "the receivers address"
                },
                "create_shipping_label": {
                  "type": "boolean",
                  "description": "determines if a shipping label should be created at the carrier (this means you will be charged)"
                },
                "from": {
                  "$ref": "#/$defs/address",
                  "description": "If missing, the default sender address (if defined in your shipcloud account) will be used"
                },
                "reference_number": {
                  "type": "string",
                  "description": "a reference number (max. 30 characters) that you want this shipment to be identified with. You can use this afterwards to easier find the shipment in the shipcloud.io backoffice"
                }
              },
              "required": [
                "carrier",
                "to",
                "package"
              ]
            },
            {
              "patternProperties": {
                "^carrier$": true,
                "^package$": true,
                "^to$": true,
                "^create_shipping_label$": true,
                "^service$": true,
                "^from$": true,
                "^reference_number$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "address": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
