{
  "$id": "http://www.52north.org/schema/json/Geometry",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "crs": {
      "$ref": "#/$defs/crs"
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/GeometryCollection"
    },
    {
      "$ref": "#/$defs/Point"
    },
    {
      "$ref": "#/$defs/MultiPoint"
    },
    {
      "$ref": "#/$defs/LineString"
    },
    {
      "$ref": "#/$defs/MultiLineString"
    },
    {
      "$ref": "#/$defs/Polygon"
    },
    {
      "$ref": "#/$defs/MultiPolygon"
    }
  ],
  "$defs": {
    "LineString": {
      "required": [
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "LineString"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/lineString"
        }
      }
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type",
                "properties"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "properties": {
                  "type": "object"
                }
              },
              "oneOf": [
                {
                  "properties": {
                    "type": {
                      "enum": [
                        "name"
                      ]
                    },
                    "properties": {
                      "$ref": "#/$defs/modern_2"
                    }
                  }
                },
                {
                  "properties": {
                    "type": {
                      "enum": [
                        "link"
                      ]
                    },
                    "properties": {
                      "$ref": "#/$defs/modern_3"
                    }
                  }
                }
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^properties$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "Point": {
      "required": [
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Point"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "MultiPolygon": {
      "required": [
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/polygonCoordinates"
          }
        }
      }
    },
    "positionArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "GeometryCollection": {
      "required": [
        "geometries"
      ],
      "properties": {
        "type": {
          "enum": [
            "GeometryCollection"
          ]
        },
        "geometries": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      }
    },
    "lineString": {
      "allOf": [
        {
          "$ref": "#/$defs/positionArray"
        },
        {
          "minItems": 2
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "href"
              ],
              "properties": {
                "href": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^href$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "MultiLineString": {
      "required": [
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "MultiLineString"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineString"
          }
        }
      }
    },
    "crs": {
      "$ref": "#/$defs/modern_1"
    },
    "Polygon": {
      "required": [
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "Polygon"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/polygonCoordinates"
        }
      }
    },
    "MultiPoint": {
      "required": [
        "coordinates"
      ],
      "properties": {
        "type": {
          "enum": [
            "MultiPoint"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/positionArray"
        }
      }
    },
    "polygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/positionArray"
          },
          {
            "minItems": 4
          }
        ]
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  }
}
