{
  "$id": "http://www.52north.org/schema/json/sos/request/Request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "request",
    "service"
  ],
  "properties": {
    "request": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "2.0.0"
      ]
    },
    "service": {
      "type": "string",
      "enum": [
        "SOS"
      ]
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "$defs": {
    "extension": {
      "type": "object",
      "required": [
        "definition",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "definition": {
          "type": "string"
        },
        "value": {
          "type": [
            "boolean",
            "string"
          ]
        }
      }
    }
  }
}
