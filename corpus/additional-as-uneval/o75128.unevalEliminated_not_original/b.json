{
  "$id": "http://www.52north.org/schema/json/sos/request/Request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "request",
    "service"
  ],
  "properties": {
    "request": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "enum": [
        "1.0.0",
        "2.0.0"
      ]
    },
    "service": {
      "type": "string",
      "enum": [
        "SOS"
      ]
    },
    "extensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "definition",
                "value"
              ],
              "properties": {
                "definition": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "boolean",
                    "string"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^definition$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "extension": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
