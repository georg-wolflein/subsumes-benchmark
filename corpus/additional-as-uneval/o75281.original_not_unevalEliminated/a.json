{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attributes": {
      "type": "object",
      "properties": {
        "preferred_shipping": {
          "type": "boolean",
          "description": "Description for preferred_shipping"
        },
        "preferred_billing": {
          "type": "boolean",
          "description": "Description for preferred_billing"
        },
        "state": {
          "type": "string",
          "description": "Description for state"
        },
        "customer_account_id": {
          "type": "number",
          "description": "Description for customer_account_id"
        },
        "postcode": {
          "type": "string",
          "description": "Description for postcode"
        },
        "address_line_3": {
          "type": "string",
          "description": "Description for address_line_3"
        },
        "country": {
          "type": "string",
          "description": "Description for country"
        },
        "last_name": {
          "type": "string",
          "description": "Description for last_name"
        },
        "address_line_2": {
          "type": "string",
          "description": "Description for address_line_2"
        },
        "middle_names": {
          "type": "string",
          "description": "Description for middle_names"
        },
        "address_line_1": {
          "type": "string",
          "description": "Description for address_line_1"
        },
        "meta_attributes": {
          "type": "object",
          "description": "Description for meta_attributes"
        },
        "first_name": {
          "type": "string",
          "description": "Description for first_name"
        },
        "city": {
          "type": "string",
          "description": "Description for city"
        }
      }
    },
    "type": {
      "type": "string",
      "description": "The json_api type for any address.json",
      "pattern": "^addresses$"
    },
    "relationships": {
      "type": "object",
      "properties": {
        "customer_account": {
          "type": "object",
          "properties": {
            "links": {
              "$ref": "#/$defs/modern_1"
            },
            "data": {
              "$ref": "#/$defs/modern_2"
            },
            "meta": {
              "$ref": "#/$defs/modern_3"
            }
          }
        }
      }
    },
    "links": {
      "$ref": "#/$defs/modern_4"
    },
    "id": {
      "type": "string",
      "description": "A unique identifier for the address.json"
    },
    "meta": {
      "$ref": "#/$defs/modern_5"
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "self": {
                  "type": "string"
                },
                "related": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^self$": true,
                "^related$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "The id and type form a pointer into the 'included' top level document property",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "self": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^self$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
