{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attributes": {
      "type": "object",
      "properties": {
        "reference": {
          "type": "string",
          "description": "Description for reference"
        },
        "image_width": {
          "type": "number",
          "description": "Description for image_width"
        },
        "name": {
          "type": "string",
          "description": "Description for name"
        },
        "asset_file": {
          "type": "string",
          "description": "Description for asset_file"
        },
        "image_height": {
          "type": "number",
          "description": "Description for image_height"
        },
        "file_content_content_type": {
          "type": "string",
          "description": "Description for file_content_content_type"
        },
        "created_at": {
          "type": "string",
          "description": "Description for created_at"
        },
        "updated_at": {
          "type": "string",
          "description": "Description for updated_at"
        },
        "meta_attributes": {
          "type": "object",
          "description": "Description for meta_attributes"
        },
        "file_content_size": {
          "type": "number",
          "description": "Description for file_content_size"
        },
        "s3_url": {
          "type": "string",
          "description": "Description for s3_url"
        },
        "deleted_at": {
          "type": "null",
          "description": "Description for deleted_at"
        },
        "file_content_filename": {
          "type": "string",
          "description": "Description for file_content_filename"
        }
      }
    },
    "type": {
      "type": "string",
      "description": "The json_api type for any asset_file.json",
      "pattern": "^asset_files$"
    },
    "relationships": {
      "type": "object",
      "properties": {
        "asset_folder": {
          "type": "object",
          "properties": {
            "links": {
              "$ref": "#/$defs/modern_1"
            },
            "data": {
              "oneOf": [
                {
                  "$ref": "#/$defs/modern_2"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              ]
            },
            "meta": {
              "$ref": "#/$defs/modern_4"
            }
          }
        }
      }
    },
    "links": {
      "$ref": "#/$defs/modern_5"
    },
    "id": {
      "type": "string",
      "description": "A unique identifier for the asset_file.json"
    },
    "meta": {
      "$ref": "#/$defs/modern_6"
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "self": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^self$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "self": {
                  "type": "string"
                },
                "related": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^self$": true,
                "^related$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "The id and type form a pointer into the 'included' top level document property",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "The id and type form a pointer into the 'included' top level document property",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
