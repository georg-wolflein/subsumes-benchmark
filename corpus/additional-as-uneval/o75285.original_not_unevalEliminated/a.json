{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "attributes": {
      "type": "object",
      "properties": {
        "price": {
          "type": "number",
          "description": "Description for price"
        },
        "start_at": {
          "type": "string",
          "description": "Description for start_at"
        },
        "end_at": {
          "type": "string",
          "description": "Description for end_at"
        }
      }
    },
    "type": {
      "type": "string",
      "description": "The json_api type for any markdown_price.json",
      "pattern": "^markdown_prices$"
    },
    "relationships": {
      "type": "object",
      "properties": {}
    },
    "links": {
      "$ref": "#/$defs/modern_1"
    },
    "id": {
      "type": "string",
      "description": "A unique identifier for the markdown_price.json"
    },
    "meta": {
      "$ref": "#/$defs/modern_2"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "self": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^self$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
