{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Address",
              "description": "A users invoice address",
              "type": "object",
              "properties": {
                "zip_code": {
                  "type": "string"
                },
                "street_no": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "country": {
                  "type": "string",
                  "description": "Country as uppercase ISO 3166-1 alpha-2 code"
                },
                "company": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                },
                "street": {
                  "type": "string"
                },
                "care_of": {
                  "type": "string"
                },
                "phone": {
                  "type": "string"
                },
                "first_name": {
                  "type": "string"
                },
                "city": {
                  "type": "string"
                }
              },
              "required": [
                "last_name",
                "street",
                "street_no",
                "city",
                "zip_code",
                "country"
              ]
            },
            {
              "patternProperties": {
                "^city$": true,
                "^phone$": true,
                "^state$": true,
                "^first_name$": true,
                "^company$": true,
                "^country$": true,
                "^last_name$": true,
                "^care_of$": true,
                "^street_no$": true,
                "^street$": true,
                "^zip_code$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
