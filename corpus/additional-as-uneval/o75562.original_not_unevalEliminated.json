{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o75562.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o75562.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "carrier": {
                    "description": "carrier used for this pickup request",
                    "type": "string"
                  },
                  "pickup_time": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "id": {
                    "description": "shipcloud identifier for this pickup request",
                    "type": "string"
                  },
                  "carrier_pickup_number": {
                    "description": "carrier identifier for this pickup request",
                    "type": "string"
                  },
                  "shipments": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "pickup_address": {
                    "$ref": "#/$defs/modern_4"
                  }
                },
                "required": [
                  "id",
                  "carrier",
                  "pickup_time"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^pickup_address$": true,
                  "^pickup_time$": true,
                  "^id$": true,
                  "^shipments$": true,
                  "^carrier$": true,
                  "^carrier_pickup_number$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "defined time window when the carrier should pickup shipments",
                "properties": {
                  "earliest": {
                    "_format": "date-time",
                    "type": "string"
                  },
                  "latest": {
                    "_format": "date-time",
                    "type": "string"
                  }
                },
                "required": [
                  "earliest",
                  "latest"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^earliest$": true,
                  "^latest$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "items": {
                  "properties": {
                    "id": {
                      "description": "id of the shipment included in this pickup request",
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "required": [
                  "id"
                ],
                "type": "array"
              },
              {
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "address where the carrier should pick up shipments",
                "properties": {
                  "zip_code": {
                    "type": "string"
                  },
                  "street_no": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "country": {
                    "description": "Country as uppercase ISO 3166-1 alpha-2 code",
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  },
                  "id": {
                    "description": "identifier of a previously created address",
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "street": {
                    "type": "string"
                  },
                  "care_of": {
                    "type": "string"
                  },
                  "phone": {
                    "description": "telephone number (mandatory when using UPS and the following terms apply: service is one_day or one_day_early or ship to country is different than ship from country)",
                    "type": "string"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  }
                },
                "required": [
                  "last_name",
                  "street",
                  "street_no",
                  "city",
                  "zip_code",
                  "country"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^city$": true,
                  "^phone$": true,
                  "^state$": true,
                  "^company$": true,
                  "^country$": true,
                  "^last_name$": true,
                  "^care_of$": true,
                  "^street_no$": true,
                  "^street$": true,
                  "^zip_code$": true,
                  "^first_name$": true,
                  "^id$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "carrier": {
        "description": "carrier used for this pickup request",
        "type": "string"
      },
      "carrier_pickup_number": {
        "description": "carrier identifier for this pickup request",
        "type": "string"
      },
      "id": {
        "description": "shipcloud identifier for this pickup request",
        "type": "string"
      },
      "pickup_address": {
        "additionalProperties": false,
        "description": "address where the carrier should pick up shipments",
        "properties": {
          "care_of": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "company": {
            "type": "string"
          },
          "country": {
            "description": "Country as uppercase ISO 3166-1 alpha-2 code",
            "type": "string"
          },
          "first_name": {
            "type": "string"
          },
          "id": {
            "description": "identifier of a previously created address",
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "phone": {
            "description": "telephone number (mandatory when using UPS and the following terms apply: service is one_day or one_day_early or ship to country is different than ship from country)",
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "street": {
            "type": "string"
          },
          "street_no": {
            "type": "string"
          },
          "zip_code": {
            "type": "string"
          }
        },
        "required": [
          "last_name",
          "street",
          "street_no",
          "city",
          "zip_code",
          "country"
        ],
        "type": "object"
      },
      "pickup_time": {
        "additionalProperties": false,
        "description": "defined time window when the carrier should pickup shipments",
        "properties": {
          "earliest": {
            "_format": "date-time",
            "type": "string"
          },
          "latest": {
            "_format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "earliest",
          "latest"
        ],
        "type": "object"
      },
      "shipments": {
        "additionalProperties": false,
        "items": {
          "properties": {
            "id": {
              "description": "id of the shipment included in this pickup request",
              "type": "string"
            }
          },
          "type": "object"
        },
        "required": [
          "id"
        ],
        "type": "array"
      }
    },
    "required": [
      "id",
      "carrier",
      "pickup_time"
    ],
    "type": "object"
  }
}
