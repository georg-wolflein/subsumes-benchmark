{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o75574.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o75574.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "description": "the webhook id that can be used for requesting info about a webhook or deleting it"
                  },
                  "url": {
                    "type": "string",
                    "description": "the URL of the webhook"
                  },
                  "event_types": {
                    "type": "array",
                    "description": "the subscripted event types"
                  },
                  "deactivated": {
                    "type": "boolean",
                    "description": "is set to true, if the call of the webhook url fails ten times."
                  }
                },
                "required": [
                  "id",
                  "url",
                  "event_types"
                ]
              },
              {
                "patternProperties": {
                  "^id$": true,
                  "^url$": true,
                  "^event_types$": true,
                  "^deactivated$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "the webhook id that can be used for requesting info about a webhook or deleting it"
      },
      "url": {
        "type": "string",
        "description": "the URL of the webhook"
      },
      "event_types": {
        "type": "array",
        "description": "the subscripted event types"
      },
      "deactivated": {
        "type": "boolean",
        "description": "is set to true, if the call of the webhook url fails ten times."
      }
    },
    "required": [
      "id",
      "url",
      "event_types"
    ],
    "additionalProperties": false
  }
}
