{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "the webhook id that can be used for requesting info about a webhook or deleting it"
                },
                "url": {
                  "type": "string",
                  "description": "the URL of the webhook"
                },
                "event_types": {
                  "type": "array",
                  "description": "the subscripted event types"
                },
                "deactivated": {
                  "type": "boolean",
                  "description": "is set to true, if the call of the webhook url fails ten times."
                }
              },
              "required": [
                "id",
                "url",
                "event_types"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^url$": true,
                "^event_types$": true,
                "^deactivated$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
