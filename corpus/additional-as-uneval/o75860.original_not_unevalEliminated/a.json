{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Environment Modules",
              "description": "Information about the modules in a Puppet code environment",
              "type": "object",
              "properties": {
                "modules": {
                  "description": "The array of modules which exist in an environment.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "name": {
                  "description": "Name of the environment",
                  "type": "string"
                }
              },
              "required": [
                "modules",
                "name"
              ]
            },
            {
              "patternProperties": {
                "^modules$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "description": "The name of the puppet module",
                  "type": "string"
                },
                "version": {
                  "description": "The version of the puppet module",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
