{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pubsub push subscription request data",
  "description": "pubsub push subscription request data",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/modern_1"
    },
    {
      "$ref": "#/$defs/modern_2"
    }
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "dockerImageName": {
                  "type": "string",
                  "minLength": 1
                },
                "spider": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "dockerImageName",
                "spider",
                "args"
              ]
            },
            {
              "patternProperties": {
                "^dockerImageName$": true,
                "^spider$": true,
                "^args$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "dockerImageName": {
                  "type": "string",
                  "minLength": 1
                },
                "spider": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "dockerImageName",
                "spider"
              ]
            },
            {
              "patternProperties": {
                "^dockerImageName$": true,
                "^spider$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
