{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "get user response",
              "properties": {
                "email": {
                  "minLength": 1,
                  "type": "string"
                },
                "links": {
                  "properties": {
                    "self": {
                      "properties": {
                        "href": {
                          "_format": "uri",
                          "type": "string"
                        }
                      },
                      "required": [
                        "href"
                      ],
                      "type": "object"
                    }
                  },
                  "required": [
                    "self"
                  ],
                  "type": "object"
                },
                "credentials": {
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "password": {
                  "minLength": 1,
                  "type": "string"
                },
                "userId": {
                  "minLength": 1,
                  "type": "string"
                },
                "dockerImageName": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "userId",
                "email",
                "password",
                "dockerImageName",
                "credentials",
                "links"
              ],
              "title": "get user response",
              "type": "object"
            },
            {
              "patternProperties": {
                "^dockerImageName$": true,
                "^links$": true,
                "^password$": true,
                "^userId$": true,
                "^credentials$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "secret": {
                  "minLength": 1,
                  "type": "string"
                },
                "createdOn": {
                  "minLength": 1,
                  "type": "string"
                },
                "revokedOn": {
                  "minLength": 1,
                  "type": "string"
                },
                "expiresOn": {
                  "minLength": 1,
                  "type": "string"
                },
                "key": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "key",
                "secret",
                "createdOn",
                "expiresOn"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^expiresOn$": true,
                "^revokedOn$": true,
                "^createdOn$": true,
                "^secret$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
