{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "put user request",
              "description": "put user request",
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "minLength": 1
                },
                "password": {
                  "type": "string",
                  "minLength": 1
                },
                "dockerImageName": {
                  "type": "string",
                  "minLength": 1
                },
                "credentials": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "email",
                "password",
                "dockerImageName",
                "credentials"
              ]
            },
            {
              "patternProperties": {
                "^email$": true,
                "^password$": true,
                "^dockerImageName$": true,
                "^credentials$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "secret": {
                  "type": "string",
                  "minLength": 1
                },
                "createdOn": {
                  "type": "string",
                  "minLength": 1
                },
                "revokedOn": {
                  "type": "string",
                  "minLength": 1
                },
                "expiresOn": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "key",
                "secret",
                "createdOn",
                "expiresOn"
              ]
            },
            {
              "patternProperties": {
                "^expiresOn$": true,
                "^revokedOn$": true,
                "^createdOn$": true,
                "^secret$": true,
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
