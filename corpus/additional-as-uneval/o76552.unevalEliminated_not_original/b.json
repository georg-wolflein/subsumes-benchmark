{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "mesos_master_url": {
                  "description": "Mesos master URL. Must be set in format: \"http://host:port\"",
                  "format": "uri",
                  "title": "Mesos Master URL",
                  "type": "string"
                },
                "ssl_verify": {
                  "default": "false",
                  "description": "Whether to verify SSL certs for HTTPS or path to certs",
                  "title": "SSL Verification",
                  "type": "string"
                },
                "pagination": {
                  "default": true,
                  "description": "Whether to paginate output",
                  "title": "Pagination",
                  "type": "boolean"
                },
                "timeout": {
                  "default": 5,
                  "description": "Request timeout in seconds",
                  "minimum": 1.0,
                  "title": "Request timeout in seconds",
                  "type": "integer"
                },
                "dcos_url": {
                  "description": "The public master IP of your DC/OS installation",
                  "format": "uri",
                  "title": "DC/OS URL",
                  "type": "string"
                },
                "reporting": {
                  "default": true,
                  "description": "Whether to report usage events to Mesosphere",
                  "title": "Usage Reporting",
                  "type": "boolean"
                },
                "dcos_acs_token": {
                  "description": "The token generated by authenticating to DC/OS with ACS",
                  "title": "DC/OS ACS token",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^timeout$": true,
                "^dcos_url$": true,
                "^dcos_acs_token$": true,
                "^mesos_master_url$": true,
                "^pagination$": true,
                "^ssl_verify$": true,
                "^reporting$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
