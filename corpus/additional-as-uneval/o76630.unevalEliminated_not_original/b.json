{
  "$anchor": "account",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "account"
  ],
  "properties": {
    "account": {
      "$ref": "#/$defs/modern_1"
    },
    "mbox": {
      "type": "null"
    },
    "mbox_sha1sum": {
      "type": "null"
    },
    "openid": {
      "type": "null"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "homePage",
                "name"
              ],
              "properties": {
                "homePage": {
                  "type": "string",
                  "format": "iri"
                },
                "name": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^homePage$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
