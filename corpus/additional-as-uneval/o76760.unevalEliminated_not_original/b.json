{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "isVerified": {
                  "type": "boolean"
                },
                "website": {
                  "_format": "uri",
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "posts": {
                  "type": "integer"
                },
                "username": {
                  "description": "the last segment of what Instagram calls a \"vanity url\"",
                  "type": "string"
                },
                "description": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "isExplicit": {
                  "type": "boolean"
                },
                "followers": {
                  "type": "integer"
                },
                "following": {
                  "type": "integer"
                },
                "isPrivate": {
                  "type": "boolean"
                },
                "userId": {
                  "type": "string"
                }
              },
              "required": [
                "description",
                "followers",
                "following",
                "isExplicit",
                "isPrivate",
                "isVerified",
                "name",
                "posts",
                "userId",
                "username",
                "website"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^isExplicit$": true,
                "^posts$": true,
                "^followers$": true,
                "^name$": true,
                "^website$": true,
                "^username$": true,
                "^description$": true,
                "^following$": true,
                "^userId$": true,
                "^isPrivate$": true,
                "^isVerified$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
