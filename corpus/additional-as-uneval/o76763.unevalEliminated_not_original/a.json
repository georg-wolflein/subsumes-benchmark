{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "followers": {
      "type": "integer"
    },
    "following": {
      "type": "integer"
    },
    "isVerified": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "userId": {
      "type": "string"
    },
    "username": {
      "type": "string",
      "description": "the last segment of what Instagram calls a \"vanity url\""
    },
    "posts": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "required": [
    "description",
    "followers",
    "following",
    "isVerified",
    "name",
    "posts",
    "userId",
    "username"
  ]
}
