{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "retweet": {
                  "type": "integer",
                  "minimum": 0.0
                },
                "favorite": {
                  "type": "integer",
                  "minimum": 0.0
                },
                "username": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "reply": {
                  "type": "integer",
                  "minimum": 0.0
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9]+$"
                },
                "isRetweet": {
                  "type": "boolean"
                },
                "time": {
                  "description": "UNIX time at which the post was made",
                  "minimum": 1136091600.0,
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "image",
                    "video"
                  ]
                },
                "images": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              },
              "required": [
                "id",
                "username",
                "time",
                "type",
                "isRetweet",
                "retweet",
                "favorite",
                "reply",
                "text",
                "images"
              ]
            },
            {
              "patternProperties": {
                "^retweet$": true,
                "^username$": true,
                "^images$": true,
                "^type$": true,
                "^isRetweet$": true,
                "^reply$": true,
                "^text$": true,
                "^favorite$": true,
                "^id$": true,
                "^time$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
