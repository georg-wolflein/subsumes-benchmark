{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "posts": {
                  "type": "integer"
                },
                "username": {
                  "type": "string",
                  "description": "the last segment of what vine calls a \"vanity url\""
                },
                "description": {
                  "type": "string"
                },
                "isExplicit": {
                  "type": "boolean"
                },
                "followers": {
                  "type": "integer"
                },
                "following": {
                  "type": "integer"
                },
                "authoredPosts": {
                  "type": "integer"
                },
                "isPrivate": {
                  "type": "boolean"
                },
                "userId": {
                  "type": "string"
                },
                "totalLikedPosts": {
                  "type": "integer",
                  "description": "videos liked by this account"
                },
                "isVerified": {
                  "type": "boolean"
                },
                "name": {
                  "type": "string"
                },
                "totalLoops": {
                  "type": "integer",
                  "description": "All the views on the videos of the given account."
                }
              },
              "required": [
                "description",
                "followers",
                "following",
                "isExplicit",
                "isPrivate",
                "isVerified",
                "name",
                "totalLoops",
                "totalLikedPosts",
                "userId",
                "username",
                "authoredPosts",
                "posts"
              ]
            },
            {
              "patternProperties": {
                "^totalLikedPosts$": true,
                "^isExplicit$": true,
                "^posts$": true,
                "^followers$": true,
                "^name$": true,
                "^totalLoops$": true,
                "^authoredPosts$": true,
                "^username$": true,
                "^description$": true,
                "^following$": true,
                "^userId$": true,
                "^isPrivate$": true,
                "^isVerified$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
