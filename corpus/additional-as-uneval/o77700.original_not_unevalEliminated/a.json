{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Schemas for activities items in activities array of main config file",
              "type": "object",
              "properties": {
                "name": {
                  "description": "Activity name",
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 64
                },
                "description": {
                  "description": "Activity description",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "version": {
                  "description": "Activity version",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[\\w\\.\\- ]+$"
                },
                "class": {
                  "description": "Class name implementing this activity",
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 256,
                  "pattern": "^[\\w\\-]+$"
                },
                "file": {
                  "description": "File implementing this activity",
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 1024,
                  "pattern": "^[\\w\\-\\./]+\\.php+$"
                }
              },
              "required": [
                "name",
                "version",
                "description",
                "file",
                "class",
                "scheduleToStartTimeout",
                "scheduleToCloseTimeout",
                "startToCloseTimeout",
                "heartbeatTimeout"
              ]
            },
            {
              "patternProperties": {
                "^description$": true,
                "^name$": true,
                "^class$": true,
                "^file$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
