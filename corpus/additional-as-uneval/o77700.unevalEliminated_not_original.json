{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "minLength",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o77700.unevalEliminated_not_original.json",
  "a": {
    "$id": "http://sportarchive.tv/input-schema/activities",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Schemas for activities items in activities array of main config file",
    "type": "object",
    "properties": {
      "name": {
        "description": "Activity name",
        "type": "string",
        "minLength": 3,
        "maxLength": 64
      },
      "version": {
        "description": "Activity version",
        "type": "string",
        "minLength": 1,
        "maxLength": 32,
        "pattern": "^[\\w\\.\\- ]+$"
      },
      "description": {
        "description": "Activity description",
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "file": {
        "description": "File implementing this activity",
        "type": "string",
        "minLength": 16,
        "maxLength": 1024,
        "pattern": "^[\\w\\-\\./]+\\.php+$"
      },
      "class": {
        "description": "Class name implementing this activity",
        "type": "string",
        "minLength": 8,
        "maxLength": 256,
        "pattern": "^[\\w\\-]+$"
      }
    },
    "required": [
      "name",
      "version",
      "description",
      "file",
      "class",
      "scheduleToStartTimeout",
      "scheduleToCloseTimeout",
      "startToCloseTimeout",
      "heartbeatTimeout"
    ],
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Schemas for activities items in activities array of main config file",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Activity name",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64
                  },
                  "description": {
                    "description": "Activity description",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "version": {
                    "description": "Activity version",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32,
                    "pattern": "^[\\w\\.\\- ]+$"
                  },
                  "class": {
                    "description": "Class name implementing this activity",
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 256,
                    "pattern": "^[\\w\\-]+$"
                  },
                  "file": {
                    "description": "File implementing this activity",
                    "type": "string",
                    "minLength": 16,
                    "maxLength": 1024,
                    "pattern": "^[\\w\\-\\./]+\\.php+$"
                  }
                },
                "required": [
                  "name",
                  "version",
                  "description",
                  "file",
                  "class",
                  "scheduleToStartTimeout",
                  "scheduleToCloseTimeout",
                  "startToCloseTimeout",
                  "heartbeatTimeout"
                ]
              },
              {
                "patternProperties": {
                  "^description$": true,
                  "^name$": true,
                  "^class$": true,
                  "^file$": true,
                  "^version$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
