{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "minLength",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o77701.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Schema for 'client'",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Client name",
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 64
                  },
                  "queues": {
                    "type": "object",
                    "properties": {
                      "input": {
                        "description": "SQS input queue",
                        "type": "string",
                        "pattern": "^https://.+$"
                      },
                      "output": {
                        "description": "SQS output queue",
                        "type": "string",
                        "pattern": "^https://.+$"
                      }
                    },
                    "required": [
                      "input",
                      "output"
                    ]
                  }
                },
                "required": [
                  "name",
                  "queues"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^queues$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://sport-archive.com/input-schema/client",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Schema for 'client'",
    "type": "object",
    "properties": {
      "name": {
        "description": "Client name",
        "type": "string",
        "minLength": 3,
        "maxLength": 64
      },
      "queues": {
        "type": "object",
        "properties": {
          "input": {
            "description": "SQS input queue",
            "type": "string",
            "pattern": "^https://.+$"
          },
          "output": {
            "description": "SQS output queue",
            "type": "string",
            "pattern": "^https://.+$"
          }
        },
        "required": [
          "input",
          "output"
        ]
      }
    },
    "required": [
      "name",
      "queues"
    ],
    "additionalProperties": false
  }
}
