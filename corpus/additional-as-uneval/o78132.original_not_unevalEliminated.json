{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o78132.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "total": {
        "description": "Total number of results returned by the search",
        "type": "integer"
      },
      "start": {
        "description": "The starting index of this set of results within the total set of results",
        "type": "integer"
      },
      "rows": {
        "description": "The results.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "description": "The URL to the object on the server (e.g. https://api.chef.io/organizations/foo/nodes/bar)",
              "type": "string",
              "format": "uri"
            },
            "data": {
              "$ref": "#/$defs/modern_1"
            }
          }
        }
      }
    },
    "example": {
      "total": 2,
      "start": 0,
      "rows": [
        {
          "url": "https://api.chef.io/organizations/essentials/nodes/monkey",
          "data": {
            "node_name": "monkey",
            "apache_port": 8080
          }
        },
        {
          "url": "https://api.chef.io/organizations/essentials/nodes/giraffe",
          "data": {
            "node_name": "giraffe",
            "apache_port": null
          }
        }
      ]
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "The desired data. Each key corresponds to a key from the POST.",
                "type": "string"
              },
              {
                "additionalProperties": {
                  "description": "The value of the attribute on the object (or null if the attribute was not on the object)."
                }
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "total": {
        "description": "Total number of results returned by the search",
        "type": "integer"
      },
      "start": {
        "description": "The starting index of this set of results within the total set of results",
        "type": "integer"
      },
      "rows": {
        "description": "The results.",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "description": "The URL to the object on the server (e.g. https://api.chef.io/organizations/foo/nodes/bar)",
              "type": "string",
              "format": "uri"
            },
            "data": {
              "description": "The desired data. Each key corresponds to a key from the POST.",
              "type": "string",
              "additionalProperties": {
                "description": "The value of the attribute on the object (or null if the attribute was not on the object)."
              }
            }
          }
        }
      }
    },
    "example": {
      "total": 2,
      "start": 0,
      "rows": [
        {
          "url": "https://api.chef.io/organizations/essentials/nodes/monkey",
          "data": {
