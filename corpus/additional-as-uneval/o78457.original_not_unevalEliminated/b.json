{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POI location",
  "type": "object",
  "properties": {
    "wgs84": {
      "title": "World Geodetic System",
      "description": "",
      "type": "object",
      "properties": {
        "latitude": {
          "description": "degrees north",
          "type": "number"
        },
        "longitude": {
          "description": "degrees east",
          "type": "number"
        },
        "height": {
          "description": "meters up from sea level, optional",
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
