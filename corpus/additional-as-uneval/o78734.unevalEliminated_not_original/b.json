                }
              },
              "required": [
                "vera__event_name__c"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^vera__boats__c$": true,
                "^vera__event_name__c$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "_id": "/vera__events__c/vera__boats__c/0",
              "properties": {
                "name": {
                  "_id": "/vera__events__c/vera__boats__c/0/name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
