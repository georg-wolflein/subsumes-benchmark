{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "start_date": {
                  "_id": "/start_date",
                  "type": "string"
                },
                "_id": {
                  "type": "string"
                },
                "markedAsCompleteDate": {
                  "_id": "/markedAsCompleteDate",
                  "type": "string"
                },
                "boats": {
                  "_id": "/boats",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "type": "array"
                },
                "cars": {
                  "_id": "/cars",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "type": [
                    "object",
                    "array"
                  ]
                },
                "instanceID": {
                  "_id": "/instanceID",
                  "type": "string"
                },
                "meta": {
                  "$ref": "#/$defs/modern_4"
                },
                "isComplete": {
                  "_id": "/isComplete",
                  "type": "string"
                },
                "submissionDate": {
                  "_id": "/submissionDate",
                  "type": "string"
                },
                "event_name": {
                  "_id": "/event_name",
                  "type": "string"
                }
              },
              "required": [
                "id",
                "instanceID",
                "submissionDate",
                "isComplete",
                "markedAsCompleteDate",
                "event_name",
                "start_date",
                "boats",
                "cars",
                "meta"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^boats$": true,
                "^cars$": true,
                "^instanceID$": true,
                "^start_date$": true,
                "^event_name$": true,
                "^submissionDate$": true,
                "^isComplete$": true,
                "^meta$": true,
                "^_id$": true,
                "^markedAsCompleteDate$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "_id": "/boats/0",
              "properties": {
                "boat_name": {
                  "_id": "/boats/0/boat_name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^boat_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "_id": "/cars/0",
              "properties": {
                "car_name": {
                  "_id": "/cars/0/car_name",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^car_name$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "_id": "/meta",
              "properties": {
                "instanceID": {
                  "_id": "/meta/instanceID",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^instanceID$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
