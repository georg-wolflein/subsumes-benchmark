{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Course Info Schema",
  "description": "A set of courses offered at concordia with information about each one.",
  "type": "array",
  "_uniqueItems": true,
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/alphaNumPunctString"
                },
                "description": {
                  "$ref": "#/$defs/alphaNumPunctString"
                },
                "credits": {
                  "$ref": "#/$defs/posNumRoundedToHundredths"
                },
                "labHours": {
                  "type": "string"
                },
                "code": {
                  "$ref": "#/$defs/courseCodeString"
                },
                "note": {
                  "type": "string"
                },
                "requirements": {
                  "type": "object",
                  "properties": {
                    "prereqs": {
                      "$ref": "#/$defs/arrayOfCourseCodeOrLists"
                    },
                    "coreqs": {
                      "$ref": "#/$defs/arrayOfCourseCodeOrLists"
                    }
                  }
                },
                "lectureHours": {
                  "type": "string"
                },
                "tutorialHours": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "name",
                "credits",
                "description",
                "requirements"
              ]
            },
            {
              "patternProperties": {
                "^code$": true,
                "^requirements$": true,
                "^description$": true,
                "^note$": true,
                "^name$": true,
                "^labHours$": true,
                "^credits$": true,
                "^lectureHours$": true,
                "^tutorialHours$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "alphaNumPunctString": {
      "type": "string",
      "pattern": "^[\\w\u00f1\u00fc\u00fa\u00e1\u00e0\u00ed\u00ce\u00f6\u00f3\u00f2\u00eb\u00e9\u00c9\u00e8\u00c8 ,'\u201c\u201d\u2018\u2019\"--\u00ad\u2010\u2011\u2012\u2013\u2014/.:;?\u00a7()\\[\\]]+$"
    },
    "courseCodeString": {
      "type": "string",
      "pattern": "^[A-Z]{4} [0-9]{3,4}$"
    },
    "posNumRoundedToHundredths": {
      "type": "string",
      "pattern": "^[0-9](\\.[0-9]{1,2})?$"
    },
    "arrayOfCourseCodeOrLists": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "$ref": "#/$defs/courseCodeString"
        }
      }
    }
  }
}
