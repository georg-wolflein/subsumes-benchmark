{
  "$id": "https://github.com/superzanti/ServerSync/server-config.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "title": "The directory_include_list schema",
              "description": "The directories that will be scanned for files to sync",
              "default": [],
              "examples": [
                [
                  {
                    "name": "test-mirror",
                    "mode": "mirror"
                  },
                  {
                    "name": "test-push",
                    "mode": "push"
                  }
                ]
              ],
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/modern_6"
                  },
                  {
                    "type": "string",
                    "title": "Named default mode",
                    "description": "Default sync mode for named directory",
                    "default": "",
                    "examples": [
                      "test-directory"
                    ]
                  }
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Object style included directory",
              "description": "Sync directory with details about how",
              "default": {},
              "examples": [
                {
                  "mode": "mirror",
                  "name": "test-mirror"
                }
              ],
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "title": "The name schema",
                  "description": "The name of the directory",
                  "default": "",
                  "examples": [
                    "test-mirror"
                  ]
                },
                "mode": {
                  "type": "string",
                  "pattern": "push|mirror",
                  "title": "The mode schema",
                  "description": "What style of sync is being used, mostly affects file deletion client side",
                  "default": "",
                  "examples": [
                    "mirror"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^mode$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "The server configuration schema",
              "description": "The root schema comprises the entire JSON document.",
              "default": {},
              "required": [
                "general",
                "connection",
                "rules",
                "misc"
              ],
              "properties": {
                "general": {
                  "$ref": "#/$defs/modern_2"
                },
                "connection": {
                  "$ref": "#/$defs/modern_3"
                },
                "rules": {
                  "$ref": "#/$defs/modern_4"
                },
                "misc": {
                  "$ref": "#/$defs/modern_9"
                }
              }
            },
            {
              "patternProperties": {
                "^general$": true,
                "^connection$": true,
                "^rules$": true,
                "^misc$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "title": "The file_ignore_list schema",
              "description": "A list of file patterns to ignore from sync",
              "default": [],
              "examples": [
                [
                  {
                    "pattern": "**/*.jar",
                    "description": "No JARs"
                  }
                ]
              ],
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/modern_8"
                  },
                  {
                    "type": "string",
                    "title": "Basic configuration",
                    "description": "A pattern to match without extra details",
                    "default": "",
                    "examples": [
                      "**/*.jar",
                      "example.jar",
                      "partial*.jar"
                    ]
                  }
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  true
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "The general schema",
              "description": "General configuration of the servers behavior",
              "default": {},
              "examples": [
                {
                  "sync_mode": 2,
                  "push_client_mods": false
                }
              ],
              "required": [
                "push_client_mods",
                "sync_mode"
              ],
              "properties": {
                "push_client_mods": {
                  "type": "boolean",
                  "title": "The push_client_mods schema",
                  "description": "Should clientmods be used for suggesting client side only mods",
                  "default": false,
                  "examples": [
                    false
                  ]
                },
                "sync_mode": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 2.0,
                  "title": "The sync_mode schema",
                  "description": "The type of file transfer that the server uses",
                  "default": 2,
                  "examples": [
                    2
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^push_client_mods$": true,
                "^sync_mode$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Detailed configuration",
              "description": "Used to specify extra information about a pattern",
              "default": {},
              "examples": [
                {
                  "pattern": "**/*.jar",
                  "description": "No JARs"
                }
              ],
              "required": [
                "pattern"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "title": "A description about the purpose of this pattern",
                  "description": "Use this to remind yourself why you are ignoring this pattern",
                  "default": "",
                  "examples": [
                    "No JARs"
                  ]
                },
                "pattern": {
                  "type": "string",
                  "title": "The pattern to match against",
                  "description": "Matches using GLOB patterns",
                  "default": "",
                  "examples": [
                    "**/*.jar"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^description$": true,
                "^pattern$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "The misc schema",
              "description": "Unspecified other settings",
              "default": {},
              "examples": [
                {
                  "locale": "en_NZ"
                }
              ],
              "required": [
                "locale"
              ],
              "properties": {
                "locale": {
                  "type": "string",
                  "title": "The locale",
                  "description": "What language should serversync load in",
                  "default": "",
                  "examples": [
                    "en_NZ"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^locale$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "The connection schema",
              "description": "Details about where your server communicates from",
              "default": {},
              "examples": [
                {
                  "port": 38067
                }
              ],
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer",
                  "title": "The port schema",
                  "description": "The port the server is serving on",
                  "default": 38067,
                  "examples": [
                    38067
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^port$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "The rules schema",
              "description": "Rules about what files to transfer and how",
              "default": {},
              "examples": [
                {
                  "file_ignore_list": [
                    {
                      "pattern": "**/*.jar"
                    }
                  ],
                  "directory_include_list": [
                    {
                      "name": "test-mirror",
                      "mode": "mirror"
                    },
                    {
                      "name": "test-push",
                      "mode": "push"
                    }
                  ]
                }
              ],
              "required": [
                "directory_include_list",
                "file_ignore_list"
              ],
              "properties": {
                "directory_include_list": {
                  "$ref": "#/$defs/modern_5"
                },
                "file_ignore_list": {
                  "$ref": "#/$defs/modern_7"
                }
              }
            },
            {
              "patternProperties": {
                "^directory_include_list$": true,
                "^file_ignore_list$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
