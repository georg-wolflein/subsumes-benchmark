{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "assets": {
      "$ref": "#/$defs/modern_1"
    },
    "images": {
      "$ref": "#/$defs/modern_5"
    }
  },
  "type": "object",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "icon-large": {
                  "description": "PNG icon URL, preferably 256 by 256 pixels.",
                  "type": "string"
                },
                "icon-medium": {
                  "description": "PNG icon URL, preferably 128 by 128 pixels.",
                  "type": "string"
                },
                "icon-small": {
                  "description": "PNG icon URL, preferably 48 by 48 pixels.",
                  "type": "string"
                },
                "screenshots": {
                  "items": {
                    "description": "PNG screen URL, preferably 1024 by 1024 pixels.",
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^icon-large$": true,
                "^icon-medium$": true,
                "^icon-small$": true,
                "^screenshots$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "container": {
                  "$ref": "#/$defs/modern_2"
                },
                "uris": {
                  "$ref": "#/$defs/modern_4"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^container$": true,
                "^uris$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "docker": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^docker$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    }
  }
}
