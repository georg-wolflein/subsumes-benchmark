{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "capabilities": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/capability"
                  }
                }
              },
              "required": [
                "capabilities"
              ]
            },
            {
              "patternProperties": {
                "^capabilities$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "capability": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
