{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "packageName": {
                  "type": "string"
                },
                "appId": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^packageName$": true,
                "^appId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
