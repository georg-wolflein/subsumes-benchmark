{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "uri": {
      "$ref": "#/$defs/httpUri"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "httpUri": {
      "type": "string",
      "allOf": [
        {
          "format": "uri"
        },
        {
          "pattern": "^https?://"
        }
      ]
    }
  }
}
