{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "results": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              "required": [
                "results"
              ]
            },
            {
              "patternProperties": {
                "^results$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "packageName": {
                  "type": "string"
                },
                "appId": {
                  "type": "string"
                },
                "packageVersion": {
                  "type": "string"
                },
                "postUninstallNotes": {
                  "type": "string"
                }
              },
              "required": [
                "packageName",
                "appId"
              ]
            },
            {
              "patternProperties": {
                "^packageName$": true,
                "^appId$": true,
                "^packageVersion$": true,
                "^postUninstallNotes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
