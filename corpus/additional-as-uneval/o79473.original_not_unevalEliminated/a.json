{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "shortCode": {
                  "type": "string",
                  "description": "the developer's shortcode"
                },
                "name": {
                  "type": "string",
                  "description": "the developer's name"
                },
                "blurb": {
                  "type": "string",
                  "description": "the developer's blurb"
                },
                "description": {
                  "type": "string",
                  "description": "the developer's description"
                }
              },
              "required": [
                "shortCode",
                "name",
                "blurb"
              ]
            },
            {
              "patternProperties": {
                "^shortCode$": true,
                "^name$": true,
                "^blurb$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "developer": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "details about a specific app",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "the app's name"
                },
                "description": {
                  "type": "string",
                  "description": "the app's description"
                },
                "learnMoreUrl": {
                  "type": "string",
                  "description": "the app's learnMoreUrl"
                },
                "principalType": {
                  "type": "string",
                  "description": "the app's principal type (if it is SSO)"
                },
                "blurb": {
                  "type": "string",
                  "description": "the app's blurb"
                },
                "shortCode": {
                  "type": "string",
                  "description": "the app's shortcode"
                },
                "logoUrl": {
                  "type": "string",
                  "format": "url",
                  "description": "the app's logo"
                },
                "developer": {
                  "$ref": "#/$defs/developer"
                }
              },
              "required": [
                "shortCode",
                "name",
                "blurb",
                "developer"
              ]
            },
            {
              "patternProperties": {
                "^blurb$": true,
                "^developer$": true,
                "^name$": true,
                "^logoUrl$": true,
                "^principalType$": true,
                "^learnMoreUrl$": true,
                "^description$": true,
                "^shortCode$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
