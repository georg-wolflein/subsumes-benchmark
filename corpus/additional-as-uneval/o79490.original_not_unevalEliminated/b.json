{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "installs": {
      "description": "apps to be installed",
      "$ref": "#/$defs/appList"
    },
    "unInstalls": {
      "description": "apps to be uninstalled",
      "$ref": "#/$defs/appList"
    }
  },
  "$defs": {
    "app": {
      "type": "string",
      "description": "the shortCode of an app"
    },
    "appList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/app"
      }
    }
  }
}
