{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "incarnation": {
                  "type": "integer",
                  "description": "a number representing the 'configuration version' of this tenant. Incremented on any changes to the installed apps."
                },
                "securityGeneration": {
                  "type": "integer",
                  "description": "a number representing the 'security version' of this tenant. Incremented when tenant signals such during a patch operation."
                },
                "state": {
                  "enum": [
                    "PREHALTING",
                    "PREHALTED",
                    "HALTING",
                    "HALTED",
                    "PRESTARTING",
                    "PRESTARTED",
                    "STARTING",
                    "STARTED",
                    "BROKEN"
                  ],
                  "description": "The tenant's current status."
                }
              },
              "required": [
                "incarnation",
                "securityGeneration"
              ]
            },
            {
              "patternProperties": {
                "^incarnation$": true,
                "^securityGeneration$": true,
                "^state$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
