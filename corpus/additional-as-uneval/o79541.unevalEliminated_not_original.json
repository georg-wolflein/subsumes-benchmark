{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79541.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "details of a candidate's ability to apply for a given job",
    "properties": {
      "allowed": {
        "type": "boolean",
        "description": "true of the candidate is allowed to apply for this job, otherwise false"
      },
      "notAllowedMessage": {
        "type": "string",
        "description": "details of why the candidate is not allowed to apply - e.g. 'You've already applied'"
      }
    },
    "additionalProperties": false,
    "required": [
      "allowed",
      "notAllowedMessage"
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "details of a candidate's ability to apply for a given job",
                "properties": {
                  "allowed": {
                    "type": "boolean",
                    "description": "true of the candidate is allowed to apply for this job, otherwise false"
                  },
                  "notAllowedMessage": {
                    "type": "string",
                    "description": "details of why the candidate is not allowed to apply - e.g. 'You've already applied'"
                  }
                },
                "required": [
                  "allowed",
                  "notAllowedMessage"
                ]
              },
              {
                "patternProperties": {
                  "^allowed$": true,
                  "^notAllowedMessage$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
