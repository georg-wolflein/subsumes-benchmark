{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "$ref": "#/$defs/operation"
                }
              },
              "required": [
                "operation"
              ]
            },
            {
              "patternProperties": {
                "^operation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "operation": {
      "enum": [
        "insert",
        "update",
        "delete"
      ]
    }
  }
}
