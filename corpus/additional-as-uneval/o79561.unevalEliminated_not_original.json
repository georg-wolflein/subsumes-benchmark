                  }
                },
                "required": [
                  "operation"
                ]
              },
              {
                "patternProperties": {
                  "^operation$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "operation": {
        "enum": [
          "insert",
          "update",
          "delete"
        ]
      }
    }
  }
}
