{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "ca": {
      "$ref": "#/$defs/ca"
    },
    "created": {
      "$ref": "#/$defs/created"
    },
    "ct": {
      "$ref": "#/$defs/ct"
    },
    "id": {
      "$ref": "#/$defs/id"
    }
  },
  "required": [
    "id",
    "ct",
    "ca",
    "created"
  ],
  "type": "object",
  "$defs": {
    "ca": {
      "description": "The consuming app",
      "type": "string"
    },
    "created": {
      "_format": "date-time",
      "description": "when the object was created",
      "type": "string"
    },
    "ct": {
      "description": "The consuming tenant",
      "type": "string"
    },
    "id": {
      "type": "integer"
    }
  }
}
