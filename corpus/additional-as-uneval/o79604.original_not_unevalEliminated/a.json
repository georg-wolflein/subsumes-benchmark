{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_3",
  "$defs": {
    "crudOutcomes": {
      "items": {
        "$ref": "#/$defs/crudOutcome"
      },
      "type": "array"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "failed": {
                  "description": "how many objects in the set have so far been unsuccessfully [operation]",
                  "type": "integer"
                },
                "failureDetails": {
                  "items": {
                    "$ref": "#/$defs/failureDetail"
                  },
                  "type": "array"
                },
                "operation": {
                  "enum": [
                    "Created",
                    "Updated",
                    "Closed"
                  ]
                },
                "succeeded": {
                  "description": "how many objects in the set have so far been successfully [operation]",
                  "type": "integer"
                }
              },
              "required": [
                "operation",
                "succeeded",
                "failed"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^failed$": true,
                "^failureDetails$": true,
                "^operation$": true,
                "^succeeded$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "crudOutcome": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "details of why a single object failed the crud operation (create or whatever)",
              "properties": {
                "code": {
                  "description": "A code, e.g. on a job or job ad, that uniquely identifies the object",
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^code$": true,
                "^message$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "the status of a previously launched upload",
              "properties": {
                "id": {
                  "description": "id of the upload operation",
                  "type": "integer"
                },
                "results": {
                  "$ref": "#/$defs/crudOutcomes"
                },
                "started": {
                  "_format": "date-time",
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "Queued",
                    "Underway",
                    "Complete",
                    "Error"
                  ]
                }
              },
              "required": [
                "id",
                "started",
                "status",
                "results"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^id$": true,
                "^results$": true,
                "^started$": true,
                "^status$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "failureDetail": {
      "$ref": "#/$defs/modern_2"
    }
  }
}
