{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79609.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "created": {
                    "$ref": "#/$defs/created"
                  },
                  "key": {
                    "$ref": "#/$defs/key"
                  }
                },
                "required": [
                  "key",
                  "created"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^created$": true,
                  "^key$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "key": {
        "type": "string"
      },
      "created": {
        "_format": "date-time",
        "description": "when the view was created",
        "type": "string"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "created": {
        "$ref": "#/$defs/created"
      },
      "key": {
        "$ref": "#/$defs/key"
      }
    },
    "required": [
      "key",
      "created"
    ],
    "type": "object",
    "$defs": {
      "created": {
        "_format": "date-time",
        "description": "when the view was created",
        "type": "string"
      },
      "key": {
        "type": "string"
      }
    }
  }
}
