{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Transport the value of an input",
              "minProperties": 1,
              "properties": {
                "v": {
                  "description": "value as integer",
                  "type": "integer"
                }
              },
              "required": [
                "v"
              ],
              "title": "Single value schema",
              "type": "object"
            },
            {
              "patternProperties": {
                "^v$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
