{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/component",
  "$defs": {
    "typedterminal": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "primitive",
            "valuespace",
            "propertyref",
            "keyword"
          ]
        },
        "name": {
          "type": "string"
        },
        "optional": {
          "type": "boolean"
        },
        "range": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "name"
      ]
    },
    "stringterminal": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^string$"
        },
        "content": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "content"
      ]
    },
    "oneOf": {
      "type": "object",
      "properties": {
        "oneOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "nonempty": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "oneOf"
      ]
    },
    "anyOf": {
      "type": "object",
      "properties": {
        "anyOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "nonempty": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "anyOf"
      ]
    },
    "allOf": {
      "type": "object",
      "properties": {
        "allOf": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/component"
          }
        },
        "nonempty": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "allOf"
      ]
    },
    "sequence": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^array$"
        },
        "items": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/component"
              }
            },
            {
              "$ref": "#/$defs/component"
            }
          ]
        },
        "minItems": {
          "type": "number"
        },
        "maxItems": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ]
    },
    "function": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^function$"
        },
        "arguments": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/component"
              }
            },
            {
              "$ref": "#/$defs/component"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "arguments"
      ]
    },
    "component": {
      "oneOf": [
        {
          "$ref": "#/$defs/typedterminal"
        },
        {
          "$ref": "#/$defs/stringterminal"
        },
        {
          "$ref": "#/$defs/oneOf"
        },
        {
          "$ref": "#/$defs/anyOf"
        },
        {
          "$ref": "#/$defs/allOf"
        },
        {
          "$ref": "#/$defs/sequence"
        },
        {
          "$ref": "#/$defs/function"
        }
      ]
    }
  }
}
