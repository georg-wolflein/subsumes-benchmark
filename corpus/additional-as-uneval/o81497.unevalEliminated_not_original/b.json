{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "RQ to notification center: confirm/finish notification",
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "CONFIRMED",
                    "FINISHED"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^state$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
