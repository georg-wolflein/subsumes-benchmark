    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "RS from notification center",
                "type": "object",
                "properties": {
                  "reportHeaders": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^reportHeaders$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              {
                "items": {
                  "anyOf": [
                    true,
                    false
                  ]
                }
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "reportId": {
                    "type": "string"
                  },
                  "notificationDate": {
                    "type": "string"
                  },
                  "actionName": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^reportId$": true,
                  "^notificationDate$": true,
                  "^actionName$": true,
                  "^address$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://integracja.firefighters.ki.agh.edu.pl",
