{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "dependentRequired": {
    "favoriteTopic": [
      "tags"
    ]
  },
  "properties": {
    "email": {
      "pattern": "^[\\w|-|.]+@[\\w]+\\.[A-Za-z]{2,4}$",
      "type": "string"
    },
    "favoriteTopic": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "email",
    "firstName",
    "lastName"
  ],
  "type": "object"
}
