{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "email": {
                  "pattern": "^[\\w|-|.]+@[\\w]+\\.[A-Za-z]{2,4}$",
                  "type": "string"
                },
                "lastName": {
                  "allOf": [
                    {
                      "type": "string"
                    },
                    {
                      "maxLength": 20
                    }
                  ]
                },
                "firstName": {
                  "type": "string"
                },
                "rating": {
                  "maximum": 5.0,
                  "type": "number"
                },
                "postedSlides": {
                  "type": "boolean"
                }
              },
              "required": [
                "email",
                "firstName",
                "lastName",
                "postedSlides",
                "rating"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^lastName$": true,
                "^firstName$": true,
                "^postedSlides$": true,
                "^rating$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
