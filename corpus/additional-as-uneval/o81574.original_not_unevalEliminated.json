{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "maxItems",
    "minItems",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o81574.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "tags": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "required": [
                  "tags"
                ]
              },
              {
                "patternProperties": {
                  "^tags$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string"
                }
              },
              {
                "items": {
                  "anyOf": [
                    true,
                    false
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "tags": {
        "type": "array",
        "minItems": 2,
        "maxItems": 4,
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "required": [
      "tags"
    ]
  }
}
