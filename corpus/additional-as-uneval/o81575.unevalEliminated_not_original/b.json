{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tags": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "tags"
              ]
            },
            {
              "patternProperties": {
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": {
                "type": "string",
                "enum": [
                  "Open Source",
                  "Java",
                  "JavaScript",
                  "JSON",
                  "REST"
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
