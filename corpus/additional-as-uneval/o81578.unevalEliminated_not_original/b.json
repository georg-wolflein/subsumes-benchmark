{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "email": {
                  "_id": "email",
                  "type": "string"
                },
                "tags": {
                  "$ref": "#/$defs/modern_2"
                },
                "firstName": {
                  "_id": "firstName",
                  "type": "string"
                },
                "about": {
                  "_id": "about",
                  "type": "string"
                },
                "company": {
                  "_id": "company",
                  "type": "string"
                },
                "lastName": {
                  "_id": "lastName",
                  "type": "string"
                }
              },
              "required": [
                "about",
                "email",
                "firstName",
                "lastName",
                "tags",
                "company"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^lastName$": true,
                "^firstName$": true,
                "^company$": true,
                "^about$": true,
                "^tags$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "_id": "tags",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
