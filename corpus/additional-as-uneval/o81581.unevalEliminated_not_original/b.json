{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "city": {
                  "type": "string"
                },
                "state": {
                  "type": "string"
                },
                "zip": {
                  "type": "string"
                },
                "country": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^line[1-3]$": {
                  "type": "string"
                }
              },
              "required": [
                "city",
                "state",
                "zip",
                "country",
                "line1"
              ]
            },
            {
              "patternProperties": {
                "^zip$": true,
                "^city$": true,
                "^line[1-3]$": true,
                "^state$": true,
                "^country$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
