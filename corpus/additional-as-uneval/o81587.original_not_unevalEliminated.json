{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o81587.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "rating": {
                    "type": "number"
                  },
                  "postedSlides": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "yes",
                          "Yes",
                          "no",
                          "No"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "email",
                  "firstName",
                  "lastName",
                  "postedSlides",
                  "rating"
                ]
              },
              {
                "patternProperties": {
                  "^lastName$": true,
                  "^firstName$": true,
                  "^postedSlides$": true,
                  "^rating$": true,
                  "^email$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "email": {
        "type": "string"
      },
      "firstName": {
        "type": "string"
      },
      "lastName": {
        "type": "string"
      },
      "postedSlides": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string",
            "enum": [
              "yes",
              "Yes",
              "no",
              "No"
            ]
          }
        ]
      },
      "rating": {
        "type": "number"
      }
    },
    "additionalProperties": false,
    "required": [
      "email",
      "firstName",
      "lastName",
      "postedSlides",
      "rating"
    ]
  }
}
