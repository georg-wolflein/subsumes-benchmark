{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "rating": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 5.0
                }
              },
              "required": [
                "rating"
              ]
            },
            {
              "patternProperties": {
                "^rating$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
