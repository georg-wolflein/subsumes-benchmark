{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "order": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "order"
              ]
            },
            {
              "patternProperties": {
                "^order$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string"
                },
                "milk": {
                  "type": "string"
                },
                "totalPrice": {
                  "type": "number"
                },
                "date": {
                  "type": "string"
                },
                "espressoConCard": {
                  "type": "string"
                },
                "time": {
                  "type": "string"
                },
                "drinkType": {
                  "type": "string"
                },
                "orderId": {
                  "type": "integer"
                },
                "customerName": {
                  "type": "string"
                }
              },
              "required": [
                "orderId",
                "customerName",
                "drinkType",
                "size",
                "date",
                "time",
                "milk",
                "espressoConCard",
                "totalPrice"
              ]
            },
            {
              "patternProperties": {
                "^orderId$": true,
                "^espressoConCard$": true,
                "^milk$": true,
                "^date$": true,
                "^customerName$": true,
                "^totalPrice$": true,
                "^time$": true,
                "^drinkType$": true,
                "^size$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
