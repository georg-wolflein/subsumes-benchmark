{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "order": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "order"
              ]
            },
            {
              "patternProperties": {
                "^order$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string",
                  "enum": [
                    "Small",
                    "Medium",
                    "Large",
                    "Extra-Large",
                    "Bucket"
                  ]
                },
                "milk": {
                  "type": "string",
                  "enum": [
                    "Non-Fat",
                    "Whole",
                    "Breve",
                    "Soy",
                    "Almond"
                  ]
                },
                "totalPrice": {
                  "type": "number"
                },
                "date": {
                  "type": "string"
                },
                "time": {
                  "type": "string"
                },
                "drinkType": {
                  "type": "string",
                  "enum": [
                    "Latte",
                    "Espresso",
                    "Cappuccino",
                    "Chai",
                    "Tea",
                    "Steamer",
                    "Hot Chocolate"
                  ]
                },
                "orderId": {
                  "type": "integer"
                },
                "customerName": {
                  "type": "string"
                },
                "flavor": {
                  "type": "string",
                  "enum": [
                    "Carmel",
                    "Chocolate",
                    "Hazelnut",
                    "Vanilla",
                    "Peppermint",
                    "White Chocolate"
                  ]
                },
                "espressoConCard": {
                  "type": "string"
                }
              },
              "required": [
                "orderId",
                "customerName",
                "drinkType",
                "size",
                "date",
                "time",
                "milk",
                "espressoConCard",
                "totalPrice"
              ]
            },
            {
              "patternProperties": {
                "^flavor$": true,
                "^orderId$": true,
                "^espressoConCard$": true,
                "^milk$": true,
                "^date$": true,
                "^customerName$": true,
                "^totalPrice$": true,
                "^time$": true,
                "^drinkType$": true,
                "^size$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
