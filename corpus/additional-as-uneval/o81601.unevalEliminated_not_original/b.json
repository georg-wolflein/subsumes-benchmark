{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "order": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "order"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^order$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "muffin": {
                  "enum": [
                    "Blueberry",
                    "Double Berry Crumb",
                    "Carrot Cake",
                    "Chocolate Chip",
                    "Double Chocolate Chip",
                    "Cherry Cheesecake",
                    "Cinnamon Cheesecake",
                    "Chocolate Cheesecake",
                    "Banana Nut"
                  ],
                  "type": "string"
                },
                "id": {
                  "type": "integer"
                },
                "date": {
                  "pattern": "^([0][1-9]|[1][0-2])-([0][0-9]|[1][0-9]|[2][0-9]|[3][0-1])-20\\d{2}$",
                  "type": "string"
                },
                "espressoConCard": {
                  "pattern": "^[A-Fa-f0-9]{8}-([A-Fa-f0-9]{4}-){3}[A-Fa-f0-9]{12}$",
                  "type": "string"
                },
                "time": {
                  "pattern": "^([0-2][0-3]|[0-1][0-9])(:[0-5][0-9]){2}$",
                  "type": "string"
                },
                "orderId": {
                  "type": "integer"
                },
                "customerName": {
                  "type": "string"
                },
                "drink": {
                  "$ref": "#/$defs/modern_3"
                },
                "totalPrice": {
                  "pattern": "^\\$[0-9]{1,3}.[0-9]{2}$",
                  "type": "string"
                }
              },
              "required": [
                "orderId",
                "id",
                "customerName",
                "date",
                "time",
                "espressoConCard",
                "totalPrice"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^drink$": true,
                "^muffin$": true,
                "^orderId$": true,
                "^espressoConCard$": true,
                "^date$": true,
                "^customerName$": true,
                "^totalPrice$": true,
                "^id$": true,
                "^time$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "drinkType": {
                  "enum": [
                    "Latte",
                    "Espresso",
                    "Cappuccino",
                    "Chai",
                    "Tea",
                    "Steamer",
                    "Hot Chocolate"
                  ],
                  "type": "string"
                },
                "flavor": {
                  "enum": [
                    "Carmel",
                    "Chocolate",
                    "Hazelnut",
                    "Vanilla",
                    "Peppermint",
                    "White Chocolate"
                  ],
                  "type": "string"
                },
                "milk": {
                  "enum": [
                    "Non-Fat",
                    "Whole",
                    "Breve",
                    "Soy",
                    "Almond"
                  ],
                  "type": "string"
                },
                "size": {
                  "enum": [
                    "Small",
                    "Medium",
                    "Large",
                    "Extra-Large",
                    "Bucket"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "drinkType",
                "size",
                "milk"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^drinkType$": true,
                "^flavor$": true,
                "^milk$": true,
                "^size$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
