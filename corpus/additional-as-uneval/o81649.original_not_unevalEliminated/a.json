{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "PR Preview Config",
              "description": "Config file for PR Preview.",
              "properties": {
                "multipage": {
                  "definition": "Whether the rendered spec is multipage.",
                  "type": "boolean"
                },
                "src_file": {
                  "definition": "Relative path to the source file from the root of the repository",
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "definition": "The spec processor used to render this spec.",
                  "enum": [
                    "bikeshed",
                    "Bikeshed",
                    "BikeShed",
                    "respec",
                    "Respec",
                    "ReSpec",
                    "wattsi",
                    "Wattsi",
                    "html",
                    "HTML"
                  ]
                },
                "post_processing": {
                  "definition": "Set a post processor.",
                  "type": "object",
                  "properties": {
                    "name": {
                      "definition": "Name of the post-processor",
                      "enum": [
                        "emu-algify",
                        "webidl-grammar"
                      ]
                    },
                    "options": {
                      "$ref": "#/$defs/modern_2"
                    }
                  },
                  "required": [
                    "name"
                  ]
                },
                "params": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "src_file",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^src_file$": true,
                "^params$": true,
                "^type$": true,
                "^multipage$": true,
                "^post_processing$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "definition": "Options object for the post-processor",
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "definition": "parameters for the spec processor",
              "type": "object"
            },
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
