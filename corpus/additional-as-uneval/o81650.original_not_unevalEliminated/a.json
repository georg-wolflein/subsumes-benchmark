{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Specref",
              "description": "A list of spec references.",
              "patternProperties": {
                "^[a-zA-Z0-9\\-_+\\.]+$": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/alias"
                    },
                    {
                      "$ref": "#/$defs/legacyRef"
                    },
                    {
                      "$ref": "#/$defs/ref"
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z0-9\\-_+\\.]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "url": {
      "definition": "An URL string.",
      "type": "string",
      "format": "uri"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "aliases": {
                  "description": "This is for in internal use only and shouldn't be manually set.",
                  "$ref": "#/$defs/idList"
                },
                "isRetired": {
                  "description": "",
                  "type": "boolean"
                },
                "isSuperseded": {
                  "description": "",
                  "type": "boolean"
                },
                "hasErrata": {
                  "description": "",
                  "$ref": "#/$defs/url"
                },
                "edDraft": {
                  "description": "URL of the editor's draft",
                  "$ref": "#/$defs/url"
                },
                "deliveredBy": {
                  "description": "An array of URLs pointing to the home page of the Working Groups working on the spec.",
                  "$ref": "#/$defs/urlList"
                },
                "obsoletedBy": {
                  "description": "Array of identifiers of specs which have replaced this one",
                  "$ref": "#/$defs/idList"
                },
                "title": {
                  "description": "Title of the spec",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "rawDate": {
                  "description": "A prefered, machine readable format (YYYY-MM-DD) to specify the date. Note month and day are optional.",
                  "type": "string",
                  "pattern": "^\\d{4}(?:-[01]\\d)?(?:-[0-3]\\d)?$"
                },
                "source": {
                  "description": "",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "repository": {
                  "description": "URL of the repository",
                  "$ref": "#/$defs/url"
                },
                "versions": {
                  "$ref": "#/$defs/modern_2"
                },
                "obsoletes": {
                  "description": "",
                  "$ref": "#/$defs/idList"
                },
                "etAl": {
                  "description": "Indicates extra, unlisted spec authors",
                  "type": "boolean"
                },
                "pages": {
                  "description": "Page number(s) where the reference is inside the titled document",
                  "type": "string",
                  "pattern": "^[0-9\\-,]+$"
                },
                "versionOf": {
                  "description": "",
                  "$ref": "#/$defs/id"
                },
                "updates": {
                  "description": "",
                  "$ref": "#/$defs/idList"
                },
                "authors": {
                  "description": "Authors of the specification",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/nonEmptyString"
                  },
                  "minItems": 1
                },
                "date": {
                  "description": "Date of publication in humand readable form, favor rawDate instead.",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "isoNumber": {
                  "description": "Number of ISO standard",
                  "type": "string",
                  "pattern": "^ISO(\\/IEC)?(\\/((TS)|(DIS)|(FDIS)))? \\d{3,}(\\-\\d+)?(\\:\\d{4})?$"
                },
                "status": {
                  "description": "What state a spec is in. Is it a work in progress, completed, etc.",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "rfcNumber": {
                  "description": "Number of IETF RFC",
                  "type": "string",
                  "pattern": "^RFC\\d{4}$"
                },
                "publisher": {
                  "description": "Name of the publisher if any.",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "isbn": {
                  "description": "International Standard Book Number",
                  "type": "string",
                  "pattern": "^[0-9\\-]+X?$"
                },
                "href": {
                  "description": "URL of the spec",
                  "$ref": "#/$defs/url"
                },
                "updatedBy": {
                  "description": "",
                  "$ref": "#/$defs/idList"
                },
                "ogcNumber": {
                  "description": "Number of OGC standard",
                  "type": "string",
                  "pattern": "^OGC \\d{2}\\-\\d+(r\\d+)?$"
                },
                "seeAlso": {
                  "description": "",
                  "$ref": "#/$defs/idList"
                }
              },
              "required": [
                "title"
              ]
            },
            {
              "patternProperties": {
                "^authors$": true,
                "^isSuperseded$": true,
                "^updates$": true,
                "^ogcNumber$": true,
                "^aliases$": true,
                "^pages$": true,
                "^repository$": true,
                "^etAl$": true,
                "^title$": true,
                "^isRetired$": true,
                "^source$": true,
                "^versions$": true,
                "^publisher$": true,
                "^hasErrata$": true,
                "^seeAlso$": true,
                "^obsoletes$": true,
                "^isbn$": true,
                "^rfcNumber$": true,
                "^isoNumber$": true,
                "^rawDate$": true,
                "^date$": true,
                "^status$": true,
                "^updatedBy$": true,
                "^versionOf$": true,
                "^obsoletedBy$": true,
                "^href$": true,
                "^deliveredBy$": true,
                "^edDraft$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "nonEmptyString": {
      "definition": "A non-empty string.",
      "type": "string",
      "minLength": 1
    },
    "urlList": {
      "definition": "An array of unique URLs.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/url"
      },
      "minItems": 1,
      "_uniqueItems": true
    },
    "ref": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "An object listing specific versions of that spec.",
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9\\-_+\\.]+$": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/version"
                    },
                    {
                      "$ref": "#/$defs/alias"
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z0-9\\-_+\\.]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "legacyRef": {
      "description": "Legacy, unstructured data. Please don't do this. Please help get it fixed: https://github.com/tobie/specref/issues/147",
      "type": "string"
    },
    "id": {
      "definition": "A reference ID (corresponds to RFCs or W3C shortnames).",
      "type": "string",
      "pattern": "^[a-zA-Z0-9\\-_+\\.]+$"
    },
    "authors": {
      "description": "Authors of the specification",
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "minItems": 1
    },
    "idList": {
      "definition": "An array of unique reference IDs.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      },
      "minItems": 1,
      "_uniqueItems": true
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "aliasOf": {
                  "description": "ID of the aliased reference. Note aliasing can be recursive.",
                  "$ref": "#/$defs/id"
                }
              },
              "required": [
                "aliasOf"
              ]
            },
            {
              "patternProperties": {
                "^aliasOf$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "aliases": {
                  "description": "",
                  "$ref": "#/$defs/idList"
                },
                "source": {
                  "description": "",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "isRetired": {
                  "description": "The spec has been retired.",
                  "type": "boolean"
                },
                "isSuperseded": {
                  "description": "",
                  "type": "boolean"
                },
                "etAl": {
                  "description": "Indicates extra, unlisted spec authors",
                  "type": "boolean"
                },
                "hasErrata": {
                  "description": "",
                  "$ref": "#/$defs/url"
                },
                "deliveredBy": {
                  "description": "An array of URLs pointing to the home page of the Working Groups working on the spec.",
                  "$ref": "#/$defs/urlList"
                },
                "title": {
                  "description": "Title of the spec",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "href": {
                  "description": "URL of the spec",
                  "$ref": "#/$defs/url"
                },
                "rawDate": {
                  "description": "A prefered, machine readable format (YYYY-MM-DD) to specify the date. Note month and day are optional.",
                  "type": "string",
                  "pattern": "^\\d{4}(?:-[01]\\d)?(?:-[0-3]\\d)?$"
                },
                "versionOf": {
                  "description": "",
                  "$ref": "#/$defs/id"
                },
                "authors": {
                  "$ref": "#/$defs/authors"
                },
                "status": {
                  "description": "What state the spec is in. Is it a in progress, completed, etc.",
                  "$ref": "#/$defs/nonEmptyString"
                },
                "publisher": {
                  "description": "Name of the publisher, if any.",
                  "$ref": "#/$defs/nonEmptyString"
                }
              },
              "required": [
                "href"
              ]
            },
            {
              "patternProperties": {
                "^authors$": true,
                "^isSuperseded$": true,
                "^rawDate$": true,
                "^aliases$": true,
                "^status$": true,
                "^versionOf$": true,
                "^etAl$": true,
                "^title$": true,
                "^isRetired$": true,
                "^href$": true,
                "^source$": true,
                "^deliveredBy$": true,
                "^publisher$": true,
                "^hasErrata$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "alias": {
      "$ref": "#/$defs/modern_3"
    },
    "version": {
      "$ref": "#/$defs/modern_4"
    }
  }
}
