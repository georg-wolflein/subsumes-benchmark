{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "variable": {
                  "$ref": "#/$defs/modern_2"
                }
              },
              "required": [
                "variable"
              ]
            },
            {
              "patternProperties": {
                "^variable$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "datatype": {
                  "type": "object",
                  "properties": {
                    "basetype": {
                      "type": "string"
                    },
                    "conversion": {
                      "type": [
                        "null",
                        "string"
                      ]
                    }
                  }
                },
                "min": {
                  "type": [
                    "null",
                    "integer"
                  ]
                }
              },
              "required": [
                "datatype"
              ]
            },
            {
              "patternProperties": {
                "^datatype$": true,
                "^min$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
