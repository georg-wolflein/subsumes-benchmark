{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_20",
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                ".*": {
                  "$ref": "#/$defs/template"
                }
              }
            },
            {
              "patternProperties": {
                "^.*$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "notification": {
      "$ref": "#/$defs/modern_3"
    },
    "host": {
      "$ref": "#/$defs/modern_4"
    },
    "deployment-check": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                ".*": {
                  "oneOf": [
                    {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/encrypted-type"
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                ".*": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_20": {
      "anyOf": [
        {
          "allOf": [
            {
              "links": [],
              "properties": {
                "deployment": {
                  "$ref": "#/$defs/deployment"
                },
                "templates": {
                  "$ref": "#/$defs/templates"
                },
                "proxy": {
                  "$ref": "#/$defs/proxy"
                },
                "notifications": {
                  "$ref": "#/$defs/notifications"
                },
                "meta-info": {
                  "$ref": "#/$defs/meta-info"
                },
                "state": {
                  "enum": [
                    "NEW",
                    "STARTED",
                    "PROMOTED",
                    "DECOMMISSIONED",
                    "FAILED"
                  ]
                },
                "security": {
                  "$ref": "#/$defs/security"
                },
                "environment": {
                  "$ref": "#/$defs/environment",
                  "description": "Defines top level environment (key, value) support"
                },
                "schedule": {
                  "description": "Run this deployment as scheduled job. See: https://www.freedesktop.org/software/systemd/man/systemd.time.html#Calendar%20Events",
                  "type": "string"
                }
              },
              "required": [
                "meta-info"
              ],
              "title": "Schema for deployment",
              "type": "object"
            },
            {
              "patternProperties": {
                "^state$": true,
                "^security$": true,
                "^meta-info$": true,
                "^environment$": true,
                "^notifications$": true,
                "^proxy$": true,
                "^schedule$": true,
                "^templates$": true,
                "^deployment$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Proxy location definition for a given proxy path",
              "properties": {
                "path": {
                  "description": "Path to be used for proxy",
                  "type": "string"
                },
                "enabled": {
                  "description": "Is location enabled?",
                  "type": "boolean"
                },
                "force-ssl": {
                  "default": false,
                  "description": "If SSL needs to be forced at the given path",
                  "type": "boolean"
                },
                "allowed-acls": {
                  "description": "List of Allowed proxy ACLs",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "port": {
                  "description": "Internal container port for proxy.",
                  "minimum": 1.0,
                  "type": "number"
                },
                "denied-acls": {
                  "description": "List of Denied proxy ACLs",
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^port$": true,
                "^denied-acls$": true,
                "^force-ssl$": true,
                "^path$": true,
                "^allowed-acls$": true,
                "^enabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "args": {
                  "$ref": "#/$defs/template-args"
                }
              }
            },
            {
              "patternProperties": {
                "^args$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "templates": {
      "$ref": "#/$defs/modern_6"
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "maxLength": 512,
                  "type": "string"
                },
                "stop": {
                  "$ref": "#/$defs/deployment-stop",
                  "type": "object"
                },
                "version": {
                  "maxLength": 100,
                  "type": "string"
                },
                "check": {
                  "$ref": "#/$defs/deployment-check"
                },
                "nodes": {
                  "maximum": 12.0,
                  "minimum": 1.0,
                  "type": "number"
                },
                "mode": {
                  "enum": [
                    "blue-green",
                    "red-green",
                    "a/b",
                    "custom"
                  ]
                },
                "type": {
                  "enum": [
                    "blue-green",
                    "red-green",
                    "a/b",
                    "custom"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^check$": true,
                "^type$": true,
                "^mode$": true,
                "^stop$": true,
                "^name$": true,
                "^nodes$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "template-args": {
      "$ref": "#/$defs/modern_9"
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "attempts": {
                  "default": "10",
                  "description": "Maximum number of attempts for deployment check before marking deployment as failed.",
                  "type": "number"
                },
                "path": {
                  "default": "",
                  "description": "Optional path to be used for performing deployment check. If null, empty or un-specified, only discover check is performed.",
                  "type": "string"
                },
                "timeout": {
                  "default": "5s",
                  "description": "Deployment check timeout represented in terms of seconds or minutes. e.g: 20s for timeout of 20 seconds",
                  "type": "string"
                },
                "port": {
                  "description": "Application internal Port to be used for discover check (Use 0 to disable discover check)",
                  "minimum": 0.0,
                  "type": "number"
                },
                "min-nodes": {
                  "description": "Minimum number of nodes for deployment. (Used for deployment check)",
                  "minimum": 1.0,
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^min-nodes$": true,
                "^port$": true,
                "^attempts$": true,
                "^timeout$": true,
                "^path$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "health": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "deployer": {
                  "type": "object"
                },
                "git": {
                  "$ref": "#/$defs/git"
                },
                "job-id": {
                  "maxLength": 100,
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^deployer$": true,
                "^git$": true,
                "^job-id$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "deployment": {
      "$ref": "#/$defs/modern_11"
    },
    "location": {
      "$ref": "#/$defs/modern_12"
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "enabled": {
                  "description": "Used for enabling/disabling notification",
                  "type": "boolean"
                },
                "level": {
                  "description": "Min level for the message to activate this notifier",
                  "type": "number"
                },
                "token": {
                  "description": "Github Oauth token",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/encrypted-type"
                    }
                  ]
                },
                "url": {
                  "description": "Github API url base",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^enabled$": true,
                "^level$": true,
                "^token$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "check-retries": {
                  "default": "10",
                  "description": "Maximum no. of retries to be attempted to check if deployment is stopped.",
                  "type": "number"
                },
                "timeout": {
                  "default": "120s",
                  "description": "Deployment stop timeout represented in terms of seconds or minutes. e.g: 30s for timeout of 30 seconds. The application will be sent SIGTERM signal and will have this time for its cleanup.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^check-retries$": true,
                "^timeout$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "listener": {
      "description": "Proxy TCP Listener definition",
      "type": "object"
    },
    "security": {
      "$ref": "#/$defs/modern_13"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Health check definition for proxy upstream",
              "properties": {
                "interval": {
                  "default": "45s",
                  "description": "Interval to be used for health check. e.g.: 30s to run health check every 30 seconds.",
                  "type": "string"
                },
                "timeout": {
                  "default": "5s",
                  "description": "Health check timeout represented in terms of seconds or minutes. e.g: 20s for timeout of 20 seconds",
                  "type": "string"
                },
                "uri": {
                  "default": "",
                  "description": "Path to be used for health check. If empty or not specified, tcp based check is used.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^interval$": true,
                "^timeout$": true,
                "^uri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "notification-hipchat": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "hosts": {
                  "description": "Hosts associated with the proxy",
                  "patternProperties": {
                    ".*": {
                      "$ref": "#/$defs/host"
                    }
                  },
                  "type": "object"
                },
                "listeners": {
                  "description": "TCP Listeners associated with proxy (for tcp based proxy)",
                  "patternProperties": {
                    ".*": {
                      "$ref": "#/$defs/listener"
                    }
                  }
                },
                "upstreams": {
                  "description": "Backends associated with the proxy",
                  "patternProperties": {
                    ".*": {
                      "$ref": "#/$defs/upstream"
                    }
                  }
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^hosts$": true,
                "^listeners$": true,
                "^upstreams$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "url": {
                  "description": "Hipchat v2 api url",
                  "type": "string"
                },
                "enabled": {
                  "description": "Used for enabling/disabling notification",
                  "type": "boolean"
                },
                "colors": {
                  "description": "Color mapping",
                  "type": "object"
                },
                "token": {
                  "description": "Hipchat API v2 token (personal/ room) for notification",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/encrypted-type"
                    }
                  ]
                },
                "room": {
                  "description": "Room to be used for notification",
                  "type": "string"
                },
                "level": {
                  "description": "Min level for the message to activate this notifier",
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^token$": true,
                "^level$": true,
                "^url$": true,
                "^colors$": true,
                "^enabled$": true,
                "^room$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "git": {
      "$ref": "#/$defs/modern_14"
    },
    "deployment-stop": {
      "$ref": "#/$defs/modern_15"
    },
    "notification-github": {
      "$ref": "#/$defs/modern_16"
    },
    "proxy": {
      "$ref": "#/$defs/modern_17"
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "command": {
                  "oneOf": [
                    {
                      "maxLength": 4096,
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/encrypted-type"
                    }
                  ]
                },
                "docker-args": {
                  "oneOf": [
                    {
                      "maxLength": 1024,
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/encrypted-type"
                    }
                  ]
                },
                "environment": {
                  "$ref": "#/$defs/environment"
                },
                "image": {
                  "maxLength": 1024,
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^command$": true,
                "^docker-args$": true,
                "^environment$": true,
                "^image$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "environment": {
      "$ref": "#/$defs/modern_7"
    },
    "modern_18": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "encrypted": {
                  "type": "boolean"
                },
                "value": {
                  "maxLength": 8192,
                  "type": "string"
                }
              },
              "required": [
                "value"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^encrypted$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "profile": {
                  "default": "default",
                  "maxLength": 100,
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^profile$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "enabled": {
                  "description": "Used for enabling/disabling notification",
                  "type": "boolean"
                },
                "level": {
                  "description": "Min level for the message to activate this notifier",
                  "type": "number"
                }
              }
            },
            {
              "patternProperties": {
                "^enabled$": true,
                "^level$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "template": {
      "$ref": "#/$defs/modern_8"
    },
    "encrypted-type": {
      "$ref": "#/$defs/modern_18"
    },
    "upstream": {
      "$ref": "#/$defs/modern_19"
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "commit": {
                  "maxLength": 100,
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "owner": {
                  "maxLength": 100,
                  "type": "string"
                },
                "ref": {
                  "maxLength": 100,
                  "type": "string"
                },
                "repo": {
                  "maxLength": 100,
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^commit$": true,
                "^owner$": true,
                "^ref$": true,
                "^repo$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "notifications": {
      "patternProperties": {
        ".*": {
          "$ref": "#/$defs/notification"
        },
        "github": {
          "$ref": "#/$defs/notification-github"
        },
        "hipchat": {
          "$ref": "#/$defs/notification-hipchat"
        }
      }
    },
    "modern_19": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Proxy Upstream (Backend) definition",
              "properties": {
                "health": {
                  "$ref": "#/$defs/health"
                },
                "mode": {
                  "default": "http",
                  "description": "Proxy mode (http or tcp)",
                  "enum": [
                    "http",
                    "tcp"
                  ]
                },
                "ttl": {
                  "default": "1w",
                  "description": "Time to live for this upstream during which no registration is received for node discovery.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^health$": true,
                "^mode$": true,
                "^ttl$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "meta-info": {
      "$ref": "#/$defs/modern_10"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Proxy Host definition",
              "properties": {
                "enabled": {
                  "description": "Is host enabled?",
                  "type": "boolean"
                },
                "hostname": {
                  "description": "Hostname(s) to be registered with proxy. If multiple hosts need to be specified, separate them using comma or space",
                  "pattern": "^[a-zA-Z0-9\\-.\\s,]*[a-zA-Z0-9\\s\\-,]$",
                  "type": "string"
                },
                "locations": {
                  "description": "Locations for given proxy host.",
                  "patternProperties": {
                    ".*": {
                      "$ref": "#/$defs/location"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^enabled$": true,
                "^hostname$": true,
                "^locations$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
