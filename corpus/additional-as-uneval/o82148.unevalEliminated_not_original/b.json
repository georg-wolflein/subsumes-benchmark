{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "commit": {
                  "maxLength": 100,
                  "title": "Git SHA Commit ID",
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "owner": {
                  "maxLength": 100,
                  "title": "Owner/Organization of the SCM repository (e.g. totem)",
                  "type": "string"
                },
                "ref": {
                  "maxLength": 100,
                  "title": "Branch or tag name",
                  "type": "string"
                },
                "repo": {
                  "maxLength": 100,
                  "title": "SCM repository name (e.g.: spec-python)",
                  "type": "string"
                }
              },
              "required": [
                "owner",
                "repo",
                "ref"
              ]
            },
            {
              "patternProperties": {
                "^commit$": true,
                "^owner$": true,
                "^ref$": true,
                "^repo$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "description": "Name of the hook (e.g. image-factory)",
                  "maxLength": 100,
                  "type": "string"
                },
                "result": {
                  "description": "Result object",
                  "type": "object"
                },
                "force-deploy": {
                  "description": "Force deploy the image on receiving this hook (ignore status)",
                  "type": "boolean"
                },
                "git": {
                  "$ref": "#/$defs/git"
                },
                "status": {
                  "description": "Status for the hook (failed, success)",
                  "enum": [
                    "success",
                    "failed"
                  ]
                },
                "type": {
                  "description": "Type of the hook (e.g. builder, ci)",
                  "enum": [
                    "builder",
                    "ci",
                    "scm-create",
                    "scm-push"
                  ]
                }
              },
              "required": [
                "name",
                "type",
                "git"
              ],
              "title": "Schema for Generic Hook payload",
              "type": "object"
            },
            {
              "patternProperties": {
                "^result$": true,
                "^name$": true,
                "^type$": true,
                "^git$": true,
                "^force-deploy$": true,
                "^status$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "git": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
