{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82156.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ref": {
        "description": "Github branch/tag",
        "type": "string",
        "maxLength": 255
      },
      "after": {
        "type": "string",
        "title": "Github push (after commit)",
        "maxLength": 250
      },
      "deleted": {
        "type": "boolean"
      },
      "repository": {
        "$ref": "#/$defs/repository"
      }
    },
    "additionalProperties": true,
    "required": [
      "repository"
    ],
    "$defs": {
      "repository": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Name of the repository",
            "maxLength": 100
          },
          "owner": {
            "$ref": "#/$defs/owner"
          }
        },
        "additionalProperties": true,
        "required": [
          "name",
          "owner"
        ]
      },
      "owner": {
        "type": "object",
        "anyOf": [
          {
            "properties": {
              "name": {
                "description": "Name of the repository owner",
                "maxLength": 100
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": true
          },
          {
            "properties": {
              "login": {
                "description": "Name of the repository owner",
                "maxLength": 100
              }
            },
            "required": [
              "login"
            ],
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_4",
    "$defs": {
      "repository": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "description": "Name of the repository",
                    "maxLength": 100
                  },
                  "owner": {
                    "$ref": "#/$defs/owner"
                  }
                },
                "required": [
                  "name",
                  "owner"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^owner$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "name": {
                    "description": "Name of the repository owner",
                    "maxLength": 100
                  }
                },
                "required": [
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "login": {
                    "description": "Name of the repository owner",
                    "maxLength": 100
                  }
                },
                "required": [
                  "login"
                ]
              },
              {
                "patternProperties": {
                  "^login$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "owner": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/$defs/modern_2"
          },
          {
            "$ref": "#/$defs/modern_3"
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "ref": {
                    "description": "Github branch/tag",
                    "type": "string",
                    "maxLength": 255
                  },
                  "after": {
                    "type": "string",
                    "title": "Github push (after commit)",
                    "maxLength": 250
                  },
                  "deleted": {
                    "type": "boolean"
                  },
                  "repository": {
                    "$ref": "#/$defs/repository"
                  }
                },
                "required": [
                  "repository"
                ]
              },
              {
                "patternProperties": {
                  "^ref$": true,
                  "^after$": true,
                  "^deleted$": true,
                  "^repository$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  }
}
