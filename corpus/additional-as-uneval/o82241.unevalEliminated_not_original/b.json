{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "venue",
              "description": "Jackson data binding is done on this project for now, this avoids requiring it in the core doxdb",
              "properties": {
                "name": {
                  "type": "string"
                },
                "language": {
                  "type": "string"
                },
                "feiId": {
                  "type": "string"
                },
                "rings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "ringNO": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^language$": true,
                "^feiId$": true,
                "^rings$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
