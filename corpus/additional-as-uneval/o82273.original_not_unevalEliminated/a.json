{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "choice-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^CHOICE$"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      },
      "required": [
        "type",
        "members"
      ]
    },
    "prec-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^(PREC|PREC_LEFT|PREC_RIGHT|PREC_DYNAMIC)$"
        },
        "value": {
          "type": "integer"
        },
        "content": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "type",
        "content",
        "value"
      ]
    },
    "string-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^STRING$"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]\\w*$": {
                  "$ref": "#/$defs/rule"
                }
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_]\\w*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "alias-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^ALIAS$"
        },
        "value": {
          "type": "string"
        },
        "named": {
          "type": "boolean"
        },
        "content": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "type",
        "named",
        "content",
        "value"
      ]
    },
    "repeat-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^REPEAT$"
        },
        "content": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "type",
        "content"
      ]
    },
    "blank-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^BLANK$"
        }
      },
      "required": [
        "type"
      ]
    },
    "symbol-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^SYMBOL$"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "repeat1-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^REPEAT1$"
        },
        "content": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "type",
        "content"
      ]
    },
    "field-rule": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "pattern": "^FIELD$"
        },
        "content": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "name",
        "type",
        "content"
      ]
    },
    "pattern-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^PATTERN$"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "tree-sitter grammar specification",
              "type": "object",
              "required": [
                "name",
                "rules"
              ],
              "properties": {
                "name": {
                  "description": "the name of the grammar",
                  "type": "string",
                  "pattern": "^[a-zA-Z_]\\w*"
                },
                "inline": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-zA-Z_]\\w*$"
                  }
                },
                "extras": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/rule"
                  }
                },
                "rules": {
                  "$ref": "#/$defs/modern_2"
                },
                "word": {
                  "type": "string",
                  "pattern": "^[a-zA-Z_]\\w*"
                },
                "externals": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/rule"
                  }
                },
                "conflicts": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-zA-Z_]\\w*$"
                    }
                  }
                },
                "supertypes": {
                  "description": "A list of hidden rule names that should be considered supertypes in the generated node types file. See http://tree-sitter.github.io/tree-sitter/using-parsers#static-node-types.",
                  "type": "array",
                  "items": {
                    "description": "the name of a rule in `rules` or `extras`",
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^externals$": true,
                "^rules$": true,
                "^conflicts$": true,
                "^supertypes$": true,
                "^name$": true,
                "^word$": true,
                "^extras$": true,
                "^inline$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "token-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^(TOKEN|IMMEDIATE_TOKEN)$"
        },
        "content": {
          "$ref": "#/$defs/rule"
        }
      },
      "required": [
        "type",
        "content"
      ]
    },
    "seq-rule": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "pattern": "^SEQ$"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      },
      "required": [
        "type",
        "members"
      ]
    },
    "rule": {
      "oneOf": [
        {
          "$ref": "#/$defs/alias-rule"
        },
        {
          "$ref": "#/$defs/blank-rule"
        },
        {
          "$ref": "#/$defs/string-rule"
        },
        {
          "$ref": "#/$defs/pattern-rule"
        },
        {
          "$ref": "#/$defs/symbol-rule"
        },
        {
          "$ref": "#/$defs/seq-rule"
        },
        {
          "$ref": "#/$defs/choice-rule"
        },
        {
          "$ref": "#/$defs/repeat1-rule"
        },
        {
          "$ref": "#/$defs/repeat-rule"
        },
        {
          "$ref": "#/$defs/token-rule"
        },
        {
          "$ref": "#/$defs/field-rule"
        },
        {
          "$ref": "#/$defs/prec-rule"
        }
      ]
    }
  }
}
