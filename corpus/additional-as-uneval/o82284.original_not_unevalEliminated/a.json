{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "version": {
                  "pattern": "^[0-9]\\.[0-9]\\.[0-9](-[0-9A-Za-z]+)?$",
                  "type": "string"
                }
              },
              "required": [
                "version"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
