{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "write_key": {
                  "type": "string",
                  "pattern": "^\\w+$",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                },
                "_schema": {
                  "type": "string",
                  "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                  "default": "pbj:gdbots:analytics:tracker:keen:1-0-0"
                },
                "project_id": {
                  "type": "string",
                  "pattern": "^\\w+$",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                },
                "is_enabled": {
                  "type": "boolean",
                  "pbj": {
                    "type": "boolean",
                    "rule": "single"
                  }
                },
                "read_key": {
                  "type": "string",
                  "pattern": "^\\w+$",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                }
              },
              "required": [
                "_schema"
              ]
            },
            {
              "patternProperties": {
                "^read_key$": true,
                "^write_key$": true,
                "^is_enabled$": true,
                "^_schema$": true,
                "^project_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
