{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "os_family": {
                  "type": "string",
                  "pattern": ".+",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                },
                "os_major": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 65535.0,
                  "pbj": {
                    "type": "small-int",
                    "rule": "single"
                  }
                },
                "os_patch_minor": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 65535.0,
                  "pbj": {
                    "type": "small-int",
                    "rule": "single"
                  }
                },
                "_schema": {
                  "type": "string",
                  "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                  "default": "pbj:gdbots:contexts::user-agent:1-0-0"
                },
                "br_family": {
                  "type": "string",
                  "pattern": ".+",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                },
                "os_minor": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 65535.0,
                  "pbj": {
                    "type": "small-int",
                    "rule": "single"
                  }
                },
                "br_patch": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 65535.0,
                  "pbj": {
                    "type": "small-int",
                    "rule": "single"
                  }
                },
                "os_patch": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 65535.0,
                  "pbj": {
                    "type": "small-int",
                    "rule": "single"
                  }
                },
                "br_minor": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 65535.0,
                  "pbj": {
                    "type": "small-int",
                    "rule": "single"
                  }
                },
                "br_major": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 65535.0,
                  "pbj": {
                    "type": "small-int",
                    "rule": "single"
                  }
                },
                "dvce_family": {
                  "type": "string",
                  "pattern": ".+",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                }
              },
              "required": [
                "_schema"
              ]
            },
            {
              "patternProperties": {
                "^os_patch$": true,
                "^dvce_family$": true,
                "^br_patch$": true,
                "^br_family$": true,
                "^os_patch_minor$": true,
                "^br_major$": true,
                "^os_minor$": true,
                "^os_family$": true,
                "^os_major$": true,
                "^_schema$": true,
                "^br_minor$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
