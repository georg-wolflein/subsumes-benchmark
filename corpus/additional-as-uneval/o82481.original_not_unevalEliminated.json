{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82481.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "from_ref": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$",
                    "pbj": {
                      "type": "identifier",
                      "rule": "single"
                    }
                  },
                  "to_ref": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$",
                    "pbj": {
                      "type": "identifier",
                      "rule": "single"
                    }
                  },
                  "multiplicity": {
                    "type": "string",
                    "default": "multi",
                    "enum": [
                      "unknown",
                      "multi",
                      "simple",
                      "many2one",
                      "one2many",
                      "one2one"
                    ],
                    "pbj": {
                      "type": "string-enum",
                      "rule": "single",
                      "overridable": true
                    }
                  },
                  "created_at": {
                    "type": "string",
                    "pattern": "^[1-9]{1}[0-9]{12,15}$",
                    "pbj": {
                      "type": "microtime",
                      "rule": "single"
                    }
                  }
                },
                "required": [
                  "from_ref",
                  "to_ref"
                ]
              },
              {
                "patternProperties": {
                  "^from_ref$": true,
                  "^to_ref$": true,
                  "^multiplicity$": true,
                  "^created_at$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://schemas.triniti.io/json-schema/gdbots/ncr/mixin/edge/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "from_ref": {
        "type": "string",
        "pattern": "^[\\w\\/\\.:-]+$",
        "pbj": {
          "type": "identifier",
          "rule": "single"
        }
      },
      "to_ref": {
        "type": "string",
        "pattern": "^[\\w\\/\\.:-]+$",
        "pbj": {
          "type": "identifier",
          "rule": "single"
        }
      },
      "multiplicity": {
        "type": "string",
        "default": "multi",
        "enum": [
          "unknown",
          "multi",
          "simple",
          "many2one",
          "one2many",
          "one2one"
        ],
        "pbj": {
          "type": "string-enum",
          "rule": "single",
          "overridable": true
        }
      },
      "created_at": {
        "type": "string",
        "pattern": "^[1-9]{1}[0-9]{12,15}$",
        "pbj": {
          "type": "microtime",
          "rule": "single"
        }
      }
    },
    "required": [
      "from_ref",
      "to_ref"
    ],
    "additionalProperties": true
  }
}
