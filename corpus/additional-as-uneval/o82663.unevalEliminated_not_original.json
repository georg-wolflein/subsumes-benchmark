{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "maxLength",
    "maximum",
    "minLength",
    "minimum",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82663.unevalEliminated_not_original.json",
  "a": {
    "$id": "http://schemas.triniti.io/json-schema/triniti/canvas/mixin/heading-block/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "etag": {
        "type": "string",
        "pattern": "^[\\w\\.:-]+$",
        "pbj": {
          "type": "string",
          "rule": "single"
        }
      },
      "css_class": {
        "type": "string",
        "pattern": "^[\\w\\s-]+$",
        "description": "In rendering environments that support HTML the css_class can be appended to the dom elements' class attribute.",
        "pbj": {
          "type": "string",
          "rule": "single"
        }
      },
      "updated_date": {
        "type": "string",
        "format": "date-time",
        "description": "Represents an update that occurred on the node this block is attached to. DOES NOT indicate an update to the block itself. eg an article with a twitter block with updated_date means that the article was updated to include that twitter block.",
        "pbj": {
          "type": "date-time",
          "rule": "single"
        }
      },
      "aside": {
        "type": "boolean",
        "description": "When true it means this block represents a portion of a document whose content is only indirectly related to the document's main content. Asides are frequently presented as sidebars or call-out boxes.",
        "pbj": {
          "type": "boolean",
          "rule": "single"
        }
      },
      "text": {
        "type": "string",
        "minLength": 0,
        "maxLength": 2000,
        "pbj": {
          "type": "text",
          "rule": "single"
        }
      },
      "size": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 6,
        "pbj": {
          "type": "tiny-int",
          "rule": "single"
        }
      },
      "url": {
        "type": "string",
        "pattern": "^(https?:\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-]*)*\\/?$",
        "pbj": {
          "type": "text",
          "rule": "single",
          "format": "url"
        }
      }
    },
    "additionalProperties": true
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "etag": {
                    "type": "string",
                    "pattern": "^[\\w\\.:-]+$",
                    "pbj": {
                      "type": "string",
                      "rule": "single"
                    }
                  },
                  "size": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0.0,
                    "maximum": 6.0,
                    "pbj": {
                      "type": "tiny-int",
                      "rule": "single"
                    }
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^(https?:\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-]*)*\\/?$",
                    "pbj": {
                      "type": "text",
                      "rule": "single",
                      "format": "url"
                    }
                  },
                  "text": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 2000,
                    "pbj": {
                      "type": "text",
                      "rule": "single"
                    }
                  },
                  "updated_date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Represents an update that occurred on the node this block is attached to. DOES NOT indicate an update to the block itself. eg an article with a twitter block with updated_date means that the article was updated to include that twitter block.",
                    "pbj": {
                      "type": "date-time",
                      "rule": "single"
                    }
                  },
                  "css_class": {
                    "type": "string",
                    "pattern": "^[\\w\\s-]+$",
                    "description": "In rendering environments that support HTML the css_class can be appended to the dom elements' class attribute.",
                    "pbj": {
                      "type": "string",
                      "rule": "single"
                    }
                  },
                  "aside": {
                    "type": "boolean",
                    "description": "When true it means this block represents a portion of a document whose content is only indirectly related to the document's main content. Asides are frequently presented as sidebars or call-out boxes.",
                    "pbj": {
                      "type": "boolean",
                      "rule": "single"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^updated_date$": true,
                  "^text$": true,
                  "^css_class$": true,
                  "^etag$": true,
                  "^url$": true,
                  "^aside$": true,
                  "^size$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  }
}
