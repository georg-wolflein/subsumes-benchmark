{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "etag": {
                  "pattern": "^[\\w\\.:-]+$",
                  "pbj": {
                    "rule": "single",
                    "type": "string"
                  },
                  "type": "string"
                },
                "loop": {
                  "pbj": {
                    "rule": "single",
                    "type": "boolean"
                  },
                  "type": "boolean"
                },
                "show_portrait": {
                  "description": "Whether or not to show the portrait (profile image) in the thumbnail.",
                  "pbj": {
                    "rule": "single",
                    "type": "boolean"
                  },
                  "type": "boolean"
                },
                "description": {
                  "maxLength": 5000,
                  "minLength": 0,
                  "pbj": {
                    "rule": "single",
                    "type": "text"
                  },
                  "type": "string"
                },
                "autoplay": {
                  "pbj": {
                    "rule": "single",
                    "type": "boolean"
                  },
                  "type": "boolean"
                },
                "updated_date": {
                  "_format": "date-time",
                  "description": "Represents an update that occurred on the node this block is attached to. DOES NOT indicate an update to the block itself. eg an article with a twitter block with updated_date means that the article was updated to include that twitter block.",
                  "pbj": {
                    "rule": "single",
                    "type": "date-time"
                  },
                  "type": "string"
                },
                "aside": {
                  "description": "When true it means this block represents a portion of a document whose content is only indirectly related to the document's main content. Asides are frequently presented as sidebars or call-out boxes.",
                  "pbj": {
                    "rule": "single",
                    "type": "boolean"
                  },
                  "type": "boolean"
                },
                "id": {
                  "pattern": "^\\d+$",
                  "pbj": {
                    "rule": "single",
                    "type": "string"
                  },
                  "type": "string"
                },
                "show_byline": {
                  "description": "Whether or not to show the byline (eg \"from Dick Tracy\") in the thumbnail.",
                  "pbj": {
                    "rule": "single",
                    "type": "boolean"
                  },
                  "type": "boolean"
                },
                "show_title": {
                  "description": "Whether or not to show the video title in the thumbnail.",
                  "pbj": {
                    "rule": "single",
                    "type": "boolean"
                  },
                  "type": "boolean"
                },
                "title": {
                  "maxLength": 255,
                  "minLength": 0,
                  "pbj": {
                    "rule": "single",
                    "type": "string"
                  },
                  "type": "string"
                },
                "user_id": {
                  "pattern": "^[\\w\\.-]+$",
                  "pbj": {
                    "rule": "single",
                    "type": "string"
                  },
                  "type": "string"
                },
                "css_class": {
                  "description": "In rendering environments that support HTML the css_class can be appended to the dom elements' class attribute.",
                  "pattern": "^[\\w\\s-]+$",
                  "pbj": {
                    "rule": "single",
                    "type": "string"
                  },
                  "type": "string"
                },
                "poster_image_ref": {
                  "description": "A reference to an image asset to use as the poster that will override what is provided by vimeo.",
                  "pattern": "^[\\w\\/\\.:-]+$",
                  "pbj": {
                    "rule": "single",
                    "type": "identifier"
                  },
                  "type": "string"
                },
                "user_name": {
                  "pattern": "^[\\s\\w\\.-]+$",
                  "pbj": {
                    "rule": "single",
                    "type": "string"
                  },
                  "type": "string"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^show_title$": true,
                "^user_name$": true,
                "^updated_date$": true,
                "^description$": true,
                "^autoplay$": true,
                "^etag$": true,
                "^loop$": true,
                "^id$": true,
                "^show_byline$": true,
                "^poster_image_ref$": true,
                "^aside$": true,
                "^show_portrait$": true,
                "^user_id$": true,
                "^title$": true,
                "^css_class$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
