{
  "$id": "http://schemas.triniti.io/json-schema/triniti/common/mixin/advertising/1-0-0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ads_enabled": {
      "type": "boolean",
      "default": true,
      "pbj": {
        "type": "boolean",
        "rule": "single"
      }
    },
    "dfp_ad_unit_path": {
      "type": "string",
      "pattern": "^[\\w\\/\\.:-]+$",
      "pbj": {
        "type": "string",
        "rule": "single"
      }
    },
    "dfp_cust_params": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
          "type": "string",
          "pattern": "^[\\w\\/\\.:-]+$"
        }
      },
      "additionalProperties": false,
      "pbj": {
        "type": "string",
        "rule": "map"
      }
    }
  },
  "additionalProperties": true
}
