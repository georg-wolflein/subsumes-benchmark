{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "custom_code": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^custom_code$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 65535
                }
              },
              "description": "A map containing (HTML, JavaScript, CSS, etc.) that is injected into an application at a named insertion point, e.g. \"html_head\" or \"footer\".",
              "pbj": {
                "type": "text",
                "rule": "map"
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
