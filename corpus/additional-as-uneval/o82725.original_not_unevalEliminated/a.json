{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "theme": {
                  "type": "string",
                  "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                  "minLength": 0,
                  "maxLength": 255,
                  "description": "A string used to indicate that a visual treatment should be applied to a piece of content, e.g. \"christmas\" or \"taco\".",
                  "pbj": {
                    "type": "string",
                    "rule": "single",
                    "format": "slug"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^theme$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
