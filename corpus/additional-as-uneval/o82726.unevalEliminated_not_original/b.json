{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                  "type": "boolean"
                }
              },
              "pbj": {
                "type": "boolean",
                "rule": "map"
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 4294967295.0
                }
              },
              "pbj": {
                "type": "int",
                "rule": "map"
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "floats": {
                  "$ref": "#/$defs/modern_2"
                },
                "promotion_slot": {
                  "type": "string",
                  "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                  "minLength": 0,
                  "maxLength": 255,
                  "description": "The promotion_slot the rendering is happening in, e.g. desktop-home-sidebar or smartphone-global-html-head.",
                  "pbj": {
                    "type": "string",
                    "rule": "single",
                    "format": "slug"
                  }
                },
                "device_view": {
                  "type": "string",
                  "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                  "minLength": 0,
                  "maxLength": 255,
                  "pbj": {
                    "type": "string",
                    "rule": "single",
                    "format": "slug"
                  }
                },
                "_schema": {
                  "type": "string",
                  "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                  "default": "pbj:triniti:common::render-context:1-0-0"
                },
                "section": {
                  "type": "string",
                  "pattern": "^[\\w-]+$",
                  "description": "Refers to the location on the screen or application that the rendering is happening in, e.g. \"article-detail\", \"blogroll\", \"modal\", \"jumbotron\". Renderers can use this to customize the output.",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                },
                "cache_expiry": {
                  "type": "integer",
                  "default": 300,
                  "minimum": 0.0,
                  "maximum": 16777215.0,
                  "description": "Number of seconds the rendered output can be cached, if the cache_enabled field is true. Zero means cache indefinitely.",
                  "pbj": {
                    "type": "medium-int",
                    "rule": "single"
                  }
                },
                "strings": {
                  "$ref": "#/$defs/modern_3"
                },
                "trinaries": {
                  "$ref": "#/$defs/modern_4"
                },
                "booleans": {
                  "$ref": "#/$defs/modern_5"
                },
                "viewer_country": {
                  "type": "string",
                  "pattern": "^[A-Z]{2}$",
                  "pbj": {
                    "type": "string",
                    "rule": "single"
                  }
                },
                "platform": {
                  "type": "string",
                  "default": "web",
                  "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                  "minLength": 0,
                  "maxLength": 255,
                  "description": "The platform the rendering is happening in, e.g. web, amp, apple-news, facebook-instant-articles.",
                  "pbj": {
                    "type": "string",
                    "rule": "single",
                    "format": "slug"
                  }
                },
                "cache_enabled": {
                  "type": "boolean",
                  "default": true,
                  "pbj": {
                    "type": "boolean",
                    "rule": "single"
                  }
                },
                "container": {
                  "type": "object",
                  "description": "A message (e.g. article) where the rendering is taking place. This is used by some renderers when it needs data from the container or to generate urls.",
                  "pbj": {
                    "type": "message",
                    "rule": "single"
                  }
                },
                "ints": {
                  "$ref": "#/$defs/modern_6"
                }
              },
              "required": [
                "_schema"
              ]
            },
            {
              "patternProperties": {
                "^section$": true,
                "^device_view$": true,
                "^container$": true,
                "^promotion_slot$": true,
                "^platform$": true,
                "^ints$": true,
                "^cache_enabled$": true,
                "^cache_expiry$": true,
                "^trinaries$": true,
                "^strings$": true,
                "^viewer_country$": true,
                "^floats$": true,
                "^_schema$": true,
                "^booleans$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                  "type": "number",
                  "default": 0
                }
              },
              "pbj": {
                "type": "float",
                "rule": "map"
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 255
                }
              },
              "pbj": {
                "type": "string",
                "rule": "map"
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                  "type": "integer",
                  "default": 0,
                  "minimum": 0.0,
                  "maximum": 2.0
                }
              },
              "pbj": {
                "type": "trinary",
                "rule": "map"
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
