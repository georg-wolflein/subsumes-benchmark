{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Taxonomy",
              "description": "Taxonomy Schema Payload for Updating Service.",
              "type": "object",
              "required": [
                "vocabularyId",
                "vocabularyName",
                "vocabularyValues"
              ],
              "properties": {
                "vocabularyId": {
                  "description": "The unique identifier for the vocabulary.",
                  "type": "integer"
                },
                "vocabularyName": {
                  "description": "The vocabulary name.",
                  "type": "string"
                },
                "vocabularyValues": {
                  "description": "Types allowed in this vocabulary.",
                  "type": "array",
                  "minItems": 1,
                  "_uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              }
            },
            {
              "items": {
                "anyOf": [
                  false,
                  false
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "valueId",
                "valueName"
              ],
              "properties": {
                "valueId": {
                  "description": "The unique identifier for the vocabulary type.",
                  "type": "integer"
                },
                "valueName": {
                  "description": "The value the vocabulary type.",
                  "type": "string"
                }
              }
            },
            {
              "items": {
                "anyOf": [
                  false,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
