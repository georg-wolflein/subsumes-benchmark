{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "_schema": {
                  "type": "string",
                  "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                  "default": "pbj:triniti:curator::slot:1-0-0"
                },
                "name": {
                  "type": "string",
                  "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                  "minLength": 0,
                  "maxLength": 255,
                  "description": "The name of the location where the widget should render, e.g. \"sidebar\", \"html-head\" or \"jumbotron-top\".",
                  "pbj": {
                    "type": "string",
                    "rule": "single",
                    "format": "slug"
                  }
                },
                "widget_ref": {
                  "type": "string",
                  "pattern": "^[\\w\\/\\.:-]+$",
                  "description": "A reference to the widget this slot will render.",
                  "pbj": {
                    "type": "identifier",
                    "rule": "single"
                  }
                },
                "rendering": {
                  "type": "string",
                  "default": "lazy",
                  "enum": [
                    "unknown",
                    "server",
                    "client",
                    "lazy"
                  ],
                  "pbj": {
                    "type": "string-enum",
                    "rule": "single"
                  }
                }
              },
              "required": [
                "_schema"
              ]
            },
            {
              "patternProperties": {
                "^_schema$": true,
                "^name$": true,
                "^widget_ref$": true,
                "^rendering$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
