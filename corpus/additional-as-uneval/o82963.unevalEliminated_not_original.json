{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "maximum",
    "minLength",
    "minimum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82963.unevalEliminated_not_original.json",
  "a": {
    "$id": "http://schemas.triniti.io/json-schema/triniti/notify/notifier-result/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "_schema": {
        "type": "string",
        "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
        "default": "pbj:triniti:notify::notifier-result:1-0-0"
      },
      "tags": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
            "type": "string",
            "pattern": "^[\\w\\/\\.:-]+$"
          }
        },
        "additionalProperties": false,
        "description": "Tags is a map that categorizes data or tracks references in external systems. The tags names should be consistent and descriptive, e.g. fb_user_id:123, salesforce_customer_id:456.",
        "pbj": {
          "type": "string",
          "rule": "map"
        }
      },
      "ok": {
        "type": "boolean",
        "default": true,
        "pbj": {
          "type": "boolean",
          "rule": "single"
        }
      },
      "code": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "maximum": 65535,
        "pbj": {
          "type": "small-int",
          "rule": "single"
        }
      },
      "error_name": {
        "type": "string",
        "pattern": "^[\\w\\/\\.:-]+$",
        "pbj": {
          "type": "string",
          "rule": "single"
        }
      },
      "error_message": {
        "type": "string",
        "minLength": 0,
        "maxLength": 65535,
        "pbj": {
          "type": "text",
          "rule": "single"
        }
      },
      "raw_response": {
        "type": "string",
        "minLength": 0,
        "maxLength": 65535,
        "description": "When a notification is sent the platform/vendor often responds with a payload that describes the result. This field should contain a (de)serializable string, JSON is preferred.",
        "pbj": {
          "type": "text",
          "rule": "single"
        }
      }
    },
    "required": [
      "_schema"
    ],
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "tags": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "_schema": {
                    "type": "string",
                    "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                    "default": "pbj:triniti:notify::notifier-result:1-0-0"
                  },
                  "raw_response": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 65535,
                    "description": "When a notification is sent the platform/vendor often responds with a payload that describes the result. This field should contain a (de)serializable string, JSON is preferred.",
                    "pbj": {
                      "type": "text",
                      "rule": "single"
                    }
                  },
                  "code": {
                    "type": "integer",
                    "default": 0,
                    "minimum": 0.0,
                    "maximum": 65535.0,
                    "pbj": {
                      "type": "small-int",
                      "rule": "single"
                    }
                  },
                  "error_message": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 65535,
                    "pbj": {
                      "type": "text",
                      "rule": "single"
                    }
                  },
                  "ok": {
                    "type": "boolean",
                    "default": true,
                    "pbj": {
                      "type": "boolean",
                      "rule": "single"
                    }
                  },
                  "error_name": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$",
                    "pbj": {
                      "type": "string",
                      "rule": "single"
                    }
                  }
                },
                "required": [
                  "_schema"
                ]
              },
              {
                "patternProperties": {
                  "^code$": true,
                  "^error_name$": true,
                  "^raw_response$": true,
                  "^ok$": true,
                  "^tags$": true,
                  "^error_message$": true,
                  "^_schema$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$"
                  }
                },
                "description": "Tags is a map that categorizes data or tracks references in external systems. The tags names should be consistent and descriptive, e.g. fb_user_id:123, salesforce_customer_id:456.",
                "pbj": {
                  "type": "string",
                  "rule": "map"
                }
              },
              {
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
