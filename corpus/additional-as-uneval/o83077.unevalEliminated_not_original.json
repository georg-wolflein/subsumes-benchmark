{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "maximum",
    "minimum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83077.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Lobby server set",
    "description": "A set of lobby servers",
    "type": "array",
    "items": {
      "title": "Lobby server",
      "description": "A lobby server",
      "type": "object",
      "properties": {
        "version": {
          "description": "The lobby server engine version",
          "type": "string",
          "pattern": "^\\d+(\\.\\d+){1,3}$"
        },
        "host": {
          "description": "The lobby server host",
          "type": "string",
          "anyOf": [
            {
              "format": "host-name"
            },
            {
              "format": "ipv4"
            },
            {
              "format": "ipv6"
            }
          ]
        },
        "port": {
          "description": "The TCP port on which the lobby server accepts connections",
          "type": "number",
          "minimum": 0,
          "maximum": 65535
        },
        "https_port": {
          "description": "Https lobby server port",
          "type": "number",
          "minimum": 0,
          "maximum": 65535
        },
        "message": {
          "description": "The message displayed when a user connects to an available lobby server",
          "type": [
            "string",
            "null"
          ]
        },
        "error_message": {
          "description": "The message displayed when a user connects to an unavailable lobby server",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "version",
        "host",
        "port",
        "https_port",
        "message",
        "error_message"
      ],
      "additionalProperties": false
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Lobby server set",
    "description": "A set of lobby servers",
    "type": "array",
    "items": {
      "$ref": "#/$defs/modern_1"
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Lobby server",
                "description": "A lobby server",
                "type": "object",
                "properties": {
                  "host": {
                    "description": "The lobby server host",
                    "type": "string",
                    "anyOf": [
                      {
                        "format": "host-name"
                      },
                      {
                        "format": "ipv4"
                      },
                      {
                        "format": "ipv6"
                      }
                    ]
                  },
                  "version": {
                    "description": "The lobby server engine version",
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+){1,3}$"
                  },
                  "port": {
                    "description": "The TCP port on which the lobby server accepts connections",
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 65535.0
                  },
                  "https_port": {
                    "description": "Https lobby server port",
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 65535.0
                  },
                  "message": {
                    "description": "The message displayed when a user connects to an available lobby server",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error_message": {
                    "description": "The message displayed when a user connects to an unavailable lobby server",
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "version",
                  "host",
                  "port",
                  "https_port",
                  "message",
                  "error_message"
                ]
              },
              {
                "patternProperties": {
                  "^https_port$": true,
                  "^host$": true,
                  "^error_message$": true,
                  "^message$": true,
                  "^port$": true,
                  "^version$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
