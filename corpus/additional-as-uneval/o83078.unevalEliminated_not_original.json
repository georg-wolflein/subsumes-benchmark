{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83078.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Maps set",
    "description": "A set of maps",
    "type": "array",
    "items": {
      "title": "Map",
      "description": "A map",
      "type": "object",
      "properties": {
        "mapName": {
          "description": "The map name",
          "type": "string"
        },
        "mapCategory": {
          "description": "The map category",
          "type": "string",
          "enum": [
            "BEST",
            "GOOD",
            "DEVELOPMENT",
            "EXPERIMENTAL"
          ]
        },
        "mapType": {
          "description": "The map type",
          "type": "string",
          "enum": [
            "MAP",
            "MAP_SKIN",
            "MAP_TOOL"
          ]
        },
        "url": {
          "description": "The map download URL",
          "type": "string"
        },
        "version": {
          "description": "The map download version",
          "type": "integer",
          "minimum": 1
        },
        "img": {
          "description": "The map thumbnail image URL",
          "type": "string"
        },
        "description": {
          "description": "The map description",
          "type": "string"
        }
      },
      "required": [
        "mapName",
        "url",
        "version",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Maps set",
    "description": "A set of maps",
    "type": "array",
    "items": {
      "$ref": "#/$defs/modern_1"
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Map",
                "description": "A map",
                "type": "object",
                "properties": {
                  "url": {
                    "description": "The map download URL",
                    "type": "string"
                  },
                  "description": {
                    "description": "The map description",
                    "type": "string"
                  },
                  "img": {
                    "description": "The map thumbnail image URL",
                    "type": "string"
                  },
                  "version": {
                    "description": "The map download version",
                    "type": "integer",
                    "minimum": 1.0
                  },
                  "mapCategory": {
                    "description": "The map category",
                    "type": "string",
                    "enum": [
                      "BEST",
                      "GOOD",
                      "DEVELOPMENT",
                      "EXPERIMENTAL"
                    ]
                  },
                  "mapName": {
                    "description": "The map name",
                    "type": "string"
                  },
                  "mapType": {
                    "description": "The map type",
                    "type": "string",
                    "enum": [
                      "MAP",
                      "MAP_SKIN",
                      "MAP_TOOL"
                    ]
                  }
                },
                "required": [
                  "mapName",
                  "url",
                  "version",
                  "description"
                ]
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^description$": true,
                  "^url$": true,
                  "^img$": true,
                  "^mapCategory$": true,
                  "^mapName$": true,
                  "^mapType$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
