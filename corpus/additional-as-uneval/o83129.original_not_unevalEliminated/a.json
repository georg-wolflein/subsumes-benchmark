{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Target",
  "$defs": {
    "Target": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "required": [
                "method",
                "url"
              ],
              "properties": {
                "body": {
                  "type": "string",
                  "media": {
                    "binaryEncoding": "base64"
                  }
                },
                "header": {
                  "patternProperties": {
                    ".*": {
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "method": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^body$": true,
                "^header$": true,
                "^method$": true,
                "^url$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
