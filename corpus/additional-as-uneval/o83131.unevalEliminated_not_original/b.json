{
  "$id": "https://github.com/tsqllint/tsqllint/master/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Configuration for TSQLLint tool",
  "type": "object",
  "properties": {
    "rules": {
      "$ref": "#/$defs/modern_1"
    },
    "plugins": {
      "$ref": "#/$defs/modern_2"
    }
  },
  "required": [
    "rules"
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "semicolon-termination": {
                  "$ref": "#/$defs/rule"
                },
                "set-transaction-isolation-level": {
                  "$ref": "#/$defs/rule"
                },
                "print-statement": {
                  "$ref": "#/$defs/rule"
                },
                "data-compression": {
                  "$ref": "#/$defs/rule",
                  "description": "Requires use of compression option during table creation"
                },
                "multi-table-alias": {
                  "$ref": "#/$defs/rule"
                },
                "select-star": {
                  "$ref": "#/$defs/rule"
                },
                "conditional-begin-end": {
                  "$ref": "#/$defs/rule",
                  "description": "Enforce use of BEGIN and END symbols inside condition statements"
                },
                "data-type-length": {
                  "$ref": "#/$defs/rule",
                  "description": "Requires use of length when declaring data types with variable length"
                },
                "keyword-capitalization": {
                  "$ref": "#/$defs/rule",
                  "description": "Requires use of capitalized keywords"
                },
                "non-sargable": {
                  "$ref": "#/$defs/rule"
                },
                "set-quoted-identifier": {
                  "$ref": "#/$defs/rule"
                },
                "unicode-string": {
                  "$ref": "#/$defs/rule"
                },
                "schema-qualify": {
                  "$ref": "#/$defs/rule"
                },
                "set-nocount": {
                  "$ref": "#/$defs/rule"
                },
                "cross-database-transaction": {
                  "$ref": "#/$defs/rule",
                  "description": "Discourages inserts or updates that create transactions in more than one database"
                },
                "upper-lower": {
                  "$ref": "#/$defs/rule"
                },
                "named-constraint": {
                  "$ref": "#/$defs/rule"
                },
                "disallow-cursors": {
                  "$ref": "#/$defs/rule",
                  "description": "Disallows use of cursors"
                },
                "linked-server": {
                  "$ref": "#/$defs/rule",
                  "description": "Disallows user of linked server calls"
                },
                "full-text": {
                  "$ref": "#/$defs/rule",
                  "description": "Disallows use of Full Text"
                },
                "set-variable": {
                  "$ref": "#/$defs/rule"
                },
                "information-schema": {
                  "$ref": "#/$defs/rule",
                  "description": "Disallows use of INFORMATION_SCHEMA views"
                },
                "set-ansi": {
                  "$ref": "#/$defs/rule"
                },
                "object-property": {
                  "$ref": "#/$defs/rule"
                }
              }
            },
            {
              "patternProperties": {
                "^multi-table-alias$": true,
                "^set-variable$": true,
                "^linked-server$": true,
                "^non-sargable$": true,
                "^semicolon-termination$": true,
                "^data-compression$": true,
                "^schema-qualify$": true,
                "^unicode-string$": true,
                "^full-text$": true,
                "^named-constraint$": true,
                "^print-statement$": true,
                "^upper-lower$": true,
                "^information-schema$": true,
                "^keyword-capitalization$": true,
                "^set-quoted-identifier$": true,
                "^data-type-length$": true,
                "^disallow-cursors$": true,
                "^set-transaction-isolation-level$": true,
                "^cross-database-transaction$": true,
                "^object-property$": true,
                "^conditional-begin-end$": true,
                "^set-nocount$": true,
                "^set-ansi$": true,
                "^select-star$": true
              },
              "additionalProperties": {
                "$ref": "#/$defs/rule"
              }
            }
          ]
        }
      ]
    },
    "rule": {
      "type": "string",
      "enum": [
        "off",
        "warning",
        "error"
      ],
      "default": "off"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    }
  }
}
