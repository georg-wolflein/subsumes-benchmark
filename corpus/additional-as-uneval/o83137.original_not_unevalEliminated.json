{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83137.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "oneOf": [
      {
        "$ref": "#/$defs/modern_1"
      },
      {
        "$ref": "#/$defs/modern_3"
      }
    ],
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "locks": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    }
                  },
                  "next_cursor": {
                    "type": "string"
                  }
                },
                "required": [
                  "locks"
                ]
              },
              {
                "patternProperties": {
                  "^locks$": true,
                  "^next_cursor$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "unlocked_at": {
                    "type": "string"
                  },
                  "committer": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "name",
                      "email"
                    ]
                  },
                  "locked_at": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  },
                  "commit_sha": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "path",
                  "commit_sha",
                  "locked_at"
                ]
              },
              {
                "items": {
                  "anyOf": [
                    false,
                    false
                  ]
                }
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "locks": {
                    "type": "null"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "error"
                ]
              },
              {
                "patternProperties": {
                  "^locks$": true,
                  "^error$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "oneOf": [
      {
        "properties": {
          "locks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "committer": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "email"
                  ]
                },
                "commit_sha": {
                  "type": "string"
                },
                "locked_at": {
                  "type": "string"
                },
                "unlocked_at": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "path",
                "commit_sha",
                "locked_at"
              ]
            }
          },
          "next_cursor": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "locks"
        ]
      },
      {
        "properties": {
          "locks": {
            "type": "null"
          },
          "error": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "error"
        ]
      }
    ]
  }
}
