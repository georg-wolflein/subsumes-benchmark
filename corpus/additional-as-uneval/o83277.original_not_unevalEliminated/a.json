{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get-menus",
  "type": "array",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "leaf": {
                  "type": "boolean"
                },
                "category": {
                  "type": "string"
                },
                "iconCls": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "node_type": {
                  "type": "string"
                },
                "group_by": {
                  "type": "string"
                },
                "query_group": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "defaultChartSettings": {
                  "type": "string"
                },
                "chartSettings": {
                  "type": "string"
                },
                "disabled": {
                  "type": "boolean"
                },
                "realm": {
                  "type": "string"
                }
              },
              "required": [
                "text",
                "id",
                "node_type",
                "iconCls",
                "leaf"
              ]
            },
            {
              "patternProperties": {
                "^chartSettings$": true,
                "^category$": true,
                "^group_by$": true,
                "^iconCls$": true,
                "^realm$": true,
                "^node_type$": true,
                "^description$": true,
                "^leaf$": true,
                "^defaultChartSettings$": true,
                "^disabled$": true,
                "^id$": true,
                "^query_group$": true,
                "^text$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
