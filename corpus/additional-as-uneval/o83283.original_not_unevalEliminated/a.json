{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "request": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "start_date": {
                  "type": "string",
                  "format": "date"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "Submitted",
                    "Available",
                    "Failed",
                    "Expired"
                  ]
                },
                "requested_datetime": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                },
                "export_expired": {
                  "type": "integer",
                  "minimum": 0.0,
                  "maximum": 1.0
                },
                "id": {
                  "type": "integer"
                },
                "end_date": {
                  "type": "string",
                  "format": "date"
                },
                "export_succeeded": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "integer",
                      "minimum": 0.0,
                      "maximum": 1.0
                    }
                  ]
                },
                "realm": {
                  "type": "string"
                },
                "export_file_format": {
                  "enum": [
                    "CSV",
                    "JSON"
                  ]
                },
                "export_expires_datetime": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                    }
                  ]
                },
                "downloaded_datetime": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                    }
                  ]
                },
                "export_created_datetime": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "realm",
                "start_date",
                "end_date",
                "export_succeeded",
                "export_expired",
                "export_expires_datetime",
                "export_created_datetime",
                "export_file_format",
                "requested_datetime",
                "state"
              ]
            },
            {
              "patternProperties": {
                "^export_file_format$": true,
                "^state$": true,
                "^export_expires_datetime$": true,
                "^start_date$": true,
                "^id$": true,
                "^export_expired$": true,
                "^export_succeeded$": true,
                "^realm$": true,
                "^end_date$": true,
                "^export_created_datetime$": true,
                "^requested_datetime$": true,
                "^downloaded_datetime$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Response from GET rest/warehouse/export/requests",
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "data": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/request"
                  }
                },
                "total": {
                  "type": "integer"
                }
              },
              "required": [
                "success",
                "data"
              ]
            },
            {
              "patternProperties": {
                "^success$": true,
                "^data$": true,
                "^total$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
