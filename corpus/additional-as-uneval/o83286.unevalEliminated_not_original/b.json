{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Resource Mapping",
  "description": "The mapping for the metrics from a SuPReMM resource to the unified format.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "start_date": {
      "type": "string"
    },
    "long_name": {
      "type": "string"
    },
    "ppn": {
      "type": "number"
    },
    "attributes": {
      "$ref": "#/$defs/modern_8"
    },
    "id": {
      "type": "number"
    },
    "nodes": {
      "type": "number"
    },
    "devices": {
      "type": "object",
      "patternProperties": {
        "netdir_(projects|work|scratch|share)": {
          "$ref": "#/$defs/netdir"
        },
        "netdrv_([a-z]+)": {
          "$ref": "#/$defs/netdrv"
        },
        "net_[a-z]+[0-9]+": {
          "$ref": "#/$defs/net"
        }
      }
    }
  },
  "required": [
    "id",
    "long_name",
    "name",
    "nodes",
    "ppn",
    "start_date",
    "devices",
    "attributes"
  ],
  "not": {
    "anyOf": [
      {
        "required": [
          "ref"
        ]
      },
      {
        "required": [
          "metricErrors"
        ]
      }
    ]
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": true,
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^required$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "refattr": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "enum": [
                    "work",
                    "home",
                    "scratch",
                    "share",
                    "projects"
                  ]
                }
              },
              "required": [
                "name",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "error": {
                  "type": "integer"
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "error"
              ]
            },
            {
              "patternProperties": {
                "^error$": true,
                "^required$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": [
                    "string",
                    "array"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "ref"
              ]
            },
            {
              "patternProperties": {
                "^ref$": true,
                "^required$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "net": {
      "$ref": "#/$defs/modern_3"
    },
    "formattr": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "[a-z0-9_]*": {
                  "$ref": "#/$defs/attribute"
                }
              },
              "required": [
                "local_job_id",
                "resource_name",
                "resource_id",
                "organization_id",
                "account",
                "username",
                "cwd",
                "executable",
                "exit_status",
                "granted_pe",
                "queue",
                "requested_nodes",
                "hosts",
                "nodes",
                "shared",
                "cores",
                "cores_avail",
                "submit_time_ts",
                "eligible_time_ts",
                "start_time_ts",
                "end_time_ts",
                "wall_time",
                "requested_wall_time",
                "wait_time",
                "cpu_time",
                "cpu_idle",
                "cpu_system",
                "cpu_user",
                "error",
                "flops",
                "flops_cov",
                "cpiref",
                "catastrophe",
                "cpldref",
                "cpiref_cov",
                "mem_transferred",
                "mem_transferred_cov",
                "cpu_user_imbalance",
                "cpu_user_cv",
                "memory_used",
                "memory_used_cov",
                "mem_used_including_os_caches",
                "mem_used_including_os_caches_cov",
                "ib_rx_bytes"
              ]
            },
            {
              "patternProperties": {
                "[a-z0-9_]*": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "valattr": {
      "$ref": "#/$defs/modern_5"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "attribute": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/refattr"
        },
        {
          "$ref": "#/$defs/formattr"
        },
        {
          "$ref": "#/$defs/valattr"
        },
        {
          "$ref": "#/$defs/errattr"
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "formula": true,
                "required": {
                  "type": "boolean"
                }
              },
              "required": [
                "formula"
              ]
            },
            {
              "patternProperties": {
                "^formula$": true,
                "^required$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "netdir": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "netdrv": {
      "$ref": "#/$defs/modern_6"
    },
    "errattr": {
      "$ref": "#/$defs/modern_7"
    }
  }
}
