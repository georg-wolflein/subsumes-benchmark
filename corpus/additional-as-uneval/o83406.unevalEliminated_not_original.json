{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83406.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Jupyter Interactive Widget View JSON schema.",
    "type": "object",
    "properties": {
      "version_major": {
        "description": "Format version (major)",
        "type": "number",
        "minimum": 1,
        "maximum": 1
      },
      "version_minor": {
        "description": "Format version (minor)",
        "type": "number"
      },
      "model_id": {
        "description": "Unique identifier of the widget model to be displayed",
        "type": "string"
      }
    },
    "required": [
      "model_id"
    ],
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Jupyter Interactive Widget View JSON schema.",
                "type": "object",
                "properties": {
                  "version_major": {
                    "description": "Format version (major)",
                    "type": "number",
                    "minimum": 1.0,
                    "maximum": 1.0
                  },
                  "version_minor": {
                    "description": "Format version (minor)",
                    "type": "number"
                  },
                  "model_id": {
                    "description": "Unique identifier of the widget model to be displayed",
                    "type": "string"
                  }
                },
                "required": [
                  "model_id"
                ]
              },
              {
                "patternProperties": {
                  "^version_major$": true,
                  "^version_minor$": true,
                  "^model_id$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
