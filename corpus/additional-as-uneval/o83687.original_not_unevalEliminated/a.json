{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Registration",
              "description": "Sports activity registration, 12-14 age bracket",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "sex": {
                  "allOf": [
                    {
                      "type": "string"
                    },
                    {
                      "enum": [
                        "M",
                        "F"
                      ]
                    }
                  ]
                },
                "age": {
                  "allOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "minimum": 12.0
                    },
                    {
                      "maximum": 14.0
                    }
                  ]
                }
              },
              "required": [
                "name",
                "sex",
                "age"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^sex$": true,
                "^age$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
