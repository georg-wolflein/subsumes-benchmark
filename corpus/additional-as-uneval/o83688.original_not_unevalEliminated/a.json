{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Team size",
              "description": "Team sizes for play day competitions",
              "type": "object",
              "properties": {
                "size": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 2.0,
                      "maximum": 4.0
                    },
                    {
                      "type": "integer",
                      "minimum": 4.0,
                      "maximum": 6.0
                    },
                    {
                      "type": "integer",
                      "minimum": 8.0,
                      "maximum": 10.0
                    },
                    {
                      "type": "integer",
                      "minimum": 10.0,
                      "maximum": 12.0
                    }
                  ]
                }
              },
              "required": [
                "size"
              ]
            },
            {
              "patternProperties": {
                "^size$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
