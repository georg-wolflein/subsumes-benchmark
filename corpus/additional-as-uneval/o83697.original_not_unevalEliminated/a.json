{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Note",
              "description": "Note with optional comments",
              "type": "object",
              "properties": {
                "author": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "^comment[1-9]$": {
                  "type": "string"
                }
              },
              "required": [
                "author",
                "title",
                "content"
              ]
            },
            {
              "patternProperties": {
                "^author$": true,
                "^title$": true,
                "^content$": true,
                "^comment[1-9]$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
