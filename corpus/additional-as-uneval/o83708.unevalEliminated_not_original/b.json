{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "IP address/port for primary/backup server pair",
              "items": {
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "port": {
                    "maximum": 65535.0,
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "required": [
                  "address",
                  "port"
                ],
                "type": "object"
              },
              "maxItems": 2,
              "minItems": 2,
              "title": "Primary and Backup Servers",
              "type": "array",
              "_uniqueItems": true
            },
            {
              "items": {
                "anyOf": [
                  true,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
