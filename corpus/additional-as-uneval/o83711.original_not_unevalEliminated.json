{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83711.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83711.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HTTP Server",
    "description": "HTTP server definition and URL list",
    "type": "object",
    "properties": {
      "server": {
        "$ref": "#/$defs/modern_1"
      },
      "pages": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_2"
        }
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                },
                "required": [
                  "address",
                  "port"
                ]
              },
              {
                "patternProperties": {
                  "^address$": true,
                  "^port$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  },
                  "page": {
                    "type": "string"
                  }
                },
                "required": [
                  "url",
                  "page"
                ]
              },
              {
                "patternProperties": {
                  "^url$": true,
                  "^page$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "HTTP Server",
    "description": "HTTP server definition and URL list",
    "type": "object",
    "properties": {
      "server": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "address",
          "port"
        ]
      },
      "pages": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "page": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "url",
            "page"
          ]
        }
      }
    }
  }
}
