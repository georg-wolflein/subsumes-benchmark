{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Taxation Id",
              "description": "Identification number for taxation purposes",
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ssn": {
                  "type": "string",
                  "pattern": "^[0-9]{3}-[0-9]{2}-[0-9]{4}$"
                },
                "ein": {
                  "type": "string",
                  "pattern": "^[0-9]{2}-[0-9]{7}$"
                },
                "itin": {
                  "type": "string",
                  "pattern": "^9[0-9]{2}-[0-9]{2}-[0-9]{4}$"
                }
              },
              "required": [
                "name"
              ],
              "oneOf": [
                {
                  "required": [
                    "ssn"
                  ]
                },
                {
                  "required": [
                    "ein"
                  ]
                },
                {
                  "required": [
                    "itin"
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^ssn$": true,
                "^ein$": true,
                "^itin$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
