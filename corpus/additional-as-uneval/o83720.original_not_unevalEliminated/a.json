{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Server start up",
  "description": "List of servers to start",
  "type": "object",
  "properties": {
    "servers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "start": {
                  "type": "boolean"
                },
                "program": {
                  "type": "string"
                },
                "port": {
                  "type": "integer"
                }
              },
              "required": [
                "name",
                "start",
                "program",
                "port"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^start$": true,
                "^program$": true,
                "^port$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
