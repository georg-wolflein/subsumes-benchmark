{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Employee",
  "description": "Employee data",
  "type": "object",
  "properties": {
    "employees": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "unit": {
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 9999.0
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "unit",
                "title"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^unit$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
