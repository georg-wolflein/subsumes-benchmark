{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Addition response",
              "description": "Answer from addition service",
              "type": "object",
              "properties": {
                "answer": {
                  "type": "integer",
                  "minimum": 1.0
                }
              },
              "required": [
                "answer"
              ]
            },
            {
              "patternProperties": {
                "^answer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
