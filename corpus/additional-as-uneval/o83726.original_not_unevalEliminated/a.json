{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Inventory",
  "description": "Inventory with current stock count",
  "type": "array",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "id": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 0.0
                }
              },
              "required": [
                "id",
                "count"
              ]
            },
            {
              "patternProperties": {
                "^id$": true,
                "^count$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
