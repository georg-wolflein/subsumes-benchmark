                    "type": "string"
                  },
                  "defeatString": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^defeatIconIndex$": true,
                  "^victoryString$": true,
                  "^triggeredEvents$": true,
                  "^defeatString$": true,
                  "^victoryIconIndex$": true
