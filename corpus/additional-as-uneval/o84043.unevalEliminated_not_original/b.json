{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "web-dir"
  ],
  "properties": {
    "scripts": {
      "$ref": "#/$defs/modern_1"
    },
    "vars": {
      "$ref": "#/$defs/modern_2"
    },
    "web-dir": {
      "type": "string",
      "description": "Relative directory that contains files to be published as website"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "This is a hash of script names (keys) and shell commands (values) to execute.",
              "patternProperties": {
                "^([a-z0-9-])+$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^([a-z0-9-])+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "This is a hash of variable names (keys) and values (values).",
              "patternProperties": {
                "^[a-zA-Z_][a-zA-Z_0-9]*$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z_][a-zA-Z_0-9]*$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
