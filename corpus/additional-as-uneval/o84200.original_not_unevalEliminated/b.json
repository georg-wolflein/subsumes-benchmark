    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "oid": {
            "type": "string"
          },
          "num_oid": {
            "type": "string",
            "pattern": "^(\\.\\d+)+\\.?\\{\\{ \\$index \\}\\}(\\.\\d+)*$"
          },
          "index": {
            "type": [
              "integer",
              "string"
