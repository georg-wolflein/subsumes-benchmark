            "airflow": {
              "$ref": "#/$defs/sensor"
            },
            "current": {
              "$ref": "#/$defs/sensor"
            },
            "frequency": {
              "$ref": "#/$defs/sensor"
            },
            "power": {
              "$ref": "#/$defs/sensor"
            },
            "pressure": {
              "$ref": "#/$defs/sensor"
            },
            "cooling": {
              "$ref": "#/$defs/sensor"
            },
            "charge": {
              "$ref": "#/$defs/sensor"
            },
            "runtime": {
              "$ref": "#/$defs/sensor"
            },
            "dbm": {
              "$ref": "#/$defs/sensor"
            },
            "load": {
              "$ref": "#/$defs/sensor"
            },
            "chromatic_dispersion": {
              "$ref": "#/$defs/sensor"
            },
            "delay": {
              "$ref": "#/$defs/sensor"
            },
            "quality_factor": {
              "$ref": "#/$defs/sensor"
            },
            "snr": {
              "$ref": "#/$defs/sensor"
            },
            "waterflow": {
              "$ref": "#/$defs/sensor"
            },
            "eer": {
              "$ref": "#/$defs/sensor"
