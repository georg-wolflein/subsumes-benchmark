                "value": {
                  "type": [
                    "boolean",
                    "integer",
                    "string",
                    "array"
                  ],
                  "items": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                }
              },
              "additionalProperties": false,
              "required": [
                "oid",
                "op",
                "value"
              ]
            }
          },
          "snmp_flags": {
            "type": [
              "string",
              "array"
            ]
          },
