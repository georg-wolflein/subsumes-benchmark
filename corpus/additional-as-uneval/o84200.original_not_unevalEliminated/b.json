      "type": "string",
      "enum": [
        "=",
        "!=",
        "==",
        "!==",
        "<=",
        ">=",
        "<",
        ">",
        "starts",
        "ends",
        "contains",
        "regex",
        "not_starts",
        "not_ends",
        "not_contains",
        "not_regex",
        "in_array",
        "not_in_array",
        "exists"
      ]
    }
