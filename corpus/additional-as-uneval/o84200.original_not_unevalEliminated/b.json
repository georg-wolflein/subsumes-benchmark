            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "low_limit": {
            "type": [
              "number",
              "string"
            ]
          },
          "low_warn_limit": {
            "type": [
              "number",
              "string"
            ]
          },
          "warn_limit": {
            "type": [
              "number",
              "string"
            ]
          },
          "high_limit": {
            "type": [
              "number",
              "string"
            ]
          },
          "skip_value_lt": {
            "type": "number"
