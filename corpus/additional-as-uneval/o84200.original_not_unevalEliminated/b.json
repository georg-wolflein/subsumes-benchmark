                      "snmp_flags": {
                        "type": [
                          "string",
                          "array"
                        ]
                      },
                      "entPhysicalIndex": {
                        "type": [
                          "integer",
                          "string"
                        ]
                      },
                      "entPhysicalIndex_measured": {
                        "type": "string"
