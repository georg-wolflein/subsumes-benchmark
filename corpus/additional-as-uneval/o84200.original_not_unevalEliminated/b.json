                          "number",
                          "string"
                        ]
                      },
                      "warn_limit": {
                        "type": [
                          "number",
                          "string"
                        ]
                      },
                      "high_limit": {
                        "type": [
                          "number",
                          "string"
                        ]
                      },
                      "skip_value_lt": {
                        "type": "number"
                      },
                      "skip_value_gt": {
                        "type": "number"
                      },
                      "num_oid": {
                        "type": "string",
