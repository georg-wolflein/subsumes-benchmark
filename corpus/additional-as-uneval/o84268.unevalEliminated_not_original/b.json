{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "generic log container format",
              "properties": {
                "name": {
                  "type": "string"
                },
                "exception": {
                  "$ref": "#/$defs/modern_2"
                },
                "version": {
                  "pattern": "^0$",
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "time": {
                  "_format": "date-time",
                  "type": "string"
                },
                "level": {
                  "pattern": "^(debug|info|warn|crit|fatal|unknown)$",
                  "type": "string"
                },
                "context": {
                  "$ref": "#/$defs/modern_4"
                },
                "data": {
                  "$ref": "#/$defs/modern_5"
                }
              },
              "required": [
                "time",
                "name",
                "level"
              ],
              "title": "Steno Log Container",
              "type": "object"
            },
            {
              "patternProperties": {
                "^version$": true,
                "^exception$": true,
                "^level$": true,
                "^name$": true,
                "^context$": true,
                "^data$": true,
                "^id$": true,
                "^time$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "backtrace": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "data": {
                  "$ref": "#/$defs/modern_3"
                },
                "message": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "type",
                "message",
                "backtrace"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^backtrace$": true,
                "^data$": true,
                "^message$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {},
              "type": "object"
            },
            {
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "method": {
                  "type": "string"
                },
                "line": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "threadId": {
                  "type": "string"
                },
                "processId": {
                  "type": "string"
                },
                "namespace": {
                  "type": "string"
                },
                "class": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^file$": true,
                "^method$": true,
                "^host$": true,
                "^threadId$": true,
                "^line$": true,
                "^class$": true,
                "^namespace$": true,
                "^processId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
