                }
              },
              "required": [
                "leftPlayerName",
                "leftPlayerCharacters",
                "leftPlayerScore",
                "rightPlayerName",
                "rightPlayerCharacters",
                "rightPlayerScore"
              ]
            },
            {
              "patternProperties": {
                "^leftPlayerScore$": true,
                "^rightPlayerName$": true,
                "^leftPlayerCharacters$": true,
                "^leftPlayerName$": true,
                "^rightPlayerScore$": true,
