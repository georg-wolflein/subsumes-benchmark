{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o85973.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Named Entity",
                "description": "Models a named entity (i.e. name of a person, place, or organization) used in a piece of content.",
                "type": "object",
                "required": [
                  "_id",
                  "name",
                  "type"
                ],
                "properties": {
                  "_id": {
                    "type": "string",
                    "description": "A unique identifier for the concept of the named entity."
                  },
                  "name": {
                    "type": "string",
                    "description": "The actual string of text that was identified as a named entity."
                  },
                  "type": {
                    "type": "string",
                    "description": "A description of what the named entity is. E.g. 'organization', 'person', or 'location'."
                  },
                  "score": {
                    "type": "number",
                    "decription": "An optional relevancy for this named entitiy."
                  }
                }
              },
              {
                "patternProperties": {
                  "^_id$": true,
                  "^name$": true,
                  "^type$": true,
                  "^score$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.10.5/utils/named_entity.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Named Entity",
    "description": "Models a named entity (i.e. name of a person, place, or organization) used in a piece of content.",
    "type": "object",
    "required": [
      "_id",
      "name",
      "type"
    ],
    "additionalProperties": false,
    "properties": {
      "_id": {
        "type": "string",
        "description": "A unique identifier for the concept of the named entity."
      },
      "name": {
        "type": "string",
        "description": "The actual string of text that was identified as a named entity."
      },
      "type": {
        "type": "string",
        "description": "A description of what the named entity is. E.g. 'organization', 'person', or 'location'."
      },
      "score": {
        "type": "number",
        "decription": "An optional relevancy for this named entitiy."
      }
    }
  }
}
