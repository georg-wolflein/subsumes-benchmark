{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Source",
              "description": "Information about the original source and/or owner of this content",
              "type": "object",
              "properties": {
                "source_id": {
                  "description": "Original source CMS id",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^source_id$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
