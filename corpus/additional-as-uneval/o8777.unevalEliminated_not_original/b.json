{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9._-]+$": {
                  "$ref": "#/$defs/service"
                }
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z0-9._-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "list_or_dict": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "_uniqueItems": true
        },
        {
          "type": "object"
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "dns_search": {
                  "$ref": "#/$defs/string_or_list"
                },
                "image": {
                  "type": "string"
                },
                "read_only": {
                  "type": "boolean"
                },
                "command": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "volume_driver": {
                  "type": "string"
                },
                "labels": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "working_dir": {
                  "type": "string"
                },
                "external_links": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "user": {
                  "type": "string"
                },
                "dns": {
                  "$ref": "#/$defs/string_or_list"
                },
                "ulimits": {
                  "type": "object",
                  "patternProperties": {
                    "^[a-z]+$": {
                      "oneOf": [
                        {
                          "type": "integer"
                        },
                        {
                          "$ref": "#/$defs/modern_2"
                        }
                      ]
                    }
                  }
                },
                "dockerfile": {
                  "type": "string"
                },
                "hostname": {
                  "type": "string"
                },
                "log_opt": {
                  "type": "object"
                },
                "cgroup_parent": {
                  "type": "string"
                },
                "env_file": {
                  "$ref": "#/$defs/string_or_list"
                },
                "domainname": {
                  "type": "string"
                },
                "build": {
                  "type": "string"
                },
                "ports": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "type": "string",
                        "format": "ports"
                      },
                      {
                        "type": "number",
                        "format": "ports"
                      }
                    ]
                  },
                  "_uniqueItems": true
                },
                "extra_hosts": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "cap_drop": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "ipc": {
                  "type": "string"
                },
                "cpu_shares": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "volumes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "net": {
                  "type": "string"
                },
                "mac_address": {
                  "type": "string"
                },
                "entrypoint": {
                  "$ref": "#/$defs/string_or_list"
                },
                "cpuset": {
                  "type": "string"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "log_driver": {
                  "type": "string"
                },
                "pid": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "stdin_open": {
                  "type": "boolean"
                },
                "container_name": {
                  "type": "string"
                },
                "memswap_limit": {
                  "type": [
                    "number",
                    "string"
                  ]
                },
                "environment": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_3"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "_uniqueItems": true
                    }
                  ]
                },
                "expose": {
                  "type": "array",
                  "items": {
                    "type": [
                      "string",
                      "number"
                    ]
                  },
                  "_uniqueItems": true
                },
                "security_opt": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "extends": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/modern_4"
                    }
                  ]
                },
                "tty": {
                  "type": "boolean"
                },
                "privileged": {
                  "type": "boolean"
                },
                "restart": {
                  "type": "string"
                },
                "devices": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "volumes_from": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "cap_add": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "mem_limit": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "dependentRequired": {
                "memswap_limit": [
                  "mem_limit"
                ]
              }
            },
            {
              "patternProperties": {
                "^volumes$": true,
                "^tty$": true,
                "^memswap_limit$": true,
                "^env_file$": true,
                "^domainname$": true,
                "^dockerfile$": true,
                "^command$": true,
                "^net$": true,
                "^extends$": true,
                "^pid$": true,
                "^external_links$": true,
                "^volumes_from$": true,
                "^extra_hosts$": true,
                "^ports$": true,
                "^user$": true,
                "^ipc$": true,
                "^container_name$": true,
                "^image$": true,
                "^privileged$": true,
                "^mem_limit$": true,
                "^security_opt$": true,
                "^mac_address$": true,
                "^working_dir$": true,
                "^labels$": true,
                "^volume_driver$": true,
                "^cpuset$": true,
                "^log_opt$": true,
                "^hostname$": true,
                "^environment$": true,
                "^cap_drop$": true,
                "^dns_search$": true,
                "^stdin_open$": true,
                "^links$": true,
                "^name$": true,
                "^ulimits$": true,
                "^entrypoint$": true,
                "^cpu_shares$": true,
                "^dns$": true,
                "^devices$": true,
                "^cap_add$": true,
                "^cgroup_parent$": true,
                "^restart$": true,
                "^expose$": true,
                "^read_only$": true,
                "^log_driver$": true,
                "^build$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "hard": {
                  "type": "integer"
                },
                "soft": {
                  "type": "integer"
                }
              },
              "required": [
                "soft",
                "hard"
              ]
            },
            {
              "patternProperties": {
                "^hard$": true,
                "^soft$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "string_or_list": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/list_of_strings"
        }
      ]
    },
    "service": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[^-]+$": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ],
                  "format": "environment"
                }
              }
            },
            {
              "patternProperties": {
                "^[^-]+$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "list_of_strings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "_uniqueItems": true
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "service": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                }
              },
              "required": [
                "service"
              ]
            },
            {
              "patternProperties": {
                "^service$": true,
                "^file$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
