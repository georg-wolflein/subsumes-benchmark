{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "account_id": {
                  "type": "string",
                  "pattern": "^[\\w\\/\\.:-]+$",
                  "description": "The EME account that this message is associated with.",
                  "pbj": {
                    "type": "identifier",
                    "rule": "single"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^account_id$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
