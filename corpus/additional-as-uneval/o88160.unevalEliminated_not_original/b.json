{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "to_ref": {
                  "type": "string",
                  "pattern": "^[\\w\\/\\.:-]+$",
                  "pbj": {
                    "type": "identifier",
                    "rule": "single"
                  }
                },
                "_schema": {
                  "type": "string",
                  "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                  "default": "pbj:eme:solicits:edge:submissions:1-0-0"
                },
                "multiplicity": {
                  "type": "string",
                  "default": "one2many",
                  "enum": [
                    "unknown",
                    "multi",
                    "simple",
                    "many2one",
                    "one2many",
                    "one2one"
                  ],
                  "pbj": {
                    "type": "string-enum",
                    "rule": "single"
                  }
                },
                "created_at": {
                  "type": "string",
                  "pattern": "^[1-9]{1}[0-9]{12,15}$",
                  "pbj": {
                    "type": "microtime",
                    "rule": "single"
                  }
                },
                "from_ref": {
                  "type": "string",
                  "pattern": "^[\\w\\/\\.:-]+$",
                  "pbj": {
                    "type": "identifier",
                    "rule": "single"
                  }
                }
              },
              "required": [
                "_schema",
                "from_ref",
                "to_ref"
              ]
            },
            {
              "patternProperties": {
                "^from_ref$": true,
                "^created_at$": true,
                "^_schema$": true,
                "^multiplicity$": true,
                "^to_ref$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
