{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "generateAddressParameters",
              "type": "object",
              "properties": {
                "options": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^options$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Options to control how the address and secret are generated.",
              "properties": {
                "entropy": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 0.0,
                    "maximum": 255.0
                  },
                  "description": "The entropy to use to generate the seed."
                },
                "algorithm": {
                  "type": "string",
                  "enum": [
                    "ecdsa-secp256k1",
                    "ed25519"
                  ],
                  "description": "The digital signature algorithm to generate an address for. Can be `ecdsa-secp256k1` (default) or `ed25519`."
                }
              }
            },
            {
              "patternProperties": {
                "^entropy$": true,
                "^algorithm$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
