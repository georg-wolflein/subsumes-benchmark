{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "#/$defs/modern_6"
    }
  ],
  "type": "object",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "weekday": {
                  "items": {
                    "type": "integer"
                  },
                  "maxItems": 2,
                  "minItems": 1,
                  "type": "array"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^weekday$": true
              },
              "additionalProperties": {
                "type": "integer"
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "__version": {
                  "exclusiveMinimum": 0.0,
                  "type": "integer"
                },
                "dag": {
                  "$ref": "#/$defs/dag"
                }
              },
              "required": [
                "__version",
                "dag"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^__version$": true,
                "^dag$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/operator"
              }
            }
          ]
        }
      ]
    },
    "timezone": {
      "type": "string"
    },
    "timedelta": {
      "minimum": 0.0,
      "type": "number"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "$comment": "A task/operator in a DAG",
              "properties": {
                "priority_weight": {
                  "type": "number"
                },
                "params": {
                  "$ref": "#/$defs/dict"
                },
                "retry_delay": {
                  "$ref": "#/$defs/timedelta"
                },
                "wait_for_downstream": {
                  "type": "boolean"
                },
                "retry_exponential_backoff": {
                  "type": "boolean"
                },
                "_task_module": {
                  "type": "string"
                },
                "end_date": {
                  "$ref": "#/$defs/datetime"
                },
                "pool": {
                  "type": "string"
                },
                "template_fields": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "trigger_rule": {
                  "type": "string"
                },
                "task_id": {
                  "type": "string"
                },
                "_downstream_task_ids": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "_operator_extra_links": {
                  "$ref": "#/$defs/extra_links"
                },
                "start_date": {
                  "$ref": "#/$defs/datetime"
                },
                "pool_slots": {
                  "type": "number"
                },
                "retries": {
                  "type": "number"
                },
                "queue": {
                  "type": "string"
                },
                "weight_rule": {
                  "type": "string"
                },
                "do_xcom_push": {
                  "type": "boolean"
                },
                "depends_on_past": {
                  "type": "boolean"
                },
                "ui_color": {
                  "$ref": "#/$defs/color"
                },
                "owner": {
                  "type": "string"
                },
                "ui_fgcolor": {
                  "$ref": "#/$defs/color"
                },
                "executor_config": {
                  "$ref": "#/$defs/dict"
                },
                "execution_timeout": {
                  "$ref": "#/$defs/timedelta"
                },
                "_task_type": {
                  "type": "string"
                },
                "subdag": {
                  "$ref": "#/$defs/dag"
                }
              },
              "required": [
                "_task_type",
                "_task_module",
                "task_id",
                "ui_color",
                "ui_fgcolor",
                "template_fields"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^depends_on_past$": true,
                "^execution_timeout$": true,
                "^_task_module$": true,
                "^priority_weight$": true,
                "^retry_delay$": true,
                "^task_id$": true,
                "^retry_exponential_backoff$": true,
                "^pool$": true,
                "^start_date$": true,
                "^_operator_extra_links$": true,
                "^ui_fgcolor$": true,
                "^weight_rule$": true,
                "^wait_for_downstream$": true,
                "^_task_type$": true,
                "^executor_config$": true,
                "^ui_color$": true,
                "^owner$": true,
                "^trigger_rule$": true,
                "^do_xcom_push$": true,
                "^_downstream_task_ids$": true,
                "^params$": true,
                "^subdag$": true,
                "^pool_slots$": true,
                "^queue$": true,
                "^retries$": true,
                "^end_date$": true,
                "^template_fields$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "color": {
      "pattern": "^#[a-fA-F0-9]{3,6}$",
      "type": "string"
    },
    "extra_links": {
      "items": {
        "maxProperties": 1,
        "minProperties": 1,
        "type": "object"
      },
      "type": "array"
    },
    "tasks": {
      "$ref": "#/$defs/modern_1"
    },
    "operator": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "is_subdag": {
                  "type": "boolean"
                },
                "start_date": {
                  "$ref": "#/$defs/datetime"
                },
                "tags": {
                  "type": "array"
                },
                "timezone": {
                  "$ref": "#/$defs/timezone"
                },
                "params": {
                  "$ref": "#/$defs/dict"
                },
                "schedule_interval": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "$ref": "#/$defs/typed_timedelta"
                    },
                    {
                      "$ref": "#/$defs/typed_relativedelta"
                    }
                  ]
                },
                "_dag_id": {
                  "type": "string"
                },
                "default_args": {
                  "$ref": "#/$defs/dict"
                },
                "_default_view": {
                  "type": "string"
                },
                "tasks": {
                  "$ref": "#/$defs/tasks"
                },
                "catchup": {
                  "type": "boolean"
                },
                "dagrun_timeout": {
                  "$ref": "#/$defs/timedelta"
                },
                "is_paused_upon_creation": {
                  "type": "boolean"
                },
                "fileloc": {
                  "type": "string"
                },
                "doc_md": {
                  "type": "string"
                },
                "_concurrency": {
                  "type": "number"
                },
                "end_date": {
                  "$ref": "#/$defs/datetime"
                },
                "orientation": {
                  "type": "string"
                },
                "_description": {
                  "type": "string"
                },
                "_access_control": {
                  "$ref": "#/$defs/dict"
                },
                "max_active_runs": {
                  "type": "number"
                }
              },
              "required": [
                "_dag_id",
                "fileloc",
                "tasks"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^is_subdag$": true,
                "^fileloc$": true,
                "^_description$": true,
                "^catchup$": true,
                "^tasks$": true,
                "^timezone$": true,
                "^params$": true,
                "^_concurrency$": true,
                "^max_active_runs$": true,
                "^dagrun_timeout$": true,
                "^doc_md$": true,
                "^_dag_id$": true,
                "^start_date$": true,
                "^_default_view$": true,
                "^schedule_interval$": true,
                "^orientation$": true,
                "^is_paused_upon_creation$": true,
                "^_access_control$": true,
                "^default_args$": true,
                "^end_date$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "dag": {
      "$ref": "#/$defs/modern_3"
    },
    "typed_timedelta": {
      "$ref": "#/$defs/modern_4"
    },
    "dict": {
      "description": "A python dictionary containing values of any type",
      "type": "object"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "__type": {
                  "const": "timedelta",
                  "type": "string"
                },
                "__var": {
                  "$ref": "#/$defs/timedelta"
                }
              },
              "required": [
                "__type",
                "__var"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^__type$": true,
                "^__var$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "datetime": {
      "description": "A date time, stored as fractional seconds since the epoch",
      "type": "number"
    },
    "typed_relativedelta": {
      "description": "A dateutil.relativedelta.relativedelta object",
      "properties": {
        "__type": {
          "const": "relativedelta",
          "type": "string"
        },
        "__var": {
          "$ref": "#/$defs/modern_5"
        }
      },
      "type": "object"
    }
  }
}
