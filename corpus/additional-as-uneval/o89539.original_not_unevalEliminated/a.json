{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standing instance",
  "type": "object",
  "required": [
    "positions"
  ],
  "properties": {
    "positions": {
      "$ref": "#/$defs/modern_1"
    }
  },
  "patternProperties": {
    "a*": {
      "oneOf": [
        {
          "type": "integer",
          "maximum": 20.0
        },
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "maxLength": 5
        }
      ]
    },
    "aaa*": {
      "type": "integer",
      "maximum": 20.0
    },
    "[0-9]{2,}": {
      "type": "boolean"
    },
    "X_": {
      "type": "string"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Docson is able to visualize it",
              "properties": {
                "id": {
                  "description": "The unique identifier for a product",
                  "type": "number"
                },
                "name": {
                  "type": "string"
                }
              },
              "patternProperties": {
                "a*": {
                  "type": "integer"
                },
                "[0-9]{2,}": {
                  "type": "boolean"
                },
                "[0-9]+": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "aaa*": {
                  "type": "integer",
                  "maximum": 20.0
                },
                "X_": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "a*": true,
                "[0-9]{2,}": true,
                "[0-9]+": true,
                "aaa*": true,
                "^name$": true,
                "^id$": true,
                "X_": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "key"
              ],
              "properties": {
                "key": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
