{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o89639.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "$ref": "#/$defs/modern_1"
      },
      {
        "$ref": "#/$defs/modern_2"
      }
    ],
    "type": "object",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "resource_type": {
                    "enum": [
                      "asset",
                      "file"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "resource_type",
                  "path"
                ]
              },
              {
                "patternProperties": {
                  "^path$": true,
                  "^resource_type$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "family": {
                    "type": "string"
                  },
                  "style": {
                    "type": "string"
                  }
                },
                "required": [
                  "style"
                ]
              },
              {
                "patternProperties": {
                  "^family$": true,
                  "^style$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "resource_type": {
            "enum": [
              "asset",
              "file"
            ],
            "type": "string"
          }
        },
        "required": [
          "resource_type",
          "path"
        ]
      },
      {
        "additionalProperties": false,
        "properties": {
          "family": {
            "type": "string"
          },
          "style": {
            "type": "string"
          }
        },
        "required": [
          "style"
        ]
      }
    ],
    "type": "object"
  }
}
