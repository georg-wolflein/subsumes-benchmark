{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/modern_1"
    },
    {
      "$ref": "#/$defs/modern_2"
    }
  ],
  "type": "object",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "path": {
                  "type": "string"
                },
                "resource_type": {
                  "enum": [
                    "asset",
                    "file"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "resource_type",
                "path"
              ]
            },
            {
              "patternProperties": {
                "^path$": true,
                "^resource_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "family": {
                  "type": "string"
                },
                "style": {
                  "type": "string"
                }
              },
              "required": [
                "style"
              ]
            },
            {
              "patternProperties": {
                "^family$": true,
                "^style$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
