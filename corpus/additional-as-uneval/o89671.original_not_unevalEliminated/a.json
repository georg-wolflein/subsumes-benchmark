{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "envscript": {
                  "default": "",
                  "title": "Env Script",
                  "type": "string"
                },
                "image": {
                  "title": "Image",
                  "type": "string"
                },
                "resources": {
                  "default": [],
                  "title": "Resources",
                  "type": "array"
                },
                "environment_type": {
                  "default": "docker-encapsulated",
                  "enum": [
                    "docker-encapsulated"
                  ],
                  "type": "string"
                },
                "imagetag": {
                  "default": "latest",
                  "title": "Tag",
                  "type": "string"
                },
                "env": {
                  "default": {},
                  "properties": {},
                  "title": "Env Vars",
                  "type": "object"
                }
              },
              "required": [
                "environment_type",
                "image"
              ],
              "title": "Docker Encapsulated Environment",
              "type": "object"
            },
            {
              "patternProperties": {
                "^env$": true,
                "^image$": true,
                "^imagetag$": true,
                "^resources$": true,
                "^envscript$": true,
                "^environment_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
