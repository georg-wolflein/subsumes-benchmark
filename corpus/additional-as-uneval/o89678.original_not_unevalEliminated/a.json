{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "outputmap": {
                  "properties": {
                    "param_card": {
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "publisher_type": {
                  "default": "frompar-pub",
                  "enum": [
                    "frompar-pub"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "publisher_type",
                "outputmap"
              ],
              "title": "Parameter Publisher",
              "type": "object"
            },
            {
              "patternProperties": {
                "^outputmap$": true,
                "^publisher_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
