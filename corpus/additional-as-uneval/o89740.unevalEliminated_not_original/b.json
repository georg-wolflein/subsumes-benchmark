{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.Security",
              "properties": {
                "sdm": {
                  "$ref": "#/$defs/modern_6"
                }
              }
            },
            {
              "patternProperties": {
                "^sdm$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.Sdm",
              "properties": {
                "authorIdentity": {
                  "type": "string"
                },
                "encryptedDigest": {
                  "type": "string"
                }
              },
              "required": [
                "authorIdentity",
                "encryptedDigest"
              ]
            },
            {
              "patternProperties": {
                "^authorIdentity$": true,
                "^encryptedDigest$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.CustomData",
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "array"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              },
              "required": [
                "key",
                "value"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.EiffelSourceChangeCreatedEvent",
              "extendsJavaClass": "com.ericsson.eiffel.semantics.events.Event",
              "properties": {
                "meta": {
                  "$ref": "#/$defs/modern_2"
                },
                "data": {
                  "$ref": "#/$defs/modern_7"
                },
                "links": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_16"
                  }
                }
              },
              "required": [
                "meta",
                "data",
                "links"
              ]
            },
            {
              "patternProperties": {
                "^meta$": true,
                "^data$": true,
                "^links$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.EiffelSourceChangeCreatedEventData",
              "properties": {
                "author": {
                  "$ref": "#/$defs/modern_8"
                },
                "ccCompositeIdentifier": {
                  "$ref": "#/$defs/modern_9"
                },
                "customData": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_10"
                  }
                },
                "change": {
                  "$ref": "#/$defs/modern_11"
                },
                "gitIdentifier": {
                  "$ref": "#/$defs/modern_12"
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_13"
                  }
                },
                "hgIdentifier": {
                  "$ref": "#/$defs/modern_14"
                },
                "svnIdentifier": {
                  "$ref": "#/$defs/modern_15"
                }
              }
            },
            {
              "patternProperties": {
                "^ccCompositeIdentifier$": true,
                "^customData$": true,
                "^change$": true,
                "^issues$": true,
                "^gitIdentifier$": true,
                "^author$": true,
                "^hgIdentifier$": true,
                "^svnIdentifier$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.EiffelSourceChangeCreatedEventMeta",
              "javaInterfaces": [
                "com.ericsson.eiffel.semantics.events.Meta"
              ],
              "properties": {
                "source": {
                  "$ref": "#/$defs/modern_3"
                },
                "security": {
                  "$ref": "#/$defs/modern_5"
                },
                "tags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "version": {
                  "type": "string",
                  "enum": [
                    "1.1.0"
                  ],
                  "default": "1.1.0"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "time": {
                  "type": "integer",
                  "format": "utc-millisec"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "EiffelSourceChangeCreatedEvent"
                  ]
                }
              },
              "required": [
                "id",
                "type",
                "version",
                "time"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^security$": true,
                "^type$": true,
                "^id$": true,
                "^time$": true,
                "^source$": true,
                "^tags$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.GitIdentifier",
              "properties": {
                "commitId": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "repoName": {
                  "type": "string"
                },
                "repoUri": {
                  "type": "string"
                }
              },
              "required": [
                "commitId",
                "repoUri"
              ]
            },
            {
              "patternProperties": {
                "^commitId$": true,
                "^branch$": true,
                "^repoName$": true,
                "^repoUri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.Author",
              "properties": {
                "name": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "group": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^email$": true,
                "^id$": true,
                "^group$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.CcCompositeIdentifier",
              "properties": {
                "vobs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "branch": {
                  "type": "string"
                },
                "configSpec": {
                  "type": "string"
                }
              },
              "required": [
                "vobs",
                "branch",
                "configSpec"
              ]
            },
            {
              "patternProperties": {
                "^vobs$": true,
                "^branch$": true,
                "^configSpec$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "tracker": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "transition": {
                  "type": "string",
                  "enum": [
                    "RESOLVED",
                    "PARTIAL",
                    "REMOVED"
                  ]
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "BUG",
                    "IMPROVEMENT",
                    "FEATURE",
                    "WORK_ITEM",
                    "REQUIREMENT",
                    "OTHER"
                  ]
                }
              },
              "required": [
                "type",
                "tracker",
                "id",
                "uri",
                "transition"
              ]
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^type$": true,
                "^transition$": true,
                "^tracker$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.Source",
              "properties": {
                "name": {
                  "type": "string"
                },
                "host": {
                  "type": "string"
                },
                "uri": {
                  "type": "string"
                },
                "serializer": {
                  "$ref": "#/$defs/modern_4"
                },
                "domainId": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^uri$": true,
                "^host$": true,
                "^name$": true,
                "^domainId$": true,
                "^serializer$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.Change",
              "properties": {
                "tracker": {
                  "type": "string"
                },
                "files": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "details": {
                  "type": "string"
                },
                "insertions": {
                  "type": "integer"
                },
                "deletions": {
                  "type": "integer"
                }
              }
            },
            {
              "patternProperties": {
                "^insertions$": true,
                "^files$": true,
                "^details$": true,
                "^deletions$": true,
                "^tracker$": true,
                "^id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.HgIdentifier",
              "properties": {
                "commitId": {
                  "type": "string"
                },
                "branch": {
                  "type": "string"
                },
                "repoName": {
                  "type": "string"
                },
                "repoUri": {
                  "type": "string"
                }
              },
              "required": [
                "commitId",
                "repoUri"
              ]
            },
            {
              "patternProperties": {
                "^commitId$": true,
                "^branch$": true,
                "^repoName$": true,
                "^repoUri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.Serializer",
              "properties": {
                "groupId": {
                  "type": "string"
                },
                "artifactId": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "groupId",
                "artifactId",
                "version"
              ]
            },
            {
              "patternProperties": {
                "^groupId$": true,
                "^artifactId$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.Link",
              "properties": {
                "type": {
                  "type": "string"
                },
                "target": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "type",
                "target"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^target$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "javaType": "com.ericsson.eiffel.semantics.events.SvnIdentifier",
              "properties": {
                "revision": {
                  "type": "integer"
                },
                "directory": {
                  "type": "string"
                },
                "repoName": {
                  "type": "string"
                },
                "repoUri": {
                  "type": "string"
                }
              },
              "required": [
                "revision",
                "directory",
                "repoUri"
              ]
            },
            {
              "patternProperties": {
                "^revision$": true,
                "^directory$": true,
                "^repoName$": true,
                "^repoUri$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
