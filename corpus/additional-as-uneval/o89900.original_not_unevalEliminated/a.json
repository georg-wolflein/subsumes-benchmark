{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "dictionary": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            },
            {
              "patternProperties": {
                "^dictionary$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[a-zA-Z0-9]{1,10}$": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^[a-zA-Z0-9]{1,10}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
