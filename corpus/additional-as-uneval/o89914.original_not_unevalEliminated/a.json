{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A representation of packages metadata.",
  "type": "object",
  "oneOf": [
    {
      "required": [
        "packages"
      ]
    },
    {
      "required": [
        "providers"
      ]
    },
    {
      "required": [
        "provider-includes",
        "providers-url"
      ]
    }
  ],
  "properties": {
    "providers": {
      "$ref": "#/$defs/modern_3"
    },
    "warning": {
      "type": "string",
      "description": "A message that will be output by Composer as a warning when this source is consulted."
    },
    "notify-batch": {
      "type": "string",
      "description": "Endpoint to call after multiple packages have been installed, e.g. '/downloads/'."
    },
    "provider-includes": {
      "$ref": "#/$defs/modern_4"
    },
    "search": {
      "type": "string",
      "description": "Endpoint that provides search capabilities, e.g. '/search.json?q=%query%&type=%type%'."
    },
    "providers-url": {
      "type": "string",
      "description": "Endpoint to retrieve provider data from, e.g. '/p/%package%$%hash%.json'."
    },
    "packages": {
      "$ref": "#/$defs/modern_5"
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": [
                "object",
                "array"
              ],
              "description": "A hashmap of package names in the form of <vendor>/<name>."
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/versions"
              }
            }
          ]
        }
      ]
    },
    "package": {
      "allOf": [
        {
          "$ref": "#/$defs/package-base"
        },
        {
          "properties": {
            "dist": {
              "type": "object"
            },
            "source": {
              "type": "object"
            }
          }
        },
        {
          "oneOf": [
            {
              "required": [
                "name",
                "version",
                "source"
              ]
            },
            {
              "required": [
                "name",
                "version",
                "dist"
              ]
            }
          ]
        }
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "sha256": {
          "type": "string",
          "description": "Hash value that can be used to validate the resource."
        }
      }
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "A hashmap of versions and their metadata."
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/version"
              }
            }
          ]
        }
      ]
    },
    "versions": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "conflict": {
                  "type": "object"
                },
                "provide": {
                  "type": "object"
                },
                "version_normalized": {
                  "type": "string",
                  "description": "Normalized version, optional but can save computational time on client side."
                },
                "version": {
                  "type": "string"
                },
                "time": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "autoload": {
                  "type": "object"
                },
                "require": {
                  "type": "object"
                },
                "replace": {
                  "type": "object"
                }
              }
            },
            {
              "patternProperties": {
                "^version$": true,
                "^autoload$": true,
                "^require$": true,
                "^conflict$": true,
                "^replace$": true,
                "^name$": true,
                "^type$": true,
                "^version_normalized$": true,
                "^provide$": true,
                "^time$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "package-base": {
      "$ref": "#/$defs/modern_2"
    },
    "metapackage": {
      "allOf": [
        {
          "$ref": "#/$defs/package-base"
        },
        {
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "metapackage"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "type"
          ]
        }
      ]
    },
    "version": {
      "type": "object",
      "oneOf": [
        {
          "$ref": "#/$defs/package"
        },
        {
          "$ref": "#/$defs/metapackage"
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "A hashmap of package names in the form of <vendor>/<name>."
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/provider"
              }
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "A hashmap of provider listings."
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/provider"
              }
            }
          ]
        }
      ]
    }
  }
}
