{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90201.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "featureExpressionInfo",
                "type": "object",
                "description": "An object that defines an expression for per-feature elevation.",
                "properties": {
                  "expression": {
                    "type": "string",
                    "description": "An [Arcade expression](https://developers.arcgis.com/arcade/) evaluating to a number.",
                    "minLength": 1
                  },
                  "title": {
                    "type": "string",
                    "description": "Title of the expression.",
                    "minLength": 1
                  }
                },
                "required": [
                  "expression"
                ],
                "esriDocumentation": {
                  "examples": [
                    {
                      "title": "Zero expression",
                      "description": "Do not use geometry.z values",
                      "code": {
                        "featureExpressionInfo": {
                          "expression": "0"
                        }
                      }
                    },
                    {
                      "title": "Expression with field name",
                      "description": "Elevation from field value without geometry.z",
                      "code": {
                        "featureExpressionInfo": {
                          "expression": "$feature.ELEVATION_FOOT"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "patternProperties": {
                  "^expression$": true,
                  "^title$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "featureExpressionInfo",
    "type": "object",
    "description": "An object that defines an expression for per-feature elevation.",
    "properties": {
      "expression": {
        "type": "string",
        "description": "An [Arcade expression](https://developers.arcgis.com/arcade/) evaluating to a number.",
        "minLength": 1
      },
      "title": {
        "type": "string",
        "description": "Title of the expression.",
        "minLength": 1
      }
    },
    "required": [
      "expression"
    ],
    "additionalProperties": false,
    "esriDocumentation": {
      "examples": [
        {
          "title": "Zero expression",
          "description": "Do not use geometry.z values",
          "code": {
            "featureExpressionInfo": {
              "expression": "0"
            }
          }
        },
        {
          "title": "Expression with field name",
          "description": "Elevation from field value without geometry.z",
          "code": {
            "featureExpressionInfo": {
              "expression": "$feature.ELEVATION_FOOT"
            }
          }
        }
      ]
    }
  }
}
