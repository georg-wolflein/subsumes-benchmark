{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "font",
              "type": "object",
              "description": "Font used for text symbols.",
              "properties": {
                "weight": {
                  "type": "string",
                  "description": "The text weight.",
                  "enum": [
                    "bold",
                    "bolder",
                    "lighter",
                    "normal"
                  ],
                  "default": "normal"
                },
                "size": {
                  "type": "number",
                  "description": "The font size in points. Ignored when font is used on TextSymbol3DLayer."
                },
                "style": {
                  "type": "string",
                  "description": "The text style.",
                  "enum": [
                    "italic",
                    "normal",
                    "oblique"
                  ],
                  "default": "normal"
                },
                "family": {
                  "type": "string",
                  "description": "The font family."
                },
                "decoration": {
                  "type": "string",
                  "description": "The text decoration.",
                  "enum": [
                    "line-through",
                    "none",
                    "underline"
                  ],
                  "default": "none"
                }
              },
              "esriDocumentation": {
                "examples": [
                  {
                    "title": "font",
                    "code": {
                      "font": {
                        "family": "Arial",
                        "size": 12,
                        "style": "normal",
                        "weight": "bold",
                        "decoration": "none"
                      }
                    }
                  }
                ]
              }
            },
            {
              "patternProperties": {
                "^style$": true,
                "^decoration$": true,
                "^family$": true,
                "^weight$": true,
                "^size$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
