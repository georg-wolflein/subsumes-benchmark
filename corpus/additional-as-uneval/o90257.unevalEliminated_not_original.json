{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90257.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "PointCloud Bitfield Filter",
    "type": "object",
    "description": "Filters points based on the value of the specified bitfield attribute.",
    "properties": {
      "field": {
        "type": "string",
        "description": "The name of the field that is used for the filter."
      },
      "requiredClearBits": {
        "type": "array",
        "description": "List ALL bit numbers that must cleared (=0) for the point to be kept. bit 0 is LSB.",
        "items": {
          "type": "number"
        }
      },
      "requiredSetBits": {
        "type": "array",
        "description": " List ALL bit numbers that must set (=1) for the point to be kept. bit 0 is LSB.",
        "items": {
          "type": "number"
        }
      },
      "type": {
        "type": "string",
        "enum": [
          "pointCloudBitfieldFilter"
        ]
      }
    },
    "anyOf": [
      {
        "required": [
          "requiredClearBits"
        ]
      },
      {
        "required": [
          "requiredSetBits"
        ]
      }
    ],
    "required": [
      "field",
      "type"
    ],
    "additionalProperties": false,
    "esriDocumentation": {
      "examples": [
        {
          "title": "PointCloud Bitfield Filter",
          "description": "",
          "code": {
            "filters": [
              {
                "type": "pointCloudBitfieldFilter",
                "field": "USAGE",
                "requiredClearBits": [
                  0
                ],
                "requiredSetBits": [
                  2,
                  3
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "PointCloud Bitfield Filter",
                "type": "object",
                "description": "Filters points based on the value of the specified bitfield attribute.",
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "The name of the field that is used for the filter."
                  },
                  "requiredClearBits": {
                    "type": "array",
                    "description": "List ALL bit numbers that must cleared (=0) for the point to be kept. bit 0 is LSB.",
                    "items": {
                      "type": "number"
                    }
                  },
                  "requiredSetBits": {
                    "type": "array",
                    "description": " List ALL bit numbers that must set (=1) for the point to be kept. bit 0 is LSB.",
                    "items": {
                      "type": "number"
                    }
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "pointCloudBitfieldFilter"
                    ]
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "requiredClearBits"
                    ]
                  },
                  {
                    "required": [
                      "requiredSetBits"
                    ]
                  }
                ],
                "required": [
                  "field",
                  "type"
                ],
                "esriDocumentation": {
                  "examples": [
                    {
                      "title": "PointCloud Bitfield Filter",
                      "description": "",
                      "code": {
                        "filters": [
                          {
                            "type": "pointCloudBitfieldFilter",
                            "field": "USAGE",
                            "requiredClearBits": [
                              0
                            ],
                            "requiredSetBits": [
                              2,
                              3
                            ]
                          }
                        ]
                      }
                    }
                  ]
                }
              },
              {
                "patternProperties": {
                  "^field$": true,
                  "^requiredClearBits$": true,
                  "^requiredSetBits$": true,
                  "^type$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
