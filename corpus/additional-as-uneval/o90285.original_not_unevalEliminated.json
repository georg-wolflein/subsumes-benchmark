  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90285.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Range Information",
                "description": "Range Information.",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "A unique name that can be referenced by webMap.activeRanges."
                  },
                  "field": {
                    "type": "string",
                    "description": "Field name to used for the range."
                  },
                  "currentRangeExtent": {
                    "type": "array",
                    "description": "Contains the min and max values within which the features are visible.",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "fullRangeExtent": {
                    "type": "array",
                    "description": "Contains the min and max values of all the features for this rangeInfo.",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "type": {
                    "type": "string",
                    "description": "Type of range object.",
                    "enum": [
                      "rangeInfo"
                    ]
                  }
                },
                "required": [
                  "field",
                  "name",
                  "type"
                ],
                "esriDocumentation": {
                  "examples": [
                    {
                      "title": "rangeInfo",
                      "schema": "layerDefinition_schema.json",
                      "code": {
                        "layerDefinition": {
                          "rangeInfos": [
                            {
                              "type": "rangeInfo",
                              "name": "floors",
                              "field": "floor",
                              "currentRangeExtent": [
                                -2,
                                10
                              ],
                              "fullRangeExtent": [
                                -2,
                                100
                              ]
                            }
                          ]
                        }
                      }
                    }
                  ]
                }
              },
              {
                "patternProperties": {
                  "^fullRangeExtent$": true,
                  "^name$": true,
                  "^type$": true,
                  "^currentRangeExtent$": true,
                  "^field$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
