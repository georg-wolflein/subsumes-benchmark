{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Range domain specifies a range of valid values for a field.",
              "esriDocumentation": {
                "examples": [
                  {
                    "code": {
                      "domain": {
                        "name": "Measured Length",
                        "range": [
                          1,
                          10000
                        ],
                        "type": "range"
                      }
                    },
                    "title": "rangeDomain"
                  }
                ]
              },
              "properties": {
                "name": {
                  "description": "The domain name.",
                  "type": "string"
                },
                "range": {
                  "description": "The first element is the minValue and the second element is the maxValue.",
                  "items": {
                    "type": "number"
                  },
                  "maxItems": 2,
                  "minItems": 2,
                  "type": "array",
                  "_uniqueItems": true
                },
                "type": {
                  "description": "String value representing the domain type.",
                  "enum": [
                    "range"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "range",
                "type"
              ],
              "title": "rangeDomain",
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true,
                "^range$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
