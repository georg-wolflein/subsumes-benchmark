{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90287.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Range",
    "description": "Range object.",
    "properties": {
      "interactionMode": {
        "type": "string",
        "description": "Indicates the mode in which the active range should be presented to the user.",
        "enum": [
          "picker",
          "slider"
        ]
      },
      "numberOfStops": {
        "type": "number",
        "description": "This is used to generate the activeRangeValues if activeRangeValues are not specified."
      },
      "stopInterval": {
        "type": "number",
        "description": "Interval in which stops should be generated."
      }
    },
    "oneOf": [
      {
        "required": [
          "interactionMode",
          "numberOfStops"
        ]
      },
      {
        "required": [
          "interactionMode",
          "stopInterval"
        ]
      }
    ],
    "additionalProperties": false,
    "esriDocumentation": {
      "examples": [
        {
          "title": "range",
          "code": {
            "range": {
              "interactionMode": "slider",
              "stopInterval": 1
            }
          }
        }
      ]
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Range",
                "description": "Range object.",
                "properties": {
                  "interactionMode": {
                    "type": "string",
                    "description": "Indicates the mode in which the active range should be presented to the user.",
                    "enum": [
                      "picker",
                      "slider"
                    ]
                  },
                  "numberOfStops": {
                    "type": "number",
                    "description": "This is used to generate the activeRangeValues if activeRangeValues are not specified."
                  },
                  "stopInterval": {
                    "type": "number",
                    "description": "Interval in which stops should be generated."
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "interactionMode",
                      "numberOfStops"
                    ]
                  },
                  {
                    "required": [
                      "interactionMode",
                      "stopInterval"
                    ]
                  }
                ],
                "esriDocumentation": {
                  "examples": [
                    {
                      "title": "range",
                      "code": {
                        "range": {
                          "interactionMode": "slider",
                          "stopInterval": 1
                        }
                      }
                    }
                  ]
                }
              },
              {
                "patternProperties": {
                  "^interactionMode$": true,
                  "^numberOfStops$": true,
                  "^stopInterval$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
