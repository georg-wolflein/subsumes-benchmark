{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Range",
              "description": "Range object.",
              "properties": {
                "interactionMode": {
                  "type": "string",
                  "description": "Indicates the mode in which the active range should be presented to the user.",
                  "enum": [
                    "picker",
                    "slider"
                  ]
                },
                "numberOfStops": {
                  "type": "number",
                  "description": "This is used to generate the activeRangeValues if activeRangeValues are not specified."
                },
                "stopInterval": {
                  "type": "number",
                  "description": "Interval in which stops should be generated."
                }
              },
              "oneOf": [
                {
                  "required": [
                    "interactionMode",
                    "numberOfStops"
                  ]
                },
                {
                  "required": [
                    "interactionMode",
                    "stopInterval"
                  ]
                }
              ],
              "esriDocumentation": {
                "examples": [
                  {
                    "title": "range",
                    "code": {
                      "range": {
                        "interactionMode": "slider",
                        "stopInterval": 1
                      }
                    }
                  }
                ]
              }
            },
            {
              "patternProperties": {
                "^interactionMode$": true,
                "^numberOfStops$": true,
                "^stopInterval$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
