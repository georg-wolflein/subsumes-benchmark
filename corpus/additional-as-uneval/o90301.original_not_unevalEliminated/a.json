{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "search layer field",
              "type": "object",
              "description": "Contains information about an attribute field in search layer configuration.",
              "properties": {
                "exactMatch": {
                  "type": "boolean",
                  "description": "A Boolean defining whether or not the field is an exact match."
                },
                "name": {
                  "type": "string",
                  "description": "A string defining the field name."
                },
                "type": {
                  "type": "string",
                  "description": "A string defining the field type.",
                  "enum": [
                    "esriFieldTypeBlob",
                    "esriFieldTypeDate",
                    "esriFieldTypeDouble",
                    "esriFieldTypeGUID",
                    "esriFieldTypeGeometry",
                    "esriFieldTypeGlobalID",
                    "esriFieldTypeInteger",
                    "esriFieldTypeLong",
                    "esriFieldTypeOID",
                    "esriFieldTypeRaster",
                    "esriFieldTypeSingle",
                    "esriFieldTypeSmallInteger",
                    "esriFieldTypeString",
                    "esriFieldTypeXML"
                  ]
                }
              },
              "esriDocumentation": {
                "examples": [
                  {
                    "title": "search layer field",
                    "code": {
                      "field": {
                        "name": "relationships/2/Postcode",
                        "type": "esriFieldTypeString",
                        "exactMatch": true
                      }
                    }
                  }
                ]
              }
            },
            {
              "patternProperties": {
                "^exactMatch$": true,
                "^name$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
