  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90306.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "sizeStop",
    "description": "A `sizeStop` object describes the size of the symbol at various values of the expression.",
    "properties": {
      "label": {
        "type": "string",
        "description": "Value if a label is needed on the legend for a stop."
      },
      "size": {
        "type": "number",
        "description": "Specifies the marker size to use for the specified value."
      },
      "value": {
        "type": "number",
        "description": "The value to be mapped to a size."
      }
    },
    "required": [
      "size",
      "value"
    ],
    "additionalProperties": false,
    "esriDocumentation": {
      "examples": [
        {
          "code": {
            "stop": {
              "value": 0,
              "size": 255
            }
          }
        }
      ]
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "sizeStop",
                "description": "A `sizeStop` object describes the size of the symbol at various values of the expression.",
                "properties": {
                  "label": {
                    "type": "string",
                    "description": "Value if a label is needed on the legend for a stop."
                  },
                  "size": {
                    "type": "number",
                    "description": "Specifies the marker size to use for the specified value."
                  },
                  "value": {
                    "type": "number",
                    "description": "The value to be mapped to a size."
                  }
                },
                "required": [
                  "size",
                  "value"
                ],
                "esriDocumentation": {
                  "examples": [
                    {
                      "code": {
                        "stop": {
                          "value": 0,
                          "size": 255
                        }
                      }
                    }
                  ]
                }
              },
              {
                "patternProperties": {
                  "^label$": true,
                  "^size$": true,
                  "^value$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
