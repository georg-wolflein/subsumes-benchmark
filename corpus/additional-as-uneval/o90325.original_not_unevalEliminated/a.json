{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "title",
              "type": "object",
              "description": "Text for the title of the individual slide.",
              "properties": {
                "text": {
                  "type": "string",
                  "description": "Text to display as slide title."
                }
              },
              "required": [
                "text"
              ],
              "esriDocumentation": {
                "examples": [
                  {
                    "title": "title",
                    "code": {
                      "title": {
                        "text": "Great slide"
                      }
                    }
                  }
                ]
              }
            },
            {
              "patternProperties": {
                "^text$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
