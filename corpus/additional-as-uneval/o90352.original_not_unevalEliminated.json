{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "format",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90352.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "$$target": "awsAclConfig.json",
                "title": "AWS Network Access Control List (ACL) Rule",
                "description": "Describes an AWS network ACL rule. See the VPC [documentation](http://docs.aws.amazon.com/AmazonVPC/latest/UserGuide/VPC_ACLs.html) for more information.",
                "properties": {
                  "cidr_block": {
                    "description": "The cidr to associate this rule to.",
                    "format": "cidr",
                    "type": "string"
                  },
                  "rule_no": {
                    "description": "The number of the rule for ordering.",
                    "type": "number"
                  },
                  "to_port": {
                    "description": "The to port number, 0 for all.",
                    "type": "number"
                  },
                  "from_port": {
                    "description": "The from port number, 0 for all.",
                    "type": "number",
                    "minimum": 0.0,
                    "maximum": 65535.0
                  },
                  "action": {
                    "description": "The action that should be implemented (allow/deny).",
                    "enum": [
                      "allow",
                      "deny"
                    ],
                    "type": "string"
                  },
                  "protocol": {
                    "description": "The protocol for this ACL.",
                    "enum": [
                      "TCP",
                      "UDP",
                      "-1",
                      "ICMP"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "protocol",
                  "rule_no",
                  "action",
                  "cidr_block",
                  "from_port",
                  "to_port"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^action$": true,
                  "^from_port$": true,
                  "^protocol$": true,
                  "^to_port$": true,
                  "^rule_no$": true,
                  "^cidr_block$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://judkins.house/apis/k2/v1/awsAclConfig.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$$target": "awsAclConfig.json",
    "title": "AWS Network Access Control List (ACL) Rule",
    "description": "Describes an AWS network ACL rule. See the VPC [documentation](http://docs.aws.amazon.com/AmazonVPC/latest/UserGuide/VPC_ACLs.html) for more information.",
    "properties": {
      "protocol": {
        "description": "The protocol for this ACL.",
        "enum": [
          "TCP",
          "UDP",
          "-1",
          "ICMP"
        ],
        "type": "string"
      },
      "rule_no": {
        "description": "The number of the rule for ordering.",
        "type": "number"
      },
      "action": {
        "description": "The action that should be implemented (allow/deny).",
        "enum": [
          "allow",
          "deny"
        ],
        "type": "string"
      },
      "cidr_block": {
        "description": "The cidr to associate this rule to.",
        "format": "cidr",
        "type": "string"
      },
      "from_port": {
        "description": "The from port number, 0 for all.",
        "type": "number",
        "minimum": 0,
        "maximum": 65535
      },
      "to_port": {
        "description": "The to port number, 0 for all.",
        "type": "number"
      }
    },
    "required": [
      "protocol",
      "rule_no",
      "action",
      "cidr_block",
      "from_port",
      "to_port"
    ],
    "additionalProperties": false,
    "type": "object"
  }
}
