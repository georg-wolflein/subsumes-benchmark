{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90368.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90368.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "$$target": "bastionConfigSimple.json",
                "title": "A Bastion configuration",
                "description": "Properties pertaining to a Bastion.",
                "properties": {
                  "name": {
                    "description": "Name of the Bastion configuration.",
                    "type": "string"
                  },
                  "kind": {
                    "description": "Type of bastion config",
                    "enum": [
                      "bastion"
                    ],
                    "type": "string"
                  },
                  "listenPort": {
                    "description": "What port number to open for the ssh tunnel, default is 22",
                    "type": "number",
                    "minimum": 0.0,
                    "default": 22,
                    "maximum": 65535.0
                  }
                },
                "required": [
                  "name",
                  "kind"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^kind$": true,
                  "^listenPort$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://judkins.house/apis/k2/v1/bastionConfigSimple.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$$target": "bastionConfigSimple.json",
    "title": "A Bastion configuration",
    "description": "Properties pertaining to a Bastion.",
    "properties": {
      "name": {
        "description": "Name of the Bastion configuration.",
        "type": "string"
      },
      "kind": {
        "description": "Type of bastion config",
        "enum": [
          "bastion"
        ],
        "type": "string"
      },
      "listenPort": {
        "description": "What port number to open for the ssh tunnel, default is 22",
        "type": "number",
        "minimum": 0,
        "default": 22,
        "maximum": 65535
      }
    },
    "required": [
      "name",
      "kind"
    ],
    "additionalProperties": false,
    "type": "object"
  }
}
