    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "$$target": "gkeNodeProviderConfig.json",
                "title": "GKE Provider Node Configuration",
                "description": "Describes GKE specific node configuration.",
                "properties": {
                  "diskSize": {
                    "description": "The amount of disk that should be allocated to the node, in GB.",
                    "type": "number"
                  },
                  "machineType": {
