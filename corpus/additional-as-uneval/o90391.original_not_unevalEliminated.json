{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90391.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "$$target": "helmChart.json",
                "title": "Helm Chart",
                "description": "Configuration for a helm chart for use in K2.",
                "properties": {
                  "registry": {
                    "description": "Registry to pull this chart from - referenced by helm application.",
                    "type": "string"
                  },
                  "version": {
                    "description": "Version of the chart to deploy - referenced by helm application.",
                    "type": "string"
                  },
                  "chart": {
                    "description": "Actual name of chart in the repository - referenced by helm application.",
                    "type": "string"
                  },
                  "repo": {
                    "description": "Repository to pull this chart from - referenced by helm application.",
                    "type": "string"
                  },
                  "namespace": {
                    "description": "Namespace of the chart.",
                    "type": "string"
                  },
                  "name": {
                    "description": "Friendly name for the chart.",
                    "type": "string"
                  },
                  "channel": {
                    "description": "Channel of the chart to deploy - referenced by helm application.",
                    "enum": [
                      "stable",
                      "beta",
                      "alpha"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "chart"
                ],
                "oneOf": [
                  {
                    "required": [
                      "version"
                    ]
                  },
                  {
                    "required": [
                      "channel"
                    ]
                  }
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^chart$": true,
                  "^namespace$": true,
                  "^registry$": true,
                  "^repo$": true,
                  "^name$": true,
                  "^channel$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://judkins.house/apis/k2/v1/helmChart.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$$target": "helmChart.json",
    "title": "Helm Chart",
    "description": "Configuration for a helm chart for use in K2.",
    "properties": {
      "name": {
        "description": "Friendly name for the chart.",
        "type": "string"
      },
      "namespace": {
        "description": "Namespace of the chart.",
        "type": "string"
      },
      "repo": {
        "description": "Repository to pull this chart from - referenced by helm application.",
        "type": "string"
      },
      "registry": {
        "description": "Registry to pull this chart from - referenced by helm application.",
        "type": "string"
      },
      "chart": {
        "description": "Actual name of chart in the repository - referenced by helm application.",
        "type": "string"
      },
      "version": {
        "description": "Version of the chart to deploy - referenced by helm application.",
        "type": "string"
      },
      "channel": {
        "description": "Channel of the chart to deploy - referenced by helm application.",
        "enum": [
          "stable",
          "beta",
          "alpha"
        ],
        "type": "string"
      }
    },
    "required": [
      "name",
      "chart"
    ],
    "oneOf": [
      {
        "required": [
          "version"
        ]
      },
      {
        "required": [
          "channel"
        ]
      }
    ],
    "additionalProperties": false,
    "type": "object"
  }
}
