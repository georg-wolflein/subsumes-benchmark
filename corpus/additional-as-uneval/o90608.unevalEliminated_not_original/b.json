{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "images": {
                  "$ref": "#/$defs/modern_2"
                },
                "assets": {
                  "$ref": "#/$defs/modern_3"
                }
              }
            },
            {
              "patternProperties": {
                "^images$": true,
                "^assets$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "screenshots": {
                  "items": {
                    "type": "string",
                    "description": "PNG screen URL, preferably 1024 by 1024 pixels."
                  },
                  "type": "array"
                },
                "icon-large": {
                  "type": "string",
                  "description": "PNG icon URL, preferably 256 by 256 pixels."
                },
                "icon-small": {
                  "type": "string",
                  "description": "PNG icon URL, preferably 48 by 48 pixels."
                },
                "icon-medium": {
                  "type": "string",
                  "description": "PNG icon URL, preferably 128 by 128 pixels."
                }
              }
            },
            {
              "patternProperties": {
                "^screenshots$": true,
                "^icon-large$": true,
                "^icon-small$": true,
                "^icon-medium$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "container": {
                  "$ref": "#/$defs/modern_4"
                },
                "uris": {
                  "$ref": "#/$defs/modern_6"
                }
              }
            },
            {
              "patternProperties": {
                "^container$": true,
                "^uris$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "docker": {
                  "$ref": "#/$defs/modern_5"
                }
              }
            },
            {
              "patternProperties": {
                "^docker$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
