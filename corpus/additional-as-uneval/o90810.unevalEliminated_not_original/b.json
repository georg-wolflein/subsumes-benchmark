{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "openvpn-admin": {
                  "$ref": "#/$defs/modern_2"
                },
                "service": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "openvpn-admin",
                "service"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^openvpn-admin$": true,
                "^service$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "cpus": {
                  "default": 0.01,
                  "description": "CPU shares to allocate to each openvpn instance.",
                  "minimum": 0.01,
                  "type": "number"
                },
                "instances": {
                  "default": 1,
                  "description": "Number of openvpn instances to run.",
                  "minimum": 1.0,
                  "type": "integer"
                },
                "mem": {
                  "default": 128.0,
                  "description": "Memory (MB) to allocate to each openvpn task.",
                  "minimum": 64.0,
                  "type": "number"
                }
              },
              "required": [
                "cpus",
                "mem",
                "instances"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^cpus$": true,
                "^instances$": true,
                "^mem$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "default": "openvpn-admin",
                  "description": "openvpn service name",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
