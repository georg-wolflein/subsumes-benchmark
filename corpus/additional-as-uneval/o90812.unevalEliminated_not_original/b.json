{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "openvpn": {
                  "properties": {
                    "ovpn_username": {
                      "default": "admin",
                      "description": "OpenVPN REST interface username",
                      "minimum": 1.0,
                      "type": "string"
                    },
                    "instances": {
                      "default": 1,
                      "description": "Number of openvpn instances to run.",
                      "minimum": 1.0,
                      "type": "integer"
                    },
                    "framework-name": {
                      "default": "openvpn",
                      "description": "openvpn framework name",
                      "type": "string"
                    },
                    "admin_port": {
                      "default": 5000,
                      "description": "TCP port to bind to.",
                      "minimum": 1.0,
                      "type": "integer"
                    },
                    "mem": {
                      "default": 128.0,
                      "description": "Memory (MB) to allocate to each openvpn task.",
                      "minimum": 64.0,
                      "type": "number"
                    },
                    "cpus": {
                      "default": 0.01,
                      "description": "CPU shares to allocate to each openvpn instance.",
                      "minimum": 0.01,
                      "type": "number"
                    },
                    "ovpn_password": {
                      "default": "",
                      "description": "OpenVPN REST interface password",
                      "minimum": 1.0,
                      "type": "string"
                    },
                    "server_port": {
                      "default": 1194,
                      "description": "UDP port to bind to.",
                      "minimum": 1.0,
                      "type": "integer"
                    }
                  },
                  "type": "object"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^openvpn$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
