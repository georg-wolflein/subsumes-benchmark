{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "union": {
      "title": "Thrift union definition schema",
      "$ref": "#/$defs/struct"
    },
    "field": {
      "title": "Thrift struct field definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "typeId": {
              "$ref": "#/$defs/type-id"
            },
            "key": {
              "type": "integer",
              "minimum": 1.0,
              "maximum": 65535.0
            },
            "default": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "array"
                },
                {
                  "type": "object"
                }
              ]
            },
            "type": {
              "$ref": "#/$defs/type-desc"
            },
            "required": {
              "enum": [
                "required",
                "optional",
                "req_out"
              ]
            }
          },
          "required": [
            "key",
            "required"
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Map of annotation names to values",
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "exception": {
      "title": "Thrift exception definition schema",
      "type": "object",
      "properties": {
        "key": {
          "type": "integer",
          "minimum": 1.0,
          "maximum": 65535.0
        },
        "name": {
          "type": "string"
        },
        "typeId": {
          "enum": [
            "exception"
          ]
        },
        "type": {
          "$ref": "#/$defs/struct-type"
        }
      },
      "required": [
        "key",
        "name",
        "typeId"
      ]
    },
    "map-type": {
      "title": "Map schema",
      "type": "object",
      "properties": {
        "keyType": {
          "$ref": "#/$defs/type-desc"
        },
        "valueTypeId": {
          "$ref": "#/$defs/type-id"
        },
        "valueType": {
          "$ref": "#/$defs/type-desc"
        },
        "keyTypeId": {
          "$ref": "#/$defs/type-id"
        },
        "typeId": {
          "enum": [
            "map"
          ]
        }
      },
      "required": [
        "typeId",
        "keyTypeId",
        "valueTypeId"
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Schema for Apache Thrift protocol descriptors",
              "type": "object",
              "required": [
                "name",
                "enums",
                "typedefs",
                "structs",
                "constants",
                "services"
              ],
              "properties": {
                "services": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/service"
                  }
                },
                "name": {
                  "type": "string"
                },
                "typedefs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/typedef"
                  }
                },
                "constants": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/constant"
                  }
                },
                "namespaces": {
                  "$ref": "#/$defs/modern_3"
                },
                "enums": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/enum"
                  }
                },
                "structs": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/struct"
                  }
                },
                "includes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^constants$": true,
                "^includes$": true,
                "^typedefs$": true,
                "^name$": true,
                "^services$": true,
                "^structs$": true,
                "^enums$": true,
                "^namespaces$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "service": {
      "title": "Thrift service definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "functions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/function"
              }
            }
          },
          "required": [
            "functions"
          ]
        }
      ]
    },
    "annotations": {
      "$ref": "#/$defs/modern_1"
    },
    "typedef": {
      "title": "Thrift typedef definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "typeId": {
              "$ref": "#/$defs/type-id"
            },
            "type": {
              "$ref": "#/$defs/type-desc"
            }
          },
          "required": [
            "typeId"
          ]
        }
      ]
    },
    "name-and-doc": {
      "title": "Name and documentation sub-schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "type-id": {
      "title": "Any type id (name)",
      "enum": [
        "void",
        "string",
        "bool",
        "byte",
        "i8",
        "i16",
        "i32",
        "i64",
        "double",
        "list",
        "set",
        "map",
        "union",
        "struct",
        "binary"
      ]
    },
    "struct-type": {
      "title": "Struct, union and exception schema",
      "type": "object",
      "properties": {
        "typeId": {
          "enum": [
            "union",
            "struct",
            "exception"
          ]
        }
      },
      "required": [
        "typeId",
        "class"
      ]
    },
    "type-desc": {
      "title": "Type descriptor schema",
      "allOf": [
        {
          "type": "object",
          "properties": {
            "typeId": {
              "type": "string"
            },
            "class": {
              "type": "string"
            }
          }
        },
        {
          "oneOf": [
            {
              "$ref": "#/$defs/base-type"
            },
            {
              "$ref": "#/$defs/list-type"
            },
            {
              "$ref": "#/$defs/map-type"
            },
            {
              "$ref": "#/$defs/struct-type"
            }
          ]
        }
      ]
    },
    "constant": {
      "title": "Thrift constant definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "$ref": "#/$defs/type-desc"
        },
        {
          "properties": {
            "value": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "array"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "value"
          ]
        }
      ]
    },
    "base-type": {
      "title": "Base type schema",
      "type": "object",
      "properties": {
        "typeId": {
          "enum": [
            "void",
            "string",
            "bool",
            "byte",
            "i8",
            "i16",
            "i32",
            "i64",
            "double",
            "binary"
          ]
        }
      },
      "required": [
        "typeId"
      ]
    },
    "enum": {
      "title": "Thrift 'enum' definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/definitions4/name-and-doc"
        },
        {
          "required": [
            "members"
          ],
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "value"
                ]
              }
            }
          }
        }
      ]
    },
    "list-type": {
      "title": "List and set schema",
      "type": "object",
      "properties": {
        "typeId": {
          "enum": [
            "list",
            "set"
          ]
        },
        "elemTypeId": {
          "$ref": "#/$defs/type-id"
        },
        "elemType": {
          "$ref": "#/$defs/type-desc"
        }
      },
      "required": [
        "typeId",
        "elemTypeId"
      ]
    },
    "function": {
      "title": "Thrift service function definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "oneway": {
              "type": "boolean"
            },
            "returnType": {
              "$ref": "#/$defs/type-desc"
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "exceptions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/exception"
              }
            }
          },
          "required": [
            "oneway",
            "arguments",
            "exceptions"
          ]
        }
      ]
    },
    "struct": {
      "title": "Thrift struct definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "isException": {
              "type": "boolean"
            },
            "isUnion": {
              "type": "boolean"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "required": [
            "isException",
            "isUnion",
            "fields"
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    }
  }
}
