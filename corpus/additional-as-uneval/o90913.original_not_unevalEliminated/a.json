{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "reference": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "@id",
                "@type"
              ],
              "properties": {
                "@type": {
                  "type": "string"
                },
                "@id": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^@type$": true,
                "^@id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "SHARE ChangeSet JSONLD",
              "description": "A sub-set of JSONLD",
              "required": [
                "@graph"
              ],
              "properties": {
                "@context": {
                  "type": "object"
                },
                "@graph": {
                  "description": "Used to express a graph.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^@context$": true,
                "^@graph$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "@id",
                "@type"
              ],
              "properties": {
                "extra": {
                  "type": "object"
                },
                "@type": {
                  "type": "string"
                },
                "@id": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^extra$": true,
                "^@type$": true,
                "^@id$": true
              },
              "additionalProperties": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/reference"
                  },
                  {
                    "$ref": "#/$defs/primitives"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/reference"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "primitives": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    }
  }
}
