{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "default": {},
  "properties": {
    "$ref": {
      "format": "uri-reference",
      "type": "string"
    },
    "x-intellij-enum-metadata": {
      "$ref": "#/$defs/modern_1"
    },
    "examples": {
      "items": true,
      "type": "array"
    },
    "additionalItems": {
      "$ref": "#"
    },
    "maxProperties": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "$id": {
      "format": "uri-reference",
      "type": "string"
    },
    "x-intellij-case-insensitive": {
      "description": "If 'true', enum options for this value will be checked case-insensitively",
      "type": "boolean"
    },
    "exclusiveMinimum": {
      "type": "number"
    },
    "x-intellij-language-injection": {
      "description": "IntelliJ language ID for language injection",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "properties": {
            "language": {
              "description": "Language ID. Invoke completion to see all options",
              "type": "string"
            },
            "prefix": {
              "description": "Code fragment that will be appended before the user code",
              "type": "string"
            },
            "suffix": {
              "description": "Code fragment that will be appended after the user code",
              "type": "string"
            }
          },
          "type": "object"
        }
      ]
    },
    "allOf": {
      "$ref": "#/$defs/schemaArray"
    },
    "exclusiveMaximum": {
      "type": "number"
    },
    "format": {
      "type": "string"
    },
    "x-intellij-html-description": {
      "description": "Description in html format",
      "type": "string"
    },
    "pattern": {
      "format": "regex",
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "anyOf": {
      "$ref": "#/$defs/schemaArray"
    },
    "patternProperties": {
      "$ref": "#/$defs/modern_3"
    },
    "items": {
      "anyOf": [
        {
          "$ref": "#"
        },
        {
          "$ref": "#/$defs/schemaArray"
        }
      ],
      "default": {}
    },
    "maxItems": {
      "$ref": "#/$defs/nonNegativeInteger"
    },
    "deprecationMessage": {
      "description": "Non-standard: deprecation message for a property, if it is deprecated",
      "type": "string"
    },
    "maximum": {
      "type": "number"
    },
    "multipleOf": {
      "exclusiveMinimum": 0.0,
      "type": "number"
    },
    "const": true,
    "properties": {
      "$ref": "#/$defs/modern_4"
    },
    "enum": {
      "minItems": 1,
      "type": "array",
      "_uniqueItems": true
    },
    "additionalProperties": {
      "$ref": "#"
    },
    "default": true,
    "minItems": {
      "$ref": "#/$defs/nonNegativeIntegerDefault0"
    },
    "not": {
      "$ref": "#"
    },
    "definitions4": {
      "$ref": "#/$defs/modern_5"
    },
    "minLength": {
      "$ref": "#/$defs/nonNegativeIntegerDefault0"
    },
    "title": {
      "type": "string"
    },
    "minimum": {
      "type": "number"
    },
    "type": {
      "anyOf": [
        {
          "$ref": "#/$defs/simpleTypes"
        },
        {
          "items": {
            "$ref": "#/$defs/simpleTypes"
          },
          "minItems": 1,
          "type": "array",
          "_uniqueItems": true
        }
      ]
    },
    "required": {
      "$ref": "#/$defs/stringArray"
    },
    "contains": {
      "$ref": "#"
    },
    "_uniqueItems": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "format": "uri",
      "type": "string"
    },
    "oneOf": {
      "$ref": "#/$defs/schemaArray"
    },
    "minProperties": {
      "$ref": "#/$defs/nonNegativeIntegerDefault0"
    },
    "propertyNames": {
      "$ref": "#"
    },
    "dependencies": {
      "$ref": "#/$defs/modern_6"
    },
    "maxLength": {
      "$ref": "#/$defs/nonNegativeInteger"
    }
  },
  "title": "Core schema meta-schema",
  "type": [
    "object",
    "boolean"
  ],
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": {},
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#"
              }
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#"
                  },
                  {
                    "$ref": "#/$defs/stringArray"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Provides description and deprecation data for enum values",
              "type": "object"
            },
            {
              "additionalProperties": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/modern_2"
                  }
                ]
              }
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "deprecationMessage": {
                  "description": "Deprecation message for an enum value",
                  "type": "string"
                },
                "description": {
                  "description": "Description for an enum value",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^deprecationMessage$": true,
                "^description$": true
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          ]
        }
      ]
    },
    "stringArray": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "schemaArray": {
      "items": {
        "$ref": "#"
      },
      "minItems": 1,
      "type": "array"
    },
    "nonNegativeInteger": {
      "minimum": 0.0,
      "type": "integer"
    },
    "nonNegativeIntegerDefault0": {
      "allOf": [
        {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        {
          "default": 0
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": {},
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#"
              }
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "default": {},
              "type": "object"
            },
            {
              "additionalProperties": {
                "$ref": "#"
              }
            }
          ]
        }
      ]
    },
    "simpleTypes": {
      "enum": [
        "array",
        "boolean",
        "integer",
        "null",
        "number",
        "object",
        "string"
      ]
    }
  }
}
