{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_5",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "fields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/dataElement"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^fields$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "tag": {
                  "type": "string",
                  "minLength": 2
                }
              }
            },
            {
              "patternProperties": {
                "^tag$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "usage": {
      "$ref": "#/$defs/modern_4"
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "type"
              ],
              "oneOf": [
                {
                  "properties": {
                    "type": {
                      "enum": [
                        "value1"
                      ]
                    }
                  },
                  "required": [
                    "dataSets"
                  ]
                },
                {
                  "properties": {
                    "type": {
                      "enum": [
                        "value2"
                      ]
                    }
                  },
                  "required": [
                    "subFields"
                  ]
                }
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "value2",
                    "value1"
                  ]
                },
                "dataSets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "code",
                      "subFields"
                    ],
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "subFields": {
                        "type": "array",
                        "items": {
                          "$ref": "#/$defs/subField"
                        }
                      }
                    }
                  }
                },
                "subFields": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/subField"
                  }
                }
              },
              "dependentSchemas": {
                "dataSets": {
                  "properties": {
                    "type": {
                      "enum": [
                        "value1"
                      ]
                    }
                  }
                },
                "subFields": {
                  "properties": {
                    "type": {
                      "enum": [
                        "value2"
                      ]
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^dataSets$": true,
                "^subFields$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "oneOf": [
                {
                  "required": [
                    "code",
                    "defaultUsage",
                    "usages",
                    "name"
                  ]
                },
                {
                  "allOf": [
                    {
                      "not": {
                        "required": [
                          "usages"
                        ]
                      }
                    },
                    {
                      "required": [
                        "code",
                        "format",
                        "name"
                      ]
                    }
                  ]
                }
              ],
              "properties": {
                "format": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "usages": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/usage"
                  }
                },
                "code": {
                  "type": "integer"
                },
                "defaultUsage": {
                  "type": "string"
                },
                "complexType": {
                  "$ref": "#/$defs/complexType"
                }
              }
            },
            {
              "patternProperties": {
                "^code$": true,
                "^usages$": true,
                "^format$": true,
                "^defaultUsage$": true,
                "^name$": true,
                "^complexType$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "dataElement": {
      "$ref": "#/$defs/modern_3"
    },
    "subField": {
      "$ref": "#/$defs/modern_1"
    },
    "complexType": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [
                "name",
                "field"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "field": {
                  "$ref": "#/$defs/dataElement"
                }
              }
            },
            {
              "patternProperties": {
                "^name$": true,
                "^field$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
