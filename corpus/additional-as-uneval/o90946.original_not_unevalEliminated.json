{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "const",
    "oneOf",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90946.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90946.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "subject": {
        "oneOf": [
          {
            "$ref": "#/$defs/first"
          },
          {
            "$ref": "#/$defs/second"
          }
        ]
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "discriminator": {
                    "const": "first"
                  },
                  "first": {
                    "type": "boolean"
                  }
                }
              },
              {
                "patternProperties": {
                  "^discriminator$": true,
                  "^first$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "discriminator": {
                    "const": "second"
                  },
                  "second": {
                    "type": "boolean"
                  }
                }
              },
              {
                "patternProperties": {
                  "^discriminator$": true,
                  "^second$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "second": {
        "$ref": "#/$defs/modern_2"
      },
      "first": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "subject": {
        "oneOf": [
          {
            "$ref": "#/$defs/first"
          },
          {
            "$ref": "#/$defs/second"
          }
        ]
      }
    },
    "$defs": {
      "first": {
        "type": "object",
        "properties": {
          "discriminator": {
            "const": "first"
          },
          "first": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "second": {
        "type": "object",
        "properties": {
          "discriminator": {
            "const": "second"
          },
          "second": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
