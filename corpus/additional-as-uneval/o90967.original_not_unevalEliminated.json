                  "type",
                  "building"
                ]
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^building$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "office_address": {
        "$ref": "#/$defs/modern_2"
      },
      "partTwo": {
        "properties": {
          "two": {
            "type": "integer"
          }
        }
      },
      "partOne": {
        "properties": {
          "one": {
            "type": "string"
          }
        }
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/partOne"
                  },
                  {
                    "not": {
                      "$ref": "#/$defs/partTwo"
                    }
                  }
                ]
              },
              {
                "patternProperties": {
                  "^one$": true
                },
                "additionalProperties": false
              }
            ]
          },
          {
            "allOf": [
              {
                "allOf": [
                  {
                    "not": {
                      "$ref": "#/$defs/partOne"
                    }
                  },
                  {
                    "$ref": "#/$defs/partTwo"
                  }
                ]
              },
              {
                "patternProperties": {
                  "^two$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "address": {
        "type": "object",
        "properties": {
          "street_address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "street_address",
          "city",
          "state"
        ]
      }
    }
  },
  "b": {
