{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90969.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "JSON schema for Prisma prisma.yml files",
    "properties": {
      "subscriptions": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "All server-side subscriptions",
                "type": "object"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/subscription"
                }
              }
            ]
          }
        ]
      },
      "subscription": {
        "description": "A piece of code that you should run."
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "JSON schema for Prisma prisma.yml files",
    "properties": {
      "subscriptions": {
        "description": "All server-side subscriptions",
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/subscription"
        }
      }
    },
    "$defs": {
      "subscription": {
        "description": "A piece of code that you should run."
      }
    }
  }
}
