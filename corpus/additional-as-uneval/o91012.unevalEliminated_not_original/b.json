{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "format": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "info": {
                  "type": "object"
                },
                "order": {
                  "enum": [
                    "asc",
                    "desc"
                  ],
                  "type": "string"
                },
                "missing_value": {
                  "title": "Missing value",
                  "type": [
                    "string",
                    "number",
                    "null",
                    "boolean"
                  ]
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^order$": true,
                "^description$": true,
                "^format$": true,
                "^label$": true,
                "^name$": true,
                "^info$": true,
                "^missing_value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "mappings": {
                  "type": "object"
                },
                "description": {
                  "type": "string"
                },
                "measures": {
                  "items": {
                    "anyof": [
                      {
                        "type": "string"
                      },
                      {
                        "additionalproperties": false,
                        "allof": [
                          {
                            "$ref": "#/$defs/attribute_base"
                          },
                          {
                            "properties": {
                              "aggregates": {
                                "type": "array"
                              },
                              "expression": {
                                "type": "string"
                              },
                              "nonadditive": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "type": "array"
                },
                "store": {
                  "type": "string"
                },
                "info": {
                  "type": "object"
                },
                "key": {
                  "type": "string"
                },
                "fact": {
                  "type": "string"
                },
                "browser_options": {
                  "type": "object"
                },
                "implicit_aggregates": {
                  "type": "boolean"
                },
                "hierarchies": {
                  "patternProperties": {
                    ".*": {
                      "items": {
                        "title": "Hierarchy",
                        "type": "string"
                      },
                      "type": "array"
                    }
                  },
                  "type": "object"
                },
                "name": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "aggregates": {
                  "items": {
                    "anyof": [
                      {
                        "type": "string"
                      },
                      {
                        "additionalproperties": false,
                        "allof": [
                          {
                            "$ref": "#/$defs/attribute_base"
                          },
                          {
                            "properties": {
                              "expression": {
                                "type": "string"
                              },
                              "formula": {
                                "type": "string"
                              },
                              "function": {
                                "type": "string"
                              },
                              "measure": {
                                "type": "string"
                              },
                              "nonadditive": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "type": "array"
                },
                "dimensions": {
                  "items": {
                    "title": "Dimension name",
                    "type": [
                      "string",
                      "object"
                    ]
                  },
                  "title": "Dimensions",
                  "type": "array"
                },
                "details": {
                  "items": {
                    "anyof": [
                      {
                        "type": "string"
                      },
                      {
                        "additionalproperties": false,
                        "allof": [
                          {
                            "$ref": "#/$defs/attribute_base"
                          },
                          {
                            "properties": {
                              "locales": {
                                "items": {
                                  "type": "string"
                                },
                                "type": "array"
                              }
                            }
                          }
                        ]
                      }
                    ]
                  },
                  "title": "Detail Attributes",
                  "type": "array"
                },
                "joins": {
                  "type": "array"
                },
                "category": {
                  "type": "string"
                }
              },
              "required": [
                "name"
              ],
              "title": "Cube",
              "type": "object"
            },
            {
              "patternProperties": {
                "^implicit_aggregates$": true,
                "^hierarchies$": true,
                "^mappings$": true,
                "^description$": true,
                "^store$": true,
                "^info$": true,
                "^details$": true,
                "^category$": true,
                "^aggregates$": true,
                "^fact$": true,
                "^dimensions$": true,
                "^measures$": true,
                "^label$": true,
                "^browser_options$": true,
                "^name$": true,
                "^key$": true,
                "^joins$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "attribute_base": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
