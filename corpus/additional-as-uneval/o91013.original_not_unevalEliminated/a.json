                },
                "label": {
                  "type": "string"
                },
                "info": {
                  "type": "object"
                },
                "attributes": {
                  "items": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "$ref": "#/$defs/attribute"
                      }
                    ]
                  },
                  "type": "array"
                }
              },
              "required": [
                "name"
              ],
              "title": "Dimension",
              "type": "object"
            },
            {
              "patternProperties": {
                "^order_attribute$": true,
                "^description$": true,
                "^attributes$": true,
                "^role$": true,
                "^info$": true,
                "^nonadditive$": true,
                "^label$": true,
                "^name$": true,
                "^levels$": true,
                "^key$": true,
                "^cardinality$": true,
                "^hierarchies$": true,
                "^template$": true,
                "^label_attribute$": true,
                "^default_hierarchy_name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
