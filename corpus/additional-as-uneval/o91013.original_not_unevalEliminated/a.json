{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_2",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "format": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "info": {
                  "type": "object"
                },
                "order": {
                  "enum": [
                    "asc",
                    "desc"
                  ],
                  "type": "string"
                },
                "missing_value": {
                  "title": "Missing value",
                  "type": [
                    "string",
                    "number",
                    "null",
                    "boolean"
                  ]
                },
                "locales": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "required": [
                "name"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^locales$": true,
                "^order$": true,
                "^description$": true,
                "^format$": true,
                "^label$": true,
                "^name$": true,
                "^info$": true,
                "^missing_value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "role": {
                  "type": "string"
                },
                "levels": {
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "type": "array"
                },
                "default_hierarchy_name": {
                  "title": "Default Hierarchy Name",
                  "type": "string"
                },
                "nonadditive": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                },
                "order_attribute": {
                  "type": "string"
                },
                "template": {
                  "type": "string"
                },
