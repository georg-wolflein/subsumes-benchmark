            {
              "patternProperties": {
                "^order_attribute$": true,
                "^order$": true,
                "^description$": true,
                "^attributes$": true,
                "^role$": true,
                "^info$": true,
                "^label$": true,
                "^name$": true,
                "^key$": true,
                "^label_attribute$": true,
                "^cardinality$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "attribute": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "name": {
                  "type": "string"
                },
                "levels": {
                  "items": {
                    "title": "Level",
                    "type": "string"
                  },
                  "type": "array"
                },
                "description": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "info": {
                  "type": "object"
                }
              },
              "required": [
                "name"
              ],
              "title": "Hierarchy",
              "type": "object"
            },
            {
              "patternProperties": {
                "^description$": true,
                "^info$": true,
                "^label$": true,
                "^name$": true,
                "^levels$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
