{
  "$id": "http://zenodo.org/schemas/records/base-v1.0.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zenodo Base Record Schema v1.0.0",
  "type": "object",
  "properties": {
    "locations": {
      "description": "Geographical location.",
      "items": {
        "properties": {
          "lat": {
            "description": "Latitude of the location.",
            "type": "number"
          },
          "lon": {
            "description": "Longitude of the location.",
            "type": "number"
          },
          "place": {
            "description": "Description of the location",
            "type": "string"
          },
          "description": {
            "description": "Place of the location",
            "type": "string"
          }
        },
        "required": [
          "place"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "method": {
      "description": "Information about the used Method",
      "type": "string"
    },
    "thesis": {
      "$ref": "#/$defs/modern_3"
    },
    "custom": {
      "$ref": "#/$defs/modern_4"
    },
    "access_conditions": {
      "title": "Access conditions",
      "description": "Conditions under which access is given if record is restricted.",
      "type": "string"
    },
    "journal": {
      "$ref": "#/$defs/modern_6"
    },
    "owners": {
      "description": "List of user ids that are record as owner of record.",
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "version": {
      "description": "Record version tag.",
      "type": "string"
    },
    "language": {
      "description": "ISO 639-3 language code.",
      "type": "string"
    },
    "dates": {
      "description": "Date interval.",
      "items": {
        "$ref": "#/$defs/modern_7"
      },
      "type": "array"
    },
    "keywords": {
      "title": "Keywords",
      "description": "Free text keywords.",
      "type": "array",
      "items": {
        "title": "Keyword",
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    },
    "grants": {
      "description": "Source of grants/awards which have funded all or part of this particular record.",
      "type": "array",
      "items": {
        "title": "Grant",
        "type": "object"
      }
    },
    "meeting": {
      "description": "Associated meeting.",
      "type": "object",
      "properties": {
        "acronym": {
          "title": "Acronym",
          "type": "string"
        },
        "session_part": {
          "title": "Part of session",
          "type": "string"
        },
        "url": {
          "title": "URL",
          "type": "string"
        },
        "dates": {
          "title": "Dates",
          "type": "string"
        },
        "session": {
          "title": "Session",
          "type": "string"
        },
        "place": {
          "title": "Place",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      }
    },
    "subjects": {
      "description": "Subjects from specific vocabularies.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_8"
      }
    },
    "description": {
      "description": "Description/abstract for record.",
      "type": "string"
    },
    "resource_type": {
      "$ref": "#/$defs/modern_9"
    },
    "_internal": {
      "$ref": "#/$defs/modern_10"
    },
    "related_identifiers": {
      "description": "Related research outputs.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "identifier": {
            "description": "Identifier of research output.",
            "type": "string"
          },
          "relation": {
            "$ref": "#/$defs/relation"
          },
          "scheme": {
            "$ref": "#/$defs/scheme"
          },
          "resource_type": {
            "$ref": "#/$defs/modern_14"
          }
        },
        "required": [
          "identifier",
          "relation",
          "scheme"
        ]
      }
    },
    "access_right": {
      "description": "Access right for record.",
      "type": "string",
      "default": "open",
      "enum": [
        "open",
        "embargoed",
        "restricted",
        "closed"
      ]
    },
    "conceptrecid": {
      "description": "Invenio record identifier (integer).",
      "type": "string"
    },
    "alternate_identifiers": {
      "description": "Alternate identifiers for record.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_15"
      }
    },
    "conceptdoi": {
      "description": "Digital Object Identifier (DOI).",
      "type": "string"
    },
    "license": {
      "title": "License",
      "description": "License for embargoed/open access content.",
      "type": "object"
    },
    "references": {
      "description": "Raw textual references when identifier is not known.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/modern_17"
      }
    },
    "_oai": {
      "$ref": "#/$defs/modern_18"
    },
    "embargo_date": {
      "title": "Embargo Date",
      "description": "Embargo date of record (ISO8601 formatted date).",
      "type": "string"
    },
    "publication_date": {
      "description": "Record publication date (IS8601-formatted). EDTF support to be added for field.",
      "type": "string"
    },
    "communities": {
      "description": "List of community identifiers.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "title": "Additional notes",
      "description": "Additional notes for record.",
      "type": "string"
    },
    "title": {
      "description": "Record title.",
      "type": "string"
    },
    "imprint": {
      "$ref": "#/$defs/modern_19"
    },
    "doi": {
      "description": "Digital Object Identifier (DOI).",
      "type": "string"
    },
    "contributors": {
      "title": "Contributors",
      "description": "Contributors in order of importance.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/contributor_person_or_org"
      }
    },
    "part_of": {
      "$ref": "#/$defs/modern_20"
    },
    "creators": {
      "description": "Creators of record in order of importance.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/person_or_org"
      }
    },
    "recid": {
      "description": "Invenio record identifier (integer).",
      "type": "number"
    }
  },
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "subject": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "object": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^subject$": true,
                "^object$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Journal in which this record is published.",
              "type": "object",
              "properties": {
                "pages": {
                  "title": "Journal page(s)",
                  "description": "Journal page(s).",
                  "type": "string"
                },
                "year": {
                  "title": "Journal year",
                  "description": "Journal year.",
                  "type": "string"
                },
                "issue": {
                  "title": "Journal issue",
                  "description": "Journal issue.",
                  "type": "string"
                },
                "title": {
                  "title": "Journal title",
                  "description": "Journal title.",
                  "type": "string"
                },
                "volume": {
                  "title": "Journal volume",
                  "description": "Journal volume.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^year$": true,
                "^pages$": true,
                "^title$": true,
                "^issue$": true,
                "^volume$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Metadata for internal use only.",
              "type": "object",
              "properties": {
                "comments": {
                  "description": "Comments for internal purposes.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_11"
                  }
                },
                "source": {
                  "$ref": "#/$defs/modern_12"
                }
              }
            },
            {
              "patternProperties": {
                "^comments$": true,
                "^source$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "relation": {
      "description": "Relation type.",
      "type": "string",
      "enum": [
        "isCitedBy",
        "cites",
        "isSupplementTo",
        "isSupplementedBy",
        "isContinuedBy",
        "continues",
        "hasMetadata",
        "isMetadataFor",
        "isNewVersionOf",
        "isPreviousVersionOf",
        "isPartOf",
        "hasPart",
        "isReferencedBy",
        "references",
        "isDocumentedBy",
        "documents",
        "isCompiledBy",
        "compiles",
        "isVariantFormOf",
        "isOrignialFormOf",
        "isIdenticalTo",
        "isReviewedBy",
        "reviews",
        "isDerivedFrom",
        "isSourceOf"
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Full name of person or organisation. Personal name format: family, given.",
                  "type": "string"
                },
                "affiliation": {
                  "description": "Affiliation for the purpose of this specific record.",
                  "type": "string"
                },
                "gnd": {
                  "description": "Gemeinsame Normdatei identifier for creator.",
                  "type": "string"
                },
                "givennames": {
                  "description": "Given names of person if known.",
                  "type": "string"
                },
                "familyname": {
                  "description": "Family name of person if known.",
                  "type": "string"
                },
                "orcid": {
                  "description": "ORCID identifier for creator.",
                  "type": "string"
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^gnd$": true,
                "^givennames$": true,
                "^name$": true,
                "^familyname$": true,
                "^orcid$": true,
                "^affiliation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "start": {
                  "description": "Start date.",
                  "type": "string"
                },
                "end": {
                  "description": "End date.",
                  "type": "string"
                },
                "type": {
                  "description": "Type of the date interval.",
                  "enum": [
                    "Collected",
                    "Valid",
                    "Withdrawn"
                  ]
                },
                "description": {
                  "description": "Description of the date interval.",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^start$": true,
                "^end$": true,
                "^type$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_20": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "For parts of books and reports.",
              "type": "object",
              "properties": {
                "title": {
                  "title": "Title",
                  "type": "string"
                },
                "pages": {
                  "title": "Pages",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^title$": true,
                "^pages$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_12": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Information related to initial source of acquisition.",
              "type": "object",
              "properties": {
                "legacy_deposit_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_13"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^legacy_deposit_id$": true,
                "^agents$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "person_or_org": {
      "$ref": "#/$defs/modern_1"
    },
    "scheme": {
      "description": "Persistent identifier scheme.",
      "type": "string",
      "enum": [
        "ads",
        "ark",
        "arxiv",
        "bioproject",
        "biosample",
        "doi",
        "ean13",
        "ean8",
        "ensembl",
        "genome",
        "gnd",
        "hal",
        "handle",
        "isbn",
        "isni",
        "issn",
        "istc",
        "lsid",
        "orcid",
        "pmcid",
        "pmid",
        "purl",
        "refseq",
        "sra",
        "uniprot",
        "url",
        "urn",
        "swh",
        "ascl"
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Record resource type.",
              "type": "object",
              "properties": {
                "type": {
                  "description": "General resource type.",
                  "default": "publication",
                  "type": "string"
                },
                "subtype": {
                  "description": "Specific resource type.",
                  "type": "string"
                },
                "openaire_subtype": {
                  "description": "OpenAIRE-specific resource type.",
                  "type": "string"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^subtype$": true,
                "^openaire_subtype$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "university": {
                  "description": "Awarding university in case of a thesis.",
                  "type": "string"
                },
                "supervisors": {
                  "description": "Supervisors of thesis in order of importance.",
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/person_or_org"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^university$": true,
                "^supervisors$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_11": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "timestamp": {
                  "description": "ISO8601 formatted date time stamp.",
                  "type": "string"
                },
                "user_id": {
                  "description": "User making the comment.",
                  "type": "string"
                },
                "comment": {
                  "description": "Comment.",
                  "type": "string"
                }
              },
              "required": [
                "timestamp",
                "user_id",
                "comment"
              ]
            },
            {
              "patternProperties": {
                "^timestamp$": true,
                "^user_id$": true,
                "^comment$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_14": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Record resource type.",
              "properties": {
                "subtype": {
                  "description": "Specific resource type.",
                  "type": "string"
                },
                "type": {
                  "default": "publication",
                  "description": "General resource type.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^subtype$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_16": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Record resource type.",
              "properties": {
                "subtype": {
                  "description": "Specific resource type.",
                  "type": "string"
                },
                "type": {
                  "default": "publication",
                  "description": "General resource type.",
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^subtype$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_15": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "identifier": {
                  "description": "Identifier of research output.",
                  "type": "string"
                },
                "scheme": {
                  "$ref": "#/$defs/scheme"
                },
                "resource_type": {
                  "$ref": "#/$defs/modern_16"
                }
              },
              "required": [
                "identifier",
                "scheme"
              ]
            },
            {
              "patternProperties": {
                "^identifier$": true,
                "^scheme$": true,
                "^resource_type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_17": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Reference",
              "type": "object",
              "properties": {
                "raw_reference": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^raw_reference$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "description": "Full name of person or organisation. Personal name format: family, given.",
                  "type": "string"
                },
                "affiliation": {
                  "description": "Affiliation for the purpose of this specific record.",
                  "type": "string"
                },
                "gnd": {
                  "description": "Gemeinsame Normdatei identifier for creator.",
                  "type": "string"
                },
                "givennames": {
                  "description": "Given names of person if known.",
                  "type": "string"
                },
                "familyname": {
                  "description": "Family name of person if known.",
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "ContactPerson",
                    "DataCollector",
                    "DataCurator",
                    "DataManager",
                    "Distributor",
                    "Editor",
                    "HostingInstitution",
                    "Other",
                    "Producer",
                    "ProjectLeader",
                    "ProjectManager",
                    "ProjectMember",
                    "RegistrationAgency",
                    "RegistrationAuthority",
                    "RelatedPerson",
                    "Researcher",
                    "ResearchGroup",
                    "RightsHolder",
                    "Sponsor",
                    "Supervisor",
                    "WorkPackageLeader"
                  ]
                },
                "orcid": {
                  "description": "ORCID identifier for creator.",
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^gnd$": true,
                "^givennames$": true,
                "^name$": true,
                "^type$": true,
                "^familyname$": true,
                "^orcid$": true,
                "^affiliation$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "contributor_person_or_org": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "term": {
                  "description": "Subject term value.",
                  "type": "string"
                },
                "identifier": {
                  "description": "Subjects term identifier.",
                  "type": "string"
                },
                "scheme": {
                  "description": "Identifier scheme.",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^term$": true,
                "^identifier$": true,
                "^scheme$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_18": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "OAI-PMH specific information.",
              "type": "object",
              "properties": {
                "id": {
                  "description": "OAI-PMH record identifier.",
                  "type": "string"
                },
                "sets": {
                  "description": "OAI-PMH sets for record.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "updated": {
                  "description": "Last OAI-PMH set update (ISO8601 formatted timestamp)",
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^sets$": true,
                "^updated$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_13": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "username": {
                  "type": "string"
                },
                "user_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "email": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "uploader"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^username$": true,
                "^role$": true,
                "^name$": true,
                "^email$": true,
                "^user_id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_19": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "publisher": {
                  "type": "string"
                },
                "place": {
                  "type": "string"
                },
                "isbn": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^publisher$": true,
                "^place$": true,
                "^isbn$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "description": "Custom metadata"
            },
            {
              "additionalProperties": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "$ref": "#/$defs/modern_5"
                    }
                  ]
                }
              }
            }
          ]
        }
      ]
    }
  }
}
