{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "title": "Zenodo SIPStore Agent Web Client Schema v1.0.0.",
              "description": "User agent information making the SIP.",
              "properties": {
                "$schema": {
                  "type": "string"
                },
                "email": {
                  "type": "string"
                },
                "ip_address": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^$schema$": true,
                "^email$": true,
                "^ip_address$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
