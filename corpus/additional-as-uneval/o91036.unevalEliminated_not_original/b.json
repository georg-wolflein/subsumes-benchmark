{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "id": {
                  "type": "string"
                },
                "signing-key": {
                  "$ref": "#/$defs/modern_2"
                },
                "verifying-key": {
                  "$ref": "#/$defs/modern_3"
                }
              },
              "required": [
                "id"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^id$": true,
                "^signing-key$": true,
                "^verifying-key$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "data": {
                  "type": "string"
                },
                "encoding": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "data",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^data$": true,
                "^encoding$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "data": {
                  "type": "string"
                },
                "encoding": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              },
              "required": [
                "data",
                "type"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^data$": true,
                "^encoding$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
