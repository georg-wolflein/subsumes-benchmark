{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "body": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "body",
                "title"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^body$": true,
                "^id$": true,
                "^title$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
