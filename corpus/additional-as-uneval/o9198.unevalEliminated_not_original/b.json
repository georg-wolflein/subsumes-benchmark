{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "The chunk processor description.",
              "type": "object",
              "required": [
                "keyHashFields",
                "keyHashName"
              ],
              "properties": {
                "keyHashName": {
                  "type": "string"
                },
                "scopeHashFields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "multiRowFields": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "contentHashName": {
                  "type": "string"
                },
                "keyHashFields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                },
                "checks": {
                  "double_rows_same": {
                    "$ref": "#/$defs/severity"
                  },
                  "double_rows_different": {
                    "$ref": "#/$defs/severity"
                  }
                },
                "scopeHashName": {
                  "type": "string"
                },
                "contentHashFields": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  },
                  "_uniqueItems": true
                }
              }
            },
            {
              "patternProperties": {
                "^scopeHashName$": true,
                "^checks$": true,
                "^multiRowFields$": true,
                "^keyHashName$": true,
                "^keyHashFields$": true,
                "^contentHashName$": true,
                "^contentHashFields$": true,
                "^scopeHashFields$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "abort_file",
        "abort_scope",
        "skip_record",
        "skip_field"
      ]
    }
  }
}
