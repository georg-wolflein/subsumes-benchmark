{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9385.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "name",
      "description"
    ],
    "properties": {
      "name": {
        "type": "string",
        "description": "The name of the control."
      },
      "description": {
        "type": "string",
        "description": "A short description of the purpose of this control."
      },
      "integration": {
        "type": "object",
        "description": "How this control should be loaded by the LaxarJS runtime.",
        "properties": {
          "technology": {
            "type": "string",
            "description": "Underlying technology of the control, which will be used to load the controller and template.",
            "default": "plain"
          }
        },
        "default": {},
        "additionalProperties": false
      },
      "controls": {
        "type": "array",
        "description": "Each control as a path that can be resolved using the module system.",
        "default": [],
        "items": {
          "type": "string"
        }
      },
      "templateSource": {
        "type": "string",
        "description": "The location of the control's HTML template."
      },
      "styleSource": {
        "type": "string",
        "description": "The location of the control's stylesheet."
      },
      "assets": {
        "type": "array",
        "description": "A list of files to make available as raw content via the artifact provider API.",
        "items": {
          "type": "string"
        }
      },
      "assetUrls": {
        "type": "array",
        "description": "A list of files to make available as URLs via the artifact provider API.",
        "items": {
          "type": "string"
        }
      },
      "assetsForTheme": {
        "type": "array",
        "description": "A list of themed files to make available as raw content via the artifact provider API.",
        "items": {
          "type": "string"
        }
      },
      "assetUrlsForTheme": {
        "type": "array",
        "description": "A list of themed files to make available as URLs via the artifact provider API.",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "name",
                  "description"
                ],
                "properties": {
                  "assets": {
                    "type": "array",
                    "description": "A list of files to make available as raw content via the artifact provider API.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "description": {
                    "type": "string",
                    "description": "A short description of the purpose of this control."
                  },
                  "assetUrls": {
                    "type": "array",
                    "description": "A list of files to make available as URLs via the artifact provider API.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "assetsForTheme": {
                    "type": "array",
                    "description": "A list of themed files to make available as raw content via the artifact provider API.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "assetUrlsForTheme": {
                    "type": "array",
                    "description": "A list of themed files to make available as URLs via the artifact provider API.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "controls": {
                    "type": "array",
                    "description": "Each control as a path that can be resolved using the module system.",
                    "default": [],
                    "items": {
                      "type": "string"
                    }
                  },
                  "templateSource": {
                    "type": "string",
                    "description": "The location of the control's HTML template."
                  },
                  "name": {
                    "type": "string",
                    "description": "The name of the control."
                  },
                  "integration": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "styleSource": {
                    "type": "string",
                    "description": "The location of the control's stylesheet."
                  }
                }
              },
              {
                "patternProperties": {
                  "^controls$": true,
                  "^assetUrls$": true,
                  "^description$": true,
                  "^styleSource$": true,
                  "^assetsForTheme$": true,
                  "^templateSource$": true,
                  "^name$": true,
                  "^assetUrlsForTheme$": true,
                  "^integration$": true,
                  "^assets$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "How this control should be loaded by the LaxarJS runtime.",
                "properties": {
                  "technology": {
                    "type": "string",
                    "description": "Underlying technology of the control, which will be used to load the controller and template.",
                    "default": "plain"
                  }
                },
                "default": {}
              },
              {
                "patternProperties": {
                  "^technology$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
