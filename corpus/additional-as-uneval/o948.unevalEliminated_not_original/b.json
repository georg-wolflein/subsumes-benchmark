{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "schema for an EventAcceptanceAction",
              "required": [
                "uuid",
                "entity",
                "type",
                "class",
                "event_uuid"
              ],
              "type": "object",
              "properties": {
                "uuid": {
                  "type": "string"
                },
                "event_uuid": {
                  "type": "string"
                },
                "entity": {
                  "type": "string"
                },
                "class": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^type$": true,
                "^entity$": true,
                "^class$": true,
                "^event_uuid$": true,
                "^uuid$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    }
  }
}
