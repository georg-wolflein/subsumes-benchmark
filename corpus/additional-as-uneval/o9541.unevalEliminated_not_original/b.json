{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "format": {
                  "type": "string",
                  "enum": [
                    "UDRW",
                    "UDRO",
                    "UDCO",
                    "UDZO",
                    "ULFO",
                    "UDBZ"
                  ]
                },
                "code-sign": {
                  "type": "object",
                  "properties": {
                    "signing-identity": {
                      "type": "string"
                    },
                    "identifier": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "signing-identity"
                  ]
                },
                "window": {
                  "type": "object",
                  "properties": {
                    "position": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "integer"
                        },
                        "y": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ]
                    },
                    "size": {
                      "type": "object",
                      "properties": {
                        "width": {
                          "type": "integer"
                        },
                        "height": {
                          "type": "integer"
                        }
                      },
                      "required": [
                        "width",
                        "height"
                      ]
                    }
                  }
                },
                "background": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                },
                "icon-size": {
                  "type": "integer"
                },
                "contents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "integer"
                      },
                      "name": {
                        "type": "string"
                      },
                      "path": {
                        "type": "string"
                      },
                      "y": {
                        "type": "integer"
                      },
                      "type": {
                        "type": "string",
                        "enum": [
                          "link",
                          "file",
                          "position"
                        ]
                      }
                    },
                    "required": [
                      "x",
                      "y",
                      "type",
                      "path"
                    ]
                  }
                },
                "background-color": {
                  "type": "string",
                  "format": "css-color"
                },
                "title": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "contents"
              ]
            },
            {
              "patternProperties": {
                "^code-sign$": true,
                "^contents$": true,
                "^format$": true,
                "^window$": true,
                "^icon-size$": true,
                "^title$": true,
                "^background$": true,
                "^background-color$": true,
                "^icon$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
