    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 32767
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "inactive"
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^description$": true,
                  "^status$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
