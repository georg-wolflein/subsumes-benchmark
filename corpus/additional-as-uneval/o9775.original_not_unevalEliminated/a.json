{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "certificate": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 50
                },
                "filterType": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "all",
                        "whitelist",
                        "blacklist"
                      ]
                    },
                    {
                      "type": "string",
                      "enum": [
                        "none"
                      ]
                    }
                  ]
                },
                "description": {
                  "type": "string",
                  "maxLength": 32767
                },
                "deviceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Fa-f\\d]{24}$"
                  },
                  "maxItems": 1000
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "active",
                    "inactive"
                  ]
                },
                "pubTopics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                },
                "deviceTags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "maxItems": 100
                },
                "subTopics": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  }
                }
              },
              "required": [
                "certificate"
              ]
            },
            {
              "patternProperties": {
                "^deviceTags$": true,
                "^filterType$": true,
                "^subTopics$": true,
                "^status$": true,
                "^pubTopics$": true,
                "^deviceIds$": true,
                "^certificate$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
