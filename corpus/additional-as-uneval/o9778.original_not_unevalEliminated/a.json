{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "email": {
                  "type": "string",
                  "format": "email",
                  "maxLength": 1024
                },
                "includeDevices": {
                  "type": "boolean",
                  "default": false
                },
                "ownerId": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[A-Fa-f\\d]{24}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "includeFiles": {
                  "type": "boolean",
                  "default": false
                },
                "dryRun": {
                  "type": "boolean",
                  "default": false
                },
                "ownerType": {
                  "type": "string",
                  "enum": [
                    "user",
                    "organization"
                  ]
                },
                "includeDataTableRows": {
                  "type": "boolean",
                  "default": false
                }
              }
            },
            {
              "patternProperties": {
                "^dryRun$": true,
                "^ownerId$": true,
                "^includeDataTableRows$": true,
                "^includeDevices$": true,
                "^email$": true,
                "^ownerType$": true,
                "^includeFiles$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
