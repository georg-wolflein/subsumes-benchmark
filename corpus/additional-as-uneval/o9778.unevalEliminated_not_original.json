{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "format",
    "maxLength",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9778.unevalEliminated_not_original.json",
  "a": {
