{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "maxLength",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9780.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "includeFiles": {
        "type": "boolean",
        "default": false
      },
      "includeDataTableRows": {
        "type": "boolean",
        "default": false
      },
      "includeDevices": {
        "type": "boolean",
        "default": false
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 1024
      }
    },
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "includeFiles": {
                    "type": "boolean",
                    "default": false
                  },
                  "includeDataTableRows": {
                    "type": "boolean",
                    "default": false
                  },
                  "includeDevices": {
                    "type": "boolean",
                    "default": false
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 1024
                  }
                }
              },
              {
                "patternProperties": {
                  "^includeFiles$": true,
                  "^includeDataTableRows$": true,
                  "^includeDevices$": true,
                  "^email$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
