{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "bucket": {
                  "type": "string",
                  "max": 255
                },
                "accessKeyId": {
                  "type": "string",
                  "min": 4,
                  "max": 128
                },
                "secretAccessKey": {
                  "type": "string",
                  "min": 4,
                  "max": 128
                },
                "region": {
                  "type": "string",
                  "max": 128
                }
              },
              "required": [
                "bucket",
                "accessKeyId",
                "secretAccessKey",
                "region"
              ]
            },
            {
              "patternProperties": {
                "^bucket$": true,
                "^accessKeyId$": true,
                "^secretAccessKey$": true,
                "^region$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "account": {
                  "type": "string",
                  "min": 3,
                  "max": 24
                },
                "accountKey": {
                  "type": "string",
                  "max": 255
                },
                "bucket": {
                  "type": "string",
                  "min": 3,
                  "max": 63
                }
              },
              "required": [
                "account",
                "accountKey",
                "bucket"
              ]
            },
            {
              "patternProperties": {
                "^account$": true,
                "^accountKey$": true,
                "^bucket$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "endpointDefaultCors": {
                  "type": "boolean"
                },
                "applicationTemplateId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "orgId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "blobUrlTTL": {
                  "type": "number",
                  "minimum": 3600.0,
                  "maximum": 604800.0
                },
                "expUserTokenCutoff": {
                  "type": "string",
                  "format": "date-time"
                },
                "description": {
                  "type": "string",
                  "maxLength": 1024
                },
                "endpointSlug": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 63,
                  "pattern": "^[0-9a-z-]*$"
                },
                "archiveConfig": {
                  "$ref": "#/$defs/modern_2"
                },
                "globals": {
                  "type": "array",
                  "maxItems": 100,
                  "items": {
                    "$ref": "#/$defs/modern_7"
                  }
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^blobUrlTTL$": true,
                "^expUserTokenCutoff$": true,
                "^description$": true,
                "^orgId$": true,
                "^name$": true,
                "^archiveConfig$": true,
                "^globals$": true,
                "^endpointDefaultCors$": true,
                "^applicationTemplateId$": true,
                "^endpointSlug$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "json": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32767
                },
                "cloudOnly": {
                  "type": "boolean",
                  "default": false
                },
                "description": {
                  "type": "string",
                  "maxLength": 1024
                }
              },
              "required": [
                "key",
                "json"
              ]
            },
            {
              "patternProperties": {
                "^key$": true,
                "^json$": true,
                "^cloudOnly$": true,
                "^description$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "dataTablesMode": {
                  "type": "string",
                  "enum": [
                    "all",
                    "whitelist",
                    "blacklist"
                  ]
                },
                "gcs": {
                  "$ref": "#/$defs/modern_3"
                },
                "includeDataTables": {
                  "type": "boolean",
                  "default": false
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "all",
                    "whitelist",
                    "blacklist"
                  ]
                },
                "deviceTags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  },
                  "maxItems": 100
                },
                "directory": {
                  "type": "string",
                  "max": 255
                },
                "dataTableIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Fa-f\\d]{24}$"
                  },
                  "maxItems": 1000
                },
                "s3": {
                  "$ref": "#/$defs/modern_5"
                },
                "deviceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Fa-f\\d]{24}$"
                  },
                  "maxItems": 1000
                },
                "azure": {
                  "$ref": "#/$defs/modern_6"
                },
                "includeEvents": {
                  "type": "boolean",
                  "default": false
                },
                "includeDevices": {
                  "type": "boolean",
                  "default": true
                }
              }
            },
            {
              "patternProperties": {
                "^deviceTags$": true,
                "^azure$": true,
                "^s3$": true,
                "^dataTablesMode$": true,
                "^directory$": true,
                "^includeDevices$": true,
                "^mode$": true,
                "^includeEvents$": true,
                "^gcs$": true,
                "^dataTableIds$": true,
                "^deviceIds$": true,
                "^includeDataTables$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "keyJson": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 4
                },
                "bucket": {
                  "type": "string",
                  "max": 255
                }
              },
              "required": [
                "projectId",
                "keyJson",
                "bucket"
              ]
            },
            {
              "patternProperties": {
                "^projectId$": true,
                "^keyJson$": true,
                "^bucket$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
