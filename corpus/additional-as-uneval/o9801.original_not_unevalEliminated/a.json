{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": [
                        "number",
                        "string",
                        "boolean"
                      ]
                    },
                    "time": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/modern_2"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "$date": {
                  "type": "string"
                }
              },
              "required": [
                "$date"
              ]
            },
            {
              "patternProperties": {
                "^$date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
