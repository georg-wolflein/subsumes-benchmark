{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9801.unevalEliminated_not_original.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "patternProperties": {
      "^[0-9a-zA-Z_-]{1,255}$": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "number",
              "string",
              "boolean"
            ]
          },
          "time": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "$date": {
                    "type": "string"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "$date"
                ]
              }
            ]
          }
        }
      }
    },
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^[0-9a-zA-Z_-]{1,255}$": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "type": [
                          "number",
                          "string",
                          "boolean"
                        ]
                      },
                      "time": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "$ref": "#/$defs/modern_2"
                          }
                        ]
                      }
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^[0-9a-zA-Z_-]{1,255}$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "$date": {
                    "type": "string"
                  }
                },
                "required": [
                  "$date"
                ]
              },
              {
                "patternProperties": {
                  "^$date$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
