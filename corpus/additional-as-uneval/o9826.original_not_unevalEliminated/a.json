{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Device Command",
              "description": "Schema for a command for a single Device",
              "type": "object",
              "properties": {
                "time": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "$ref": "#/$defs/modern_2"
                    }
                  ]
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "payload": true
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^time$": true,
                "^name$": true,
                "^payload$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "$date": {
                  "type": "string"
                }
              },
              "required": [
                "$date"
              ]
            },
            {
              "patternProperties": {
                "^$date$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
