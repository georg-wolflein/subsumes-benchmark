{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "secret": {
                  "type": "string"
                },
                "requestedScopes": {
                  "type": "array",
                  "_uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "all.Device",
                      "all.Device.read",
                      "data.export",
                      "data.timeSeriesQuery",
                      "data.lastValueQuery",
                      "device.commandStream",
                      "device.get",
                      "device.getCompositeState",
                      "device.getState",
                      "device.stateStream",
                      "device.getLogEntries",
                      "device.getCommand",
                      "device.debug",
                      "device.sendState",
                      "device.sendCommand",
                      "device.setConnectionStatus",
                      "devices.get",
                      "devices.sendCommand"
                    ]
                  }
                },
                "key": {
                  "type": "string"
                },
                "tokenTTL": {
                  "type": "integer",
                  "minimum": 0.0
                },
                "deviceId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                }
              },
              "required": [
                "deviceId"
              ]
            },
            {
              "patternProperties": {
                "^secret$": true,
                "^deviceId$": true,
                "^key$": true,
                "^requestedScopes$": true,
                "^tokenTTL$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
