{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "email": {
      "_format": "email",
      "maxLength": 1024,
      "type": "string"
    },
    "token": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "email",
    "token"
  ],
  "type": "object"
}
