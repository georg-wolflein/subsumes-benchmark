{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "twoFactorAuthKey": {
                  "type": "string",
                  "minLength": 52,
                  "maxLength": 52
                },
                "password": {
                  "type": "string",
                  "minLength": 8,
                  "maxLength": 2048
                }
              },
              "required": [
                "password",
                "twoFactorAuthKey"
              ]
            },
            {
              "patternProperties": {
                "^twoFactorAuthKey$": true,
                "^password$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
