{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "replaceExisting": {
                  "type": "boolean",
                  "default": false
                },
                "createUsers": {
                  "type": "boolean",
                  "default": true
                },
                "createGroups": {
                  "type": "boolean",
                  "default": true
                },
                "slug": {
                  "type": "string",
                  "minLength": 4,
                  "maxLength": 63,
                  "pattern": "^[0-9a-z-]*$"
                }
              }
            },
            {
              "patternProperties": {
                "^replaceExisting$": true,
                "^createUsers$": true,
                "^createGroups$": true,
                "^slug$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
