{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "domainName": {
                  "type": "string",
                  "maxLength": 1024,
                  "minLength": 3
                },
                "version": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sslCert": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 50
                },
                "sslBundle": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 50
                },
                "sslKey": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 50
                }
              },
              "required": [
                "domainName"
              ]
            },
            {
              "patternProperties": {
                "^sslBundle$": true,
                "^sslCert$": true,
                "^sslKey$": true,
                "^domainName$": true,
                "^version$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
