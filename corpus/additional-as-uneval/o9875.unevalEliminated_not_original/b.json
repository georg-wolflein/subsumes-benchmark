{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "delete",
                    "get",
                    "options",
                    "patch",
                    "post",
                    "put"
                  ]
                },
                "experienceGroupIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Fa-f\\d]{24}$"
                  },
                  "maxItems": 1000
                },
                "description": {
                  "type": "string",
                  "maxLength": 32767
                },
                "enabled": {
                  "type": "boolean"
                },
                "endpointTags": {
                  "$ref": "#/$defs/modern_2"
                },
                "unauthorizedReply": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_3"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "access": {
                  "type": "string",
                  "enum": [
                    "public",
                    "authenticated",
                    "group"
                  ]
                },
                "route": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "staticReply": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/modern_4"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "route",
                "method"
              ]
            },
            {
              "patternProperties": {
                "^unauthorizedReply$": true,
                "^route$": true,
                "^access$": true,
                "^enabled$": true,
                "^staticReply$": true,
                "^endpointTags$": true,
                "^method$": true,
                "^description$": true,
                "^experienceGroupIds$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            },
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "statusCode": {
                  "type": "number",
                  "min": 100,
                  "max": 599,
                  "integer": true
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "page",
                    "redirect"
                  ]
                }
              },
              "required": [
                "value",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^statusCode$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string"
                },
                "statusCode": {
                  "type": "number",
                  "min": 100,
                  "max": 599,
                  "integer": true
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "page",
                    "redirect"
                  ]
                }
              },
              "required": [
                "value",
                "type"
              ]
            },
            {
              "patternProperties": {
                "^value$": true,
                "^statusCode$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
