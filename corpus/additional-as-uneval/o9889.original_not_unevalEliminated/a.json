{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "userTags": {
                  "$ref": "#/$defs/modern_2"
                },
                "tokenCutoff": {
                  "_format": "date-time",
                  "type": "string"
                },
                "lastName": {
                  "maxLength": 1024,
                  "type": "string"
                },
                "firstName": {
                  "maxLength": 1024,
                  "type": "string"
                },
                "password": {
                  "maxLength": 2048,
                  "minLength": 8,
                  "type": "string"
                },
                "email": {
                  "_format": "email",
                  "maxLength": 1024,
                  "type": "string"
                },
                "experienceGroupIds": {
                  "items": {
                    "pattern": "^[A-Fa-f\\d]{24}$",
                    "type": "string"
                  },
                  "maxItems": 1000,
                  "type": "array"
                }
              },
              "required": [
                "email",
                "password"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^tokenCutoff$": true,
                "^lastName$": true,
                "^experienceGroupIds$": true,
                "^password$": true,
                "^firstName$": true,
                "^userTags$": true,
                "^email$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": {
                  "maxLength": 255,
                  "minLength": 1,
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
