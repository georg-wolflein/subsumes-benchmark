{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sortField": {
      "type": "string"
    },
    "page": {
      "type": "integer"
    },
    "perPage": {
      "type": "integer"
    },
    "filter": {
      "type": "string"
    },
    "experienceGroupId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "sortDirection": {
      "type": "string",
      "enum": [
        "asc",
        "desc",
        "ASC",
        "DESC",
        ""
      ]
    },
    "totalCount": {
      "type": "integer"
    },
    "count": {
      "type": "integer"
    },
    "filterField": {
      "type": "string"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "items": {
      "type": "array",
      "items": {
        "title": "Experience User",
        "description": "Schema for a single Experience User",
        "type": "object",
        "properties": {
          "userTags": {
            "$ref": "#/$defs/modern_1"
          },
          "lastLogin": {
            "type": "string",
            "format": "date-time"
          },
          "passwordLastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 1024
          },
          "tokenCutoff": {
            "type": "string",
            "format": "date-time"
          },
          "applicationId": {
            "type": "string",
            "pattern": "^[A-Fa-f\\d]{24}$"
          },
          "experienceGroups": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                }
              }
            }
          },
          "lastName": {
            "type": "string",
            "maxLength": 1024
          },
          "creationDate": {
            "type": "string",
            "format": "date-time"
          },
          "experienceUserId": {
            "type": "string",
            "pattern": "^[A-Fa-f\\d]{24}$"
          },
          "lastUpdated": {
            "type": "string",
            "format": "date-time"
          },
          "avatarUrl": {
            "type": "string",
            "format": "url"
          },
          "firstName": {
            "type": "string",
            "maxLength": 1024
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Fa-f\\d]{24}$"
          }
        }
      }
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            },
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
