{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "endpointDefaultCors": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "maxLength": 32767
                },
                "sourceVersionIdOrName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            },
            {
              "patternProperties": {
                "^endpointDefaultCors$": true,
                "^description$": true,
                "^sourceVersionIdOrName$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
