{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "layoutId": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "body": {
                  "type": "string",
                  "maxLength": 131072,
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "description": {
                  "type": "string",
                  "maxLength": 32767
                },
                "viewTags": {
                  "$ref": "#/$defs/modern_2"
                },
                "viewType": {
                  "type": "string",
                  "enum": [
                    "layout",
                    "page",
                    "component"
                  ]
                }
              },
              "required": [
                "name",
                "viewType",
                "body"
              ]
            },
            {
              "patternProperties": {
                "^viewType$": true,
                "^description$": true,
                "^layoutId$": true,
                "^viewTags$": true,
                "^body$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            },
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
