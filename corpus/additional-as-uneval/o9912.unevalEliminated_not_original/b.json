{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "notes": {
                  "type": "string",
                  "maxLength": 32767
                },
                "enabled": {
                  "type": "boolean"
                }
              }
            },
            {
              "patternProperties": {
                "^notes$": true,
                "^enabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
