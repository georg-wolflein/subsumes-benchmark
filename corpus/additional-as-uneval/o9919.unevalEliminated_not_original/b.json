{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    },
    "integrationId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "meridianConfig": {
      "$ref": "#/$defs/modern_1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "googlePubSubConfig": {
      "$ref": "#/$defs/modern_2"
    },
    "status": {
      "lastKeepAlive": {
        "type": [
          "number"
        ]
      },
      "nextAttempt": {
        "type": [
          "number"
        ]
      },
      "connectInfo": {
        "type": "object",
        "properties": {
          "ts": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      },
      "disconnectInfo": {
        "type": "object",
        "properties": {
          "ts": {
            "type": [
              "number",
              "null"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      }
    },
    "mqttConfig": {
      "$ref": "#/$defs/modern_3"
    },
    "creationDate": {
      "type": "string",
      "format": "date-time"
    },
    "integrationType": {
      "type": "string",
      "enum": [
        "googlePubSub",
        "meridian",
        "mqtt",
        "particle"
      ]
    },
    "particleConfig": {
      "$ref": "#/$defs/modern_4"
    },
    "applicationId": {
      "type": "string",
      "pattern": "^[A-Fa-f\\d]{24}$"
    },
    "enabled": {
      "type": "boolean"
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "authenticationToken": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "locationId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "assetUpdates": {
                  "type": "boolean"
                },
                "zoneUpdates": {
                  "type": "boolean"
                }
              },
              "required": [
                "authenticationToken",
                "locationId"
              ]
            },
            {
              "patternProperties": {
                "^authenticationToken$": true,
                "^locationId$": true,
                "^assetUpdates$": true,
                "^zoneUpdates$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "projectId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "keyJson": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 4
                }
              },
              "required": [
                "projectId",
                "keyJson"
              ]
            },
            {
              "patternProperties": {
                "^projectId$": true,
                "^keyJson$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "certificate": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 4
                },
                "clientId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "host": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "clean": {
                  "type": "boolean"
                },
                "privateKey": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 4
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "mqtt",
                    "mqtts",
                    "ws",
                    "wss"
                  ]
                },
                "password": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "port": {
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 65535.0
                },
                "caCertificate": {
                  "type": "string",
                  "maxLength": 32767,
                  "minLength": 4
                }
              },
              "required": [
                "port",
                "protocol",
                "host"
              ]
            },
            {
              "patternProperties": {
                "^port$": true,
                "^protocol$": true,
                "^clientId$": true,
                "^host$": true,
                "^caCertificate$": true,
                "^clean$": true,
                "^certificate$": true,
                "^username$": true,
                "^privateKey$": true,
                "^password$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "accessToken": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "productSlugOrId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "orgSlugOrId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "deviceNameOrId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                }
              },
              "required": [
                "accessToken"
              ]
            },
            {
              "patternProperties": {
                "^accessToken$": true,
                "^productSlugOrId$": true,
                "^orgSlugOrId$": true,
                "^deviceNameOrId$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
