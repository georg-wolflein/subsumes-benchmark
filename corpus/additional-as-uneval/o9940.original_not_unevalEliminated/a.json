{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "applicationRoles": {
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "maxItems": 1000,
                  "type": "array"
                },
                "dashboardRoles": {
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "maxItems": 1000,
                  "type": "array"
                },
                "email": {
                  "_format": "email",
                  "maxLength": 1024,
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "admin",
                    "edit",
                    "collaborate",
                    "view",
                    "none"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "email",
                "role"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^applicationRoles$": true,
                "^dashboardRoles$": true,
                "^email$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "resourceId": {
                  "pattern": "^[A-Fa-f\\d]{24}$",
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "collaborate",
                    "view",
                    "none"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "resourceId",
                "role"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^resourceId$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "properties": {
                "resourceId": {
                  "pattern": "^[A-Fa-f\\d]{24}$",
                  "type": "string"
                },
                "role": {
                  "enum": [
                    "collaborate",
                    "view",
                    "none"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "resourceId",
                "role"
              ],
              "type": "object"
            },
            {
              "patternProperties": {
                "^resourceId$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
