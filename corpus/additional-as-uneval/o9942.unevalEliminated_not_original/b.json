{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "applicationRoles": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_1"
        },
        "maxItems": 1000
      },
      "inviteDate": {
        "type": "string",
        "format": "date-time"
      },
      "id": {
        "type": "string",
        "pattern": "^[A-Fa-f\\d]{24}$"
      },
      "hasExpired": {
        "type": "boolean"
      },
      "ttl": {
        "type": "number"
      },
      "dashboardRoles": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_2"
        },
        "maxItems": 1000
      },
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 1024
      },
      "role": {
        "type": "string",
        "enum": [
          "admin",
          "edit",
          "collaborate",
          "view",
          "none"
        ]
      }
    }
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "resourceId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "collaborate",
                    "view",
                    "none"
                  ]
                }
              },
              "required": [
                "resourceId",
                "role"
              ]
            },
            {
              "patternProperties": {
                "^resourceId$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "resourceId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "collaborate",
                    "view",
                    "none"
                  ]
                }
              },
              "required": [
                "resourceId",
                "role"
              ]
            },
            {
              "patternProperties": {
                "^resourceId$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
