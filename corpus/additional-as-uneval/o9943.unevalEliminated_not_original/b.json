{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "userId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "admin",
                    "edit",
                    "collaborate",
                    "view",
                    "none"
                  ]
                },
                "applicationRoles": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "maxItems": 1000
                },
                "dashboardRoles": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "maxItems": 1000
                }
              },
              "required": [
                "userId"
              ]
            },
            {
              "patternProperties": {
                "^userId$": true,
                "^role$": true,
                "^applicationRoles$": true,
                "^dashboardRoles$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "resourceId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "collaborate",
                    "view",
                    "none"
                  ]
                }
              },
              "required": [
                "resourceId",
                "role"
              ]
            },
            {
              "patternProperties": {
                "^resourceId$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "resourceId": {
                  "type": "string",
                  "pattern": "^[A-Fa-f\\d]{24}$"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "collaborate",
                    "view",
                    "none"
                  ]
                }
              },
              "required": [
                "resourceId",
                "role"
              ]
            },
            {
              "patternProperties": {
                "^resourceId$": true,
                "^role$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
