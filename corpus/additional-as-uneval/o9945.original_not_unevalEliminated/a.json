{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "billingEmail": {
                  "type": "string",
                  "format": "email",
                  "maxLength": 1024
                },
                "iconColor": {
                  "type": "string",
                  "maxLength": 64
                },
                "planId": {
                  "type": "string",
                  "maxLength": 1024
                },
                "description": {
                  "type": "string",
                  "maxLength": 32767
                },
                "cardToken": {
                  "type": "string",
                  "maxLength": 1024
                }
              },
              "required": [
                "name"
              ]
            },
            {
              "patternProperties": {
                "^billingEmail$": true,
                "^description$": true,
                "^name$": true,
                "^iconColor$": true,
                "^planId$": true,
                "^cardToken$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
