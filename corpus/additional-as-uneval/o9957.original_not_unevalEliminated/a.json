{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^[0-9a-zA-Z_-]{1,255}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "FIRST",
                        "LAST",
                        "COUNT",
                        "MAX",
                        "MIN",
                        "MEDIAN",
                        "MEAN",
                        "SUM",
                        "STD_DEV"
                      ]
                    },
                    {
                      "type": "string",
                      "enum": [
                        "NONE"
                      ]
                    }
                  ]
                },
                "options": {
                  "$ref": "#/$defs/modern_7"
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^options$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "end": {
                  "type": "string",
                  "_format": "date-time"
                },
                "start": {
                  "type": "string",
                  "_format": "date-time"
                },
                "devices": {
                  "$ref": "#/$defs/modern_2"
                },
                "resolution": {
                  "type": "number"
                },
                "aggregation": {
                  "oneOf": [
                    {
                      "oneOf": [
                        {
                          "type": "string",
                          "enum": [
                            "FIRST",
                            "LAST",
                            "COUNT",
                            "MAX",
                            "MIN",
                            "MEDIAN",
                            "MEAN",
                            "SUM",
                            "STD_DEV"
                          ]
                        },
                        {
                          "type": "string",
                          "enum": [
                            "NONE"
                          ]
                        }
                      ]
                    },
                    {
                      "$ref": "#/$defs/modern_6"
                    },
                    {
                      "$ref": "#/$defs/modern_8"
                    }
                  ]
                }
              },
              "required": [
                "start",
                "end",
                "resolution",
                "aggregation",
                "devices"
              ]
            },
            {
              "patternProperties": {
                "^aggregation$": true,
                "^end$": true,
                "^start$": true,
                "^devices$": true,
                "^resolution$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object"
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "patternProperties": {
                "^[A-Fa-f\\d]{24}$": {
                  "$ref": "#/$defs/modern_3"
                }
              }
            },
            {
              "patternProperties": {
                "^[A-Fa-f\\d]{24}$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "TIMEATVALUE"
                  ]
                },
                "options": {
                  "$ref": "#/$defs/modern_9"
                }
              },
              "required": [
                "type",
                "options"
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^options$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 255
                }
              },
              "required": [
                "value"
              ]
            },
            {
              "patternProperties": {
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "points": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              "required": [
                "name",
                "points"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^points$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "time": {
                  "type": "string",
                  "_format": "date-time"
                },
                "data": {
                  "$ref": "#/$defs/modern_5"
                }
              },
              "required": [
                "data",
                "time"
              ]
            },
            {
              "patternProperties": {
                "^time$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
