{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "maxItems",
    "maxLength",
    "minLength",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9958.original_not_unevalEliminated.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "duration": {
                    "type": "number"
                  },
                  "deviceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Fa-f\\d]{24}$"
                    },
                    "maxItems": 1000
                  },
                  "attributes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                    }
                  },
                  "end": {
                    "type": "number"
                  },
                  "start": {
                    "type": "number"
                  },
                  "limit": {
                    "type": "number"
                  },
                  "deviceTags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "maxItems": 100
                  },
                  "resolution": {
                    "type": "number"
                  },
                  "order": {
                    "type": "string",
                    "enum": [
                      "asc",
                      "desc"
                    ],
                    "default": "asc"
                  },
                  "aggregation": {
                    "oneOf": [
                      {
                        "type": "string",
                        "enum": [
                          "FIRST",
                          "LAST",
                          "COUNT",
                          "MAX",
                          "MIN",
                          "MEDIAN",
                          "MEAN",
                          "SUM",
                          "STD_DEV"
                        ]
                      },
                      {
                        "type": "string",
                        "enum": [
                          "NONE"
                        ]
                      }
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^deviceTags$": true,
                  "^aggregation$": true,
                  "^order$": true,
                  "^attributes$": true,
                  "^duration$": true,
                  "^start$": true,
                  "^deviceIds$": true,
                  "^resolution$": true,
                  "^end$": true,
                  "^limit$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                }
              },
              {
                "patternProperties": {
                  "^key$": true,
                  "^value$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "start": {
        "type": "number"
      },
      "end": {
        "type": "number"
      },
      "duration": {
        "type": "number"
      },
      "resolution": {
        "type": "number"
      },
      "aggregation": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "FIRST",
              "LAST",
              "COUNT",
              "MAX",
              "MIN",
              "MEDIAN",
              "MEAN",
              "SUM",
              "STD_DEV"
            ]
          },
          {
            "type": "string",
            "enum": [
              "NONE"
            ]
          }
        ]
      },
      "attributes": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[0-9a-zA-Z_-]{1,255}$"
        }
      },
      "deviceTags": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[0-9a-zA-Z_-]{1,255}$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "additionalProperties": false
        },
        "maxItems": 100
      },
      "deviceIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Fa-f\\d]{24}$"
        },
        "maxItems": 1000
      },
      "limit": {
        "type": "number"
      },
      "order": {
        "type": "string",
        "enum": [
          "asc",
          "desc"
        ],
        "default": "asc"
      }
    },
    "additionalProperties": false
  }
}
