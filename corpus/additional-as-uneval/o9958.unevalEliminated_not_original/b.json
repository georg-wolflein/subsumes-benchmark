{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "duration": {
                  "type": "number"
                },
                "deviceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Fa-f\\d]{24}$"
                  },
                  "maxItems": 1000
                },
                "attributes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                  }
                },
                "end": {
                  "type": "number"
                },
                "start": {
                  "type": "number"
                },
                "limit": {
                  "type": "number"
                },
                "deviceTags": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "maxItems": 100
                },
                "resolution": {
                  "type": "number"
                },
                "order": {
                  "type": "string",
                  "enum": [
                    "asc",
                    "desc"
                  ],
                  "default": "asc"
                },
                "aggregation": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "FIRST",
                        "LAST",
                        "COUNT",
                        "MAX",
                        "MIN",
                        "MEDIAN",
                        "MEAN",
                        "SUM",
                        "STD_DEV"
                      ]
                    },
                    {
                      "type": "string",
                      "enum": [
                        "NONE"
                      ]
                    }
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^deviceTags$": true,
                "^aggregation$": true,
                "^order$": true,
                "^attributes$": true,
                "^duration$": true,
                "^start$": true,
                "^deviceIds$": true,
                "^resolution$": true,
                "^end$": true,
                "^limit$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                },
                "value": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                }
              }
            },
            {
              "patternProperties": {
                "^key$": true,
                "^value$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
