    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maxLength",
    "maximum",
    "minLength",
    "minimum",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9966.unevalEliminated_not_original.json",
  "a": {
