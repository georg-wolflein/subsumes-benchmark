{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "enum": [
        "grid-1.0.0"
      ]
    },
    "layers": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "properties": {
              "spriteId": {
                "type": "integer"
              },
              "targetX": {
                "type": "integer"
              },
              "targetY": {
                "type": "integer"
              }
            },
            "additionalProperties": false,
            "required": [
              "spriteId"
            ]
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "layers"
  ]
}
