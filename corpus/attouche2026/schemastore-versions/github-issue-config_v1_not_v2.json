{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": false,
  "features": [
    "additionalProperties",
    "items",
    "minItems",
    "minLength",
    "pattern",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/schemastore_containment/sat/github-issue-config_v1_not_v2.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/schemastore_containment/sat/github-issue-config_v2_not_v1.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "https://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
    "title": "GitHub issue template chooser configuration",
    "description": "You can customize the issue template chooser that people see when creating a new issue in your repository.",
    "type": "object",
    "properties": {
      "blank_issues_enabled": {
        "description": "Specify whether allow contributors to create blank issues or not.",
        "type": "boolean"
      },
      "contact_links": {
        "description": "Link to places outside of GitHub where you'd prefer certain reports or discussion take place.",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "description": "The name or title of the link.",
              "type": "string",
              "minLength": 1,
              "examples": [
                "Sample name"
              ]
            },
            "url": {
              "description": "The URL this link goes to.",
              "type": "string",
              "pattern": "^https?://",
              "examples": [
                "https://sample/url"
              ]
            },
            "about": {
              "description": "A short text description of the link.",
              "type": "string",
              "minLength": 1,
              "examples": [
                "Sample description"
              ]
            }
          },
          "required": [
            "name",
            "url",
            "about"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "https://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
    "title": "GitHub issue template configuration",
    "description": "You can customize the issue template chooser that people see when creating a new issue in your repository.",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "blank_issues_enabled": {
        "description": "Should contributors be able to create blank issues, or must they use a template?",
        "type": "boolean"
      },
      "contact_links": {
        "description": "Link to places outside of GitHub where you'd prefer certain reports or discussion take place",
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url",
            "about"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "The name or title of the link"
            },
            "url": {
              "type": "string",
              "description": "The URL this link goes to (must be a valid HTTP or HTTPS URL)"
            },
            "about": {
              "type": "string",
              "description": "A short text description of the link"
            }
          }
        }
      }
    }
  }
}
