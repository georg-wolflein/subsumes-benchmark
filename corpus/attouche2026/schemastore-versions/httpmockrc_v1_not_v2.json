{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/schemastore_containment/sat/httpmockrc_v1_not_v2.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/schemastore_containment/unknown/httpmockrc_v2_not_v1.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Http-mocker configuration.",
    "description": "A tool for mock local requests or proxy remote requests.",
    "type": "object",
    "properties": {
      "mockFileName": {
        "default": "mocks",
        "type": "string",
        "description": "Root of mock files"
      },
      "requestHeaders": {
        "type": "object",
        "description": "Custom request header"
      },
      "responseHeaders": {
        "type": "object",
        "description": "Custom response header"
      },
      "routes": {
        "type": "object",
        "description": "Rules for proxy and mock",
        "patternProperties": {
          "^.*$": {
            "type": "object",
            "description": "Rule of Matching route",
            "properties": {
              "path": {
                "type": "string",
                "description": "Where Mock result file located"
              },
              "ignore": {
                "type": "boolean",
                "description": "Whether to ignore this rule, generally used for remote interfaces instead of mock in the local"
              },
              "delay": {
                "type": "number",
                "description": "How many milliseconds are delayed to return a request, general used for control the request sequence"
              }
            },
            "required": [
              "path"
            ]
          }
        }
      }
    },
    "required": [
      "mockFileName",
      "routes"
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Http-mocker configuration.",
    "description": "A tool for mock local requests or proxy remote requests.",
    "type": "object",
    "properties": {
      "mockFileName": {
        "default": "mocks",
        "type": "string",
        "description": "Root of mock files"
      },
      "responseHeaders": {
        "type": "object",
        "description": "Custom response header"
      },
      "routes": {
        "type": "object",
        "description": "Rules for proxy and mock"
      }
    },
    "required": [
      "mockFileName",
      "routes"
    ]
  }
}
