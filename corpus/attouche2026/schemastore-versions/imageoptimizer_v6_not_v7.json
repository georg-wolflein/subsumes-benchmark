    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Schema for imageoptimizer.json files",
    "properties": {
      "optimizations": {
        "description": "An array of optimization rules",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "includes"
          ],
          "properties": {
