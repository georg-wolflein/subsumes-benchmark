{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "maxLength",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10020.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10020.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "$ref": "#/$defs/modern_1"
      },
      {
        "$ref": "#/$defs/modern_2"
      }
    ],
    "title": "ForgetRequest",
    "type": "object",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "key": {
                    "maxLength": 12,
                    "pattern": "^[a-zA-Z0-9_\\.]+$",
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^key$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "keys": {
                    "items": {
                      "maxLength": 12,
                      "pattern": "^[a-zA-Z0-9_\\.]+$",
                      "type": "string"
                    },
                    "type": "array"
                  }
                }
              },
              {
                "patternProperties": {
                  "^keys$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
      {
        "additionalProperties": false,
        "properties": {
          "key": {
            "maxLength": 12,
            "pattern": "^[a-zA-Z0-9_\\.]+$",
            "type": "string"
          }
        }
      },
      {
        "additionalProperties": false,
        "properties": {
          "keys": {
            "items": {
              "maxLength": 12,
              "pattern": "^[a-zA-Z0-9_\\.]+$",
              "type": "string"
            },
            "type": "array"
          }
        }
      }
    ],
    "title": "ForgetRequest",
    "type": "object"
  }
}
