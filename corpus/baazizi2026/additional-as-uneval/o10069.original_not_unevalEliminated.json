{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minLength",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10069.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o10069.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DatabaseCollection",
    "description": "A collection from a certain namespace",
    "oneOf": [
      {
        "$ref": "#/$defs/modern_1"
      },
      {
        "type": "string",
        "description": "A collection from the default namespace",
        "pattern": "^[a-zA-Z0-9_\\.~]+$"
      }
    ],
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "A collection from the given namespace",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_\\.]+$",
                    "minLength": 2
                  },
                  "namespace": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_\\.]+$"
                  }
                },
                "required": [
                  "name",
                  "namespace"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^namespace$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DatabaseCollection",
    "description": "A collection from a certain namespace",
    "oneOf": [
      {
        "type": "object",
        "description": "A collection from the given namespace",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\.]+$",
            "minLength": 2
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\.]+$"
          }
        },
        "required": [
          "name",
          "namespace"
        ],
        "additionalProperties": false
      },
      {
        "type": "string",
        "description": "A collection from the default namespace",
        "pattern": "^[a-zA-Z0-9_\\.~]+$"
      }
    ]
  }
}
