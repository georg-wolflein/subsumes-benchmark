{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "maxLength",
    "minItems",
    "minLength",
    "patternProperties",
    "properties",
    "recursion",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o13135.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o13135.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "List item",
                "description": "Single list item definition (hierarchical)",
                "type": "object",
                "properties": {
                  "value": {
                    "title": "Value",
                    "description": "Value to be stored in the database",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "label": {
                    "title": "Label",
                    "description": "User-friendly label",
                    "type": "string",
                    "minLength": 1
                  },
                  "inactive": {
                    "title": "Inactive",
                    "description": "Whether or not the item is active",
                    "type": "boolean",
                    "default": false
                  },
                  "children": {
                    "title": "List item children",
                    "description": "Direct children items of the current list item",
                    "type": "array",
                    "items": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/listItem"
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "value",
                  "label",
                  "inactive",
                  "children"
                ]
              },
              {
                "patternProperties": {
                  "^value$": true,
                  "^label$": true,
                  "^inactive$": true,
                  "^children$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "listItem": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "CSV List Configuration",
                "description": "List items configuration for a single CSV list",
                "type": "object",
                "properties": {
                  "items": {
                    "title": "List items",
                    "description": "A list of items for a given list",
                    "type": "array",
                    "items": {
                      "allOf": [
                        {
                          "$ref": "#/$defs/listItem"
                        }
                      ]
                    },
                    "minItems": 1,
                    "_uniqueItems": true
                  }
                },
                "required": [
                  "items"
                ]
              },
              {
                "patternProperties": {
                  "^items$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CSV List Configuration",
    "description": "List items configuration for a single CSV list",
    "type": "object",
    "properties": {
      "items": {
        "title": "List items",
        "description": "A list of items for a given list",
        "type": "array",
        "items": {
          "allOf": [
            {
              "$ref": "#/$defs/listItem"
            }
          ]
        },
        "minItems": 1,
        "_uniqueItems": true
      }
    },
    "additionalProperties": false,
    "required": [
      "items"
    ],
    "$defs": {
      "listItem": {
        "title": "List item",
        "description": "Single list item definition (hierarchical)",
        "type": "object",
        "properties": {
          "value": {
            "title": "Value",
            "description": "Value to be stored in the database",
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "label": {
            "title": "Label",
            "description": "User-friendly label",
            "type": "string",
            "minLength": 1
          },
          "inactive": {
            "title": "Inactive",
            "description": "Whether or not the item is active",
            "type": "boolean",
            "default": false
          },
          "children": {
            "title": "List item children",
            "description": "Direct children items of the current list item",
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/$defs/listItem"
                }
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "value",
          "label",
          "inactive",
          "children"
        ]
      }
    }
  }
}
