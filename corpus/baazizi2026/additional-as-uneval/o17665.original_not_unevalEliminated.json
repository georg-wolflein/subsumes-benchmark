{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o17665.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o17665.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/MyObject",
    "$defs": {
      "MyString": {
        "type": "string"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "object": {
                    "$ref": "#/$defs/MySubObject"
                  },
                  "primitive": {
                    "$ref": "#/$defs/MyString"
                  }
                },
                "required": [
                  "primitive",
                  "object"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^object$": true,
                  "^primitive$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "propA": {
                    "type": "number"
                  },
                  "propB": {
                    "type": "number"
                  }
                },
                "required": [
                  "propA",
                  "propB"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^propA$": true,
                  "^propB$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "MyObject": {
        "$ref": "#/$defs/modern_1"
      },
      "MySubObject": {
        "$ref": "#/$defs/modern_2"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/MyObject",
    "$defs": {
      "MyObject": {
        "properties": {
          "object": {
            "$ref": "#/$defs/MySubObject"
          },
          "primitive": {
            "$ref": "#/$defs/MyString"
          }
        },
        "required": [
          "primitive",
          "object"
        ],
        "additionalProperties": false,
        "type": "object"
      },
      "MyString": {
        "type": "string"
      },
      "MySubObject": {
        "properties": {
          "propA": {
            "type": "number"
          },
          "propB": {
            "type": "number"
          }
        },
        "required": [
          "propA",
          "propB"
        ],
        "additionalProperties": false,
        "type": "object"
      }
    }
  }
}
