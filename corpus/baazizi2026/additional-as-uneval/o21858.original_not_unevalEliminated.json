{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "recursion",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21858.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o21858.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "required": [
                  "PathPart"
                ],
                "type": "object",
                "properties": {
                  "PathPart": {
                    "type": "string",
                    "pattern": "^(\\{[\\w\\-]+\\})|([\\w\\-]+)$"
                  },
                  "ChildResources": {
                    "$ref": "#/$defs/childresources"
                  }
                }
              },
              {
                "patternProperties": {
                  "^PathPart$": true,
                  "^ChildResources$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "ParentId",
                  "RestApiId",
                  "ChildResources"
                ],
                "properties": {
                  "ParentId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+$"
                  },
                  "RestApiId": {
                    "type": "string",
                    "pattern": "^[a-z0-9]{10}$"
                  },
                  "ChildResources": {
                    "$ref": "#/$defs/childresources"
                  }
                }
              },
              {
                "patternProperties": {
                  "^ParentId$": true,
                  "^RestApiId$": true,
                  "^ChildResources$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "childresource": {
        "$ref": "#/$defs/modern_1"
      },
      "childresources": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/childresource"
        }
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "ParentId",
      "RestApiId",
      "ChildResources"
    ],
    "properties": {
      "ParentId": {
        "type": "string",
        "pattern": "^[a-z0-9]+$"
      },
      "RestApiId": {
        "type": "string",
        "pattern": "^[a-z0-9]{10}$"
      },
      "ChildResources": {
        "$ref": "#/$defs/childresources"
      }
    },
    "additionalProperties": false,
    "$defs": {
      "childresources": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/childresource"
        }
      },
      "childresource": {
        "required": [
          "PathPart"
        ],
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "PathPart": {
            "type": "string",
            "pattern": "^(\\{[\\w\\-]+\\})|([\\w\\-]+)$"
          },
          "ChildResources": {
            "$ref": "#/$defs/childresources"
          }
        }
      }
    }
  }
}
