{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o24202.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o24202.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Uploaded file metadata entity",
                "properties": {
                  "name": {
                    "description": "Name of the file with extension",
                    "type": "string"
                  },
                  "loaded": {
                    "description": "Flag that indicates whether the file is loaded",
                    "type": "boolean"
                  },
                  "uploadedDate": {
                    "description": "Date and time when the file was uploaded",
                    "type": "string",
                    "format": "date-time"
                  },
                  "id": {
                    "description": "UUID",
                    "type": "string"
                  },
                  "createDate": {
                    "description": "Date and time when the file definition was created",
                    "type": "string",
                    "format": "date-time"
                  },
                  "uploadDefinitionId": {
                    "description": "Link to UploadDefinition entity",
                    "type": "string"
                  },
                  "jobExecutionId": {
                    "description": "Link to JobExecution entity",
                    "type": "string"
                  },
                  "sourcePath": {
                    "description": "The path to the file location",
                    "type": "string",
                    "readonly": true
                  }
                },
                "required": [
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^createDate$": true,
                  "^uploadDefinitionId$": true,
                  "^id$": true,
                  "^sourcePath$": true,
                  "^uploadedDate$": true,
                  "^jobExecutionId$": true,
                  "^loaded$": true,
                  "^name$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Uploaded file metadata entity",
    "additionalProperties": false,
    "properties": {
      "id": {
        "description": "UUID",
        "type": "string"
      },
      "sourcePath": {
        "description": "The path to the file location",
        "type": "string",
        "readonly": true
      },
      "name": {
        "description": "Name of the file with extension",
        "type": "string"
      },
      "jobExecutionId": {
        "description": "Link to JobExecution entity",
        "type": "string"
      },
      "uploadDefinitionId": {
        "description": "Link to UploadDefinition entity",
        "type": "string"
      },
      "loaded": {
        "description": "Flag that indicates whether the file is loaded",
        "type": "boolean"
      },
      "createDate": {
        "description": "Date and time when the file definition was created",
        "type": "string",
        "format": "date-time"
      },
      "uploadedDate": {
        "description": "Date and time when the file was uploaded",
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "name"
    ]
  }
}
