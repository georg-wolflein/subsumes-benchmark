{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minProperties",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o27356.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o27356.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "plugins": {
        "properties": {
          "puppet": {
            "$ref": "#/$defs/modern_1"
          }
        },
        "type": "object"
      }
    },
    "title": "Puppet plugin manifest",
    "type": "object",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "minProperties": 1,
                "properties": {
                  "assets": {
                    "$ref": "#/$defs/absolute_path"
                  },
                  "manifest": {
                    "$ref": "#/$defs/absolute_path"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^assets$": true,
                  "^manifest$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "absolute_path": {
        "pattern": "^/[^\\0]+$",
        "type": "string"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "plugins": {
        "properties": {
          "puppet": {
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "assets": {
                "$ref": "#/$defs/absolute_path"
              },
              "manifest": {
                "$ref": "#/$defs/absolute_path"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    "title": "Puppet plugin manifest",
    "type": "object",
    "$defs": {
      "absolute_path": {
        "pattern": "^/[^\\0]+$",
        "type": "string"
      }
    }
  }
}
