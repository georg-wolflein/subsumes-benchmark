                        {
                          "$ref": "#/$defs/MappingParent"
                        },
                        {
                          "$ref": "#/$defs/Mapping"
                        }
                      ]
                    }
                  },
                  "cvss_v3": {
                    "$ref": "#/$defs/CVSSv3"
                  }
                },
                "required": [
                  "id",
                  "children"
                ]
              },
              {
                "patternProperties": {
