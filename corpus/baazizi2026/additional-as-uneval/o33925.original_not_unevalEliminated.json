    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "issuer_key": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    }
                  },
                  "revocation_key": {
