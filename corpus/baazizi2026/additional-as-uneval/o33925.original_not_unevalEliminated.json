                  "revocation_key"
                ]
              },
              {
                "patternProperties": {
                  "^issuer_key$": true,
                  "^revocation_key$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date time ISO-8601 format of the date that the keys were issued."
                  },
                  "key": {
                    "type": "string",
                    "description": "Bitcoin address (compressed public key, usually 24 characters) that the issuer uses to issue the certificates."
                  }
                },
                "required": [
                  "date",
                  "key"
                ]
              },
              {
                "patternProperties": {
                  "^date$": true,
                  "^key$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Date time ISO-8601 format of the date that the keys were issued."
                  },
                  "key": {
                    "type": "string",
                    "description": "Bitcoin address (compressed public key, usually 24 characters) that the issuer uses to revoke the certificates."
                  }
                },
                "required": [
                  "date",
                  "key"
                ]
              },
              {
                "patternProperties": {
                  "^date$": true,
                  "^key$": true
                },
                "additionalProperties": false
