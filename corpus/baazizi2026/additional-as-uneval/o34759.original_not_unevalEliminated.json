{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minItems",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o34759.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o34759.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "break": {
        "enum": [
          "none",
          "paragraph",
          "page"
        ]
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Stages",
                "type": "object"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/modern_2"
                }
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "text",
                  "prompt"
                ],
                "properties": {
                  "stage": {
                    "type": "string"
                  },
                  "description": {
                    "$ref": "#/$defs/text"
                  },
                  "prompt": {
                    "$ref": "#/$defs/text"
                  },
                  "text": {
                    "type": "string"
                  },
                  "condition": {
                    "type": "string"
                  },
                  "action": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^action$": true,
                  "^description$": true,
                  "^stage$": true,
                  "^condition$": true,
                  "^text$": true,
                  "^prompt$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "text": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Stage",
                "properties": {
                  "stage": {
                    "type": "string"
                  },
                  "choices": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_3"
                    },
                    "minItems": 1
                  },
                  "text": {
                    "$ref": "#/$defs/text"
                  },
                  "end": {
                    "$ref": "#/$defs/break"
                  },
                  "start": {
                    "$ref": "#/$defs/break"
                  }
                }
              },
              {
                "patternProperties": {
                  "^end$": true,
                  "^stage$": true,
                  "^start$": true,
                  "^choices$": true,
                  "^text$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://danielzhu.tk/birthland/data",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Stages",
    "type": "object",
    "additionalProperties": {
      "title": "Stage",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/break"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "end": {
          "$ref": "#/$defs/break"
        },
        "stage": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "text",
              "prompt"
            ],
            "additionalProperties": false,
            "properties": {
              "description": {
                "$ref": "#/$defs/text"
              },
              "text": {
                "type": "string"
              },
              "prompt": {
                "$ref": "#/$defs/text"
              },
              "action": {
                "type": "string"
              },
              "stage": {
                "type": "string"
              },
              "condition": {
                "type": "string"
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "$defs": {
      "text": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        ]
      },
      "break": {
        "enum": [
          "none",
          "paragraph",
          "page"
        ]
      }
    }
  }
}
