{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "const",
    "items",
    "minItems",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o39080.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39080.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "$tool": {
                    "const": "go-const-ts",
                    "description": "Must be set to go-const-ts.",
                    "type": "string"
                  },
                  "excludeTypes": {
                    "description": "Exclude const types.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "langs": {
                    "description": "Langs to exrtact. Field name will be used if lang not set in go const.",
                    "items": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "prettiesRoots": {
                    "description": "Dirs that contains the translated jsons which will overwrite the go const types.",
                    "items": {
                      "preproccess": "env",
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "pretties": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "dist": {
                    "description": "The output root path (relative to the pwd).",
                    "type": "string"
                  },
                  "includeTypes": {
                    "description": "Include const types only, ignore others.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "src": {
                    "description": "Input go files(Glob), expand with env first.",
                    "items": {
                      "preproccess": "env",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "pipePrefix": {
                    "default": "",
                    "description": "Prefix to pipe name, pipe name is used as file name.",
                    "type": "string"
                  },
                  "$schema": {
                    "type": "string"
                  }
                },
                "required": [
                  "$tool",
                  "src",
                  "dist",
                  "langs",
                  "pipePrefix"
                ],
                "title": "go-const-ts Config",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schema$": true,
                  "^excludeTypes$": true,
                  "^$tool$": true,
                  "^pretties$": true,
                  "^dist$": true,
                  "^pipePrefix$": true,
                  "^prettiesRoots$": true,
                  "^src$": true,
                  "^includeTypes$": true,
                  "^langs$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Dirs that contains the translated jsons which will overwrite the go const types.",
                "patternProperties": {
                  "^[a-z]{2}(-[A-Z]{2})?$": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^[a-z]{2}(-[A-Z]{2})?$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Lang from langs.",
                "patternProperties": {
                  "^[A-Z].*$": {
                    "description": "Struct translates filepath that will overwrite all other translates.",
                    "preproccess": "env",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^[A-Z].*$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "$schema": {
        "type": "string"
      },
      "$tool": {
        "const": "go-const-ts",
        "description": "Must be set to go-const-ts.",
        "type": "string"
      },
      "dist": {
        "description": "The output root path (relative to the pwd).",
        "type": "string"
      },
      "excludeTypes": {
        "description": "Exclude const types.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "includeTypes": {
        "description": "Include const types only, ignore others.",
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "langs": {
        "description": "Langs to exrtact. Field name will be used if lang not set in go const.",
        "items": {
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "pipePrefix": {
        "default": "",
        "description": "Prefix to pipe name, pipe name is used as file name.",
        "type": "string"
      },
      "pretties": {
        "additionalProperties": false,
        "description": "Dirs that contains the translated jsons which will overwrite the go const types.",
        "patternProperties": {
          "^[a-z]{2}(-[A-Z]{2})?$": {
            "additionalProperties": false,
            "description": "Lang from langs.",
            "patternProperties": {
              "^[A-Z].*$": {
                "description": "Struct translates filepath that will overwrite all other translates.",
                "preproccess": "env",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "prettiesRoots": {
        "description": "Dirs that contains the translated jsons which will overwrite the go const types.",
        "items": {
          "preproccess": "env",
          "type": "string"
        },
        "type": "array"
      },
      "src": {
        "description": "Input go files(Glob), expand with env first.",
        "items": {
          "preproccess": "env",
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      }
    },
    "required": [
      "$tool",
      "src",
      "dist",
      "langs",
      "pipePrefix"
    ],
    "title": "go-const-ts Config",
    "type": "object"
  }
}
