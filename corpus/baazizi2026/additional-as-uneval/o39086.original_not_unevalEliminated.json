    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "$tool": {
                    "const": "to-mpeg4",
                    "description": "Must be set to to-mpeg4.",
                    "type": "string"
                  },
                  "history": {
                    "default": ".history/",
                    "description": "The history dir (relative to the pwd).",
                    "type": "string"
                  },
                  "outputOptions": {
                    "description": "Ffmpeg output options, in k-v mode ie '-vf scale=640:360'.",
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "dist": {
                    "description": "The output dir (relative to the pwd).",
                    "type": "string"
                  },
                  "src": {
                    "description": "Input go files(Glob), expand with env first. ie ~/movie/non-mp4/&#42;&#42;/&#42;.{mp4,mkv,avi,flv}",
                    "items": {
                      "preproccess": "env",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "$schema": {
                    "type": "string"
                  }
                },
                "required": [
                  "$tool",
                  "src",
                  "dist",
                  "history"
                ],
                "title": "to-mpeg4 Config",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schema$": true,
                  "^$tool$": true,
                  "^history$": true,
                  "^dist$": true,
                  "^outputOptions$": true,
                  "^src$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
