{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "const",
    "items",
    "minItems",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o39088.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39088.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Generate translate from ts interface.",
                "properties": {
                  "$tool": {
                    "const": "ts-trans",
                    "description": "Must be set to ts-trans.",
                    "type": "string"
                  },
                  "tag": {
                    "default": "tr",
                    "description": "Field with this tag content will be parsed.",
                    "type": "string"
                  },
                  "langs": {
                    "description": "Langs to exrtact. Field name will be used if lang not set.",
                    "items": {
                      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "dist": {
                    "description": "The output root path (relative to the pwd).",
                    "type": "string"
                  },
                  "src": {
                    "description": "Input go files(Glob), expand with env first.",
                    "items": {
                      "preproccess": "env",
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "pipePrefix": {
                    "default": "",
                    "description": "Prefix to pipe name, pipe name is used as file name.",
                    "type": "string"
                  },
                  "$schema": {
                    "type": "string"
                  }
                },
                "required": [
                  "$tool",
                  "src",
                  "dist",
                  "tag",
                  "langs",
                  "pipePrefix"
                ],
                "title": "ts-trans Config",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schema$": true,
                  "^$tool$": true,
                  "^dist$": true,
                  "^langs$": true,
                  "^pipePrefix$": true,
                  "^tag$": true,
                  "^src$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Generate translate from ts interface.",
    "properties": {
      "$schema": {
        "type": "string"
      },
      "$tool": {
        "const": "ts-trans",
        "description": "Must be set to ts-trans.",
        "type": "string"
      },
      "dist": {
        "description": "The output root path (relative to the pwd).",
        "type": "string"
      },
      "langs": {
        "description": "Langs to exrtact. Field name will be used if lang not set.",
        "items": {
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "pipePrefix": {
        "default": "",
        "description": "Prefix to pipe name, pipe name is used as file name.",
        "type": "string"
      },
      "src": {
        "description": "Input go files(Glob), expand with env first.",
        "items": {
          "preproccess": "env",
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "tag": {
        "default": "tr",
        "description": "Field with this tag content will be parsed.",
        "type": "string"
      }
    },
    "required": [
      "$tool",
      "src",
      "dist",
      "tag",
      "langs",
      "pipePrefix"
    ],
    "title": "ts-trans Config",
    "type": "object"
  }
}
