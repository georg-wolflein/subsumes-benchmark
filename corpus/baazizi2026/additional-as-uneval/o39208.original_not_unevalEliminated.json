{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39208.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39208.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Person",
                "type": "object",
                "properties": {
                  "name": {
                    "description": "The name of the person",
                    "type": "string",
                    "minLength": 1
                  },
                  "age": {
                    "description": "The age of the person",
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "age"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^age$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Test Schema",
                "type": "object",
                "properties": {
                  "person": {
                    "$ref": "#/$defs/personDefinition"
                  }
                }
              },
              {
                "patternProperties": {
                  "^person$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "personDefinition": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Test Schema",
    "type": "object",
    "properties": {
      "person": {
        "$ref": "#/$defs/personDefinition"
      }
    },
    "additionalProperties": false,
    "$defs": {
      "personDefinition": {
        "description": "Person",
        "type": "object",
        "properties": {
          "name": {
            "description": "The name of the person",
            "type": "string",
            "minLength": 1
          },
          "age": {
            "description": "The age of the person",
            "type": "integer"
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "age"
        ]
      }
    }
  }
}
