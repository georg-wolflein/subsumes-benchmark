{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39426.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o39426.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "CreateRepoRequest",
                "type": "object",
                "properties": {
                  "bumper": {
                    "type": "string",
                    "description": "The bumper to be used when creating a repo."
                  },
                  "scmUrl": {
                    "type": "string",
                    "description": "The URL to get the repo, if provided can help when trying to clone a repo."
                  },
                  "description": {
                    "type": "string",
                    "description": "Description of the repo."
                  },
                  "history": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/CreateHistory"
                    },
                    "description": "Seed the repo with history."
                  }
                },
                "javaName": "CreateRepoRequest"
              },
              {
                "patternProperties": {
                  "^bumper$": true,
                  "^scmUrl$": true,
                  "^description$": true,
                  "^history$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string",
                    "description": "Version of the new history."
                  },
                  "commitId": {
                    "type": "string",
                    "description": "Commit for the element in history."
                  },
                  "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "description": "An optional time for when the commit was created."
                  }
                }
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^commitId$": true,
                  "^createdAt$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "CreateHistory": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "CreateRepoRequest",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bumper": {
        "type": "string",
        "description": "The bumper to be used when creating a repo."
      },
      "scmUrl": {
        "type": "string",
        "description": "The URL to get the repo, if provided can help when trying to clone a repo."
      },
      "description": {
        "type": "string",
        "description": "Description of the repo."
      },
      "history": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/CreateHistory"
        },
        "description": "Seed the repo with history."
      }
    },
    "javaName": "CreateRepoRequest",
    "$defs": {
      "CreateHistory": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "version": {
            "type": "string",
            "description": "Version of the new history."
          },
          "commitId": {
            "type": "string",
            "description": "Commit for the element in history."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "An optional time for when the commit was created."
          }
        }
      }
    }
  }
}
