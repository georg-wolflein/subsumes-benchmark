{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o4177.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o4177.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "$schemaRef": {
                    "type": "string"
                  },
                  "header": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "message": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "$schemaRef",
                  "header",
                  "message"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schemaRef$": true,
                  "^header$": true,
                  "^message$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "gatewayTimestamp": {
                    "_format": "date-time",
                    "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
                    "type": "string"
                  },
                  "softwareName": {
                    "type": "string"
                  },
                  "softwareVersion": {
                    "type": "string"
                  },
                  "uploaderID": {
                    "type": "string"
                  }
                },
                "required": [
                  "uploaderID",
                  "softwareName",
                  "softwareVersion"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^gatewayTimestamp$": true,
                  "^softwareName$": true,
                  "^softwareVersion$": true,
                  "^uploaderID$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Contains all properties from the listed events in the client's journal minus Localised strings and the properties marked below as 'disallowed'",
                "properties": {
                  "sellPrice": {
                    "description": "Price to sell to the market",
                    "type": "integer"
                  },
                  "timestamp": {
                    "_format": "date-time",
                    "type": "string"
                  },
                  "systemName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "name": {
                    "description": "Commodity name as returned by the MarketSell entry in the Journal",
                    "minLength": 1,
                    "type": "string"
                  },
                  "stationName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "prohibited": {
                    "description": "Whether the commodity is prohibited at this station",
                    "type": "boolean"
                  },
                  "marketId": {
                    "type": "number"
                  }
                },
                "required": [
                  "systemName",
                  "stationName",
                  "timestamp",
                  "name",
                  "sellPrice",
                  "prohibited"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^sellPrice$": true,
                  "^prohibited$": true,
                  "^marketId$": true,
                  "^stationName$": true,
                  "^name$": true,
                  "^timestamp$": true,
                  "^systemName$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://eddn.edcd.io/schemas/blackmarket/1",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "$schemaRef": {
        "type": "string"
      },
      "header": {
        "additionalProperties": true,
        "properties": {
          "gatewayTimestamp": {
            "_format": "date-time",
            "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
            "type": "string"
          },
          "softwareName": {
            "type": "string"
          },
          "softwareVersion": {
            "type": "string"
          },
          "uploaderID": {
            "type": "string"
          }
        },
        "required": [
          "uploaderID",
          "softwareName",
          "softwareVersion"
        ],
        "type": "object"
      },
      "message": {
        "additionalProperties": true,
        "description": "Contains all properties from the listed events in the client's journal minus Localised strings and the properties marked below as 'disallowed'",
        "properties": {
          "marketId": {
            "type": "number"
          },
          "name": {
            "description": "Commodity name as returned by the MarketSell entry in the Journal",
            "minLength": 1,
            "type": "string"
          },
          "prohibited": {
            "description": "Whether the commodity is prohibited at this station",
            "type": "boolean"
          },
          "sellPrice": {
            "description": "Price to sell to the market",
            "type": "integer"
          },
          "stationName": {
            "minLength": 1,
            "type": "string"
          },
          "systemName": {
            "minLength": 1,
            "type": "string"
          },
          "timestamp": {
            "_format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "systemName",
          "stationName",
          "timestamp",
          "name",
          "sellPrice",
          "prohibited"
        ],
        "type": "object"
      }
    },
    "required": [
      "$schemaRef",
      "header",
      "message"
    ],
    "type": "object"
  }
}
