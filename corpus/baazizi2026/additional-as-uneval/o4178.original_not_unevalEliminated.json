{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minItems",
    "minLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o4178.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o4178.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_5": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "sellPrice": {
                    "description": "Price to sell to the market",
                    "type": "integer"
                  },
                  "stock": {
                    "type": "integer"
                  },
                  "name": {
                    "description": "Symbolic name as returned by the Companion API",
                    "minLength": 1,
                    "type": "string"
                  },
                  "stockBracket": {
                    "$ref": "#/$defs/levelType"
                  },
                  "buyPrice": {
                    "description": "Price to buy from the market",
                    "type": "integer"
                  },
                  "demandBracket": {
                    "$ref": "#/$defs/levelType"
                  },
                  "meanPrice": {
                    "type": "integer"
                  },
                  "statusFlags": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "_uniqueItems": true
                  },
                  "demand": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "meanPrice",
                  "buyPrice",
                  "stock",
                  "stockBracket",
                  "sellPrice",
                  "demand",
                  "demandBracket"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^sellPrice$": true,
                  "^buyPrice$": true,
                  "^meanPrice$": true,
                  "^name$": true,
                  "^demandBracket$": true,
                  "^demand$": true,
                  "^stockBracket$": true,
                  "^stock$": true,
                  "^statusFlags$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "$schemaRef": {
                    "type": "string"
                  },
                  "header": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "message": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "$schemaRef",
                  "header",
                  "message"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^$schemaRef$": true,
                  "^header$": true,
                  "^message$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "levelType": {
        "description": "Note: A value of \"\" indicates that the commodity is not normally sold/purchased at this station, but is currently temporarily for sale/purchase",
        "enum": [
          0,
          1,
          2,
          3,
          ""
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "gatewayTimestamp": {
                    "_format": "date-time",
                    "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
                    "type": "string"
                  },
                  "softwareName": {
                    "type": "string"
                  },
                  "softwareVersion": {
                    "type": "string"
                  },
                  "uploaderID": {
                    "type": "string"
                  }
                },
                "required": [
                  "uploaderID",
                  "softwareName",
                  "softwareVersion"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^gatewayTimestamp$": true,
                  "^softwareName$": true,
                  "^softwareVersion$": true,
                  "^uploaderID$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "stationName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "timestamp": {
                    "_format": "date-time",
                    "type": "string"
                  },
                  "systemName": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "horizons": {
                    "description": "Whether the sending Cmdr has a Horizons pass.",
                    "type": "boolean"
                  },
                  "economies": {
                    "items": {
                      "$ref": "#/$defs/modern_4"
                    },
                    "type": "array"
                  },
                  "commodities": {
                    "description": "Commodities returned by the Companion API, with illegal commodities omitted",
                    "items": {
                      "$ref": "#/$defs/modern_5"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "prohibited": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": "array",
                    "_uniqueItems": true
                  },
                  "marketId": {
                    "type": "number"
                  }
                },
                "required": [
                  "systemName",
                  "stationName",
                  "marketId",
                  "timestamp",
                  "commodities"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^prohibited$": true,
                  "^marketId$": true,
                  "^commodities$": true,
                  "^economies$": true,
                  "^timestamp$": true,
                  "^systemName$": true,
                  "^stationName$": true,
                  "^horizons$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "name": {
                    "description": "Economy type as returned by the Companion API",
                    "minLength": 1,
                    "type": "string"
                  },
                  "proportion": {
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "proportion"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^proportion$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://eddn.edcd.io/schemas/commodity/3",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "$schemaRef": {
        "type": "string"
      },
      "header": {
        "additionalProperties": true,
        "properties": {
          "gatewayTimestamp": {
            "_format": "date-time",
            "description": "Timestamp upon receipt at the gateway. If present, this property will be overwritten by the gateway; submitters are not intended to populate this property.",
            "type": "string"
          },
          "softwareName": {
            "type": "string"
          },
          "softwareVersion": {
            "type": "string"
          },
          "uploaderID": {
            "type": "string"
          }
        },
        "required": [
          "uploaderID",
          "softwareName",
          "softwareVersion"
        ],
        "type": "object"
      },
      "message": {
        "additionalProperties": false,
        "properties": {
          "commodities": {
            "description": "Commodities returned by the Companion API, with illegal commodities omitted",
            "items": {
              "additionalProperties": false,
              "properties": {
                "buyPrice": {
                  "description": "Price to buy from the market",
                  "type": "integer"
                },
                "demand": {
                  "type": "integer"
                },
                "demandBracket": {
                  "$ref": "#/$defs/levelType"
                },
                "meanPrice": {
                  "type": "integer"
                },
                "name": {
                  "description": "Symbolic name as returned by the Companion API",
                  "minLength": 1,
                  "type": "string"
                },
                "sellPrice": {
                  "description": "Price to sell to the market",
                  "type": "integer"
                },
                "statusFlags": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "_uniqueItems": true
                },
                "stock": {
                  "type": "integer"
                },
                "stockBracket": {
                  "$ref": "#/$defs/levelType"
                }
              },
              "required": [
                "name",
                "meanPrice",
                "buyPrice",
                "stock",
                "stockBracket",
                "sellPrice",
                "demand",
                "demandBracket"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "economies": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "description": "Economy type as returned by the Companion API",
                  "minLength": 1,
                  "type": "string"
                },
                "proportion": {
                  "type": "number"
                }
              },
              "required": [
                "name",
                "proportion"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "horizons": {
            "description": "Whether the sending Cmdr has a Horizons pass.",
            "type": "boolean"
          },
          "marketId": {
            "type": "number"
          },
          "prohibited": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "_uniqueItems": true
          },
          "stationName": {
            "minLength": 1,
            "type": "string"
          },
          "systemName": {
            "minLength": 1,
            "type": "string"
          },
          "timestamp": {
            "_format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "systemName",
          "stationName",
          "marketId",
          "timestamp",
          "commodities"
        ],
        "type": "object"
      }
    },
    "required": [
      "$schemaRef",
      "header",
      "message"
    ],
    "type": "object",
    "$defs": {
      "levelType": {
        "description": "Note: A value of \"\" indicates that the commodity is not normally sold/purchased at this station, but is currently temporarily for sale/purchase",
        "enum": [
          0,
          1,
          2,
          3,
          ""
        ]
      }
    }
  }
}
