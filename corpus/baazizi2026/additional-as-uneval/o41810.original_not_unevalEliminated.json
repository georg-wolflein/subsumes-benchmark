{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "minLength",
    "minProperties",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o41810.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o41810.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "patternProperties": {
                  "^[a-z]+$": {
                    "$ref": "#/$defs/modern_2"
                  }
                },
                "title": "Firefox download sources",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^[a-z]+$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "branches": {
                    "minProperties": 1,
                    "patternProperties": {
                      "nightly|beta|devedition|release|esr|unbranded-release": {
                        "$ref": "#/$defs/modern_3"
                      }
                    },
                    "type": "object"
                  },
                  "defaultBranch": {
                    "enum": [
                      "nightly",
                      "devedition",
                      "beta",
                      "release",
                      "esr",
                      "unbranded-release"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "defaultBranch",
                  "branches"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^branches$": true,
                  "^defaultBranch$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "arches": {
                    "patternProperties": {
                      "multi|x86(_64)?|arm-v15": {
                        "$ref": "#/$defs/modern_4"
                      }
                    },
                    "type": "object"
                  },
                  "defaultArch": {
                    "enum": [
                      "multi",
                      "x86",
                      "x86_64",
                      "arm-v15"
                    ],
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "classic",
                      "mdu",
                      "taskcluster"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "defaultArch",
                  "type",
                  "arches"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^arches$": true,
                  "^defaultArch$": true,
                  "^type$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "minProperties": 2,
                "properties": {
                  "path": {
                    "minLength": 3,
                    "pattern": "^[a-z0-9/-]+$",
                    "type": "string"
                  },
                  "fileEnding": {
                    "pattern": "^\\.[a-z0-9.-]+$",
                    "type": "string"
                  },
                  "version": {
                    "pattern": "^[A-Z0-9_]+$",
                    "type": "string"
                  },
                  "platform": {
                    "pattern": "^[A-Z0-9_]+$",
                    "type": "string"
                  },
                  "namespace": {
                    "minLength": 3,
                    "type": "string"
                  },
                  "product": {
                    "pattern": "^[A-Z_]+$",
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^fileEnding$": true,
                  "^product$": true,
                  "^platform$": true,
                  "^namespace$": true,
                  "^path$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "patternProperties": {
      "^[a-z]+$": {
        "additionalProperties": false,
        "properties": {
          "branches": {
            "minProperties": 1,
            "patternProperties": {
              "nightly|beta|devedition|release|esr|unbranded-release": {
                "additionalProperties": false,
                "properties": {
                  "arches": {
                    "patternProperties": {
                      "multi|x86(_64)?|arm-v15": {
                        "additionalProperties": false,
                        "minProperties": 2,
                        "properties": {
                          "fileEnding": {
                            "pattern": "^\\.[a-z0-9.-]+$",
                            "type": "string"
                          },
                          "namespace": {
                            "minLength": 3,
                            "type": "string"
                          },
                          "path": {
                            "minLength": 3,
                            "pattern": "^[a-z0-9/-]+$",
                            "type": "string"
                          },
                          "platform": {
                            "pattern": "^[A-Z0-9_]+$",
                            "type": "string"
                          },
                          "product": {
                            "pattern": "^[A-Z_]+$",
                            "type": "string"
                          },
                          "version": {
                            "pattern": "^[A-Z0-9_]+$",
                            "type": "string"
                          }
                        },
                        "type": "object"
                      }
                    },
                    "type": "object"
                  },
                  "defaultArch": {
                    "enum": [
                      "multi",
                      "x86",
                      "x86_64",
                      "arm-v15"
                    ],
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "classic",
                      "mdu",
                      "taskcluster"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "defaultArch",
                  "type",
                  "arches"
                ],
                "type": "object"
              }
            },
            "type": "object"
          },
          "defaultBranch": {
            "enum": [
              "nightly",
              "devedition",
              "beta",
              "release",
              "esr",
              "unbranded-release"
            ],
            "type": "string"
          }
        },
        "required": [
          "defaultBranch",
          "branches"
        ],
        "type": "object"
      }
    },
    "title": "Firefox download sources",
    "type": "object"
  }
}
