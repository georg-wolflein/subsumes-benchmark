    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                    "minLength": 0,
                    "maxLength": 20
                  },
                  "_schema": {
                    "type": "string",
                    "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
                    "default": "pbj:gdbots:contexts::cloud:1-0-0"
                  },
                  "region": {
                    "type": "string",
                    "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                    "minLength": 0,
                    "maxLength": 20
                  },
                  "zone": {
                    "type": "string",
                    "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
                    "minLength": 0,
                    "maxLength": 20
                  },
                  "instance_id": {
                    "type": "string",
                    "pattern": "^[\\w\\.-]+$"
                  },
                  "instance_type": {
                    "type": "string",
                    "pattern": "^[\\w\\.-]+$"
                  }
                },
                "required": [
                  "_schema"
                ]
              },
              {
                "patternProperties": {
                  "^instance_type$": true,
                  "^zone$": true,
                  "^provider$": true,
                  "^instance_id$": true,
                  "^_schema$": true,
                  "^region$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://schemas.gdbots.io/json-schema/gdbots/contexts/cloud/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "_schema": {
        "type": "string",
        "pattern": "^pbj:([a-z0-9-]+):([a-z0-9\\.-]+):([a-z0-9-]+)?:([a-z0-9-]+):([0-9]+-[0-9]+-[0-9]+)$",
        "default": "pbj:gdbots:contexts::cloud:1-0-0"
