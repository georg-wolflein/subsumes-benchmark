    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "minLength",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o42527.original_not_unevalEliminated.json",
