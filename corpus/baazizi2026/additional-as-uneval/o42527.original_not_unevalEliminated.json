        "pattern": "^([\\w\\/-]|[\\w-][\\w\\/-]*[\\w-])$",
        "minLength": 0,
        "maxLength": 20
      },
      "instance_id": {
        "type": "string",
        "pattern": "^[\\w\\.-]+$"
      },
      "instance_type": {
        "type": "string",
        "pattern": "^[\\w\\.-]+$"
      }
