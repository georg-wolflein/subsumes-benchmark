{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o43042.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o43042.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "avalon-core:subset-3.0",
                "description": "A container of instances",
                "type": "object",
                "required": [
                  "schema",
                  "type",
                  "parent",
                  "name",
                  "data"
                ],
                "properties": {
                  "parent": {
                    "description": "Unique identifier to parent document",
                    "example": "592c33475f8c1b064c4d1696"
                  },
                  "name": {
                    "description": "Name of directory",
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_.]*$",
                    "example": "shot01"
                  },
                  "data": {
                    "description": "Document metadata",
                    "type": "object",
                    "required": [
                      "families"
                    ],
                    "properties": {
                      "families": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "description": "One or more families associated with this subset"
                      }
                    },
                    "example": {
                      "families": [
                        "avalon.camera"
                      ],
                      "frameStart": 1000,
                      "frameEnd": 1201
                    }
                  },
                  "schema": {
                    "description": "The schema associated with this document",
                    "type": "string",
                    "enum": [
                      "avalon-core:subset-3.0"
                    ],
                    "example": "avalon-core:subset-3.0"
                  },
                  "type": {
                    "description": "The type of document",
                    "type": "string",
                    "enum": [
                      "subset"
                    ],
                    "example": "subset"
                  }
                }
              },
              {
                "patternProperties": {
                  "^schema$": true,
                  "^name$": true,
                  "^type$": true,
                  "^parent$": true,
                  "^data$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "avalon-core:subset-3.0",
    "description": "A container of instances",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "schema",
      "type",
      "parent",
      "name",
      "data"
    ],
    "properties": {
      "schema": {
        "description": "The schema associated with this document",
        "type": "string",
        "enum": [
          "avalon-core:subset-3.0"
        ],
        "example": "avalon-core:subset-3.0"
      },
      "type": {
        "description": "The type of document",
        "type": "string",
        "enum": [
          "subset"
        ],
        "example": "subset"
      },
      "parent": {
        "description": "Unique identifier to parent document",
        "example": "592c33475f8c1b064c4d1696"
      },
      "name": {
        "description": "Name of directory",
        "type": "string",
        "pattern": "^[a-zA-Z0-9_.]*$",
        "example": "shot01"
      },
      "data": {
        "description": "Document metadata",
        "type": "object",
        "required": [
          "families"
        ],
        "properties": {
          "families": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One or more families associated with this subset"
          }
        },
        "example": {
          "families": [
            "avalon.camera"
          ],
          "frameStart": 1000,
          "frameEnd": 1201
        }
      }
    }
  }
}
