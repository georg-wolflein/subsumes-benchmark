{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o46220.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o46220.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "items": {
                  "properties": {
                    "key": {
                      "title": "Key/Attribute",
                      "type": "string"
                    },
                    "value": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "$ref": "#/$defs/modern_2"
                        }
                      ],
                      "title": "Value"
                    }
                  },
                  "type": "object"
                },
                "title": "Parameter Selection",
                "type": "array"
              },
              {
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "unwrap": {
                    "type": "boolean"
                  },
                  "output": {
                    "type": "string"
                  },
                  "expression_type": {
                    "default": "stage-output-selector",
                    "enum": [
                      "stage-output-selector"
                    ],
                    "type": "string"
                  },
                  "flatten": {
                    "type": "boolean"
                  },
                  "stages": {
                    "type": "string"
                  }
                },
                "required": [
                  "expression_type"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^stages$": true,
                  "^output$": true,
                  "^expression_type$": true,
                  "^unwrap$": true,
                  "^flatten$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "items": {
      "properties": {
        "key": {
          "title": "Key/Attribute",
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "additionalProperties": false,
              "properties": {
                "expression_type": {
                  "default": "stage-output-selector",
                  "enum": [
                    "stage-output-selector"
                  ],
                  "type": "string"
                },
                "flatten": {
                  "type": "boolean"
                },
                "output": {
                  "type": "string"
                },
                "stages": {
                  "type": "string"
                },
                "unwrap": {
                  "type": "boolean"
                }
              },
              "required": [
                "expression_type"
              ],
              "type": "object"
            }
          ],
          "title": "Value"
        }
      },
      "type": "object"
    },
    "title": "Parameter Selection",
    "type": "array"
  }
}
