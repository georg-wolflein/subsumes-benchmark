{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o49200.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o49200.unevalEliminated_not_original.json"
  ],
  "a": {
    "$id": "http://jerzual.github.io/azimut/config.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "title": "ConfigurationSchema",
                "required": [
                  "backendurl"
                ],
                "description": "Environment configuration",
                "properties": {
                  "backendUrl": {
                    "type": "string",
                    "default": "",
                    "examples": [
                      "http://azimut_server"
                    ],
                    "description": "Base url",
                    "pattern": "^https?://(.*)$"
                  },
                  "databaseHost": {
                    "type": "string",
                    "description": "host of couchdb",
                    "default": ""
                  }
                }
              },
              {
                "patternProperties": {
                  "^backendUrl$": true,
                  "^databaseHost$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://jerzual.github.io/azimut/config.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "ConfigurationSchema",
    "required": [
      "backendurl"
    ],
    "description": "Environment configuration",
    "additionalProperties": false,
    "properties": {
      "backendUrl": {
        "type": "string",
        "default": "",
        "examples": [
          "http://azimut_server"
        ],
        "description": "Base url",
        "pattern": "^https?://(.*)$"
      },
      "databaseHost": {
        "type": "string",
        "description": "host of couchdb",
        "default": ""
      }
    }
  }
}
