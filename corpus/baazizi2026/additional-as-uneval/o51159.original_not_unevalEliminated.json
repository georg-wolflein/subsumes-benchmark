{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o51159.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o51159.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Credit card with or without security code",
    "properties": {
      "creditcard": {
        "oneOf": [
          {
            "$ref": "#/$defs/modern_1"
          },
          {
            "$ref": "#/$defs/modern_2"
          }
        ]
      }
    },
    "title": "Credit card validation",
    "type": "object",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "provider": {
                    "enum": [
                      "mastercard"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "provider"
                ]
              },
              {
                "patternProperties": {
                  "^provider$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "provider": {
                    "enum": [
                      "visa"
                    ],
                    "type": "string"
                  },
                  "securitycode": {
                    "type": "integer"
                  }
                },
                "required": [
                  "provider",
                  "securitycode"
                ]
              },
              {
                "patternProperties": {
                  "^provider$": true,
                  "^securitycode$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Credit card with or without security code",
    "properties": {
      "creditcard": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "provider": {
                "enum": [
                  "mastercard"
                ],
                "type": "string"
              }
            },
            "required": [
              "provider"
            ]
          },
          {
            "additionalProperties": false,
            "properties": {
              "provider": {
                "enum": [
                  "visa"
                ],
                "type": "string"
              },
              "securitycode": {
                "type": "integer"
              }
            },
            "required": [
              "provider",
              "securitycode"
            ]
          }
        ]
      }
    },
    "title": "Credit card validation",
    "type": "object"
  }
}
