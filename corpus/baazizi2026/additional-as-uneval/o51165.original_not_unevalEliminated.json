{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o51165.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o51165.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "JSON schema for the tested configuration files",
                "type": "object",
                "properties": {
                  "tests": {
                    "description": "The directory where the codelytics rules live",
                    "type": "object",
                    "anyOf": [
                      {
                        "$ref": "#/$defs/includeDefinition"
                      },
                      {
                        "$ref": "#/$defs/excludeDefinition"
                      }
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^tests$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "excludeDefinition": {
        "properties": {
          "exclude": {
            "description": "Specifies a list globs that need to be excluded from compilation. The 'exclude' property only affects the files included via the 'include' property",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "includeDefinition": {
        "properties": {
          "include": {
            "description": "Specifies a list of glob patterns that match files to be included in compilation.",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "JSON schema for the tested configuration files",
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "tests": {
        "description": "The directory where the codelytics rules live",
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/$defs/includeDefinition"
          },
          {
            "$ref": "#/$defs/excludeDefinition"
          }
        ]
      }
    },
    "$defs": {
      "includeDefinition": {
        "properties": {
          "include": {
            "description": "Specifies a list of glob patterns that match files to be included in compilation.",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "excludeDefinition": {
        "properties": {
          "exclude": {
            "description": "Specifies a list globs that need to be excluded from compilation. The 'exclude' property only affects the files included via the 'include' property",
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      }
    }
  }
}
