{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "exclusiveMinimum",
    "items",
    "minItems",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o53085.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o53085.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "basic schema from z-schema benchmark (https://github.com/zaggino/z-schema)",
    "items": {
      "$ref": "#/$defs/modern_1"
    },
    "title": "Product set",
    "type": "array",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "tags": {
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "_uniqueItems": true
                  },
                  "price": {
                    "exclusiveMinimum": 0.0,
                    "type": "number"
                  },
                  "id": {
                    "description": "The unique identifier for a product",
                    "type": "number"
                  },
                  "dimensions": {
                    "properties": {
                      "height": {
                        "type": "number"
                      },
                      "length": {
                        "type": "number"
                      },
                      "width": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "length",
                      "width",
                      "height"
                    ],
                    "type": "object"
                  },
                  "warehouseLocation": {
                    "description": "Coordinates of the warehouse with the product"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "price"
                ],
                "title": "Product",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^warehouseLocation$": true,
                  "^name$": true,
                  "^id$": true,
                  "^price$": true,
                  "^tags$": true,
                  "^dimensions$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "basic schema from z-schema benchmark (https://github.com/zaggino/z-schema)",
    "items": {
      "additionalProperties": false,
      "properties": {
        "dimensions": {
          "properties": {
            "height": {
              "type": "number"
            },
            "length": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": [
            "length",
            "width",
            "height"
          ],
          "type": "object"
        },
        "id": {
          "description": "The unique identifier for a product",
          "type": "number"
        },
        "name": {
          "type": "string"
        },
        "price": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "_uniqueItems": true
        },
        "warehouseLocation": {
          "description": "Coordinates of the warehouse with the product"
        }
      },
      "required": [
        "id",
        "name",
        "price"
      ],
      "title": "Product",
      "type": "object"
    },
    "title": "Product set",
    "type": "array"
  }
}
