  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o56020.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o56020.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Fibaro Home Center User JSON Schema",
                "name": "user",
                "type": "object",
                "properties": {
                  "tracking": {
                    "description": "How frequently GPS position from the user's iPhone should be collected [min]",
                    "type": "integer"
                  },
                  "usePin": {
                    "description": "Use PIN Flag",
                    "type": "boolean"
                  },
                  "type": {
                    "description": "Type of the user",
                    "type": "string",
                    "enum": [
                      "user",
                      "superuser"
                    ]
                  },
                  "pin": {
                    "description": "PIN instead of a password for confirmations",
                    "type": "string"
                  },
                  "password": {
                    "description": "Password",
                    "type": "string"
                  },
                  "name": {
                    "description": "Name of the user",
                    "type": "string",
                    "maxLength": 20
                  },
                  "hotelRoom": {
                    "description": "Hotel room number",
                    "type": "integer"
                  },
                  "email": {
                    "description": "Email of the user",
                    "type": "string",
                    "format": "email"
                  },
                  "sceneRights": {
                    "description": "List of Scenes Visible for User",
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0.0
                    }
                  },
                  "deviceRights": {
                    "description": "List of Devices Visible for User",
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0.0
                    }
                  },
                  "useOptionalArmPin": {
                    "description": "Use Optional Arm PIN Falg",
                    "type": "boolean"
                  },
                  "id": {
                    "description": "Identifier for the user",
                    "type": "integer",
                    "minimum": 0.0
                  },
                  "hasGPS": {
                    "description": "User has GPS Flag",
                    "type": "boolean"
                  },
                  "sendNotifications": {
                    "description": "Shall Fibaro send notifications",
                    "type": "boolean"
                  }
                },
                "required": [
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^sendNotifications$": true,
                  "^useOptionalArmPin$": true,
                  "^sceneRights$": true,
                  "^hotelRoom$": true,
                  "^name$": true,
                  "^id$": true,
                  "^usePin$": true,
                  "^hasGPS$": true,
                  "^tracking$": true,
                  "^email$": true,
                  "^deviceRights$": true,
                  "^pin$": true,
                  "^type$": true,
                  "^password$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Fibaro Home Center User JSON Schema",
    "name": "user",
    "type": "object",
    "properties": {
      "id": {
        "description": "Identifier for the user",
        "type": "integer",
        "minimum": 0
      },
      "name": {
        "description": "Name of the user",
        "type": "string",
        "maxLength": 20
      },
      "type": {
        "description": "Type of the user",
        "type": "string",
        "enum": [
          "user",
          "superuser"
        ]
      },
      "email": {
        "description": "Email of the user",
        "type": "string",
        "format": "email"
      },
      "hasGPS": {
        "description": "User has GPS Flag",
        "type": "boolean"
      },
      "deviceRights": {
        "description": "List of Devices Visible for User",
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        }
      },
      "sceneRights": {
        "description": "List of Scenes Visible for User",
        "type": "array",
        "items": {
          "type": "number",
          "minimum": 0
        }
      },
      "hotelRoom": {
        "description": "Hotel room number",
        "type": "integer"
      },
      "sendNotifications": {
        "description": "Shall Fibaro send notifications",
        "type": "boolean"
      },
      "tracking": {
        "description": "How frequently GPS position from the user's iPhone should be collected [min]",
        "type": "integer"
      },
      "usePin": {
        "description": "Use PIN Flag",
        "type": "boolean"
      },
      "useOptionalArmPin": {
        "description": "Use Optional Arm PIN Falg",
        "type": "boolean"
      },
      "pin": {
        "description": "PIN instead of a password for confirmations",
        "type": "string"
      },
      "password": {
        "description": "Password",
        "type": "string"
      }
    },
    "required": [
