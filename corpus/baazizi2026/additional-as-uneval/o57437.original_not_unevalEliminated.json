            "email": {
              "type": "string",
              "description": "Contact email for the purpose of this specific record.",
              "format": "email"
            },
            "role": {
              "description": "",
              "type": "string",
              "enum": [
                "ContactPerson",
                "Researcher",
                "Other"
              ]
            }
          },
          "required": [
            "name"
          ]
        }
