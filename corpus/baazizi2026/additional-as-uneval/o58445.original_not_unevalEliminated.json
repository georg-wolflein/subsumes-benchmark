  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Extract i18n Target",
                "description": "Extract i18n target options for Build Facade.",
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "description": "Output format for the generated file.",
                    "default": "xlf",
                    "enum": [
                      "xmb",
                      "xlf",
                      "xlif",
                      "xliff",
                      "xlf2",
                      "xliff2"
                    ]
                  },
                  "outFile": {
                    "type": "string",
                    "description": "Name of the file to output."
                  },
                  "i18nFormat": {
                    "type": "string",
                    "description": "Output format for the generated file.",
                    "default": "xlf",
                    "x-deprecated": "Use 'format' option instead.",
                    "enum": [
                      "xmb",
                      "xlf",
                      "xlif",
                      "xliff",
                      "xlf2",
                      "xliff2"
                    ]
                  },
                  "progress": {
                    "type": "boolean",
                    "description": "Log progress to the console.",
                    "default": true
                  },
                  "outputPath": {
                    "type": "string",
                    "description": "Path where output will be placed."
                  },
                  "browserTarget": {
                    "type": "string",
                    "description": "Target to extract from.",
                    "pattern": "^[^:\\s]+:[^:\\s]+(:[^\\s]+)?$"
                  },
                  "i18nLocale": {
                    "type": "string",
                    "description": "Specifies the source language of the application.",
                    "x-deprecated": "Use 'i18n' project level sub-option 'sourceLocale' instead."
                  }
                },
                "required": [
                  "browserTarget"
                ]
              },
              {
                "patternProperties": {
                  "^progress$": true,
                  "^browserTarget$": true,
                  "^format$": true,
                  "^outFile$": true,
                  "^i18nFormat$": true,
                  "^outputPath$": true,
                  "^i18nLocale$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Extract i18n Target",
    "description": "Extract i18n target options for Build Facade.",
    "type": "object",
    "properties": {
      "browserTarget": {
        "type": "string",
        "description": "Target to extract from.",
        "pattern": "^[^:\\s]+:[^:\\s]+(:[^\\s]+)?$"
      },
      "format": {
        "type": "string",
        "description": "Output format for the generated file.",
        "default": "xlf",
        "enum": [
          "xmb",
          "xlf",
          "xlif",
          "xliff",
          "xlf2",
          "xliff2"
        ]
      },
      "i18nFormat": {
        "type": "string",
        "description": "Output format for the generated file.",
        "default": "xlf",
        "x-deprecated": "Use 'format' option instead.",
        "enum": [
          "xmb",
          "xlf",
          "xlif",
          "xliff",
          "xlf2",
          "xliff2"
        ]
      },
      "i18nLocale": {
        "type": "string",
        "description": "Specifies the source language of the application.",
        "x-deprecated": "Use 'i18n' project level sub-option 'sourceLocale' instead."
      },
      "progress": {
        "type": "boolean",
        "description": "Log progress to the console.",
        "default": true
      },
      "outputPath": {
        "type": "string",
        "description": "Path where output will be placed."
      },
      "outFile": {
        "type": "string",
        "description": "Name of the file to output."
      }
    },
    "additionalProperties": false,
    "required": [
      "browserTarget"
    ]
  }
}
