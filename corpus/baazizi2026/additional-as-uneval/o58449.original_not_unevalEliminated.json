{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minLength",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o58449.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o58449.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "TSlint Target",
                "description": "TSlint target options for Build Facade.",
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "description": "Output format (prose, json, stylish, verbose, pmd, msbuild, checkstyle, vso, fileslist).",
                    "default": "stylish",
                    "anyOf": [
                      {
                        "enum": [
                          "checkstyle",
                          "codeFrame",
                          "filesList",
                          "json",
                          "junit",
                          "msbuild",
                          "pmd",
                          "prose",
                          "stylish",
                          "tap",
                          "verbose",
                          "vso"
                        ]
                      },
                      {
                        "minLength": 1
                      }
                    ]
                  },
                  "force": {
                    "type": "boolean",
                    "description": "Succeeds even if there was linting errors.",
                    "default": false
                  },
                  "silent": {
                    "type": "boolean",
                    "description": "Show output text.",
                    "default": false
                  },
                  "fix": {
                    "type": "boolean",
                    "description": "Fixes linting errors (may overwrite linted files).",
                    "default": false
                  },
                  "files": {
                    "type": "array",
                    "description": "Files to include in linting.",
                    "default": [],
                    "items": {
                      "type": "string"
                    }
                  },
                  "tslintConfig": {
                    "type": "string",
                    "description": "The name of the TSLint configuration file."
                  },
                  "typeCheck": {
                    "type": "boolean",
                    "description": "Controls the type check for linting.",
                    "default": false
                  },
                  "exclude": {
                    "type": "array",
                    "description": "Files to exclude from linting.",
                    "default": [],
                    "items": {
                      "type": "string"
                    }
                  },
                  "tsConfig": {
                    "description": "The name of the TypeScript configuration file.",
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  }
                },
                "required": []
              },
              {
                "patternProperties": {
                  "^tsConfig$": true,
                  "^fix$": true,
                  "^files$": true,
                  "^format$": true,
                  "^silent$": true,
                  "^typeCheck$": true,
                  "^force$": true,
                  "^tslintConfig$": true,
                  "^exclude$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TSlint Target",
    "description": "TSlint target options for Build Facade.",
    "type": "object",
    "properties": {
      "tslintConfig": {
        "type": "string",
        "description": "The name of the TSLint configuration file."
      },
      "tsConfig": {
        "description": "The name of the TypeScript configuration file.",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      },
      "fix": {
        "type": "boolean",
        "description": "Fixes linting errors (may overwrite linted files).",
        "default": false
      },
      "typeCheck": {
        "type": "boolean",
        "description": "Controls the type check for linting.",
        "default": false
      },
      "force": {
        "type": "boolean",
        "description": "Succeeds even if there was linting errors.",
        "default": false
      },
      "silent": {
        "type": "boolean",
        "description": "Show output text.",
        "default": false
      },
      "format": {
        "type": "string",
        "description": "Output format (prose, json, stylish, verbose, pmd, msbuild, checkstyle, vso, fileslist).",
        "default": "stylish",
        "anyOf": [
          {
            "enum": [
              "checkstyle",
              "codeFrame",
              "filesList",
              "json",
              "junit",
              "msbuild",
              "pmd",
              "prose",
              "stylish",
              "tap",
              "verbose",
              "vso"
            ]
          },
          {
            "minLength": 1
          }
        ]
      },
      "exclude": {
        "type": "array",
        "description": "Files to exclude from linting.",
        "default": [],
        "items": {
          "type": "string"
        }
      },
      "files": {
        "type": "array",
        "description": "Files to include in linting.",
        "default": [],
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": false,
    "required": []
  }
}
