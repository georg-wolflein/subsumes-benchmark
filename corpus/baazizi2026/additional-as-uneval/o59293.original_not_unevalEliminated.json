{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o59293.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o59293.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "local",
                  "targets"
                ],
                "properties": {
                  "local": {
                    "$ref": "#/$defs/localTarget"
                  },
                  "targets": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^local$": true,
                  "^targets$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "localTarget": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "defaultTarget": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "deleteRemoteFiles": {
            "type": "boolean",
            "default": false
          },
          "files": {
            "type": "string",
            "default": "**/**"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          }
        }
      },
      "remoteTarget": {
        "type": "object",
        "required": [
          "host",
          "path",
          "user"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "prompt": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ],
            "default": true
          },
          "cache": {
            "type": "string",
            "description": "Name of checksum list file. (Default = '.synco-filelist')",
            "default": ".synco-filelist"
          },
          "port": {
            "type": "number",
            "description": "(Default = 21)",
            "default": 21
          },
          "pass": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "(reservered for future use)"
          },
          "user": {
            "type": "string"
          }
        }
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/remoteTarget"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "https://raw.githubusercontent.com/mattmccray/syncodemayo/master/config.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "local",
      "targets"
    ],
    "properties": {
      "local": {
        "$ref": "#/$defs/localTarget"
      },
      "targets": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/remoteTarget"
        }
      }
    },
    "additionalProperties": true,
    "$defs": {
      "localTarget": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "files": {
            "type": "string",
            "default": "**/**"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "defaultTarget": {
            "type": "string"
          },
          "deleteRemoteFiles": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "remoteTarget": {
        "type": "object",
        "required": [
          "host",
          "path",
          "user"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "pass": {
            "type": "string"
          },
          "port": {
            "type": "number",
            "description": "(Default = 21)",
            "default": 21
          },
          "cache": {
            "type": "string",
            "description": "Name of checksum list file. (Default = '.synco-filelist')",
            "default": ".synco-filelist"
          },
          "prompt": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ],
            "default": true
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "type": {
            "type": "string",
            "description": "(reservered for future use)"
          }
        }
      }
    }
  }
}
