{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maxLength",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o6022.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o6022.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "x": {
                    "description": "in SVG coordinates",
                    "type": "number"
                  },
                  "char": {
                    "description": "keycode",
                    "oneOf": [
                      {
                        "type": "null"
                      },
                      {
                        "maxLength": 20,
                        "type": "string"
                      }
                    ]
                  },
                  "element": {
                    "description": "id attribute",
                    "pattern": "^[a-f][a-f0-9]{31}$",
                    "type": "string"
                  },
                  "time": {
                    "description": "millis per Date.getTime",
                    "type": "integer"
                  },
                  "active": {
                    "description": "e.g. mouse button is down",
                    "type": "boolean"
                  },
                  "y": {
                    "description": "in SVG coordinates",
                    "type": "number"
                  },
                  "tool": {
                    "enum": [
                      "Pen",
                      "Hand",
                      "Eraser"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "time",
                  "tool",
                  "active"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^char$": true,
                  "^tool$": true,
                  "^x$": true,
                  "^active$": true,
                  "^time$": true,
                  "^element$": true,
                  "^y$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "active": {
        "description": "e.g. mouse button is down",
        "type": "boolean"
      },
      "char": {
        "description": "keycode",
        "oneOf": [
          {
            "type": "null"
          },
          {
            "maxLength": 20,
            "type": "string"
          }
        ]
      },
      "element": {
        "description": "id attribute",
        "pattern": "^[a-f][a-f0-9]{31}$",
        "type": "string"
      },
      "time": {
        "description": "millis per Date.getTime",
        "type": "integer"
      },
      "tool": {
        "enum": [
          "Pen",
          "Hand",
          "Eraser"
        ],
        "type": "string"
      },
      "x": {
        "description": "in SVG coordinates",
        "type": "number"
      },
      "y": {
        "description": "in SVG coordinates",
        "type": "number"
      }
    },
    "required": [
      "time",
      "tool",
      "active"
    ],
    "type": "object"
  }
}
