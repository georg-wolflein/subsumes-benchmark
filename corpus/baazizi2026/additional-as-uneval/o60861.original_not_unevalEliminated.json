{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60861.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o60861.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "avalon-core:application-1.0",
                "description": "An application definition.",
                "type": "object",
                "required": [
                  "schema",
                  "label",
                  "application_dir",
                  "executable"
                ],
                "properties": {
                  "label": {
                    "description": "Nice name of application.",
                    "type": "string"
                  },
                  "schema": {
                    "description": "Schema identifier for payload",
                    "type": "string"
                  },
                  "environment": {
                    "description": "Key/value pairs for environment variables related to this application. Supports lists for paths, such as PYTHONPATH.",
                    "type": "object",
                    "items": {
                      "oneOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      ]
                    }
                  },
                  "copy": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "application_dir": {
                    "description": "Name of directory used for application resources.",
                    "type": "string"
                  },
                  "executable": {
                    "description": "Name of callable executable, this is called to launch the application",
                    "type": "string"
                  },
                  "description": {
                    "description": "Description of application.",
                    "type": "string"
                  },
                  "default_dirs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^executable$": true,
                  "^schema$": true,
                  "^default_dirs$": true,
                  "^copy$": true,
                  "^description$": true,
                  "^environment$": true,
                  "^label$": true,
                  "^application_dir$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^.*$": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^.*$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "avalon-core:application-1.0",
    "description": "An application definition.",
    "type": "object",
    "additionalProperties": true,
    "required": [
      "schema",
      "label",
      "application_dir",
      "executable"
    ],
    "properties": {
      "schema": {
        "description": "Schema identifier for payload",
        "type": "string"
      },
      "label": {
        "description": "Nice name of application.",
        "type": "string"
      },
      "application_dir": {
        "description": "Name of directory used for application resources.",
        "type": "string"
      },
      "executable": {
        "description": "Name of callable executable, this is called to launch the application",
        "type": "string"
      },
      "description": {
        "description": "Description of application.",
        "type": "string"
      },
      "environment": {
        "description": "Key/value pairs for environment variables related to this application. Supports lists for paths, such as PYTHONPATH.",
        "type": "object",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        }
      },
      "default_dirs": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "copy": {
        "type": "object",
        "patternProperties": {
          "^.*$": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
