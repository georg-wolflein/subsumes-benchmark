                  },
                  "flavors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^sha$": true,
                  "^formats$": true,
                  "^flavors$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^(gz|raw)$": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              {
                "patternProperties": {
                  "^(gz|raw)$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 0.0
                  }
                },
                "required": [
                  "size"
                ]
              },
              {
                "patternProperties": {
                  "^size$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://mindsnacks.github.io/Zinc/schemas/v1/manifest.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
