                  "files": {
                    "type": "object",
                    "patternProperties": {
                      ".+": {
                        "$ref": "#/$defs/modern_2"
                      }
                    }
                  },
                  "version": {
                    "type": "integer",
                    "minimum": 1.0
                  },
                  "catalog": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bundle": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^format$": true,
                  "^flavors$": true,
                  "^catalog$": true,
                  "^files$": true,
                  "^bundle$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
