                  "catalog",
                  "bundle",
                  "version",
                  "files"
                ],
                "properties": {
                  "format": {
                    "type": "string",
                    "pattern": "1"
                  },
                  "flavors": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
