                  "^ip$": true,
                  "^port$": true,
                  "^password$": true,
                  "^status$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "connected",
          "connecting",
          "disconnected",
          "error"
        ],
        "default": "disconnected"
      }
    }
