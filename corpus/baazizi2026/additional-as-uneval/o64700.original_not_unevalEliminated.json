{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o64700.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o64700.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "project description file",
                "name": "Module",
                "properties": {
                  "require": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "path": {
                    "type": "object",
                    "description": "path config",
                    "properties": {
                      "modules": {
                        "type": "string",
                        "description": "modules path"
                      },
                      "applications": {
                        "type": "string",
                        "description": "applications path"
                      }
                    }
                  }
                },
                "required": [
                  "require",
                  "path"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^require$": true,
                  "^path$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "This is a hash of module name (keys) and version constraints (values) that are required to run this module."
              },
              {
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "project description file",
    "name": "Module",
    "properties": {
      "require": {
        "type": "object",
        "description": "This is a hash of module name (keys) and version constraints (values) that are required to run this module.",
        "additionalProperties": {
          "type": "string"
        }
      },
      "path": {
        "type": "object",
        "description": "path config",
        "properties": {
          "modules": {
            "type": "string",
            "description": "modules path"
          },
          "applications": {
            "type": "string",
            "description": "applications path"
          }
        }
      }
    },
    "required": [
      "require",
      "path"
    ],
    "type": "object"
  }
}
