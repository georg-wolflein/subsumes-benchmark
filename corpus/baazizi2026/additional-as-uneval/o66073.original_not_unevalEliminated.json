  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Object install-if-different property",
    "description": "This property handles when an object should be installed on target",
    "oneOf": [
      {
        "title": "sha256sum verification type",
        "description": "Installs if sha256sum doesn't match",
        "type": "string",
        "enum": [
          "sha256sum"
        ]
      },
      {
        "$ref": "#/$defs/modern_1"
      },
      {
        "$ref": "#/$defs/modern_2"
      }
    ],
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Known patterns verification type",
                "description": "Installs if version of know object type is different",
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string"
                  },
                  "pattern": {
                    "type": "string",
                    "enum": [
                      "linux-kernel",
                      "u-boot"
                    ]
                  }
                },
                "required": [
                  "version",
                  "pattern"
                ]
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^pattern$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Custom pattern verification type",
                "description": "Installs if version of unknow object type is different",
                "type": "object",
                "properties": {
                  "version": {
                    "type": "string"
                  },
                  "pattern": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "version",
                  "pattern"
                ]
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^pattern$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "regexp": {
                    "description": "the pattern to match",
                    "type": "string"
                  },
                  "seek": {
                    "description": "Where to start reading file.",
                    "type": "integer",
                    "default": 0
                  },
                  "buffer-size": {
                    "description": "How much bytes must be read. If -1, until the end.",
                    "type": "integer",
                    "default": -1
                  }
                },
                "required": [
                  "regexp"
                ]
              },
              {
                "patternProperties": {
                  "^regexp$": true,
                  "^seek$": true,
                  "^buffer-size$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
