{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "minimum",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/sat/o66204.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o66204.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "PaperHive annotation schema for POSTing",
                "type": "object",
                "properties": {
                  "$schema": {
                    "enum": [
                      "http://paperhive.org/api/v0/schemas/annotation_post.json#"
                    ]
                  },
                  "publication_id": {
                    "type": "string"
                  },
                  "target": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/modern_2"
                      }
                    ]
                  },
                  "body": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "publication_id",
                  "target",
                  "body"
                ]
              },
              {
                "patternProperties": {
                  "^$schema$": true,
                  "^publication_id$": true,
                  "^target$": true,
                  "^body$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "page": {
                    "type": "integer",
                    "minimum": 1.0
                  },
                  "h": {
                    "type": "number"
                  },
                  "type": {
                    "enum": [
                      "FragmentSelector"
                    ]
                  },
                  "w": {
                    "type": "number"
                  }
                },
                "required": [
                  "type",
                  "page",
                  "x",
                  "y",
                  "w",
                  "h"
                ]
              },
              {
                "patternProperties": {
                  "^page$": true,
                  "^x$": true,
                  "^type$": true,
                  "^w$": true,
                  "^h$": true,
                  "^y$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "enum": [
                      "markdown"
                    ]
                  },
                  "value": {
                    "type": "string"
                  },
                  "language": {
                    "type": "string"
                  }
                },
                "required": [
                  "type",
                  "value"
                ]
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^value$": true,
                  "^language$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://paperhive.org/api/v0/schemas/annotation_post.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "PaperHive annotation schema for POSTing",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "$schema": {
        "enum": [
          "http://paperhive.org/api/v0/schemas/annotation_post.json#"
        ]
      },
      "publication_id": {
        "type": "string"
      },
      "target": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": {
                "enum": [
                  "FragmentSelector"
                ]
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "w": {
                "type": "number"
              },
              "h": {
                "type": "number"
              }
            },
            "required": [
              "type",
              "page",
              "x",
              "y",
              "w",
              "h"
            ]
          }
        ]
      },
      "body": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "markdown"
            ]
          },
          "value": {
            "type": "string"
          },
          "language": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "value"
        ]
      }
    },
    "required": [
      "publication_id",
      "target",
      "body"
    ]
  }
}
