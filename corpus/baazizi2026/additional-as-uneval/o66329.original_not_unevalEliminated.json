{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o66329.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o66329.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "This is validation for file metadata fields that the OSF allows to be edited by the user. These fields will match the fields presented to the user on a file metadata form on the OSF.",
                "properties": {
                  "file_description": {
                    "description": "The description of the file",
                    "type": "string"
                  },
                  "funders": {
                    "description": "Funders responsible for funding the resource.",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "type": "array"
                  },
                  "related_publication_doi": {
                    "description": "The DOI of a related resource.",
                    "pattern": "10\\..+/.+",
                    "type": "string"
                  },
                  "resource_type": {
                    "enum": [
                      "Audio/Video",
                      "Dataset",
                      "Image",
                      "Model",
                      "Software",
                      "Book",
                      "Funding Submission",
                      "Journal Article",
                      "Lesson",
                      "Poster",
                      "Preprint",
                      "Presentation",
                      "Research Tool",
                      "Thesis",
                      "Other"
                    ],
                    "type": "string"
                  }
                },
                "title": "OSF Specific Fields for the Datacite Schema",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^file_description$": true,
                  "^funders$": true,
                  "^related_publication_doi$": true,
                  "^resource_type$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "funding_agency": {
                    "description": "The name of the funding provider",
                    "type": "string"
                  },
                  "grant_number": {
                    "description": "The code assigned by the funder to a sponsored award (grant).",
                    "type": "string"
                  }
                },
                "required": [
                  "funding_agency"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^funding_agency$": true,
                  "^grant_number$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "This is validation for file metadata fields that the OSF allows to be edited by the user. These fields will match the fields presented to the user on a file metadata form on the OSF.",
    "properties": {
      "file_description": {
        "description": "The description of the file",
        "type": "string"
      },
      "funders": {
        "description": "Funders responsible for funding the resource.",
        "items": {
          "additionalProperties": false,
          "properties": {
            "funding_agency": {
              "description": "The name of the funding provider",
              "type": "string"
            },
            "grant_number": {
              "description": "The code assigned by the funder to a sponsored award (grant).",
              "type": "string"
            }
          },
          "required": [
            "funding_agency"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "related_publication_doi": {
        "description": "The DOI of a related resource.",
        "pattern": "10\\..+/.+",
        "type": "string"
      },
      "resource_type": {
        "enum": [
          "Audio/Video",
          "Dataset",
          "Image",
          "Model",
          "Software",
          "Book",
          "Funding Submission",
          "Journal Article",
          "Lesson",
          "Poster",
          "Preprint",
          "Presentation",
          "Research Tool",
          "Thesis",
          "Other"
        ],
        "type": "string"
      }
    },
    "title": "OSF Specific Fields for the Datacite Schema",
    "type": "object"
  }
}
