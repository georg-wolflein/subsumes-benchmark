{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "minItems",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o67274.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o67274.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Resolver Package Repository",
                "type": "object",
                "required": [
                  "name",
                  "description",
                  "homepage"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The name of the repository."
                  },
                  "auth": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "description": {
                    "type": "string",
                    "description": "The description of the repository."
                  },
                  "web_template": {
                    "type": "string",
                    "description": "The template to use when generating HTML. This can be a name or a path to a template."
                  },
                  "web_target": {
                    "type": "string",
                    "description": "The directory where the generated HTML will be stored."
                  },
                  "package_target": {
                    "type": "string",
                    "description": "The directory where the resolver-packages.json file should be generated."
                  },
                  "homepage": {
                    "type": "string",
                    "description": "The url of the repository."
                  },
                  "packages": {
                    "type": "array",
                    "description": "The list with packages that exists.",
                    "minItems": 1,
                    "_uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/modern_3"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^description$": true,
                  "^web_template$": true,
                  "^homepage$": true,
                  "^name$": true,
                  "^web_target$": true,
                  "^packages$": true,
                  "^package_target$": true,
                  "^auth$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Optional authentication tokens used to request the packages.",
                "properties": {
                  "github": {
                    "type": "string",
                    "description": "The Github access token."
                  }
                }
              },
              {
                "patternProperties": {
                  "^github$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "required": [
                  "type",
                  "url"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "The type of the package."
                  },
                  "url": {
                    "type": "string",
                    "description": "The url of the package."
                  }
                }
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^url$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Resolver Package Repository",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "description",
      "homepage"
    ],
    "properties": {
      "name": {
        "type": "string",
        "description": "The name of the repository."
      },
      "description": {
        "type": "string",
        "description": "The description of the repository."
      },
      "homepage": {
        "type": "string",
        "description": "The url of the repository."
      },
      "package_target": {
        "type": "string",
        "description": "The directory where the resolver-packages.json file should be generated."
      },
      "web_target": {
        "type": "string",
        "description": "The directory where the generated HTML will be stored."
      },
      "web_template": {
        "type": "string",
        "description": "The template to use when generating HTML. This can be a name or a path to a template."
      },
      "auth": {
        "type": "object",
        "description": "Optional authentication tokens used to request the packages.",
        "additionalProperties": false,
        "properties": {
          "github": {
            "type": "string",
            "description": "The Github access token."
          }
        }
      },
      "packages": {
        "type": "array",
        "description": "The list with packages that exists.",
        "minItems": 1,
        "_uniqueItems": true,
        "items": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "type",
            "url"
          ],
          "properties": {
            "type": {
              "type": "string",
              "description": "The type of the package."
            },
            "url": {
              "type": "string",
              "description": "The url of the package."
            }
          }
        }
      }
    }
  }
}
