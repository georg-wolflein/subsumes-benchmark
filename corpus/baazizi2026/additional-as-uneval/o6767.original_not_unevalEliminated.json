                    "title": "Date Updated",
                    "description": "Indicates when the submission was last updated.",
                    "name": "dateupdated"
                  },
                  "additional_resources": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "location": {
                          "type": "string"
                        },
                        "description": {
