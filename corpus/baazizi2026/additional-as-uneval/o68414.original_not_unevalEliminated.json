{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o68414.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o68414.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Artifacts to be fetched by url",
    "type": [
      "array",
      "null"
    ],
    "items": {
      "$ref": "#/$defs/modern_1"
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "A specific artifact to be fetched by URL",
                "properties": {
                  "sha1": {
                    "description": "The sha1 checksum of the artifact",
                    "type": "string",
                    "pattern": "^[a-f0-9]{40}$"
                  },
                  "url": {
                    "description": "The URL to be used to fetch artifact",
                    "type": "string"
                  },
                  "sha256": {
                    "description": "The sha256 checksum of the artifact",
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "md5": {
                    "description": "The md5 checksum of the artifact",
                    "type": "string",
                    "pattern": "^[a-f0-9]{32}$"
                  },
                  "target": {
                    "description": "Name to be used when saving artifact to disk",
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ],
                "anyOf": [
                  {
                    "required": [
                      "md5"
                    ]
                  },
                  {
                    "required": [
                      "sha1"
                    ]
                  },
                  {
                    "required": [
                      "sha256"
                    ]
                  }
                ]
              },
              {
                "patternProperties": {
                  "^target$": true,
                  "^sha256$": true,
                  "^sha1$": true,
                  "^md5$": true,
                  "^url$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Artifacts to be fetched by url",
    "type": [
      "array",
      "null"
    ],
    "items": {
      "type": "object",
      "description": "A specific artifact to be fetched by URL",
      "properties": {
        "url": {
          "description": "The URL to be used to fetch artifact",
          "type": "string"
        },
        "md5": {
          "description": "The md5 checksum of the artifact",
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "sha1": {
          "description": "The sha1 checksum of the artifact",
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "sha256": {
          "description": "The sha256 checksum of the artifact",
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "target": {
          "description": "Name to be used when saving artifact to disk",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "anyOf": [
        {
          "required": [
            "md5"
          ]
        },
        {
          "required": [
            "sha1"
          ]
        },
        {
          "required": [
            "sha256"
          ]
        }
      ]
    }
  }
}
