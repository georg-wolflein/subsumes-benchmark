{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o68806.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o68806.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Result from processing a (plugin, instance) pair",
                "properties": {
                  "plugin": {
                    "description": "Name of processed plug-in",
                    "type": "string"
                  },
                  "duration": {
                    "description": "Time in milliseconds taken to process a pair",
                    "type": "number"
                  },
                  "success": {
                    "description": "Status of processing",
                    "type": "boolean"
                  },
                  "instance": {
                    "description": "Name of processed instance or null if no instance were processed",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/Error"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "records": {
                    "items": {
                      "$ref": "#/$defs/Record"
                    },
                    "type": "array"
                  }
                },
                "title": "Result",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^duration$": true,
                  "^success$": true,
                  "^plugin$": true,
                  "^instance$": true,
                  "^error$": true,
                  "^records$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "Error": {
        "properties": {
          "fname": {
            "description": "Name of file from which the exception was thrown",
            "type": "string"
          },
          "line_number": {
            "description": "Line at which exception occurred",
            "type": "number"
          },
          "message": {
            "description": "Message passed to exception",
            "type": "string"
          },
          "func": {
            "description": "Name of function from which the exception was thrown",
            "type": "string"
          },
          "exc": {
            "description": "Message from extracted traceback (should be identical to `message`)",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Record": {
        "properties": {
          "name": true,
          "msecs": true,
          "exc_text": true,
          "funcName": true,
          "thread": true,
          "filename": true,
          "levelno": true,
          "exc_info": true,
          "created": true,
          "lineno": true,
          "module": true,
          "process": true,
          "pathname": true,
          "levelname": true,
          "processName": true,
          "message": {
            "type": "string"
          },
          "args": true,
          "relativeCreated": true,
          "threadName": true
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Result from processing a (plugin, instance) pair",
    "properties": {
      "duration": {
        "description": "Time in milliseconds taken to process a pair",
        "type": "number"
      },
      "error": {
        "oneOf": [
          {
            "$ref": "#/$defs/Error"
          },
          {
            "type": "null"
          }
        ]
      },
      "instance": {
        "description": "Name of processed instance or null if no instance were processed",
        "type": [
          "string",
          "null"
        ]
      },
      "plugin": {
        "description": "Name of processed plug-in",
        "type": "string"
      },
      "records": {
        "items": {
          "$ref": "#/$defs/Record"
        },
        "type": "array"
      },
      "success": {
        "description": "Status of processing",
        "type": "boolean"
      }
    },
    "title": "Result",
    "type": "object",
    "$defs": {
      "Error": {
        "properties": {
          "exc": {
            "description": "Message from extracted traceback (should be identical to `message`)",
            "type": "string"
          },
          "fname": {
            "description": "Name of file from which the exception was thrown",
            "type": "string"
          },
          "func": {
            "description": "Name of function from which the exception was thrown",
            "type": "string"
          },
          "line_number": {
            "description": "Line at which exception occurred",
            "type": "number"
          },
          "message": {
            "description": "Message passed to exception",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "Record": {
        "properties": {
          "args": {},
          "created": {},
          "exc_info": {},
          "exc_text": {},
          "filename": {},
          "funcName": {},
          "levelname": {},
          "levelno": {},
          "lineno": {},
          "message": {
            "type": "string"
          },
          "module": {},
          "msecs": {},
          "name": {},
          "pathname": {},
          "process": {},
          "processName": {},
          "relativeCreated": {},
          "thread": {},
          "threadName": {}
        },
        "required": [
          "message"
        ],
        "type": "object"
      }
    }
  }
}
