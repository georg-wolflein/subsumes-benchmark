{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o69912.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o69912.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Returns count of logs.",
                "examples": [
                  {
                    "email": "test@test.com",
                    "filter": [
                      "sent_at"
                    ],
                    "from": "2020-04-07T13:33:44+02:00",
                    "to": "2020-04-08T13:33:44+02:00"
                  }
                ],
                "properties": {
                  "email": {
                    "_format": "email",
                    "type": "string"
                  },
                  "filter": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "from": {
                    "_format": "date-time",
                    "title": "From filter",
                    "type": "string"
                  },
                  "to": {
                    "_format": "date-time",
                    "title": "To filter",
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "filter"
                ],
                "title": "Logs count",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^email$": true,
                  "^filter$": true,
                  "^from$": true,
                  "^to$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "items": {
                  "enum": [
                    "sent_at",
                    "delivered_at",
                    "clicked_at",
                    "opened_at",
                    "dropped_at",
                    "spam_complained_at",
                    "hard_bounced_at"
                  ]
                },
                "type": "array"
              },
              {
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Returns count of logs.",
    "examples": [
      {
        "email": "test@test.com",
        "filter": [
          "sent_at"
        ],
        "from": "2020-04-07T13:33:44+02:00",
        "to": "2020-04-08T13:33:44+02:00"
      }
    ],
    "properties": {
      "email": {
        "_format": "email",
        "type": "string"
      },
      "filter": {
        "additionalProperties": false,
        "items": {
          "enum": [
            "sent_at",
            "delivered_at",
            "clicked_at",
            "opened_at",
            "dropped_at",
            "spam_complained_at",
            "hard_bounced_at"
          ]
        },
        "type": "array"
      },
      "from": {
        "_format": "date-time",
        "title": "From filter",
        "type": "string"
      },
      "to": {
        "_format": "date-time",
        "title": "To filter",
        "type": "string"
      }
    },
    "required": [
      "email",
      "filter"
    ],
    "title": "Logs count",
    "type": "object"
  }
}
