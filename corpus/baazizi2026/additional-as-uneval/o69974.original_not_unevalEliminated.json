        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "title": "Organisation",
                "description": "JSON schema for an organisation",
                "required": [
                  "$schema",
                  "pid",
                  "name",
                  "code",
                  "default_currency"
                ],
                "properties": {
                  "online_harvested_source": {
