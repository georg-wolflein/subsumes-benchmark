{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minItems",
    "minProperties",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o70011.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o70011.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "$ref": "#/$defs/modern_1"
    },
    "minItems": 1,
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "regex": {
                    "type": "boolean",
                    "default": "false"
                  },
                  "old": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  },
                  "new": {
                    "type": "string"
                  },
                  "classify": {
                    "type": "object",
                    "properties": {
                      "SOURCE": {
                        "$ref": "#/$defs/classification"
                      },
                      "BINARY": {
                        "$ref": "#/$defs/classification"
                      },
                      "SEMANTIC": {
                        "$ref": "#/$defs/classification"
                      },
                      "OTHER": {
                        "$ref": "#/$defs/classification"
                      }
                    },
                    "minProperties": 1
                  }
                },
                "required": [
                  "code"
                ]
              },
              {
                "patternProperties": {
                  "^new$": true,
                  "^regex$": true,
                  "^classify$": true,
                  "^old$": true,
                  "^code$": true
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            ]
          }
        ]
      },
      "classification": {
        "type": "string",
        "enum": [
          "EQUIVALENT",
          "NON_BREAKING",
          "POTENTIALLY_BREAKING",
          "BREAKING"
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "regex": {
          "type": "boolean",
          "default": "false"
        },
        "code": {
          "type": "string"
        },
        "old": {
          "type": "string"
        },
        "new": {
          "type": "string"
        },
        "classify": {
          "type": "object",
          "properties": {
            "SOURCE": {
              "$ref": "#/$defs/classification"
            },
            "BINARY": {
              "$ref": "#/$defs/classification"
            },
            "SEMANTIC": {
              "$ref": "#/$defs/classification"
            },
            "OTHER": {
              "$ref": "#/$defs/classification"
            }
          },
          "minProperties": 1
        }
      },
      "additionalProperties": {
        "type": "string"
      },
      "required": [
        "code"
      ]
    },
    "minItems": 1,
    "$defs": {
      "classification": {
        "type": "string",
        "enum": [
          "EQUIVALENT",
          "NON_BREAKING",
          "POTENTIALLY_BREAKING",
          "BREAKING"
        ]
      }
    }
  }
