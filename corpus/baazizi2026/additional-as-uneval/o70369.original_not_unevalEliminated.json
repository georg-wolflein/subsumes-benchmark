              {
                "patternProperties": {
                  "^financialPeriod$": true,
                  "^method$": true,
                  "^paymentReference$": true,
                  "^LISAManagerReferenceNumber$": true,
                  "^paymentDate$": true,
                  "^_links$": true,
                  "^status$": true,
                  "^amount$": true,
                  "^direction$": true
                },
                "additionalProperties": false
              }
            ]
          }
