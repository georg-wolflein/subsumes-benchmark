    "$defs": {
      "ISO8601-Date": {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
      },
      "LISAManagerReferenceNumberType": {
        "pattern": "^Z\\d{6}$",
        "type": "string"
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "DoD": {
                    "$ref": "#/$defs/ISO8601-Date"
