{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o72570.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o72570.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_4",
    "$defs": {
      "modern_5": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "A map where the keys are the element tag, and the value is the data about how to get the element"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/bowerElement"
                }
              }
            ]
          }
        ]
      },
      "modern_6": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "A map where the keys is the page name, the value is the schema and the template"
              },
              {
                "additionalProperties": {
                  "$ref": "#/$defs/page"
                }
              }
            ]
          }
        ]
      },
      "bowerElement": {
        "$ref": "#/$defs/modern_3"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "schema": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "template": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/templateElement"
                    },
                    "description": "an array of elements and their bindings to a schema field"
                  }
                }
              },
              {
                "patternProperties": {
                  "^schema$": true,
                  "^template$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "page": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "A declaration of schema fields as the keys, the type of the field as a value"
              },
              {
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "string",
                    "number",
                    "object",
                    "array",
                    "boolean"
                  ]
                }
              }
            ]
          }
        ]
      },
      "templateElement": {
        "type": "object",
        "properties": {
          "elementTag": {
            "type": "string"
          },
          "propertyBindings": {
            "type": "object",
            "description": "A declaration of bindings for this template, keys are the schema field and values are the element property"
          }
        },
        "required": [
          "elementTag"
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "bowerPackage": {
                    "type": "string",
                    "description": "The package to install with bower for this element"
                  },
                  "elementPath": {
                    "type": "string",
                    "description": "The path to the .html file to include (with root set to bower_components, no leading dotslash)"
                  }
                }
              },
              {
                "patternProperties": {
                  "^bowerPackage$": true,
                  "^elementPath$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Kangrat",
                "description": "A schema for Kangrat",
                "type": "object",
                "properties": {
                  "elements": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "author": {
                    "type": "string",
                    "default": "somebody",
                    "description": "The author of the site"
                  },
                  "pages": {
                    "$ref": "#/$defs/modern_6"
                  },
                  "siteName": {
                    "type": "string",
                    "default": "My Kangrat Site",
                    "description": "The name of the site"
                  },
                  "basePage": {
                    "type": "string",
                    "default": "./basepage.html",
                    "description": "The base page to build the templates off of"
                  }
                },
                "required": [
                  "siteName",
                  "author",
                  "basePage",
                  "pages",
                  "elements"
                ]
              },
              {
                "patternProperties": {
                  "^basePage$": true,
                  "^author$": true,
                  "^elements$": true,
                  "^pages$": true,
                  "^siteName$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Kangrat",
    "description": "A schema for Kangrat",
    "type": "object",
    "properties": {
      "siteName": {
        "type": "string",
        "default": "My Kangrat Site",
        "description": "The name of the site"
      },
      "author": {
        "type": "string",
        "default": "somebody",
        "description": "The author of the site"
      },
      "basePage": {
        "type": "string",
        "default": "./basepage.html",
        "description": "The base page to build the templates off of"
      },
      "pages": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/page"
        },
        "description": "A map where the keys is the page name, the value is the schema and the template"
      },
      "elements": {
        "type": "object",
        "description": "A map where the keys are the element tag, and the value is the data about how to get the element",
        "additionalProperties": {
          "$ref": "#/$defs/bowerElement"
        }
      }
    },
    "additionalProperties": true,
    "required": [
      "siteName",
      "author",
      "basePage",
      "pages",
      "elements"
    ],
    "$defs": {
      "page": {
        "type": "object",
        "properties": {
          "schema": {
            "type": "object",
            "description": "A declaration of schema fields as the keys, the type of the field as a value",
            "additionalProperties": {
              "type": "string",
              "enum": [
                "string",
                "number",
                "object",
                "array",
                "boolean"
              ]
            }
          },
          "template": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/templateElement"
            },
            "description": "an array of elements and their bindings to a schema field"
          }
        },
        "additionalProperties": false
      },
      "templateElement": {
        "type": "object",
        "properties": {
          "elementTag": {
            "type": "string"
          },
          "propertyBindings": {
            "type": "object",
            "description": "A declaration of bindings for this template, keys are the schema field and values are the element property"
          }
        },
        "required": [
          "elementTag"
        ]
      },
      "bowerElement": {
        "type": "object",
        "properties": {
          "bowerPackage": {
            "type": "string",
            "description": "The package to install with bower for this element"
          },
          "elementPath": {
            "type": "string",
            "description": "The path to the .html file to include (with root set to bower_components, no leading dotslash)"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
