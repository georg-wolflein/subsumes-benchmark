  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o7288.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "amountOfContexts": {
                    "description": "amount of contexts",
                    "type": "integer"
                  },
                  "amountOfFeatures": {
                    "description": "amount of features",
                    "type": "integer"
                  },
                  "contextDomains": {
                    "description": "list stating the domains of the context. The order matters.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    }
                  },
                  "attributesPerFeature": {
                    "description": "list stating the number of attributes for array. The order of the features matter.",
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "attributeDomains": {
                    "description": "list stating the domains of the attributes. Attributes are listed accodring to the feature order and then their attribute number.",
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_3"
                    }
                  },
                  "configuration": {
                    "$ref": "#/$defs/modern_4"
                  },
                  "constraints": {
                    "description": "constraint derived from the FM. Their grammar is defined in SpecificationGrammar.g4",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "preferences": {
                    "description": "preferences derived from the user. Their grammar is defined in SpecificationGrammar.g4",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "amountOfFeatures",
                  "amountOfContexts",
                  "attributesPerFeature",
                  "attributeDomains",
                  "contextDomains",
                  "configuration",
                  "constraints",
                  "preferences"
                ]
              },
              {
                "patternProperties": {
                  "^contextDomains$": true,
                  "^constraints$": true,
                  "^configuration$": true,
                  "^amountOfFeatures$": true,
                  "^attributesPerFeature$": true,
                  "^attributeDomains$": true,
                  "^preferences$": true,
                  "^amountOfContexts$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "min": {
                    "description": "minimal value that the context can take",
                    "type": "integer"
                  },
                  "max": {
                    "description": "maximal value that the context can take",
                    "type": "integer"
                  }
                }
              },
              {
                "patternProperties": {
                  "^min$": true,
                  "^max$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "min": {
                    "description": "minimal value that the attribute can take",
                    "type": "integer"
                  },
                  "max": {
                    "description": "maximal value that the attribute can take",
                    "type": "integer"
                  }
                }
              },
              {
                "patternProperties": {
                  "^min$": true,
                  "^max$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "Inital configuration and context infomration",
                "type": "object",
                "properties": {
                  "selectedFeatures": {
                    "description": "list representing wich features are selected",
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "attributeValues": {
                    "description": "list representing the intial values of the attributes. The values of the attributes of non selected features are set to the maximum.",
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  },
                  "contextValues": {
                    "description": "list representing the contextual values",
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^selectedFeatures$": true,
                  "^attributeValues$": true,
                  "^contextValues$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
