{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o74932.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o74932.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "price": {
                    "type": "number",
                    "description": "price that we're going to charge you (exl. VAT)"
                  },
                  "carrier_tracking_no": {
                    "type": "string",
                    "description": "the original tracking number that can be used on the carriers website"
                  },
                  "id": {
                    "type": "string",
                    "description": "the shipment id that can be used for requesting info about a shipment or tracking it"
                  },
                  "label_url": {
                    "type": "string",
                    "description": "URL where you can download the label in pdf format"
                  },
                  "tracking_url": {
                    "type": "string",
                    "description": "URL you can send your customers so they can track this shipment"
                  }
                },
                "required": [
                  "id",
                  "carrier_tracking_no",
                  "tracking_url",
                  "label_url",
                  "price"
                ]
              },
              {
                "patternProperties": {
                  "^carrier_tracking_no$": true,
                  "^tracking_url$": true,
                  "^label_url$": true,
                  "^id$": true,
                  "^price$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "the shipment id that can be used for requesting info about a shipment or tracking it"
      },
      "carrier_tracking_no": {
        "type": "string",
        "description": "the original tracking number that can be used on the carriers website"
      },
      "tracking_url": {
        "type": "string",
        "description": "URL you can send your customers so they can track this shipment"
      },
      "label_url": {
        "type": "string",
        "description": "URL where you can download the label in pdf format"
      },
      "price": {
        "type": "number",
        "description": "price that we're going to charge you (exl. VAT)"
      }
    },
    "required": [
      "id",
      "carrier_tracking_no",
      "tracking_url",
      "label_url",
      "price"
    ],
    "additionalProperties": false
  }
}
