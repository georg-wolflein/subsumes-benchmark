{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o75561.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o75561.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "carrier": {
                    "description": "acronym of the carrier you want to use",
                    "enum": [
                      "ups",
                      "dpd",
                      "hermes",
                      "gls"
                    ],
                    "type": "string"
                  },
                  "pickup_address": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "pickup_date": {
                    "description": "deprecated: please use pickup_time instead.",
                    "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$",
                    "type": "string"
                  },
                  "pickup_time": {
                    "$ref": "#/$defs/modern_3"
                  }
                },
                "required": [
                  "carrier",
                  "pickup_time"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^carrier$": true,
                  "^pickup_address$": true,
                  "^pickup_date$": true,
                  "^pickup_time$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "address where the carrier should pick up shipments",
                "properties": {
                  "zip_code": {
                    "type": "string"
                  },
                  "street_no": {
                    "type": "string"
                  },
                  "state": {
                    "type": "string"
                  },
                  "country": {
                    "description": "Country as uppercase ISO 3166-1 alpha-2 code",
                    "type": "string"
                  },
                  "company": {
                    "type": "string"
                  },
                  "id": {
                    "description": "identifier of a previously created address",
                    "type": "string"
                  },
                  "last_name": {
                    "type": "string"
                  },
                  "street": {
                    "type": "string"
                  },
                  "care_of": {
                    "type": "string"
                  },
                  "phone": {
                    "description": "telephone number (mandatory when using UPS and the following terms apply: service is one_day or one_day_early or ship to country is different than ship from country)",
                    "type": "string"
                  },
                  "first_name": {
                    "type": "string"
                  },
                  "city": {
                    "type": "string"
                  }
                },
                "required": [
                  "last_name",
                  "street",
                  "street_no",
                  "city",
                  "zip_code",
                  "country"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^city$": true,
                  "^phone$": true,
                  "^state$": true,
                  "^company$": true,
                  "^country$": true,
                  "^last_name$": true,
                  "^care_of$": true,
                  "^street_no$": true,
                  "^street$": true,
                  "^zip_code$": true,
                  "^first_name$": true,
                  "^id$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "defines a time window in which the carrier should pickup shipments",
                "properties": {
                  "earliest": {
                    "_format": "date-time",
                    "type": "string"
                  },
                  "latest": {
                    "_format": "date-time",
                    "type": "string"
                  }
                },
                "required": [
                  "earliest",
                  "latest"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^earliest$": true,
                  "^latest$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
