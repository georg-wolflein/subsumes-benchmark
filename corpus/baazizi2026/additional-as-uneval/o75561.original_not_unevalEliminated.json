          "city",
          "zip_code",
          "country"
        ],
        "type": "object"
      },
      "pickup_date": {
        "description": "deprecated: please use pickup_time instead.",
        "pattern": "^[0-9]{4}/[0-9]{2}/[0-9]{2}$",
