{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79473.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79473.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "shortCode": {
                    "type": "string",
                    "description": "the developer's shortcode"
                  },
                  "name": {
                    "type": "string",
                    "description": "the developer's name"
                  },
                  "blurb": {
                    "type": "string",
                    "description": "the developer's blurb"
                  },
                  "description": {
                    "type": "string",
                    "description": "the developer's description"
                  }
                },
                "required": [
                  "shortCode",
                  "name",
                  "blurb"
                ]
              },
              {
                "patternProperties": {
                  "^shortCode$": true,
                  "^name$": true,
                  "^blurb$": true,
                  "^description$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "developer": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "details about a specific app",
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "the app's name"
                  },
                  "description": {
                    "type": "string",
                    "description": "the app's description"
                  },
                  "learnMoreUrl": {
                    "type": "string",
                    "description": "the app's learnMoreUrl"
                  },
                  "principalType": {
                    "type": "string",
                    "description": "the app's principal type (if it is SSO)"
                  },
                  "blurb": {
                    "type": "string",
                    "description": "the app's blurb"
                  },
                  "shortCode": {
                    "type": "string",
                    "description": "the app's shortcode"
                  },
                  "logoUrl": {
                    "type": "string",
                    "format": "url",
                    "description": "the app's logo"
                  },
                  "developer": {
                    "$ref": "#/$defs/developer"
                  }
                },
                "required": [
                  "shortCode",
                  "name",
                  "blurb",
                  "developer"
                ]
              },
              {
                "patternProperties": {
                  "^blurb$": true,
                  "^developer$": true,
                  "^name$": true,
                  "^logoUrl$": true,
                  "^principalType$": true,
                  "^learnMoreUrl$": true,
                  "^description$": true,
                  "^shortCode$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "details about a specific app",
    "additionalProperties": false,
    "properties": {
      "shortCode": {
        "type": "string",
        "description": "the app's shortcode"
      },
      "name": {
        "type": "string",
        "description": "the app's name"
      },
      "blurb": {
        "type": "string",
        "description": "the app's blurb"
      },
      "description": {
        "type": "string",
        "description": "the app's description"
      },
      "logoUrl": {
        "type": "string",
        "format": "url",
        "description": "the app's logo"
      },
      "learnMoreUrl": {
        "type": "string",
        "description": "the app's learnMoreUrl"
      },
      "principalType": {
        "type": "string",
        "description": "the app's principal type (if it is SSO)"
      },
      "developer": {
        "$ref": "#/$defs/developer"
      }
    },
    "required": [
      "shortCode",
      "name",
      "blurb",
      "developer"
    ],
    "$defs": {
      "developer": {
        "type": "object",
        "properties": {
          "shortCode": {
            "type": "string",
            "description": "the developer's shortcode"
          },
          "name": {
            "type": "string",
            "description": "the developer's name"
          },
          "blurb": {
            "type": "string",
            "description": "the developer's blurb"
          },
          "description": {
            "type": "string",
            "description": "the developer's description"
          }
        },
        "additionalProperties": false,
        "required": [
          "shortCode",
          "name",
          "blurb"
        ]
      }
    }
  }
}
