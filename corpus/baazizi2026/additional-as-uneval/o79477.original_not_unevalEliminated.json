{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79477.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79477.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "canCreateAccounts": {
                    "type": "boolean",
                    "description": "true if this account manager can create accounts - in which case TAS SSO will display a sign up button"
                  },
                  "createAccountTermsAndConditionsUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "A link to the terms and conditions that the user must agree to before creating an account. Only present if canCerateAccounts is true."
                  }
                },
                "required": [
                  "canCreateAccounts"
                ]
              },
              {
                "patternProperties": {
                  "^canCreateAccounts$": true,
                  "^createAccountTermsAndConditionsUrl$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "canCreateAccounts": {
        "type": "boolean",
        "description": "true if this account manager can create accounts - in which case TAS SSO will display a sign up button"
      },
      "createAccountTermsAndConditionsUrl": {
        "type": "string",
        "format": "uri",
        "description": "A link to the terms and conditions that the user must agree to before creating an account. Only present if canCerateAccounts is true."
      }
    },
    "required": [
      "canCreateAccounts"
    ],
    "additionalProperties": false
  }
}
