          "fileName": {
            "type": "string"
          },
          "via": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "favoriteColor": {
        "access": "eeo",
        "default": "blue",
        "description": "Tell us your favorite color. Our advanced hiring algorithm uses it.",
        "title": "Favorite color",
        "type": "string"
      }
    },
    "required": [
      "favoriteColor"
    ],
    "type": "object"
  }
