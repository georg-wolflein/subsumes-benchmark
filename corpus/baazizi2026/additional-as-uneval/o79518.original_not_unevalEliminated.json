{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79518.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o79518.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "$ref": "#/$defs/apiTest"
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "api": {
                    "type": "string",
                    "description": "URL called to perform the api test"
                  },
                  "message": {
                    "type": "string",
                    "description": "Describes the outcome of the api test. Includes any exceptions if required"
                  },
                  "success": {
                    "type": "boolean",
                    "description": "true if the api test succeeds or false if the api test fails"
                  }
                },
                "required": [
                  "api",
                  "message",
                  "success"
                ]
              },
              {
                "patternProperties": {
                  "^api$": true,
                  "^message$": true,
                  "^success$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "apiTest": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "$ref": "#/$defs/apiTest"
    },
    "$defs": {
      "apiTest": {
        "type": "object",
        "properties": {
          "api": {
            "type": "string",
            "description": "URL called to perform the api test"
          },
          "message": {
            "type": "string",
            "description": "Describes the outcome of the api test. Includes any exceptions if required"
          },
          "success": {
            "type": "boolean",
            "description": "true if the api test succeeds or false if the api test fails"
          }
        },
        "additionalProperties": false,
        "required": [
          "api",
          "message",
          "success"
        ]
      }
    }
  }
}
