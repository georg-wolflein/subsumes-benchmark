{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "minLength",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o81495.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o81495.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "description": "RS from firefightersPost",
                "properties": {
                  "availableEquipment": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "availableUnits": {
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^availableEquipment$": true,
                  "^availableUnits$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "items": {
                  "$ref": "#/$defs/modern_3"
                },
                "type": "array"
              },
              {
                "items": {
                  "anyOf": [
                    true,
                    false
                  ]
                }
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "name": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "quantity": {
                    "type": "integer"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^quantity$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "RS from firefightersPost",
    "properties": {
      "availableEquipment": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "quantity": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "type": "array"
      },
      "availableUnits": {
        "type": "integer"
      }
    },
    "type": "object"
  }
}
