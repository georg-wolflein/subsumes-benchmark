                  "lastName",
                  "email",
                  "postedSlides",
                  "rating",
                  "tags"
                ]
              },
              {
                "patternProperties": {
                  "^lastName$": true,
                  "^firstName$": true,
                  "^postedSlides$": true,
                  "^rating$": true,
                  "^tags$": true,
                  "^email$": true
