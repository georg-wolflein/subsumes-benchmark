{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "minItems",
    "pattern",
    "properties",
    "required",
    "type"
  ],
