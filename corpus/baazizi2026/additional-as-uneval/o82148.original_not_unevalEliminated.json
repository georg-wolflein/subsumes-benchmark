{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "maxLength",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82148.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82148.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_2",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "commit": {
                    "maxLength": 100,
                    "title": "Git SHA Commit ID",
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "owner": {
                    "maxLength": 100,
                    "title": "Owner/Organization of the SCM repository (e.g. totem)",
                    "type": "string"
                  },
                  "ref": {
                    "maxLength": 100,
                    "title": "Branch or tag name",
                    "type": "string"
                  },
                  "repo": {
                    "maxLength": 100,
                    "title": "SCM repository name (e.g.: spec-python)",
                    "type": "string"
                  }
                },
                "required": [
                  "owner",
                  "repo",
                  "ref"
                ]
              },
              {
                "patternProperties": {
                  "^commit$": true,
                  "^owner$": true,
                  "^ref$": true,
                  "^repo$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "name": {
                    "description": "Name of the hook (e.g. image-factory)",
                    "maxLength": 100,
                    "type": "string"
                  },
                  "result": {
                    "description": "Result object",
                    "type": "object"
                  },
                  "force-deploy": {
                    "description": "Force deploy the image on receiving this hook (ignore status)",
                    "type": "boolean"
                  },
                  "git": {
                    "$ref": "#/$defs/git"
                  },
                  "status": {
                    "description": "Status for the hook (failed, success)",
                    "enum": [
                      "success",
                      "failed"
                    ]
                  },
                  "type": {
                    "description": "Type of the hook (e.g. builder, ci)",
                    "enum": [
                      "builder",
                      "ci",
                      "scm-create",
                      "scm-push"
                    ]
                  }
                },
                "required": [
                  "name",
                  "type",
                  "git"
                ],
                "title": "Schema for Generic Hook payload",
                "type": "object"
              },
              {
                "patternProperties": {
                  "^result$": true,
                  "^name$": true,
                  "^type$": true,
                  "^git$": true,
                  "^force-deploy$": true,
                  "^status$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "git": {
        "$ref": "#/$defs/modern_1"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "force-deploy": {
        "description": "Force deploy the image on receiving this hook (ignore status)",
        "type": "boolean"
      },
      "git": {
        "$ref": "#/$defs/git"
      },
      "name": {
        "description": "Name of the hook (e.g. image-factory)",
        "maxLength": 100,
        "type": "string"
      },
      "result": {
        "description": "Result object",
        "type": "object"
      },
      "status": {
        "description": "Status for the hook (failed, success)",
        "enum": [
          "success",
          "failed"
        ]
      },
      "type": {
        "description": "Type of the hook (e.g. builder, ci)",
        "enum": [
          "builder",
          "ci",
          "scm-create",
          "scm-push"
        ]
      }
    },
    "required": [
      "name",
      "type",
      "git"
    ],
    "title": "Schema for Generic Hook payload",
    "type": "object",
    "$defs": {
      "git": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "maxLength": 100,
            "title": "Git SHA Commit ID",
            "type": [
              "string",
              "null"
            ]
          },
          "owner": {
            "maxLength": 100,
            "title": "Owner/Organization of the SCM repository (e.g. totem)",
            "type": "string"
          },
          "ref": {
            "maxLength": 100,
            "title": "Branch or tag name",
            "type": "string"
          },
          "repo": {
            "maxLength": 100,
            "title": "SCM repository name (e.g.: spec-python)",
            "type": "string"
          }
        },
        "required": [
          "owner",
          "repo",
          "ref"
        ]
      }
    }
  }
}
