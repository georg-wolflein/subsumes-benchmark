{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "format",
    "items",
    "minItems",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82251.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82251.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_9",
    "$defs": {
      "modern_5": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "multipleYears": {
                    "type": "boolean",
                    "default": false,
                    "description": "Specify if the budget applies for more than 1 administrative year"
                  },
                  "exchangeRate": {
                    "type": "number",
                    "description": "Exchange rate applicable if the contract use any currency different from MXN"
                  }
                }
              },
              {
                "patternProperties": {
                  "^multipleYears$": true,
                  "^exchangeRate$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_6": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Additional details applicable to the implementation phase",
                "properties": {
                  "hasAudits": {
                    "type": "boolean",
                    "description": "Specify if audits were performed during the contracting process"
                  },
                  "audits": {
                    "type": "array",
                    "minItems": 0,
                    "default": [],
                    "items": {
                      "$ref": "#/$defs/audit"
                    }
                  }
                }
              },
              {
                "patternProperties": {
                  "^hasAudits$": true,
                  "^audits$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "tender": {
        "$ref": "#/$defs/modern_1"
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Additional details applicable to the tender phase",
                "properties": {
                  "requiringEntity": {
                    "type": "object",
                    "description": "Entity requiring the contract process (Organization object)"
                  },
                  "scope": {
                    "type": "string",
                    "description": "Specify the scope of the tender process",
                    "default": "national",
                    "enum": [
                      "national",
                      "international",
                      "internationalTreaty"
                    ]
                  },
                  "technicalEntity": {
                    "type": "object",
                    "description": "Entity involved in the technical aspects of the contract process (Organization object)"
                  },
                  "procurementStyle": {
                    "type": "string",
                    "description": "Specify the procurement style of the tender process",
                    "default": "multiple",
                    "enum": [
                      "presence",
                      "electronic",
                      "multiple"
                    ]
                  },
                  "socialWitness": {
                    "type": "object",
                    "description": "Social witness entity (Organization object)"
                  },
                  "hasSocialWitness": {
                    "type": "boolean",
                    "description": "Specify whether a social witness participate during the tender process or not",
                    "default": "false"
                  },
                  "socialWitnessDesignationDate": {
                    "type": "string",
                    "format": "date-time"
                  }
                }
              },
              {
                "patternProperties": {
                  "^requiringEntity$": true,
                  "^technicalEntity$": true,
                  "^hasSocialWitness$": true,
                  "^scope$": true,
                  "^socialWitnessDesignationDate$": true,
                  "^socialWitness$": true,
                  "^procurementStyle$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Additional details applicable to the award phase",
                "properties": {
                  "complains": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              },
              {
                "patternProperties": {
                  "^complains$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "planning": {
        "$ref": "#/$defs/modern_4"
      },
      "modern_9": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Base TM Extension",
                "description": "Basic extension to implement OCDS in Mexico",
                "type": "object",
                "required": [
                  "version"
                ],
                "properties": {
                  "tender": {
                    "$ref": "#/$defs/tender"
                  },
                  "award": {
                    "$ref": "#/$defs/award"
                  },
                  "implementation": {
                    "$ref": "#/$defs/implementation"
                  },
                  "contract": {
                    "$ref": "#/$defs/contract"
                  },
                  "planning": {
                    "$ref": "#/$defs/planning"
                  },
                  "version": {
                    "type": "string",
                    "title": "Version",
                    "description": "Semantic version of the extension",
                    "default": "0.1.0"
                  }
                }
              },
              {
                "patternProperties": {
                  "^version$": true,
                  "^tender$": true,
                  "^implementation$": true,
                  "^award$": true,
                  "^planning$": true,
                  "^contract$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Details about complains received during the award phase of the contracting process",
                "properties": {
                  "accepted": {
                    "type": "integer",
                    "default": 0
                  },
                  "notAccepted": {
                    "type": "integer",
                    "default": 0
                  }
                }
              },
              {
                "patternProperties": {
                  "^accepted$": true,
                  "^notAccepted$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "audit": {
        "$ref": "#/$defs/modern_7"
      },
      "contract": {
        "$ref": "#/$defs/modern_8"
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Additional details applicable to the planning phase",
                "properties": {
                  "budget": {
                    "$ref": "#/$defs/modern_5"
                  }
                }
              },
              {
                "patternProperties": {
                  "^budget$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "award": {
        "$ref": "#/$defs/modern_2"
      },
      "modern_7": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "title": "Audit",
                "description": "Defines an audit process",
                "required": [
                  "type",
                  "auditor",
                  "observations",
                  "actions"
                ],
                "properties": {
                  "type": {
                    "type": "string",
                    "title": "Type",
                    "description": "Type of audit process",
                    "default": "external",
                    "enum": [
                      "internal",
                      "external"
                    ]
                  },
                  "auditor": {
                    "type": "object"
                  },
                  "observations": {
                    "type": "array",
                    "minItems": 0,
                    "_uniqueItems": true,
                    "items": {
                      "type": "string"
                    },
                    "title": "Observation(s)",
                    "description": "Observations presented during the audit process",
                    "default": []
                  },
                  "actions": {
                    "type": "array",
                    "minItems": 0,
                    "_uniqueItems": true,
                    "items": {
                      "type": "string"
                    },
                    "title": "Action(s)",
                    "description": "Actions taken during the audit process",
                    "default": []
                  }
                }
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^auditor$": true,
                  "^observations$": true,
                  "^actions$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "implementation": {
        "$ref": "#/$defs/modern_6"
      },
      "modern_8": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Additional details applicable to the contract phase",
                "properties": {
                  "administratorEntity": {
                    "type": "object",
                    "description": "Entity with administrative lead during the contract process (Organization object)"
                  },
                  "hasModifications": {
                    "type": "boolean",
                    "default": false,
                    "description": "Specify if the contracting process have been modified/adjusted"
                  }
                }
              },
              {
                "patternProperties": {
                  "^administratorEntity$": true,
                  "^hasModifications$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://tm.org.mx/edca/extensions/base.json",
