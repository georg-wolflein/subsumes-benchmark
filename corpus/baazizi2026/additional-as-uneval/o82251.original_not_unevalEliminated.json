        "required": [
          "type",
          "auditor",
          "observations",
          "actions"
        ],
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "description": "Type of audit process",
            "default": "external",
            "enum": [
              "internal",
              "external"
