          },
          "auditor": {
            "type": "object"
          },
          "observations": {
            "type": "array",
            "minItems": 0,
            "_uniqueItems": true,
            "items": {
              "type": "string"
            },
            "title": "Observation(s)",
            "description": "Observations presented during the audit process",
            "default": []
          },
          "actions": {
            "type": "array",
            "minItems": 0,
            "_uniqueItems": true,
            "items": {
              "type": "string"
            },
            "title": "Action(s)",
            "description": "Actions taken during the audit process",
