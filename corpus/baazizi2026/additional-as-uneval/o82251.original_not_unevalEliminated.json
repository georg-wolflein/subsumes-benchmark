    "title": "Base TM Extension",
    "description": "Basic extension to implement OCDS in Mexico",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "version"
    ],
    "properties": {
      "version": {
        "type": "string",
        "title": "Version",
        "description": "Semantic version of the extension",
        "default": "0.1.0"
      },
      "planning": {
        "$ref": "#/$defs/planning"
      },
      "tender": {
        "$ref": "#/$defs/tender"
      },
      "award": {
        "$ref": "#/$defs/award"
      },
      "contract": {
        "$ref": "#/$defs/contract"
      },
      "implementation": {
        "$ref": "#/$defs/implementation"
      }
    },
    "$defs": {
