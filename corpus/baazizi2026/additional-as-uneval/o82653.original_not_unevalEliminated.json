{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82653.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82653.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "etag": {
                    "type": "string",
                    "pattern": "^[\\w\\.:-]+$",
                    "pbj": {
                      "type": "string",
                      "rule": "single"
                    }
                  },
                  "show_captions": {
                    "type": "boolean",
                    "pbj": {
                      "type": "boolean",
                      "rule": "single"
                    }
                  },
                  "show_text": {
                    "type": "boolean",
                    "pbj": {
                      "type": "boolean",
                      "rule": "single"
                    }
                  },
                  "autoplay": {
                    "type": "boolean",
                    "pbj": {
                      "type": "boolean",
                      "rule": "single"
                    }
                  },
                  "updated_date": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Represents an update that occurred on the node this block is attached to. DOES NOT indicate an update to the block itself. eg an article with a twitter block with updated_date means that the article was updated to include that twitter block.",
                    "pbj": {
                      "type": "date-time",
                      "rule": "single"
                    }
                  },
                  "css_class": {
                    "type": "string",
                    "pattern": "^[\\w\\s-]+$",
                    "description": "In rendering environments that support HTML the css_class can be appended to the dom elements' class attribute.",
                    "pbj": {
                      "type": "string",
                      "rule": "single"
                    }
                  },
                  "aside": {
                    "type": "boolean",
                    "description": "When true it means this block represents a portion of a document whose content is only indirectly related to the document's main content. Asides are frequently presented as sidebars or call-out boxes.",
                    "pbj": {
                      "type": "boolean",
                      "rule": "single"
                    }
                  },
                  "href": {
                    "type": "string",
                    "pattern": "^(https?:\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-]*)*\\/?$",
                    "pbj": {
                      "type": "text",
                      "rule": "single",
                      "format": "url"
                    }
                  },
                  "poster_image_ref": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$",
                    "description": "A reference to an image asset to use as the poster that will override what is provided by facebook.",
                    "pbj": {
                      "type": "identifier",
                      "rule": "single"
                    }
                  }
                },
                "required": [
                  "href"
                ]
              },
              {
                "patternProperties": {
                  "^show_captions$": true,
                  "^updated_date$": true,
                  "^autoplay$": true,
                  "^etag$": true,
                  "^show_text$": true,
                  "^poster_image_ref$": true,
                  "^css_class$": true,
                  "^aside$": true,
                  "^href$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://schemas.triniti.io/json-schema/triniti/canvas/mixin/facebook-video-block/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "etag": {
        "type": "string",
        "pattern": "^[\\w\\.:-]+$",
        "pbj": {
          "type": "string",
          "rule": "single"
        }
      },
      "css_class": {
        "type": "string",
        "pattern": "^[\\w\\s-]+$",
        "description": "In rendering environments that support HTML the css_class can be appended to the dom elements' class attribute.",
        "pbj": {
          "type": "string",
          "rule": "single"
        }
      },
      "updated_date": {
        "type": "string",
        "format": "date-time",
        "description": "Represents an update that occurred on the node this block is attached to. DOES NOT indicate an update to the block itself. eg an article with a twitter block with updated_date means that the article was updated to include that twitter block.",
        "pbj": {
          "type": "date-time",
          "rule": "single"
        }
      },
      "aside": {
        "type": "boolean",
        "description": "When true it means this block represents a portion of a document whose content is only indirectly related to the document's main content. Asides are frequently presented as sidebars or call-out boxes.",
        "pbj": {
          "type": "boolean",
          "rule": "single"
        }
      },
      "href": {
        "type": "string",
        "pattern": "^(https?:\\/\\/)?([\\da-z\\.-]+)\\.([a-z\\.]{2,6})([\\/\\w \\.-]*)*\\/?$",
        "pbj": {
          "type": "text",
          "rule": "single",
          "format": "url"
        }
      },
      "autoplay": {
        "type": "boolean",
        "pbj": {
          "type": "boolean",
          "rule": "single"
        }
      },
      "show_text": {
        "type": "boolean",
        "pbj": {
          "type": "boolean",
          "rule": "single"
        }
      },
      "show_captions": {
        "type": "boolean",
        "pbj": {
          "type": "boolean",
          "rule": "single"
        }
      },
      "poster_image_ref": {
        "type": "string",
        "pattern": "^[\\w\\/\\.:-]+$",
        "description": "A reference to an image asset to use as the poster that will override what is provided by facebook.",
        "pbj": {
          "type": "identifier",
          "rule": "single"
        }
      }
    },
    "required": [
      "href"
    ],
    "additionalProperties": true
  }
}
