    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82694.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "etag": {
                    "pattern": "^[\\w\\.:-]+$",
                    "pbj": {
                      "rule": "single",
                      "type": "string"
                    },
                    "type": "string"
                  },
                  "track_id": {
                    "pattern": "^\\d+$",
                    "pbj": {
                      "rule": "single",
                      "type": "string"
                    },
                    "type": "string"
                  },
                  "updated_date": {
                    "_format": "date-time",
                    "description": "Represents an update that occurred on the node this block is attached to. DOES NOT indicate an update to the block itself. eg an article with a twitter block with updated_date means that the article was updated to include that twitter block.",
                    "pbj": {
                      "rule": "single",
                      "type": "date-time"
                    },
                    "type": "string"
                  },
                  "css_class": {
                    "description": "In rendering environments that support HTML the css_class can be appended to the dom elements' class attribute.",
                    "pattern": "^[\\w\\s-]+$",
                    "pbj": {
                      "rule": "single",
                      "type": "string"
                    },
                    "type": "string"
                  },
                  "show_comments": {
                    "pbj": {
                      "rule": "single",
                      "type": "boolean"
                    },
                    "type": "boolean"
                  },
                  "poster_image_ref": {
                    "description": "A reference to an image asset to use as the poster that will override what is provided by soundcloud.",
                    "pattern": "^[\\w\\/\\.:-]+$",
                    "pbj": {
                      "rule": "single",
                      "type": "identifier"
                    },
                    "type": "string"
                  },
                  "aside": {
                    "description": "When true it means this block represents a portion of a document whose content is only indirectly related to the document's main content. Asides are frequently presented as sidebars or call-out boxes.",
                    "pbj": {
                      "rule": "single",
                      "type": "boolean"
                    },
                    "type": "boolean"
                  },
                  "auto_play": {
                    "pbj": {
                      "rule": "single",
                      "type": "boolean"
                    },
                    "type": "boolean"
                  },
                  "hide_related": {
                    "pbj": {
                      "rule": "single",
                      "type": "boolean"
                    },
                    "type": "boolean"
                  },
                  "visual": {
                    "description": "Whether or not to use the thumbnail as a poster image.",
                    "pbj": {
                      "rule": "single",
                      "type": "boolean"
                    },
                    "type": "boolean"
                  }
                },
                "required": [
                  "track_id"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^updated_date$": true,
                  "^track_id$": true,
                  "^hide_related$": true,
                  "^etag$": true,
                  "^visual$": true,
                  "^css_class$": true,
                  "^show_comments$": true,
                  "^poster_image_ref$": true,
                  "^aside$": true,
                  "^auto_play$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://schemas.triniti.io/json-schema/triniti/canvas/mixin/soundcloud-audio-block/1-0-0.json",
