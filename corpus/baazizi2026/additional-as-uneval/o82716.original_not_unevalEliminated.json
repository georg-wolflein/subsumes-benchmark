{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82716.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82716.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "ads_enabled": {
                    "type": "boolean",
                    "default": true,
                    "pbj": {
                      "type": "boolean",
                      "rule": "single"
                    }
                  },
                  "dfp_ad_unit_path": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$",
                    "pbj": {
                      "type": "string",
                      "rule": "single"
                    }
                  },
                  "dfp_cust_params": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^ads_enabled$": true,
                  "^dfp_ad_unit_path$": true,
                  "^dfp_cust_params$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                    "type": "string",
                    "pattern": "^[\\w\\/\\.:-]+$"
                  }
                },
                "pbj": {
                  "type": "string",
                  "rule": "map"
                }
              },
              {
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://schemas.triniti.io/json-schema/triniti/common/mixin/advertising/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ads_enabled": {
        "type": "boolean",
        "default": true,
        "pbj": {
          "type": "boolean",
          "rule": "single"
        }
      },
      "dfp_ad_unit_path": {
        "type": "string",
        "pattern": "^[\\w\\/\\.:-]+$",
        "pbj": {
          "type": "string",
          "rule": "single"
        }
      },
      "dfp_cust_params": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
            "type": "string",
            "pattern": "^[\\w\\/\\.:-]+$"
          }
        },
        "additionalProperties": false,
        "pbj": {
          "type": "string",
          "rule": "map"
        }
      }
    },
    "additionalProperties": true
  }
}
