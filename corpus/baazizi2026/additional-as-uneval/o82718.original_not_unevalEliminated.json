{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "maxLength",
    "minLength",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82718.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o82718.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "custom_code": {
                    "$ref": "#/$defs/modern_2"
                  }
                }
              },
              {
                "patternProperties": {
                  "^custom_code$": true
                },
                "additionalProperties": true
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 65535
                  }
                },
                "description": "A map containing (HTML, JavaScript, CSS, etc.) that is injected into an application at a named insertion point, e.g. \"html_head\" or \"footer\".",
                "pbj": {
                  "type": "text",
                  "rule": "map"
                }
              },
              {
                "patternProperties": {
                  "^[a-zA-Z_]{1}[\\w\\.:-]+$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://schemas.triniti.io/json-schema/triniti/common/mixin/custom-code/1-0-0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "custom_code": {
        "type": "object",
        "patternProperties": {
          "^[a-zA-Z_]{1}[\\w\\.:-]+$": {
            "type": "string",
            "minLength": 0,
            "maxLength": 65535
          }
        },
        "additionalProperties": false,
        "description": "A map containing (HTML, JavaScript, CSS, etc.) that is injected into an application at a named insertion point, e.g. \"html_head\" or \"footer\".",
        "pbj": {
          "type": "text",
          "rule": "map"
        }
      }
    },
    "additionalProperties": true
  }
}
