{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "maximum",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83722.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83722.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Organization",
    "description": "Unit hierarchy and board members",
    "type": "object",
    "properties": {
      "units": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_1"
        }
      },
      "board": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/modern_2"
        }
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "unitId": {
                    "type": "integer",
                    "minimum": 1.0,
                    "maximum": 9999.0
                  },
                  "unitOf": {
                    "type": "integer",
                    "minimum": 0.0,
                    "maximum": 9999.0
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "unitId",
                  "unitOf",
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^unitId$": true,
                  "^unitOf$": true,
                  "^name$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "independent": {
                    "type": "boolean"
                  },
                  "chair": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "independent",
                  "chair"
                ]
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^independent$": true,
                  "^chair$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Organization",
    "description": "Unit hierarchy and board members",
    "type": "object",
    "properties": {
      "units": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "unitId": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9999
            },
            "unitOf": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "unitId",
            "unitOf",
            "name"
          ]
        }
      },
      "board": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "independent": {
              "type": "boolean"
            },
            "chair": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "independent",
            "chair"
          ]
        }
      }
    }
  }
}
