  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_5": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Chance to get specific primary skill on level-up, applicable for levels less than 10"
              },
              {
                "additionalProperties": {
                  "type": "number"
                }
              }
            ]
          }
        ]
      },
      "modern_6": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Initial primary skills of heroes"
              },
              {
                "additionalProperties": {
                  "type": "number"
                }
              }
            ]
          }
        ]
      },
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "title": "VCMI hero class format",
                "description": "Format used to define classes of heroes in VCMI",
                "required": [
                  "animation",
                  "faction",
                  "highLevelChance",
                  "lowLevelChance",
                  "name",
                  "primarySkills",
                  "secondarySkills",
                  "tavern",
                  "defaultTavern",
                  "affinity",
                  "commander"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Translatable name of hero class"
                  },
                  "animation": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "defaultTavern": {
                    "type": "number",
                    "description": "Default chance for hero to appear in tavern, used only when value vas not set in tavern field",
                    "minimum": 0.0
                  },
                  "lowLevelChance": {
                    "$ref": "#/$defs/modern_5"
                  },
                  "primarySkills": {
                    "$ref": "#/$defs/modern_6"
                  },
                  "index": {
                    "type": "number",
                    "description": "Private field to break things, do not use."
                  },
                  "affinity": {
                    "type": "string",
                    "description": "Affinity of hero class, might or magic",
                    "enum": [
                      "might",
                      "magic"
                    ]
                  },
                  "commander": {
                    "type": "string",
                    "description": "Identifier of creature that is used as commander by heroes"
                  },
                  "tavern": {
                    "$ref": "#/$defs/modern_7"
                  },
                  "faction": {
                    "type": "string",
                    "description": "Faction this hero class belongs to"
                  },
                  "secondarySkills": {
                    "$ref": "#/$defs/modern_8"
                  },
                  "highLevelChance": {
                    "$ref": "#/$defs/modern_9"
                  }
                }
              },
              {
                "patternProperties": {
                  "^primarySkills$": true,
                  "^commander$": true,
                  "^faction$": true,
                  "^name$": true,
                  "^animation$": true,
                  "^highLevelChance$": true,
                  "^defaultTavern$": true,
                  "^secondarySkills$": true,
                  "^index$": true,
                  "^tavern$": true,
                  "^affinity$": true,
                  "^lowLevelChance$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_7": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Chance for this hero to appear in tavern of this factions. Reversed version of field \"tavern\" from town format"
              },
              {
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0.0
                }
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Files related to hero animation",
                "required": [
                  "battle",
                  "map"
                ],
                "properties": {
                  "battle": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "map": {
                    "$ref": "#/$defs/modern_4"
                  }
                }
              },
              {
                "patternProperties": {
                  "^battle$": true,
                  "^map$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_8": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Chance to get specific secondary skill on level-up. All missing skills are considered to be banned"
              },
              {
                "additionalProperties": {
                  "type": "number"
                }
              }
            ]
          }
        ]
      },
      "modern_9": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Chance to get specific primary skill on level-up, applicable for levels starting from 10"
              },
              {
                "additionalProperties": {
                  "type": "number"
                }
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Hero animations for battle",
                "required": [
                  "female",
                  "male"
                ],
                "properties": {
                  "female": {
                    "type": "string",
                    "description": "Female version",
                    "format": "defFile"
                  },
                  "male": {
                    "type": "string",
                    "description": "Male version",
                    "format": "defFile"
                  }
                }
              },
              {
                "patternProperties": {
                  "^female$": true,
                  "^male$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_4": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Hero animations for adventure map",
                "required": [
                  "female",
                  "male"
                ],
                "properties": {
                  "female": {
                    "type": "string",
                    "description": "Female version. Warning: not implemented!",
                    "format": "defFile"
                  },
                  "male": {
                    "type": "string",
                    "description": "Male version",
                    "format": "defFile"
                  }
                }
              },
              {
                "patternProperties": {
                  "^female$": true,
                  "^male$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
