{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83835.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o83835.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "title": "VCMI town structures format",
                "description": "Format used to define structures visible on town screen in VCMI",
                "required": [
                  "animation",
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number",
                    "description": "Position on screen"
                  },
                  "area": {
                    "type": "string",
                    "description": "Area that indicate when building is selected. Must be 8-bit image",
                    "format": "imageFile"
                  },
                  "border": {
                    "type": "string",
                    "description": "Golden border around building, displayed when building is selected",
                    "format": "imageFile"
                  },
                  "y": {
                    "type": "number",
                    "description": "Position on screen"
                  },
                  "hidden": {
                    "type": "boolean",
                    "description": "If upgrade, this building will replace parent animation but will not alter its behaviour"
                  },
                  "animation": {
                    "type": "string",
                    "description": "Main animation file for this building",
                    "format": "animationFile"
                  },
                  "builds": {
                    "type": "string",
                    "description": ""
                  },
                  "z": {
                    "type": "number",
                    "description": "Position on screen. Buildings with higher value will be drawn on top of other buildings"
                  }
                }
              },
              {
                "patternProperties": {
                  "^hidden$": true,
                  "^x$": true,
                  "^border$": true,
                  "^area$": true,
                  "^animation$": true,
                  "^builds$": true,
                  "^z$": true,
                  "^y$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "VCMI town structures format",
    "description": "Format used to define structures visible on town screen in VCMI",
    "required": [
      "animation",
      "x",
      "y"
    ],
    "additionalProperties": false,
    "properties": {
      "animation": {
        "type": "string",
        "description": "Main animation file for this building",
        "format": "animationFile"
      },
      "area": {
        "type": "string",
        "description": "Area that indicate when building is selected. Must be 8-bit image",
        "format": "imageFile"
      },
      "border": {
        "type": "string",
        "description": "Golden border around building, displayed when building is selected",
        "format": "imageFile"
      },
      "builds": {
        "type": "string",
        "description": ""
      },
      "hidden": {
        "type": "boolean",
        "description": "If upgrade, this building will replace parent animation but will not alter its behaviour"
      },
      "x": {
        "type": "number",
        "description": "Position on screen"
      },
      "y": {
        "type": "number",
        "description": "Position on screen"
      },
      "z": {
        "type": "number",
        "description": "Position on screen. Buildings with higher value will be drawn on top of other buildings"
      }
    }
  }
}
