{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o84043.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o84043.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "web-dir"
    ],
    "properties": {
      "scripts": {
        "$ref": "#/$defs/modern_1"
      },
      "vars": {
        "$ref": "#/$defs/modern_2"
      },
      "web-dir": {
        "type": "string",
        "description": "Relative directory that contains files to be published as website"
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "This is a hash of script names (keys) and shell commands (values) to execute.",
                "patternProperties": {
                  "^([a-z0-9-])+$": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^([a-z0-9-])+$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "This is a hash of variable names (keys) and values (values).",
                "patternProperties": {
                  "^[a-zA-Z_][a-zA-Z_0-9]*$": {
                    "type": "string"
                  }
                }
              },
              {
                "patternProperties": {
                  "^[a-zA-Z_][a-zA-Z_0-9]*$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "web-dir"
    ],
    "properties": {
      "scripts": {
        "type": "object",
        "description": "This is a hash of script names (keys) and shell commands (values) to execute.",
        "additionalProperties": false,
        "patternProperties": {
          "^([a-z0-9-])+$": {
            "type": "string"
          }
        }
      },
      "vars": {
        "type": "object",
        "description": "This is a hash of variable names (keys) and values (values).",
        "additionalProperties": false,
        "patternProperties": {
          "^[a-zA-Z_][a-zA-Z_0-9]*$": {
            "type": "string"
          }
        }
      },
      "web-dir": {
        "type": "string",
        "description": "Relative directory that contains files to be published as website"
      }
    }
  }
}
