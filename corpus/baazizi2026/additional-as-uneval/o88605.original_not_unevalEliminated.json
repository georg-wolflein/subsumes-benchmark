                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "homePage",
                  "name"
                ]
              },
              {
                "patternProperties": {
                  "^homePage$": true,
                  "^name$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
