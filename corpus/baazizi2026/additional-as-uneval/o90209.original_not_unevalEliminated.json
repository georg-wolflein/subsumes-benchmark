{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90209.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90209.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "font",
                "type": "object",
                "description": "Font used for text symbols.",
                "properties": {
                  "weight": {
                    "type": "string",
                    "description": "The text weight.",
                    "enum": [
                      "bold",
                      "bolder",
                      "lighter",
                      "normal"
                    ],
                    "default": "normal"
                  },
                  "size": {
                    "type": "number",
                    "description": "The font size in points. Ignored when font is used on TextSymbol3DLayer."
                  },
                  "style": {
                    "type": "string",
                    "description": "The text style.",
                    "enum": [
                      "italic",
                      "normal",
                      "oblique"
                    ],
                    "default": "normal"
                  },
                  "family": {
                    "type": "string",
                    "description": "The font family."
                  },
                  "decoration": {
                    "type": "string",
                    "description": "The text decoration.",
                    "enum": [
                      "line-through",
                      "none",
                      "underline"
                    ],
                    "default": "none"
                  }
                },
                "esriDocumentation": {
                  "examples": [
                    {
                      "title": "font",
                      "code": {
                        "font": {
                          "family": "Arial",
                          "size": 12,
                          "style": "normal",
                          "weight": "bold",
                          "decoration": "none"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "patternProperties": {
                  "^style$": true,
                  "^decoration$": true,
                  "^family$": true,
                  "^weight$": true,
                  "^size$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "font",
    "type": "object",
    "description": "Font used for text symbols.",
    "properties": {
      "decoration": {
        "type": "string",
        "description": "The text decoration.",
        "enum": [
          "line-through",
          "none",
          "underline"
        ],
        "default": "none"
      },
      "family": {
        "type": "string",
        "description": "The font family."
      },
      "size": {
        "type": "number",
        "description": "The font size in points. Ignored when font is used on TextSymbol3DLayer."
      },
      "style": {
        "type": "string",
        "description": "The text style.",
        "enum": [
          "italic",
          "normal",
          "oblique"
        ],
        "default": "normal"
      },
      "weight": {
        "type": "string",
        "description": "The text weight.",
        "enum": [
          "bold",
          "bolder",
          "lighter",
          "normal"
        ],
        "default": "normal"
      }
    },
    "additionalProperties": false,
    "esriDocumentation": {
      "examples": [
        {
          "title": "font",
          "code": {
            "font": {
              "family": "Arial",
              "size": 12,
              "style": "normal",
              "weight": "bold",
              "decoration": "none"
            }
          }
        }
      ]
    }
  }
}
