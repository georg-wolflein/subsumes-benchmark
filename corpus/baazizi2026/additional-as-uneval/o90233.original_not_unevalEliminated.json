        ]
      },
      "longitudeFieldName": {
        "type": "string",
        "description": "A string defining the field name that holds the longitude (X) coordinate."
      }
    },
    "required": [
      "locationType"
    ],
    "additionalProperties": false,
    "esriDocumentation": {
      "examples": [
        {
          "title": "locationInfo",
          "code": {
