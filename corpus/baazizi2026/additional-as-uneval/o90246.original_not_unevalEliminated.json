{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "dependentRequired",
    "items",
    "maxItems",
    "minItems",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90246.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90246.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Multi-dimensional Definition",
                "type": "object",
                "properties": {
                  "dimensionName": {
                    "type": "string",
                    "description": "Type of dimension being used (ex. StdTime)."
                  },
                  "isSlice": {
                    "type": "boolean",
                    "description": "Is slice?",
                    "default": true
                  },
                  "values": {
                    "type": "array",
                    "description": "Array where every element is either a single value, or an array of two values (lower and upper bound).",
                    "items": {
                      "oneOf": [
                        {
                          "type": "number"
                        },
                        {
                          "type": "array",
                          "items": {
                            "type": "number"
                          },
                          "minItems": 2,
                          "maxItems": 2
                        }
                      ]
                    }
                  },
                  "variableName": {
                    "type": "string",
                    "description": "Name of the variable."
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "variableName"
                    ]
                  },
                  {
                    "required": [
                      "dimensionName",
                      "values"
                    ]
                  }
                ],
                "dependentRequired": {
                  "dimensionName": [
                    "values"
                  ],
                  "values": [
                    "dimensionName"
                  ]
                },
                "esriDocumentation": {
                  "additionalInformation": "[Multidimensional Definition](http://resources.arcgis.com/en/help/arcgis-rest-api/index.html#//02r300000290000000) in ArcGIS REST API",
                  "examples": [
                    {
                      "code": {
                        "multidimensionalDefinition": {
                          "variableName": "AvgSalinity",
                          "dimensionName": "StdZ",
                          "values": [
                            [
                              1406181600000,
                              1406182200000
                            ],
                            [
                              1406224800000,
                              1406225400000
                            ]
                          ],
                          "isSlice": false
                        }
                      }
                    }
                  ]
                }
              },
              {
                "patternProperties": {
                  "^dimensionName$": true,
                  "^isSlice$": true,
                  "^values$": true,
                  "^variableName$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Multi-dimensional Definition",
    "type": "object",
    "properties": {
      "dimensionName": {
        "type": "string",
        "description": "Type of dimension being used (ex. StdTime)."
      },
      "isSlice": {
        "type": "boolean",
        "description": "Is slice?",
        "default": true
      },
      "values": {
        "type": "array",
        "description": "Array where every element is either a single value, or an array of two values (lower and upper bound).",
        "items": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        }
      },
      "variableName": {
        "type": "string",
        "description": "Name of the variable."
      }
    },
    "anyOf": [
      {
        "required": [
          "variableName"
        ]
      },
      {
        "required": [
          "dimensionName",
          "values"
        ]
      }
    ],
    "additionalProperties": false,
    "dependentRequired": {
      "dimensionName": [
        "values"
      ],
      "values": [
        "dimensionName"
      ]
    },
    "esriDocumentation": {
      "additionalInformation": "[Multidimensional Definition](http://resources.arcgis.com/en/help/arcgis-rest-api/index.html#//02r300000290000000) in ArcGIS REST API",
      "examples": [
        {
          "code": {
            "multidimensionalDefinition": {
              "variableName": "AvgSalinity",
              "dimensionName": "StdZ",
              "values": [
                [
                  1406181600000,
                  1406182200000
                ],
                [
                  1406224800000,
                  1406225400000
                ]
              ],
              "isSlice": false
            }
          }
        }
      ]
    }
  }
}
