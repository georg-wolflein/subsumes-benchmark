{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90364.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90364.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "$$target": "awsSubnetConfig.json",
                "title": "AWS Subnet Configurationn",
                "description": "Describes an [AWS subnet](http://docs.aws.amazon.com/AmazonVPC/latest/UserGuide/VPC_Subnets.html).",
                "properties": {
                  "name": {
                    "description": "The name of the subnet, for use within k2 configurations.",
                    "type": "string"
                  },
                  "az": {
                    "description": "Name of the Availability Zone (AZ) in AWS. Regions and AZs are documented [here](http://docs.aws.amazon.com/AWSEC2/latest/UserGuide/using-regions-availability-zones.html#concepts-available-regions).",
                    "type": "string",
                    "default": "us-east-1a"
                  },
                  "cidr": {
                    "description": "The cidr to associate to the subnet (within the VPC).",
                    "format": "cidr",
                    "type": "string",
                    "default": "10.0.0.0/18"
                  },
                  "enablePublicIPs": {
                    "description": "Do we allow for Auto-assigned Public IPs, Our clusters default to true",
                    "type": "boolean",
                    "default": "true"
                  }
                },
                "required": [
                  "name",
                  "az",
                  "cidr"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^name$": true,
                  "^az$": true,
                  "^cidr$": true,
                  "^enablePublicIPs$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://judkins.house/apis/k2/v1/awsSubnetConfig.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$$target": "awsSubnetConfig.json",
    "title": "AWS Subnet Configurationn",
    "description": "Describes an [AWS subnet](http://docs.aws.amazon.com/AmazonVPC/latest/UserGuide/VPC_Subnets.html).",
    "properties": {
      "name": {
        "description": "The name of the subnet, for use within k2 configurations.",
        "type": "string"
      },
      "az": {
        "description": "Name of the Availability Zone (AZ) in AWS. Regions and AZs are documented [here](http://docs.aws.amazon.com/AWSEC2/latest/UserGuide/using-regions-availability-zones.html#concepts-available-regions).",
        "type": "string",
        "default": "us-east-1a"
      },
      "cidr": {
        "description": "The cidr to associate to the subnet (within the VPC).",
        "format": "cidr",
        "type": "string",
        "default": "10.0.0.0/18"
      },
      "enablePublicIPs": {
        "description": "Do we allow for Auto-assigned Public IPs, Our clusters default to true",
        "type": "boolean",
        "default": "true"
      }
    },
    "required": [
      "name",
      "az",
      "cidr"
    ],
    "additionalProperties": false,
    "type": "object"
  }
}
