{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90402.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90402.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "$$target": "kubeDns.json",
                "title": "Kubernetes DNS Configurations",
                "description": "Describes the configuration of DNS for the Kubernetes cluster.",
                "properties": {
                  "cluster_ip": {
                    "description": "This should be the same as the IP set in the deployment.clusters[x].dns in the main configuration file.",
                    "type": "string"
                  },
                  "dns_domain": {
                    "description": "This should be the same as the domain set in deployment.clusters[x].domain in the main configuration file.",
                    "type": "string"
                  },
                  "namespace": {
                    "description": "Kubernetes is expecting DNS to be in kube-system.",
                    "type": "string"
                  }
                },
                "required": [
                  "cluster_ip",
                  "dns_domain"
                ],
                "type": "object"
              },
              {
                "patternProperties": {
                  "^cluster_ip$": true,
                  "^dns_domain$": true,
                  "^namespace$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://judkins.house/apis/k2/v1/kubeDns.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$$target": "kubeDns.json",
    "title": "Kubernetes DNS Configurations",
    "description": "Describes the configuration of DNS for the Kubernetes cluster.",
    "properties": {
      "cluster_ip": {
        "description": "This should be the same as the IP set in the deployment.clusters[x].dns in the main configuration file.",
        "type": "string"
      },
      "dns_domain": {
        "description": "This should be the same as the domain set in deployment.clusters[x].domain in the main configuration file.",
        "type": "string"
      },
      "namespace": {
        "description": "Kubernetes is expecting DNS to be in kube-system.",
        "type": "string"
      }
    },
    "required": [
      "cluster_ip",
      "dns_domain"
    ],
    "additionalProperties": false,
    "type": "object"
  }
}
