{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "items",
    "maxItems",
    "minItems",
    "oneOf",
    "patternProperties",
    "properties",
    "propertyNames",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90905.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o90905.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$id": "http://labcompass.futurecode.com/room-presets.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "required": [
        "roomName",
        "goldenDoor",
        "variants"
      ],
      "properties": {
        "roomName": {
          "type": "string"
        },
        "goldenDoor": {
          "type": "boolean"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "areaCode",
              "contentLocations",
              "doorLocations",
              "minimap"
            ],
            "properties": {
              "areaCode": {
                "type": "string"
              },
              "contentLocations": {
                "type": "object",
                "oneOf": [
                  {
                    "$ref": "#/$defs/modern_1"
                  },
                  {
                    "$ref": "#/$defs/modern_2"
                  }
                ]
              },
              "doorLocations": {
                "$ref": "#/$defs/directionList"
              },
              "minimap": {
                "type": "object",
                "required": [
                  "rows",
                  "columns",
                  "directions"
                ],
                "properties": {
                  "rows": {
                    "type": "integer"
                  },
                  "columns": {
                    "type": "integer"
                  },
                  "directions": {
                    "$ref": "#/$defs/modern_3"
                  }
                }
              }
            }
          }
        }
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "required": [
                  "major",
                  "minor"
                ],
                "properties": {
                  "major": {
                    "$ref": "#/$defs/directionList"
                  },
                  "minor": {
                    "$ref": "#/$defs/directionList"
                  }
                }
              },
              {
                "patternProperties": {
                  "^major$": true,
                  "^minor$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "directionList": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/direction"
        }
      },
      "direction": {
        "enum": [
          "N",
          "NE",
          "E",
          "SE",
          "S",
          "SW",
          "W",
          "NW"
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "required": [
                  "generic"
                ],
                "properties": {
                  "generic": {
                    "$ref": "#/$defs/directionList"
                  }
                }
              },
              {
                "patternProperties": {
                  "^generic$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/direction"
                }
              },
              {
                "additionalProperties": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2,
                  "items": {
                    "type": "integer"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$id": "http://labcompass.futurecode.com/room-presets.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "required": [
        "roomName",
        "goldenDoor",
        "variants"
      ],
      "properties": {
        "roomName": {
          "type": "string"
        },
        "goldenDoor": {
          "type": "boolean"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "areaCode",
              "contentLocations",
              "doorLocations",
              "minimap"
            ],
            "properties": {
              "areaCode": {
                "type": "string"
              },
              "contentLocations": {
                "type": "object",
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "required": [
                      "major",
                      "minor"
                    ],
                    "properties": {
                      "major": {
                        "$ref": "#/$defs/directionList"
                      },
                      "minor": {
                        "$ref": "#/$defs/directionList"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "required": [
                      "generic"
                    ],
                    "properties": {
                      "generic": {
                        "$ref": "#/$defs/directionList"
                      }
                    }
                  }
                ]
              },
              "doorLocations": {
                "$ref": "#/$defs/directionList"
              },
              "minimap": {
                "type": "object",
                "required": [
                  "rows",
                  "columns",
                  "directions"
                ],
                "properties": {
                  "rows": {
                    "type": "integer"
                  },
                  "columns": {
                    "type": "integer"
                  },
                  "directions": {
                    "type": "object",
                    "propertyNames": {
                      "$ref": "#/$defs/direction"
                    },
                    "additionalProperties": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "$defs": {
      "direction": {
        "enum": [
          "N",
          "NE",
          "E",
          "SE",
          "S",
          "SW",
          "W",
          "NW"
        ]
      },
      "directionList": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/direction"
        }
      }
    }
  }
}
