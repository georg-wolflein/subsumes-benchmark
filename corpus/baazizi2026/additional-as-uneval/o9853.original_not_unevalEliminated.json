{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "items",
    "maxItems",
    "maxLength",
    "minLength",
    "pattern",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9853.original_not_unevalEliminated.json",
    "duplicates": [
      "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9853.unevalEliminated_not_original.json"
    ]
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "flowId": {
                    "type": "string",
                    "pattern": "^[A-Fa-f\\d]{24}$"
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "deviceIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Fa-f\\d]{24}$"
                    },
                    "maxItems": 1000
                  },
                  "deviceTags": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/modern_2"
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "flowId",
                  "version"
                ]
              },
              {
                "patternProperties": {
                  "^flowId$": true,
                  "^version$": true,
                  "^deviceIds$": true,
                  "^deviceTags$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[0-9a-zA-Z_-]{1,255}$"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                }
              },
              {
                "patternProperties": {
                  "^key$": true,
                  "^value$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "flowId": {
        "type": "string",
        "pattern": "^[A-Fa-f\\d]{24}$"
      },
      "version": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 255
      },
      "deviceIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Fa-f\\d]{24}$"
        },
        "maxItems": 1000
      },
      "deviceTags": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[0-9a-zA-Z_-]{1,255}$"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          },
          "additionalProperties": false
        },
        "maxItems": 100
      }
    },
    "additionalProperties": false,
    "required": [
      "flowId",
      "version"
    ]
  }
}
