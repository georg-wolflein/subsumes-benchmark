                        "maxLength": 255
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sslCert": {
                    "type": "string",
                    "maxLength": 32767,
                    "minLength": 50
                  },
                  "sslBundle": {
                    "type": "string",
                    "maxLength": 32767,
                    "minLength": 50
                  },
                  "sslKey": {
                    "type": "string",
                    "maxLength": 32767,
                    "minLength": 50
                  }
                },
                "required": [
                  "domainName"
                ]
              },
              {
                "patternProperties": {
                  "^sslBundle$": true,
                  "^sslCert$": true,
                  "^sslKey$": true,
                  "^domainName$": true,
                  "^version$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "sslKey": {
        "type": "string",
        "maxLength": 32767,
        "minLength": 50
      },
      "sslCert": {
        "type": "string",
        "maxLength": 32767,
        "minLength": 50
      },
      "sslBundle": {
        "type": "string",
        "maxLength": 32767,
        "minLength": 50
      },
