{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "items",
    "maxItems",
    "maxLength",
    "minLength",
    "pattern",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9888.original_not_unevalEliminated.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/additional_as_uneval_eliminated_containment/unsat/o9888.unevalEliminated_not_original.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "userTags": {
                    "$ref": "#/$defs/modern_2"
                  },
                  "tokenCutoff": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "lastName": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "firstName": {
                    "type": "string",
                    "maxLength": 1024
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 2048
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 1024
                  },
                  "experienceGroupIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Fa-f\\d]{24}$"
                    },
                    "maxItems": 1000
                  }
                }
              },
              {
                "patternProperties": {
                  "^tokenCutoff$": true,
                  "^lastName$": true,
                  "^experienceGroupIds$": true,
                  "^password$": true,
                  "^firstName$": true,
                  "^userTags$": true,
                  "^email$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "patternProperties": {
                  "^[0-9a-zA-Z_-]{1,255}$": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                }
              },
              {
                "patternProperties": {
                  "^[0-9a-zA-Z_-]{1,255}$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "email": {
        "type": "string",
        "format": "email",
        "maxLength": 1024
      },
      "firstName": {
        "type": "string",
        "maxLength": 1024
      },
      "lastName": {
        "type": "string",
        "maxLength": 1024
      },
      "password": {
        "type": "string",
        "minLength": 8,
        "maxLength": 2048
      },
      "tokenCutoff": {
        "type": "string",
        "format": "date-time"
      },
      "userTags": {
        "type": "object",
        "patternProperties": {
          "^[0-9a-zA-Z_-]{1,255}$": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        },
        "additionalProperties": false
      },
      "experienceGroupIds": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Fa-f\\d]{24}$"
        },
        "maxItems": 1000
      }
    },
    "additionalProperties": false
  }
}
