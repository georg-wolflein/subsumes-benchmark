{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "anyOf",
    "oneOf",
    "pattern",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o36080.anyOf_not_oneOf.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o36080.oneOf_not_anyOf.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A generic numerical value container: can be an integer, stringified fraction or stringified IEEE-754 value.",
    "type": [
      "integer",
      "string"
    ],
    "oneOf": [
      {
        "type": "integer"
      },
      {
        "$ref": "#/$defs/fraction"
      },
      {
        "$ref": "#/$defs/ieee754"
      }
    ],
    "$defs": {
      "fraction": {
        "description": "A stringified fraction. For example ``4/7'' or ``-11/3''.",
        "type": "string",
        "pattern": "^-?\\d+/\\d+$"
      },
      "ieee754": {
        "description": "A stringified IEEE-754 value in ``%a'' format. For example, ``sqrt(2)`` is nearest to ``0x1.6a09e667f3bcdp+0''.",
        "type": "string",
        "pattern": "^-?0x1\\.[0-9a-f]{13}p[+-]\\d+$"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A generic numerical value container: can be an integer, stringified fraction or stringified IEEE-754 value.",
    "type": [
      "integer",
      "string"
    ],
    "anyOf": [
      {
        "type": "integer"
      },
      {
        "$ref": "#/$defs/fraction"
      },
      {
        "$ref": "#/$defs/ieee754"
      }
    ],
    "$defs": {
      "fraction": {
        "description": "A stringified fraction. For example ``4/7'' or ``-11/3''.",
        "type": "string",
        "pattern": "^-?\\d+/\\d+$"
      },
      "ieee754": {
        "description": "A stringified IEEE-754 value in ``%a'' format. For example, ``sqrt(2)`` is nearest to ``0x1.6a09e667f3bcdp+0''.",
        "type": "string",
        "pattern": "^-?0x1\\.[0-9a-f]{13}p[+-]\\d+$"
      }
    }
  }
}
