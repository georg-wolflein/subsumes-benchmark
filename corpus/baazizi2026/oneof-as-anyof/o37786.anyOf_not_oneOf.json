{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "anyOf",
    "enum",
    "items",
    "maxItems",
    "maximum",
    "minItems",
    "minProperties",
    "minimum",
    "not",
    "oneOf",
    "pattern",
    "patternProperties",
    "properties",
    "recursion",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/sat/o37786.anyOf_not_oneOf.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o37786.oneOf_not_anyOf.json"
  ],
  "a": {
    "$id": "https://tabris.com/colors-schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Tabris.js Color Resources JSON Schema",
    "oneOf": [
      {
        "$ref": "#/$defs/colorResources"
      }
    ],
    "$defs": {
      "colorResources": {
        "type": "object",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "$scaleFactor": {
            "enum": [
              "nearest",
              "lower",
              "higher"
            ]
          },
          "$fallbackLanguage": {
            "type": "string",
            "pattern": "^[a-zA-Z][a-zA-Z][a-zA-Z]?(-[\\-a-zA-Z0-9]+)?$"
          }
        },
        "patternProperties": {
          "^[a-z][a-zA-Z][a-zA-Z0-9]+$": {
            "$ref": "#/$defs/colorResource"
          }
        },
        "additionalProperties": false
      },
      "colorResource": {
        "oneOf": [
          {
            "$ref": "#/$defs/colorDefinition"
          },
          {
            "$ref": "#/$defs/colorSelector"
          }
        ]
      },
      "colorSelector": {
        "oneOf": [
          {
            "description": "Platform Selector",
            "type": "object",
            "properties": {
              "ios": {
                "$ref": "#/$defs/colorResource"
              },
              "android": {
                "$ref": "#/$defs/colorResource"
              }
            },
            "required": [
              "ios",
              "android"
            ],
            "additionalProperties": false
          },
          {
            "description": "Resource Reference",
            "type": "object",
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string"
              }
            },
            "additionalProperties": false
          },
          {
            "description": "Inherit Marker",
            "type": "object",
            "properties": {
              "inherit": {
                "enum": [
                  true
                ]
              }
            },
            "required": [
              "inherit"
            ],
            "additionalProperties": false
          },
          {
            "description": "Scale Selector",
            "type": "object",
            "patternProperties": {
              "^([0-9]\\.?[0-9]*)x$": {
                "$ref": "#/$defs/colorResource"
              }
            },
            "additionalProperties": false,
            "minProperties": 1
          },
          {
            "description": "Locale Selector",
            "type": "object",
            "patternProperties": {
              "^[a-zA-Z][a-zA-Z][a-zA-Z]?(-[\\-a-zA-Z0-9]+)?$": {
                "$ref": "#/$defs/colorResource"
              }
            },
            "additionalProperties": false,
            "minProperties": 1,
            "not": {
              "required": [
                "ios"
              ]
            }
          }
        ]
      },
      "colorDefinition": {
        "oneOf": [
          {
            "type": "array",
            "minItems": 3,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 255
            }
          },
          {
            "type": "string",
            "pattern": "^#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]?[0-9a-fA-F]?$"
          },
          {
            "enum": [
              "black",
              "silver",
              "gray",
              "white",
              "maroon",
              "red",
              "purple",
              "fuchsia",
              "green",
              "lime",
              "olive",
              "yellow",
              "navy",
              "blue",
              "teal",
              "aqua",
              "transparent"
            ]
          }
        ]
      }
    }
  },
