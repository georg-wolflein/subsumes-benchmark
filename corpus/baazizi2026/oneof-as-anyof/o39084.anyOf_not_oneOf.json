            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "from": {
        "description": "RegExp(s) to find from files.",
        "oneOf": [
          {
            "instanceof": "RegExp"
          },
          {
            "preproccess": "regexp",
            "type": "string"
          },
          {
            "items": {
              "oneOf": [
                {
                  "instanceof": "RegExp"
                },
                {
                  "preproccess": "regexp",
                  "type": "string"
                }
              ]
            },
            "minItems": 1,
            "type": "array"
          }
        ]
      },
      "to": {
        "description": "Multiple replacements with same/different strings (replaced sequentially).",
        "oneOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        ]
      }
    },
    "required": [
      "$tool",
      "files",
      "from",
      "to"
    ],
    "title": "replace-in-file Config",
    "type": "object"
  },
