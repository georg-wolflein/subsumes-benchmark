        "required": [
          "type",
          "name",
          "styleName"
        ]
      }
    ],
    "additionalProperties": false,
    "esriDocumentation": {
      "examples": [
        {
          "code": {
            "symbol": {
              "type": "styleSymbolReference",
              "styleName": "EsriThematicTreesStyle",
              "name": "Frangula"
            }
          }
        }
      ]
    }
