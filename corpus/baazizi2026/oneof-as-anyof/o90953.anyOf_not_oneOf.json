    "a_subsumes_b": {
      "checkers": [
        "RWG 8064ad8",
        "subsumes 0.2.0"
      ]
    },
    "b_subsumes_a": {
      "checkers": [
        "RWG 8064ad8",
        "subsumes 0.2.0"
      ]
    }
  },
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A JSON RPC 2.0 response",
    "oneOf": [
      {
        "$ref": "#/$defs/success"
      },
      {
        "$ref": "#/$defs/error"
      },
      {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "$ref": "#/$defs/success"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      }
    ],
    "$defs": {
      "common": {
        "required": [
          "id",
          "jsonrpc"
        ],
        "not": {
          "description": "cannot have result and error at the same time",
          "required": [
            "result",
            "error"
          ]
        },
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "integer",
              "null"
            ],
            "note": [
              "spec says a number which should not contain a fractional part",
              "We choose integer here, but this is unenforceable with some languages"
            ]
          },
          "jsonrpc": {
            "enum": [
              "2.0"
            ]
          }
        }
      },
      "success": {
        "description": "A success. The result member is then required and can be anything.",
        "allOf": [
          {
            "$ref": "#/$defs/common"
          },
          {
            "required": [
              "result"
            ]
          }
        ]
      },
      "error": {
        "allOf": [
          {
            "$ref": "#/$defs/common"
          },
          {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "integer",
                    "note": [
                      "unenforceable in some languages"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "data": {
                    "description": "optional, can be anything"
                  }
                }
              }
            }
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A JSON RPC 2.0 response",
    "anyOf": [
      {
        "$ref": "#/$defs/success"
      },
      {
        "$ref": "#/$defs/error"
      },
      {
        "type": "array",
        "items": {
          "anyOf": [
            {
              "$ref": "#/$defs/success"
            },
            {
              "$ref": "#/$defs/error"
            }
          ]
        }
      }
    ],
    "$defs": {
      "common": {
        "required": [
          "id",
          "jsonrpc"
        ],
        "not": {
          "description": "cannot have result and error at the same time",
          "required": [
            "result",
            "error"
          ]
        },
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "string",
              "integer",
              "null"
            ],
            "note": [
              "spec says a number which should not contain a fractional part",
              "We choose integer here, but this is unenforceable with some languages"
            ]
          },
          "jsonrpc": {
            "enum": [
              "2.0"
            ]
          }
        }
      },
      "success": {
        "description": "A success. The result member is then required and can be anything.",
        "allOf": [
          {
            "$ref": "#/$defs/common"
          },
          {
            "required": [
              "result"
            ]
          }
        ]
      },
      "error": {
        "allOf": [
          {
            "$ref": "#/$defs/common"
          },
          {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "code",
                  "message"
                ],
                "properties": {
                  "code": {
                    "type": "integer",
                    "note": [
                      "unenforceable in some languages"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "data": {
