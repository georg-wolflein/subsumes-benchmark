{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minimum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_9.translate_not_trivial.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_9.trivial_not_translate.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "description": "Write datapoints and events to an influxdb database",
    "required": [
      "host",
      "database"
    ],
    "properties": {
      "host": {
        "type": "string",
        "description": "URL of the host influxdb server"
      },
      "username": {
        "type": "string",
        "description": "Username for the influxdb server"
      },
      "password": {
        "type": "string",
        "description": "Password for the influxdb server"
      },
      "database": {
        "type": "string",
        "description": "Database to connect to on the influxdb server"
      },
      "point-chunk-size": {
        "type": "integer",
        "description": "Maximum number of points to send in each request to influx",
        "minimum": 1,
        "default": 100000
      },
      "debug": {
        "type": "boolean",
        "description": "Debug mode. If true, data will not be pushed to target"
      },
      "read-extracted-ranges": {
        "type": "boolean",
        "description": "Whether to read start/end points on startup, where possible."
      },
      "read-extracted-event-ranges": {
        "type": "boolean",
        "description": "Whether to read start/end points for events on startup, where possible"
      },
      "non-finite-replacement": {
        "type": [
          "number",
          "null"
        ],
        "description": "Replace all instances of NaN or Infinity with this floating point number"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Write datapoints and events to an influxdb database",
                "required": [
                  "host",
                  "database"
                ],
                "properties": {
                  "database": {
                    "type": "string",
                    "description": "Database to connect to on the influxdb server"
                  },
                  "read-extracted-ranges": {
                    "type": "boolean",
                    "description": "Whether to read start/end points on startup, where possible."
                  },
                  "non-finite-replacement": {
                    "type": [
                      "number",
                      "null"
                    ],
                    "description": "Replace all instances of NaN or Infinity with this floating point number"
                  },
                  "username": {
                    "type": "string",
                    "description": "Username for the influxdb server"
                  },
                  "host": {
                    "type": "string",
                    "description": "URL of the host influxdb server"
                  },
                  "debug": {
                    "type": "boolean",
                    "description": "Debug mode. If true, data will not be pushed to target"
                  },
                  "read-extracted-event-ranges": {
                    "type": "boolean",
                    "description": "Whether to read start/end points for events on startup, where possible"
                  },
                  "point-chunk-size": {
                    "type": "integer",
                    "description": "Maximum number of points to send in each request to influx",
                    "minimum": 1.0,
                    "default": 100000
                  },
                  "password": {
                    "type": "string",
                    "description": "Password for the influxdb server"
                  }
                }
              },
              {
                "patternProperties": {
                  "^debug$": true,
                  "^read-extracted-ranges$": true,
                  "^username$": true,
                  "^read-extracted-event-ranges$": true,
                  "^host$": true,
                  "^password$": true,
                  "^non-finite-replacement$": true,
                  "^point-chunk-size$": true,
                  "^database$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
