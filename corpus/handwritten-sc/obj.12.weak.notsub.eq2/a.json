{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "a": {
      "type": "string",
      "pattern": "a|b|c"
    },
    "b": {
      "type": "string",
      "pattern": "^(a|b)c$"
    },
    "c": {
      "type": "string",
      "enum": [
        "ac",
        "bc"
      ]
    }
  },
  "additionalProperties": {
    "type": "string",
    "pattern": "ac|bc",
    "maxLength": 2
  }
}
