{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "a": {
      "type": "string",
      "pattern": "a|b|c",
      "patternStrong": "c|aa",
      "patternWeak": "a|b?|c"
    }
  },
  "additionalProperties": {
    "allOf": [
      {
        "type": "string",
        "pattern": "(a|b)c",
        "maxLength": 3
      },
      {
        "type": "string",
        "pattern": "z",
        "minLength": 2
      }
    ]
  }
}
