{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "allOf",
    "anyOf",
    "maximum",
    "minimum",
    "not",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/trickyschemas/unsat/obj.29.strong.sub.eq2.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "required": [
          "a",
          "b"
        ],
        "properties": {
          "a": {
            "type": "number",
            "minimum": 5
          },
          "b": {
            "type": "number",
            "maximum": 100
          }
        }
      },
      {
        "type": "object",
        "required": [
          "b"
        ],
        "properties": {
          "b": {
            "allOf": [
              {
                "type": "number",
                "minimum": 5
              },
              {
                "type": "number",
                "maximum": 100
              }
            ]
          }
        }
      }
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "not": {
          "patternProperties": {
            "^(a|b)$": {
              "not": {
                "type": "number",
                "_minimum": 5,
                "minimum": 10,
                "_minimumWeak": 3
              }
            }
          }
        }
      },
      {
        "not": {
          "patternProperties": {
            "^b$": {
              "not": {
                "type": "number",
                "maximum": 100
              }
            }
          }
        }
      }
    ]
  }
}
