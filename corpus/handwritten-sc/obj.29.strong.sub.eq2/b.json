{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "not": {
        "patternProperties": {
          "^(a|b)$": {
            "not": {
              "type": "number",
              "_minimum": 5,
              "minimum": 10,
              "_minimumWeak": 3
            }
          }
        }
      }
    },
    {
      "not": {
        "patternProperties": {
          "^b$": {
            "not": {
              "type": "number",
              "maximum": 100
            }
          }
        }
      }
    }
  ]
}
