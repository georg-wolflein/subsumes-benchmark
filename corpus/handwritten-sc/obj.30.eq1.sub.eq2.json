{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "allOf",
    "anyOf",
    "maximum",
    "minimum",
    "not",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/trickyschemas/unsat/obj.30.eq1.sub.eq2.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "required": [
          "a",
          "b"
        ],
        "properties": {
          "a": {
            "$ref": "#/$defs/eq2A"
          },
          "b": {
            "$ref": "#/$defs/eq2B"
          }
        }
      },
      {
        "type": "object",
        "required": [
          "b"
        ],
        "properties": {
          "b": {
            "allOf": [
              {
                "$ref": "#/$defs/eq2A"
              },
              {
                "$ref": "#/$defs/eq2B"
              }
            ]
          }
        }
      }
    ],
    "$defs": {
      "eq2A": {
        "type": "number",
        "minimum": 5
      },
      "eq2B": {
        "type": "number",
        "maximum": 100
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "not": {
          "patternProperties": {
            "^(a|b)$": {
              "not": {
                "$ref": "#/$defs/eq1A"
              }
            }
          }
        }
      },
      {
        "not": {
          "patternProperties": {
            "^b$": {
              "not": {
                "$ref": "#/$defs/eq1B"
              }
            }
          }
        }
      }
    ],
    "$defs": {
      "eq1A": {
        "type": "number",
        "minimum": 5,
        "minimumStrong": 10,
        "minimumWeak": 3
      },
      "eq1B": {
        "type": "number",
        "maximum": 100
      }
    }
  }
}
