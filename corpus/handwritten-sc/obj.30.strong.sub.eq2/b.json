{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "not": {
        "patternProperties": {
          "^(a|b)$": {
            "not": {
              "$ref": "#/$defs/eq1A"
            }
          }
        }
      }
    },
    {
      "not": {
        "patternProperties": {
          "^b$": {
            "not": {
              "$ref": "#/$defs/eq1B"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "eq1A": {
      "type": "number",
      "_minimum": 5,
      "minimum": 10,
      "_minimumWeak": 3
    },
    "eq1B": {
      "type": "number",
      "maximum": 100
    }
  }
}
