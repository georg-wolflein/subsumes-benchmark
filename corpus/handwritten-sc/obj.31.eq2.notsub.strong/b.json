{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "required": [
        "a",
        "b"
      ],
      "properties": {
        "a": {
          "$ref": "#/$defs/eq2Right"
        },
        "b": {
          "$ref": "#/$defs/eq2B"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "b"
      ],
      "properties": {
        "b": {
          "allOf": [
            {
              "$ref": "#/$defs/eq2Right"
            },
            {
              "$ref": "#/$defs/eq2B"
            }
          ]
        }
      }
    },
    {
      "allOf": [
        {
          "not": {
            "$ref": "#/$defs/eq2A"
          }
        },
        {
          "$ref": "#/$defs/eq2A"
        }
      ]
    }
  ],
  "$defs": {
    "eq2A": {
      "type": "number",
      "minimum": 5
    },
    "eq2B": {
      "type": "number",
      "maximum": 100
    },
    "eq2Left": {
      "allOf": [
        {
          "not": {
            "patternProperties": {
              "^(a|b)$": {
                "not": {
                  "$ref": "#/$defs/eq2A"
                }
              }
            }
          }
        },
        {
          "not": {
            "patternProperties": {
              "^b$": {
                "not": {
                  "$ref": "#/$defs/eq2B"
                }
              }
            }
          }
        }
      ]
    },
    "eq2Right": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "a",
            "b"
          ],
          "properties": {
            "a": {
              "$ref": "#/$defs/eq2A"
            },
            "b": {
              "$ref": "#/$defs/eq2B"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "b"
          ],
          "properties": {
            "b": {
              "allOf": [
                {
                  "$ref": "#/$defs/eq2A"
                },
                {
                  "$ref": "#/$defs/eq2B"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
