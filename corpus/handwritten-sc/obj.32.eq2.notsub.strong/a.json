{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "type": "object",
      "patternProperties": {
        "a.*": {
          "type": "string"
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 3
      },
      "minProperties": 1,
      "maxProperties": 1
    },
    {
      "patternProperties": {
        ".*": {
          "_maxLength": 2,
          "maxLength": 1,
          "_maxLengthWeak": 3
        }
      }
    }
  ]
}
