{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "allOf",
    "maxLength",
    "maxProperties",
    "minLength",
    "minProperties",
    "not",
    "patternProperties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/trickyschemas/unsat/obj.33.eq2.sub.weak.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/trickyschemas/sat/obj.33.weak.notsub.eq2.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "type": "object",
        "patternProperties": {
          "^a.*": {
            "type": "string"
          }
        }
      },
      {
        "patternProperties": {
          "^[^a].*": {
            "type": "string",
            "minLength": 5
          }
        },
        "minProperties": 1,
        "maxProperties": 1
      },
      {
        "patternProperties": {
          ".*": {
            "maxLength": 4
          }
        }
      },
      {
        "patternProperties": {
          "a": {
            "_maxLength": 2,
            "_maxLengthStrong": 1,
            "maxLength": 3
          }
        }
      }
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "not": {
      "patternProperties": {
        "^a.*": {
          "minLength": 3
        }
      }
    },
    "maxProperties": 1
  }
}
