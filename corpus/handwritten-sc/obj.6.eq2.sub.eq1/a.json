{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "patternProperties": {
    "^(a|b)": {
      "type": "number",
      "minimum": 5,
      "minimumStrong": 10,
      "minimumWeak": 3
    },
    "^a": {
      "allOf": [
        {
          "type": "number",
          "minimum": 5
        },
        {
          "type": "number",
          "maximum": 100
        }
      ]
    },
    "^(a|c)": {
      "type": "number",
      "maximum": 100
    }
  }
}
