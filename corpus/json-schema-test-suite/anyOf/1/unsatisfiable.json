{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "anyOf",
    "maxLength",
    "minLength",
    "not",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/anyOf.json#/tests/1",
  "a": false,
  "b": {
    "allOf": [
      {
        "type": "string",
        "anyOf": [
          {
            "maxLength": 2
          },
          {
            "minLength": 4
          }
        ]
      },
      {
        "not": {
          "type": "string",
          "anyOf": [
            {
              "maxLength": 2
            },
            {
              "minLength": 4
            }
          ]
        }
      }
    ]
  }
}
