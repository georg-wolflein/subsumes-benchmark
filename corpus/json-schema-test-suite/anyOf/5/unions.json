{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "anyOf",
    "const",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/anyOf.json#/tests/5",
  "a": {
    "anyOf": [
      {
        "properties": {
          "bar": {
            "type": "integer"
          }
        },
        "required": [
          "bar"
        ]
      },
      {
        "properties": {
          "foo": {
            "type": "string"
          }
        },
        "required": [
          "foo"
        ]
      }
    ]
  },
  "b": {
    "anyOf": [
      {
        "const": {
          "bar": 2
        }
      },
      {
        "const": {
          "foo": "baz"
        }
      },
      {
        "const": {
          "foo": "baz",
          "bar": 2
        }
      }
    ]
  }
}
