{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "anyOf",
    "const",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/default.json#/tests/0",
  "a": {
    "properties": {
      "foo": {
        "type": "integer",
        "default": []
      }
    }
  },
  "b": {
    "anyOf": [
      {
        "const": {
          "foo": 13
        }
      },
      {
        "const": {}
      }
    ]
  }
}
