{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "anyOf",
    "const",
    "minLength",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/default.json#/tests/1",
  "derived": {
    "b_subsumes_a": {
      "counterexample": null
    }
  },
  "a": {
    "properties": {
      "bar": {
        "type": "string",
        "minLength": 4,
        "default": "bad"
      }
    }
  },
  "b": {
    "anyOf": [
      {
        "const": {
          "bar": "good"
        }
      },
      {
        "const": {}
      }
    ]
  }
}
