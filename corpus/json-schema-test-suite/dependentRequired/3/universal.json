{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "dependentRequired",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dependentRequired.json#/tests/3",
  "a": true,
  "b": {
    "anyOf": [
      {
        "dependentRequired": {
          "bar": []
        }
      },
      {
        "not": {
          "dependentRequired": {
            "bar": []
          }
        }
      }
    ]
  }
}
