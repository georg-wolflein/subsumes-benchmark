{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$dynamicRef",
    "$ref",
    "additionalProperties",
    "allOf",
    "items",
    "not",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dynamicRef.json#/tests/13",
  "a": false,
  "b": {
    "allOf": [
      {
        "$ref": "http://localhost:1234/strict-extendible.json"
      },
      {
        "not": {
          "$ref": "http://localhost:1234/strict-extendible.json"
        }
      }
    ],
    "$defs": {
      "http://localhost:1234/strict-extendible.json": {
        "$id": "http://localhost:1234/strict-extendible.json",
        "$ref": "extendible-dynamic-ref.json",
        "$defs": {
          "elements": {
            "$dynamicAnchor": "elements",
            "properties": {
              "a": true
            },
            "required": [
              "a"
            ],
            "additionalProperties": false
          },
          "http://localhost:1234/extendible-dynamic-ref.json": {
            "$id": "http://localhost:1234/extendible-dynamic-ref.json",
            "description": "extendible array",
            "type": "object",
            "properties": {
              "elements": {
                "type": "array",
                "items": {
                  "$dynamicRef": "#elements"
                }
              }
            },
            "required": [
              "elements"
            ],
            "additionalProperties": false,
            "$defs": {
              "elements": {
                "$dynamicAnchor": "elements"
              }
            }
          }
        }
      }
    }
  }
}
