{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "$dynamicRef",
    "const",
    "items",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dynamicRef.json#/tests/24/tests/1",
  "a": {
    "type": "array",
    "items": {
      "$dynamicRef": "#items"
    },
    "$defs": {
      "foo": {
        "$anchor": "items",
        "type": "string"
      }
    }
  },
  "b": {
    "const": [
      "foo",
      42
    ]
  }
}
