{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "anyOf",
    "const",
    "format"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/format-uri-reference.json#/tests/2",
  "a": {
    "format": "uri-reference"
  },
  "b": {
    "anyOf": [
      {
        "const": "http://foo.bar/?baz=qux#quux"
      },
      {
        "const": "//foo.bar/?baz=qux#quux"
      },
      {
        "const": "/abc"
      },
      {
        "const": "abc"
      },
      {
        "const": "#fragment"
      },
      {
        "const": "http://087.10.0.1/"
      },
      {
        "const": "http://999.999.999.999/"
      },
      {
        "const": ""
      },
      {
        "const": "?query=1"
      },
      {
        "const": "//"
      },
      {
        "const": "./this:that"
      }
    ]
  }
}
