{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "minimum",
    "properties",
    "recursion"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/10",
  "a": {
    "$comment": "URIs do not have to have HTTP(s) schemes",
    "$id": "tag:foo.example,2025:bar/baz",
    "minimum": 30,
    "properties": {
      "foo": {
        "$ref": "tag:foo.example,2025:bar/baz"
      }
    }
  },
  "b": {
    "$comment": "URIs do not have to have HTTP(s) schemes",
    "$id": "tag:foo.example,2025:bar/baz",
    "minimum": 30,
    "properties": {
      "foo": {
        "$ref": "tag:foo.example,2025:bar/baz"
      }
    }
  }
}
