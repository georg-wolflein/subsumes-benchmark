{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "allOf",
    "not",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/19",
  "a": false,
  "b": {
    "allOf": [
      {
        "$ref": "file:///c:/folder/file.json"
      },
      {
        "not": {
          "$ref": "file:///c:/folder/file.json"
        }
      }
    ],
    "$defs": {
      "file:///c:/folder/file.json": {
        "$id": "file:///c:/folder/file.json",
        "$defs": {
          "foo": {
            "type": "number"
          }
        },
        "$ref": "#/$defs/foo"
      }
    }
  }
}
