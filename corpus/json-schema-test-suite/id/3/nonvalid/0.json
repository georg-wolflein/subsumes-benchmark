{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "const",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/3/tests/0",
  "a": {
    "not": {
      "$ref": "http://example.com/schema-relative-uri-defs1.json"
    },
    "$defs": {
      "http://example.com/schema-relative-uri-defs1.json": {
        "$id": "http://example.com/schema-relative-uri-defs1.json",
        "properties": {
          "foo": {
            "$id": "schema-relative-uri-defs2.json",
            "$defs": {
              "inner": {
                "properties": {
                  "bar": {
                    "type": "string"
                  }
                }
              }
            },
            "$ref": "#/$defs/inner"
          }
        },
        "$ref": "schema-relative-uri-defs2.json"
      }
    }
  },
  "b": {
    "const": {
      "foo": {
        "bar": 1
      },
      "bar": "a"
    }
  }
}
