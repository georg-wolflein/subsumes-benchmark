{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "const",
    "maximum",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/6/tests/0",
  "a": {
    "not": {
      "$ref": "https://example.com/ref-and-id1/base.json"
    },
    "$defs": {
      "https://example.com/ref-and-id1/base.json": {
        "$id": "https://example.com/ref-and-id1/base.json",
        "$comment": "$id must be evaluated before $ref to get the proper $ref destination",
        "$ref": "int.json",
        "$defs": {
          "bigint": {
            "$comment": "canonical uri: https://example.com/ref-and-id1/int.json",
            "$id": "int.json",
            "maximum": 10
          },
          "smallint": {
            "$comment": "canonical uri: https://example.com/ref-and-id1-int.json",
            "$id": "/ref-and-id1-int.json",
            "maximum": 2
          }
        }
      }
    }
  },
  "b": {
    "const": 5
  }
}
