{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "const",
    "else",
    "if",
    "maxLength",
    "not",
    "then"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/if-then-else.json#/tests/9/tests/1",
  "a": {
    "not": {
      "then": {
        "const": "yes"
      },
      "else": {
        "const": "other"
      },
      "if": {
        "maxLength": 4
      }
    }
  },
  "b": {
    "const": "other"
  }
}
