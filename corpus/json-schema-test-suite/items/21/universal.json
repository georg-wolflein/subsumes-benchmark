{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "anyOf",
    "items",
    "minimum",
    "not",
    "prefixItems"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/items.json#/tests/21",
  "a": true,
  "b": {
    "anyOf": [
      {
        "allOf": [
          {
            "prefixItems": [
              {
                "minimum": 3
              }
            ]
          }
        ],
        "items": {
          "minimum": 5
        }
      },
      {
        "not": {
          "allOf": [
            {
              "prefixItems": [
                {
                  "minimum": 3
                }
              ]
            }
          ],
          "items": {
            "minimum": 5
          }
        }
      }
    ]
  }
}
