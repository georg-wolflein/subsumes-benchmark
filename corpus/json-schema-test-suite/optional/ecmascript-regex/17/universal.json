    "additionalProperties",
    "anyOf",
    "not",
    "patternProperties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/optional/ecmascript-regex.json#/tests/17",
  "a": true,
  "b": {
    "anyOf": [
      {
