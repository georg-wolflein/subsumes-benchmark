{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "not",
    "pattern",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/optional/ecmascript-regex.json#/tests/4",
  "a": true,
  "b": {
    "anyOf": [
      {
        "type": "string",
        "pattern": "^\\d$"
      },
      {
        "not": {
          "type": "string",
          "pattern": "^\\d$"
        }
      }
    ]
  }
}
