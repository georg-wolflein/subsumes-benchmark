{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "anyOf",
    "const",
    "pattern",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/pattern.json#/tests/3",
  "a": {
    "type": "string",
    "pattern": "^\\p{Letter}+$"
  },
  "b": {
    "anyOf": [
      {
        "const": "\u03c0"
      },
      {
        "const": "\u03c0\u03bb"
      }
    ]
  }
}
