{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "not",
    "patternProperties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/patternProperties.json#/tests/2",
  "a": false,
  "b": {
    "allOf": [
      {
        "patternProperties": {
          "[0-9]{2,}": {
            "type": "boolean"
          },
          "X_": {
            "type": "string"
          }
        }
      },
      {
        "not": {
          "patternProperties": {
            "[0-9]{2,}": {
              "type": "boolean"
            },
            "X_": {
              "type": "string"
            }
          }
        }
      }
    ]
  }
}
