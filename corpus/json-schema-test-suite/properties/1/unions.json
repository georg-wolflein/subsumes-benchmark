{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "additionalProperties",
    "anyOf",
    "const",
    "maxItems",
    "minItems",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/properties.json#/tests/1",
  "a": {
    "properties": {
      "foo": {
        "type": "array",
        "maxItems": 3
      },
      "bar": {
        "type": "array"
      }
    },
    "patternProperties": {
      "f.o": {
        "minItems": 2
      }
    },
    "additionalProperties": {
      "type": "integer"
    }
  },
  "b": {
    "anyOf": [
      {
        "const": {
          "foo": [
            1,
            2
          ]
        }
      },
      {
        "const": {
          "fxo": [
            1,
            2
          ]
        }
      },
      {
        "const": {
          "bar": []
        }
      },
      {
        "const": {
          "quux": 3
        }
      }
    ]
  }
}
