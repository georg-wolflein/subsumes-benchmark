{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "maxItems",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/ref.json#/tests/5",
  "a": {
    "$defs": {
      "reffed": {
        "type": "array"
      }
    },
    "properties": {
      "foo": {
        "$ref": "#/$defs/reffed",
        "maxItems": 2
      }
    }
  },
  "b": {
    "$defs": {
      "reffed": {
        "type": "array"
      }
    },
    "properties": {
      "foo": {
        "$ref": "#/$defs/reffed",
        "maxItems": 2
      }
    }
  }
}
