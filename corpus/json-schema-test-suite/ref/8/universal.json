{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "enum",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/ref.json#/tests/8",
  "a": true,
  "b": {
    "anyOf": [
      {
        "$defs": {
          "a_string": {
            "type": "string"
          }
        },
        "enum": [
          {
            "$ref": "#/$defs/a_string"
          }
        ]
      },
      {
        "not": {
          "$defs": {
            "a_string": {
              "type": "string"
            }
          },
          "enum": [
            {
              "$ref": "#/$defs/a_string"
            }
          ]
        }
      }
    ]
  }
}
