{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "anyOf",
    "const",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/type.json#/tests/11",
  "a": {
    "type": [
      "array",
      "object"
    ]
  },
  "b": {
    "anyOf": [
      {
        "const": [
          1,
          2,
          3
        ]
      },
      {
        "const": {
          "foo": 123
        }
      }
    ]
  }
}
