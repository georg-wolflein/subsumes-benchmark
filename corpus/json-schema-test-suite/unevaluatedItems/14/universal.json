{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "anyOf",
    "items",
    "not",
    "prefixItems",
    "type",
    "unevaluatedItems"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedItems.json#/tests/14",
  "a": true,
  "b": {
    "anyOf": [
      {
        "allOf": [
          {
            "prefixItems": [
              {
                "type": "string"
              }
            ],
            "items": true
          }
        ],
        "unevaluatedItems": false
      },
      {
        "not": {
          "allOf": [
            {
              "prefixItems": [
                {
                  "type": "string"
                }
              ],
              "items": true
            }
          ],
          "unevaluatedItems": false
        }
      }
    ]
  }
}
