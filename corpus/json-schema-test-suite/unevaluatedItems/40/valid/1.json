{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "const",
    "contains",
    "if",
    "then",
    "unevaluatedItems"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedItems.json#/tests/40/tests/1",
  "a": {
    "if": {
      "contains": {
        "const": "a"
      }
    },
    "then": {
      "if": {
        "contains": {
          "const": "b"
        }
      },
      "then": {
        "if": {
          "contains": {
            "const": "c"
          }
        }
      }
    },
    "unevaluatedItems": false
  },
  "b": {
    "const": [
      "a",
      "a"
    ]
  }
}
