{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "anyOf",
    "const",
    "properties",
    "required",
    "type",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/11",
  "derived": {
    "b_subsumes_a": {
      "counterexample": {
        "baz": "baz"
      }
    }
  },
  "a": {
    "type": "object",
    "properties": {
      "foo": {
        "type": "string"
      }
    },
    "anyOf": [
      {
        "properties": {
          "bar": {
            "const": "bar"
          }
        },
        "required": [
          "bar"
        ]
      },
      {
        "properties": {
          "baz": {
            "const": "baz"
          }
        },
        "required": [
          "baz"
        ]
      },
      {
        "properties": {
          "quux": {
            "const": "quux"
          }
        },
        "required": [
          "quux"
        ]
      }
    ],
    "unevaluatedProperties": false
  },
  "b": {
    "anyOf": [
      {
        "const": {
          "foo": "foo",
          "bar": "bar"
        }
      },
      {
        "const": {
          "foo": "foo",
          "bar": "bar",
          "baz": "baz"
        }
      }
    ]
  }
}
