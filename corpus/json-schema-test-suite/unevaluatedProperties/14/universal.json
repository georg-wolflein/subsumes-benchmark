{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "const",
    "else",
    "if",
    "not",
    "properties",
    "required",
    "then",
    "type",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/14",
  "a": true,
  "b": {
    "anyOf": [
      {
        "type": "object",
        "if": {
          "properties": {
            "foo": {
              "const": "then"
            }
          },
          "required": [
            "foo"
          ]
        },
        "then": {
          "properties": {
            "bar": {
              "type": "string"
            }
          },
          "required": [
            "bar"
          ]
        },
        "else": {
          "properties": {
            "baz": {
              "type": "string"
            }
          },
          "required": [
            "baz"
          ]
        },
        "unevaluatedProperties": false
      },
      {
        "not": {
          "type": "object",
          "if": {
            "properties": {
              "foo": {
                "const": "then"
              }
            },
            "required": [
              "foo"
            ]
          },
          "then": {
            "properties": {
              "bar": {
                "type": "string"
              }
            },
            "required": [
              "bar"
            ]
          },
          "else": {
            "properties": {
              "baz": {
                "type": "string"
              }
            },
            "required": [
              "baz"
            ]
          },
          "unevaluatedProperties": false
        }
      }
    ]
  }
}
