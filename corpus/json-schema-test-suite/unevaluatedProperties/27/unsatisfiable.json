{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "not",
    "properties",
    "type",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/27",
  "a": false,
  "b": {
    "allOf": [
      {
        "type": "object",
        "allOf": [
          {
            "properties": {
              "foo": {
                "type": "string"
              }
            },
            "unevaluatedProperties": true
          }
        ],
        "unevaluatedProperties": false
      },
      {
        "not": {
          "type": "object",
          "allOf": [
            {
              "properties": {
                "foo": {
                  "type": "string"
                }
              },
              "unevaluatedProperties": true
            }
          ],
          "unevaluatedProperties": false
        }
      }
    ]
  }
}
