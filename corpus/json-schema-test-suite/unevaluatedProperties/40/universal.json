{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "maxLength",
    "not",
    "propertyNames",
    "type",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/40",
  "a": true,
  "b": {
    "anyOf": [
      {
        "propertyNames": {
          "maxLength": 1
        },
        "unevaluatedProperties": {
          "type": "number"
        }
      },
      {
        "not": {
          "propertyNames": {
            "maxLength": 1
          },
          "unevaluatedProperties": {
            "type": "number"
          }
        }
      }
    ]
  }
}
