{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "const",
    "not",
    "patternProperties",
    "properties",
    "type",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/44/tests/1",
  "a": {
    "not": {
      "properties": {
        "foo": {
          "patternProperties": {
            "^bar$": {
              "type": "string"
            }
          }
        }
      },
      "unevaluatedProperties": false
    }
  },
  "b": {
    "const": {
      "foo": {
        "bar": "foo"
      },
      "bar": "bar"
    }
  }
}
