{
  "$schema": "../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "additionalProperties",
    "anyOf",
    "not",
    "properties",
    "type",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/45",
  "a": true,
  "b": {
    "anyOf": [
      {
        "properties": {
          "foo": {
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "unevaluatedProperties": false
      },
      {
        "not": {
          "properties": {
            "foo": {
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "unevaluatedProperties": false
        }
      }
    ]
  }
}
