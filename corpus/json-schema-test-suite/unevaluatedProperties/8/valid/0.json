{
  "$schema": "../../../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "allOf",
    "const",
    "patternProperties",
    "properties",
    "type",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/8/tests/0",
  "a": {
    "type": "object",
    "properties": {
      "foo": {
        "type": "string"
      }
    },
    "allOf": [
      {
        "patternProperties": {
          "^bar": {
            "type": "string"
          }
        }
      }
    ],
    "unevaluatedProperties": false
  },
  "b": {
    "const": {
      "foo": "foo",
      "bar": "bar"
    }
  }
}
