{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "additionalProperties",
    "allOf",
    "properties"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/additionalProperties_allows_only_intersecting_properties.merge_not_orig.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "properties": {
          "foo": true
        },
        "additionalProperties": true
      },
      {
        "properties": {
          "bar": true
        },
        "additionalProperties": false
      }
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "bar": true
    },
    "additionalProperties": false
  }
}
