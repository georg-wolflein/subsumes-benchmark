{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "additionalProperties",
    "allOf",
    "patternProperties",
    "properties"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/additionalProperties_disallows_all_except_matching_patternProperties_if_both_false.orig_not_merge.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "foo123": true
    },
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "properties": {
          "foo": true,
          "foo123": true
        },
        "additionalProperties": false
      },
      {
        "properties": {
          "bar": true
        },
        "patternProperties": {
          ".+\\d+$": true
        },
        "additionalProperties": false
      }
    ]
  }
}
