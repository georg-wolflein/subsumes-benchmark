{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "allOf",
    "items",
    "pattern",
    "prefixItems",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/items_merges_additionalItems.merge_not_orig.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/items_merges_additionalItems.orig_not_merge.json"
  ],
  "note": "Upstream's label holds only if . matches a line terminator. In ECMA-262 . matches none, so [{}, {\"name\": \"foo\\nbar\"}] is valid under b and not under a.",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
      "type": "object"
    },
    "allOf": [
      {
        "prefixItems": [
          true
        ],
        "items": {
          "properties": {
            "name": {
              "type": "string",
              "pattern": "bar"
            }
          }
        }
      },
      {
        "prefixItems": [
          true
        ],
        "items": {
          "properties": {
            "name": {
              "type": "string",
              "pattern": "foo"
            }
          }
        }
      }
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "prefixItems": [
      {
        "type": "object"
      }
    ],
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "(foo.*bar)|(bar.*foo)"
        }
      }
    }
  }
}
