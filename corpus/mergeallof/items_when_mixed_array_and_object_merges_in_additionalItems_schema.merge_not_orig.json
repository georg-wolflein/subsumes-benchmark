{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": null,
  "features": [
    "allOf",
    "items",
    "maximum",
    "minimum",
    "prefixItems",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/items_when_mixed_array_and_object_merges_in_additionalItems_schema.merge_not_orig.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "items": {
          "type": "integer",
          "minimum": 5,
          "maximum": 30,
          "allOf": [
            {
              "minimum": 9
            }
          ]
        }
      },
      {
        "prefixItems": [
          {
            "type": "integer",
            "allOf": [
              {
                "minimum": 7,
                "maximum": 20
              }
            ]
          }
        ],
        "items": {
          "type": "integer",
          "minimum": 10
        }
      }
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "prefixItems": [
      {
        "type": "integer",
        "minimum": 9,
        "maximum": 20
      }
    ],
    "items": {
      "type": "integer",
      "minimum": 10,
      "maximum": 30
    }
  }
}
