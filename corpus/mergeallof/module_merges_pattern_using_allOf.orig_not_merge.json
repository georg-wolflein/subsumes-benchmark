{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "allOf",
    "pattern"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/module_merges_pattern_using_allOf.orig_not_merge.json",
  "note": "Upstream's label holds only if . matches a line terminator. In ECMA-262 . matches none, so \"fdsaf\\nabba\" is valid under b and not under a.",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "pattern": "(fdsaf.*abba)|(abba.*fdsaf)"
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {},
      {
        "pattern": "fdsaf"
      },
      {
        "pattern": "abba"
      }
    ]
  }
}
