{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "maxLength",
    "minLength",
    "pattern",
    "propertyNames",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/module_propertyNames_merges_similar_schemas.merge_not_orig.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/allOf_containment/unsat/module_propertyNames_merges_similar_schemas.orig_not_merge.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "propertyNames": {
      "type": "string",
      "allOf": [
        {
          "minLength": 5
        }
      ]
    },
    "allOf": [
      {
        "propertyNames": {
          "type": "string",
          "pattern": "abc.*",
          "allOf": [
            {
              "maxLength": 7
            }
          ]
        }
      }
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "propertyNames": {
      "type": "string",
      "pattern": "abc.*",
      "minLength": 5,
      "maxLength": 7
    }
  }
}
