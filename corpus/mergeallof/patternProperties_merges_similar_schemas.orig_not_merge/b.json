{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "patternProperties": {
    "^\\$.+": {
      "type": [
        "string",
        "null",
        "integer"
      ],
      "allOf": [
        {
          "minimum": 5
        }
      ]
    }
  },
  "allOf": [
    {
      "patternProperties": {
        "^\\$.+": {
          "type": [
            "string",
            "null"
          ],
          "allOf": [
            {
              "minimum": 7
            }
          ]
        },
        ".*": {
          "type": "null"
        }
      }
    }
  ]
}
