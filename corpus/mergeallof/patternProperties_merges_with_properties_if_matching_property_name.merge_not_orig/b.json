{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "foo_long": {
      "type": "string",
      "minLength": 9
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "patternProperties": {
    "_long$": {
      "type": "string",
      "minLength": 7
    },
    "^name.*": {
      "type": "string",
      "minLength": 8
    }
  }
}
