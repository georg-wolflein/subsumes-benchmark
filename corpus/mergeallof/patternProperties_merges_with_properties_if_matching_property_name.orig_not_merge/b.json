{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "patternProperties": {
        "_long$": {
          "type": "string",
          "minLength": 7
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "foo_long": {
          "type": "string",
          "minLength": 9
        }
      },
      "patternProperties": {
        "^name.*": {
          "type": "string",
          "minLength": 8
        }
      }
    }
  ]
}
