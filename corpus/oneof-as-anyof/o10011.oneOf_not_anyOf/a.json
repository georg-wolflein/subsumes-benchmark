{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Client creation request",
  "properties": {
    "grantType": {
      "type": "string"
    },
    "redirectUris": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "responseType": {
      "type": "string"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "title": "OAuthClientRequest",
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "grantType": {
          "enum": [
            "authorization_code"
          ]
        },
        "responseType": {
          "default": "code",
          "enum": [
            "code"
          ]
        }
      },
      "required": [
        "grantType"
      ]
    },
    {
      "properties": {
        "grantType": {
          "enum": [
            "client_credentials"
          ]
        },
        "responseType": {
          "default": "token",
          "enum": [
            "token"
          ]
        }
      },
      "required": [
        "grantType"
      ]
    }
  ]
}
