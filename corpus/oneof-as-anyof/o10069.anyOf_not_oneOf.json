{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "additionalProperties",
    "anyOf",
    "minLength",
    "oneOf",
    "pattern",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o10069.anyOf_not_oneOf.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DatabaseCollection",
    "description": "A collection from a certain namespace",
    "oneOf": [
      {
        "type": "object",
        "description": "A collection from the given namespace",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\.]+$",
            "minLength": 2
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\.]+$"
          }
        },
        "required": [
          "name",
          "namespace"
        ],
        "additionalProperties": false
      },
      {
        "type": "string",
        "description": "A collection from the default namespace",
        "pattern": "^[a-zA-Z0-9_\\.~]+$"
      }
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "DatabaseCollection",
    "description": "A collection from a certain namespace",
    "anyOf": [
      {
        "type": "object",
        "description": "A collection from the given namespace",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\.]+$",
            "minLength": 2
          },
          "namespace": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\.]+$"
          }
        },
        "required": [
          "name",
          "namespace"
        ],
        "additionalProperties": false
      },
      {
        "type": "string",
        "description": "A collection from the default namespace",
        "pattern": "^[a-zA-Z0-9_\\.~]+$"
      }
    ]
  }
}
