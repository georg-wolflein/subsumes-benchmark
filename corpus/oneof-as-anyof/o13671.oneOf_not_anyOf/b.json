{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "self": {
      "type": "boolean"
    },
    "graduation_year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "majors": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "self",
    "graduation_year",
    "majors"
  ]
}
