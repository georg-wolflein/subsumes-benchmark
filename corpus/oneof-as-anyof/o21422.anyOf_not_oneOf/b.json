{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access_limited": {
      "$ref": "#/$defs/access_limited"
    },
    "analytics_identifier": {
      "$ref": "#/$defs/analytics_identifier"
    },
    "auth_bypass_ids": {
      "$ref": "#/$defs/guid_list",
      "description": "A list of ids that will allow access to this item for non-authenticated users"
    },
    "base_path": {
      "$ref": "#/$defs/absolute_path"
    },
    "bulk_publishing": {
      "type": "boolean"
    },
    "change_note": {
      "type": [
        "null",
        "string"
      ]
    },
    "description": {
      "$ref": "#/$defs/description_optional"
    },
    "details": {
      "$ref": "#/$defs/details"
    },
    "document_type": {
      "enum": [
        "travel_advice_index"
      ],
      "type": "string"
    },
    "first_published_at": {
      "$ref": "#/$defs/first_published_at"
    },
    "last_edited_at": {
      "_format": "date-time",
      "description": "Last time when the content received a major or minor update.",
      "type": "string"
    },
    "links": {
      "additionalProperties": false,
      "properties": {
        "policy_areas": {
          "$ref": "#/$defs/guid_list",
          "description": "A largely deprecated tag currently only used to power email alerts."
        }
      },
      "type": "object"
    },
    "locale": {
      "$ref": "#/$defs/locale"
    },
    "need_ids": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "phase": {
      "description": "The service design phase of this content item - https://www.gov.uk/service-manual/phases",
      "enum": [
        "alpha",
        "beta",
        "live"
      ],
      "type": "string"
    },
    "previous_version": {
      "type": "string"
    },
    "public_updated_at": {
      "$ref": "#/$defs/public_updated_at"
    },
    "publishing_app": {
      "$ref": "#/$defs/publishing_app_name"
    },
    "redirects": {
      "items": {},
      "type": "array"
    },
    "rendering_app": {
      "$ref": "#/$defs/rendering_app"
    },
    "routes": {
      "$ref": "#/$defs/routes"
    },
    "schema_name": {
      "enum": [
        "travel_advice_index"
      ],
      "type": "string"
    },
    "title": {
      "$ref": "#/$defs/title"
    },
    "update_type": {
      "$ref": "#/$defs/update_type"
    }
  },
  "required": [
    "base_path",
    "details",
    "document_type",
    "publishing_app",
    "rendering_app",
    "routes",
    "schema_name",
    "title"
  ],
  "type": "object",
  "$defs": {
    "absolute_path": {
      "description": "A path only. Query string and/or fragment are not allowed.",
      "pattern": "^/(([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})+(/([a-zA-Z0-9._~!$&'()*+,;=:@-]|%[0-9a-fA-F]{2})*)*)?$",
      "type": "string"
    },
    "access_limited": {
      "additionalProperties": false,
      "properties": {
        "auth_bypass_ids": {
          "$ref": "#/$defs/guid_list",
          "description": "Deprecated: auth_bypass_ids should be sent as a separate field"
        },
        "organisations": {
          "$ref": "#/$defs/guid_list",
          "description": "A list of organisation content ids permitted access to this item"
        },
        "users": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "analytics_identifier": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "A short identifier we send to Google Analytics for multi-valued fields. This means we avoid the truncated values we would get if we sent the path or slug of eg organisations."
    },
    "description": {
      "type": "string"
    },
    "description_optional": {
      "anyOf": [
        {
          "$ref": "#/$defs/description"
        },
        {
          "type": "null"
        }
      ]
    },
    "details": {
      "additionalProperties": false,
      "properties": {
        "email_signup_link": {
          "$ref": "#/$defs/email_signup_link"
        },
        "max_cache_time": {
          "$ref": "#/$defs/max_cache_time"
        },
        "publishing_request_id": {
          "$ref": "#/$defs/publishing_request_id"
        }
      },
      "required": [
        "email_signup_link"
      ],
      "type": "object"
    },
    "email_signup_link": {
      "_format": "uri",
      "description": "Path to email signup form. TODO: Check if can be switched to use links instead",
      "type": "string"
    },
    "first_published_at": {
      "_format": "date-time",
      "description": "The date the content was first published.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "guid": {
      "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[1-5][a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$",
      "type": "string"
    },
    "guid_list": {
      "items": {
        "$ref": "#/$defs/guid"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "locale": {
      "enum": [
        "ar",
        "az",
        "be",
        "bg",
        "bn",
        "cs",
        "cy",
        "da",
        "de",
        "dr",
        "el",
        "en",
        "es",
        "es-419",
        "et",
        "fa",
        "fi",
        "fr",
        "gd",
        "he",
        "hi",
        "hr",
        "hu",
        "hy",
        "id",
        "is",
        "it",
        "ja",
        "ka",
        "kk",
        "ko",
        "lt",
        "lv",
        "ms",
        "mt",
        "nl",
        "no",
        "pl",
        "ps",
        "pt",
        "ro",
        "ru",
        "si",
        "sk",
        "sl",
        "so",
        "sq",
        "sr",
        "sv",
        "sw",
        "ta",
        "th",
        "tk",
        "tr",
        "uk",
        "ur",
        "uz",
        "vi",
        "zh",
        "zh-hk",
        "zh-tw"
      ],
      "type": "string"
    },
    "max_cache_time": {
      "description": "The maximum length of time the content should be cached, in seconds",
      "type": "integer"
    },
    "public_updated_at": {
      "_format": "date-time",
      "description": "When the content was last significantly changed (a major update). Shown to users.  Automatically determined by the publishing-api, unless overridden by the publishing application.",
      "type": "string"
    },
    "publishing_app_name": {
      "description": "The application that published this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections-publisher",
        "contacts",
        "content-publisher",
        "content-tagger",
        "email-alert-frontend",
        "external-link-tracker",
        "feedback",
        "frontend",
        "government-frontend",
        "hmrc-manuals-api",
        "info-frontend",
        "licencefinder",
        "local-links-manager",
        "manuals-frontend",
        "manuals-publisher",
        "maslow",
        "performanceplatform-big-screen-view",
        "publisher",
        "rummager",
        "search-admin",
        "search-api",
        "service-manual-publisher",
        "share-sale-publisher",
        "short-url-manager",
        "smartanswers",
        "special-route-publisher",
        "specialist-publisher",
        "static",
        "tariff",
        "travel-advice-publisher",
        "whitehall"
      ],
      "type": "string"
    },
    "publishing_request_id": {
      "description": "A unique identifier used to track publishing requests to rendered content",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "rendering_app": {
      "description": "The application that renders this item.",
      "enum": [
        "calculators",
        "calendars",
        "collections",
        "content-store",
        "email-alert-frontend",
        "email-campaign-frontend",
        "feedback",
        "finder-frontend",
        "frontend",
        "government-frontend",
        "info-frontend",
        "licencefinder",
        "manuals-frontend",
        "performanceplatform-big-screen-view",
        "rummager",
        "search-api",
        "service-manual-frontend",
        "smartanswers",
        "spotlight",
        "static",
        "tariff",
        "whitehall-admin",
        "whitehall-frontend"
      ],
      "type": "string"
    },
    "route": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "type": {
          "enum": [
            "prefix",
            "exact"
          ]
        }
      },
      "required": [
        "path",
        "type"
      ],
      "type": "object"
    },
    "routes": {
      "items": {
        "$ref": "#/$defs/route"
      },
      "minItems": 1,
      "type": "array"
    },
    "title": {
      "type": "string"
    },
    "update_type": {
      "enum": [
        "major",
        "minor",
        "republish"
      ]
    }
  }
}
