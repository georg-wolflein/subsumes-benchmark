{
  "$id": "http://blog.axross.org/schemas/User.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "bio": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "email": {
      "_format": "email",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "imageUrl": {
      "anyOf": [
        {
          "_format": "uri",
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "name": {
      "maxLength": 64,
      "type": "string"
    },
    "username": {
      "maxLength": 128,
      "type": "string"
    }
  },
  "required": [
    "id",
    "username",
    "email",
    "name",
    "imageUrl",
    "bio"
  ],
  "title": "User",
  "type": "object"
}
