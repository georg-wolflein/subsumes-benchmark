{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "anyOf",
    "enum",
    "items",
    "minItems",
    "oneOf",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o25419.anyOf_not_oneOf.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "A JSON RPC 2.0 request",
    "oneOf": [
      {
        "description": "An individual request",
        "$ref": "#/$defs/request"
      },
      {
        "description": "An array of requests",
        "type": "array",
        "items": {
          "$ref": "#/$defs/request"
        },
        "minItems": 1
      }
    ],
    "$defs": {
      "request": {
        "type": "object",
        "required": [
          "jsonrpc",
          "method"
        ],
        "properties": {
          "jsonrpc": {
            "enum": [
              "2.0"
            ]
          },
          "method": {
            "type": "string"
          },
          "id": {
            "type": [
              "string",
              "number",
              "null"
            ],
            "note": [
              "While allowed, null should be avoided: http://www.jsonrpc.org/specification#id1",
              "While allowed, a number with a fractional part should be avoided: http://www.jsonrpc.org/specification#id2"
            ]
          },
          "params": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
