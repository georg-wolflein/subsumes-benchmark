{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "created": {
      "_$id": "/properties/created",
      "description": "creation date",
      "readOnly": true,
      "title": "Created",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "_format": "date-time",
          "type": "string"
        }
      ]
    },
    "description": {
      "_$id": "/properties/description",
      "description": "role description",
      "title": "Description",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "contentMediaType": "text/html",
          "type": "string"
        }
      ]
    },
    "modified": {
      "_$id": "/properties/modified",
      "description": "last modification date",
      "readOnly": true,
      "title": "Modified",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "_format": "date-time",
          "type": "string"
        }
      ]
    },
    "name": {
      "_$id": "/properties/name",
      "description": "role unique name",
      "maxLength": 32,
      "title": "Name",
      "type": "string"
    },
    "unchangeable": {
      "_$id": "/properties/unchangeable",
      "default": false,
      "description": "role data not modifiable (default:false)",
      "readOnly": true,
      "title": "Unchangeable",
      "type": "boolean"
    }
  },
  "required": [
    "name"
  ],
  "type": "object"
}
