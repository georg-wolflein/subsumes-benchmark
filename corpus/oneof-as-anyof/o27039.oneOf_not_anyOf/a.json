{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "schema for an Service Case question list",
  "items": {
    "$ref": "#/$defs/ServiceField"
  },
  "minItems": 1,
  "_uniqueItems": true,
  "type": "array",
  "$defs": {
    "ServiceField": {
      "type": "object",
      "anyOf": [
        {
          "$ref": "#/$defs/ServiceNote"
        },
        {
          "$ref": "#/$defs/ServiceQuestion"
        }
      ]
    },
    "ServiceFieldList": {
      "items": {
        "$ref": "#/$defs/ServiceField"
      },
      "minItems": 1,
      "_uniqueItems": true,
      "type": "array"
    },
    "ServiceNote": {
      "additionalProperties": false,
      "properties": {
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "hasAllowableModules": {
          "$ref": "#/$defs/hasAllowableModules"
        },
        "hasBusinessCodes": {
          "$ref": "#/$defs/hasBusinessCodes"
        },
        "hasDataType": {
          "$ref": "#/$defs/hasDataType"
        },
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "hasOrderBy": {
          "$ref": "#/$defs/hasOrderBy"
        },
        "hasChoiceValueList": {
          "$ref": "#/$defs/hasChoiceValueList"
        },
        "hasDataSource": {
          "$ref": "#/$defs/hasDataSource"
        },
        "isDisabled": {
          "$ref": "#/$defs/isDisabled"
        },
        "type": {
          "enum": [
            "ServiceNote"
          ]
        }
      },
      "required": [
        "iri",
        "label",
        "hasDataType",
        "hasOrderBy",
        "type"
      ],
      "type": "object"
    },
    "ServiceQuestion": {
      "additionalProperties": false,
      "properties": {
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "hasAllowableModules": {
          "$ref": "#/$defs/hasAllowableModules"
        },
        "hasBusinessCodes": {
          "$ref": "#/$defs/hasBusinessCodes"
        },
        "hasDataType": {
          "$ref": "#/$defs/hasDataType"
        },
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "hasOrderBy": {
          "$ref": "#/$defs/hasOrderBy"
        },
        "hasChoiceValueList": {
          "$ref": "#/$defs/hasChoiceValueList"
        },
        "hasServiceFieldAlert": {
          "$ref": "#/$defs/hasServiceFieldAlert"
        },
        "isDisabled": {
          "$ref": "#/$defs/isDisabled"
        },
        "hasDefaultIntakeMethod": {
          "$ref": "#/$defs/hasDefaultIntakeMethod"
        },
        "hasStandardizeStreetFormat": {
          "$ref": "#/$defs/hasStandardizeStreetFormat"
        },
        "hasLegacyEvent": {
          "$ref": "#/$defs/hasLegacyEvent"
        },
        "hasActivityAssignment": {
          "$ref": "#/$defs/hasActivityAssignment"
        },
        "type": {
          "enum": [
            "ServiceQuestion"
          ]
        }
      },
      "required": [
        "iri",
        "label",
        "hasDataType",
        "hasOrderBy",
        "type"
      ],
      "type": "object"
    },
    "hasStandardizeStreetFormat": {
      "enum": [
        "true",
        "false"
      ]
    },
    "isDisabled": {
      "enum": [
        "true",
        "false"
      ]
    },
    "booleanValue": {
      "enum": [
        "true",
        "false"
      ]
    },
    "hasBusinessCodes": {
      "pattern": "^,?(((NOUPDATE|REQINTAK|FQ_ALERT|SUCCESSR|WEBQREQD|5DAYWORK|INSSPEC|DUPSTAFF|REQRESAC|REQMASS),?)*)+$",
      "type": "string"
    },
    "hasOrderBy": {
      "pattern": "^[-+]?[0-9]*.?[0-9]+$",
      "type": "string"
    },
    "floatNumber": {
      "pattern": "^[-+]?[0-9]*.?[0-9]+$",
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "hasAllowableModules": {
      "pattern": "^,?(((SREINTAK|SRERESAC|SREMASS|SRSNGLWO|SRSUMMRY|WEBINTAK|SRSUMMRY|MD-WCS|MD-WCSL),?)*)+$",
      "type": "string"
    },
    "iri": {
      "type": "string"
    },
    "hasLegacyCode": {
      "type": "string"
    },
    "hasServiceFieldAlert": {
      "anyOf": [
        {
          "$ref": "#/$defs/hasServiceFieldAlertList"
        },
        {
          "$ref": "#/$defs/ServiceFieldAlert"
        }
      ]
    },
    "hasServiceFieldAlertList": {
      "items": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/$defs/ServiceFieldAlert"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "ServiceFieldAlert": {
      "properties": {
        "hasLegacyEvent": {
          "$ref": "#/$defs/hasLegacyEvent"
        },
        "hasAnswerObject": {
          "$ref": "#/$defs/hasAnswerObject"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "QuestionTrigger"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        }
      },
      "required": [
        "iri",
        "label",
        "hasLegacyEvent",
        "type"
      ],
      "type": "object"
    },
    "hasDataType": {
      "enum": [
        "TIME",
        "CHAR",
        "DATE",
        "NUMBER",
        "CHARLIST",
        "CHARMULT",
        "CHAROPT",
        "PHONENUM"
      ]
    },
    "hasChoiceValueList": {
      "type": "object",
      "properties": {
        "hasChoiceValue": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChoiceValue"
            },
            {
              "$ref": "#/$defs/ListOfChoiceValues"
            }
          ]
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "type": {
          "enum": [
            "ChoiceValueList"
          ]
        }
      },
      "required": [
        "iri",
        "label",
        "hasChoiceValue",
        "type"
      ]
    },
    "hasChoiceValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChoiceValue"
        },
        {
          "$ref": "#/$defs/ListOfChoiceValues"
        }
      ]
    },
    "ListOfChoiceValues": {
      "items": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/$defs/ChoiceValue"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "ChoiceValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "hasOrderBy": {
          "$ref": "#/$defs/hasOrderBy"
        },
        "isDisabled": {
          "$ref": "#/$defs/isDisabled"
        },
        "hasLegacyEvent": {
          "$ref": "#/$defs/hasLegacyEvent"
        },
        "type": {
          "enum": [
            "ChoiceValue"
          ]
        }
      },
      "required": [
        "iri",
        "label",
        "type"
      ]
    },
    "ynQuestion": {
      "enum": [
        "Y",
        "N"
      ]
    },
    "hasDefaultIntakeMethod": {
      "type": "object",
      "properties": {
        "hasOrderBy": {
          "$ref": "#/$defs/hasOrderBy"
        },
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "isAlwaysPublic": {
          "$ref": "#/$defs/ynQuestion"
        },
        "type": {
          "enum": [
            "IntakeMethod"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        }
      },
      "required": [
        "iri",
        "label",
        "hasLegacyCode",
        "type"
      ]
    },
    "hasLegacyInterface": {
      "items": {
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "hasLegacyEvent": {
      "anyOf": [
        {
          "$ref": "#/$defs/LegacyEventObject"
        },
        {
          "$ref": "#/$defs/ListOfLegacyEventObject"
        }
      ]
    },
    "ListOfLegacyEventObject": {
      "items": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/$defs/LegacyEventObject"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "LegacyEventObject": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "ServiceFieldAlert",
            "ClearServiceField",
            "MarkServiceFieldRequired",
            "MarkServiceFieldDisabled",
            "ActivityAssignment",
            "StatusChange"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "hasServiceField": {
          "$ref": "#/$defs/ServiceFieldList"
        },
        "hasActivity": {
          "$ref": "#/$defs/Activity"
        },
        "hasStatus": {
          "$ref": "#/$defs/hasStatus"
        }
      }
    },
    "hasStatus": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "Status"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "hasOrderBy": {
          "$ref": "#/$defs/hasOrderBy"
        },
        "hasAllowableStatuses": {
          "$ref": "#/$defs/hasAllowableStatuses"
        },
        "isAlwaysPublic": {
          "$ref": "#/$defs/ynQuestion"
        }
      }
    },
    "hasAllowableStatuses": {
      "pattern": "^,?(((C-CLOSED|O-OPEN|O-PENDING),?)*)+$",
      "type": "string"
    },
    "Activity": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "Activity"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "hasOrderBy": {
          "$ref": "#/$defs/hasOrderBy"
        },
        "hasBusinessCodes": {
          "$ref": "#/$defs/hasBusinessCodes"
        },
        "hasOccurDays": {
          "$ref": "#/$defs/floatNumber"
        },
        "hasSuspenseDays": {
          "$ref": "#/$defs/floatNumber"
        },
        "isAutoCreate": {
          "$ref": "#/$defs/ynQuestion"
        },
        "isAutoAssign": {
          "$ref": "#/$defs/booleanValue"
        },
        "hasAllowableOutcome": {
          "$ref": "#/$defs/Outcome"
        },
        "hasDefaultOutcome": {
          "$ref": "#/$defs/Outcome"
        },
        "hasAssignmentRule": {
          "$ref": "#/$defs/hasAssignmentRule"
        },
        "hasActivityAssignment": {
          "$ref": "#/$defs/hasActivityAssignment"
        }
      }
    },
    "hasAssignmentRule": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "AssignActivityToUserRule",
            "CaseActivityAssignmentRule"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "hasUsername": {
          "$ref": "#/$defs/username"
        }
      }
    },
    "Outcome": {
      "anyOf": [
        {
          "$ref": "#/$defs/OutcomeObject"
        },
        {
          "$ref": "#/$defs/ListOfOutcomeObject"
        }
      ]
    },
    "ListOfOutcomeObject": {
      "items": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/$defs/OutcomeObject"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "OutcomeObject": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "hasLegacyEvent": {
          "$ref": "#/$defs/hasLegacyEvent"
        },
        "type": {
          "enum": [
            "Outcome"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        }
      }
    },
    "hasActivityAssignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/ActivityAssignmentObject"
        },
        {
          "$ref": "#/$defs/ListOfActivityAssignmentObject"
        }
      ]
    },
    "ListOfActivityAssignmentObject": {
      "items": {
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/$defs/ActivityAssignmentObject"
          }
        ]
      },
      "minItems": 1,
      "type": "array"
    },
    "ActivityAssignmentObject": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "hasActivity": {
          "$ref": "#/$defs/Activity"
        },
        "hasOutcome": {
          "$ref": "#/$defs/Outcome"
        },
        "hasLegacyEvent": {
          "$ref": "#/$defs/hasLegacyEvent"
        },
        "hasAnswerObject": {
          "$ref": "#/$defs/hasAnswerObject"
        },
        "type": {
          "enum": [
            "Activity Trigger",
            "QuestionTrigger"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        }
      }
    },
    "username": {
      "type": "string"
    },
    "hasAnswerObject": {
      "type": "object",
      "properties": {
        "hasLegacyCode": {
          "$ref": "#/$defs/hasLegacyCode"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "ChoiceValue"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "hasLegacyEvent": {
          "$ref": "#/$defs/hasLegacyEvent"
        }
      },
      "required": [
        "iri",
        "label",
        "hasLegacyCode",
        "type"
      ]
    },
    "hasDataSource": {
      "type": "object",
      "properties": {
        "providedBy": {
          "$ref": "#/$defs/providedBy"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "EventBasedDataSource"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        },
        "hasPropertyName": {
          "$ref": "#/$defs/label"
        }
      },
      "required": [
        "iri",
        "label",
        "providedBy",
        "hasPropertyName",
        "type"
      ]
    },
    "providedBy": {
      "type": "object",
      "properties": {
        "label": {
          "$ref": "#/$defs/label"
        },
        "type": {
          "enum": [
            "ClientSideEventType"
          ]
        },
        "iri": {
          "$ref": "#/$defs/iri"
        }
      },
      "required": [
        "iri",
        "label",
        "type"
      ]
    }
  }
}
