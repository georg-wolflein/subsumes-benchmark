{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "default": {
      "allOf": [
        {
          "$ref": "#/$defs/command"
        },
        {
          "required": [
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "iterations": {
      "items": {
        "$ref": "#/$defs/command"
      },
      "type": "array"
    }
  },
  "required": [
    "iterations"
  ],
  "title": "Clack Schema",
  "type": "object",
  "$defs": {
    "command": {
      "additionalProperties": false,
      "properties": {
        "arguments": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "string"
            }
          ]
        },
        "command": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "options": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  }
}
