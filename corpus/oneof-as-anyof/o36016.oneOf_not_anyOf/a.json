{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "description": "DForms Form Schema",
  "required": [
    "sections"
  ],
  "properties": {
    "sections": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "$ref": "#/$defs/section"
        }
      },
      "additionalProperties": false
    },
    "expressions": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_]+$": {
          "$ref": "#/$defs/expressions"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "section": {
      "properties": {
        "label": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_]+$": {
              "$ref": "#/$defs/fields"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "fields": {
      "anyOf": [
        {
          "$ref": "#/$defs/textField"
        },
        {
          "$ref": "#/$defs/numericField"
        },
        {
          "$ref": "#/$defs/emailField"
        },
        {
          "$ref": "#/$defs/currencyField"
        },
        {
          "$ref": "#/$defs/staticField"
        },
        {
          "$ref": "#/$defs/enumField"
        },
        {
          "$ref": "#/$defs/multipleField"
        },
        {
          "$ref": "#/$defs/dateField"
        },
        {
          "$ref": "#/$defs/timeField"
        },
        {
          "$ref": "#/$defs/datetimeField"
        },
        {
          "$ref": "#/$defs/repeatingField"
        }
      ]
    },
    "expressionId": {
      "type": "string"
    },
    "textField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "text"
          ]
        },
        "suggestions": {
          "type": "array"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "emailField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "email"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "currencyField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "currency"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "staticField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "static"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "enumField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "enum"
          ]
        },
        "options": {
          "anyOf": [
            {
              "type": "array",
              "minItems": 1,
              "_uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            {
              "type": "object",
              "minProperties": 1
            }
          ]
        },
        "default": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "multipleField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "multiple"
          ]
        },
        "fields": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_]+$": {
              "$ref": "#/$defs/fields"
            }
          }
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "numericField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "number",
            "decimal"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "dateField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "date"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "timeField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "time"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "datetimeField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "datetime"
          ]
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "required": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        },
        "placeholder": {
          "type": "string"
        },
        "size": {
          "$ref": "#/$defs/fieldSize"
        },
        "visible": {
          "$ref": "#/$defs/expressionId"
        },
        "valid": {
          "$ref": "#/$defs/expressionId"
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "fieldSize": {
      "type": "number",
      "minimum": 1,
      "maximum": 12,
      "multipleOf": 1
    },
    "repeatingField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "repeating"
          ]
        },
        "fields": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_]+$": {
              "$ref": "#/$defs/fields"
            }
          }
        },
        "label": {
          "type": "string"
        },
        "help": {
          "type": "string"
        },
        "minRows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "maxRows": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        },
        "inline": {
          "type": "boolean"
        },
        "expressions": {
          "type": "object",
          "patternProperties": {
            "^[a-zA-Z0-9_]+$": {
              "$ref": "#/$defs/expressions"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "label"
      ],
      "additionalProperties": false
    },
    "conditionAnd": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/expressions"
      }
    },
    "conditionOr": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/expressions"
      }
    },
    "conditionGreaterThan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/expressions"
      }
    },
    "conditionGreaterThanOrEqualTo": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/expressions"
      }
    },
    "conditionLessThan": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/expressions"
      }
    },
    "conditionLessThanOrEqualTo": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/expressions"
      }
    },
    "conditionNot": {
      "$ref": "#/$defs/expressions"
    },
    "conditionEmpty": {
      "$ref": "#/$defs/expressions"
    },
    "conditionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        }
      ]
    },
    "conditionEquals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/expressions"
      }
    },
    "conditionField": {
      "type": "string"
    },
    "conditionExpression": {
      "type": "string"
    },
    "expressions": {
      "anyOf": [
        {
          "properties": {
            "and": {
              "$ref": "#/$defs/conditionAnd"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "or": {
              "$ref": "#/$defs/conditionOr"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "not": {
              "$ref": "#/$defs/conditionNot"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "field": {
              "$ref": "#/$defs/conditionField"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "equals": {
              "$ref": "#/$defs/conditionEquals"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "empty": {
              "$ref": "#/$defs/conditionEmpty"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "value": {
              "$ref": "#/$defs/conditionValue"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            ">": {
              "$ref": "#/$defs/conditionGreaterThan"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            ">=": {
              "$ref": "#/$defs/conditionGreaterThanOrEqualTo"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "<": {
              "$ref": "#/$defs/conditionLessThan"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "<=": {
              "$ref": "#/$defs/conditionLessThanOrEqualTo"
            }
          },
          "additionalProperties": false
        },
        {
          "properties": {
            "expression": {
              "$ref": "#/$defs/conditionExpression"
            }
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
