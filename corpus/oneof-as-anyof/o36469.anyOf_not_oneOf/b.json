{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single user details",
  "description": "All fields present in a single user data request.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "result",
    "jsonrpc",
    "id"
  ],
  "properties": {
    "jsonrpc": {
      "type": "string",
      "enum": [
        "2.0"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "memberType",
        "firstName",
        "middleName",
        "lastName",
        "address",
        "zipcode",
        "city",
        "birthDate",
        "phoneNumber",
        "mobileNumber",
        "email",
        "emailParents",
        "startDate",
        "endDate",
        "memberDay"
      ],
      "properties": {
        "id": {
          "type": "number"
        },
        "memberType": {
          "type": "array",
          "uniqueness": "true",
          "items": {
            "type": "string",
            "enum": [
              "lid",
              "begeleider",
              "bestuur",
              "sponsor",
              "ondersteuning",
              "aspirant_begeleider",
              "strippenkaart"
            ]
          }
        },
        "firstName": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "middleName": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "lastName": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "zipcode": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "city": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            }
          ]
        },
        "birthDate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        },
        "phoneNumber": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "^\\d+$"
            }
          ]
        },
        "mobileNumber": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "^\\d+$"
            }
          ]
        },
        "email": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "email"
            }
          ]
        },
        "emailParents": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "email"
            }
          ]
        },
        "startDate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        },
        "endDate": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "^\\d{4}-\\d{2}-\\d{2}$"
            }
          ]
        },
        "memberDay": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "enum": [
                "ma",
                "di",
                "wo",
                "do",
                "vr",
                "za",
                "zo"
              ]
            }
          ]
        }
      }
    },
    "id": {
      "type": "number"
    }
  }
}
