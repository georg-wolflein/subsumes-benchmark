{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Annotation Model",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "overrides": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/HttpEndpointOverride"
          },
          {
            "$ref": "#/$defs/HttpParameterOverride"
          }
        ]
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/DirectListInput"
          },
          {
            "$ref": "#/$defs/CsvInput"
          },
          {
            "$ref": "#/$defs/ExtractedInput"
          },
          {
            "$ref": "#/$defs/CounterInput"
          }
        ]
      }
    },
    "endpoint-annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/EndpointAnnotation"
      }
    }
  },
  "$defs": {
    "EndpointAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "overrides": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/HttpEndpointOverride"
              },
              {
                "$ref": "#/$defs/HttpParameterOverride"
              }
            ]
          }
        },
        "parameter-annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParameterAnnotation"
          }
        }
      },
      "required": [
        "endpoint"
      ]
    },
    "ParameterAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "parameter": {
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/DirectListInput"
            },
            {
              "$ref": "#/$defs/CsvInput"
            },
            {
              "$ref": "#/$defs/ExtractedInput"
            },
            {
              "$ref": "#/$defs/CounterInput"
            }
          ]
        },
        "overrides": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/HttpParameterOverride"
              }
            ]
          }
        }
      },
      "required": [
        "parameter",
        "input"
      ]
    },
    "DirectListInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@type": {
          "type": "string",
          "enum": [
            "direct"
          ],
          "default": "direct"
        },
        "id": {
          "type": "string"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "associated": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/DirectListInput"
              },
              {
                "$ref": "#/$defs/CsvInput"
              }
            ]
          }
        }
      },
      "required": [
        "@type",
        "data"
      ]
    },
    "CsvInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@type": {
          "type": "string",
          "enum": [
            "csv"
          ],
          "default": "csv"
        },
        "id": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "column": {
          "type": "integer"
        },
        "separator": {
          "type": "string",
          "default": ";"
        },
        "associated": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "$ref": "#/$defs/DirectListInput"
              },
              {
                "$ref": "#/$defs/CsvInput"
              }
            ]
          }
        }
      },
      "required": [
        "@type",
        "file",
        "column"
      ]
    },
    "ExtractedInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@type": {
          "type": "string",
          "enum": [
            "extracted"
          ],
          "default": "extracted"
        },
        "id": {
          "type": "string"
        },
        "initial": {
          "type": "string"
        },
        "extractions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegExExtraction"
          }
        }
      },
      "required": [
        "@type",
        "extractions"
      ]
    },
    "RegExExtraction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        },
        "response-key": {
          "type": "string",
          "default": "<default>"
        },
        "template": {
          "type": "string",
          "default": "(1)"
        },
        "match-number": {
          "type": "integer",
          "default": 1
        },
        "fallback": {
          "type": "string",
          "default": "NOT FOUND"
        }
      },
      "required": [
        "from",
        "pattern"
      ]
    },
    "CounterInput": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "@type": {
          "type": "string",
          "enum": [
            "counter"
          ],
          "default": "counter"
        },
        "id": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "GLOBAL",
            "USER",
            "USER_ITERATION"
          ]
        },
        "start": {
          "type": "integer"
        },
        "increment": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        }
      },
      "required": [
        "@type",
        "scope",
        "start",
        "increment",
        "maximum"
      ]
    },
    "HttpEndpointOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "HttpEndpoint.domain": {
          "type": "string"
        },
        "HttpEndpoint.port": {
          "type": "string"
        },
        "HttpEndpoint.encoding": {
          "type": "string"
        },
        "HttpEndpoint.protocol": {
          "type": "string"
        },
        "HttpEndpoint.header": {
          "type": "string"
        }
      }
    },
    "HttpParameterOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "HttpParameter.encoded": {
          "type": "string"
        }
      }
    }
  }
}
