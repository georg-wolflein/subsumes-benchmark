{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "anyOf": [
    {
      "allOf": [
        {
          "required": [
            "type",
            "coordinates"
          ]
        },
        {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/MultiPoint"
            },
            {
              "$ref": "#/$defs/LineString"
            },
            {
              "$ref": "#/$defs/MultiLineString"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ]
        }
      ]
    },
    {
      "required": [
        "type",
        "geometries"
      ],
      "properties": {
        "type": {
          "enum": [
            "GeometryCollection"
          ]
        },
        "geometries": {
          "type": "array",
          "items": {
            "$ref": "#"
          }
        }
      }
    }
  ],
  "$defs": {
    "Point": {
      "title": "Point",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Point"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "MultiPoint": {
      "title": "MultiPoint",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "MultiPoint"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/positionArray"
        }
      }
    },
    "LineString": {
      "title": "LineString",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "LineString"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/lineString"
        }
      }
    },
    "MultiLineString": {
      "title": "MultiLineString",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "MultiLineString"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineString"
          }
        }
      }
    },
    "Polygon": {
      "title": "Polygon",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Polygon"
          ]
        },
        "coordinates": {
          "$ref": "#/$defs/polygonCoordinates"
        }
      }
    },
    "MultiPolygon": {
      "title": "MultiPolygon",
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "MultiPolygon"
          ]
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/polygonCoordinates"
          }
        }
      }
    },
    "lineString": {
      "allOf": [
        {
          "$ref": "#/$defs/positionArray"
        },
        {
          "minItems": 2
        }
      ]
    },
    "linearRingCoordinates": {
      "allOf": [
        {
          "$ref": "#/$defs/positionArray"
        },
        {
          "minItems": 4
        }
      ]
    },
    "polygonCoordinates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/linearRingCoordinates"
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false
    },
    "positionArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/position"
      }
    }
  }
}
