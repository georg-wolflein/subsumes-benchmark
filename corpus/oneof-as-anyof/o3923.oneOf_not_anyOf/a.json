{
  "$id": "http://www.cornutum.org/tcases/system-test-schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Test Model",
  "description": "Defines test cases for a system (version: ${project.version})",
  "type": "object",
  "properties": {
    "system": {
      "type": "string"
    },
    "has": {
      "$ref": "#/$defs/annotation"
    }
  },
  "required": [
    "system"
  ],
  "additionalProperties": {
    "$ref": "#/$defs/function"
  },
  "$defs": {
    "annotation": {
      "description": "Defines a set of output annotations",
      "type": "object",
      "patternProperties": {
        ".": {
          "type": "string"
        }
      },
      "minProperties": 1
    },
    "function": {
      "description": "Defines the test cases for a system function",
      "anyOf": [
        {
          "description": "Deprecated: For compatibility with version<=3.0.1",
          "type": "array",
          "items": {
            "$ref": "#/$defs/testCase"
          }
        },
        {
          "type": "object",
          "properties": {
            "testCases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/testCase"
              }
            },
            "has": {
              "$ref": "#/$defs/annotation"
            }
          },
          "required": [
            "testCases"
          ]
        }
      ]
    },
    "testCase": {
      "description": "Defines a test case for a system function",
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "has": {
          "$ref": "#/$defs/annotation"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/inputDef"
      },
      "required": [
        "id"
      ]
    },
    "inputDef": {
      "description": "Defines bindings for a set of input variables of the same type",
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        ".": {
          "$ref": "#/$defs/bindingDef"
        }
      }
    },
    "bindingDef": {
      "type": "object",
      "properties": {
        "has": {
          "$ref": "#/$defs/annotation"
        },
        "value": {
          "type": "string"
        },
        "NA": {
          "type": "boolean"
        },
        "failure": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "value"
          ],
          "properties": {
            "NA": false
          }
        },
        {
          "required": [
            "NA"
          ],
          "properties": {
            "value": false,
            "failure": false
          }
        }
      ]
    }
  }
}
