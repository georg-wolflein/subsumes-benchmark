{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "extensionLevels": {
      "default": [],
      "items": {
        "$ref": "#/$defs/extensionLevel"
      },
      "type": "array"
    },
    "initialLevel": {
      "$ref": "#/$defs/initialLevel"
    }
  },
  "required": [
    "initialLevel"
  ],
  "type": "object",
  "$defs": {
    "action": {
      "properties": {
        "interactions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/interaction"
          },
          "type": "array"
        },
        "publishedProperties": {
          "default": [],
          "items": {
            "$ref": "#/$defs/property"
          },
          "type": "array"
        },
        "realizedFunctionalities": {
          "default": [],
          "items": {
            "$ref": "#/$defs/functionality"
          },
          "type": "array"
        },
        "widget": {
          "$ref": "#/$defs/widget"
        }
      },
      "required": [
        "widget"
      ],
      "type": "object"
    },
    "actionProvision": {
      "properties": {
        "precursorAction": {
          "$ref": "#/$defs/action"
        },
        "propertyProvisions": {
          "items": {
            "$ref": "#/$defs/propertyProvision"
          },
          "minItems": 1,
          "type": "array"
        },
        "requestedAction": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "request"
      ],
      "type": "object"
    },
    "distance": {
      "default": 0,
      "description": "a value indicating the distance between two related concepts, the higher the value the more distant their relation is, value 0 means identical concepts",
      "min": 0,
      "type": "number"
    },
    "extensionLevel": {
      "properties": {
        "actionProvisions": {
          "items": {
            "$ref": "#/$defs/actionProvision"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "actionProvisions"
      ],
      "type": "object"
    },
    "functionality": {
      "$ref": "#/$defs/identifiable"
    },
    "functionalityProvision": {
      "properties": {
        "distance": {
          "$ref": "#/$defs/distance"
        },
        "offer": {
          "$ref": "#/$defs/functionality"
        },
        "providingAction": {
          "$ref": "#/$defs/action"
        },
        "request": {
          "$ref": "#/$defs/functionality"
        }
      },
      "required": [
        "request",
        "offer",
        "providingAction"
      ],
      "type": "object"
    },
    "identifiable": {
      "description": "a uniquely identifiable entity",
      "type": "object",
      "anyOf": [
        {
          "properties": {
            "uri": {
              "_format": "uri",
              "description": "a URI identifying the entity",
              "type": "string"
            }
          },
          "required": [
            "uri"
          ]
        },
        {
          "properties": {
            "id": {
              "description": "a value uniquely identifying the entity within a single plan, used when the entity cannot identified by a URI",
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        }
      ]
    },
    "initialLevel": {
      "properties": {
        "functionalityProvisions": {
          "items": {
            "$ref": "#/$defs/functionalityProvision"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "functionalityProvisions"
      ],
      "type": "object"
    },
    "interaction": {
      "properties": {
        "instructionText": {
          "type": "string"
        }
      },
      "required": [
        "instructionText"
      ],
      "type": "object"
    },
    "property": {
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/type"
        }
      },
      "required": [
        "name",
        "type"
      ],
      "type": "object"
    },
    "propertyProvision": {
      "properties": {
        "distance": {
          "$ref": "#/$defs/distance"
        },
        "offer": {
          "$ref": "#/$defs/property"
        },
        "providingAction": {
          "$ref": "#/$defs/action"
        },
        "request": {
          "$ref": "#/$defs/property"
        }
      },
      "required": [
        "request",
        "offer",
        "providingAction"
      ],
      "type": "object"
    },
    "type": {
      "$ref": "#/$defs/identifiable"
    },
    "widget": {
      "$ref": "#/$defs/identifiable"
    }
  }
}
