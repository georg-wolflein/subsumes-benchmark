{
  "$id": "http://www.gaaiat.com/json-xformer",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "JSON Transformer Schema",
  "title": "JSON Transformer Schema",
  "type": "object",
  "required": [
    "transformMap"
  ],
  "properties": {
    "sourceLocale": {
      "type": "string",
      "default": "en-US"
    },
    "targetLocale": {
      "type": "string",
      "default": "en-US"
    },
    "transformMap": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sourcePtr": {
            "type": "string"
          },
          "targetPtr": {
            "type": "string"
          },
          "customFormatter": {
            "type": "string"
          },
          "defaultValue": {
            "anyOf": [
              {
                "type": [
                  "array",
                  "object",
                  "boolean",
                  "integer",
                  "number",
                  "string"
                ]
              }
            ]
          }
        },
        "requiredProperties": [
          "sourcePtr",
          "targetPtr"
        ]
      }
    }
  }
}
