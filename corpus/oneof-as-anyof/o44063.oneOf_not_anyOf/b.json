{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A schema for a Fruity API",
  "properties": {
    "lemon": {
      "$ref": "#/$defs/lemon"
    },
    "lime": {
      "$ref": "#/$defs/lime"
    }
  },
  "$defs": {
    "lemon": {
      "$defs": {
        "identity": {
          "oneOf": [
            {
              "$ref": "#/$defs/lemon/$defs/lemon_uuid"
            }
          ]
        },
        "is_ripe": {
          "description": "Whether or not the lemon is ripe",
          "example": true,
          "type": [
            "boolean"
          ]
        },
        "lemon_uuid": {
          "description": "A unique uuid reference for the lemon",
          "example": "44724831-bf66-4bc2-865f-e2c4c2b14c78",
          "format": "uuid",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "picked_on": {
          "description": "The date on which the lemon was picked",
          "example": "2013-10-19 22:10:29Z",
          "format": "date-time",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "size": {
          "description": "The size of the lemon, 'small', 'medium' or 'large'",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "example": "small",
          "readOnly": true
        }
      },
      "description": "For lovers of lemons, look no further.",
      "links": [
        {
          "description": "List all Lemons",
          "href": "/lemon",
          "method": "GET",
          "rel": "instances",
          "schema": {
            "additionalProperties": false,
            "properties": {
              "size": {
                "items": {
                  "$ref": "#/$defs/lemon/$defs/size"
                },
                "maxItems": 2,
                "type": [
                  "array",
                  "string"
                ]
              }
            },
            "type": [
              "object"
            ]
          },
          "title": "List"
        },
        {
          "description": "Show a single Lemon",
          "href": "/lemon/{(%23%2Fdefinitions3%2Flemon%2Fdefinitions3%2Flemon_uuid)}",
          "method": "GET",
          "rel": "self",
          "title": "Info"
        },
        {
          "description": "Create a new Lemon",
          "href": "/lemon",
          "method": "POST",
          "rel": "create",
          "schema": {
            "properties": {
              "is_ripe": {
                "$ref": "#/$defs/lemon/$defs/is_ripe"
              },
              "lemon_uuid": {
                "$ref": "#/$defs/lemon/$defs/lemon_uuid"
              },
              "picked_on": {
                "$ref": "#/$defs/lemon/$defs/picked_on"
              },
              "size": {
                "$ref": "#/$defs/lemon/$defs/size"
              }
            }
          },
          "title": "Create"
        },
        {
          "description": "Update a sample lemon",
          "href": "/lemon/{(%23%2Fdefinitions3%2Flemon%2Fdefinitions3%2Flemon_uuid)}",
          "method": "PATCH",
          "rel": "update",
          "schema": {
            "properties": {
              "is_ripe": {
                "$ref": "#/$defs/lemon/$defs/is_ripe"
              },
              "lemon_uuid": {
                "$ref": "#/$defs/lemon/$defs/lemon_uuid"
              },
              "picked_on": {
                "$ref": "#/$defs/lemon/$defs/picked_on"
              },
              "size": {
                "$ref": "#/$defs/lemon/$defs/size"
              }
            }
          },
          "title": "Update"
        },
        {
          "description": "Delete a whole size of lemons, you murderer",
          "href": "/lemon/{(%23%2Fdefinitions3%2Flemon%2Fdefinitions3%2Fsize)}",
          "method": "DELETE",
          "rel": "destroy",
          "title": "Delete"
        }
      ],
      "properties": {
        "is_ripe": {
          "$ref": "#/$defs/lemon/$defs/is_ripe"
        },
        "lemon_uuid": {
          "$ref": "#/$defs/lemon/$defs/lemon_uuid"
        },
        "picked_on": {
          "$ref": "#/$defs/lemon/$defs/picked_on"
        },
        "size": {
          "$ref": "#/$defs/lemon/$defs/size"
        }
      },
      "title": "Lemons",
      "type": [
        "object"
      ]
    },
    "lime": {
      "$defs": {
        "identity": {
          "oneOf": [
            {
              "$ref": "#/$defs/lime/$defs/lime_uuid"
            }
          ]
        },
        "lime_uuid": {
          "description": "A unique uuid reference for the lime",
          "example": "44724831-bf66-4bc2-865f-e2c4c2b14c78",
          "format": "uuid",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "picked_on": {
          "description": "The date on which the lime was picked",
          "example": "2013-10-19 22:10:29Z",
          "format": "date-time",
          "readOnly": true,
          "type": [
            "string"
          ]
        }
      },
      "description": "Like lemons, but not as good",
      "links": [
        {
          "description": "List all Limes",
          "href": "/lime",
          "method": "GET",
          "rel": "instances",
          "title": "List"
        }
      ],
      "properties": {
        "lime_uuid": {
          "$ref": "#/$defs/lime/$defs/lime_uuid"
        },
        "picked_on": {
          "$ref": "#/$defs/lime/$defs/picked_on"
        }
      },
      "title": "Limes < Lemons",
      "type": [
        "object"
      ]
    }
  }
}
