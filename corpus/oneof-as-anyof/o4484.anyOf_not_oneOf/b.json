{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "name": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[@a-zA-Z0-9\\-]*$",
      "type": "string"
    },
    "services": {
      "items": {
        "$ref": "#/$defs/service"
      },
      "minItems": 1,
      "type": "array",
      "_uniqueItems": true
    },
    "size": {
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "minimum": 3,
      "multipleOf": 1.0,
      "type": "number"
    },
    "will_end": {
      "type": "boolean"
    }
  },
  "required": [
    "name",
    "will_end",
    "size",
    "version",
    "services"
  ],
  "title": "Zoe application description schema",
  "type": "object",
  "$defs": {
    "env_var": {
      "prefixItems": [
        {
          "regex": "^[A-Z][A-Z0-9]*$",
          "type": "string"
        },
        {
          "type": "string"
        }
      ],
      "type": "array"
    },
    "port": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 3,
          "type": "string"
        },
        "port_number": {
          "multipleOf": 1.0,
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 65536
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ],
          "type": "string"
        },
        "proxy": {
          "type": "boolean"
        },
        "url_template": {
          "regex": "^[a-z]?://HOST:PORT/[a-zA-Z0-9./\\-_]$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "port_number",
        "protocol",
        "url_template"
      ],
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "items": {
            "$ref": "#/$defs/env_var"
          },
          "minItems": 0,
          "type": "array",
          "_uniqueItems": true
        },
        "essential_count": {
          "minimum": 1,
          "multipleOf": 1.0,
          "type": "number"
        },
        "image": {
          "minLength": 1,
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "_uniqueItems": true
        },
        "monitor": {
          "type": "boolean"
        },
        "name": {
          "maxLength": 16,
          "minLength": 3,
          "pattern": "^[a-zA-Z0-9\\-]*$",
          "type": "string"
        },
        "network": {
          "minLength": 1,
          "type": "string"
        },
        "ports": {
          "items": {
            "$ref": "#/$defs/port"
          },
          "minItems": 0,
          "type": "array",
          "_uniqueItems": true
        },
        "replicas": {
          "minimum": 1,
          "multipleOf": 1.0,
          "type": "number"
        },
        "resources": {
          "additionalProperties": false,
          "properties": {
            "cores": {
              "additionalProperties": false,
              "properties": {
                "max": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "min": {
                  "anyOf": [
                    {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "min",
                "max"
              ],
              "type": "object"
            },
            "memory": {
              "additionalProperties": false,
              "properties": {
                "max": {
                  "anyOf": [
                    {
                      "multipleOf": 1.0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "min": {
                  "anyOf": [
                    {
                      "minimum": 1024,
                      "multipleOf": 1.0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "min",
                "max"
              ],
              "type": "object"
            },
            "shm": {
              "minimum": 0,
              "multipleOf": 1.0,
              "type": "number"
            }
          },
          "required": [
            "memory",
            "cores"
          ],
          "type": "object"
        },
        "startup_order": {
          "multipleOf": 1.0,
          "type": "number"
        },
        "total_count": {
          "minimum": 1,
          "multipleOf": 1.0,
          "type": "number"
        },
        "volumes": {
          "items": {
            "$ref": "#/$defs/volume"
          },
          "minItems": 0,
          "type": "array",
          "_uniqueItems": true
        },
        "work_dir": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "image",
        "ports",
        "environment",
        "volumes",
        "monitor",
        "startup_order",
        "essential_count",
        "total_count",
        "resources",
        "command"
      ],
      "type": "object"
    },
    "volume": {
      "properties": {
        "name": {
          "minLength": 3,
          "regex": "^[a-zA-Z0-9.]?$",
          "type": "string"
        },
        "path": {
          "minLength": 2,
          "regex": "^/[a-zA-Z0-9]?[a-zA-Z0-9./]*$",
          "type": "string"
        },
        "read_only": {
          "type": "boolean"
        }
      },
      "type": "object"
    }
  }
}
