{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Sample schema for use in tests.",
  "properties": {
    "another-resource": {
      "$ref": "#/$defs/another-resource"
    },
    "resource": {
      "$ref": "#/$defs/resource"
    },
    "underscored_resource": {
      "$ref": "#/$defs/underscored_resource"
    }
  },
  "$defs": {
    "another-resource": {
      "$defs": {},
      "description": "Another sample resource to use in tests.",
      "links": [
        {
          "description": "Show all sample resources",
          "href": "/another-resource",
          "method": "GET",
          "rel": "instances",
          "title": "List"
        }
      ],
      "properties": {},
      "title": "Another sample resource title",
      "type": [
        "object"
      ]
    },
    "resource": {
      "$defs": {
        "boolean_field": {
          "description": "A sample boolean field",
          "example": true,
          "type": [
            "boolean"
          ]
        },
        "date_field": {
          "description": "A sample date field",
          "example": "2013-10-19 22:10:29Z",
          "format": "date-time",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "email_field": {
          "description": "A sample email address field",
          "example": "username@example.com",
          "format": "email",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "identity": {
          "oneOf": [
            {
              "$ref": "#/$defs/resource/$defs/uuid_field"
            },
            {
              "$ref": "#/$defs/resource/$defs/email_field"
            }
          ]
        },
        "string_field": {
          "description": "A sample string field",
          "example": "Sample text.",
          "readOnly": true,
          "type": [
            "string"
          ]
        },
        "uuid_field": {
          "description": "A sample UUID field",
          "example": "44724831-bf66-4bc2-865f-e2c4c2b14c78",
          "format": "uuid",
          "readOnly": true,
          "type": [
            "string"
          ]
        }
      },
      "description": "A sample resource to use in tests.",
      "links": [
        {
          "description": "Show all sample resources",
          "href": "/resource",
          "method": "GET",
          "rel": "instances",
          "title": "List"
        },
        {
          "description": "Show a sample resource",
          "href": "/resource/{(%23%2Fdefinitions3%2Fresource%2Fdefinitions3%2Fuuid_field)}",
          "method": "GET",
          "rel": "self",
          "title": "Info"
        },
        {
          "description": "Show a sample resource",
          "href": "/resource/{(%23%2Fdefinitions3%2Fresource%2Fdefinitions3%2Fidentity)}",
          "method": "GET",
          "rel": "self",
          "title": "Identify resource"
        },
        {
          "description": "Create a sample resource",
          "href": "/resource",
          "method": "POST",
          "rel": "create",
          "schema": {
            "properties": {
              "boolean_field": {
                "$ref": "#/$defs/resource/$defs/boolean_field"
              },
              "date_field": {
                "$ref": "#/$defs/resource/$defs/date_field"
              },
              "email_field": {
                "$ref": "#/$defs/resource/$defs/email_field"
              },
              "string_field": {
                "$ref": "#/$defs/resource/$defs/string_field"
              },
              "uuid_field": {
                "$ref": "#/$defs/resource/$defs/uuid_field"
              }
            }
          },
          "title": "Create"
        },
        {
          "description": "Submit a sample resource as form data",
          "encType": "application/x-www-form-urlencoded",
          "href": "/resource",
          "method": "POST",
          "rel": "submit",
          "schema": {
            "properties": {
              "boolean_field": {
                "$ref": "#/$defs/resource/$defs/boolean_field"
              },
              "date_field": {
                "$ref": "#/$defs/resource/$defs/date_field"
              },
              "email_field": {
                "$ref": "#/$defs/resource/$defs/email_field"
              },
              "string_field": {
                "$ref": "#/$defs/resource/$defs/string_field"
              },
              "uuid_field": {
                "$ref": "#/$defs/resource/$defs/uuid_field"
              }
            }
          },
          "title": "Submit"
        },
        {
          "description": "Update a sample resource",
          "href": "/resource/{(%23%2Fdefinitions3%2Fresource%2Fdefinitions3%2Fuuid_field)}",
          "method": "PATCH",
          "rel": "update",
          "schema": {
            "properties": {
              "boolean_field": {
                "$ref": "#/$defs/resource/$defs/boolean_field"
              },
              "date_field": {
                "$ref": "#/$defs/resource/$defs/date_field"
              },
              "email_field": {
                "$ref": "#/$defs/resource/$defs/email_field"
              },
              "string_field": {
                "$ref": "#/$defs/resource/$defs/string_field"
              },
              "uuid_field": {
                "$ref": "#/$defs/resource/$defs/uuid_field"
              }
            }
          },
          "title": "Update"
        },
        {
          "description": "Delete an existing sample resource at specific time",
          "href": "/resource/{(%23%2Fdefinitions3%2Fresource%2Fdefinitions3%2Fdate_field)}",
          "method": "DELETE",
          "rel": "destroy",
          "title": "Delete"
        }
      ],
      "properties": {
        "boolean_field": {
          "$ref": "#/$defs/resource/$defs/boolean_field"
        },
        "date_field": {
          "$ref": "#/$defs/resource/$defs/date_field"
        },
        "email_field": {
          "$ref": "#/$defs/resource/$defs/email_field"
        },
        "string_field": {
          "$ref": "#/$defs/resource/$defs/string_field"
        },
        "uuid_field": {
          "$ref": "#/$defs/resource/$defs/uuid_field"
        }
      },
      "title": "Sample resource title",
      "type": [
        "object"
      ]
    },
    "underscored_resource": {
      "$defs": {},
      "description": "Underscores the importance of supporting underscored resources",
      "links": [
        {
          "description": "Show all underscored resources",
          "href": "/underscored_resource",
          "method": "GET",
          "rel": "instances",
          "title": "List"
        }
      ],
      "properties": {},
      "title": "Another underscored resource to use in tests",
      "type": [
        "object"
      ]
    }
  }
}
