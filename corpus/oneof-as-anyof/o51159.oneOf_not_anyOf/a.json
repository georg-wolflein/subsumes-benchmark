{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Credit card with or without security code",
  "properties": {
    "creditcard": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "mastercard"
              ],
              "type": "string"
            }
          },
          "required": [
            "provider"
          ]
        },
        {
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "visa"
              ],
              "type": "string"
            },
            "securitycode": {
              "type": "integer"
            }
          },
          "required": [
            "provider",
            "securitycode"
          ]
        }
      ]
    }
  },
  "title": "Credit card validation",
  "type": "object"
}
