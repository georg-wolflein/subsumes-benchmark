{
  "$id": "https://raw.githubusercontent.com/Microsoft/vscode-python/master/schemas/conda-meta.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "conda metadata build recipe",
  "description": "conda's meta.yaml file; https://conda.io/docs/user-guide/tasks/build-packages/define-metadata.html",
  "properties": {
    "package": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/package"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "source": {
      "oneOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      ]
    },
    "build": {
      "type": "object",
      "properties": {
        "number": {
          "$ref": "#/$defs/integer"
        },
        "string": {
          "type": "string"
        },
        "entry_points": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "osx_is_app": {
          "$ref": "#/$defs/boolean"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "track_features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "preserve_egg_dir": {
          "$ref": "#/$defs/boolean"
        },
        "skip_compile_pyc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "no_link": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "script": {
          "type": "string"
        },
        "rpaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "always_include_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "binary_relocation": {
          "$ref": "#/$defs/boolean"
        },
        "detect_binary_files_with_prefix": {
          "$ref": "#/$defs/boolean"
        },
        "binary_has_prefix_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "has_prefix_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "ignore_prefix_files": {
          "oneOf": [
            {
              "$ref": "#/$defs/boolean"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/$defs/path"
              }
            }
          ]
        },
        "skip": {
          "$ref": "#/$defs/boolean"
        },
        "noarch": {
          "type": "string"
        },
        "noarch_python": {
          "$ref": "#/$defs/boolean"
        },
        "include_recipe": {
          "$ref": "#/$defs/boolean"
        },
        "script_env": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "run_exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ignore_run_exports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "requirements": {
      "$ref": "#/$defs/requirement"
    },
    "test": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/test"
        }
      ]
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/path"
            }
          },
          "script": {
            "$ref": "#/$defs/path"
          },
          "script_interpreter": {
            "type": "string"
          },
          "requirements": {
            "oneOf": [
              {
                "$ref": "#/$defs/requirement"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/package"
                }
              }
            ]
          },
          "run_exports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test": {
            "$ref": "#/$defs/test"
          },
          "type": {
            "type": "string"
          }
        }
      }
    },
    "about": {
      "type": "object",
      "properties": {
        "home": {
          "$ref": "#/$defs/uri"
        },
        "license": {
          "type": "string"
        },
        "license_file": {
          "$ref": "#/$defs/path"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "entry": {
          "type": "string"
        },
        "icon": {
          "$ref": "#/$defs/path"
        },
        "summary": {
          "type": "string"
        },
        "own_environment": {
          "$ref": "#/$defs/boolean"
        }
      }
    },
    "extra": {}
  },
  "$defs": {
    "boolean": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string"
        }
      ]
    },
    "integer": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "feature": {
      "type": "string"
    },
    "package": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "uri": {
      "type": "string"
    },
    "requirement": {
      "type": "object",
      "properties": {
        "build": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "host": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "run": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "$ref": "#/$defs/uri"
        },
        "md5": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{32}$"
        },
        "sha1": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{40}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{64}$"
        },
        "git_url": {
          "$ref": "#/$defs/uri"
        },
        "git_rev": {
          "type": "string"
        },
        "hg_url": {
          "$ref": "#/$defs/uri"
        },
        "hg_tag": {
          "type": "string"
        },
        "svn_url": {
          "$ref": "#/$defs/uri"
        },
        "svn_rev": {
          "type": "string"
        },
        "svn_ignore_externals": {
          "$ref": "#/$defs/boolean"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "patches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "folder": {
          "$ref": "#/$defs/path"
        },
        "fn": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "source_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/package"
          }
        },
        "script": {
          "type": "string"
        }
      }
    }
  }
}
