{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "anyOf",
    "enum",
    "items",
    "oneOf",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o58615.oneOf_not_anyOf.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "top level oneOf enum array",
    "type": "array",
    "items": {
      "anyOf": [
        {
          "$ref": "#/$defs/MyEnum"
        },
        {
          "enum": [
            "d",
            "e"
          ]
        }
      ]
    },
    "$defs": {
      "MyEnum": {
        "enum": [
          "a",
          "b",
          "c"
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "top level oneOf enum array",
    "type": "array",
    "items": {
      "oneOf": [
        {
          "$ref": "#/$defs/MyEnum"
        },
        {
          "enum": [
            "d",
            "e"
          ]
        }
      ]
    },
    "$defs": {
      "MyEnum": {
        "enum": [
          "a",
          "b",
          "c"
        ]
      }
    }
  }
}
