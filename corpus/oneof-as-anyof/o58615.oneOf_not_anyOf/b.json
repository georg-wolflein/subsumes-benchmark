{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "top level oneOf enum array",
  "type": "array",
  "items": {
    "oneOf": [
      {
        "$ref": "#/$defs/MyEnum"
      },
      {
        "enum": [
          "d",
          "e"
        ]
      }
    ]
  },
  "$defs": {
    "MyEnum": {
      "enum": [
        "a",
        "b",
        "c"
      ]
    }
  }
}
