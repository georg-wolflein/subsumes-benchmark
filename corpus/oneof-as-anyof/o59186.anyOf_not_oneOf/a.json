{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON schema for express-json-patch-assertion options",
  "type": "object",
  "properties": {
    "allow": {
      "description": "Assertions that will allow matched operations to proceed",
      "oneOf": [
        {
          "$ref": "#/$defs/assertion"
        },
        {
          "$ref": "#/$defs/assertionList"
        }
      ]
    },
    "deny": {
      "description": "Assertions that will deny matched operations from proceeding",
      "oneOf": [
        {
          "$ref": "#/$defs/assertion"
        },
        {
          "$ref": "#/$defs/assertionList"
        }
      ]
    },
    "property": {
      "type": "string",
      "minLenth": 1
    },
    "ajv": {
      "$ref": "#/$defs/ajvOptions"
    }
  },
  "required": [
    "allow",
    "deny",
    "property",
    "ajv"
  ],
  "$defs": {
    "assertion": {
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/path"
        },
        {
          "$ref": "#/$defs/op"
        }
      ],
      "properties": {
        "condition": {
          "type": "object"
        },
        "assertion": {
          "description": "Whether to proceed to next middleware if this one is matched"
        },
        "next": {
          "description": "Whether to proceed to next middleware if this one is matched",
          "type": "boolean"
        },
        "value": {
          "description": "Value or pattern to match against this operation"
        },
        "from": {
          "description": "Property to copy or move from",
          "type": "string"
        }
      },
      "required": [
        "path",
        "op"
      ]
    },
    "assertionList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "path": {
      "properties": {
        "path": {
          "oneOf": [
            {
              "$ref": "#/$defs/pathString"
            },
            {
              "$ref": "#/$defs/pathList"
            }
          ]
        }
      }
    },
    "pathString": {
      "description": "A JSON Pointer path.",
      "type": "string"
    },
    "pathList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pathString"
      }
    },
    "op": {
      "properties": {
        "op": {
          "oneOf": [
            {
              "$ref": "#/$defs/opString"
            },
            {
              "$ref": "#/$defs/opList"
            }
          ]
        }
      }
    },
    "opString": {
      "type": "string",
      "enum": [
        "add",
        "replace",
        "test",
        "remove",
        "*"
      ]
    },
    "opList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opString"
      }
    },
    "ajvOptions": {
      "description": "AJV json validator options - see https://github.com/epoberezkin/ajv/blob/master/README.md#options",
      "type": "object"
    }
  }
}
