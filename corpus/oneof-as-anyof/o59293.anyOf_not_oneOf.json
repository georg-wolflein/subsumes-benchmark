{
  "$schema": "../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "anyOf",
    "items",
    "oneOf",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o59293.anyOf_not_oneOf.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o59293.oneOf_not_anyOf.json"
  ],
  "derived": {
    "a_subsumes_b": {
      "checkers": [
        "RWG 8064ad8",
        "jsoncompat 0.6.0",
        "subsumes 0.2.0"
      ]
    },
    "b_subsumes_a": {
      "checkers": [
        "RWG 8064ad8",
        "jsoncompat 0.6.0",
        "subsumes 0.2.0"
      ]
    }
  },
  "a": {
    "$id": "https://raw.githubusercontent.com/mattmccray/syncodemayo/master/config.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "local",
      "targets"
    ],
    "properties": {
      "local": {
        "$ref": "#/$defs/localTarget"
      },
      "targets": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/remoteTarget"
        }
      }
    },
    "additionalProperties": true,
    "$defs": {
      "localTarget": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "files": {
            "type": "string",
            "default": "**/**"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "defaultTarget": {
            "type": "string"
          },
          "deleteRemoteFiles": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "remoteTarget": {
        "type": "object",
        "required": [
          "host",
          "path",
          "user"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "pass": {
            "type": "string"
          },
          "port": {
            "type": "number",
            "description": "(Default = 21)",
            "default": 21
          },
          "cache": {
            "type": "string",
            "description": "Name of checksum list file. (Default = '.synco-filelist')",
            "default": ".synco-filelist"
          },
          "prompt": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ],
            "default": true
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "type": {
            "type": "string",
            "description": "(reservered for future use)"
          }
        }
      }
    }
  },
  "b": {
    "$id": "https://raw.githubusercontent.com/mattmccray/syncodemayo/master/config.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "local",
      "targets"
    ],
    "properties": {
      "local": {
        "$ref": "#/$defs/localTarget"
      },
      "targets": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/remoteTarget"
        }
      }
    },
    "additionalProperties": true,
    "$defs": {
      "localTarget": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "files": {
            "type": "string",
            "default": "**/**"
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": []
          },
          "defaultTarget": {
            "type": "string"
          },
          "deleteRemoteFiles": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "remoteTarget": {
        "type": "object",
        "required": [
          "host",
          "path",
          "user"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "host": {
            "type": "string"
          },
          "user": {
            "type": "string"
          },
          "pass": {
            "type": "string"
          },
          "port": {
            "type": "number",
            "description": "(Default = 21)",
            "default": 21
          },
          "cache": {
            "type": "string",
            "description": "Name of checksum list file. (Default = '.synco-filelist')",
            "default": ".synco-filelist"
          },
          "prompt": {
            "default": true,
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "type": {
            "type": "string",
            "description": "(reservered for future use)"
          }
        }
      }
    }
  }
}
