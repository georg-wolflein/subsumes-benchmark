{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The value returned by PUT /{db}/{docid}",
  "oneOf": [
    {
      "properties": {
        "error": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "error",
        "reason"
      ]
    },
    {
      "properties": {
        "id": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "rev": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "ok"
      ]
    }
  ],
  "title": "CouchDB create doc",
  "type": "object"
}
