{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The value returned by PUT /{db}",
  "title": "CouchDB database creation",
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "error": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "error",
        "reason"
      ]
    },
    {
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "ok"
      ]
    }
  ]
}
