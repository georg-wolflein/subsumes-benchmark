{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "anyOf",
    "enum",
    "format",
    "items",
    "oneOf",
    "pattern",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o60974.anyOf_not_oneOf.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o60974.oneOf_not_anyOf.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Result of Dependency Snapshot worker",
    "properties": {
      "schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the schema",
            "pattern": "^[a-zA-Z0-9_]+$"
          },
          "version": {
            "type": "string",
            "description": "Version of the schema",
            "pattern": "^[0-9]+-[0-9]+-[0-9]+$"
          },
          "url": {
            "type": "string",
            "description": "Full URL of the schema",
            "format": "uri"
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "_release": {
        "type": "string",
        "description": "Unique release id in form of \"ecosystem:package:version\""
      },
      "status": {
        "type": "string",
        "enum": [
          "success",
          "error"
        ]
      },
      "details": {
        "$ref": "#/$defs/dependency_snapshot_detail"
      },
      "summary": {
        "$ref": "#/$defs/dependency_snapshot_summary"
      }
    },
    "required": [
      "status",
      "details",
      "summary"
    ],
    "additionalProperties": false,
    "title": "dependency_snapshot-v1-0-0",
    "$defs": {
      "dependencies_counts": {
        "type": "object",
        "description": "Counts of various types of dependencies",
        "properties": {
          "runtime": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "dependency_object": {
        "type": "object",
        "description": "Dependency Object",
        "properties": {
          "ecosystem": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "version": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "declaration": {
            "type": "string"
          },
          "resolved_at": {
            "type": "string"
          }
        },
        "required": [
          "ecosystem",
          "name",
          "version",
          "declaration",
          "resolved_at"
        ],
        "additionalProperties": false
      },
      "dependency_snapshot_detail": {
        "type": "object",
        "description": "Details of Dependency Snapshot run on a component",
        "properties": {
          "runtime": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/dependency_object"
            }
          }
        },
        "additionalProperties": false
      },
      "dependency_snapshot_summary": {
        "type": "object",
        "description": "Summary of Dependency Snapshot run on a component",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependency_counts": {
            "$ref": "#/$defs/dependencies_counts"
          }
        },
        "required": [
          "errors",
          "dependency_counts"
        ],
        "additionalProperties": false
      }
    }
  },
