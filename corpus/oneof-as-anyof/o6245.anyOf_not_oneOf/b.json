{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "anyOf": [
    {
      "properties": {
        "method": {
          "$ref": "#/$defs/_methodNoBody"
        },
        "responsePath": {
          "$ref": "#/$defs/responsePath"
        },
        "uriTemplate": {
          "$ref": "#/$defs/uriTemplate"
        },
        "headerInfo": {
          "$ref": "#/$defs/headerInfo"
        }
      },
      "required": [
        "method",
        "uriTemplate"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "method": {
          "$ref": "#/$defs/_methodWithBody"
        },
        "responsePath": {
          "$ref": "#/$defs/responsePath"
        },
        "uriTemplate": {
          "$ref": "#/$defs/uriTemplate"
        },
        "bodyTemplate": {
          "$ref": "#/$defs/bodyTemplate"
        },
        "headerInfo": {
          "$ref": "#/$defs/headerInfo"
        }
      },
      "required": [
        "method",
        "uriTemplate",
        "bodyTemplate"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "_methodNoBody": {
      "title": "HTTP Method",
      "description": "GET, DELETE, POST, PATCH or PUT",
      "enum": [
        "GET",
        "DELETE"
      ]
    },
    "_methodWithBody": {
      "title": "HTTP Method",
      "description": "GET, DELETE, POST, PATCH or PUT",
      "enum": [
        "POST",
        "PATCH",
        "PUT"
      ]
    },
    "responsePath": {
      "title": "Response Path",
      "description": "JSON path for where to store response",
      "type": "string",
      "minLength": 1
    },
    "uriTemplate": {
      "title": "URI Template",
      "minLength": 1,
      "type": "string",
      "messages": {
        "required": "URI Template is required"
      }
    },
    "bodyTemplate": {
      "title": "Request Body",
      "type": "string"
    },
    "headerInfo": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "properties": {
          "key": {
            "title": "Name",
            "type": "string",
            "minLength": 1
          },
          "valueTemplate": {
            "title": "Value Template",
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "key",
          "valueTemplate"
        ]
      }
    }
  }
}
