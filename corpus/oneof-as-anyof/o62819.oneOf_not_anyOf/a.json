{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ingest Bulk Update",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "concept-ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "collection-ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CollectionIdType"
      },
      "minItems": 1
    },
    "update-type": {
      "$ref": "#/$defs/UpdateTypeEnum"
    },
    "update-field": {
      "$ref": "#/$defs/UpdateFieldEnum"
    },
    "update-value": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 1
        }
      ]
    },
    "find-value": {
      "type": "object"
    }
  },
  "required": [
    "update-type",
    "update-field",
    "concept-ids"
  ],
  "$defs": {
    "CollectionIdType": {
      "type": "object",
      "properties": {
        "short-name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "short-name",
        "version"
      ]
    },
    "UpdateTypeEnum": {
      "type": "string",
      "enum": [
        "ADD_TO_EXISTING",
        "CLEAR_FIELD",
        "CLEAR_ALL_AND_REPLACE",
        "FIND_AND_REMOVE",
        "FIND_AND_REPLACE",
        "FIND_AND_UPDATE",
        "FIND_AND_UPDATE_HOME_PAGE_URL"
      ]
    },
    "UpdateFieldEnum": {
      "type": "string",
      "enum": [
        "SCIENCE_KEYWORDS",
        "LOCATION_KEYWORDS",
        "DATA_CENTERS",
        "PLATFORMS",
        "INSTRUMENTS"
      ]
    }
  }
}
