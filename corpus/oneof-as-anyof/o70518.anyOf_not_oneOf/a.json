{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledgerVersion",
  "description": "A ledger version number",
  "oneOf": [
    {
      "type": "integer",
      "minimum": 1
    },
    {
      "type": "string",
      "enum": [
        "validated",
        "closed",
        "current"
      ]
    }
  ]
}
