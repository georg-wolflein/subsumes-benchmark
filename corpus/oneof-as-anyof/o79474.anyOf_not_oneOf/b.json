{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "anyOf": [
      {
        "$ref": "#/$defs/allowLogin"
      },
      {
        "$ref": "#/$defs/injectRoles"
      }
    ]
  },
  "$defs": {
    "wildCardCondition": {
      "type": "object",
      "properties": {
        "attribute": {
          "type": "string",
          "description": "the SAML attribute to run the wildcard against"
        },
        "wildCard": {
          "type": "string",
          "description": "the wildcard, with * supported"
        }
      },
      "additionalProperties": false,
      "required": [
        "attribute",
        "wildCard"
      ]
    },
    "alwaysCondition": {
      "type": "boolean"
    },
    "notCondition": {
      "type": "object",
      "properties": {
        "not": {
          "$ref": "#/$defs/condition"
        }
      },
      "additionalProperties": false,
      "required": [
        "not"
      ]
    },
    "condition": {
      "anyOf": [
        {
          "$ref": "#/$defs/wildCardCondition"
        },
        {
          "$ref": "#/$defs/notCondition"
        },
        {
          "$ref": "#/$defs/alwaysCondition"
        }
      ]
    },
    "injectRoles": {
      "type": "object",
      "properties": {
        "injectRoles": {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "roles": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "condition",
            "roles"
          ]
        }
      },
      "required": [
        "injectRoles"
      ]
    },
    "allowLogin": {
      "type": "object",
      "properties": {
        "allowLogin": {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "required": [
            "condition"
          ]
        }
      },
      "required": [
        "allowLogin"
      ]
    }
  }
}
