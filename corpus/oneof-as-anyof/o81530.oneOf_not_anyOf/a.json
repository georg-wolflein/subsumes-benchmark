{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "email": {
      "pattern": "^[\\w|-|.]+@[\\w]+\\.[A-Za-z]{2,4}$",
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "postedSlides": {
      "type": "boolean"
    },
    "rating": {
      "type": "number",
      "anyOf": [
        {
          "maximum": 2
        },
        {
          "maximum": 5
        }
      ]
    }
  },
  "required": [
    "email",
    "firstName",
    "lastName",
    "postedSlides",
    "rating"
  ],
  "type": "object"
}
