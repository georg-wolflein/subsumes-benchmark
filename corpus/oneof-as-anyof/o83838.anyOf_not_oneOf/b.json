{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "networks": {
      "patternProperties": {
        "^[a-zA-Z0-9._-]+$": {
          "$ref": "#/$defs/network"
        }
      },
      "type": "object"
    },
    "services": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9._-]+$": {
          "$ref": "#/$defs/service"
        }
      },
      "type": "object"
    },
    "version": {
      "type": "string"
    },
    "volumes": {
      "additionalProperties": false,
      "patternProperties": {
        "^[a-zA-Z0-9._-]+$": {
          "$ref": "#/$defs/volume"
        }
      },
      "type": "object"
    }
  },
  "type": "object",
  "$defs": {
    "blkio_limit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "rate": {
          "type": [
            "integer",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "blkio_weight": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "weight": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "constraints": {
      "service": {
        "anyOf": [
          {
            "required": [
              "build"
            ]
          },
          {
            "required": [
              "image"
            ]
          }
        ],
        "id": "#/definitions4/constraints/service",
        "properties": {
          "build": {
            "required": [
              "context"
            ]
          }
        }
      }
    },
    "healthcheck": {
      "additionalProperties": false,
      "properties": {
        "disable": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "retries": {
          "type": "number"
        },
        "test": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "timeout": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ipam_config": {
      "additionalProperties": false,
      "properties": {
        "aux_addresses": {
          "additionalProperties": false,
          "patternProperties": {
            "^.+$": {
              "type": "string"
            }
          },
          "type": "object"
        },
        "gateway": {
          "type": "string"
        },
        "ip_range": {
          "type": "string"
        },
        "subnet": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "labels": {
      "anyOf": [
        {
          "additionalProperties": false,
          "patternProperties": {
            ".+": {
              "type": "string"
            }
          },
          "type": "object"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        }
      ]
    },
    "list_of_strings": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "_uniqueItems": true
    },
    "list_or_dict": {
      "anyOf": [
        {
          "additionalProperties": false,
          "patternProperties": {
            ".+": {
              "type": [
                "string",
                "number",
                "null"
              ]
            }
          },
          "type": "object"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        }
      ]
    },
    "network": {
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string"
        },
        "driver_opts": {
          "patternProperties": {
            "^.+$": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "type": "object"
        },
        "enable_ipv6": {
          "type": "boolean"
        },
        "external": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "type": [
            "boolean",
            "object"
          ]
        },
        "internal": {
          "type": "boolean"
        },
        "ipam": {
          "additionalProperties": false,
          "properties": {
            "config": {
              "items": {
                "$ref": "#/$defs/ipam_config"
              },
              "type": "array"
            },
            "driver": {
              "type": "string"
            },
            "options": {
              "additionalProperties": false,
              "patternProperties": {
                "^.+$": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "name": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "service": {
      "additionalProperties": false,
      "dependentRequired": {
        "memswap_limit": [
          "mem_limit"
        ]
      },
      "properties": {
        "blkio_config": {
          "additionalProperties": false,
          "properties": {
            "device_read_bps": {
              "items": {
                "$ref": "#/$defs/blkio_limit"
              },
              "type": "array"
            },
            "device_read_iops": {
              "items": {
                "$ref": "#/$defs/blkio_limit"
              },
              "type": "array"
            },
            "device_write_bps": {
              "items": {
                "$ref": "#/$defs/blkio_limit"
              },
              "type": "array"
            },
            "device_write_iops": {
              "items": {
                "$ref": "#/$defs/blkio_limit"
              },
              "type": "array"
            },
            "weight": {
              "type": "integer"
            },
            "weight_device": {
              "items": {
                "$ref": "#/$defs/blkio_weight"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "args": {
                  "$ref": "#/$defs/list_or_dict"
                },
                "context": {
                  "type": "string"
                },
                "dockerfile": {
                  "type": "string"
                },
                "isolation": {
                  "type": "string"
                },
                "labels": {
                  "$ref": "#/$defs/labels"
                }
              },
              "type": "object"
            }
          ]
        },
        "cap_add": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "cap_drop": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "cgroup_parent": {
          "type": "string"
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "container_name": {
          "type": "string"
        },
        "cpu_period": {
          "type": [
            "number",
            "string"
          ]
        },
        "cpu_quota": {
          "type": [
            "number",
            "string"
          ]
        },
        "cpu_shares": {
          "type": [
            "number",
            "string"
          ]
        },
        "cpuset": {
          "type": "string"
        },
        "depends_on": {
          "anyOf": [
            {
              "$ref": "#/$defs/list_of_strings"
            },
            {
              "additionalProperties": false,
              "patternProperties": {
                "^[a-zA-Z0-9._-]+$": {
                  "additionalProperties": false,
                  "properties": {
                    "condition": {
                      "enum": [
                        "service_started",
                        "service_healthy"
                      ],
                      "type": "string"
                    }
                  },
                  "required": [
                    "condition"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            }
          ]
        },
        "devices": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "dns": {
          "$ref": "#/$defs/string_or_list"
        },
        "dns_opt": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "dns_search": {
          "$ref": "#/$defs/string_or_list"
        },
        "domainname": {
          "type": "string"
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "env_file": {
          "$ref": "#/$defs/string_or_list"
        },
        "environment": {
          "$ref": "#/$defs/list_or_dict"
        },
        "expose": {
          "items": {
            "format": "expose",
            "type": [
              "string",
              "number"
            ]
          },
          "type": "array",
          "_uniqueItems": true
        },
        "extends": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "file": {
                  "type": "string"
                },
                "service": {
                  "type": "string"
                }
              },
              "required": [
                "service"
              ],
              "type": "object"
            }
          ]
        },
        "external_links": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "extra_hosts": {
          "$ref": "#/$defs/list_or_dict"
        },
        "group_add": {
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": "array",
          "_uniqueItems": true
        },
        "healthcheck": {
          "$ref": "#/$defs/healthcheck"
        },
        "hostname": {
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "ipc": {
          "type": "string"
        },
        "isolation": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "links": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "logging": {
          "additionalProperties": false,
          "properties": {
            "driver": {
              "type": "string"
            },
            "options": {
              "type": "object"
            }
          },
          "type": "object"
        },
        "mac_address": {
          "type": "string"
        },
        "mem_limit": {
          "type": [
            "number",
            "string"
          ]
        },
        "mem_reservation": {
          "type": [
            "string",
            "integer"
          ]
        },
        "mem_swappiness": {
          "type": "integer"
        },
        "memswap_limit": {
          "type": [
            "number",
            "string"
          ]
        },
        "network_mode": {
          "type": "string"
        },
        "networks": {
          "anyOf": [
            {
              "$ref": "#/$defs/list_of_strings"
            },
            {
              "additionalProperties": false,
              "patternProperties": {
                "^[a-zA-Z0-9._-]+$": {
                  "anyOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "aliases": {
                          "$ref": "#/$defs/list_of_strings"
                        },
                        "ipv4_address": {
                          "type": "string"
                        },
                        "ipv6_address": {
                          "type": "string"
                        },
                        "link_local_ips": {
                          "$ref": "#/$defs/list_of_strings"
                        },
                        "priority": {
                          "type": "number"
                        }
                      },
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "type": "object"
            }
          ]
        },
        "oom_kill_disable": {
          "type": "boolean"
        },
        "oom_score_adj": {
          "maximum": 1000,
          "minimum": -1000,
          "type": "integer"
        },
        "pid": {
          "type": [
            "string",
            "null"
          ]
        },
        "pids_limit": {
          "type": [
            "number",
            "string"
          ]
        },
        "ports": {
          "items": {
            "format": "ports",
            "type": [
              "string",
              "number"
            ]
          },
          "type": "array",
          "_uniqueItems": true
        },
        "privileged": {
          "type": "boolean"
        },
        "read_only": {
          "type": "boolean"
        },
        "restart": {
          "type": "string"
        },
        "security_opt": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "shm_size": {
          "type": [
            "number",
            "string"
          ]
        },
        "stdin_open": {
          "type": "boolean"
        },
        "stop_grace_period": {
          "_format": "duration",
          "type": "string"
        },
        "stop_signal": {
          "type": "string"
        },
        "storage_opt": {
          "type": "object"
        },
        "sysctls": {
          "$ref": "#/$defs/list_or_dict"
        },
        "tmpfs": {
          "$ref": "#/$defs/string_or_list"
        },
        "tty": {
          "type": "boolean"
        },
        "ulimits": {
          "patternProperties": {
            "^[a-z]+$": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "hard": {
                      "type": "integer"
                    },
                    "soft": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "soft",
                    "hard"
                  ],
                  "type": "object"
                }
              ]
            }
          },
          "type": "object"
        },
        "user": {
          "type": "string"
        },
        "userns_mode": {
          "type": "string"
        },
        "volume_driver": {
          "type": "string"
        },
        "volumes": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "volumes_from": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "_uniqueItems": true
        },
        "working_dir": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "string_or_list": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/list_of_strings"
        }
      ]
    },
    "volume": {
      "additionalProperties": false,
      "properties": {
        "driver": {
          "type": "string"
        },
        "driver_opts": {
          "patternProperties": {
            "^.+$": {
              "type": [
                "string",
                "number"
              ]
            }
          },
          "type": "object"
        },
        "external": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "type": [
            "boolean",
            "object"
          ]
        },
        "labels": {
          "$ref": "#/$defs/labels"
        },
        "name": {
          "type": "string"
        }
      },
      "type": [
        "object",
        "null"
      ]
    }
  }
}
