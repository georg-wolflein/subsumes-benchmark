{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A MWF Image component's schema definition.",
  "title": "Image",
  "type": "object",
  "anyOf": [
    {
      "$ref": "#/$defs/picture-element"
    },
    {
      "$ref": "#/$defs/image-element"
    }
  ],
  "$defs": {
    "image-element": {
      "properties": {
        "content": {
          "properties": {
            "alt": {
              "type": "string"
            },
            "src": {
              "type": "string"
            }
          },
          "required": [
            "src",
            "alt"
          ],
          "type": "object"
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    },
    "picture-element": {
      "properties": {
        "content": {
          "properties": {
            "background-image": {
              "properties": {
                "alt": {
                  "type": "string"
                },
                "vp1": {
                  "type": "string"
                },
                "vp2": {
                  "type": "string"
                },
                "vp3": {
                  "type": "string"
                },
                "vp4": {
                  "type": "string"
                },
                "vp5": {
                  "type": "string"
                },
                "vp6": {
                  "type": "string"
                }
              },
              "required": [
                "alt",
                "vp1"
              ],
              "type": "object"
            }
          },
          "required": [
            "background-image"
          ],
          "type": "object"
        }
      },
      "required": [
        "content"
      ],
      "type": "object"
    }
  }
}
