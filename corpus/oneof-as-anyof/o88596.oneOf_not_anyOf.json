{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "anyOf",
    "oneOf",
    "patternProperties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o88596.oneOf_not_anyOf.json",
  "a": {
    "$id": "http://webmozart.io/fixtures/schema-refs",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "patternProperties": {
      "^[a-zA-Z]": {
        "anyOf": [
          {
            "$ref": "#/$defs/stringDefinition"
          },
          {
            "$ref": "#/$defs/booleanDefinition"
          }
        ]
      }
    },
    "additionalProperties": false,
    "$defs": {
      "stringDefinition": {
        "type": "string"
      },
      "booleanDefinition": {
        "type": "boolean"
      }
    }
  },
  "b": {
    "$id": "http://webmozart.io/fixtures/schema-refs",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "patternProperties": {
      "^[a-zA-Z]": {
        "oneOf": [
          {
            "$ref": "#/$defs/stringDefinition"
          },
          {
            "$ref": "#/$defs/booleanDefinition"
          }
        ]
      }
    },
    "additionalProperties": false,
    "$defs": {
      "stringDefinition": {
        "type": "string"
      },
      "booleanDefinition": {
        "type": "boolean"
      }
    }
  }
}
