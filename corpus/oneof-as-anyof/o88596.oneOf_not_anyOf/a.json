{
  "$id": "http://webmozart.io/fixtures/schema-refs",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "patternProperties": {
    "^[a-zA-Z]": {
      "anyOf": [
        {
          "$ref": "#/$defs/stringDefinition"
        },
        {
          "$ref": "#/$defs/booleanDefinition"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringDefinition": {
      "type": "string"
    },
    "booleanDefinition": {
      "type": "boolean"
    }
  }
}
