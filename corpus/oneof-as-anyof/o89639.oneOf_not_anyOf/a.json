{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "resource_type": {
          "enum": [
            "asset",
            "file"
          ],
          "type": "string"
        }
      },
      "required": [
        "resource_type",
        "path"
      ]
    },
    {
      "additionalProperties": false,
      "properties": {
        "family": {
          "type": "string"
        },
        "style": {
          "type": "string"
        }
      },
      "required": [
        "style"
      ]
    }
  ]
}
