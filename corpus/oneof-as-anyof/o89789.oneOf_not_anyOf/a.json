{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boolString",
  "description": "field that can be true, false, \"true\", or \"false\"",
  "anyOf": [
    {
      "type": "string",
      "enum": [
        "true",
        "false"
      ]
    },
    {
      "type": "boolean"
    }
  ]
}
