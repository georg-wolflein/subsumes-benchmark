{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "additionalProperties",
    "anyOf",
    "enum",
    "oneOf",
    "pattern",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/sat/o90249.anyOf_not_oneOf.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/oneOf_as_anyOf_containment/unknown/o90249.oneOf_not_anyOf.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ObjectSymbol3DLayer Resource",
    "type": "object",
    "description": "The primitive shape (primitive) or external 3D model (href) used to visualize the points.",
    "properties": {
      "href": {
        "oneOf": [
          {
            "type": "string",
            "description": "An absolute URL",
            "pattern": "^https?://.+$"
          },
          {
            "type": "string",
            "description": "A relative path starting with ./",
            "pattern": "^\\./.+$"
          }
        ]
      },
      "primitive": {
        "type": "string",
        "enum": [
          "cone",
          "cube",
          "cylinder",
          "diamond",
          "invertedCone",
          "sphere",
          "tetrahedron"
        ]
      }
    },
    "oneOf": [
      {
        "required": [
          "primitive"
        ]
      },
      {
        "required": [
          "href"
        ]
      }
    ],
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "ObjectSymbol3DLayer Resource",
    "type": "object",
    "description": "The primitive shape (primitive) or external 3D model (href) used to visualize the points.",
    "properties": {
      "href": {
        "anyOf": [
          {
            "type": "string",
            "description": "An absolute URL",
            "pattern": "^https?://.+$"
          },
          {
            "type": "string",
            "description": "A relative path starting with ./",
            "pattern": "^\\./.+$"
          }
        ]
      },
      "primitive": {
        "type": "string",
        "enum": [
          "cone",
          "cube",
          "cylinder",
          "diamond",
          "invertedCone",
          "sphere",
          "tetrahedron"
        ]
      }
    },
    "additionalProperties": false,
    "anyOf": [
      {
        "required": [
          "primitive"
        ]
      },
      {
        "required": [
          "href"
        ]
      }
    ]
  }
}
