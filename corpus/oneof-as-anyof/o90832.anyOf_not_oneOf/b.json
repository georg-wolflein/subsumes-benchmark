{
  "$id": "http://thrift.apache.org/schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for Apache Thrift protocol descriptors",
  "type": "object",
  "required": [
    "name",
    "enums",
    "typedefs",
    "structs",
    "constants",
    "services"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "_uniqueItems": true
    },
    "namespaces": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "enums": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/enum"
      }
    },
    "typedefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/typedef"
      }
    },
    "structs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/struct"
      }
    },
    "constants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constant"
      }
    },
    "services": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "type-id": {
      "title": "Any type id (name)",
      "enum": [
        "void",
        "string",
        "bool",
        "byte",
        "i8",
        "i16",
        "i32",
        "i64",
        "double",
        "list",
        "set",
        "map",
        "union",
        "struct",
        "binary"
      ]
    },
    "base-type": {
      "title": "Base type schema",
      "type": "object",
      "properties": {
        "typeId": {
          "enum": [
            "void",
            "string",
            "bool",
            "byte",
            "i8",
            "i16",
            "i32",
            "i64",
            "double",
            "binary"
          ]
        }
      },
      "required": [
        "typeId"
      ]
    },
    "list-type": {
      "title": "List and set schema",
      "type": "object",
      "properties": {
        "typeId": {
          "enum": [
            "list",
            "set"
          ]
        },
        "elemTypeId": {
          "$ref": "#/$defs/type-id"
        },
        "elemType": {
          "$ref": "#/$defs/type-desc"
        }
      },
      "required": [
        "typeId",
        "elemTypeId"
      ]
    },
    "map-type": {
      "title": "Map schema",
      "type": "object",
      "properties": {
        "typeId": {
          "enum": [
            "map"
          ]
        },
        "keyTypeId": {
          "$ref": "#/$defs/type-id"
        },
        "keyType": {
          "$ref": "#/$defs/type-desc"
        },
        "valueTypeId": {
          "$ref": "#/$defs/type-id"
        },
        "valueType": {
          "$ref": "#/$defs/type-desc"
        }
      },
      "required": [
        "typeId",
        "keyTypeId",
        "valueTypeId"
      ]
    },
    "struct-type": {
      "title": "Struct, union and exception schema",
      "type": "object",
      "properties": {
        "typeId": {
          "enum": [
            "union",
            "struct",
            "exception"
          ]
        }
      },
      "required": [
        "typeId",
        "class"
      ]
    },
    "type-desc": {
      "title": "Type descriptor schema",
      "allOf": [
        {
          "type": "object",
          "properties": {
            "typeId": {
              "type": "string"
            },
            "class": {
              "type": "string"
            }
          }
        },
        {
          "anyOf": [
            {
              "$ref": "#/$defs/base-type"
            },
            {
              "$ref": "#/$defs/list-type"
            },
            {
              "$ref": "#/$defs/map-type"
            },
            {
              "$ref": "#/$defs/struct-type"
            }
          ]
        }
      ]
    },
    "name-and-doc": {
      "title": "Name and documentation sub-schema",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "doc": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "enum": {
      "title": "Thrift 'enum' definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "required": [
            "members"
          ],
          "properties": {
            "members": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "value": {
                    "type": "integer"
                  }
                },
                "required": [
                  "name",
                  "value"
                ]
              }
            }
          }
        }
      ]
    },
    "typedef": {
      "title": "Thrift typedef definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "typeId": {
              "$ref": "#/$defs/type-id"
            },
            "type": {
              "$ref": "#/$defs/type-desc"
            }
          },
          "required": [
            "typeId"
          ]
        }
      ]
    },
    "constant": {
      "title": "Thrift constant definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "$ref": "#/$defs/type-desc"
        },
        {
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "array"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "value"
          ]
        }
      ]
    },
    "field": {
      "title": "Thrift struct field definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "key": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "required": {
              "enum": [
                "required",
                "optional",
                "req_out"
              ]
            },
            "typeId": {
              "$ref": "#/$defs/type-id"
            },
            "type": {
              "$ref": "#/$defs/type-desc"
            },
            "default": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "array"
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "required": [
            "key",
            "required"
          ]
        }
      ]
    },
    "struct": {
      "title": "Thrift struct definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "isException": {
              "type": "boolean"
            },
            "isUnion": {
              "type": "boolean"
            },
            "fields": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            }
          },
          "required": [
            "isException",
            "isUnion",
            "fields"
          ]
        }
      ]
    },
    "union": {
      "title": "Thrift union definition schema",
      "$ref": "#/$defs/struct"
    },
    "exception": {
      "title": "Thrift exception definition schema",
      "type": "object",
      "properties": {
        "key": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "name": {
          "type": "string"
        },
        "typeId": {
          "enum": [
            "exception"
          ]
        },
        "type": {
          "$ref": "#/$defs/struct-type"
        }
      },
      "required": [
        "key",
        "name",
        "typeId"
      ]
    },
    "function": {
      "title": "Thrift service function definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "oneway": {
              "type": "boolean"
            },
            "returnType": {
              "$ref": "#/$defs/type-desc"
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/field"
              }
            },
            "exceptions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/exception"
              }
            }
          },
          "required": [
            "oneway",
            "arguments",
            "exceptions"
          ]
        }
      ]
    },
    "service": {
      "title": "Thrift service definition schema",
      "type": "object",
      "allOf": [
        {
          "$ref": "#/$defs/name-and-doc"
        },
        {
          "properties": {
            "functions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/function"
              }
            }
          },
          "required": [
            "functions"
          ]
        }
      ]
    },
    "annotations": {
      "title": "Map of annotation names to values",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
