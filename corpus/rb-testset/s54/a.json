{
  "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/utils/content_element.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "An element that can be listed as part of content elements",
  "description": "An item that conforms to this schema can be rendered in a sequence",
  "type": "object",
  "additionalProperties": {},
  "properties": {
    "type": {
      "type": "string"
    },
    "_id": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_id.json#"
    },
    "subtype": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_subtype.json#"
    },
    "channels": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_channel.json#"
    },
    "alignment": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_alignment.json#"
    },
    "additional_properties": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_additional_properties.json#"
    }
  },
  "required": [
    "type"
  ],
  "$defs": {
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_additional_properties.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_additional_properties.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Has additional properties",
      "description": "A grab-bag object for non-validatable data.",
      "type": "object",
      "additionalProperties": {}
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_alignment.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_alignment.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Alignment",
      "type": "string",
      "description": "A property used to determine horizontal positioning of a content element relative to the elements that immediately follow it in the element sequence.",
      "enum": [
        "left",
        "right",
        "center"
      ]
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_channel.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_channel.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Channel trait",
      "description": "An optional list of output types for which this element should be visible",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_id.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_id.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Globally Unique ID trait",
      "description": "A globally unique identifier of the content in the ANS repository.",
      "type": "string"
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_subtype.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.7.0/traits/trait_subtype.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Subtype trait",
      "type": "string",
      "description": "A more granular type than story, gallery, etc. (E.g., column, blog_post)"
    }
  }
}
