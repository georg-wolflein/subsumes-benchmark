  "description": "An html content element",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "enum": [
        "raw_html"
      ]
    },
    "_id": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_id.json#"
    },
    "subtype": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_subtype.json#"
    },
    "channels": {
      "$ref": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_channel.json#"
    },
    "alignment": {
