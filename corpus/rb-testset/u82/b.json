    "content"
  ],
  "$defs": {
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_additional_properties.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_additional_properties.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Has additional properties",
      "description": "A grab-bag object for non-validatable data.",
      "type": "object",
      "additionalProperties": {}
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_alignment.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_alignment.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Alignment",
      "type": "string",
      "description": "A property used to determine horizontal positioning of a content element relative to the elements that immediately follow it in the element sequence.",
      "enum": [
        "left",
        "right",
        "center"
      ]
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_channel.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_channel.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Channel trait",
      "description": "An optional list of output types for which this element should be visible",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_id.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_id.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Globally Unique ID trait",
      "description": "A globally unique identifier of the content in the ANS repository.",
      "type": "string"
    },
    "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_subtype.json": {
      "$id": "https://raw.githubusercontent.com/washingtonpost/ans-schema/master/src/main/resources/schema/ans/0.9.0/traits/trait_subtype.json",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Subtype or Template",
      "type": "string",
      "description": "A user-defined categorization method to supplement type. In Arc, this field is reserved for organization-defined purposes, such as selecting the PageBuilder template that should be used to render a document."
    }
