{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "additionalProperties",
    "enum",
    "items",
    "minLength",
    "properties",
    "propertyNames",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/schemastore_containment/sat/cdk_v1_not_v2.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Schema for AWS CDK context files (cdk.json)",
    "type": "object",
    "properties": {
      "app": {
        "type": "string",
        "minLength": 1
      },
      "build": {
        "type": "string"
      },
      "versionReporting": {
        "type": "boolean"
      },
      "watch": {
        "type": "object",
        "properties": {
          "include": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exclude": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "context": {
        "type": "object"
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Schema for AWS CDK context files (cdk.json)",
    "type": "object",
    "properties": {
      "app": {
        "type": "string",
        "minLength": 1
      },
      "context": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        },
        "propertyNames": {
          "type": "string",
          "enum": [
            "@aws-cdk-containers/ecs-service-extensions:enableDefaultLogDriver",
            "@aws-cdk/aws-apigateway:usagePlanKeyOrderInsensitiveId",
            "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021",
            "@aws-cdk/aws-ec2:uniqueImdsv2TemplateName",
            "@aws-cdk/aws-ecr-assets:dockerIgnoreSupport",
            "@aws-cdk/aws-ecs-patterns:removeDefaultDesiredCount",
            "@aws-cdk/aws-efs:defaultEncryptionAtRest",
            "@aws-cdk/aws-iam:minimizePolicies",
            "@aws-cdk/aws-kms:defaultKeyPolicies",
            "@aws-cdk/aws-lambda:recognizeVersionProps",
            "@aws-cdk/aws-rds:lowercaseDbIdentifier",
            "@aws-cdk/aws-s3:grantWriteWithoutAcl",
            "@aws-cdk/aws-secretsmanager:parseOwnedSecretName",
            "@aws-cdk/core:enableStackNameDuplicates",
            "@aws-cdk/core:stackRelativeExports",
            "aws-cdk:enableDiffNoFail"
          ]
        }
      }
    }
  }
}
