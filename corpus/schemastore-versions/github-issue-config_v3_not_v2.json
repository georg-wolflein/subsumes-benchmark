{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "additionalProperties",
    "items",
    "minItems",
    "minLength",
    "pattern",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/schemastore_containment/unknown/github-issue-config_v3_not_v2.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "https://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
    "title": "GitHub issue template chooser configuration",
    "description": "You can customize the issue template chooser that people see when creating a new issue in your repository.",
    "type": "object",
    "properties": {
      "blank_issues_enabled": {
        "description": "Specify whether allow contributors to create blank issues or not.",
        "type": "boolean"
      },
      "contact_links": {
        "description": "Link to places outside of GitHub where you'd prefer certain reports or discussion take place.",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "description": "The name or title of the link.",
              "type": "string",
              "minLength": 1,
              "examples": [
                "Sample name"
              ]
            },
            "url": {
              "description": "The URL this link goes to.",
              "type": "string",
              "pattern": "^https?://",
              "examples": [
                "https://sample/url"
              ]
            },
            "about": {
              "description": "A short text description of the link.",
              "type": "string",
              "minLength": 1,
              "examples": [
                "Sample description"
              ]
            }
          },
          "required": [
            "name",
            "url",
            "about"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$comment": "https://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
    "title": "GitHub issue template chooser config file schema",
    "type": "object",
    "properties": {
      "blank_issues_enabled": {
        "description": "Specify whether allow blank issue creation\nhttps://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
        "type": "boolean"
      },
      "contact_links": {
        "title": "contact links",
        "description": "Contact links\nhttps://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "name",
            "url",
            "about"
          ],
          "properties": {
            "name": {
              "description": "A link title\nhttps://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
              "type": "string",
              "minLength": 1,
              "examples": [
                "Sample name"
              ]
            },
            "url": {
              "description": "A link URL\nhttps://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
              "type": "string",
              "pattern": "^https?://",
              "examples": [
                "https://sample/url"
              ]
            },
            "about": {
              "description": "A link description\nhttps://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository#configuring-the-template-chooser",
              "type": "string",
              "minLength": 1,
              "examples": [
                "Sample description"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
