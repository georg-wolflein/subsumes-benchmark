{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "items",
    "minItems",
    "minLength",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/schemastore_containment/sat/imageoptimizer_v4_not_v3.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Schema for imageoptimizer.json files",
    "type": "object",
    "properties": {
      "optimizations": {
        "description": "An array of optimization rules",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "includes"
          ],
          "properties": {
            "includes": {
              "description": "An array of globbing patterns of files/folders to include in the optimization",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excludes": {
              "description": "An array of globbing patterns of files/folders to exclude in the optimization",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "node_modules",
                "bower_components",
                "jspm_packages"
              ]
            },
            "lossy": {
              "description": "When set to true, images are compressed a lot more but with a slight quality loss that may not be visible to the human eye.",
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "warmupTime": {
        "description": "Number of seconds to wait from the WebJob starts until it starts processing the file system",
        "type": "integer",
        "default": 60
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Schema for imageoptimizer.json files",
    "type": "object",
    "properties": {
      "optimizations": {
        "description": "An array of optimization rules",
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "includes"
          ],
          "properties": {
            "includes": {
              "description": "An array of globbing patterns of files/folders to include in the optimization",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "excludes": {
              "description": "An array of globbing patterns of files/folders to exclude in the optimization",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "default": [
                "node_modules",
                "bower_components",
                "jspm_packages"
              ]
            },
            "lossy": {
              "description": "When set to true, images are compressed a lot more but with a slight quality loss that may not be visible to the human eye.",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  }
}
