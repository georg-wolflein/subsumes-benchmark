{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON Schema for mime type collections",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {
    "^\\..+": {
      "description": "A file extension mapping.",
      "pattern": "^[\\w\\-_.]+/[\\w\\-_.]+$"
    }
  }
}
