{
  "$id": "https://json.schemastore.org/pgap_yaml_input_reader",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "$defs": {},
  "description": "NCBI Prokaryotic Genome Annotation Pipeline (PGAP) input metadata (submol) JSON/YAML configuration file",
  "required": [
    "authors",
    "contact_info"
  ],
  "properties": {
    "consortium": {
      "type": "string",
      "title": "The Consortium Schema ",
      "default": "",
      "examples": [
        "SkyNet"
      ]
    },
    "comment": {
      "type": "string",
      "title": "The Comment Schema ",
      "default": "",
      "examples": [
        "This draft WGS assembly was generated by running SKESA to  generate a de-novo assembly. The de-novo assembly was then concatenated with  contigs generated using a guided assembler using antimicrobial resistance genes as baits to comprehensively catalog the set of resistance genes in the isolate. Note, some parts of the contigs derived from the guided assembler may overlap de-novo contigs, and other guided assembler contigs. De-novo contigs can be differentiated from guided assembler contigs by their names, which include either 'denovo' or 'guided'."
      ]
    },
    "tp_assembly": {
      "type": "boolean",
      "title": "The Third Party Assembly Schema ",
      "default": false,
      "examples": [
        false
      ]
    },
    "sra": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "accession"
        ],
        "properties": {
          "accession": {
            "title": "The Accession Schema ",
            "type": "string",
            "default": "",
            "examples": [
              "SRR8796989"
            ]
          }
        }
      }
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "author"
        ],
        "properties": {
          "author": {
            "type": "object",
            "required": [
              "first_name",
              "last_name"
            ],
            "properties": {
              "first_name": {
                "type": "string",
                "title": "The First_name Schema ",
                "default": "",
                "examples": [
                  "Arnold"
                ]
              },
              "last_name": {
                "type": "string",
                "title": "The Last_name Schema ",
                "default": "",
                "examples": [
                  "Schwarzenegger"
                ]
              },
              "middle_initial": {
                "type": "string",
                "title": "The Middle_initial Schema ",
                "default": "",
                "examples": [
                  "T800"
                ]
              }
            }
          }
        }
      }
    },
    "bioproject": {
      "type": "string",
      "title": "The Bioproject Schema ",
      "default": "",
      "examples": [
        "PRJ9999999"
      ]
    },
    "biosample": {
      "type": "string",
      "title": "The Biosample Schema ",
      "default": "",
      "examples": [
        "SAMN99999999"
      ]
    },
    "contact_info": {
      "type": "object",
      "required": [
        "organization",
        "department",
        "city",
        "country",
        "street",
        "email",
        "first_name",
        "last_name",
        "postal_code"
      ],
      "properties": {
        "state": {
          "type": "string",
          "title": "The State Schema ",
          "default": "",
          "examples": [
            "MD",
            "Florida"
          ]
        },
        "fax": {
          "type": "string",
          "title": "The Fax Schema ",
          "default": "",
          "examples": [
            "301-555-1234",
            "+7 095 555 1234"
          ]
        },
        "city": {
          "type": "string",
          "title": "The City Schema ",
          "default": "",
          "examples": [
            "Docker"
          ]
        },
        "country": {
          "type": "string",
          "title": "The Country Schema ",
          "default": "",
          "examples": [
            "Lappland"
          ]
        },
        "department": {
          "type": "string",
          "title": "The Department Schema ",
          "default": "",
          "examples": [
            "Department of Using NCBI"
          ]
        },
        "email": {
          "type": "string",
          "title": "The Email Schema ",
          "default": "",
          "examples": [
            "jane_doe@gmail.com"
          ]
        },
        "first_name": {
          "type": "string",
          "title": "The First_name Schema ",
          "default": "",
          "examples": [
            "Jane"
          ]
        },
        "middle_initial": {
          "type": "string",
          "title": "The Middle_initial Schema ",
          "default": "",
          "examples": [
            "N"
          ]
        },
        "last_name": {
          "type": "string",
          "title": "The Last_name Schema ",
          "default": "",
          "examples": [
            "Doe"
          ]
        },
        "organization": {
          "type": "string",
          "title": "The Organization Schema ",
          "default": "",
          "examples": [
            "Institute of Klebsiella foobarensis research"
          ]
        },
        "phone": {
          "type": "string",
          "title": "The Phone Schema ",
          "default": "",
          "examples": [
            "301-555-0245"
          ]
        },
        "postal_code": {
          "type": "string",
          "title": "The Postal_code Schema ",
          "default": "",
          "examples": [
            "12345"
          ]
        },
        "street": {
          "type": "string",
          "title": "The Street Schema ",
          "default": "",
          "examples": [
            "1234 Main St"
          ]
        }
      }
    },
    "fasta": {
      "type": "object",
      "properties": {
        "class": {
          "type": "string",
          "title": "The Class Schema ",
          "default": "",
          "examples": [
            "File"
          ]
        },
        "location": {
          "type": "string",
          "title": "The Location Schema ",
          "default": "",
          "examples": [
            "sample_fasta_input.fasta"
          ]
        }
      }
    },
    "locus_tag_prefix": {
      "type": "string",
      "title": "The Locus_tag_prefix Schema ",
      "default": "",
      "examples": [
        "tmp"
      ]
    },
    "organism": {
      "type": "object",
      "properties": {
        "strain": {
          "type": "string",
          "title": "The Strain Schema ",
          "default": "",
          "examples": [
            "my_strain"
          ]
        },
        "genus_species": {
          "type": "string",
          "title": "The Genus Species Schema ",
          "default": "",
          "examples": [
            "Escherichia coli"
          ]
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "publication"
        ],
        "properties": {
          "publication": {
            "type": "object",
            "properties": {
              "authors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "author": {
                      "type": "object",
                      "required": [
                        "first_name",
                        "last_name"
                      ],
                      "properties": {
                        "first_name": {
                          "type": "string",
                          "title": "The First_name Schema ",
                          "default": "",
                          "examples": [
                            "Arnold"
                          ]
                        },
                        "last_name": {
                          "type": "string",
                          "title": "The Last_name Schema ",
                          "default": "",
                          "examples": [
                            "Schwarzenegger"
                          ]
                        },
                        "middle_initial": {
                          "type": "string",
                          "title": "The Middle_initial Schema ",
                          "default": "",
                          "examples": [
                            "T800"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "status": {
                "type": "string",
                "title": "The Status Schema ",
                "default": "",
                "enum": [
                  "published",
                  "in-press",
                  "unpublished"
                ]
              },
              "pmid": {
                "type": "integer",
                "title": "The Status Schema ",
                "default": ""
              },
              "title": {
                "type": "string",
                "title": "The Title Schema ",
                "default": "",
                "examples": [
                  "Discrete CHARMm of Klebsiella foobarensis. Journal of Improbable Results, vol. 34, issue 13, pages: 10001-100005, 2018"
                ]
              }
            }
          }
        }
      }
    },
    "topology": {
      "type": "string",
      "title": "The Topology Schema ",
      "default": "",
      "examples": [
        "circular",
        "linear"
      ]
    }
  }
}
