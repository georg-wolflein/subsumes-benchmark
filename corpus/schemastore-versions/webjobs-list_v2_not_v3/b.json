{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JSON schema for Azure Webjobs collection files",
  "type": "object",
  "required": [
    "WebJobs"
  ],
  "properties": {
    "WebJobs": {
      "type": "array",
      "description": "A list of Azure Webjobs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "filePath": {
            "type": "string"
          }
        }
      }
    }
  }
}
