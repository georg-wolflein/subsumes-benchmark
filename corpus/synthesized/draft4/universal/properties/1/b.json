{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "properties": {
        "bar": {
          "type": "string"
        },
        "foo": {
          "type": "integer"
        }
      }
    },
    {
      "not": {
        "properties": {
          "bar": {
            "type": "string"
          },
          "foo": {
            "type": "integer"
          }
        }
      }
    }
  ]
}
