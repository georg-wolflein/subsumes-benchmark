{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "allOf": [
                {
                  "prefixItems": [
                    {
                      "const": "foo"
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "prefixItems": [
                        true,
                        {
                          "const": "bar"
                        }
                      ]
                    },
                    {
                      "prefixItems": [
                        true,
                        true,
                        {
                          "const": "then"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "prefixItems": [
                true,
                true,
                true
              ],
              "items": {
                "anyOf": [
                  false,
                  false
                ]
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "allOf": [
                {
                  "prefixItems": [
                    {
                      "const": "foo"
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "not": {
                        "prefixItems": [
                          true,
                          {
                            "const": "bar"
                          }
                        ]
                      }
                    },
                    {
                      "prefixItems": [
                        true,
                        true,
                        true,
                        {
                          "const": "else"
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "prefixItems": [
                true,
                true,
                true,
                true
              ],
              "items": {
                "anyOf": [
                  false,
                  false
                ]
              }
            }
          ]
        }
      ]
