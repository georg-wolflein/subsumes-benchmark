{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "prefixItems": [
                {
                  "const": "a"
                }
              ]
            },
            {
              "prefixItems": [
                true
              ],
              "items": {
                "anyOf": [
                  false,
                  false
                ]
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "not": {
                "prefixItems": [
                  {
                    "const": "a"
                  }
                ]
              }
            },
            {
              "items": {
                "anyOf": [
                  false,
                  false
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
