{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "asl-help.settings-condensed",
  "description": "Provides some settings that can be loaded by asl-help.",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/modern_1"
  },
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "array"
                },
                {
                  "minItems": 1,
                  "maxItems": 2,
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                }
              ]
            },
            {
              "prefixItems": [
                true
              ],
              "items": {
                "anyOf": [
                  false,
                  {
                    "$ref": "#"
                  }
                ]
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "array"
                },
                {
                  "minItems": 2,
                  "maxItems": 3,
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                }
              ]
            },
            {
              "prefixItems": [
                true,
                true
              ],
              "items": {
                "anyOf": [
                  false,
                  {
                    "$ref": "#"
                  }
                ]
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "array"
                },
                {
                  "minItems": 3,
                  "maxItems": 4,
                  "prefixItems": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "string",
                      "minLength": 1
                    }
                  ]
                }
              ]
            },
            {
              "prefixItems": [
                true,
                true,
                true
              ],
              "items": {
                "anyOf": [
                  false,
                  {
                    "$ref": "#"
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  }
}
