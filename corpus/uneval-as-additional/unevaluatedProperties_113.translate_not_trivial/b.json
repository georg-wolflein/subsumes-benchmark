{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Validator",
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "edtf",
                    "edtf_year",
                    "geometry_point",
                    "list",
                    "regex",
                    "required",
                    "table"
                  ]
                },
                "allowed_values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "regex": {
                  "type": "string"
                },
                "error_message": {
                  "type": "string"
                }
              },
              "allOf": [
                {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "properties": {
                            "type": {
                              "const": "list"
                            }
                          }
                        },
                        {
                          "required": [
                            "allowed_values"
                          ]
                        }
                      ]
                    },
                    {
                      "not": {
                        "properties": {
                          "type": {
                            "const": "list"
                          }
                        }
                      }
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "allOf": [
                        {
                          "properties": {
                            "type": {
                              "const": "regex"
                            }
                          }
                        },
                        {
                          "required": [
                            "regex"
                          ]
                        }
                      ]
                    },
                    {
                      "not": {
                        "properties": {
                          "type": {
                            "const": "regex"
                          }
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^type$": true,
                "^allowed_values$": true,
                "^regex$": true,
                "^error_message$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
