{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "fragment": {
                  "type": "object",
                  "properties": {
                    "constant": {
                      "type": "boolean"
                    },
                    "name": {
                      "type": "string"
                    },
                    "outputs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "internalType": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "payable": {
                      "type": "boolean"
                    },
                    "inputs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "internalType": {
                            "type": "string"
                          },
                          "type": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "stateMutability": {
                      "type": "string"
                    },
                    "type": {
                      "enum": [
                        "function"
                      ]
                    }
                  },
                  "required": [
                    "inputs",
                    "name",
                    "outputs",
                    "stateMutability",
                    "type"
                  ],
                  "nullable": true,
                  "additionalProperties": false
                },
                "builder": {
                  "type": "string",
                  "pattern": "^0x[a-fA-F0-9]{40}$"
                },
                "version": {
                  "enum": [
                    "0.1.0"
                  ]
                },
                "transaction": {
                  "type": "object",
                  "properties": {
                    "from": {
                      "type": "string",
                      "pattern": "^0x[a-fA-F0-9]{40}$",
                      "nullable": true
                    },
                    "to": {
                      "type": "string",
                      "pattern": "^0x[a-fA-F0-9]{40}$"
                    },
                    "data": {
                      "type": "string",
                      "pattern": "^0x[a-fA-F0-9]+$"
                    }
                  },
                  "required": [
                    "to",
                    "data"
                  ],
                  "additionalProperties": false
                },
                "protocol": {
                  "enum": [
                    "buidltxn"
                  ]
                }
              },
              "required": [
                "protocol",
                "version",
                "builder",
                "transaction"
              ]
            },
            {
              "patternProperties": {
                "^version$": true,
                "^protocol$": true,
                "^builder$": true,
                "^fragment$": true,
                "^transaction$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
