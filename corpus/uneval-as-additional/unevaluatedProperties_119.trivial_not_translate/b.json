    "transaction": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$",
          "nullable": true
        },
        "to": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]{40}$"
        },
        "data": {
          "type": "string",
          "pattern": "^0x[a-fA-F0-9]+$"
        }
      },
      "required": [
        "to",
        "data"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocol",
    "version",
    "builder",
    "transaction"
  ],
  "additionalProperties": false
}
