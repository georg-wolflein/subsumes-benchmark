{
  "$id": "https://json.schemastore.org/azure-deviceupdate-rootkeypackage-1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protected": {
      "type": "object",
      "properties": {
        "disabledSigningKeys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signingKeyHashDef"
          }
        },
        "published": {
          "type": "number"
        },
        "isTest": {
          "type": "boolean"
        },
        "disabledRootKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rootKeys": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "$ref": "#/$defs/rootKeyDef"
            }
          }
        },
        "version": {
          "type": "number"
        }
      }
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "alg": {
            "enum": [
              "RS256",
              "RS384",
              "RS512"
            ]
          },
          "sig": {
            "type": "string"
          }
        },
        "uniqueItems": true
      }
    }
  },
  "required": [
    "protected",
    "signatures"
  ],
  "$defs": {
    "rootKeyDef": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "object"
                },
                {
                  "properties": {
                    "keyType": {
                      "enum": [
                        "RSA"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "keyType"
                  ]
                },
                {
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "keyType": {
                          "const": "RSA"
                        }
                      }
                    },
                    {
                      "properties": {
                        "n": {
                          "type": "string"
                        },
                        "e": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "n",
                        "e"
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^keyType$": true,
                "^n$": true,
                "^e$": true
              },
              "additionalProperties": true
            }
          ]
        },
        {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "object"
                },
                {
                  "properties": {
                    "keyType": {
                      "enum": [
                        "RSA"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "keyType"
                  ]
                },
                {
                  "not": {
                    "type": "object",
                    "properties": {
                      "keyType": {
                        "const": "RSA"
                      }
                    }
                  }
                }
              ]
            },
            {
              "patternProperties": {
                "^keyType$": true
              },
              "additionalProperties": true
            }
          ]
        }
      ]
    },
    "signingKeyHashDef": {
      "type": "object",
      "properties": {
        "alg": {
          "enum": [
            "SHA256",
            "SHA384",
            "SHA512"
          ]
        },
        "hash": {
          "type": "string"
        }
      }
    }
  }
}
