{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Menu Cache Properties",
              "lightning:type": "lightning__objectType",
              "properties": {
                "cacheName": {
                  "lightning:type": "lightning__textType",
                  "title": "Cache Name"
                },
                "cacheKey": {
                  "lightning:type": "lightning__textType",
                  "title": "Cache Key"
                },
                "cacheEnabled": {
                  "lightning:type": "lightning__booleanType",
                  "title": "Cache Enabled"
                }
              },
              "required": []
            },
            {
              "patternProperties": {
                "^cacheName$": true,
                "^cacheKey$": true,
                "^cacheEnabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
