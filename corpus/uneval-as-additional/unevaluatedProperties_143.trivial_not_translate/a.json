{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "number": {
                  "type": "number"
                },
                "street_name": {
                  "type": "string"
                },
                "street_type": {
                  "enum": [
                    "Street",
                    "Avenue",
                    "Boulevard"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^number$": true,
                "^street_name$": true,
                "^street_type$": true
              },
              "additionalProperties": {
                "type": "boolean"
              }
            }
          ]
        }
      ]
    }
  }
}
