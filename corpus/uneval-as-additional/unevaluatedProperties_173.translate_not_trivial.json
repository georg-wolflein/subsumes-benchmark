{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/sat/unevaluatedProperties_173.translate_not_trivial.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/bar",
    "properties": {
      "foo": {
        "type": "string"
      }
    },
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "bar": {
        "properties": {
          "bar": {
            "type": "string"
          }
        }
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "$ref": "#/$defs/bar",
                "properties": {
                  "foo": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^bar$": true,
                  "^foo$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "bar": {
        "properties": {
          "bar": {
            "type": "string"
          }
        }
      }
    }
  }
}
