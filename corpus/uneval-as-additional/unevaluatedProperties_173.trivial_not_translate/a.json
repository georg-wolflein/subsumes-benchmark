{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/bar",
              "properties": {
                "foo": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^bar$": true,
                "^foo$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "bar": {
      "properties": {
        "bar": {
          "type": "string"
        }
      }
    }
  }
}
