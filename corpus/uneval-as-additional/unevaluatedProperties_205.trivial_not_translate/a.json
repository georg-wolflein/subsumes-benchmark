{
  "$id": "std:destructionLevel",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "Standart Destruction Level",
              "description": "This extension is used to describe the degree of deletion. Five different levels of deletion are offered.",
              "$comment": "The Interpreter must check if it supports the methods in the destructionLevel enumeration.",
              "type": "object",
              "required": [
                "destructionLevel"
              ],
              "properties": {
                "destructionLevel": {
                  "type": "string",
                  "enum": [
                    "recycled",
                    "deleted",
                    "metadata destroyed",
                    "wiped",
                    "physically destroyed"
                  ]
                }
              }
            },
            {
              "patternProperties": {
                "^destructionLevel$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
