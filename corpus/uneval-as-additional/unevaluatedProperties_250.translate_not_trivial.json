{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_250.translate_not_trivial.json",
  "duplicates": [
    "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_250.trivial_not_translate.json"
  ],
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Configuration for storing extraction progress either locally or in CDF Raw",
    "type": "object",
    "properties": {
      "raw": {
        "type": "object",
        "additionalProperties": false,
        "description": "Store state in a Raw table",
        "required": [
          "database",
          "table"
        ],
        "properties": {
          "database": {
            "type": "string",
            "description": "Raw database"
          },
          "table": {
            "type": "string",
            "description": "Raw table"
          },
          "upload-interval": {
            "type": "integer",
            "description": "Interval in seconds between each upload of state to Raw",
            "default": 30
          }
        }
      },
      "local": {
        "type": "object",
        "additionalProperties": false,
        "description": "Store state in a local JSON file",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "Path to JSON file"
          },
          "save-interval": {
            "type": "integer",
            "description": "Interval in seconds between each time state is saved",
            "default": 30
          }
        }
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Configuration for storing extraction progress either locally or in CDF Raw",
    "type": "object",
    "properties": {
      "raw": {
        "$ref": "#/$defs/modern_1"
      },
      "local": {
        "$ref": "#/$defs/modern_2"
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Store state in a Raw table",
                "required": [
                  "database",
                  "table"
                ],
                "properties": {
                  "database": {
                    "type": "string",
                    "description": "Raw database"
                  },
                  "table": {
                    "type": "string",
                    "description": "Raw table"
                  },
                  "upload-interval": {
                    "type": "integer",
                    "description": "Interval in seconds between each upload of state to Raw",
                    "default": 30
                  }
                }
              },
              {
                "patternProperties": {
                  "^database$": true,
                  "^table$": true,
                  "^upload-interval$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Store state in a local JSON file",
                "required": [
                  "path"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "Path to JSON file"
                  },
                  "save-interval": {
                    "type": "integer",
                    "description": "Interval in seconds between each time state is saved",
                    "default": 30
                  }
                }
              },
              {
                "patternProperties": {
                  "^path$": true,
                  "^save-interval$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
