{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_294.translate_not_trivial.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "number": {
        "type": "number"
      },
      "street_name": {
        "type": "string"
      },
      "street_type": {
        "enum": [
          "Street",
          "Avenue",
          "Boulevard"
        ]
      }
    },
    "additionalProperties": false
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "number": {
                    "type": "number"
                  },
                  "street_name": {
                    "type": "string"
                  },
                  "street_type": {
                    "enum": [
                      "Street",
                      "Avenue",
                      "Boulevard"
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^number$": true,
                  "^street_name$": true,
                  "^street_type$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
