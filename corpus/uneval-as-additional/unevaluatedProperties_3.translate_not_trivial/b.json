{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "allOf": [
                {
                  "type": "object",
                  "properties": {
                    "street_address": {
                      "type": "string"
                    },
                    "city": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "street_address",
                    "city",
                    "state"
                  ]
                }
              ],
              "properties": {
                "type": {
                  "enum": [
                    "residential",
                    "business"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            {
              "patternProperties": {
                "^street_address$": true,
                "^city$": true,
                "^state$": true,
                "^type$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
