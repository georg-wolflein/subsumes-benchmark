{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "minimum",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_343.translate_not_trivial.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Configuration to allow you to run multiple redundant extractors. Each extractor needs a unique index.",
    "properties": {
      "index": {
        "type": "integer",
        "description": "Unique index of this extractor. Each redundant extractor must have a unique index",
        "minimum": 0
      },
      "raw": {
        "type": "object",
        "description": "Configuration to use Raw as backend for high availability",
        "properties": {
          "database-name": {
            "type": "string",
            "description": "Raw database to store high availability states in"
          },
          "table-name": {
            "type": "string",
            "description": "Raw table to store high availability states in"
          }
        },
        "required": [
          "database-name",
          "table-name"
        ],
        "additionalProperties": false
      },
      "redis": {
        "type": "object",
        "description": "Configuration to use a Redis store as backend for high availability",
        "properties": {
          "connection-string": {
            "type": "string",
            "description": "Connection string to connect to redis instance"
          },
          "table-name": {
            "type": "string",
            "description": "Redis table name to store high availability states in"
          }
        },
        "required": [
          "connection-string",
          "table-name"
        ],
        "additionalProperties": false
      }
    },
    "oneOf": [
      {
        "required": [
          "raw"
        ]
      },
      {
        "required": [
          "redis"
        ]
      }
    ],
    "required": [
      "index"
    ]
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Configuration to allow you to run multiple redundant extractors. Each extractor needs a unique index.",
    "properties": {
      "index": {
        "type": "integer",
        "description": "Unique index of this extractor. Each redundant extractor must have a unique index",
        "minimum": 0.0
      },
      "raw": {
        "$ref": "#/$defs/modern_1"
      },
      "redis": {
        "$ref": "#/$defs/modern_2"
      }
    },
    "oneOf": [
      {
        "required": [
          "raw"
        ]
      },
      {
        "required": [
          "redis"
        ]
      }
    ],
    "required": [
      "index"
    ],
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Configuration to use Raw as backend for high availability",
                "properties": {
                  "database-name": {
                    "type": "string",
                    "description": "Raw database to store high availability states in"
                  },
                  "table-name": {
                    "type": "string",
                    "description": "Raw table to store high availability states in"
                  }
                },
                "required": [
                  "database-name",
                  "table-name"
                ]
              },
              {
                "patternProperties": {
                  "^database-name$": true,
                  "^table-name$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Configuration to use a Redis store as backend for high availability",
                "properties": {
                  "connection-string": {
                    "type": "string",
                    "description": "Connection string to connect to redis instance"
                  },
                  "table-name": {
                    "type": "string",
                    "description": "Redis table name to store high availability states in"
                  }
                },
                "required": [
                  "connection-string",
                  "table-name"
                ]
              },
              {
                "patternProperties": {
                  "^connection-string$": true,
                  "^table-name$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
