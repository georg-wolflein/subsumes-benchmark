{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "server": {
      "description": "Server information of the environment.",
      "type": "object",
      "properties": {
        "type": {
          "description": "Type of the server that represents the environment.",
          "type": "string"
        },
        "managementPortalUri": {
          "description": "URIs of the server's management portal.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200
        }
      }
    },
    "description": {
      "description": "Description of the environment.",
      "type": "string",
      "maxLength": 1000
    },
    "onboarding": {
      "description": "Onboarding information for this environment.",
      "type": "object",
      "properties": {
        "instructions": {
          "description": "Instructions how to onboard to the environment.",
          "type": "string",
          "maxLength": 1000
        },
        "developerPortalUri": {
          "description": "Developer portal URIs of the environment.",
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 200
        }
      }
    },
    "customProperties": {
      "$ref": "#/$defs/modern_1"
    },
    "kind": {
      "description": "Kind of deployment environment.",
      "type": "string"
    },
    "title": {
      "description": "The name of the environment.",
      "type": "string",
      "maxLength": 50
    }
  },
  "required": [
    "title",
    "kind"
  ],
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {},
              "required": []
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
