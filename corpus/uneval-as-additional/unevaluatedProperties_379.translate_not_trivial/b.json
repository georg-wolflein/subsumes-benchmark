{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "description": "Example description",
              "type": "object",
              "properties": {
                "first_name": {
                  "type": "string"
                },
                "last_name": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "^first_name$": true,
                "^last_name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
