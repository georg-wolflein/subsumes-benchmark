{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_383.translate_not_trivial.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "properties": {
          "foo": {
            "properties": {
              "faz": {
                "type": "string"
              }
            }
          }
        }
      }
    ],
    "properties": {
      "foo": {
        "properties": {
          "bar": {
            "type": "string"
          }
        },
        "type": "object",
        "additionalProperties": false
      }
    },
    "type": "object"
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "properties": {
          "foo": {
            "properties": {
              "faz": {
                "type": "string"
              }
            }
          }
        }
      }
    ],
    "properties": {
      "foo": {
        "$ref": "#/$defs/modern_1"
      }
    },
    "type": "object",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "properties": {
                  "bar": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  "^bar$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
