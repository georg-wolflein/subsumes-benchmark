{
  "$id": "urn:resolver:schema:urnr",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "URN Resolver JSON Schema (rule files .urnr.{json,yml}",
              "description": "Early draft. See https://github.com/EticaAI/urn-resolver/issues/2",
              "type": "object",
              "properties": {
                "data": {
                  "type": "object"
                },
                "$id": {
                  "type": "string"
                },
                "meta": {
                  "type": "object",
                  "properties": {
                    "examples": {
                      "type": "array",
                      "description": "Examples of input and output"
                    },
                    "featured": {
                      "type": "boolean",
                      "description": "If this is an example to show featured compared to others"
                    },
                    "_internal": {
                      "type": "boolean"
                    },
                    "Cache-Control": {
                      "type": "object"
                    },
                    "spec": {
                      "type": [
                        "string",
                        "array"
                      ]
                    },
                    "_comment": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "rules": {
                  "type": "array",
                  "description": "List of rules"
                },
                "$schema": {
                  "type": "string"
                },
                "@id": {
                  "type": "string"
                }
              },
              "required": [
                "rules"
              ]
            },
            {
              "patternProperties": {
                "^$schema$": true,
                "^rules$": true,
                "^@id$": true,
                "^meta$": true,
                "^$id$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
