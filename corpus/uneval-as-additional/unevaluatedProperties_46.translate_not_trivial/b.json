{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "file": {
                  "$ref": "#/$defs/file"
                },
                "dir": {
                  "$ref": "#/$defs/dir"
                },
                "and": {
                  "type": "array",
                  "items": {
                    "$ref": "#"
                  }
                },
                "or": {
                  "type": "array",
                  "items": {
                    "$ref": "#"
                  }
                }
              }
            },
            {
              "patternProperties": {
                "^file$": true,
                "^dir$": true,
                "^and$": true,
                "^or$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "dir": {
      "type": "object",
      "properties": {
        "mandatory": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "properties": {
            "only_folders": {
              "type": "boolean"
            },
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dir/properties/rules"
              }
            },
            "dir": {
              "$ref": "#/$defs/dir"
            },
            "file": {
              "$ref": "#/$defs/file"
            },
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dir/properties/rules"
              }
            }
          },
          "minProperties": 1,
          "maxProperties": 1,
          "additionalProperties": false
        }
      },
      "required": [
        "mandatory",
        "path"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "mandatory": {
          "type": "boolean"
        },
        "path": {
          "type": "string"
        },
        "rules": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string"
            },
            "matching_file": {
              "type": "string"
            },
            "and": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file/properties/rules"
              }
            },
            "or": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/file/properties/rules"
              }
            }
          },
          "additionalProperties": false,
          "maxProperties": 1,
          "minProperties": 1
        }
      },
      "required": [
        "mandatory",
        "path"
      ],
      "additionalProperties": false
    }
  }
}
