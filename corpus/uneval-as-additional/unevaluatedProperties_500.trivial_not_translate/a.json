{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "oneOf": [
                {
                  "required": [
                    "id"
                  ]
                },
                {
                  "required": [
                    "external-id"
                  ]
                }
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "description": "Resource internal id"
                },
                "external-id": {
                  "type": "string",
                  "description": "Resource external id"
                }
              }
            },
            {
              "patternProperties": {
                "^id$": true,
                "^external-id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
