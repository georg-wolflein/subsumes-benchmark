{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/_AdaptiveExtension_"
    }
  ],
  "$defs": {
    "_AdaptiveExtension_.propertyTypes": {
      "properties": {
        "afwCompiledVersion": {
          "description": "Version of libafw this extension was compiled against.",
          "title": "AFW Version",
          "type": "string"
        },
        "extensionId": {
          "description": "Id of extension.",
          "title": "Extension Id",
          "type": "string"
        },
        "extensionVersion": {
          "description": "Version of this extension.",
          "title": "Version",
          "type": "string"
        }
      },
      "type": "object"
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "anyOf": [
                {
                  "$ref": "#/$defs/_AdaptiveExtension_.propertyTypes"
                }
              ],
              "description": "Run time information for a loaded extension.",
              "type": "object"
            },
            {
              "patternProperties": {
                "^afwCompiledVersion$": true,
                "^extensionId$": true,
                "^extensionVersion$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "_AdaptiveExtension_": {
      "$ref": "#/$defs/modern_1"
    }
  }
}
