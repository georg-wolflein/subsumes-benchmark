{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "patternProperties": {
                "foo": {
                  "type": "string"
                }
              }
            },
            {
              "patternProperties": {
                "foo": true
              },
              "additionalProperties": false
            }
          ]
        },
        {
          "allOf": [
            {
              "not": {
                "patternProperties": {
                  "foo": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
