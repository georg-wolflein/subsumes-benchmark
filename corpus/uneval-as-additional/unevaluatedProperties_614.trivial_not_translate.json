                  "path",
                  "rule"
                ]
              },
              {
                "patternProperties": {
                  "^type$": true,
                  "^path$": true,
                  "^rule$": true,
                  "^routes$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
