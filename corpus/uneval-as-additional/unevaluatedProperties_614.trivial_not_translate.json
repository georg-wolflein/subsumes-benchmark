                    "$ref": "#/$defs/route"
                  }
                },
                "required": [
                  "port"
                ]
              },
              {
                "patternProperties": {
                  "^host$": true,
                  "^port$": true,
                  "^root$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
