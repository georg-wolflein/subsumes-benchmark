                    "type": "boolean"
                  },
                  "PUT": {
                    "type": "boolean"
                  },
                  "GET": {
                    "type": "boolean"
                  },
                  "POST": {
                    "type": "boolean"
                  },
                  "DELETE": {
                    "type": "boolean"
                  }
                }
              },
              {
                "patternProperties": {
                  "^PATCH$": true,
                  "^GET$": true,
                  "^DELETE$": true,
                  "^HEAD$": true,
                  "^POST$": true,
                  "^OPTIONS$": true,
                  "^PUT$": true,
                  "^TRACE$": true
