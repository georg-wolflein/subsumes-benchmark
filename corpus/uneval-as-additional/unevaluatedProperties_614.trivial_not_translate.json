                    "type": "string",
                    "description": "path to file system root"
                  },
                  "methods": {
                    "$ref": "#/$defs/modern_3"
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "file"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "http route path segment"
                  },
                  "routes": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/route"
                    }
                  }
                },
                "required": [
                  "type",
                  "path"
                ]
              },
              {
                "patternProperties": {
                  "^root$": true,
                  "^type$": true,
                  "^methods$": true,
                  "^directoryListing$": true,
                  "^routes$": true,
                  "^path$": true
                },
                "additionalProperties": false
              }
            ]
