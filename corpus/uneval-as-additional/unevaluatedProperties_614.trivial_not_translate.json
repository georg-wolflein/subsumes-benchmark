  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "miniRT",
    "description": "config for webserv",
    "$ref": "#/$defs/root",
    "$defs": {
      "root": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "servers": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/server"
            }
          }
        }
      },
      "server": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "host": {
            "type": "string",
            "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$"
          },
          "port": {
            "type": "integer",
            "min": 1,
            "max": 65535
          },
          "root": {
            "$ref": "#/$defs/route"
          }
        },
        "required": [
          "port"
        ]
      },
      "route": {
        "type": "object",
        "additionalProperties": false,
        "oneOf": [
          {
            "$ref": "#/$defs/file-route"
          },
          {
            "$ref": "#/$defs/cgi-route"
          }
        ]
      },
