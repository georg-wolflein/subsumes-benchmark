      "modern_5": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "enum": [
                      "cgi"
                    ]
                  },
                  "path": {
                    "type": "string"
                  },
                  "rule": {
                    "type": "array",
