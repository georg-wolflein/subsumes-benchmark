{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "format",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_617.translate_not_trivial.json",
  "a": {
    "$id": "std:fromPointInTime",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Standard From Point In Time",
    "description": "This extension is used when you want to delete data only from a certain point of time.",
    "$comment": "The DCA must be able to receive the current time and compare it with the given one.",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "from"
    ],
    "properties": {
      "from": {
        "type": "string",
        "format": "date-time",
        "description": "Point in time at which the deletion starts.",
        "examples": [
          "2022-12-01T00:00:00.000Z"
        ]
      }
    }
  },
  "b": {
    "$id": "std:fromPointInTime",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "title": "Standard From Point In Time",
                "description": "This extension is used when you want to delete data only from a certain point of time.",
                "$comment": "The DCA must be able to receive the current time and compare it with the given one.",
                "type": "object",
                "required": [
                  "from"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Point in time at which the deletion starts.",
                    "examples": [
                      "2022-12-01T00:00:00.000Z"
                    ]
                  }
                }
              },
              {
                "patternProperties": {
                  "^from$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  }
}
