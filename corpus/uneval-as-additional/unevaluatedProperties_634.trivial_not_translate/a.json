{
  "$id": "file:///driver/src/batch_score/common/configuration/file/schemas/public/concurrency_settings.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "required": [],
              "properties": {
                "initial_worker_count": {
                  "type": "integer",
                  "default": 100,
                  "minimum": 1.0,
                  "description": "The initial number of workers."
                },
                "max_worker_count": {
                  "type": "integer",
                  "default": 200,
                  "minimum": 1.0,
                  "description": "The maximum number of workers to use. Overrides initial_worker_count if needed."
                }
              }
            },
            {
              "patternProperties": {
                "^initial_worker_count$": true,
                "^max_worker_count$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
