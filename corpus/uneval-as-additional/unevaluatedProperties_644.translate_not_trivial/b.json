{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "allOf": [
                {
                  "patternProperties": {
                    "^bar": {
                      "type": "string"
                    }
                  }
                }
              ],
              "properties": {
                "foo": {
                  "type": "string"
                }
              },
              "type": "object"
            },
            {
              "patternProperties": {
                "^bar": true,
                "^foo$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
