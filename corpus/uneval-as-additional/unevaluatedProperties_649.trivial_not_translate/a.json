{
  "$id": "https://raw.githubusercontent.com/ITxPT/schematest/main/identifiers/example-globally_unique_id_value_test.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Global Unique Identifier",
  "description": "ITxPT schema for Global Unique Identifier for any vehicle mode",
  "type": "object",
  "required": [
    "schema-link",
    "version",
    "atDateTime",
    "origin",
    "identifier"
  ],
  "properties": {
    "identifier": {
      "$ref": "#/$defs/modern_1"
    },
    "$id": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "minLength": 3,
      "maxLength": 16,
      "pattern": "^[LRS]{1}-[a-zA-Z0-9]"
    },
    "atDateTime": {
      "description": "TR-001 formated timestamp of when payload was generated",
      "type": "string",
      "format": "date-time"
    },
    "schema-link": {
      "type": "string"
    },
    "extensions": {
      "type": [
        "object",
        "array"
      ],
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "description": "A ITxPT formatted local identifier of the origin of the extension",
          "type": "string",
          "minLength": 3,
          "maxLength": 16,
          "pattern": "^[LRS]{1}-[a-zA-Z0-9]"
        }
      }
    },
    "version": {
      "description": "The ITxPT version number that the payload origins from",
      "type": "string",
      "minLength": 5,
      "maxLength": 14,
      "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "allOf": [
                {
                  "description": "generic object for identifier"
                },
                {
                  "type": "object"
                },
                {
                  "properties": {
                    "idType": {
                      "type": "string",
                      "enum": [
                        "VIN",
                        "UUID",
                        "EUI64"
                      ]
                    }
                  }
                },
                {
                  "required": [
                    "idType",
                    "idValue"
                  ]
                },
                {
                  "allOf": [
                    {
                      "allOf": [
                        {
                          "properties": {
                            "idType": {
                              "type": "string",
                              "const": "VIN"
                            }
                          },
                          "required": [
                            "idType"
                          ]
                        },
                        {
                          "properties": {
                            "idValue": {
                              "description": "Vehicle Identification Number per ISO 3779:2009",
                              "type": "string",
                              "pattern": "^[A-Z0-9]{11,17}$"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "allOf": [
                        {
                          "properties": {
                            "idType": {
                              "type": "string",
                              "const": "UUID"
                            }
                          },
                          "required": [
                            "idType"
                          ]
                        },
                        {
                          "properties": {
                            "idValue": {
                              "description": "Universally unique identifier (UUID) per ISO/IEC 9834-8:2005",
                              "type": "string",
                              "pattern": "^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}$"
                            }
                          }
                        }
                      ]
                    },
                    {
                      "allOf": [
                        {
                          "properties": {
                            "idType": {
                              "type": "string",
                              "const": "EUI64"
                            }
                          },
                          "required": [
                            "idType"
                          ]
                        },
                        {
                          "properties": {
                            "idValue": {
                              "description": "IEEE 64-bit Global Identifier (EUI-64)",
                              "type": "string",
                              "pattern": "^([a-f0-9]{2}-){7}[a-f0-9]{2}$"
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "patternProperties": {
                "^idType$": true,
                "^idValue$": true
              },
              "additionalProperties": false
            }
          ]
        },
