{
  "$schema": "../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "not",
    "patternProperties",
    "properties"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/sat/unevaluatedProperties_653.trivial_not_translate.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "not": {
      "$ref": "#/$defs/modern_1"
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "allOf": [
                  {
                    "$comment": "this subschema must still produce annotations internally, even though the 'not' will ultimately discard them"
                  },
                  true
                ]
              },
              {
                "additionalProperties": false
              }
            ]
          },
          {
            "allOf": [
              {
                "allOf": [
                  {
                    "$comment": "this subschema must still produce annotations internally, even though the 'not' will ultimately discard them"
                  },
                  {
                    "properties": {
                      "foo": true
                    }
                  }
                ]
              },
              {
                "patternProperties": {
                  "^foo$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "not": {
      "$comment": "this subschema must still produce annotations internally, even though the 'not' will ultimately discard them",
      "anyOf": [
        true,
        {
          "properties": {
            "foo": true
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
