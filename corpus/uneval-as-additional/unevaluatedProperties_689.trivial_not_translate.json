{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_689.trivial_not_translate.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Configuration for logging to file or console",
    "properties": {
      "console": {
        "$ref": "#/$defs/modern_1"
      },
      "file": {
        "$ref": "#/$defs/modern_2"
      },
      "metrics": {
        "type": "boolean",
        "description": "Enables metrics on the number of log messages recorded per logger and level. This requires `metrics` to be configured as well"
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Configuration for logging to the console",
                "properties": {
                  "level": {
                    "type": "string",
                    "description": "Minimum level of messages sent to console",
                    "enum": [
                      "NOTSET",
                      "DEBUG",
                      "INFO",
                      "WARNING",
                      "ERROR",
                      "FATAL",
                      "CRITICAL"
                    ],
                    "default": "INFO"
                  }
                }
              },
              {
                "patternProperties": {
                  "^level$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Configuration for logging to a rotating file",
                "required": [
                  "path"
                ],
                "properties": {
                  "level": {
                    "type": "string",
                    "description": "Minimum level of messages sent to file",
                    "enum": [
                      "NOTSET",
                      "DEBUG",
                      "INFO",
                      "WARNING",
                      "ERROR",
                      "FATAL",
                      "CRITICAL"
                    ],
                    "default": "INFO"
                  },
                  "path": {
                    "type": "string",
                    "description": "Path to log file"
                  },
                  "retention": {
                    "type": "integer",
                    "description": "Number of log files to keep. Files are rotated daily",
                    "default": 7
                  }
                }
              },
              {
                "patternProperties": {
                  "^level$": true,
                  "^path$": true,
                  "^retention$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Configuration for logging to file or console",
    "properties": {
      "console": {
        "type": "object",
        "description": "Configuration for logging to the console",
        "additionalProperties": false,
        "properties": {
          "level": {
            "type": "string",
            "description": "Minimum level of messages sent to console",
            "enum": [
              "NOTSET",
              "DEBUG",
              "INFO",
              "WARNING",
              "ERROR",
              "FATAL",
              "CRITICAL"
            ],
            "default": "INFO"
          }
        }
      },
      "file": {
        "type": "object",
        "description": "Configuration for logging to a rotating file",
        "additionalProperties": false,
        "required": [
          "path"
        ],
        "properties": {
          "level": {
            "type": "string",
            "description": "Minimum level of messages sent to file",
            "enum": [
              "NOTSET",
              "DEBUG",
              "INFO",
              "WARNING",
              "ERROR",
              "FATAL",
              "CRITICAL"
            ],
            "default": "INFO"
          },
          "path": {
            "type": "string",
            "description": "Path to log file"
          },
          "retention": {
            "type": "integer",
            "description": "Number of log files to keep. Files are rotated daily",
            "default": 7
          }
        }
      },
      "metrics": {
        "type": "boolean",
        "description": "Enables metrics on the number of log messages recorded per logger and level. This requires `metrics` to be configured as well"
      }
    }
  }
}
