{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "enum",
    "patternProperties",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_726.trivial_not_translate.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "description": "Configuration for logging to console or file.",
    "properties": {
      "console": {
        "$ref": "#/$defs/modern_1"
      },
      "file": {
        "$ref": "#/$defs/modern_2"
      },
      "trace-listener": {
        "$ref": "#/$defs/modern_3"
      }
    },
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Configuration for logging to the console.",
                "properties": {
                  "level": {
                    "type": "string",
                    "description": "Minimum level of log events to write to the console.",
                    "enum": [
                      "verbose",
                      "debug",
                      "information",
                      "warning",
                      "error",
                      "fatal"
                    ]
                  },
                  "stderr-level": {
                    "type": "string",
                    "description": "Log events at this level or above are redirected to standard error.",
                    "enum": [
                      "verbose",
                      "debug",
                      "information",
                      "warning",
                      "error",
                      "fatal"
                    ]
                  }
                },
                "required": [
                  "level"
                ]
              },
              {
                "patternProperties": {
                  "^level$": true,
                  "^stderr-level$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Configuration for logging to a rotating log file.",
                "properties": {
                  "level": {
                    "type": "string",
                    "description": "Minimum level of log events to write to file.",
                    "enum": [
                      "verbose",
                      "debug",
                      "information",
                      "warning",
                      "error",
                      "fatal"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "Path to the files to be logged. If this is set to `logs/log.txt`, logs on the form `logs/log[date].txt` will be created, depending on `rolling-interval`."
                  },
                  "retention-limit": {
                    "type": "integer",
                    "min": 1,
                    "description": "Maximum number of log files that are kept in the log folder",
                    "default": 31
                  },
                  "rolling-interval": {
                    "type": "string",
                    "enum": [
                      "day",
                      "hour"
                    ],
                    "description": "Rolling interval for log files. Either `day` or `hour`",
                    "default": "day"
                  }
                },
                "required": [
                  "level",
                  "path"
                ]
              },
              {
                "patternProperties": {
                  "^level$": true,
                  "^path$": true,
                  "^retention-limit$": true,
                  "^rolling-interval$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_3": {
        "anyOf": [
          {
            "allOf": [
              {
                "type": "object",
                "description": "Adds a listener that uses the configured logger to output messages from `System.Diagnostics.Trace`",
                "properties": {
                  "level": {
                    "type": "string",
                    "enum": [
                      "verbose",
                      "debug",
                      "information",
                      "warning",
                      "error",
                      "fatal"
                    ],
                    "description": "Level to output trace messages at"
                  }
                },
                "required": [
                  "level"
                ]
              },
              {
                "patternProperties": {
                  "^level$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
