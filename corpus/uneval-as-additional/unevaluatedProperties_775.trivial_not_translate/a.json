{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "namespace-uri": {
                  "type": "string",
                  "description": "Full URI of the node namespace. If left out it is assumed to be the base namespace"
                },
                "node-id": {
                  "type": "string",
                  "description": "Identifier of the node id, on the form i=123, s=string, etc. See the OPC-UA standard"
                }
              }
            },
            {
              "patternProperties": {
                "^namespace-uri$": true,
                "^node-id$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
