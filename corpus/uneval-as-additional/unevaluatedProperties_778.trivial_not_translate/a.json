{
  "$id": "https://urn.etica.ai/urn:cod:jsonld:context:ab",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_1",
  "$defs": {
    "cod-ab-hxl": {
      "type": "object",
      "required": [
        "#country+code"
      ],
      "properties": {
        "#adm4+code": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "#adm3+name+ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "#date+valid_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "#country+code": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "#adm1+code": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "#adm3+code": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "#adm2+code": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "#date+valid_on": {
          "type": "string",
          "format": "date"
        },
        "#date": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "title": "JSON-Schema context for common operational datasets of kind administrative boundaries.",
              "description": "Early draft from Etica.AI (feedback at rocha@ieee.org). Uses as reference Common Operational Datasets from UN OCHA. Public domain.",
              "type": "object",
              "properties": {
                "data": {
                  "type": "array",
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "#/$defs/cod-ab-hxl"
                      },
                      {
                        "$ref": "#/$defs/cod-ab-plain"
                      }
                    ]
                  }
                },
                "$id": {
                  "type": "string"
                },
                "@type": {
                  "type": "string"
                },
                "$schema": {
                  "type": "string"
                },
                "@context": {
                  "type": "string"
                },
                "@id": {
                  "type": "string"
                }
              },
              "required": [
                "data"
              ]
            },
            {
              "patternProperties": {
                "^$schema$": true,
                "^@type$": true,
                "^@id$": true,
                "^@context$": true,
                "^$id$": true,
                "^data$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "cod-ab-plain": {
      "type": "object",
      "required": [
        "admin0Pcode"
      ],
      "properties": {
        "validOn": {
          "type": "string",
          "format": "date"
        },
        "admin3RefName": {
          "type": [
            "string",
            "null"
          ]
        },
        "admin1Pcode": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "admin4Pcode": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "admin0Pcode": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "admin2Pcode": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "admin3Pcode": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{1,12}$"
        },
        "validTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        }
      }
    }
  }
}
