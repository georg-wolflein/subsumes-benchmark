{
  "$schema": "../case.schema.json",
  "a_subsumes_b": null,
  "b_subsumes_a": null,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "anyOf",
    "patternProperties",
    "properties",
    "type"
  ],
  "upstream": "https://gitlab.lip6.fr/benali1/refutationalnormalizationforjsonschema/-/blob/8064ad83a0dbdb4b02c0ce1632d273f7cbf736cf/src/test/resources/inclusion/uneval_eliminated_as_additional_containment/unknown/unevaluatedProperties_804.trivial_not_translate.json",
  "a": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$ref": "#/$defs/modern_1",
    "$defs": {
      "modern_1": {
        "anyOf": [
          {
            "allOf": [
              {
                "allOf": [
                  {
                    "$ref": "#/$defs/modern_2"
                  }
                ],
                "properties": {
                  "foo": {
                    "type": "string"
                  }
                },
                "type": "object"
              },
              {
                "patternProperties": {
                  ".*": true,
                  "^foo$": true
                },
                "additionalProperties": false
              }
            ]
          }
        ]
      },
      "modern_2": {
        "additionalProperties": true
      }
    }
  },
  "b": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "additionalProperties": true
      }
    ],
    "properties": {
      "foo": {
        "type": "string"
      }
    },
    "type": "object",
    "additionalProperties": false
  }
}
