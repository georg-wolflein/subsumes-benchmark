{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "abi": {
      "properties": {
        "enumTypes": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/genericDefinition"
              },
              {
                "$ref": "#/$defs/withComment"
              },
              {
                "properties": {
                  "constants": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            ],
            "required": [
              "constants"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "envType": {
          "allOf": [
            {
              "$ref": "#/$defs/objectDefinition"
            }
          ],
          "type": "object"
        },
        "importedEnumTypes": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/enumDefinition"
              },
              {
                "$ref": "#/$defs/importedDefinition"
              }
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "importedEnvTypes": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/importedObjectDefinition"
              }
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "importedModuleTypes": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/genericDefinition"
              },
              {
                "$ref": "#/$defs/importedDefinition"
              },
              {
                "$ref": "#/$defs/withComment"
              },
              {
                "properties": {
                  "isInterface": {
                    "type": [
                      "boolean"
                    ]
                  },
                  "methods": {
                    "items": {
                      "$ref": "#/$defs/methodDefinition"
                    },
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "importedObjectTypes": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/objectDefinition"
              },
              {
                "$ref": "#/$defs/importedDefinition"
              },
              {
                "$ref": "#/$defs/withComment"
              }
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "interfaceTypes": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/genericDefinition"
              },
              {
                "$ref": "#/$defs/importedDefinition"
              },
              {
                "properties": {
                  "capabilities": {
                    "$ref": "#/$defs/capabilityDefinition"
                  }
                },
                "additionalProperties": false
              }
            ],
            "required": [
              "capabilities"
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "moduleType": {
          "allOf": [
            {
              "$ref": "#/$defs/genericDefinition"
            },
            {
              "$ref": "#/$defs/withComment"
            },
            {
              "properties": {
                "imports": {
                  "items": {
                    "$ref": "#/$defs/importedModuleRef"
                  },
                  "type": "array"
                },
                "interfaces": {
                  "items": {
                    "$ref": "#/$defs/interfaceImplementedDefinition"
                  },
                  "type": "array"
                },
                "methods": {
                  "items": {
                    "$ref": "#/$defs/methodDefinition"
                  },
                  "type": "array"
                }
              },
              "additionalProperties": false
            }
          ],
          "type": "object",
          "additionalProperties": false
        },
        "objectTypes": {
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/genericDefinition"
              },
              {
                "$ref": "#/$defs/withComment"
              },
              {
                "properties": {
                  "interfaces": {
                    "items": {
                      "$ref": "#/$defs/interfaceImplementedDefinition"
                    },
                    "type": "array"
                  },
                  "properties": {
                    "items": {
                      "$ref": "#/$defs/propertyDefinition"
                    },
                    "type": "array"
                  }
                },
                "additionalProperties": false
              }
            ],
            "type": "object",
            "additionalProperties": false
          },
          "type": "array"
        },
        "version": {
          "const": "0.1",
          "description": "ABI Version",
          "type": "string"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "name": {
      "description": "Wrapper Name",
      "pattern": "^[a-zA-Z0-9\\-\\_]+$",
      "type": "string"
    },
    "type": {
      "description": "Wrapper Package Type",
      "enum": [
        "wasm",
        "interface",
        "plugin"
      ],
      "type": "string"
    },
    "version": {
      "description": "WRAP Standard Version",
      "enum": [
        "0.1.0",
        "0.1"
      ],
      "type": "string"
    }
  },
  "required": [
    "version",
    "name",
    "type",
    "abi"
  ],
  "type": "object",
  "$defs": {
    "anyDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        },
        {
          "properties": {
            "array": {
              "$ref": "#/$defs/arrayDefinition"
            },
            "enum": {
              "allOf": [
                {
                  "$ref": "#/$defs/enumRef"
                }
              ],
              "required": [
                "type"
              ]
            },
            "map": {
              "$ref": "#/$defs/mapDefinition"
            },
            "object": {
              "$ref": "#/$defs/objectRef"
            },
            "scalar": {
              "$ref": "#/$defs/scalarDefinition"
            },
            "unresolvedObjectOrEnum": {
              "$ref": "#/$defs/unresolvedObjectOrEnumRef"
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "arrayDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/anyDefinition"
        },
        {
          "properties": {
            "item": {
              "$ref": "#/$defs/genericDefinition"
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "item"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "capabilityDefinition": {
      "properties": {
        "getImplementations": {
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "type": "object",
          "additionalProperties": false
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "enumDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        },
        {
          "$ref": "#/$defs/withComment"
        },
        {
          "properties": {
            "constants": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "constants"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "enumRef": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "envDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/objectDefinition"
        }
      ],
      "type": "object"
    },
    "genericDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/withKind"
        },
        {
          "properties": {
            "name": {
              "type": [
                "string"
              ]
            },
            "required": {
              "type": [
                "boolean"
              ]
            },
            "type": {
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "importedDefinition": {
      "properties": {
        "namespace": {
          "type": "string"
        },
        "nativeType": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        }
      },
      "required": [
        "uri",
        "namespace",
        "nativeType"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "importedEnumDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/enumDefinition"
        },
        {
          "$ref": "#/$defs/importedDefinition"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "importedEnvDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/importedObjectDefinition"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "importedModuleDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        },
        {
          "$ref": "#/$defs/importedDefinition"
        },
        {
          "$ref": "#/$defs/withComment"
        },
        {
          "properties": {
            "isInterface": {
              "type": [
                "boolean"
              ]
            },
            "methods": {
              "items": {
                "$ref": "#/$defs/methodDefinition"
              },
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "importedModuleRef": {
      "properties": {
        "type": {
          "type": "string"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "importedObjectDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/objectDefinition"
        },
        {
          "$ref": "#/$defs/importedDefinition"
        },
        {
          "$ref": "#/$defs/withComment"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "interfaceDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        },
        {
          "$ref": "#/$defs/importedDefinition"
        },
        {
          "properties": {
            "capabilities": {
              "$ref": "#/$defs/capabilityDefinition"
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "capabilities"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "interfaceImplementedDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "mapDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/anyDefinition"
        },
        {
          "$ref": "#/$defs/withComment"
        },
        {
          "properties": {
            "key": {
              "$ref": "#/$defs/mapKeyDefinition"
            },
            "value": {
              "$ref": "#/$defs/genericDefinition"
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "key",
        "value"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "mapKeyDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/anyDefinition"
        },
        {
          "properties": {
            "type": {
              "$ref": "#/$defs/mapKeyType"
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "type"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "mapKeyType": {
      "enum": [
        "UInt",
        "UInt8",
        "UInt16",
        "UInt32",
        "Int",
        "Int8",
        "Int16",
        "Int32",
        "String"
      ],
      "type": "string"
    },
    "methodDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        },
        {
          "$ref": "#/$defs/withComment"
        },
        {
          "properties": {
            "arguments": {
              "items": {
                "$ref": "#/$defs/propertyDefinition"
              },
              "type": "array"
            },
            "env": {
              "properties": {
                "required": {
                  "type": "boolean"
                }
              },
              "type": "object",
              "additionalProperties": false
            },
            "return": {
              "$ref": "#/$defs/propertyDefinition"
            }
          },
          "additionalProperties": false
        }
      ],
      "required": [
        "return"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "moduleDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        },
        {
          "$ref": "#/$defs/withComment"
        },
        {
          "properties": {
            "imports": {
              "items": {
                "$ref": "#/$defs/importedModuleRef"
              },
              "type": "array"
            },
            "interfaces": {
              "items": {
                "$ref": "#/$defs/interfaceImplementedDefinition"
              },
              "type": "array"
            },
            "methods": {
              "items": {
                "$ref": "#/$defs/methodDefinition"
              },
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "objectDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        },
        {
          "$ref": "#/$defs/withComment"
        },
        {
          "properties": {
            "interfaces": {
              "items": {
                "$ref": "#/$defs/interfaceImplementedDefinition"
              },
              "type": "array"
            },
            "properties": {
              "items": {
                "$ref": "#/$defs/propertyDefinition"
              },
              "type": "array"
            }
          },
          "additionalProperties": false
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "objectRef": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "propertyDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/withComment"
        },
        {
          "$ref": "#/$defs/anyDefinition"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "scalarDefinition": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        }
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/scalarType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object",
      "additionalProperties": false
    },
    "scalarType": {
      "enum": [
        "UInt",
        "UInt8",
        "UInt16",
        "UInt32",
        "Int",
        "Int8",
        "Int16",
        "Int32",
        "String",
        "Boolean",
        "Bytes",
        "BigInt",
        "BigNumber",
        "JSON"
      ],
      "type": "string"
    },
    "unresolvedObjectOrEnumRef": {
      "allOf": [
        {
          "$ref": "#/$defs/genericDefinition"
        }
      ],
      "type": "object",
      "additionalProperties": false
    },
    "withComment": {
      "properties": {
        "comment": {
          "type": "string"
        }
      },
      "type": "object",
      "additionalProperties": false
    },
    "withKind": {
      "properties": {
        "kind": {
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object",
      "additionalProperties": false
    }
  }
}
