{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/modern_10",
  "$defs": {
    "modern_6": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "setupMirrored": {
                  "type": "boolean"
                },
                "custommetrics": {
                  "$ref": "#/$defs/custommetrics"
                },
                "global": {
                  "$ref": "#/$defs/global"
                },
                "dah": {
                  "$ref": "#/$defs/dah"
                },
                "content": {
                  "$ref": "#/$defs/content"
                },
                "idol-licenseserver": {
                  "$ref": "#/$defs/optional_subchart"
                },
                "autoscaling": {
                  "$ref": "#/$defs/autoscaling"
                },
                "dih": {
                  "$ref": "#/$defs/dih"
                },
                "prometheus": {
                  "$ref": "#/$defs/prometheus"
                }
              },
              "required": [
                "global",
                "autoscaling",
                "content",
                "dih",
                "dah",
                "custommetrics",
                "prometheus",
                "idol-licenseserver",
                "setupMirrored"
              ],
              "allOf": [
                {
                  "$ref": "#/$defs/licensing"
                },
                {
                  "$ref": "#/$defs/idol_services"
                }
              ]
            },
            {
              "patternProperties": {
                "^custommetrics$": true,
                "^setupMirrored$": true,
                "^queryserviceName$": true,
                "^autoscaling$": true,
                "^content$": true,
                "^global$": true,
                "^idol-licenseserver$": true,
                "^prometheus$": true,
                "^dah$": true,
                "^licenseServerPort$": true,
                "^dih$": true,
                "^indexserviceName$": true,
                "^licenseServerHostname$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_1": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/required_string"
                },
                "servicePort": {
                  "$ref": "#/$defs/port_number"
                },
                "containerPort": {
                  "$ref": "#/$defs/port_number"
                }
              },
              "required": [
                "name",
                "servicePort",
                "containerPort"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^servicePort$": true,
                "^containerPort$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "required_string": {
      "type": "string",
      "minLength": 1
    },
    "modern_2": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "ingress": {
                  "$ref": "#/$defs/ingress"
                }
              },
              "required": [
                "ingress"
              ],
              "allOf": [
                {
                  "$ref": "#/$defs/aciCommon"
                }
              ]
            },
            {
              "patternProperties": {
                "^additionalVolumes$": true,
                "^aciPort$": true,
                "^ingress$": true,
                "^existingConfigMap$": true,
                "^additionalVolumeMounts$": true,
                "^idolImage$": true,
                "^envConfigMap$": true,
                "^livenessProbe$": true,
                "^indexPort$": true,
                "^servicePort$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "aciCommon": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/required_string"
        },
        "envConfigMap": {
          "type": "string"
        },
        "aciPort": {
          "$ref": "#/$defs/port_number"
        },
        "servicePort": {
          "$ref": "#/$defs/port_number"
        },
        "additionalVolumeMounts": {
          "type": "array"
        },
        "additionalVolumes": {
          "type": "array"
        },
        "idolImage": {
          "$ref": "#/$defs/idolImage"
        },
        "indexPort": {
          "$ref": "#/$defs/port_number"
        },
        "livenessProbe": {
          "$ref": "#/$defs/liveness_probe"
        },
        "existingConfigMap": {
          "type": "string"
        }
      },
      "required": [
        "idolImage",
        "ingress",
        "name",
        "aciPort",
        "servicePort"
      ]
    },
    "global": {
      "type": "object",
      "properties": {
        "no_proxy": {
          "type": "string"
        },
        "idolVersion": {
          "type": "string"
        },
        "imagePullSecrets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/required_string"
          }
        },
        "http_proxy": {
          "type": "string"
        },
        "idolImageRegistry": {
          "type": "string"
        },
        "https_proxy": {
          "type": "string"
        }
      },
      "required": [
        "imagePullSecrets"
      ]
    },
    "modern_9": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "registry": {
                  "type": "string",
                  "format": "hostname"
                },
                "version": {
                  "$ref": "#/$defs/required_string"
                },
                "repo": {
                  "$ref": "#/$defs/required_string"
                }
              },
              "required": [
                "registry",
                "version",
                "repo"
              ]
            },
            {
              "patternProperties": {
                "^registry$": true,
                "^version$": true,
                "^repo$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_3": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "dihStorageClass": {
                  "$ref": "#/$defs/required_string"
                },
                "prometheusPort": {
                  "$ref": "#/$defs/port_number"
                },
                "ingress": {
                  "$ref": "#/$defs/ingress"
                }
              },
              "required": [
                "dihStorageClass",
                "prometheusPort",
                "ingress"
              ],
              "allOf": [
                {
                  "$ref": "#/$defs/aciCommon"
                }
              ]
            },
            {
              "patternProperties": {
                "^additionalVolumes$": true,
                "^dihStorageClass$": true,
                "^prometheusPort$": true,
                "^aciPort$": true,
                "^ingress$": true,
                "^existingConfigMap$": true,
                "^additionalVolumeMounts$": true,
                "^idolImage$": true,
                "^envConfigMap$": true,
                "^livenessProbe$": true,
                "^indexPort$": true,
                "^servicePort$": true,
                "^name$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "port_number": {
      "type": "string",
      "pattern": "^((6553[0-5])|(655[0-2][0-9])|(65[0-4][0-9]{2})|(6[0-4][0-9]{3})|([1-5][0-9]{4})|([0-5]{0,5})|([0-9]{1,4}))$"
    },
    "ingressCommon": {
      "type": "object",
      "properties": {
        "proxyBodySize": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?(?:Ki|Mi|Gi|Ti|Pi|Ei|m|k|M|G|T|P|E)?$"
        },
        "host": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "nginx",
            "haproxy"
          ]
        }
      },
      "required": [
        "enabled",
        "type"
      ]
    },
    "modern_4": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "allOf": [
                {
                  "$ref": "#/$defs/ingressCommon"
                }
              ]
            },
            {
              "patternProperties": {
                "^proxyBodySize$": true,
                "^host$": true,
                "^type$": true,
                "^className$": true,
                "^enabled$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "volume_size": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)?(?:Ki|Mi|Gi|Ti|Pi|Ei|m|k|M|G|T|P|E)?$"
    },
    "optional_subchart": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "enabled"
      ]
    },
    "modern_5": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "#/$defs/required_string"
                },
                "port": {
                  "$ref": "#/$defs/port_number"
                },
                "ingress": {
                  "$ref": "#/$defs/ingress"
                }
              },
              "required": [
                "name",
                "port",
                "ingress"
              ]
            },
            {
              "patternProperties": {
                "^name$": true,
                "^port$": true,
                "^ingress$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "modern_10": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "$ref": "#/$defs/base"
            },
            {
              "patternProperties": {
                ".*": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "licensing": {
      "type": "object",
      "properties": {
        "licenseServerHostname": {
          "type": "string",
          "format": "hostname"
        },
        "licenseServerPort": {
          "$ref": "#/$defs/port_number"
        }
      },
      "required": [
        "licenseServerHostname",
        "licenseServerPort"
      ]
    },
    "custommetrics": {
      "$ref": "#/$defs/modern_1"
    },
    "modern_7": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "contentVolumeSize": {
                  "$ref": "#/$defs/volume_size"
                },
                "ingress": {
                  "$ref": "#/$defs/modern_8"
                },
                "primaryBackupInterval": {
                  "$ref": "#/$defs/required_string"
                },
                "primaryBackupTime": {
                  "$ref": "#/$defs/required_string"
                },
                "backupArchiveStorageClass": {
                  "$ref": "#/$defs/required_string"
                },
                "contentStorageClass": {
                  "$ref": "#/$defs/required_string"
                },
                "initialEngineCount": {
                  "$ref": "#/$defs/non_zero_number"
                }
              },
              "required": [
                "contentStorageClass",
                "contentVolumeSize",
                "backupArchiveStorageClass",
                "primaryBackupInterval",
                "primaryBackupTime",
                "initialEngineCount",
                "ingress"
              ],
              "allOf": [
                {
                  "$ref": "#/$defs/aciCommon"
                }
              ]
            },
            {
              "patternProperties": {
                "^additionalVolumes$": true,
                "^primaryBackupTime$": true,
                "^initialEngineCount$": true,
                "^backupArchiveStorageClass$": true,
                "^aciPort$": true,
                "^ingress$": true,
                "^additionalVolumeMounts$": true,
                "^idolImage$": true,
                "^primaryBackupInterval$": true,
                "^envConfigMap$": true,
                "^livenessProbe$": true,
                "^indexPort$": true,
                "^contentStorageClass$": true,
                "^servicePort$": true,
                "^name$": true,
                "^contentVolumeSize$": true,
                "^existingConfigMap$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "$ref": "#/$defs/non_zero_number"
        },
        "maxDocumentCount": {
          "$ref": "#/$defs/non_zero_number"
        },
        "maxReplicas": {
          "$ref": "#/$defs/non_zero_number"
        },
        "targetAverageCpuUse": {
          "type": "string",
          "pattern": "^\\d+(?:\\.\\d+)?(?:m|k|M|G|T|P|E)?$"
        }
      },
      "required": [
        "enabled",
        "minReplicas",
        "maxReplicas",
        "maxDocumentCount",
        "targetAverageCpuUse"
      ]
    },
    "dih": {
      "$ref": "#/$defs/modern_3"
    },
    "ingress": {
      "$ref": "#/$defs/modern_4"
    },
    "prometheus": {
      "$ref": "#/$defs/modern_5"
    },
    "non_zero_number": {
      "type": "string",
      "pattern": "^[1-9]|\\d{2,}$"
    },
    "base": {
      "$ref": "#/$defs/modern_6"
    },
    "idol_services": {
      "type": "object",
      "properties": {
        "queryserviceName": {
          "$ref": "#/$defs/required_string"
        },
        "indexserviceName": {
          "$ref": "#/$defs/required_string"
        }
      },
      "required": [
        "queryserviceName",
        "indexserviceName"
      ]
    },
    "liveness_probe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {
          "type": "integer"
        },
        "timeoutSeconds": {
          "type": "integer"
        },
        "periodSeconds": {
          "type": "integer"
        },
        "failureThreshold": {
          "type": "integer"
        }
      }
    },
    "dah": {
      "$ref": "#/$defs/modern_2"
    },
    "modern_8": {
      "anyOf": [
        {
          "allOf": [
            {
              "type": "object",
              "properties": {
                "exposedContents": {
                  "type": "integer",
                  "minimum": 0.0
                }
              },
              "allOf": [
                {
                  "$ref": "#/$defs/ingressCommon"
                }
              ]
            },
            {
              "patternProperties": {
                "^proxyBodySize$": true,
                "^type$": true,
                "^className$": true,
                "^enabled$": true,
                "^exposedContents$": true,
                "^host$": true
              },
              "additionalProperties": false
            }
          ]
        }
      ]
    },
    "content": {
      "$ref": "#/$defs/modern_7"
    },
    "idolImage": {
      "$ref": "#/$defs/modern_9"
    }
  }
}
