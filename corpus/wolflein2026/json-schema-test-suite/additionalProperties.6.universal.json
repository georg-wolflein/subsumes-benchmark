{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "additionalProperties",
    "allOf",
    "anyOf",
    "not",
    "properties",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/additionalProperties.json#/tests/6"
  },
  "a": true,
  "b": {
    "anyOf": [
      {
        "allOf": [
          {
            "properties": {
              "foo": {}
            }
          }
        ],
        "additionalProperties": {
          "type": "boolean"
        }
      },
      {
        "not": {
          "allOf": [
            {
              "properties": {
                "foo": {}
              }
            }
          ],
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    ]
  }
}
