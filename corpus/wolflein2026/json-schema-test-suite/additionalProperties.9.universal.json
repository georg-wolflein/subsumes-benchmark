{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "additionalProperties",
    "anyOf",
    "dependentSchemas",
    "not",
    "properties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/additionalProperties.json#/tests/9",
  "a": true,
  "b": {
    "anyOf": [
      {
        "properties": {
          "foo2": {}
        },
        "dependentSchemas": {
          "foo": {},
          "foo2": {
            "properties": {
              "bar": {}
            }
          }
        },
        "additionalProperties": false
      },
      {
        "not": {
          "properties": {
            "foo2": {}
          },
          "dependentSchemas": {
            "foo": {},
            "foo2": {
              "properties": {
                "bar": {}
              }
            }
          },
          "additionalProperties": false
        }
      }
    ]
  }
}
