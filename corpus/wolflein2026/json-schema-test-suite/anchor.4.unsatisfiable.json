{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "allOf",
    "not",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/anchor.json#/tests/4",
  "a": false,
  "b": {
    "allOf": [
      {
        "$ref": "https://example.com/schema-with-anchor"
      },
      {
        "not": {
          "$ref": "https://example.com/schema-with-anchor"
        }
      }
    ],
    "$defs": {
      "https://example.com/schema-with-anchor": {
        "$id": "https://example.com/schema-with-anchor",
        "allOf": [
          {
            "$ref": "https://example.com/schema-with-anchor#foo"
          }
        ],
        "$defs": {
          "A": {
            "$anchor": "foo",
            "type": "integer"
          }
        }
      }
    }
  }
}
