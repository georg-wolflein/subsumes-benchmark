{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "const",
    "contains",
    "maxContains",
    "minContains",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/contains.json#/tests/19",
  "a": true,
  "b": {
    "anyOf": [
      {
        "contains": {
          "const": 1
        },
        "minContains": 1,
        "maxContains": 3
      },
      {
        "not": {
          "contains": {
            "const": 1
          },
          "minContains": 1,
          "maxContains": 3
        }
      }
    ]
  }
}
