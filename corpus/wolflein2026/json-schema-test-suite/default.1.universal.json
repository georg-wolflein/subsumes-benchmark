{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "minLength",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/default.json#/tests/1",
  "a": true,
  "b": {
    "anyOf": [
      {
        "properties": {
          "bar": {
            "type": "string",
            "minLength": 4,
            "default": "bad"
          }
        }
      },
      {
        "not": {
          "properties": {
            "bar": {
              "type": "string",
              "minLength": 4,
              "default": "bad"
            }
          }
        }
      }
    ]
  }
}
