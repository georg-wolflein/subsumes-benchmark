{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "const",
    "dependentRequired",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dependentRequired.json#/tests/7/tests/3",
  "derived": {
    "b_subsumes_a": {
      "counterexample": {
        "foo\nbar": null,
        "foo\"bar": null
      }
    }
  },
  "a": {
    "not": {
      "dependentRequired": {
        "foo\nbar": [
          "foo\rbar"
        ],
        "foo\"bar": [
          "foo'bar"
        ]
      }
    }
  },
  "b": {
    "const": {
      "foo\"bar": 2
    }
  }
}
