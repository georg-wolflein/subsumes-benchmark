{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "dependentRequired",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dependentRequired.json#/tests/7",
  "a": false,
  "b": {
    "allOf": [
      {
        "dependentRequired": {
          "foo\nbar": [
            "foo\rbar"
          ],
          "foo\"bar": [
            "foo'bar"
          ]
        }
      },
      {
        "not": {
          "dependentRequired": {
            "foo\nbar": [
              "foo\rbar"
            ],
            "foo\"bar": [
              "foo'bar"
            ]
          }
        }
      }
    ]
  }
}
