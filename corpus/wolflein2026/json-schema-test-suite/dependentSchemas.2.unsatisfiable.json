{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "dependentSchemas",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dependentSchemas.json#/tests/2",
  "a": false,
  "b": {
    "allOf": [
      {
        "dependentSchemas": {
          "foo": true,
          "bar": false
        }
      },
      {
        "not": {
          "dependentSchemas": {
            "foo": true,
            "bar": false
          }
        }
      }
    ]
  }
}
