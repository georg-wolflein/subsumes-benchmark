{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "const",
    "dependentSchemas",
    "minProperties",
    "not",
    "required"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dependentSchemas.json#/tests/4/tests/2",
  "derived": {
    "b_subsumes_a": {
      "counterexample": {
        "a": null,
        "foo\tbar": null
      }
    }
  },
  "a": {
    "not": {
      "dependentSchemas": {
        "foo\tbar": {
          "minProperties": 4
        },
        "foo'bar": {
          "required": [
            "foo\"bar"
          ]
        }
      }
    }
  },
  "b": {
    "const": {
      "foo\tbar": 1,
      "a": 2
    }
  }
}
