{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "dependentSchemas",
    "minProperties",
    "not",
    "required"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dependentSchemas.json#/tests/4"
  },
  "a": true,
  "b": {
    "anyOf": [
      {
        "dependentSchemas": {
          "foo\tbar": {
            "minProperties": 4
          },
          "foo'bar": {
            "required": [
              "foo\"bar"
            ]
          }
        }
      },
      {
        "not": {
          "dependentSchemas": {
            "foo\tbar": {
              "minProperties": 4
            },
            "foo'bar": {
              "required": [
                "foo\"bar"
              ]
            }
          }
        }
      }
    ]
  }
}
