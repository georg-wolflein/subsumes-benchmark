{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$dynamicRef",
    "$ref",
    "allOf",
    "items",
    "not",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dynamicRef.json#/tests/28"
  },
  "a": false,
  "b": {
    "allOf": [
      {
        "$ref": "https://test.json-schema.org/unmatched-dynamic-anchor/root"
      },
      {
        "not": {
          "$ref": "https://test.json-schema.org/unmatched-dynamic-anchor/root"
        }
      }
    ],
    "$defs": {
      "https://test.json-schema.org/unmatched-dynamic-anchor/root": {
        "$id": "https://test.json-schema.org/unmatched-dynamic-anchor/root",
        "$ref": "list",
        "$defs": {
          "foo": {
            "$dynamicAnchor": "items",
            "type": "string"
          },
          "list": {
            "$id": "list",
            "type": "array",
            "items": {
              "$dynamicRef": "#items"
            },
            "$defs": {
              "items": {
                "$comment": "This is only needed to give the reference somewhere to resolve to when it behaves like $ref",
                "$anchor": "items",
                "$dynamicAnchor": "foo"
              }
            }
          }
        }
      }
    }
  }
}
