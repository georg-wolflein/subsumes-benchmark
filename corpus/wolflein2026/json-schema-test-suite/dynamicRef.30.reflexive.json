{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$dynamicRef",
    "$ref",
    "const",
    "properties",
    "recursion",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/dynamicRef.json#/tests/30",
  "a": {
    "$id": "https://test.json-schema.org/relative-dynamic-reference-without-bookend/root",
    "$dynamicAnchor": "meta",
    "type": "object",
    "properties": {
      "foo": {
        "const": "pass"
      }
    },
    "$ref": "extended",
    "$defs": {
      "extended": {
        "$id": "extended",
        "$anchor": "meta",
        "type": "object",
        "properties": {
          "bar": {
            "$ref": "bar"
          }
        }
      },
      "bar": {
        "$id": "bar",
        "type": "object",
        "properties": {
          "baz": {
            "$dynamicRef": "extended#meta"
          }
        }
      }
    }
  },
  "b": {
    "$id": "https://test.json-schema.org/relative-dynamic-reference-without-bookend/root",
    "$dynamicAnchor": "meta",
    "type": "object",
    "properties": {
      "foo": {
        "const": "pass"
      }
    },
    "$ref": "extended",
    "$defs": {
      "extended": {
        "$id": "extended",
        "$anchor": "meta",
        "type": "object",
        "properties": {
          "bar": {
            "$ref": "bar"
          }
        }
      },
      "bar": {
        "$id": "bar",
        "type": "object",
        "properties": {
          "baz": {
            "$dynamicRef": "extended#meta"
          }
        }
      }
    }
  }
}
