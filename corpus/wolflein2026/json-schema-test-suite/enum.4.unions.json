{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "anyOf",
    "const",
    "enum",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/enum.json#/tests/4",
  "derived": {
    "b_subsumes_a": {
      "counterexample": {
        "a": null,
        "bar": "bar"
      }
    }
  },
  "a": {
    "type": "object",
    "properties": {
      "foo": {
        "enum": [
          "foo"
        ]
      },
      "bar": {
        "enum": [
          "bar"
        ]
      }
    },
    "required": [
      "bar"
    ]
  },
  "b": {
    "anyOf": [
      {
        "const": {
          "foo": "foo",
          "bar": "bar"
        }
      },
      {
        "const": {
          "bar": "bar"
        }
      }
    ]
  }
}
