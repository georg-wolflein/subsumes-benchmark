{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "enum",
    "not",
    "properties",
    "required",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/enum.json#/tests/4",
  "a": true,
  "b": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "foo": {
            "enum": [
              "foo"
            ]
          },
          "bar": {
            "enum": [
              "bar"
            ]
          }
        },
        "required": [
          "bar"
        ]
      },
      {
        "not": {
          "type": "object",
          "properties": {
            "foo": {
              "enum": [
                "foo"
              ]
            },
            "bar": {
              "enum": [
                "bar"
              ]
            }
          },
          "required": [
            "bar"
          ]
        }
      }
    ]
  }
}
