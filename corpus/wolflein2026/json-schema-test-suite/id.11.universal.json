{
  "$schema": "../../case.schema.json",
  "labels": {
    "a_subsumes_b": {
      "kind": "source",
      "answer": true
    },
    "b_subsumes_a": {
      "kind": "source",
      "answer": true
    }
  },
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/11"
  },
  "features": [
    "$ref",
    "anyOf",
    "minimum",
    "not",
    "properties",
    "recursion"
  ],
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "foo:bar/baz"
      },
      {
        "not": {
          "$ref": "foo:bar/baz"
        }
      }
    ],
    "$defs": {
      "foo:bar/baz": {
        "$id": "foo:bar/baz",
        "$comment": "URIs do not have to have HTTP(s) schemes",
        "minimum": 30,
        "properties": {
          "foo": {
            "$ref": "foo:bar/baz"
          }
        }
      }
    }
  }
}
