{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "anyOf",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/12",
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "urn:uuid:deadbeef-1234-00ff-ff00-4321feebdaed"
      },
      {
        "not": {
          "$ref": "urn:uuid:deadbeef-1234-00ff-ff00-4321feebdaed"
        }
      }
    ],
    "$defs": {
      "urn:uuid:deadbeef-1234-00ff-ff00-4321feebdaed": {
        "$id": "urn:uuid:deadbeef-1234-00ff-ff00-4321feebdaed",
        "$comment": "URIs do not have to have HTTP(s) schemes",
        "properties": {
          "foo": {
            "$ref": "#/$defs/bar"
          }
        },
        "$defs": {
          "bar": {
            "type": "string"
          }
        }
      }
    }
  }
}
