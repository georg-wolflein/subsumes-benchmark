{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "allOf",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/13",
  "a": false,
  "b": {
    "allOf": [
      {
        "$ref": "urn:example:1/406/47452/2"
      },
      {
        "not": {
          "$ref": "urn:example:1/406/47452/2"
        }
      }
    ],
    "$defs": {
      "urn:example:1/406/47452/2": {
        "$id": "urn:example:1/406/47452/2",
        "$comment": "RFC 8141 \u00a72.2",
        "properties": {
          "foo": {
            "$ref": "#/$defs/bar"
          }
        },
        "$defs": {
          "bar": {
            "type": "string"
          }
        }
      }
    }
  }
}
