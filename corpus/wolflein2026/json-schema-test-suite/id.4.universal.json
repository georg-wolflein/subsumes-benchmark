{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "anyOf",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/4",
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "http://example.com/schema-refs-absolute-uris-defs1.json"
      },
      {
        "not": {
          "$ref": "http://example.com/schema-refs-absolute-uris-defs1.json"
        }
      }
    ],
    "$defs": {
      "http://example.com/schema-refs-absolute-uris-defs1.json": {
        "$id": "http://example.com/schema-refs-absolute-uris-defs1.json",
        "properties": {
          "foo": {
            "$id": "http://example.com/schema-refs-absolute-uris-defs2.json",
            "$defs": {
              "inner": {
                "properties": {
                  "bar": {
                    "type": "string"
                  }
                }
              }
            },
            "$ref": "#/$defs/inner"
          }
        },
        "$ref": "schema-refs-absolute-uris-defs2.json"
      }
    }
  }
}
