{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "allOf",
    "anyOf",
    "not",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/5"
  },
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "http://example.com/a.json"
      },
      {
        "not": {
          "$ref": "http://example.com/a.json"
        }
      }
    ],
    "$defs": {
      "http://example.com/a.json": {
        "$id": "http://example.com/a.json",
        "$defs": {
          "x": {
            "$id": "http://example.com/b/c.json",
            "not": {
              "$defs": {
                "y": {
                  "$id": "d.json",
                  "type": "number"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "$ref": "http://example.com/b/d.json"
          }
        ]
      }
    }
  }
}
