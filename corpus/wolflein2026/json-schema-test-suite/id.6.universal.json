{
  "$schema": "../../case.schema.json",
  "labels": {
    "a_subsumes_b": {
      "kind": "source",
      "answer": true
    },
    "b_subsumes_a": {
      "kind": "source",
      "answer": true
    }
  },
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/6"
  },
  "features": [
    "$ref",
    "anyOf",
    "maximum",
    "not"
  ],
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "https://example.com/ref-and-id1/base.json"
      },
      {
        "not": {
          "$ref": "https://example.com/ref-and-id1/base.json"
        }
      }
    ],
    "$defs": {
      "https://example.com/ref-and-id1/base.json": {
        "$id": "https://example.com/ref-and-id1/base.json",
        "$comment": "$id must be evaluated before $ref to get the proper $ref destination",
        "$ref": "int.json",
        "$defs": {
          "bigint": {
            "$comment": "canonical uri: https://example.com/ref-and-id1/int.json",
            "$id": "int.json",
            "maximum": 10
          },
          "smallint": {
            "$comment": "canonical uri: https://example.com/ref-and-id1-int.json",
            "$id": "/ref-and-id1-int.json",
            "maximum": 2
          }
        }
      }
    }
  }
}
