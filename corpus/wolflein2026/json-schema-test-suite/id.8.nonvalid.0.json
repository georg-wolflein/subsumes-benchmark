{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": false,
  "features": [
    "$ref",
    "const",
    "not",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/8/tests/0",
  "derived": {
    "b_subsumes_a": {
      "counterexample": null
    }
  },
  "a": {
    "not": {
      "$ref": "https://example.com/ref-and-id3/base.json"
    },
    "$defs": {
      "https://example.com/ref-and-id3/base.json": {
        "$id": "https://example.com/ref-and-id3/base.json",
        "$comment": "$id must be evaluated before $ref to get the proper $ref destination",
        "$ref": "nested/foo.json",
        "$defs": {
          "foo": {
            "$comment": "canonical uri: https://example.com/ref-and-id3/nested/foo.json",
            "$id": "nested/foo.json",
            "$ref": "./bar.json"
          },
          "bar": {
            "$comment": "canonical uri: https://example.com/ref-and-id3/nested/bar.json",
            "$id": "nested/bar.json",
            "type": "number"
          }
        }
      }
    }
  },
  "b": {
    "const": 5
  }
}
