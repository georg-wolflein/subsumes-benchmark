{
  "$schema": "../../case.schema.json",
  "labels": {
    "a_subsumes_b": {
      "kind": "source",
      "answer": true
    },
    "b_subsumes_a": {
      "kind": "source",
      "answer": true
    }
  },
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/id.json#/tests/8"
  },
  "features": [
    "$ref",
    "allOf",
    "not",
    "type"
  ],
  "a": false,
  "b": {
    "allOf": [
      {
        "$ref": "https://example.com/ref-and-id3/base.json"
      },
      {
        "not": {
          "$ref": "https://example.com/ref-and-id3/base.json"
        }
      }
    ],
    "$defs": {
      "https://example.com/ref-and-id3/base.json": {
        "$id": "https://example.com/ref-and-id3/base.json",
        "$comment": "$id must be evaluated before $ref to get the proper $ref destination",
        "$ref": "nested/foo.json",
        "$defs": {
          "foo": {
            "$comment": "canonical uri: https://example.com/ref-and-id3/nested/foo.json",
            "$id": "nested/foo.json",
            "$ref": "./bar.json"
          },
          "bar": {
            "$comment": "canonical uri: https://example.com/ref-and-id3/nested/bar.json",
            "$id": "nested/bar.json",
            "type": "number"
          }
        }
      }
    }
  }
}
