{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "const",
    "else",
    "if",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/if-then-else.json#/tests/11",
  "a": true,
  "b": {
    "anyOf": [
      {
        "if": {
          "const": 1
        },
        "else": false
      },
      {
        "not": {
          "if": {
            "const": 1
          },
          "else": false
        }
      }
    ]
  }
}
