{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "else",
    "exclusiveMaximum",
    "if",
    "multipleOf",
    "not"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/if-then-else.json#/tests/4",
  "a": false,
  "b": {
    "allOf": [
      {
        "if": {
          "exclusiveMaximum": 0
        },
        "else": {
          "multipleOf": 2
        }
      },
      {
        "not": {
          "if": {
            "exclusiveMaximum": 0
          },
          "else": {
            "multipleOf": 2
          }
        }
      }
    ]
  }
}
