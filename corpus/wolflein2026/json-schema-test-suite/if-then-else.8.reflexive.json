{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "const",
    "else",
    "if",
    "then"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/if-then-else.json#/tests/8",
  "a": {
    "if": false,
    "then": {
      "const": "then"
    },
    "else": {
      "const": "else"
    }
  },
  "b": {
    "if": false,
    "then": {
      "const": "then"
    },
    "else": {
      "const": "else"
    }
  }
}
