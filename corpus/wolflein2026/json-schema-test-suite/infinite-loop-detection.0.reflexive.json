{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "additionalProperties",
    "allOf",
    "properties",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/infinite-loop-detection.json#/tests/0"
  },
  "a": {
    "$defs": {
      "int": {
        "type": "integer"
      }
    },
    "allOf": [
      {
        "properties": {
          "foo": {
            "$ref": "#/$defs/int"
          }
        }
      },
      {
        "additionalProperties": {
          "$ref": "#/$defs/int"
        }
      }
    ]
  },
  "b": {
    "$defs": {
      "int": {
        "type": "integer"
      }
    },
    "allOf": [
      {
        "properties": {
          "foo": {
            "$ref": "#/$defs/int"
          }
        }
      },
      {
        "additionalProperties": {
          "$ref": "#/$defs/int"
        }
      }
    ]
  }
}
