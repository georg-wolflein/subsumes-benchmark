{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "anyOf",
    "items",
    "not",
    "prefixItems",
    "required",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/items.json#/tests/7",
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "https://subsumes-benchmark.example/schema"
      },
      {
        "not": {
          "$ref": "https://subsumes-benchmark.example/schema"
        }
      }
    ],
    "$defs": {
      "https://subsumes-benchmark.example/schema": {
        "$id": "https://subsumes-benchmark.example/schema",
        "$defs": {
          "item": {
            "type": "array",
            "items": false,
            "prefixItems": [
              {
                "$ref": "#/$defs/sub-item"
              },
              {
                "$ref": "#/$defs/sub-item"
              }
            ]
          },
          "sub-item": {
            "type": "object",
            "required": [
              "foo"
            ]
          }
        },
        "type": "array",
        "items": false,
        "prefixItems": [
          {
            "$ref": "#/$defs/item"
          },
          {
            "$ref": "#/$defs/item"
          },
          {
            "$ref": "#/$defs/item"
          }
        ]
      }
    }
  }
}
