{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "multipleOf",
    "not",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/multipleOf.json#/tests/8",
  "a": true,
  "b": {
    "anyOf": [
      {
        "type": "integer",
        "multipleOf": 0.123456789
      },
      {
        "not": {
          "type": "integer",
          "multipleOf": 0.123456789
        }
      }
    ]
  }
}
