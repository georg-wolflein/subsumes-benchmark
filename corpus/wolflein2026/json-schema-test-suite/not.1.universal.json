{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "not",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/not.json#/tests/1",
  "a": true,
  "b": {
    "anyOf": [
      {
        "not": {
          "type": [
            "integer",
            "boolean"
          ]
        }
      },
      {
        "not": {
          "not": {
            "type": [
              "integer",
              "boolean"
            ]
          }
        }
      }
    ]
  }
}
