{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "not",
    "pattern"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/optional/ecmascript-regex.json#/tests/12",
  "a": false,
  "b": {
    "allOf": [
      {
        "pattern": "[a-z]cole"
      },
      {
        "not": {
          "pattern": "[a-z]cole"
        }
      }
    ]
  }
}
