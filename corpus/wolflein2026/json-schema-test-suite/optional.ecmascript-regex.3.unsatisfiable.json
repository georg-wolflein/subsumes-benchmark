{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "not",
    "pattern",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/optional/ecmascript-regex.json#/tests/3"
  },
  "a": false,
  "b": {
    "allOf": [
      {
        "type": "string",
        "pattern": "^\\cc$"
      },
      {
        "not": {
          "type": "string",
          "pattern": "^\\cc$"
        }
      }
    ]
  }
}
