{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "anyOf",
    "const",
    "pattern",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/optional/ecmascript-regex.json#/tests/8",
  "derived": {
    "b_subsumes_a": {
      "counterexample": "\u1680"
    }
  },
  "a": {
    "type": "string",
    "pattern": "^\\s$"
  },
  "b": {
    "anyOf": [
      {
        "const": " "
      },
      {
        "const": "\t"
      },
      {
        "const": "\u000b"
      },
      {
        "const": "\f"
      },
      {
        "const": "\u00a0"
      },
      {
        "const": "\ufeff"
      },
      {
        "const": "\n"
      },
      {
        "const": "\u2029"
      },
      {
        "const": "\u2003"
      }
    ]
  }
}
