{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "not",
    "pattern"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/pattern.json#/tests/1",
  "a": true,
  "b": {
    "anyOf": [
      {
        "pattern": "a+"
      },
      {
        "not": {
          "pattern": "a+"
        }
      }
    ]
  }
}
