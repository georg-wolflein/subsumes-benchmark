{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "not",
    "patternProperties"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/patternProperties.json#/tests/3"
  },
  "a": false,
  "b": {
    "allOf": [
      {
        "patternProperties": {
          "f.*": true,
          "b.*": false
        }
      },
      {
        "not": {
          "patternProperties": {
            "f.*": true,
            "b.*": false
          }
        }
      }
    ]
  }
}
