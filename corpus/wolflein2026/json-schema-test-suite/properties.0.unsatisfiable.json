{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/properties.json#/tests/0",
  "a": false,
  "b": {
    "allOf": [
      {
        "properties": {
          "foo": {
            "type": "integer"
          },
          "bar": {
            "type": "string"
          }
        }
      },
      {
        "not": {
          "properties": {
            "foo": {
              "type": "integer"
            },
            "bar": {
              "type": "string"
            }
          }
        }
      }
    ]
  }
}
