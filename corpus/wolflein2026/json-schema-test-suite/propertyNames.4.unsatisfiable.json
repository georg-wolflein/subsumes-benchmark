{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "const",
    "not",
    "propertyNames"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/propertyNames.json#/tests/4",
  "a": false,
  "b": {
    "allOf": [
      {
        "propertyNames": {
          "const": "foo"
        }
      },
      {
        "not": {
          "propertyNames": {
            "const": "foo"
          }
        }
      }
    ]
  }
}
