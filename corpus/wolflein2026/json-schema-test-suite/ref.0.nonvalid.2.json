{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "$ref",
    "additionalProperties",
    "const",
    "not",
    "properties",
    "recursion"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/ref.json#/tests/0/tests/2",
  "derived": {
    "b_subsumes_a": {
      "counterexample": {
