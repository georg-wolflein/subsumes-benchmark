{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": false,
  "features": [
    "$ref",
    "const",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/ref.json#/tests/22/tests/0",
  "derived": {
    "b_subsumes_a": {
      "counterexample": {
        "bar": null
      }
    }
  },
  "a": {
    "not": {
      "$ref": "https://subsumes-benchmark.example/schema"
    },
    "$defs": {
      "https://subsumes-benchmark.example/schema": {
        "$id": "https://subsumes-benchmark.example/schema",
        "$ref": "http://localhost:1234/ref-and-defs.json",
        "$defs": {
          "http://localhost:1234/ref-and-defs.json": {
            "$id": "http://localhost:1234/ref-and-defs.json",
            "$defs": {
              "inner": {
                "properties": {
                  "bar": {
                    "type": "string"
                  }
                }
              }
            },
            "$ref": "#/$defs/inner"
          }
        }
      }
    }
  },
  "b": {
    "const": {
      "bar": 1
    }
  }
}
