{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "allOf",
    "not",
    "properties",
    "type"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/ref.json#/tests/3"
  },
  "a": false,
  "b": {
    "allOf": [
      {
        "$ref": "https://subsumes-benchmark.example/schema"
      },
      {
        "not": {
          "$ref": "https://subsumes-benchmark.example/schema"
        }
      }
    ],
    "$defs": {
      "https://subsumes-benchmark.example/schema": {
        "$id": "https://subsumes-benchmark.example/schema",
        "$defs": {
          "tilde~field": {
            "type": "integer"
          },
          "slash/field": {
            "type": "integer"
          },
          "percent%field": {
            "type": "integer"
          }
        },
        "properties": {
          "tilde": {
            "$ref": "#/$defs/tilde~0field"
          },
          "slash": {
            "$ref": "#/$defs/slash~1field"
          },
          "percent": {
            "$ref": "#/$defs/percent%25field"
          }
        }
      }
    }
  }
}
