{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "not",
    "properties",
    "type"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/ref.json#/tests/6",
  "a": true,
  "b": {
    "anyOf": [
      {
        "properties": {
          "$ref": {
            "type": "string"
          }
        }
      },
      {
        "not": {
          "properties": {
            "$ref": {
              "type": "string"
            }
          }
        }
      }
    ]
  }
}
