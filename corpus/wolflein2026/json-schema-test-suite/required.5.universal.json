{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "not",
    "required"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/required.json#/tests/5",
  "a": true,
  "b": {
    "anyOf": [
      {
        "required": [
          "foo\nbar",
          "foo\"bar",
          "foo\\bar",
          "foo\rbar",
          "foo\tbar",
          "foo\fbar"
        ]
      },
      {
        "not": {
          "required": [
            "foo\nbar",
            "foo\"bar",
            "foo\\bar",
            "foo\rbar",
            "foo\tbar",
            "foo\fbar"
          ]
        }
      }
    ]
  }
}
