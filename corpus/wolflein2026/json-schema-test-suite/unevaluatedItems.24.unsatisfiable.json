{
  "$schema": "../../case.schema.json",
  "kind": "upstream",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "const",
    "else",
    "if",
    "not",
    "prefixItems",
    "then",
    "unevaluatedItems"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedItems.json#/tests/24",
  "a": false,
  "b": {
    "allOf": [
      {
        "prefixItems": [
          {
            "const": "foo"
          }
        ],
        "if": {
          "prefixItems": [
            true,
            {
              "const": "bar"
            }
          ]
        },
        "then": {
          "prefixItems": [
            true,
            true,
            {
              "const": "then"
            }
          ]
        },
        "else": {
          "prefixItems": [
            true,
            true,
            true,
            {
              "const": "else"
            }
          ]
        },
        "unevaluatedItems": false
      },
      {
        "not": {
          "prefixItems": [
            {
              "const": "foo"
            }
          ],
          "if": {
            "prefixItems": [
              true,
              {
                "const": "bar"
              }
            ]
          },
          "then": {
            "prefixItems": [
              true,
              true,
              {
                "const": "then"
              }
            ]
          },
          "else": {
            "prefixItems": [
              true,
              true,
              true,
              {
                "const": "else"
              }
            ]
          },
          "unevaluatedItems": false
        }
      }
    ]
  }
}
