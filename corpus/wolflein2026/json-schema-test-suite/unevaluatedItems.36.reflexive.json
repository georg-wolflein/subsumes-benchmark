{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "prefixItems",
    "properties",
    "type",
    "unevaluatedItems"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedItems.json#/tests/36",
  "a": {
    "properties": {
      "foo": {
        "prefixItems": [
          {
            "type": "string"
          }
        ],
        "unevaluatedItems": false
      }
    },
    "anyOf": [
      {
        "properties": {
          "foo": {
            "prefixItems": [
              true,
              {
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  },
  "b": {
    "properties": {
      "foo": {
        "prefixItems": [
          {
            "type": "string"
          }
        ],
        "unevaluatedItems": false
      }
    },
    "anyOf": [
      {
        "properties": {
          "foo": {
            "prefixItems": [
              true,
              {
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  }
}
