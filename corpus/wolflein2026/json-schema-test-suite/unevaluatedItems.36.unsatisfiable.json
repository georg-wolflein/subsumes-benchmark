{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "anyOf",
    "not",
    "prefixItems",
    "properties",
    "type",
    "unevaluatedItems"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedItems.json#/tests/36"
  },
  "a": false,
  "b": {
    "allOf": [
      {
        "properties": {
          "foo": {
            "prefixItems": [
              {
                "type": "string"
              }
            ],
            "unevaluatedItems": false
          }
        },
        "anyOf": [
          {
            "properties": {
              "foo": {
                "prefixItems": [
                  true,
                  {
                    "type": "string"
                  }
                ]
              }
            }
          }
        ]
      },
      {
        "not": {
          "properties": {
            "foo": {
              "prefixItems": [
                {
                  "type": "string"
                }
              ],
              "unevaluatedItems": false
            }
          },
          "anyOf": [
            {
              "properties": {
                "foo": {
                  "prefixItems": [
                    true,
                    {
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
