{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "contains",
    "minContains",
    "not",
    "type",
    "unevaluatedItems"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedItems.json#/tests/41",
  "a": true,
  "b": {
    "anyOf": [
      {
        "contains": {
          "type": "string"
        },
        "minContains": 0,
        "unevaluatedItems": false
      },
      {
        "not": {
          "contains": {
            "type": "string"
          },
          "minContains": 0,
          "unevaluatedItems": false
        }
      }
    ]
  }
}
