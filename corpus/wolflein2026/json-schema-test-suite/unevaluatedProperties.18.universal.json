{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "anyOf",
    "not",
    "properties",
    "type",
    "unevaluatedProperties"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/18"
  },
  "a": true,
  "b": {
    "anyOf": [
      {
        "type": "object",
        "properties": {
          "foo": {
            "type": "string"
          }
        },
        "allOf": [
          true
        ],
        "unevaluatedProperties": false
      },
      {
        "not": {
          "type": "object",
          "properties": {
            "foo": {
              "type": "string"
            }
          },
          "allOf": [
            true
          ],
          "unevaluatedProperties": false
        }
      }
    ]
  }
}
