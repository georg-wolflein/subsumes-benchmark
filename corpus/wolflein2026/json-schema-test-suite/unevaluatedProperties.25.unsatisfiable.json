{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "not",
    "properties",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/25",
  "a": false,
  "b": {
    "allOf": [
      {
        "allOf": [
          {
            "unevaluatedProperties": false
          },
          {
            "properties": {
              "foo": true
            }
          }
        ]
      },
      {
        "not": {
          "allOf": [
            {
              "unevaluatedProperties": false
            },
            {
              "properties": {
                "foo": true
              }
            }
          ]
        }
      }
    ]
  }
}
