{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "anyOf",
    "not",
    "properties",
    "type",
    "unevaluatedProperties"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/33"
  },
  "a": false,
  "b": {
    "allOf": [
      {
        "type": "object",
        "allOf": [
          {
            "properties": {
              "foo": true
            },
            "unevaluatedProperties": false
          }
        ],
        "anyOf": [
          {
            "properties": {
              "bar": true
            }
          }
        ]
      },
      {
        "not": {
          "type": "object",
          "allOf": [
            {
              "properties": {
                "foo": true
              },
              "unevaluatedProperties": false
            }
          ],
          "anyOf": [
            {
              "properties": {
                "bar": true
              }
            }
          ]
        }
      }
    ]
  }
}
