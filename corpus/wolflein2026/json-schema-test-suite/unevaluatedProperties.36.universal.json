{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "allOf",
    "anyOf",
    "not",
    "oneOf",
    "properties",
    "required",
    "unevaluatedProperties"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/36"
  },
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "https://subsumes-benchmark.example/schema"
      },
      {
        "not": {
          "$ref": "https://subsumes-benchmark.example/schema"
        }
      }
    ],
    "$defs": {
      "https://subsumes-benchmark.example/schema": {
        "$id": "https://subsumes-benchmark.example/schema",
        "$defs": {
          "one": {
            "properties": {
              "a": true
            }
          },
          "two": {
            "required": [
              "x"
            ],
            "properties": {
              "x": true
            }
          }
        },
        "allOf": [
          {
            "$ref": "#/$defs/one"
          },
          {
            "properties": {
              "b": true
            }
          },
          {
            "oneOf": [
              {
                "$ref": "#/$defs/two"
              },
              {
                "required": [
                  "y"
                ],
                "properties": {
                  "y": true
                }
              }
            ]
          }
        ],
        "unevaluatedProperties": false
      }
    }
  }
}
