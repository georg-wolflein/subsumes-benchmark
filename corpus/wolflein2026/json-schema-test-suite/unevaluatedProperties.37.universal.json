{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "$ref",
    "anyOf",
    "not",
    "oneOf",
    "patternProperties",
    "properties",
    "required",
    "unevaluatedProperties"
  ],
  "upstream": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/37",
  "a": true,
  "b": {
    "anyOf": [
      {
        "$ref": "https://subsumes-benchmark.example/schema"
      },
      {
        "not": {
          "$ref": "https://subsumes-benchmark.example/schema"
        }
      }
    ],
    "$defs": {
      "https://subsumes-benchmark.example/schema": {
        "$id": "https://subsumes-benchmark.example/schema",
        "$defs": {
          "one": {
            "oneOf": [
              {
                "$ref": "#/$defs/two"
              },
              {
                "required": [
                  "b"
                ],
                "properties": {
                  "b": true
                }
              },
              {
                "required": [
                  "xx"
                ],
                "patternProperties": {
                  "x": true
                }
              },
              {
                "required": [
                  "all"
                ],
                "unevaluatedProperties": true
              }
            ]
          },
          "two": {
            "oneOf": [
              {
                "required": [
                  "c"
                ],
                "properties": {
                  "c": true
                }
              },
              {
                "required": [
                  "d"
                ],
                "properties": {
                  "d": true
                }
              }
            ]
          }
        },
        "oneOf": [
          {
            "$ref": "#/$defs/one"
          },
          {
            "required": [
              "a"
            ],
            "properties": {
              "a": true
            }
          }
        ],
        "unevaluatedProperties": false
      }
    }
  }
}
