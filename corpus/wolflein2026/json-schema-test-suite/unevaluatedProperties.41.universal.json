{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "anyOf",
    "if",
    "not",
    "patternProperties",
    "type",
    "unevaluatedProperties"
  ],
  "built_from": {
    "kind": "source",
    "link": "https://github.com/json-schema-org/JSON-Schema-Test-Suite/blob/e2a68a15cd490750fd6b95e604e4054d7d978d1f/validation/tests/unevaluatedProperties.json#/tests/41"
  },
  "a": true,
  "b": {
    "anyOf": [
      {
        "if": {
          "patternProperties": {
            "foo": {
              "type": "string"
            }
          }
        },
        "unevaluatedProperties": false
      },
      {
        "not": {
          "if": {
            "patternProperties": {
              "foo": {
                "type": "string"
              }
            }
          },
          "unevaluatedProperties": false
        }
      }
    ]
  }
}
