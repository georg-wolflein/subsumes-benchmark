{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": false,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "pattern",
    "type"
  ],
  "built_from": {
    "kind": "generator",
    "family": "coprime-counters",
    "sizes": {
      "p": 11,
      "q": 13
    },
    "twin": true
  },
  "a": {
    "type": "string",
    "pattern": "^(a{286})*$"
  },
  "b": {
    "type": "string",
    "allOf": [
      {
        "pattern": "^(a{11})*$"
      },
      {
        "pattern": "^(a{13})*$"
      }
    ]
  }
}
