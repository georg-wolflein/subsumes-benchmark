{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "allOf",
    "pattern",
    "type"
  ],
  "built_from": {
    "kind": "generator",
    "family": "coprime-counters",
    "sizes": {
      "p": 7,
      "q": 11
    },
    "twin": false
  },
  "a": {
    "type": "string",
    "pattern": "^(a{77})*$"
  },
  "b": {
    "type": "string",
    "allOf": [
      {
        "pattern": "^(a{7})*$"
      },
      {
        "pattern": "^(a{11})*$"
      }
    ]
  }
}
