{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "pattern",
    "type"
  ],
  "generated": {
    "family": "nth-from-end",
    "sizes": {
      "n": 16
    },
    "twin": false
  },
  "a": {
    "type": "string",
    "pattern": "^(a|b)*a(a|b){15}(a|b)$"
  },
  "b": {
    "type": "string",
    "pattern": "^[ab]*a[ab]{16}$"
  }
}
