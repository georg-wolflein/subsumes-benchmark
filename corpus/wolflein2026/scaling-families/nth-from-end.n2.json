{
  "$schema": "../../case.schema.json",
  "labels": {
    "a_subsumes_b": {
      "kind": "construction",
      "answer": true
    },
    "b_subsumes_a": {
      "kind": "construction",
      "answer": true
    }
  },
  "built_from": {
    "kind": "generator",
    "family": "nth-from-end",
    "sizes": {
      "n": 2
    },
    "twin": false
  },
  "features": [
    "pattern",
    "type"
  ],
  "a": {
    "type": "string",
    "pattern": "^(a|b)*a(a|b){1}(a|b)$"
  },
  "b": {
    "type": "string",
    "pattern": "^[ab]*a[ab]{2}$"
  }
}
