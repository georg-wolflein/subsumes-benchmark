{
  "$schema": "../../case.schema.json",
  "a_subsumes_b": true,
  "b_subsumes_a": true,
  "features": [
    "pattern",
    "type"
  ],
  "built_from": {
    "kind": "generator",
    "family": "nth-from-end",
    "sizes": {
      "n": 4
    },
    "twin": false
  },
  "a": {
    "type": "string",
    "pattern": "^(a|b)*a(a|b){3}(a|b)$"
  },
  "b": {
    "type": "string",
    "pattern": "^[ab]*a[ab]{4}$"
  }
}
